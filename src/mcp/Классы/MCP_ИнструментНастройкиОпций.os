// MCP-инструмент настройки набора опций в сессии (экономия токенов).
//
// Общие наборы опций (подключение, платформа, СУБД, настройки и пр.) исключены
// из схем команд и настраиваются один раз отдельными инструментами set_*. Значения
// пишутся в бин-синглтон набора опций; поскольку команды берут тот же синглтон
// (Поделка.НайтиЖелудь), настройки действуют до конца сессии для всех команд.
// Так общие ~18 опций не повторяются в каждом из ~49 инструментов и не передаются
// в каждом вызове.
//
// Реализует контракт инструмента autumn-mcp (см. MCP_Сервер).

#Использовать autumn

Перем _Поделка;
Перем _Имя;
Перем _Описание;
Перем _Схема;
Перем _ИмяКлассаНабора;
Перем _ПланПараметров; // Массив структур {ИмяОпции, ИмяПоля}
Перем _Рефлектор;

Процедура ПриСозданииОбъекта()
	_Рефлектор = Новый Рефлектор();
КонецПроцедуры

Процедура Заполнить(Поделка, Имя, Описание, Схема, ИмяКлассаНабора, ПланПараметров) Экспорт
	_Поделка = Поделка;
	_Имя = Имя;
	_Описание = Описание;
	_Схема = Схема;
	_ИмяКлассаНабора = ИмяКлассаНабора;
	_ПланПараметров = ПланПараметров;
КонецПроцедуры

Функция ИмяИнструмента() Экспорт
	Возврат _Имя;
КонецФункции

Функция ОписаниеИнструмента() Экспорт
	Возврат _Описание;
КонецФункции

Функция СхемаИнструмента() Экспорт
	Возврат _Схема;
КонецФункции

Функция ВыполнитьИнструмент(Инструмент, ПараметрыИнструмента) Экспорт

	Аргументы = ?(ПараметрыИнструмента = Неопределено, Новый Соответствие(), ПараметрыИнструмента);
	Набор = _Поделка.НайтиЖелудь(_ИмяКлассаНабора);

	Установлено = Новый Массив();
	Для Каждого П Из _ПланПараметров Цикл
		Значение = Аргументы.Получить(П.ИмяОпции);
		Если Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		_Рефлектор.УстановитьСвойство(Набор, П.ИмяПоля, Значение);
		Установлено.Добавить(П.ИмяОпции);
	КонецЦикла;

	Если Установлено.Количество() = 0 Тогда
		Возврат "Опции не изменены (нет переданных значений).";
	КонецЕсли;
	Возврат СтрШаблон("Опции сессии обновлены: %1.", СтрСоединить(Установлено, ", "));

КонецФункции
