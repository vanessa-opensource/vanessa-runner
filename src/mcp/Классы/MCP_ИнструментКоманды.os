// MCP-инструмент-обёртка над CLI-подкомандой vrunner. Исполнение — IN-PROCESS:
// бин команды резолвится из контекста (сервисы &Пластилин автовайрятся), наборы
// опций инстанцируются из контекста, поля заполняются Рефлектором из аргументов
// инструмента, затем вызывается ВыполнитьДействие(). Дочерний процесс не нужен.
//
// Реализует контракт инструмента autumn-mcp (MCP_Сервер):
//   ИмяИнструмента() -> Строка
//   ОписаниеИнструмента() -> Строка
//   СхемаИнструмента() -> Соответствие (JSON Schema inputSchema)
//   ВыполнитьИнструмент(Инструмент, ПараметрыИнструмента) -> Строка
//
// Лог команды (логгер "vrunner.*") уходит клиенту как notifications/message
// через MCP_АппендерУведомлений (настраивается в точке входа src/mcp.os).

#Использовать autumn

Перем _Поделка;
Перем _Имя;
Перем _Описание;
Перем _Схема;
Перем _ИмяБинаКоманды;  // имя желудя команды для НайтиЖелудь
Перем _Наборы;          // Массив структур {ИмяПоля, ИмяКласса} — наборы опций команды
Перем _ПланПараметров;  // Массив структур {ИмяОпции, ИмяПоля, ВладелецНабор, ЭтоФлаг, ЭтоАргумент}
Перем _Рефлектор;

Процедура ПриСозданииОбъекта()
	_Рефлектор = Новый Рефлектор();
КонецПроцедуры

Процедура Заполнить(Поделка, Имя, Описание, Схема, ИмяБинаКоманды, Наборы, ПланПараметров) Экспорт
	_Поделка = Поделка;
	_Имя = Имя;
	_Описание = Описание;
	_Схема = Схема;
	_ИмяБинаКоманды = ИмяБинаКоманды;
	_Наборы = Наборы;
	_ПланПараметров = ПланПараметров;
КонецПроцедуры

Функция ИмяИнструмента() Экспорт
	Возврат _Имя;
КонецФункции

Функция ОписаниеИнструмента() Экспорт
	Возврат _Описание;
КонецФункции

Функция СхемаИнструмента() Экспорт
	Возврат _Схема;
КонецФункции

// Сигнатура по контракту autumn-mcp: первым параметром сервер передаёт сам
// объект инструмента (нам не нужен — у нас уже есть состояние), вторым — аргументы.
Функция ВыполнитьИнструмент(Инструмент, ПараметрыИнструмента) Экспорт

	Аргументы = ?(ПараметрыИнструмента = Неопределено, Новый Соответствие(), ПараметрыИнструмента);

	Команда = _Поделка.НайтиЖелудь(_ИмяБинаКоманды);

	// Наборы опций — синглтоны из контекста: несут настройки сессии (заданные
	// инструментами set_*) и привязываются к команде. Сами опции наборов в схему
	// команды не входят (см. MCP_РеестрИнструментов / MCP_ИнструментНастройкиОпций).
	Для Каждого Набор Из _Наборы Цикл
		_Рефлектор.УстановитьСвойство(Команда, Набор.ИмяПоля, _Поделка.НайтиЖелудь(Набор.ИмяКласса));
	КонецЦикла;

	// Собственные опции/аргументы команды из вызова.
	Для Каждого П Из _ПланПараметров Цикл
		Значение = Аргументы.Получить(П.ИмяОпции);
		Если Значение <> Неопределено Тогда
			_Рефлектор.УстановитьСвойство(Команда, П.ИмяПоля, Значение);
		КонецЕсли;
	КонецЦикла;

	Команда.ВыполнитьДействие();

	Возврат СтрШаблон("%1 — выполнено.", _Описание);

КонецФункции
