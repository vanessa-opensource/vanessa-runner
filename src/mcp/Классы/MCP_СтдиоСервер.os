// ПРОТОТИП. Минимальный MCP-сервер поверх stdio (JSON-RPC 2.0).
//
// Формы ответов (initialize / tools/list / tools/call / ping) повторяют
// реализацию autumn-library/autumn-mcp (MCP_Сервер). Вынесено в vrunner,
// чтобы НЕ зависеть от пакета autumn-mcp на уровне packagedef: иначе его
// &Рогатка перехватывала бы каждый обычный запуск vrunner.
//
// TODO: когда в autumn-mcp появится "библиотечный режим" (сервер без
//       авто-рогатки) — заменить этот класс на зависимость от autumn-mcp.
//
// Контракт инструмента (МассивИнструментов — массив объектов):
//   Имя()            -> Строка
//   Описание()       -> Строка
//   Схема()          -> Соответствие/Структура (JSON Schema inputSchema)
//   Аннотации()      -> Соответствие (MCP tool annotations; пустое — не выводится)
//   ВыполнитьИнструмент(Арг, Нотификатор) -> Строка (текстовый результат; Арг — Соответствие)

#Использовать json

Перем Инструменты; // Соответствие: имя -> объект-инструмент
Перем ПарсерJSON;  // общий парсер: нужен и в цикле, и при отправке уведомлений из инструментов

Процедура ПриСозданииОбъекта()
	Инструменты = Новый Соответствие();
	ПарсерJSON = Новый ПарсерJSON();
КонецПроцедуры

Процедура ЗарегистрироватьИнструменты(МассивИнструментов) Экспорт
	Для Каждого Инструмент Из МассивИнструментов Цикл
		Инструменты.Вставить(Инструмент.Имя(), Инструмент);
	КонецЦикла;
КонецПроцедуры

Процедура Запустить() Экспорт

	Консоль.КодировкаВходногоПотока = "UTF-8";
	Консоль.КодировкаВыходногоПотока = "UTF-8";

	Пока Истина Цикл

		ТекстКоманды = Консоль.ПрочитатьСтроку();
		Если ТекстКоманды = Неопределено Тогда
			Прервать; // stdin закрыт — клиент отсоединился
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ТекстКоманды) Тогда
			Продолжить;
		КонецЕсли;

		Запрос = ПарсерJSON.ПрочитатьJSON(ТекстКоманды);
		Метод = Запрос.Получить("method");
		ИдЗапроса = Запрос.Получить("id");

		// Уведомления (без id) не требуют ответа.
		Если ИдЗапроса = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если Метод = "initialize" Тогда
			ОтправитьРезультат(ПарсерJSON, ИдЗапроса, ОтветInitialize());
		ИначеЕсли Метод = "tools/list" Тогда
			ОтправитьРезультат(ПарсерJSON, ИдЗапроса, ОтветToolsList());
		ИначеЕсли Метод = "tools/call" Тогда
			ОтправитьРезультат(ПарсерJSON, ИдЗапроса, ОтветToolsCall(Запрос.Получить("params")));
		ИначеЕсли Метод = "logging/setLevel" Тогда
			// Уровень не фильтруем (прототип) — подтверждаем пустым результатом.
			ОтправитьРезультат(ПарсерJSON, ИдЗапроса, Новый Соответствие());
		ИначеЕсли Метод = "ping" Тогда
			ОтправитьРезультат(ПарсерJSON, ИдЗапроса, Новый Соответствие());
		Иначе
			ОтправитьОшибку(ПарсерJSON, ИдЗапроса, -32601, "Метод не поддерживается: " + Строка(Метод));
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Отправить клиенту лог-уведомление (server -> client). Вызывается из инструментов
// по мере поступления вывода дочерней команды. Это notification (без id) — ответа нет.
//
// Параметры:
//   Уровень - Строка - уровень MCP-лога ("info", "error", "debug", ...)
//   Логгер  - Строка - имя источника (params.logger)
//   Данные  - Произвольный - полезная нагрузка (params.data)
Процедура ОтправитьУведомлениеЛог(Знач Уровень, Знач Логгер, Знач Данные) Экспорт
	Параметры = Новый Соответствие();
	Параметры.Вставить("level", Уровень);
	Параметры.Вставить("logger", Логгер);
	Параметры.Вставить("data", Данные);

	Уведомление = Новый Соответствие();
	Уведомление.Вставить("jsonrpc", "2.0");
	Уведомление.Вставить("method", "notifications/message");
	Уведомление.Вставить("params", Параметры);
	Консоль.ВывестиСтроку(ПарсерJSON.ЗаписатьJSON(Уведомление, Ложь));
КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Функция ОтветInitialize()
	Возможности = Новый Соответствие();
	Возможности.Вставить("tools", Новый Соответствие());
	Возможности.Вставить("logging", Новый Соответствие()); // server -> client: notifications/message

	ИнфоСервера = Новый Соответствие();
	ИнфоСервера.Вставить("name", "vrunner-mcp");
	ИнфоСервера.Вставить("version", "0.1.0");

	Результат = Новый Соответствие();
	Результат.Вставить("protocolVersion", "2025-03-26");
	Результат.Вставить("capabilities", Возможности);
	Результат.Вставить("serverInfo", ИнфоСервера);
	Результат.Вставить("instructions", "Инструменты vrunner: запуск тестов, сценариев и обслуживания ИБ 1С.");
	Возврат Результат;
КонецФункции

Функция ОтветToolsList()
	МассивИнструментов = Новый Массив();
	Для Каждого КлючЗначение Из Инструменты Цикл
		Инструмент = КлючЗначение.Значение;
		Описание = Новый Соответствие();
		Описание.Вставить("name", Инструмент.Имя());
		Описание.Вставить("description", Инструмент.Описание());
		Описание.Вставить("inputSchema", Инструмент.Схема());
		Аннотации = Инструмент.Аннотации();
		Если Аннотации.Количество() > 0 Тогда
			Описание.Вставить("annotations", Аннотации);
		КонецЕсли;
		МассивИнструментов.Добавить(Описание);
	КонецЦикла;

	Результат = Новый Соответствие();
	Результат.Вставить("tools", МассивИнструментов);
	Возврат Результат;
КонецФункции

Функция ОтветToolsCall(Параметры)
	ИмяИнструмента = Параметры.Получить("name");
	Аргументы = Параметры.Получить("arguments");
	Если Аргументы = Неопределено Тогда
		Аргументы = Новый Соответствие();
	КонецЕсли;

	ЭтоОшибка = Ложь;
	Попытка
		Инструмент = Инструменты.Получить(ИмяИнструмента);
		Если Инструмент = Неопределено Тогда
			ВызватьИсключение СтрШаблон("Инструмент не найден: %1", ИмяИнструмента);
		КонецЕсли;
		// ЭтотОбъект как нотификатор: инструмент стримит вывод дочерней команды
		// через ОтправитьУведомлениеЛог -> notifications/message по мере поступления.
		Текст = Инструмент.ВыполнитьИнструмент(Аргументы, ЭтотОбъект);
	Исключение
		Текст = ОписаниеОшибки();
		ЭтоОшибка = Истина;
	КонецПопытки;

	БлокТекста = Новый Соответствие();
	БлокТекста.Вставить("type", "text");
	БлокТекста.Вставить("text", Текст);

	Контент = Новый Массив();
	Контент.Добавить(БлокТекста);

	Результат = Новый Соответствие();
	Результат.Вставить("content", Контент);
	Если ЭтоОшибка Тогда
		Результат.Вставить("isError", Истина);
	КонецЕсли;
	Возврат Результат;
КонецФункции

Процедура ОтправитьРезультат(ПарсерJSON, ИдЗапроса, Результат)
	Ответ = Новый Соответствие();
	Ответ.Вставить("jsonrpc", "2.0");
	Ответ.Вставить("id", ИдЗапроса);
	Ответ.Вставить("result", Результат);
	Консоль.ВывестиСтроку(ПарсерJSON.ЗаписатьJSON(Ответ, Ложь));
КонецПроцедуры

Процедура ОтправитьОшибку(ПарсерJSON, ИдЗапроса, Код, Сообщение)
	Ошибка = Новый Соответствие();
	Ошибка.Вставить("code", Код);
	Ошибка.Вставить("message", Сообщение);

	Ответ = Новый Соответствие();
	Ответ.Вставить("jsonrpc", "2.0");
	Ответ.Вставить("id", ИдЗапроса);
	Ответ.Вставить("error", Ошибка);
	Консоль.ВывестиСтроку(ПарсерJSON.ЗаписатьJSON(Ответ, Ложь));
КонецПроцедуры

#КонецОбласти
