// ПРОТОТИП. Сток-лог для стриминга вывода дочерней команды в MCP-нотификации.
//
// Передаётся в Команда.ДобавитьЛогВыводаКоманды(...): библиотека 1commands во
// время опроса процесса вызывает у подключённого лога .Информация(порция) и
// .Ошибка(порция) на КАЖДУЮ поступившую порцию stdout/stderr. Здесь порция:
//   * разбивается на строки и сразу отправляется клиенту как notifications/message
//     (server -> client logging) — вывод идёт по мере поступления;
//   * накапливается в буфере, чтобы вернуть полный текст в финальном result —
//     для клиентов, которые лог-нотификации не отображают.
//
// JSON-aware: если дочерний процесс пишет лог JSON-раскладкой logos
// ({"time","level","msg","log"} — см. logos/json-layout.os), строка разбирается
// и в нотификацию идут ТОЧНЫЕ level/logger/текст из самого события. Иначе строка
// уходит как есть с уровнем по потоку (stdout -> info, stderr -> error).
// Включить JSON-вывод у потомка: env logos_logger_vrunner_classlayout=JSONРаскладкаСообщения.
//
// Контракт нотификатора (см. MCP_СтдиоСервер):
//   ОтправитьУведомлениеЛог(Уровень, Логгер, Данные) -> отправка notifications/message

#Использовать json

Перем _Нотификатор; // объект с методом ОтправитьУведомлениеЛог(Уровень, Логгер, Данные)
Перем _Логгер;      // имя логгера по умолчанию (для не-JSON строк)
Перем _Буфер;       // массив текстовых строк — для финального результата
Перем _ПарсерJSON;  // переиспользуемый парсер
Перем _КартаУровней; // logos-уровень (DEBUG/INFO/...) -> MCP-уровень

Процедура ПриСозданииОбъекта()
	_Буфер = Новый Массив();
	_Логгер = "vrunner";
	_ПарсерJSON = Новый ПарсерJSON();
	_КартаУровней = КартаУровней();
КонецПроцедуры

Процедура Заполнить(Нотификатор, Знач Логгер = "vrunner") Экспорт
	_Нотификатор = Нотификатор;
	_Логгер = Логгер;
КонецПроцедуры

// Методы лог-интерфейса, дёргаемые из Команда.ОбработатьОчереднуюСтрокуВывода.
Процедура Информация(Знач Сообщение) Экспорт
	ОбработатьПорцию(Сообщение, "info");
КонецПроцедуры

Процедура Ошибка(Знач Сообщение) Экспорт
	ОбработатьПорцию(Сообщение, "error");
КонецПроцедуры

Функция ПолучитьВывод() Экспорт
	Возврат СтрСоединить(_Буфер, Символы.ПС);
КонецФункции

#Область СлужебныеПроцедурыИФункции

Процедура ОбработатьПорцию(Знач Порция, Знач УровеньПоУмолчанию)
	Если Не ЗначениеЗаполнено(Порция) Тогда
		Возврат;
	КонецЕсли;
	// Порция может содержать несколько строк — обрабатываем построчно.
	// Нормализуем CRLF: режем по ПС, у строк убираем хвостовой ВК (Windows).
	Для Каждого Строка Из СтрРазделить(СтрЗаменить(Порция, Символы.ВК, ""), Символы.ПС, Ложь) Цикл
		Если Не ЗначениеЗаполнено(Строка) Тогда
			Продолжить;
		КонецЕсли;

		Событие = РазобратьСобытие(Строка, УровеньПоУмолчанию);
		_Буфер.Добавить(Событие.Текст);

		Если _Нотификатор <> Неопределено Тогда
			_Нотификатор.ОтправитьУведомлениеЛог(Событие.Уровень, Событие.Логгер, Событие.Текст);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Пытается разобрать строку как JSON-событие logos. Возвращает структуру
// {Уровень, Логгер, Текст}. Для не-JSON строк — значения по умолчанию.
Функция РазобратьСобытие(Знач Строка, Знач УровеньПоУмолчанию)

	Уровень = УровеньПоУмолчанию;
	Логгер = _Логгер;
	Текст = Строка;

	ПерваяЛексема = Лев(СокрЛ(Строка), 1);
	Если ПерваяЛексема = "{" Тогда
		Попытка
			Данные = _ПарсерJSON.ПрочитатьJSON(Строка);
			Если ТипЗнч(Данные) = Тип("Соответствие") И Данные.Получить("msg") <> Неопределено Тогда
				Текст = Строка(Данные.Получить("msg"));
				Уровень = MCPУровень(Данные.Получить("level"), УровеньПоУмолчанию);
				Если ЗначениеЗаполнено(Данные.Получить("log")) Тогда
					Логгер = Строка(Данные.Получить("log"));
				КонецЕсли;
			КонецЕсли;
		Исключение
			// Не JSON (или битый) — оставляем строку как есть.
		КонецПопытки;
	КонецЕсли;

	Возврат Новый Структура("Уровень, Логгер, Текст", Уровень, Логгер, Текст);
КонецФункции

Функция MCPУровень(Знач УровеньLogos, Знач УровеньПоУмолчанию)
	Если УровеньLogos = Неопределено Тогда
		Возврат УровеньПоУмолчанию;
	КонецЕсли;
	Сопоставленный = _КартаУровней.Получить(ВРег(Строка(УровеньLogos)));
	Возврат ?(Сопоставленный = Неопределено, УровеньПоУмолчанию, Сопоставленный);
КонецФункции

// logos -> MCP logging levels (spec: debug/info/notice/warning/error/critical/...).
Функция КартаУровней()
	Карта = Новый Соответствие();
	Карта.Вставить("DEBUG", "debug");
	Карта.Вставить("INFO", "info");
	Карта.Вставить("WARN", "warning");
	Карта.Вставить("ERROR", "error");
	Карта.Вставить("FATAL", "critical");
	Возврат Карта;
КонецФункции

#КонецОбласти
