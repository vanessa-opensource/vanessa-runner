// ПРОТОТИП. MCP-инструмент-обёртка над CLI-командой vrunner.
//
// Метаданные (имя/описание/схема) строятся рефлексией один раз при старте
// (см. MCP_РеестрИнструментов). Исполнение — ВНЕ процесса: запускается
// дочерний `vrunner <путь команды> <флаги>`, его stdout/stderr перехватывается
// и возвращается как результат инструмента.
//
// Почему out-of-process:
//   * stdout текущего процесса занят JSON-RPC (MCP) — вывод команды его бы сломал;
//   * команда может звать ЗавершитьРаботу/падать — это не должно убивать сервер;
//   * переиспользуется ровно тот же путь запуска, что и в обычном CLI.

#Использовать 1commands

Перем _Имя;
Перем _Описание;
Перем _Схема;
Перем _ПутьCLI;     // Массив строк, напр. ["test", "xunit"]
Перем _МетаОпций;   // Массив структур: Имя, ЭтоФлаг (Булево), ЭтоАргумент (Булево)
Перем _СтрокаЗапускаVrunner; // префикс запуска потомка, напр. oscript "<корень>/src/main.os"
Перем _Аннотации;   // Соответствие: MCP tool annotations (title/readOnlyHint/destructiveHint)

Процедура Заполнить(Имя, Описание, Схема, ПутьCLI, МетаОпций, СтрокаЗапускаVrunner, Аннотации = Неопределено) Экспорт
	_Имя = Имя;
	_Описание = Описание;
	_Схема = Схема;
	_ПутьCLI = ПутьCLI;
	_МетаОпций = МетаОпций;
	_СтрокаЗапускаVrunner = СтрокаЗапускаVrunner;
	_Аннотации = ?(Аннотации = Неопределено, Новый Соответствие(), Аннотации);
КонецПроцедуры

Функция Имя() Экспорт
	Возврат _Имя;
КонецФункции

Функция Описание() Экспорт
	Возврат _Описание;
КонецФункции

Функция Схема() Экспорт
	Возврат _Схема;
КонецФункции

// MCP-аннотации инструмента (title/readOnlyHint/destructiveHint) или пустое соответствие.
Функция Аннотации() Экспорт
	Возврат _Аннотации;
КонецФункции

// Параметры:
//   Аргументы   - Соответствие - значения опций/аргументов из tools/call
//   Нотификатор - Произвольный  - объект с методом ОтправитьУведомлениеЛог(Уровень, Логгер, Данные).
//                 Если задан — вывод дочерней команды стримится клиенту по мере
//                 поступления (notifications/message), иначе перехватывается целиком.
Функция ВыполнитьИнструмент(Аргументы, Нотификатор = Неопределено) Экспорт

	ЧастиКоманды = Новый Массив();
	Опции = Новый Массив();
	Позиционные = Новый Массив();

	Для Каждого Мета Из _МетаОпций Цикл
		Значение = Аргументы.Получить(Мета.Имя);
		Если Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если Мета.ЭтоАргумент Тогда
			Позиционные.Добавить(Цитировать(Строка(Значение)));
		ИначеЕсли Мета.ЭтоФлаг Тогда
			Если Значение = Истина Тогда
				Опции.Добавить(Флаг(Мета.Имя));
			КонецЕсли;
		Иначе
			Если ЗначениеЗаполнено(Строка(Значение)) Тогда
				Опции.Добавить(Флаг(Мета.Имя));
				Опции.Добавить(Цитировать(Строка(Значение)));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Для Каждого Часть Из _ПутьCLI Цикл
		ЧастиКоманды.Добавить(Часть);
	КонецЦикла;
	Для Каждого Часть Из Опции Цикл
		ЧастиКоманды.Добавить(Часть);
	КонецЦикла;
	Для Каждого Часть Из Позиционные Цикл
		ЧастиКоманды.Добавить(Часть);
	КонецЦикла;

	СтрокаЗапуска = _СтрокаЗапускаVrunner + " " + СтрСоединить(ЧастиКоманды, " ");

	Команда = Новый Команда();
	Команда.УстановитьСтрокуЗапуска(СтрокаЗапуска);
	Команда.ПоказыватьВыводНемедленно(Ложь); // ВАЖНО: вывод НЕ в stdout сервера, иначе сломаем MCP-канал

	// Со стоком вывод идёт в него порциями (1commands дёргает .Информация/.Ошибка
	// при опросе процесса каждые 100мс) и тут же уходит клиенту как notifications/message.
	Сток = Неопределено;
	Если Нотификатор <> Неопределено Тогда
		Сток = Новый MCP_СтокЛога();
		Сток.Заполнить(Нотификатор, СтрСоединить(_ПутьCLI, "."));
		Команда.ДобавитьЛогВыводаКоманды(Сток);
	КонецЕсли;

	КодВозврата = Команда.Исполнить();
	// При подключённом стоке ПолучитьВывод() пуст (вывод ушёл в сток) — берём из стока.
	Вывод = ?(Сток = Неопределено, Команда.ПолучитьВывод(), Сток.ПолучитьВывод());

	Возврат СтрШаблон("$ %1%2код возврата: %3%2%4", СтрокаЗапуска, Символы.ПС, КодВозврата, Вывод);

КонецФункции

#Область СлужебныеПроцедурыИФункции

Функция Флаг(Имя)
	Возврат ?(СтрДлина(Имя) = 1, "-", "--") + Имя;
КонецФункции

Функция Цитировать(Знач Значение)
	Если СтрНайти(Значение, " ") > 0 Тогда
		Возврат """" + Значение + """";
	КонецЕсли;
	Возврат Значение;
КонецФункции

#КонецОбласти
