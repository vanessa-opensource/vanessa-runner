// BSLLS:MissingVariablesDescription-off Поля autumn (&Лог/&Желудь).
// BSLLS:UnusedLocalMethod-off ПриСозданииОбъекта вызывается рантаймом при Новый.
// BSLLS:MagicNumber-off Шаги и интервалы опроса по умолчанию.
// Запуск внешних процессов и ожидание их завершения - единое место для всех сервисов,
// которым нужен фоновый процесс: клиент и конфигуратор 1С, сервер отладки dbgs, утилита
// покрываемых строк. Все ожидания - опросом с шагом: блокирующий Процесс.ОжидатьЗавершения
// не даёт ни наблюдателя (healthcheck), ни таймаута.
//
// Процесс - штатный Процесс OneScript либо duck-typed объект с полями Завершен, КодВозврата
// и методом Завершить() (стабы в юнит-тестах).
//
// Командная строка в лог здесь не пишется: в ней бывают пароли, маскировать их умеет
// только вызывающий сервис.

&Лог("vrunner")
Перем Лог;

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Запустить процесс, не дожидаясь завершения.
//
// Параметры:
//   СтрокаЗапуска - Строка - командная строка
//   ПеренаправлятьВывод - Булево - перенаправить вывод процесса в поток (см. ПрочитатьВывод).
//       Для долгих процессов с большим выводом не включать: нечитаемый буфер блокирует процесс
//
// Возвращаемое значение:
//   Процесс - запущенный процесс
//
Функция Запустить(Знач СтрокаЗапуска, Знач ПеренаправлятьВывод = Ложь) Экспорт

	Процесс = СоздатьПроцесс(СтрокаЗапуска, , ПеренаправлятьВывод);
	Процесс.Запустить();
	Лог.Отладка("Запущен процесс PID %1", Процесс.Идентификатор);

	Возврат Процесс;

КонецФункции

// Дождаться завершения процесса опросом.
//
// Параметры:
//   Процесс - Процесс - запущенный процесс
//   Наблюдатель - Произвольный, Неопределено - объект с методом ПроверитьПроцесс(Процесс);
//       вызывается раз в ИнтервалНаблюденияМс, пока процесс жив, и может прервать процесс
//       и выбросить исключение (healthcheck)
//   ИнтервалНаблюденияМс - Число - период вызова наблюдателя
//   ШагМс - Число - шаг опроса
//
// Возвращаемое значение:
//   Число - код возврата процесса
//
Функция ОжидатьЗавершения(Знач Процесс, Знач Наблюдатель = Неопределено,
		Знач ИнтервалНаблюденияМс = 60000, Знач ШагМс = 500) Экспорт

	НакопленоМс = 0;
	Пока НЕ Процесс.Завершен Цикл
		Приостановить(ШагМс);
		Если Наблюдатель = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		НакопленоМс = НакопленоМс + ШагМс;
		Если НакопленоМс >= ИнтервалНаблюденияМс Тогда
			НакопленоМс = 0;
			Наблюдатель.ПроверитьПроцесс(Процесс);
		КонецЕсли;
	КонецЦикла;

	Лог.Отладка("Процесс завершён, код возврата %1", Процесс.КодВозврата);
	Возврат Процесс.КодВозврата;

КонецФункции

// Ждать появления файла, которым процесс сигналит готовность, в пределах таймаута.
//
// Параметры:
//   Процесс - Процесс - запущенный процесс
//   ПутьКФайлу - Строка - файл-признак готовности
//   ТаймаутМс - Число - сколько ждать
//   ШагМс - Число - шаг опроса
//
// Возвращаемое значение:
//   Строка - "готов" (файл появился), "умер" (процесс завершился раньше, файла нет),
//            "таймаут" (файла нет, процесс жив)
//
Функция ОжидатьФайла(Знач Процесс, Знач ПутьКФайлу, Знач ТаймаутМс, Знач ШагМс = 200) Экспорт

	Прошло = 0;
	Пока Прошло < ТаймаутМс Цикл
		Если Новый Файл(ПутьКФайлу).Существует() Тогда
			Возврат "готов";
		КонецЕсли;
		Если НЕ Жив(Процесс) Тогда
			Возврат "умер";
		КонецЕсли;
		Приостановить(ШагМс);
		Прошло = Прошло + ШагМс;
	КонецЦикла;

	Если Новый Файл(ПутьКФайлу).Существует() Тогда
		Возврат "готов";
	КонецЕсли;

	Возврат ?(Жив(Процесс), "таймаут", "умер");

КонецФункции

// Жив ли процесс. Если объект не умеет отвечать (частичный стаб) - считаем живым,
// чтобы не обрывать ожидание.
//
// Параметры:
//   Процесс - Процесс, Неопределено - процесс
//
// Возвращаемое значение:
//   Булево
//
Функция Жив(Знач Процесс) Экспорт

	Если Процесс = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		Возврат НЕ Процесс.Завершен;
	Исключение
		Возврат Истина;
	КонецПопытки;

КонецФункции

// Завершить процесс принудительно, не роняя вызывающего.
//
// Параметры:
//   Процесс - Процесс, Неопределено - процесс; отсутствие процесса - не ошибка
//
// Возвращаемое значение:
//   Булево - Ложь, только если процесс есть, но завершить его не удалось
//
Функция Завершить(Знач Процесс) Экспорт

	Если Процесс = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Попытка
		Процесс.Завершить();
	Исключение
		Лог.Отладка("Не удалось завершить процесс: %1", ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;

	Возврат Истина;

КонецФункции

// Прочитать вывод завершённого процесса.
//
// Параметры:
//   Процесс - Процесс - процесс, запущенный с перенаправлением вывода
//
// Возвращаемое значение:
//   Строка - вывод без обрамляющих пробелов; пусто, если вывод не перенаправлялся
//
Функция ПрочитатьВывод(Знач Процесс) Экспорт

	Попытка
		Возврат СокрЛП(Процесс.ПотокВывода.Прочитать());
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

#КонецОбласти
