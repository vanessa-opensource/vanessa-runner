// BSLLS:UnusedLocalMethod-off ПриСозданииОбъекта вызывается рантаймом при Новый.
// BSLLS:MissingVariablesDescription-off Внутреннее состояние: адрес и ход подбора порта.
// BSLLS:LatinAndCyrillicSymbolInWord-off Технические идентификаторы (HTTP, TCP).
// Адрес локального сервера (хост:порт) и подбор свободного порта - общая часть автономного
// сервера ibsrv (СервисАвтономногоСервера) и сервера отладки dbgs (СервисСервераОтладки).
// Класс не запускает сервер: он выдаёт кандидатов на порт и проверяет, отвечает ли кто-то
// по адресу. Сама попытка старта и остановка остаются за сервисом-владельцем.
//
// Подбор порта: первый кандидат - базовый порт, далее базовый + ШагСдвига * случайный
// множитель (1..МаксимальныйМножитель); случайные сдвиги снижают коллизии параллельных
// прогонов. Предпроверки свободности порта перед стартом намеренно нет (гонка TOCTOU):
// сервис делает реальную попытку старта на каждом кандидате.

Перем _Хост;
Перем _БазовыйПорт;
Перем _Порт;
Перем _ОставшиесяПопытки;
Перем _ШагСдвига;
Перем _МаксимальныйМножитель;
Перем _Генератор;
Перем _Перебранные;

// Параметры:
//   Хост - Строка - хост, на котором слушает сервер
//   БазовыйПорт - Число - порт по умолчанию; он же первый кандидат при подборе
//
Процедура ПриСозданииОбъекта(Знач Хост, Знач БазовыйПорт)

	_Хост = Хост;
	_БазовыйПорт = БазовыйПорт;
	_Порт = БазовыйПорт;
	_ОставшиесяПопытки = 0;
	_ШагСдвига = 0;
	_МаксимальныйМножитель = 0;
	_Генератор = Неопределено;
	_Перебранные = Новый Массив;

КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Хост сервера.
//
// Возвращаемое значение:
//   Строка
//
Функция Хост() Экспорт
	Возврат _Хост;
КонецФункции

// Текущий порт: заданный явно либо последний кандидат подбора; до подбора - базовый.
//
// Возвращаемое значение:
//   Число
//
Функция Порт() Экспорт
	Возврат _Порт;
КонецФункции

// http-адрес сервера.
//
// Возвращаемое значение:
//   Строка - http://<хост>:<порт>
//
Функция Адрес() Экспорт
	Возврат СтрШаблон("http://%1:%2", _Хост, XMLСтрока(_Порт));
КонецФункции

// Сдвиг текущего порта относительно базового. По нему владелец сдвигает и свои
// сопутствующие порты (у ibsrv - прямого соединения, отладки, диапазон подключений).
//
// Возвращаемое значение:
//   Число - 0, если порт базовый
//
Функция Сдвиг() Экспорт
	Возврат _Порт - _БазовыйПорт;
КонецФункции

// Зафиксировать порт без подбора.
//
// Параметры:
//   Порт - Число
//
Процедура УстановитьПорт(Знач Порт) Экспорт
	_Порт = Порт;
КонецПроцедуры

// Начать подбор порта: сбросить перечень перебранных и подготовить генератор сдвигов.
// Кандидаты выдаёт СледующийКандидат().
//
// Параметры:
//   КоличествоПопыток - Число - сколько кандидатов выдать, включая базовый порт
//   ШагСдвига - Число - на что умножается случайный множитель
//   МаксимальныйМножитель - Число - верхняя граница множителя (нижняя - 1)
//
Процедура НачатьПодбор(Знач КоличествоПопыток, Знач ШагСдвига, Знач МаксимальныйМножитель) Экспорт

	_ОставшиесяПопытки = КоличествоПопыток;
	_ШагСдвига = ШагСдвига;
	_МаксимальныйМножитель = МаксимальныйМножитель;
	_Генератор = Новый ГенераторСлучайныхЧисел(ТекущаяУниверсальнаяДатаВМиллисекундах());
	_Перебранные = Новый Массив;

КонецПроцедуры

// Перейти к следующему кандидату на порт: первый - базовый, остальные - случайный сдвиг.
// Выбранный кандидат становится текущим портом и попадает в ПеребранныеПорты().
//
// Возвращаемое значение:
//   Булево - Ложь, когда попытки исчерпаны (порт не меняется)
//
Функция СледующийКандидат() Экспорт

	Если _ОставшиесяПопытки <= 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Если _Перебранные.Количество() = 0 Тогда
		_Порт = _БазовыйПорт;
	Иначе
		_Порт = _БазовыйПорт + _ШагСдвига * _Генератор.СлучайноеЧисло(1, _МаксимальныйМножитель);
	КонецЕсли;

	_Перебранные.Добавить(XMLСтрока(_Порт));
	_ОставшиесяПопытки = _ОставшиесяПопытки - 1;

	Возврат Истина;

КонецФункции

// Порты, выданные с начала подбора, - для сообщения об исчерпании попыток.
//
// Возвращаемое значение:
//   Строка - перечень через запятую, например "1550, 1873"
//
Функция ПеребранныеПорты() Экспорт
	Возврат СтрСоединить(_Перебранные, ", ");
КонецФункции

// Отвечает ли сервер по http: любой ответ на запрос "/" означает, что сервер жив;
// отказ соединения или таймаут (сервер завис, но порт держит) - что мёртв.
//
// Параметры:
//   ТаймаутСек - Число - таймаут проверки в секундах
//
// Возвращаемое значение:
//   Булево
//
Функция ОтвечаетПоHTTP(Знач ТаймаутСек) Экспорт

	Попытка
		Соединение = Новый HTTPСоединение(_Хост, _Порт, , , , ТаймаутСек);
		Соединение.Получить(Новый HTTPЗапрос("/"));
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Свободен ли текущий порт: пробуем поднять на нём слушающий TCP-сервер.
//
// Возвращаемое значение:
//   Булево
//
Функция ПортСвободен() Экспорт

	TCPСервер = Новый TCPСервер(_Порт);
	Попытка
		TCPСервер.Запустить();
	Исключение
		Возврат Ложь;
	КонецПопытки;

	TCPСервер.Остановить();
	Возврат Истина;

КонецФункции

#КонецОбласти
