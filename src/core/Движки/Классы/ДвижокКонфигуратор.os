// BSLLS:LineLength-off
// BSLLS:MissingVariablesDescription-off Поля autumn
// BSLLS:NumberOfOptionalParams-off
// BSLLS:NumberOfParams-off
// BSLLS:LatinAndCyrillicSymbolInWord-off Идентификаторы вида ИнтервалHealthcheckМс (как ПортHttp/Ibsrv).
// BSLLS:Typo-off
// BSLLS:NumberOfValuesInStructureConstructor-off
// BSLLS:MagicNumber-off
// BSLLS:NonExportMethodsInApiRegion-off Чистые функции служебной области экспортированы для юнит-тестов.
// Движок операций с конфигурацией через конфигуратор (v8runner).
// Предоставляет атомарные операции. Оркестрация - в СервисПлатформы.

#Использовать v8runner
#Использовать tempfiles

&Лог("vrunner")
Перем Лог;

&Пластилин
Перем ФайловыеОперации;

&Пластилин
Перем СервисПроцессов;

&Пластилин
Перем СервисОкружения;

// Опциональная фабрика УправлениеКонфигуратором (для юнит-тестов).
// Если задана, должна реализовать метод Создать().
Перем _ФабрикаКонфигуратора;

// Код возврата процесса платформы из последнего запуска с ожиданием.
Перем _КодВозвратаПоследнегоЗапуска;

&Верховный
&Желудь
&Прозвище("ДвижокПлатформы")
Процедура ПриСозданииОбъекта()
	_ФабрикаКонфигуратора = Неопределено;
	_КодВозвратаПоследнегоЗапуска = 0;
КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Создать временную файловую ИБ и вернуть параметры подключения к ней.
//
// Параметры:
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//
// Возвращаемое значение:
//   Структура - СтрокаПодключения, Пользователь, Пароль, КаталогБазы
//
Функция СоздатьВременнуюБазу(Знач ПараметрыПлатформы = Неопределено) Экспорт

	КаталогВременнойИБ = ВременныеФайлы.СоздатьКаталог();
	Лог.Отладка("Создание временной файловой ИБ: %1", КаталогВременнойИБ);
	Конфигуратор = СоздатьКонфигуратор(ПараметрыПлатформы);
	Конфигуратор.СоздатьФайловуюБазу(КаталогВременнойИБ);

	Возврат Новый ПараметрыФайловойИБ().Создать(КаталогВременнойИБ);

КонецФункции

// Загрузить конфигурацию в ИБ из каталога с файлами XML через конфигуратор.
//
// Параметры:
//   ПараметрыПодключения - Структура - параметры подключения к ИБ
//   КаталогИсходников - Строка - путь к каталогу с файлами исходников XML
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//   СписокФайлов - Строка - путь к файлу со списком изменённых файлов
//
Процедура ЗагрузитьКонфигурациюИзФайлов(Знач ПараметрыПодключения, Знач КаталогИсходников, Знач ПараметрыПлатформы = Неопределено, Знач СписокФайлов = "") Экспорт

	Лог.Отладка("Загрузка конфигурации из файлов: %1", КаталогИсходников);
	Конфигуратор = ПодключенныйКонфигуратор(ПараметрыПодключения, ПараметрыПлатформы);
	Конфигуратор.ЗагрузитьКонфигурациюИзФайлов(КаталогИсходников, СписокФайлов);
	Лог.Информация("✓ Конфигурация успешно загружена из файлов: %1", КаталогИсходников);

КонецПроцедуры

// Получить список изменённых файлов конфигурации относительно кеша ConfigDumpInfo.
// При ошибке сравнения кеш удаляется и запрашивается полная загрузка (ibcmd в той же ситуации
// только предупреждает и оставляет инкремент по индексу исходников).
//
// Параметры:
//   ПараметрыПодключения - Структура - параметры подключения к ИБ
//   КаталогИсходников - Строка - путь к каталогу с файлами исходников конфигурации
//   ПутьКФайлуВерсийДляСравнения - Строка - путь к файлу кеша ConfigDumpInfo
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//   ИмяРасширения - Строка - имя расширения (пусто для основной конфигурации)
//
// Возвращаемое значение:
//   Структура - ТребуетсяПолнаяЗагрузка (Булево), ИзмененныеФайлы (Массив из Строка)
//
Функция ПолучитьИзмененияКонфигурации(Знач ПараметрыПодключения, Знач КаталогИсходников, Знач ПутьКФайлуВерсийДляСравнения = "", Знач ПараметрыПлатформы = Неопределено, Знач ИмяРасширения = "") Экспорт

	Разбор = Новый РазборИзмененийКонфигурации;

	ПричинаПропуска = Разбор.ПричинаПропускаСравнения(ПутьКФайлуВерсийДляСравнения);
	Если ЗначениеЗаполнено(ПричинаПропуска) Тогда
		Лог.Отладка("Инкрементальная загрузка: %1, сравнение с конфигуратором пропущено", ПричинаПропуска);
		Возврат Разбор.ПустойРезультат();
	КонецЕсли;

	Лог.Отладка("Инкрементальная загрузка: сравниваем конфигурацию с кешем ConfigDumpInfo: %1", ПутьКФайлуВерсийДляСравнения);
	// Временный файл удаляют РазобратьИУдалить и УдалитьБезопасно ниже.
	ПутьКФайлуИзменений = ПолучитьИмяВременногоФайла(".txt"); // BSLLS:MissingTemporaryFileDeletion-off

	Попытка
		Конфигуратор = ПодключенныйКонфигуратор(ПараметрыПодключения, ПараметрыПлатформы);
		Конфигуратор.ВыгрузитьИзмененияКонфигурацииВФайл(
			КаталогИсходников,
			ПутьКФайлуИзменений,
			ПутьКФайлуВерсийДляСравнения,
			"",
			ИмяРасширения);
		Результат = Разбор.РазобратьИУдалить(ПутьКФайлуИзменений);
	Исключение
		Лог.Отладка("Инкрементальная загрузка: проверка по кешу ConfigDumpInfo завершилась с ошибкой (%1), кеш будет очищен и перестроен", ОписаниеОшибки());
		ФайловыеОперации.УдалитьБезопасно(ПутьКФайлуИзменений);
		ФайловыеОперации.УдалитьБезопасно(ПутьКФайлуВерсийДляСравнения);
		Результат = Разбор.ПустойРезультат();
		Результат.ТребуетсяПолнаяЗагрузка = Истина;
		Возврат Результат;
	КонецПопытки;

	Если Результат.ТребуетсяПолнаяЗагрузка Тогда
		Лог.Отладка("Инкрементальная загрузка: конфигуратор сообщает о полной перезагрузке конфигурации");
	Иначе
		Лог.Отладка("Инкрементальная загрузка: конфигуратор выявил изменений=%1", Результат.ИзмененныеФайлы.Количество());
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Загрузить конфигурацию в ИБ из CF-файла.
//
// Параметры:
//   ПараметрыПодключения - Структура - параметры подключения к ИБ
//   ПутьКФайлуCf - Строка - путь к CF-файлу конфигурации
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//
Процедура ЗагрузитьКонфигурациюИзФайла(Знач ПараметрыПодключения, Знач ПутьКФайлуCf, Знач ПараметрыПлатформы = Неопределено) Экспорт

	Лог.Отладка("Загрузка конфигурации из файла: %1", ПутьКФайлуCf);
	Конфигуратор = ПодключенныйКонфигуратор(ПараметрыПодключения, ПараметрыПлатформы);
	Конфигуратор.ЗагрузитьКонфигурациюИзФайла(ПутьКФайлуCf);
	Лог.Информация("✓ Конфигурация успешно загружена из файла: %1", ПутьКФайлуCf);

КонецПроцедуры

// Выгрузить конфигурацию из ИБ в CF-файл.
//
// Параметры:
//   ПараметрыПодключения - Структура - параметры подключения к ИБ
//   ПутьКФайлуCf - Строка - путь к CF-файлу для выгрузки
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//
Процедура ВыгрузитьКонфигурациюВФайл(Знач ПараметрыПодключения, Знач ПутьКФайлуCf, Знач ПараметрыПлатформы = Неопределено) Экспорт

	Лог.Отладка("Выгрузка конфигурации в файл: %1", ПутьКФайлуCf);
	ФайловыеОперации.ОбеспечитьКаталогДляФайла(ПутьКФайлуCf);
	Конфигуратор = ПодключенныйКонфигуратор(ПараметрыПодключения, ПараметрыПлатформы);
	Конфигуратор.ВыгрузитьКонфигурациюВФайл(ПутьКФайлуCf);
	Лог.Информация("✓ Конфигурация выгружена в файл: %1", ПутьКФайлуCf);

КонецПроцедуры

// Создать полный файл поставки конфигурации из конфигурации указанной ИБ.
// Операция поддерживается только Конфигуратором (/CreateDistributionFiles).
//
// Параметры:
//   ПараметрыПодключения - Структура - параметры подключения к ИБ
//   ПутьКФайлуCf - Строка - путь к полному файлу поставки (*.cf)
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//
Процедура СоздатьФайлыПоставки(Знач ПараметрыПодключения, Знач ПутьКФайлуCf,
		Знач ПараметрыПлатформы = Неопределено) Экспорт

	Лог.Отладка("Создание полного файла поставки конфигурации: %1", ПутьКФайлуCf);
	ФайловыеОперации.ОбеспечитьКаталогДляФайла(ПутьКФайлуCf);
	Конфигуратор = ПодключенныйКонфигуратор(ПараметрыПодключения, ПараметрыПлатформы);
	Конфигуратор.СоздатьФайлыПоставки(ПутьКФайлуCf);
	Лог.Информация("✓ Полный файл поставки конфигурации создан: %1", ПутьКФайлуCf);

КонецПроцедуры

// Выгрузить конфигурацию из ИБ в каталог с файлами XML.
//
// Параметры:
//   ПараметрыПодключения - Структура - параметры подключения к ИБ
//   КаталогВыгрузки - Строка - путь к каталогу для выгрузки
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//
Процедура ВыгрузитьКонфигурациюВФайлы(Знач ПараметрыПодключения, Знач КаталогВыгрузки, Знач ПараметрыПлатформы = Неопределено) Экспорт

	Лог.Отладка("Выгрузка конфигурации в файлы: %1", КаталогВыгрузки);
	Конфигуратор = ПодключенныйКонфигуратор(ПараметрыПодключения, ПараметрыПлатформы);
	Конфигуратор.ВыгрузитьКонфигурациюВФайлы(КаталогВыгрузки);
	Лог.Информация("✓ Конфигурация выгружена в файлы: %1", КаталогВыгрузки);

КонецПроцедуры

// Объединить конфигурацию ИБ с конфигурацией из CF-файла через конфигуратор.
//
// Параметры:
//   ПараметрыПодключения - Структура - параметры подключения к ИБ
//   ПутьКCf - Строка - путь к CF-файлу конфигурации поставщика
//   ФайлНастроек - Строка - путь к файлу правил объединения
//   ПоставитьНаПоддержку - Булево, Неопределено - поставить на поддержку при объединении
//   ВключитьВОбъединениеОбъектыПоНеразрешеннымСсылкам - Булево, Неопределено - включать объекты по неразрешённым ссылкам
//   Принудительно - Булево - выполнить принудительное объединение
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//
Процедура ОбъединитьКонфигурациюСФайлом(Знач ПараметрыПодключения, Знач ПутьКCf, Знач ФайлНастроек,
	Знач ПоставитьНаПоддержку = Неопределено,
	Знач ВключитьВОбъединениеОбъектыПоНеразрешеннымСсылкам = Неопределено,
	Знач Принудительно = Ложь,
	Знач ПараметрыПлатформы = Неопределено) Экспорт

	Лог.Отладка("Объединение конфигурации с файлом: %1, настройки: %2", ПутьКCf, ФайлНастроек);
	Конфигуратор = ПодключенныйКонфигуратор(ПараметрыПодключения, ПараметрыПлатформы);
	Конфигуратор.ОбъединитьКонфигурациюСФайлом(
		ПутьКCf,
		ФайлНастроек,
		ПоставитьНаПоддержку,
		ВключитьВОбъединениеОбъектыПоНеразрешеннымСсылкам,
		Принудительно);
	Лог.Информация("✓ Конфигурация объединена с файлом: %1", ПутьКCf);

КонецПроцедуры

// Обновить конфигурацию ИБ, находящуюся на поддержке, из файла поставщика (/UpdateCfg).
//
// Параметры:
//   ПараметрыПодключения - Структура - параметры подключения к ИБ
//   ПутьКФайлу - Строка - путь к файлу обновления (.cfu) или полному дистрибутиву поставщика (.cf)
//   ФайлНастроек - Строка, Неопределено - путь к файлу настроек объединения
//   ВключитьВОбъединениеОбъектыПоНеразрешеннымСсылкам - Булево, Неопределено - включать объекты по неразрешённым ссылкам
//   Принудительно - Булево - выполнить принудительное обновление при наличии предупреждений
//   ВывестиДваждыИзмененныеСвойства - Булево - вывести список дважды изменённых свойств в файл служебных сообщений
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//
Процедура ОбновитьКонфигурациюИзФайла(Знач ПараметрыПодключения, Знач ПутьКФайлу,
	Знач ФайлНастроек = Неопределено,
	Знач ВключитьВОбъединениеОбъектыПоНеразрешеннымСсылкам = Неопределено,
	Знач Принудительно = Ложь,
	Знач ВывестиДваждыИзмененныеСвойства = Ложь,
	Знач ПараметрыПлатформы = Неопределено) Экспорт

	Лог.Отладка("Обновление конфигурации на поддержке из файла: %1, настройки: %2", ПутьКФайлу, ФайлНастроек);
	Конфигуратор = ПодключенныйКонфигуратор(ПараметрыПодключения, ПараметрыПлатформы);
	Конфигуратор.ОбновитьКонфигурациюИзФайла(
		ПутьКФайлу,
		ФайлНастроек,
		ВключитьВОбъединениеОбъектыПоНеразрешеннымСсылкам,
		Принудительно,
		ВывестиДваждыИзмененныеСвойства);
	Лог.Информация("✓ Конфигурация обновлена из файла поставщика: %1", ПутьКФайлу);

КонецПроцедуры

// Сравнить конфигурацию ИБ с CF-файлом и получить отчёт о различиях.
//
// Параметры:
//   ПараметрыПодключения - Структура - параметры подключения к ИБ
//   ПутьКВторомуCf - Строка - путь к CF-файлу для сравнения
//   ПутьКОтчету - Строка - путь к файлу отчёта о различиях
//   ТипОтчета - Строка - тип отчёта
//   ФорматОтчета - Строка - формат отчёта
//   ПутьКПервомуCf - Строка, Неопределено - путь к первому CF-файлу (если не задан, используется конфигурация ИБ)
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//
// Возвращаемое значение:
//   Строка - путь к файлу отчёта о различиях
//
Функция СравнитьКонфигурации(Знач ПараметрыПодключения, Знач ПутьКВторомуCf, Знач ПутьКОтчету,
	Знач ТипОтчета, Знач ФорматОтчета,
	Знач ПутьКПервомуCf = Неопределено,
	Знач ПараметрыПлатформы = Неопределено) Экспорт

	Режим = ?(ЗначениеЗаполнено(ПутьКПервомуCf), "два файла", "конфигурация базы");
	Лог.Отладка("Сравнение конфигураций: второй=%1, режим=%2", ПутьКВторомуCf, Режим);
	Если НЕ ЗначениеЗаполнено(ПутьКПервомуCf) Тогда
		ПутьКПервомуCf = Неопределено;
	КонецЕсли;
	Конфигуратор = ПодключенныйКонфигуратор(ПараметрыПодключения, ПараметрыПлатформы);
	Конфигуратор.ПолучитьОтчетОСравненииКонфигурацииСФайлом(
		ПутьКВторомуCf,
		ПутьКОтчету,
		ТипОтчета,
		ФорматОтчета,
		,
		ПутьКПервомуCf);

	Возврат ПутьКОтчету;

КонецФункции

// Сравнить расширение конфигурации с CFE-файлом и получить отчёт о различиях.
//
// Параметры:
//   ПараметрыПодключения - Структура - параметры подключения к ИБ
//   ИмяРасширения - Строка - имя расширения в конфигурации
//   ВторойФайл - Строка - путь к CFE-файлу для сравнения
//   ПутьКОтчету - Строка - путь к файлу отчёта о различиях
//   ТипОтчета - Строка - тип отчёта
//   ФорматОтчета - Строка - формат отчёта
//   ПервыйФайл - Строка, Неопределено - путь к первому CFE-файлу (если не задан, используется расширение из базы)
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//
// Возвращаемое значение:
//   Строка - путь к файлу отчёта о различиях
//
Функция СравнитьРасширения(Знач ПараметрыПодключения, Знач ИмяРасширения, Знач ВторойФайл, Знач ПутьКОтчету,
	Знач ТипОтчета, Знач ФорматОтчета,
	Знач ПервыйФайл = Неопределено,
	Знач ПараметрыПлатформы = Неопределено) Экспорт

	Режим = ?(ЗначениеЗаполнено(ПервыйФайл), "два файла", "расширение из базы");
	Лог.Отладка("Сравнение расширений: имя=%1, второй=%2, режим=%3", ИмяРасширения, ВторойФайл, Режим);
	Если НЕ ЗначениеЗаполнено(ПервыйФайл) Тогда
		ПервыйФайл = Неопределено;
	КонецЕсли;
	Конфигуратор = ПодключенныйКонфигуратор(ПараметрыПодключения, ПараметрыПлатформы);
	Конфигуратор.ПолучитьОтчетОСравненииКонфигурацииСФайлом(
		ВторойФайл,
		ПутьКОтчету,
		ТипОтчета,
		ФорматОтчета,
		ИмяРасширения,
		ПервыйФайл);

	Возврат ПутьКОтчету;

КонецФункции

// Создать файловую ИБ в заданном каталоге.
//
// Параметры:
//   КаталогБазы - Строка - путь к каталогу для создания ИБ
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//
// Возвращаемое значение:
//   Структура - СтрокаПодключения, Пользователь, Пароль, КаталогБазы
//
Функция СоздатьФайловуюБазу(Знач КаталогБазы, Знач ПараметрыПлатформы = Неопределено) Экспорт

	Лог.Отладка("Создание файловой ИБ: %1", КаталогБазы);
	Конфигуратор = СоздатьКонфигуратор(ПараметрыПлатформы);
	Конфигуратор.СоздатьФайловуюБазу(КаталогБазы);

	Возврат Новый ПараметрыФайловойИБ().Создать(КаталогБазы);

КонецФункции

// Загрузить данные ИБ из DT-файла.
//
// Параметры:
//   ПараметрыПодключения - Структура - параметры подключения к ИБ
//   ПутьКФайлуDT - Строка - путь к DT-файлу инфобазы
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//
Процедура ЗагрузитьИнфобазуИзФайла(Знач ПараметрыПодключения, Знач ПутьКФайлуDT, Знач ПараметрыПлатформы = Неопределено) Экспорт

	Лог.Отладка("Загрузка инфобазы из файла DT: %1", ПутьКФайлуDT);
	Конфигуратор = ПодключенныйКонфигуратор(ПараметрыПодключения, ПараметрыПлатформы);
	Конфигуратор.ЗагрузитьИнформационнуюБазу(ПутьКФайлуDT);

КонецПроцедуры

// Выгрузить данные ИБ в DT-файл.
//
// Параметры:
//   ПараметрыПодключения - Структура - параметры подключения к ИБ
//   ПутьКФайлуDT - Строка - путь к DT-файлу для выгрузки
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//
Процедура ВыгрузитьИнфобазуВФайл(Знач ПараметрыПодключения, Знач ПутьКФайлуDT, Знач ПараметрыПлатформы = Неопределено) Экспорт

	Лог.Отладка("Выгрузка инфобазы в файл DT: %1", ПутьКФайлуDT);
	ФайловыеОперации.ОбеспечитьКаталогДляФайла(ПутьКФайлуDT);
	Конфигуратор = ПодключенныйКонфигуратор(ПараметрыПодключения, ПараметрыПлатформы);
	Конфигуратор.ВыгрузитьИнформационнуюБазу(ПутьКФайлуDT);

КонецПроцедуры

// Обновить конфигурацию базы данных.
//
// Параметры:
//   ПараметрыПодключения - Структура - параметры подключения к ИБ
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//   НастройкиОбновления - Структура, Неопределено - параметры обновления: ИмяРасширения, ОбновитьВсеРасширения, РежимРеструктуризации
//
Процедура ОбновитьКонфигурациюБД(
	Знач ПараметрыПодключения,
	Знач ПараметрыПлатформы = Неопределено,
	Знач НастройкиОбновления = Неопределено) Экспорт

	НастройкиОбновления = ?(НастройкиОбновления = Неопределено, Новый Структура, НастройкиОбновления);
	РежимРеструктуризации = ЗначениеСвойства(НастройкиОбновления, "РежимРеструктуризации", "");
	ИмяРасширения = ЗначениеСвойства(НастройкиОбновления, "ИмяРасширения", Неопределено);
	ОбновитьВсеРасширения = ЗначениеСвойства(НастройкиОбновления, "ОбновитьВсеРасширения", Ложь);
	ДинамическоеОбновление = ЗначениеСвойства(НастройкиОбновления, "ДинамическоеОбновление", Ложь);

	Лог.Отладка("Обновление конфигурации базы данных, режим: %1", ?(ЗначениеЗаполнено(РежимРеструктуризации), РежимРеструктуризации, "стандартный"));
	Если ОбновитьВсеРасширения Тогда
		Лог.Отладка("У /UpdateDBCfg нет ключа для всех расширений - обновляется конфигурация БД целиком");
	КонецЕсли;
	Конфигуратор = ПодключенныйКонфигуратор(ПараметрыПодключения, ПараметрыПлатформы);
	ЗавершатьСеансы = Ложь;
	Если ЗначениеЗаполнено(РежимРеструктуризации) Тогда
		Конфигуратор.ОбновитьКонфигурациюБазыДанныхНаСервере(
			Ложь, ДинамическоеОбновление, РежимРеструктуризации, ИмяРасширения, ЗавершатьСеансы);
	Иначе
		Конфигуратор.ОбновитьКонфигурациюБазыДанных(
			Ложь, Истина, ДинамическоеОбновление,
			?(ИмяРасширения = Неопределено, "", ИмяРасширения), ЗавершатьСеансы);
	КонецЕсли;
	Лог.Информация("✓ Конфигурация БД обновлена");

КонецПроцедуры

#Область ВнешниеОбработки

// Собрать EPF/ERF-файл внешней обработки из XML-файла исходников через конфигуратор.
//
// Параметры:
//   ПараметрыПодключения - Структура - параметры подключения к ИБ
//   ПутьКФайлуXml - Строка - путь к XML-файлу описания обработки
//   ПутьКФайлуEpf - Строка - путь к результирующему EPF/ERF-файлу
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//
Процедура СобратьВнешнююОбработкуИзФайлов(Знач ПараметрыПодключения, Знач ПутьКФайлуXml, Знач ПутьКФайлуEpf, Знач ПараметрыПлатформы = Неопределено) Экспорт

	Лог.Отладка("Сборка внешней обработки из файлов: %1 → %2", ПутьКФайлуXml, ПутьКФайлуEpf);
	ФайловыеОперации.ОбеспечитьКаталогДляФайла(ПутьКФайлуEpf);
	Конфигуратор = ПодключенныйКонфигуратор(ПараметрыПодключения, ПараметрыПлатформы);

	Параметры = Конфигуратор.ПолучитьПараметрыЗапуска();
	Параметры.Добавить("/LoadExternalDataProcessorOrReportFromFiles");
	Параметры.Добавить("""" + ПутьКФайлуXml + """");
	Параметры.Добавить("""" + ПутьКФайлуEpf + """");

	Лог.Отладка("Выполнение команды конфигуратора с параметрами: /LoadExternalDataProcessorOrReportFromFiles");
	Конфигуратор.ВыполнитьКоманду(Параметры);
	Лог.Информация("✓ Внешняя обработка собрана: %1", ПутьКФайлуEpf);

КонецПроцедуры

// Разобрать EPF/ERF-файл внешней обработки в XML-файлы исходников через конфигуратор.
//
// Параметры:
//   ПараметрыПодключения - Структура - параметры подключения к ИБ
//   ПутьКФайлуEpf - Строка - путь к EPF/ERF-файлу обработки
//   КаталогВыгрузки - Строка - путь к каталогу для выгрузки XML-файлов
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//
Процедура РазобратьВнешнююОбработкуВФайлы(Знач ПараметрыПодключения, Знач ПутьКФайлуEpf, Знач КаталогВыгрузки, Знач ПараметрыПлатформы = Неопределено) Экспорт

	Лог.Отладка("Разборка внешней обработки в файлы: %1 → %2", ПутьКФайлуEpf, КаталогВыгрузки);
	Конфигуратор = ПодключенныйКонфигуратор(ПараметрыПодключения, ПараметрыПлатформы);
	Конфигуратор.ВыгрузитьВнешниеОтчетыИлиОбработкиВФайлы(КаталогВыгрузки, ПутьКФайлуEpf);
	Лог.Информация("✓ Внешняя обработка разобрана в файлы: %1", КаталогВыгрузки);

КонецПроцедуры

#КонецОбласти

#Область Расширения

// Загрузить расширение конфигурации из CFE-файла.
//
// Параметры:
//   ПараметрыПодключения - Структура - параметры подключения к ИБ
//   ПутьКФайлуCfe - Строка - путь к CFE-файлу расширения
//   ИмяРасширения - Строка - имя расширения в конфигурации
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//
Процедура ЗагрузитьРасширениеИзФайла(Знач ПараметрыПодключения, Знач ПутьКФайлуCfe, Знач ИмяРасширения, Знач ПараметрыПлатформы = Неопределено) Экспорт

	Лог.Отладка("Загрузка расширения из файла: %1 (имя=%2)", ПутьКФайлуCfe, ИмяРасширения);
	Конфигуратор = ПодключенныйКонфигуратор(ПараметрыПодключения, ПараметрыПлатформы);
	Конфигуратор.ЗагрузитьРасширениеИзФайла(ПутьКФайлуCfe, ИмяРасширения);
	Лог.Информация("✓ Расширение '%1' загружено из файла: %2", ИмяРасширения, ПутьКФайлуCfe);

КонецПроцедуры

// Выгрузить расширение конфигурации в CFE-файл.
//
// Параметры:
//   ПараметрыПодключения - Структура - параметры подключения к ИБ
//   ПутьКФайлуCfe - Строка - путь к CFE-файлу для выгрузки
//   ИмяРасширения - Строка - имя расширения в конфигурации
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//
Процедура ВыгрузитьРасширениеВФайл(Знач ПараметрыПодключения, Знач ПутьКФайлуCfe, Знач ИмяРасширения, Знач ПараметрыПлатформы = Неопределено) Экспорт

	Лог.Отладка("Выгрузка расширения в файл: %1 (имя=%2)", ПутьКФайлуCfe, ИмяРасширения);
	ФайловыеОперации.ОбеспечитьКаталогДляФайла(ПутьКФайлуCfe);
	Конфигуратор = ПодключенныйКонфигуратор(ПараметрыПодключения, ПараметрыПлатформы);
	Конфигуратор.ВыгрузитьРасширениеВФайл(ПутьКФайлуCfe, ИмяРасширения);
	Лог.Информация("✓ Расширение '%1' выгружено в файл: %2", ИмяРасширения, ПутьКФайлуCfe);

КонецПроцедуры

// Загрузить расширение конфигурации из каталога с файлами XML.
//
// Параметры:
//   ПараметрыПодключения - Структура - параметры подключения к ИБ
//   КаталогИсходников - Строка - путь к каталогу с файлами исходников расширения
//   ИмяРасширения - Строка - имя расширения в конфигурации
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//   СписокФайлов - Строка - путь к файлу со списком изменённых файлов
//
Процедура ЗагрузитьРасширениеИзФайлов(Знач ПараметрыПодключения, Знач КаталогИсходников, Знач ИмяРасширения, Знач ПараметрыПлатформы = Неопределено, Знач СписокФайлов = "") Экспорт

	Лог.Отладка("Загрузка расширения из файлов: %1 (имя=%2)", КаталогИсходников, ИмяРасширения);
	Конфигуратор = ПодключенныйКонфигуратор(ПараметрыПодключения, ПараметрыПлатформы);
	Конфигуратор.ЗагрузитьРасширениеИзФайлов(КаталогИсходников, ИмяРасширения, СписокФайлов);
	Лог.Информация("✓ Расширение '%1' загружено из файлов: %2", ИмяРасширения, КаталогИсходников);

КонецПроцедуры

// Выгрузить расширение конфигурации в каталог с файлами XML.
//
// Параметры:
//   ПараметрыПодключения - Структура - параметры подключения к ИБ
//   КаталогВыгрузки - Строка - путь к каталогу для выгрузки
//   ИмяРасширения - Строка - имя расширения в конфигурации
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//
Процедура ВыгрузитьРасширениеВФайлы(Знач ПараметрыПодключения, Знач КаталогВыгрузки, Знач ИмяРасширения, Знач ПараметрыПлатформы = Неопределено) Экспорт

	Лог.Отладка("Выгрузка расширения в файлы: %1 (имя=%2)", КаталогВыгрузки, ИмяРасширения);
	Конфигуратор = ПодключенныйКонфигуратор(ПараметрыПодключения, ПараметрыПлатформы);
	Конфигуратор.ВыгрузитьРасширениеВФайлы(КаталогВыгрузки, ИмяРасширения);
	Лог.Информация("✓ Расширение '%1' выгружено в файлы: %2", ИмяРасширения, КаталогВыгрузки);

КонецПроцедуры

#КонецОбласти

#Область ПроверкаКонфигурации

// Выполнить проверку конфигурации (syntax-check).
// Использует /CheckConfig конфигуратора с переданными режимами проверки.
//
// Параметры:
//   ПараметрыПодключения - Структура - параметры подключения к ИБ
//   РежимыПроверки - Массив из Строка - режимы проверки (напр. "-ThinClient", "-Server")
//   ПараметрыХранилища - Структура, Неопределено - параметры хранилища (АдресХранилища, Пользователь, Пароль)
//   ПараметрыПлатформы - Структура, Неопределено - параметры платформы
//
// Возвращаемое значение:
//   Структура - Успешно (Булево), ВыводКоманды (Строка)
//
Функция ВыполнитьПроверкуКонфигурации(Знач ПараметрыПодключения, Знач РежимыПроверки, Знач ПараметрыХранилища = Неопределено, Знач ПараметрыПлатформы = Неопределено) Экспорт

	Лог.Отладка("Проверка конфигурации, режимы: %1", СтрСоединить(РежимыПроверки, " "));
	Конфигуратор = ПодключенныйКонфигуратор(ПараметрыПодключения, ПараметрыПлатформы);

	Хранилище = Новый Структура("АдресХранилища, Пользователь, Пароль", "", "", "");
	Если ПараметрыХранилища <> Неопределено
		И ЗначениеЗаполнено(ПараметрыХранилища.АдресХранилища) Тогда
		ЗаполнитьЗначенияСвойств(Хранилище, ПараметрыХранилища);
	КонецЕсли;

	Ключи = Новый Соответствие;
	Для Каждого Режим Из РежимыПроверки Цикл
		Ключи.Вставить(Режим, Истина);
	КонецЦикла;

	Успешно = Истина;
	ВыводКоманды = "";
	Попытка
		Конфигуратор.ВыполнитьРасширеннуюПроверкуКонфигуратора(Ключи,
			Хранилище.АдресХранилища, Хранилище.Пользователь, Хранилище.Пароль);
		ВыводКоманды = Конфигуратор.ВыводКоманды();
	Исключение
		ВыводКоманды = Конфигуратор.ВыводКоманды();
		Успешно = Ложь;
	КонецПопытки;

	Возврат Новый Структура("Успешно, ВыводКоманды", Успешно, ВыводКоманды);

КонецФункции

#КонецОбласти

#Область Запуск

// Запуск 1С:Предприятие.
//
// Параметры:
//   ПараметрыПодключения - Структура - параметры подключения к ИБ
//   ПараметрыЗапуска - Структура - параметры запуска: НеОжидать, РежимЗапуска, КомандаЗапуска,
//     ПутьОбработки, НавигационнаяСсылка, ДополнительныеПараметры, ПутьКФайлуСтатуса
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//
Процедура ЗапуститьПредприятие(Знач ПараметрыПодключения, Знач ПараметрыЗапуска, Знач ПараметрыПлатформы = Неопределено) Экспорт

	Лог.Информация("Выполняю команду/действие в режиме 1С:Предприятие");

	Запуск = ПодготовитьЗапускПлатформы(ПараметрыПодключения, ПараметрыЗапуска, ПараметрыПлатформы,
		"1С:Предприятие запущено", "1С:Предприятие завершено");

	ТолстыйКлиент = ОпределитьТолстыйКлиент(ПараметрыЗапуска.РежимЗапуска);
	Лог.Отладка("НеОжидать = %1, ТолстыйКлиент = %2, РежимЗапуска = %3", Запуск.НеОжидать, ТолстыйКлиент, ПараметрыЗапуска.РежимЗапуска);

	КомандаЗапуска = СформироватьКомандуЗапуска(
		ПараметрыЗапуска.КомандаЗапуска,
		ПараметрыЗапуска.ПутьКФайлуСтатуса);
	КомандаЗапуска = КомандаЗапускаДляОС(КомандаЗапуска, СервисОкружения.ЭтоWindows());

	АргументыПлатформы = Запуск.АргументыПлатформы;
	АргументыПлатформы[ИндексРежимаЗапуска()] = "ENTERPRISE";

	Если ЗначениеЗаполнено(КомандаЗапуска) Тогда
		АргументыПлатформы.Добавить("/C""" + КомандаЗапуска + """");
	КонецЕсли;

	Если ТолстыйКлиент Тогда
		АргументыПлатформы.Добавить("/RunModeOrdinaryApplication");
	КонецЕсли;

	ДополнительныеКлючи = СобратьДополнительныеКлючиПредприятия(ПараметрыЗапуска);
	Если ЗначениеЗаполнено(ДополнительныеКлючи) Тогда
		АргументыПлатформы.Добавить(ДополнительныеКлючи);
	КонецЕсли;

	Запуск.ПутьКПриложению = ?(ТолстыйКлиент,
		Запуск.Конфигуратор.ПутьКПлатформе1С(),
		Запуск.Конфигуратор.ПутьКТонкомуКлиенту1С());
	Запуск.ПутьКФайлуСтатуса = ПараметрыЗапуска.ПутьКФайлуСтатуса;
	Запуск.МониторСервера = ПрочитатьМониторСервера(ПараметрыЗапуска);

	ВыполнитьЗапускПлатформы(Запуск);

КонецПроцедуры

// Запустить конфигуратор с заданными параметрами.
//
// Параметры:
//   ПараметрыПодключения - Структура - параметры подключения к ИБ
//   ПараметрыЗапуска - Структура - параметры запуска: НеОжидать, ДополнительныеПараметры и др.
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//
Процедура ЗапуститьКонфигуратор(Знач ПараметрыПодключения, Знач ПараметрыЗапуска, Знач ПараметрыПлатформы = Неопределено) Экспорт

	Лог.Информация("Выполняю команду Конфигуратора");

	Запуск = ПодготовитьЗапускПлатформы(ПараметрыПодключения, ПараметрыЗапуска, ПараметрыПлатформы,
		"Конфигуратор запущен", "Конфигуратор завершён");

	Лог.Отладка("Конфигуратор: НеОжидать = %1", Запуск.НеОжидать);

	ДобавитьПараметрыХранилища(Запуск.АргументыПлатформы, ПараметрыЗапуска.ПараметрыХранилища);

	Если ЗначениеЗаполнено(ПараметрыЗапуска.ДополнительныеПараметры) Тогда
		Запуск.АргументыПлатформы.Добавить(ПараметрыЗапуска.ДополнительныеПараметры);
	КонецЕсли;

	Запуск.ПутьКПриложению = Запуск.Конфигуратор.ПутьКПлатформе1С();

	ВыполнитьЗапускПлатформы(Запуск);

КонецПроцедуры

// Код возврата процесса платформы из последнего запуска с ожиданием
// (ЗапуститьПредприятие/ЗапуститьКонфигуратор). 0 - успех.
// Позволяет вызывающему коду распознать аварийное завершение платформы,
// когда обработка не записала собственный файл результата.
//
// Возвращаемое значение:
//   Число - код возврата процесса платформы
//
Функция КодВозвратаПоследнегоЗапуска() Экспорт
	Возврат _КодВозвратаПоследнегоЗапуска;
КонецФункции

#КонецОбласти

// Создание настроенного экземпляра УправлениеКонфигуратором.
// Используется для передачи в v8storage МенеджерХранилищаКонфигурации.
//
// Параметры:
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//   ПараметрыПодключения - Структура, Неопределено - параметры подключения к БД
//
// Возвращаемое значение:
//   УправлениеКонфигуратором
//
Функция НовыйКонфигуратор(Знач ПараметрыПлатформы = Неопределено, Знач ПараметрыПодключения = Неопределено) Экспорт

	Если ПараметрыПодключения = Неопределено Тогда
		Возврат СоздатьКонфигуратор(ПараметрыПлатформы);
	КонецЕсли;

	Возврат ПодключенныйКонфигуратор(ПараметрыПодключения, ПараметрыПлатформы);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Общая подготовка запуска платформы (предприятие и конфигуратор): подключённый конфигуратор,
// стандартные аргументы v8runner с перенаправленным /Out и тексты для лога.
// Специфику (режим, ключи, исполняемый файл) вызывающий дописывает в Структуру перед
// ВыполнитьЗапускПлатформы.
//
// Параметры:
//   ПараметрыПодключения - Структура - параметры подключения к ИБ
//   ПараметрыЗапуска - Структура - параметры запуска (используется НеОжидать)
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//   СообщениеЗапущено - Строка - сообщение для лога после запуска без ожидания
//   СообщениеЗавершено - Строка - сообщение для лога после ожидания завершения
//
// Возвращаемое значение:
//   Структура:
//     * Конфигуратор - УправлениеКонфигуратором - подключённый экземпляр
//     * НеОжидать - Булево - режим запуска без ожидания
//     * АргументыПлатформы - Массив из Строка - аргументы командной строки платформы
//     * ФайлВывода - Строка - временный файл /Out (пусто в режиме без ожидания)
//     * ПутьКПриложению - Строка - исполняемый файл платформы (заполняет вызывающий)
//     * СообщениеЗапущено, СообщениеЗавершено - Строка - тексты для лога
//     * ПутьКФайлуСтатуса - Строка - файл статуса exitCodePath (заполняет вызывающий)
//     * МониторСервера - Произвольный, Неопределено - монитор ibsrv (заполняет вызывающий)
//
Функция ПодготовитьЗапускПлатформы(Знач ПараметрыПодключения, Знач ПараметрыЗапуска, Знач ПараметрыПлатформы,
	Знач СообщениеЗапущено, Знач СообщениеЗавершено)

	_КодВозвратаПоследнегоЗапуска = 0;

	Запуск = Новый Структура;
	Запуск.Вставить("Конфигуратор", ПодключенныйКонфигуратор(ПараметрыПодключения, ПараметрыПлатформы));
	Запуск.Вставить("НеОжидать", ПараметрыЗапуска.НеОжидать = Истина);
	Запуск.Вставить("АргументыПлатформы", Запуск.Конфигуратор.ПолучитьПараметрыЗапуска());
	Запуск.Вставить("ФайлВывода", ПодготовитьФайлВыводаПлатформы(Запуск.АргументыПлатформы, Запуск.НеОжидать));
	Запуск.Вставить("ПутьКПриложению", "");
	Запуск.Вставить("СообщениеЗапущено", СообщениеЗапущено);
	Запуск.Вставить("СообщениеЗавершено", СообщениеЗавершено);
	Запуск.Вставить("ПутьКФайлуСтатуса", "");
	Запуск.Вставить("МониторСервера", Неопределено);

	Возврат Запуск;

КонецФункции

// Индекс режима запуска в массиве v8runner.ПолучитьПараметрыЗапуска(): первый элемент -
// DESIGNER, затем строка подключения, затем /Out (см. v8runner СтандартныеПараметрыЗапускаКонфигуратора).
//
// Возвращаемое значение:
//   Число - индекс элемента с режимом запуска
//
Функция ИндексРежимаЗапуска()
	Возврат 0;
КонецФункции

// Подготавливает /Out-параметр в массиве параметров запуска платформы.
// Стандартный /Out от v8runner указывает в рабочий каталог (КаталогСборки =
// ТекущийКаталог), поэтому всегда перенаправляем вывод во временный файл: иначе лог
// платформы остаётся в рабочем каталоге и попадает в git (особенно при запуске без
// ожидания или аварийном завершении). Временный файл вычищается автоматически (ОС/tempfiles).
//
// В режиме ожидания путь возвращается для чтения и удаления вызывающим кодом. В режиме
// без ожидания платформа держит файл открытым и завершается уже после возврата vrunner,
// поэтому удалять его синхронно нельзя - путь не возвращается (пустая строка).
//
// Параметры:
//   АргументыПлатформы - Массив - параметры запуска (элемент /Out заменяется на месте)
//   НеОжидать - Булево - режим запуска без ожидания завершения
//
// Возвращаемое значение:
//   Строка - путь к временному файлу вывода (пустая строка в режиме без ожидания)
//
Функция ПодготовитьФайлВыводаПлатформы(АргументыПлатформы, Знач НеОжидать) Экспорт

	ФайлВывода = ВременныеФайлы.НовоеИмяФайла("log");
	ПараметрВывода = "/Out """ + ФайлВывода + """";

	ИндексВывода = ИндексПараметраВывода(АргументыПлатформы);
	Если ИндексВывода = Неопределено Тогда
		АргументыПлатформы.Добавить(ПараметрВывода);
	Иначе
		АргументыПлатформы[ИндексВывода] = ПараметрВывода;
	КонецЕсли;

	Если НеОжидать Тогда
		Возврат "";
	КонецЕсли;

	Возврат ФайлВывода;

КонецФункции

// Параметры:
//   АргументыПлатформы - Массив из Строка - параметры запуска платформы
//
// Возвращаемое значение:
//   Число, Неопределено - индекс параметра /Out; Неопределено, если его нет
//
Функция ИндексПараметраВывода(Знач АргументыПлатформы)

	Для Индекс = 0 По АргументыПлатформы.ВГраница() Цикл
		Если СтрНачинаетсяС(ВРег(АргументыПлатформы[Индекс]), "/OUT") Тогда
			Возврат Индекс;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Добавляет ключи /ConfigurationRepository* в параметры запуска при наличии параметров хранилища.
//
// Параметры:
//   АргументыПлатформы - Массив - модифицируется добавлением ключей
//   ПараметрыХранилища - Структура, Неопределено - АдресХранилища, Пользователь, Пароль
//
Процедура ДобавитьПараметрыХранилища(АргументыПлатформы, Знач ПараметрыХранилища) Экспорт

	Если ПараметрыХранилища = Неопределено
		Или НЕ ЗначениеЗаполнено(ПараметрыХранилища.АдресХранилища) Тогда
		Возврат;
	КонецЕсли;

	АргументыПлатформы.Добавить("/ConfigurationRepositoryF""" + ПараметрыХранилища.АдресХранилища + """");

	Если ЗначениеЗаполнено(ПараметрыХранилища.Пользователь) Тогда
		АргументыПлатформы.Добавить("/ConfigurationRepositoryN""" + ПараметрыХранилища.Пользователь + """");
	КонецЕсли;
	Если ЗначениеЗаполнено(ПараметрыХранилища.Пароль) Тогда
		АргументыПлатформы.Добавить("/ConfigurationRepositoryP""" + ПараметрыХранилища.Пароль + """");
	КонецЕсли;

КонецПроцедуры

// Собирает дополнительные ключи запуска для режима 1С:Предприятие
// (/Execute, /URL, произвольные параметры).
//
// Параметры:
//   ПараметрыЗапуска - Структура - ПутьОбработки, НавигационнаяСсылка, ДополнительныеПараметры
//
// Возвращаемое значение:
//   Строка - склеенная строка ключей или пустая строка
//
Функция СобратьДополнительныеКлючиПредприятия(Знач ПараметрыЗапуска) Экспорт

	Результат = "";

	Если ЗначениеЗаполнено(ПараметрыЗапуска.ПутьОбработки) Тогда
		Результат = Результат + " /Execute""" + ПараметрыЗапуска.ПутьОбработки + """";
	КонецЕсли;

	Если ЗначениеЗаполнено(ПараметрыЗапуска.НавигационнаяСсылка) Тогда
		Результат = Результат + " /URL""" + ПараметрыЗапуска.НавигационнаяСсылка + """";
	КонецЕсли;

	Если ЗначениеЗаполнено(ПараметрыЗапуска.ДополнительныеПараметры) Тогда
		Результат = Результат + " " + ПараметрыЗапуска.ДополнительныеПараметры;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Склеивает путь к исполняемому файлу платформы и параметры запуска в единую командную строку.
//
// Параметры:
//   ПутьКПриложению - Строка - путь к 1cv8.exe / 1cv8c.exe
//   АргументыПлатформы - Массив - аргументы командной строки
//
// Возвращаемое значение:
//   Строка - готовая командная строка
//
Функция СформироватьКоманднуюСтроку(Знач ПутьКПриложению, Знач АргументыПлатформы) Экспорт

	Если Найти(ПутьКПриложению, " ") > 0 Тогда
		ПутьКПриложению = """" + ПутьКПриложению + """";
	КонецЕсли;

	СтрокаЗапуска = "";
	Для Каждого Параметр Из АргументыПлатформы Цикл
		СтрокаЗапуска = СтрокаЗапуска + " " + Параметр;
	КонецЦикла;

	Возврат ПутьКПриложению + " " + СтрокаЗапуска;

КонецФункции

// Скрыть пароли в командной строке платформы перед выводом в лог: значения ключей /P
// (пароль пользователя ИБ) и /ConfigurationRepositoryP (пароль хранилища) заменяются на ***.
// Правило то же, что у v8runner при выводе своей командной строки.
//
// Параметры:
//   КоманднаяСтрока - Строка - строка запуска платформы
//
// Возвращаемое значение:
//   Строка - строка запуска с замаскированными паролями
//
Функция ЗамаскироватьПароли(Знач КоманднаяСтрока) Экспорт

	Выражение = Новый РегулярноеВыражение("(/ConfigurationRepositoryP|/P)(""[^""]*""|[^\s""]*)");
	Возврат Выражение.Заменить(КоманднаяСтрока, "$1***");

КонецФункции

// Выполняет запуск платформы (с ожиданием или без), обрабатывает файл вывода/статуса
// и гарантированно удаляет временный файл вывода.
//
// Параметры:
//   Запуск - Структура - описание запуска из ПодготовитьЗапускПлатформы, дополненное
//     ПутьКПриложению, ПутьКФайлуСтатуса и МониторСервера
//
Процедура ВыполнитьЗапускПлатформы(Знач Запуск)

	КоманднаяСтрока = СформироватьКоманднуюСтроку(Запуск.ПутьКПриложению, Запуск.АргументыПлатформы);
	Лог.Отладка("Командная строка: %1", ЗамаскироватьПароли(КоманднаяСтрока));

	ОшибкаЗапуска = "";
	Попытка
		Если Запуск.НеОжидать Тогда
			Лог.Отладка("Запускаем без ожидания (ЗапуститьПриложение)");
			ЗапуститьПриложение(КоманднаяСтрока);
			Лог.Информация(Запуск.СообщениеЗапущено);
		Иначе
			Лог.Отладка("Запускаем с ожиданием (ЗапуститьПроцесс1С)");
			ЗапуститьПроцесс1С(КоманднаяСтрока, Запуск.МониторСервера);
			ВывестиФайлПлатформы(Запуск.ФайлВывода);
			Если ЗначениеЗаполнено(Запуск.ПутьКФайлуСтатуса) Тогда
				ОбработатьФайлСтатуса(Запуск.ПутьКФайлуСтатуса);
			КонецЕсли;
			Лог.Информация(Запуск.СообщениеЗавершено);
		КонецЕсли;
	Исключение
		ОшибкаЗапуска = ОписаниеОшибки();
	КонецПопытки;

	// Файл вывода удаляется и при ошибке запуска; в режиме без ожидания путь пуст
	// (см. ПодготовитьФайлВыводаПлатформы), и удалять нечего.
	ФайловыеОперации.УдалитьБезопасно(Запуск.ФайлВывода);

	Если ЗначениеЗаполнено(ОшибкаЗапуска) Тогда
		ВызватьИсключение ОшибкаЗапуска;
	КонецЕсли;

КонецПроцедуры

// Настроенный конфигуратор с установленным контекстом подключения к ИБ.
//
// Параметры:
//   ПараметрыПодключения - Структура - СтрокаПодключения, Пользователь, Пароль
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//
// Возвращаемое значение:
//   УправлениеКонфигуратором
//
Функция ПодключенныйКонфигуратор(Знач ПараметрыПодключения, Знач ПараметрыПлатформы)

	Конфигуратор = СоздатьКонфигуратор(ПараметрыПлатформы);
	УстановитьКонтекст(Конфигуратор, ПараметрыПодключения);
	Возврат Конфигуратор;

КонецФункции

Функция СоздатьКонфигуратор(ПараметрыПлатформы)

	Конфигуратор = СоздатьЭкземплярКонфигуратора();
	// Служебный вывод платформы (/Out по умолчанию - в рабочий каталог) уводится во временный файл.
	Конфигуратор.УстановитьИмяФайлаСообщенийПлатформы(ВременныеФайлы.НовоеИмяФайла("log"));
	НастроитьПлатформу(Конфигуратор, ПараметрыПлатформы);
	Возврат Конфигуратор;

КонецФункции

Функция СоздатьЭкземплярКонфигуратора()
	Если _ФабрикаКонфигуратора <> Неопределено Тогда
		Возврат _ФабрикаКонфигуратора.Создать();
	КонецЕсли;
	Возврат Новый УправлениеКонфигуратором;
КонецФункции

Процедура УстановитьКонтекст(Конфигуратор, ПараметрыПодключения)

	СтрокаПодключения = НормализоватьСтрокуПодключения(ПараметрыПодключения.СтрокаПодключения);

	Лог.Отладка("Установка контекста подключения: строка=%1, пользователь=%2",
		СтрокаПодключения, ПараметрыПодключения.Пользователь);
	Конфигуратор.УстановитьКонтекст(
		СтрокаПодключения,
		ПараметрыПодключения.Пользователь,
		ПараметрыПодключения.Пароль);

КонецПроцедуры

// Привести строку подключения к файловой ИБ к виду /F"<полный путь>".
// Параметры:
//   СтрокаПодключения - Строка - значение опции --ibconnection (/F... или /S...)
//
// Возвращаемое значение:
//   Строка - нормализованная строка подключения; для /S и пустого значения - без изменений
//
Функция НормализоватьСтрокуПодключения(Знач СтрокаПодключения)

	Если ТипЗнч(СтрокаПодключения) <> Тип("Строка") ИЛИ НЕ ЗначениеЗаполнено(СтрокаПодключения) Тогда
		Возврат СтрокаПодключения;
	КонецЕсли;

	Если НЕ СтрНачинаетсяС(ВРег(СокрЛП(СтрокаПодключения)), "/F") Тогда
		Возврат СтрокаПодключения;
	КонецЕсли;

	ПутьКБазе = СокрЛП(Сред(СокрЛП(СтрокаПодключения), 3));
	ПутьКБазе = УбратьКавычки(ПутьКБазе);

	Если НЕ ЗначениеЗаполнено(ПутьКБазе) Тогда
		Возврат СтрокаПодключения;
	КонецЕсли;

	ПутьКБазе = Новый Файл(ПутьКБазе).ПолноеИмя;

	Результат = Новый ПараметрыФайловойИБ().СтрокаПодключения(ПутьКБазе);
	Если Результат <> СтрокаПодключения Тогда
		Лог.Отладка("Строка подключения нормализована: %1 -> %2", СтрокаПодключения, Результат);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция УбратьКавычки(Знач Значение)

	Если СтрДлина(Значение) >= 2 И Лев(Значение, 1) = """" И Прав(Значение, 1) = """" Тогда
		Возврат Сред(Значение, 2, СтрДлина(Значение) - 2);
	КонецЕсли;

	Возврат Значение;

КонецФункции

Процедура НастроитьПлатформу(Конфигуратор, ПараметрыПлатформы)

	Если ПараметрыПлатформы = Неопределено Тогда
		Лог.Отладка("Параметры платформы не установлены, используются значения по умолчанию");
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(ПараметрыПлатформы.ВерсияПлатформы) Тогда
		Лог.Отладка("Установка версии платформы: ""%1""", ПараметрыПлатформы.ВерсияПлатформы);
		Конфигуратор.ИспользоватьВерсиюПлатформы(ПараметрыПлатформы.ВерсияПлатформы);
	КонецЕсли;
	Если ЗначениеЗаполнено(ПараметрыПлатформы.КодРазрешения) Тогда
		Лог.Отладка("Установка ключа разрешения");
		Конфигуратор.УстановитьКлючРазрешенияЗапуска(ПараметрыПлатформы.КодРазрешения);
	КонецЕсли;
	Если ЗначениеЗаполнено(ПараметрыПлатформы.Язык) Тогда
		Лог.Отладка("Установка языка: %1", ПараметрыПлатформы.Язык);
		Конфигуратор.УстановитьКодЯзыка(ПараметрыПлатформы.Язык);
	КонецЕсли;
	Если ЗначениеЗаполнено(ПараметрыПлатформы.Локаль) Тогда
		Лог.Отладка("Установка локали: %1", ПараметрыПлатформы.Локаль);
		Конфигуратор.УстановитьКодЯзыкаСеанса(ПараметрыПлатформы.Локаль);
	КонецЕсли;

КонецПроцедуры

// Значение свойства структуры настроек с подстановкой умолчания: ключ отсутствует
// или равен Неопределено - возвращается значение по умолчанию.
//
// Параметры:
//   Настройки - Структура - настройки операции
//   Имя - Строка - имя свойства
//   ПоУмолчанию - Произвольный - значение при отсутствии свойства
//
// Возвращаемое значение:
//   Произвольный - значение свойства или умолчание
//
Функция ЗначениеСвойства(Знач Настройки, Знач Имя, Знач ПоУмолчанию)

	Значение = Неопределено;
	Если Настройки.Свойство(Имя, Значение) И Значение <> Неопределено Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат ПоУмолчанию;

КонецФункции

// Собирает строку /C из команды запуска и пути к файлу статуса (exitCodePath).
// Путь статуса не дублируется, если он уже задан в команде (exitCodePath=/xddExitCodePath).
//
// Параметры:
//   КомандаЗапуска - Строка - значение опции --command (может быть пустым)
//   ПутьКФайлуСтатуса - Строка - путь к файлу статуса выполнения (может быть пустым)
//
// Возвращаемое значение:
//   Строка - склеенная через ";" команда запуска или пустая строка
//
Функция СформироватьКомандуЗапуска(Знач КомандаЗапуска, Знач ПутьКФайлуСтатуса) Экспорт

	Части = Новый Массив;

	Если ЗначениеЗаполнено(КомандаЗапуска) Тогда
		Части.Добавить(КомандаЗапуска);
	КонецЕсли;

	ПутьСтатусаУжеЕстьВКоманде = ЗначениеЗаполнено(КомандаЗапуска)
		И (СтрНайти(КомандаЗапуска, "xddExitCodePath") > 0
			ИЛИ СтрНайти(КомандаЗапуска, "exitCodePath=") > 0);

	Если ЗначениеЗаполнено(ПутьКФайлуСтатуса) И НЕ ПутьСтатусаУжеЕстьВКоманде Тогда
		Части.Добавить(СтрШаблон("exitCodePath=%1", ПутьКФайлуСтатуса));
	КонецЕсли;

	Если Части.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат СтрСоединить(Части, ";");

КонецФункции

// Значение /C в виде, который платформа получает одинаково на всех версиях OneScript.
//
// На Windows командная строка уходит платформе как есть, и удвоенные кавычки внутри /C"..."
// (правило 1С для кавычки в значении) работают. На Linux/macOS OneScript сам режет строку
// на argv: до 2.2.0 удвоенная кавычка внутри кавычек просто исчезала, и платформа получала
// значение без кавычек; с 2.2.0 она стала экранированной кавычкой, платформа получает
// значение с буквальными кавычками, и пакетный режим xddTestRunner не запускается
// (CI ubuntu, 1С 8.3.25 и 8.5.1). Поэтому вне Windows удвоенные кавычки убираются -
// это ровно то значение, которое платформа получала раньше.
//
// Параметры:
//   КомандаЗапуска - Строка - значение /C
//   ЭтоWindows - Булево - целевая ОС
//
// Возвращаемое значение:
//   Строка - значение /C для передачи платформе
//
Функция КомандаЗапускаДляОС(Знач КомандаЗапуска, Знач ЭтоWindows) Экспорт

	Если ЭтоWindows ИЛИ НЕ ЗначениеЗаполнено(КомандаЗапуска) Тогда
		Возврат КомандаЗапуска;
	КонецЕсли;

	Возврат СтрЗаменить(КомандаЗапуска, """""", "");

КонецФункции

// Определяет толстый/тонкий клиент на основе значения --ordinaryapp.
// "1" → толстый клиент (Истина), "0" → тонкий клиент (Ложь), иначе → тонкий по-умолчанию (Ложь).
//
// Параметры:
//   РежимЗапуска - Строка - значение опции --ordinaryapp ("1" / "0" / пусто)
//
// Возвращаемое значение:
//   Булево - Истина для толстого клиента, Ложь для тонкого
//
Функция ОпределитьТолстыйКлиент(Знач РежимЗапуска) Экспорт

	Возврат РежимЗапуска = "1";

КонецФункции

// Читает и выводит содержимое /Out файла платформы после завершения.
// Удаление файла - ответственность вызывающего кода (он владеет временным файлом).
//
// Параметры:
//   ПутьКФайлу - Строка - путь к файлу /Out, созданному платформой
//
Процедура ВывестиФайлПлатформы(Знач ПутьКФайлу)

	ФайлВывода = Новый Файл(ПутьКФайлу);
	Если НЕ ФайлВывода.Существует() Тогда
		Лог.Отладка("Файл вывода платформы не найден: %1", ПутьКФайлу);
		Возврат;
	КонецЕсли;

	Содержимое = ПрочитатьФайлПлатформыСПовторами(ПутьКФайлу);

	Если ЗначениеЗаполнено(Содержимое) Тогда
		Лог.Информация("Вывод платформы:");
		Лог.Информация(Содержимое);
	КонецЕсли;

КонецПроцедуры

// Читает файл вывода платформы, повторяя попытку при временной блокировке файла.
// Платформа может ещё удерживать /Out файл сразу после завершения процесса,
// что приводит к IOException ("используется другим процессом"). Несколько коротких
// повторов делают захват вывода детерминированным.
//
// Параметры:
//   ПутьКФайлу - Строка - путь к файлу /Out
//
// Возвращаемое значение:
//   Строка - содержимое файла (пустая строка, если прочитать не удалось)
//
Функция ПрочитатьФайлПлатформыСПовторами(Знач ПутьКФайлу)

	Для НомерПопытки = 1 По МаксимумПопытокЧтенияВывода() Цикл
		Попытка
			ЧтениеТекста = Новый ЧтениеТекста(ПутьКФайлу, КодировкаТекста.UTF8);
			Содержимое = ЧтениеТекста.Прочитать();
			ЧтениеТекста.Закрыть();
			Возврат ?(Содержимое = Неопределено, "", Содержимое);
		Исключение
			Если НомерПопытки = МаксимумПопытокЧтенияВывода() Тогда
				Лог.Отладка("Ошибка чтения файла вывода после %1 попыток: %2",
					МаксимумПопытокЧтенияВывода(), ОписаниеОшибки());
				Возврат "";
			КонецЕсли;
			Приостановить(ПаузаМеждуПопыткамиЧтенияМс());
		КонецПопытки;
	КонецЦикла;

	Возврат "";

КонецФункции

// Возвращаемое значение:
//   Число - сколько раз пробовать прочитать файл /Out, пока платформа его отпускает
//
Функция МаксимумПопытокЧтенияВывода()
	Возврат 25;
КонецФункции

// Возвращаемое значение:
//   Число - пауза между попытками чтения файла /Out, мс
//
Функция ПаузаМеждуПопыткамиЧтенияМс()
	Возврат 200;
КонецФункции

// Запуск процесса 1С с ожиданием завершения.
// Ожидаем завершения именно запущенного процесса. При заданном МониторСервера раз в минуту
// проверяется живость автономного сервера (НаблюдательАвтономногоСервера): если он умер,
// а процесс не завершён - процесс прерывается, чтобы vrunner не завис на зависшем клиенте
// (например, в CI).
//
// Параметры:
//   СтрокаЗапуска - Строка - готовая командная строка для запуска платформы
//   МониторСервера - Объект, Неопределено - монитор с методом СерверЖив() для healthcheck-watchdog
//
Процедура ЗапуститьПроцесс1С(Знач СтрокаЗапуска, Знач МониторСервера = Неопределено)

	Процесс = СервисПроцессов.Запустить(СтрокаЗапуска);

	Наблюдатель = Неопределено;
	Если МониторСервера <> Неопределено Тогда
		Наблюдатель = Новый НаблюдательАвтономногоСервера(МониторСервера);
	КонецЕсли;

	_КодВозвратаПоследнегоЗапуска = СервисПроцессов.ОжидатьЗавершения(Процесс, Наблюдатель);

КонецПроцедуры

// Безопасно читает монитор автономного сервера из параметров запуска (опционально).
//
// Параметры:
//   ПараметрыЗапуска - Структура - параметры запуска предприятия
//
// Возвращаемое значение:
//   Произвольный, Неопределено - монитор сервера или Неопределено, если не задан
//
Функция ПрочитатьМониторСервера(Знач ПараметрыЗапуска)
	Возврат ЗначениеСвойства(ПараметрыЗапуска, "МониторСервера", Неопределено);
КонецФункции

// Обрабатывает файл статуса выполнения (exitCodePath).
// 0 = успех, 1 = ошибка (исключение), 2 = предупреждение.
//
// Параметры:
//   ПутьКФайлуСтатуса - Строка - путь к файлу статуса (может быть пустым)
//
Процедура ОбработатьФайлСтатуса(Знач ПутьКФайлуСтатуса) Экспорт

	Если НЕ ЗначениеЗаполнено(ПутьКФайлуСтатуса) Тогда
		Возврат;
	КонецЕсли;

	ФайлСтатуса = Новый Файл(ПутьКФайлуСтатуса);
	Если НЕ ФайлСтатуса.Существует() Тогда
		Лог.Предупреждение("Файл статуса выполнения не найден: %1", ПутьКФайлуСтатуса);
		Возврат;
	КонецЕсли;

	Попытка
		ЧтениеТекста = Новый ЧтениеТекста(ПутьКФайлуСтатуса, "UTF-8");
		СтатусВозврата = СокрЛП(ЧтениеТекста.Прочитать());
		ЧтениеТекста.Закрыть();
	Исключение
		Лог.Ошибка("Ошибка чтения файла статуса: %1", ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	Лог.Отладка("Код возврата: %1", СтатусВозврата);

	Если СтатусВозврата = "0" Тогда
		Лог.Информация("Выполнение в режиме 1С:Предприятие завершено успешно");
	ИначеЕсли СтатусВозврата = "1" Тогда
		ВызватьИсключение "Возникла ошибка при выполнении в режиме 1С:Предприятие! Код возврата: 1";
	ИначеЕсли СтатусВозврата = "2" Тогда
		Лог.Предупреждение("Выполнение команды в режиме 1С:Предприятие завершилось с предупреждением");
	Иначе
		ВызватьИсключение СтрШаблон(
			"Получен неожиданный результат работы - %1
			|Возможно, работа 1С:Предприятие завершилась некорректно.
			|Проверьте журнал регистрации в ИБ.", СтатусВозврата);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
