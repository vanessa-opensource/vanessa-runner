// BSLLS:UnusedLocalMethod-off ПриСозданииОбъекта вызывается рантаймом при Новый.
// BSLLS:MissingVariablesDescription-off Внутреннее состояние наблюдателя.
// Наблюдатель клиентского процесса 1С при работе через автономный сервер ibsrv.
// СервисПроцессов.ОжидатьЗавершения вызывает ПроверитьПроцесс раз в интервал наблюдения:
// если сервер умер, а клиент всё ещё жив - клиент прерывается, чтобы vrunner не завис
// на зависшем клиенте (например, в CI).
//
// Процесс - duck-typed (.Завершен, .Завершить()), монитор - объект с методом СерверЖив().

Перем _МониторСервера;

// Параметры:
//   МониторСервера - Произвольный, Неопределено - монитор автономного сервера (.СерверЖив())
//
Процедура ПриСозданииОбъекта(Знач МониторСервера)
	_МониторСервера = МониторСервера;
КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Прервать зависший процесс платформы, если автономный сервер уже мёртв.
//
// Параметры:
//   Процесс - Произвольный - процесс платформы (.Завершен, .Завершить())
//
Процедура ПроверитьПроцесс(Знач Процесс) Экспорт

	Если _МониторСервера = Неопределено ИЛИ Процесс.Завершен Тогда
		Возврат;
	КонецЕсли;

	Если НЕ _МониторСервера.СерверЖив() Тогда
		Процесс.Завершить();
		ВызватьИсключение "Автономный сервер ibsrv недоступен (healthcheck) - выполнение прервано.";
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
