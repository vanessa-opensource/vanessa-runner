// BSLLS:NumberOfValuesInStructureConstructor-off Структура параметров подключения - четыре поля.
// Параметры подключения к файловой ИБ, которую создал движок платформы.
// Общий для ДвижокКонфигуратор и ДвижокIbcmd ответ СоздатьФайловуюБазу/СоздатьВременнуюБазу:
// строка подключения формата конфигуратора (1cv8) и пустая авторизация.

#Область ПрограммныйИнтерфейс

// Параметры подключения к файловой ИБ в каталоге.
//
// Параметры:
//   КаталогБазы - Строка - путь к каталогу файловой ИБ
//
// Возвращаемое значение:
//   Структура - СтрокаПодключения, Пользователь, Пароль, КаталогБазы
//
Функция Создать(Знач КаталогБазы) Экспорт

	Возврат Новый Структура(
		"СтрокаПодключения, Пользователь, Пароль, КаталогБазы",
		СтрокаПодключения(КаталогБазы), "", "", КаталогБазы);

КонецФункции

// Строка подключения к файловой ИБ для конфигуратора (1cv8).
//
// Параметры:
//   КаталогБазы - Строка - путь к каталогу файловой ИБ
//
// Возвращаемое значение:
//   Строка - строка подключения вида /F"<путь>"
//
Функция СтрокаПодключения(Знач КаталогБазы) Экспорт
	Возврат "/F""" + КаталогБазы + """";
КонецФункции

#КонецОбласти
