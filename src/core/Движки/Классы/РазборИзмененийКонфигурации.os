// BSLLS:UsingSynchronousCalls-off Файловый разбор без интерактивности.
// Разбор файла изменений конфигурации (вывод сравнения с кешем ConfigDumpInfo).
//
// Формат файла - строки вида "modified: Тип.Имя"; маркеры FULLDUMP / "modified: all"
// означают, что инкремент невозможен и нужна полная загрузка. Разбор одинаков для
// конфигуратора и ibcmd, поэтому живёт отдельно от движков.

// Результат без изменений: полная загрузка не требуется, список файлов пуст.
//
// Возвращаемое значение:
//   Структура:
//     * ТребуетсяПолнаяЗагрузка - Булево - Ложь
//     * ИзмененныеФайлы - Массив из Строка - пустой массив
//
Функция ПустойРезультат() Экспорт
	Возврат Новый Структура("ТребуетсяПолнаяЗагрузка, ИзмененныеФайлы", Ложь, Новый Массив);
КонецФункции

// Почему сравнение с кешем ConfigDumpInfo невозможно: кеш не задан или файла нет.
//
// Параметры:
//   ПутьКФайлуВерсийДляСравнения - Строка - путь к файлу кеша ConfigDumpInfo
//
// Возвращаемое значение:
//   Строка - причина пропуска для лога; пустая строка, если сравнение возможно
//
Функция ПричинаПропускаСравнения(Знач ПутьКФайлуВерсийДляСравнения) Экспорт

	Если НЕ ЗначениеЗаполнено(ПутьКФайлуВерсийДляСравнения) Тогда
		Возврат "кеш ConfigDumpInfo не задан";
	КонецЕсли;

	Если НЕ Новый Файл(ПутьКФайлуВерсийДляСравнения).Существует() Тогда
		Возврат СтрШаблон("кеш ConfigDumpInfo не найден (%1)", ПутьКФайлуВерсийДляСравнения);
	КонецЕсли;

	Возврат "";

КонецФункции

// Разобрать временный файл изменений и удалить его.
//
// Параметры:
//   ПутьКФайлуИзменений - Строка - путь к файлу изменений; отсутствие файла - не ошибка
//
// Возвращаемое значение:
//   Структура - см. Разобрать
//
Функция РазобратьИУдалить(Знач ПутьКФайлуИзменений) Экспорт

	Результат = Разобрать(ПутьКФайлуИзменений);
	Если Новый Файл(ПутьКФайлуИзменений).Существует() Тогда
		УдалитьФайлы(ПутьКФайлуИзменений);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Разобрать файл изменений в список относительных путей XML-выгрузки.
//
// Параметры:
//   ПутьКФайлуИзменений - Строка - путь к файлу изменений; отсутствие файла - не ошибка
//
// Возвращаемое значение:
//   Структура:
//     * ТребуетсяПолнаяЗагрузка - Булево - встречен маркер полной перезагрузки
//     * ИзмененныеФайлы - Массив из Строка - относительные пути изменённых файлов (без повторов)
//
Функция Разобрать(Знач ПутьКФайлуИзменений) Экспорт

	Результат = ПустойРезультат();
	ФайлИзменений = Новый Файл(ПутьКФайлуИзменений);
	Если НЕ ФайлИзменений.Существует() Тогда
		Возврат Результат;
	КонецЕсли;

	УникальныеФайлы = Новый Соответствие;
	Чтение = Новый ЧтениеТекста(ПутьКФайлуИзменений, "UTF-8");
	СтрокаИзменения = Чтение.ПрочитатьСтроку();

	Пока СтрокаИзменения <> Неопределено Цикл
		Если ОбработатьСтрокуИзменения(УникальныеФайлы, СокрЛП(СтрокаИзменения)) Тогда
			Результат.ТребуетсяПолнаяЗагрузка = Истина;
			Прервать;
		КонецЕсли;
		СтрокаИзменения = Чтение.ПрочитатьСтроку();
	КонецЦикла;

	Чтение.Закрыть();

	Если НЕ Результат.ТребуетсяПолнаяЗагрузка Тогда
		Для Каждого КлючИЗначение Из УникальныеФайлы Цикл
			Результат.ИзмененныеФайлы.Добавить(КлючИЗначение.Значение);
		КонецЦикла;
	КонецЕсли;

	Возврат Результат;

КонецФункции

#Область СлужебныеПроцедурыИФункции

Функция ОбработатьСтрокуИзменения(УникальныеФайлы, Знач СтрокаИзменения)

	НижнийРегистр = НРег(СтрокаИзменения);

	Если НижнийРегистр = "fulldump" ИЛИ НижнийРегистр = "modified: all" Тогда
		Возврат Истина;
	КонецЕсли;

	Если СтрНачинаетсяС(НижнийРегистр, "modified:") Тогда
		ОтносительныйПуть = ПреобразоватьСтрокуИзмененияВОтносительныйПуть(СтрокаИзменения);
		Ключ = НРег(ОтносительныйПуть);
		Если ЗначениеЗаполнено(ОтносительныйПуть) И УникальныеФайлы[Ключ] = Неопределено Тогда
			УникальныеФайлы.Вставить(Ключ, ОтносительныйПуть);
		КонецЕсли;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

Функция ПреобразоватьСтрокуИзмененияВОтносительныйПуть(Знач СтрокаИзменения)

	СтрокаИзменения = СтрЗаменить(СтрокаИзменения, "modified: ", "");
	СтрокаИзменения = СтрЗаменить(СтрокаИзменения, "Modified: ", "");
	СтрокаИзменения = СокрЛП(СтрокаИзменения);

	Если СтрНачинаетсяС(СтрокаИзменения, "Configuration") Тогда
		Возврат "Configuration.xml";
	КонецЕсли;

	Части = СтрРазделить(СтрокаИзменения, ".", Ложь);
	Если Части.Количество() < 2 Тогда // BSLLS:MagicNumber-off
		Возврат "";
	КонецЕсли;

	КорневойТип = Части[0] + "s";
	ИмяОбъекта = Части[1];

	Возврат КорневойТип + "/" + ИмяОбъекта + ".xml";

КонецФункции

#КонецОбласти
