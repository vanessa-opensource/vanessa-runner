// BSLLS:MissingVariablesDescription-off Поля autumn
// BSLLS:NumberOfValuesInStructureConstructor-off
// Движок операций с конфигурацией через ibcmd (ibcmdrunner).
// Предоставляет атомарные операции. Оркестрация - в СервисПлатформы.

#Использовать ibcmdrunner
#Использовать v8find

&Лог("vrunner")
Перем Лог;

&Пластилин
Перем ФайловыеОперации;

// Опциональная фабрика УправлениеИБ (для юнит-тестов).
// Если задана, должна реализовать метод Создать(ВерсияПлатформы).
Перем _ФабрикаУправленияИБ;

Перем _КаталогДанныхАвтономногоСервера;

&Желудь
&Прозвище("ДвижокПлатформы")
Процедура ПриСозданииОбъекта()
	_ФабрикаУправленияИБ = Неопределено;
	_КаталогДанныхАвтономногоСервера = Неопределено;
КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Создать временную файловую ИБ и вернуть параметры подключения к ней.
//
// Параметры:
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//
// Возвращаемое значение:
//   Структура - СтрокаПодключения, Пользователь, Пароль, КаталогБазы
//
Функция СоздатьВременнуюБазу(Знач ПараметрыПлатформы = Неопределено) Экспорт

	КаталогВременнойИБ = ВременныеФайлы.СоздатьКаталог();
	Лог.Отладка("Создание временной файловой ИБ через ibcmd: %1", КаталогВременнойИБ);
	// ibcmd на Windows не может создать ИБ в уже существующем (пусть и пустом) каталоге -
	// возвращает "Ошибка при работе с файлом". Удаляем заранее созданный каталог.
	ФайловыеОперации.УдалитьБезопасно(КаталогВременнойИБ);
	Менеджер = СоздатьМенеджер(ПараметрыПлатформы);
	Менеджер.УстановитьПараметрыФайловойИБ(КаталогВременнойИБ);
	Менеджер.СоздатьИБ();

	Возврат Новый ПараметрыФайловойИБ().Создать(КаталогВременнойИБ);

КонецФункции

// Загрузить конфигурацию в ИБ из каталога с файлами XML через ibcmd.
//
// Параметры:
//   ПараметрыПодключения - Структура - параметры подключения к ИБ
//   КаталогИсходников - Строка - путь к каталогу с файлами исходников XML
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//   СписокФайлов - Строка - путь к файлу со списком изменённых файлов для инкрементальной загрузки
//
Процедура ЗагрузитьКонфигурациюИзФайлов(Знач ПараметрыПодключения, Знач КаталогИсходников,
		Знач ПараметрыПлатформы = Неопределено, Знач СписокФайлов = "") Экспорт

	КаталогИсходников = АбсолютныйПуть(КаталогИсходников);
	Лог.Отладка("Загрузка конфигурации из файлов через ibcmd: %1", КаталогИсходников);
	Менеджер = ПодключенныйМенеджер(ПараметрыПодключения, ПараметрыПлатформы);
	ЗагрузитьИзФайлов(Менеджер, КаталогИсходников, "", СписокФайлов);
	Лог.Информация("✓ Конфигурация успешно загружена из файлов через ibcmd: %1", КаталогИсходников);

КонецПроцедуры

// Получить список изменённых файлов конфигурации относительно кеша ConfigDumpInfo.
// При ошибке сравнения только предупреждает и оставляет инкремент по индексу исходников
// (конфигуратор в той же ситуации удаляет кеш и запрашивает полную загрузку).
//
// Параметры:
//   ПараметрыПодключения - Структура - параметры подключения к ИБ
//   КаталогИсходников - Строка - путь к каталогу с файлами исходников конфигурации
//   ПутьКФайлуВерсийДляСравнения - Строка - путь к файлу кеша ConfigDumpInfo
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//   ИмяРасширения - Строка - имя расширения (пусто для основной конфигурации)
//
// Возвращаемое значение:
//   Структура - ТребуетсяПолнаяЗагрузка (Булево), ИзмененныеФайлы (Массив из Строка)
//
// BSLLS:UnusedParameters-off Полиморфная сигнатура с ДвижокКонфигуратор - параметры в этой реализации не нужны.
Функция ПолучитьИзмененияКонфигурации(Знач ПараметрыПодключения, Знач КаталогИсходников,
		Знач ПутьКФайлуВерсийДляСравнения = "", Знач ПараметрыПлатформы = Неопределено,
		Знач ИмяРасширения = "") Экспорт
// BSLLS:UnusedParameters-on

	Разбор = Новый РазборИзмененийКонфигурации;

	ПричинаПропуска = Разбор.ПричинаПропускаСравнения(ПутьКФайлуВерсийДляСравнения);
	Если ЗначениеЗаполнено(ПричинаПропуска) Тогда
		Лог.Отладка("Инкрементальная загрузка: %1, сравнение через ibcmd пропущено", ПричинаПропуска);
		Возврат Разбор.ПустойРезультат();
	КонецЕсли;

	ПутьКФайлуВерсийДляСравнения = АбсолютныйПуть(ПутьКФайлуВерсийДляСравнения);
	Лог.Отладка("Инкрементальная загрузка: сравниваем конфигурацию с кешем ConfigDumpInfo через ibcmd: %1",
		ПутьКФайлуВерсийДляСравнения);
	// Временный файл удаляют РазобратьИУдалить и УдалитьБезопасно ниже.
	ПутьКФайлуИзменений = ПолучитьИмяВременногоФайла(".txt"); // BSLLS:MissingTemporaryFileDeletion-off

	Попытка
		Менеджер = ПодключенныйМенеджер(ПараметрыПодключения, ПараметрыПлатформы);
		Менеджер.ВыгрузитьВФайлИзмененияКонфигурации(
			ПутьКФайлуИзменений,
			ПутьКФайлуВерсийДляСравнения,
			"",
			Истина);
		Результат = Разбор.РазобратьИУдалить(ПутьКФайлуИзменений);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Лог.Предупреждение("Не удалось получить изменения конфигурации через ibcmd,"
			+ " будет использован только индекс исходников: %1", ТекстОшибки);
		ФайловыеОперации.УдалитьБезопасно(ПутьКФайлуИзменений);
		Возврат Разбор.ПустойРезультат();
	КонецПопытки;

	Если Результат.ТребуетсяПолнаяЗагрузка Тогда
		Лог.Отладка("Инкрементальная загрузка: ibcmd сообщает о полной перезагрузке конфигурации");
	Иначе
		Лог.Отладка("Инкрементальная загрузка: ibcmd выявил изменений=%1", Результат.ИзмененныеФайлы.Количество());
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Загрузить конфигурацию в ИБ из CF-файла.
//
// Параметры:
//   ПараметрыПодключения - Структура - параметры подключения к ИБ
//   ПутьКФайлуCf - Строка - путь к CF-файлу конфигурации
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//
Процедура ЗагрузитьКонфигурациюИзФайла(Знач ПараметрыПодключения, Знач ПутьКФайлуCf,
		Знач ПараметрыПлатформы = Неопределено) Экспорт

	ПутьКФайлуCf = АбсолютныйПуть(ПутьКФайлуCf);
	Лог.Отладка("Загрузка конфигурации из файла через ibcmd: %1", ПутьКФайлуCf);
	Менеджер = ПодключенныйМенеджер(ПараметрыПодключения, ПараметрыПлатформы);
	Менеджер.ЗагрузитьКонфигурацию(ПутьКФайлуCf);
	Лог.Информация("✓ Конфигурация загружена из файла через ibcmd: %1", ПутьКФайлуCf);

КонецПроцедуры

// Выгрузить конфигурацию из ИБ в CF-файл.
//
// Параметры:
//   ПараметрыПодключения - Структура - параметры подключения к ИБ
//   ПутьКФайлуCf - Строка - путь к CF-файлу для выгрузки
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//
Процедура ВыгрузитьКонфигурациюВФайл(Знач ПараметрыПодключения, Знач ПутьКФайлуCf,
		Знач ПараметрыПлатформы = Неопределено) Экспорт

	ПутьКФайлуCf = АбсолютныйПуть(ПутьКФайлуCf);
	Лог.Отладка("Выгрузка конфигурации в файл через ibcmd: %1", ПутьКФайлуCf);
	ФайловыеОперации.ОбеспечитьКаталогДляФайла(ПутьКФайлуCf);
	Менеджер = ПодключенныйМенеджер(ПараметрыПодключения, ПараметрыПлатформы);
	Менеджер.ВыгрузитьКонфигурациюВФайл(ПутьКФайлуCf);
	Лог.Информация("✓ Конфигурация выгружена в файл через ibcmd: %1", ПутьКФайлуCf);

КонецПроцедуры

// Выгрузить конфигурацию из ИБ в каталог с файлами XML.
//
// Параметры:
//   ПараметрыПодключения - Структура - параметры подключения к ИБ
//   КаталогВыгрузки - Строка - путь к каталогу для выгрузки
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//
Процедура ВыгрузитьКонфигурациюВФайлы(Знач ПараметрыПодключения, Знач КаталогВыгрузки,
		Знач ПараметрыПлатформы = Неопределено) Экспорт

	КаталогВыгрузки = АбсолютныйПуть(КаталогВыгрузки);
	Лог.Отладка("Выгрузка конфигурации в файлы через ibcmd: %1", КаталогВыгрузки);
	ФайловыеОперации.ОбеспечитьПустойКаталог(КаталогВыгрузки);
	Менеджер = ПодключенныйМенеджер(ПараметрыПодключения, ПараметрыПлатформы);
	Менеджер.ВыгрузитьКонфигурациюВФайлы(КаталогВыгрузки, "", "", Ложь);
	Лог.Информация("✓ Конфигурация выгружена в файлы через ibcmd: %1", КаталогВыгрузки);

КонецПроцедуры

// Создать файловую ИБ в заданном каталоге.
//
// Параметры:
//   КаталогБазы - Строка - путь к каталогу для создания ИБ
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//
// Возвращаемое значение:
//   Структура - СтрокаПодключения, Пользователь, Пароль, КаталогБазы
//
Функция СоздатьФайловуюБазу(Знач КаталогБазы, Знач ПараметрыПлатформы = Неопределено) Экспорт

	Лог.Отладка("Создание файловой ИБ через ibcmd: %1", КаталогБазы);
	Менеджер = СоздатьМенеджер(ПараметрыПлатформы);
	Менеджер.УстановитьПараметрыФайловойИБ(КаталогБазы);
	Менеджер.СоздатьИБ();

	Возврат Новый ПараметрыФайловойИБ().Создать(КаталогБазы);

КонецФункции

// Загрузить данные ИБ из DT-файла.
//
// Параметры:
//   ПараметрыПодключения - Структура - параметры подключения к ИБ
//   ПутьКФайлуDT - Строка - путь к DT-файлу инфобазы
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//
Процедура ЗагрузитьИнфобазуИзФайла(Знач ПараметрыПодключения, Знач ПутьКФайлуDT, // BSLLS:Typo-off
		Знач ПараметрыПлатформы = Неопределено) Экспорт

	ПутьКФайлуDT = АбсолютныйПуть(ПутьКФайлуDT);
	Лог.Отладка("Загрузка инфобазы из файла DT: %1", ПутьКФайлуDT); // BSLLS:Typo-off
	Менеджер = ПодключенныйМенеджер(ПараметрыПодключения, ПараметрыПлатформы);
	Менеджер.ЗагрузитьДанныеИБ(ПутьКФайлуDT);

КонецПроцедуры

// Выгрузить данные ИБ в DT-файл.
//
// Параметры:
//   ПараметрыПодключения - Структура - параметры подключения к ИБ
//   ПутьКФайлуDT - Строка - путь к DT-файлу для выгрузки
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//
Процедура ВыгрузитьИнфобазуВФайл(Знач ПараметрыПодключения, Знач ПутьКФайлуDT, // BSLLS:Typo-off
		Знач ПараметрыПлатформы = Неопределено) Экспорт

	ПутьКФайлуDT = АбсолютныйПуть(ПутьКФайлуDT);
	Лог.Отладка("Выгрузка инфобазы в файл DT: %1", ПутьКФайлуDT); // BSLLS:Typo-off
	ФайловыеОперации.ОбеспечитьКаталогДляФайла(ПутьКФайлуDT);
	Менеджер = ПодключенныйМенеджер(ПараметрыПодключения, ПараметрыПлатформы);
	Менеджер.ВыгрузитьДанныеИБ(ПутьКФайлуDT);

КонецПроцедуры

// Обновить конфигурацию базы данных.
//
// Параметры:
//   ПараметрыПодключения - Структура - параметры подключения к ИБ
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//   НастройкиОбновления - Структура, Неопределено - параметры обновления:
//                           ИмяРасширения, ОбновитьВсеРасширения, РежимРеструктуризации
//
Процедура ОбновитьКонфигурациюБД(
	Знач ПараметрыПодключения,
	Знач ПараметрыПлатформы = Неопределено,
	Знач НастройкиОбновления = Неопределено) Экспорт

	НастройкиОбновления = ?(НастройкиОбновления = Неопределено, Новый Структура, НастройкиОбновления);
	ИмяРасширения = ЗначениеСвойства(НастройкиОбновления, "ИмяРасширения", "");
	ОбновитьВсеРасширения = ЗначениеСвойства(НастройкиОбновления, "ОбновитьВсеРасширения", Ложь);

	Менеджер = ПодключенныйМенеджер(ПараметрыПодключения, ПараметрыПлатформы);

	Если ОбновитьВсеРасширения Тогда
		ОбновитьВсеРасширенияВнутри(Менеджер);
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(ИмяРасширения) Тогда
		Лог.Отладка("Обновление расширения '%1' через ibcmd", ИмяРасширения);
		Менеджер.ОбновитьКонфигурациюБазыДанных(ИмяРасширения);
		Лог.Информация("✓ Конфигурация расширения '%1' обновлена через ibcmd", ИмяРасширения);
		Возврат;
	КонецЕсли;

	Лог.Отладка("Обновление конфигурации БД через ibcmd (режимы реструктуризации не поддерживаются)");
	Менеджер.ОбновитьКонфигурациюБазыДанных();
	Лог.Информация("✓ Конфигурация БД обновлена через ibcmd");

КонецПроцедуры

#Область Расширения

// Загрузить расширение конфигурации из CFE-файла.
//
// Параметры:
//   ПараметрыПодключения - Структура - параметры подключения к ИБ
//   ПутьКФайлуCfe - Строка - путь к CFE-файлу расширения
//   ИмяРасширения - Строка - имя расширения в конфигурации
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//
Процедура ЗагрузитьРасширениеИзФайла(Знач ПараметрыПодключения, Знач ПутьКФайлуCfe,
		Знач ИмяРасширения, Знач ПараметрыПлатформы = Неопределено) Экспорт

	ПутьКФайлуCfe = АбсолютныйПуть(ПутьКФайлуCfe);
	Лог.Отладка("Загрузка расширения через ibcmd: %1 (имя=%2)", ПутьКФайлуCfe, ИмяРасширения);
	Менеджер = ПодключенныйМенеджер(ПараметрыПодключения, ПараметрыПлатформы);
	Менеджер.ЗагрузитьКонфигурацию(ПутьКФайлуCfe, ИмяРасширения);
	Лог.Информация("✓ Расширение '%1' загружено через ibcmd из: %2", ИмяРасширения, ПутьКФайлуCfe);

КонецПроцедуры

// Выгрузить расширение конфигурации в CFE-файл.
//
// Параметры:
//   ПараметрыПодключения - Структура - параметры подключения к ИБ
//   ПутьКФайлуCfe - Строка - путь к CFE-файлу для выгрузки
//   ИмяРасширения - Строка - имя расширения в конфигурации
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//
Процедура ВыгрузитьРасширениеВФайл(Знач ПараметрыПодключения, Знач ПутьКФайлуCfe,
		Знач ИмяРасширения, Знач ПараметрыПлатформы = Неопределено) Экспорт

	ПутьКФайлуCfe = АбсолютныйПуть(ПутьКФайлуCfe);
	Лог.Отладка("Выгрузка расширения через ibcmd: %1 (имя=%2)", ПутьКФайлуCfe, ИмяРасширения);
	ФайловыеОперации.ОбеспечитьКаталогДляФайла(ПутьКФайлуCfe);
	Менеджер = ПодключенныйМенеджер(ПараметрыПодключения, ПараметрыПлатформы);
	Менеджер.ВыгрузитьКонфигурациюВФайл(ПутьКФайлуCfe, ИмяРасширения);
	Лог.Информация("✓ Расширение '%1' выгружено через ibcmd в: %2", ИмяРасширения, ПутьКФайлуCfe);

КонецПроцедуры

// Загрузить расширение конфигурации из каталога с файлами XML.
//
// Параметры:
//   ПараметрыПодключения - Структура - параметры подключения к ИБ
//   КаталогИсходников - Строка - путь к каталогу с файлами исходников расширения
//   ИмяРасширения - Строка - имя расширения в конфигурации
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//   СписокФайлов - Строка - путь к файлу со списком изменённых файлов
//
Процедура ЗагрузитьРасширениеИзФайлов(Знач ПараметрыПодключения, Знач КаталогИсходников,
		Знач ИмяРасширения, Знач ПараметрыПлатформы = Неопределено, Знач СписокФайлов = "") Экспорт

	КаталогИсходников = АбсолютныйПуть(КаталогИсходников);
	Лог.Отладка("Загрузка расширения из файлов через ibcmd: %1 (имя=%2)", КаталогИсходников, ИмяРасширения);
	Менеджер = ПодключенныйМенеджер(ПараметрыПодключения, ПараметрыПлатформы);
	ЗагрузитьИзФайлов(Менеджер, КаталогИсходников, ИмяРасширения, СписокФайлов);
	Лог.Информация("✓ Расширение '%1' загружено через ibcmd из файлов: %2", ИмяРасширения, КаталогИсходников);

КонецПроцедуры

// Выгрузить расширение конфигурации в каталог с файлами XML.
//
// Параметры:
//   ПараметрыПодключения - Структура - параметры подключения к ИБ
//   КаталогВыгрузки - Строка - путь к каталогу для выгрузки
//   ИмяРасширения - Строка - имя расширения в конфигурации
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//
Процедура ВыгрузитьРасширениеВФайлы(Знач ПараметрыПодключения, Знач КаталогВыгрузки,
		Знач ИмяРасширения, Знач ПараметрыПлатформы = Неопределено) Экспорт

	КаталогВыгрузки = АбсолютныйПуть(КаталогВыгрузки);
	Лог.Отладка("Выгрузка расширения в файлы через ibcmd: %1 (имя=%2)", КаталогВыгрузки, ИмяРасширения);
	ФайловыеОперации.ОбеспечитьПустойКаталог(КаталогВыгрузки);
	Менеджер = ПодключенныйМенеджер(ПараметрыПодключения, ПараметрыПлатформы);
	Менеджер.ВыгрузитьКонфигурациюВФайлы(КаталогВыгрузки, "", ИмяРасширения, Ложь);
	Лог.Информация("✓ Расширение '%1' выгружено через ibcmd в файлы: %2", ИмяРасширения, КаталогВыгрузки);

КонецПроцедуры

// Изменить свойства расширения в ИБ через ibcmd.
//
// Параметры:
//   ПараметрыПодключения - Структура - параметры подключения к ИБ
//   ИмяРасширения - Строка - имя расширения в конфигурации
//   Свойства - Структура - свойства расширения: Активность, БезопасныйРежим и др.
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//
Процедура ИзменитьСвойстваРасширения(Знач ПараметрыПодключения, Знач ИмяРасширения,
		Знач Свойства, Знач ПараметрыПлатформы = Неопределено) Экспорт

	Лог.Отладка("Изменение свойств расширения: %1", ИмяРасширения);
	Менеджер = ПодключенныйМенеджер(ПараметрыПодключения, ПараметрыПлатформы);
	Менеджер.ИзменитьСвойстваРасширения(
		ИмяРасширения,
		Свойства.Активность,
		Свойства.БезопасныйРежим,
		Свойства.ИмяПрофиляБезопасности,
		Свойства.ЗащитаОтОпасныхДействий,
		Свойства.ИспользуетсяВ_РИБ,
		Свойства.ОбластьДействия_ИБ);

КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Загрузка конфигурации или расширения из файлов: выборочная по непустому списку файлов,
// иначе полная.
//
// Параметры:
//   Менеджер - УправлениеИБ - подключённый менеджер
//   КаталогИсходников - Строка - абсолютный путь к каталогу исходников
//   ИмяРасширения - Строка - имя расширения; пусто для основной конфигурации
//   СписокФайлов - Строка - путь к файлу со списком изменённых файлов; может быть пустым
//
Процедура ЗагрузитьИзФайлов(Знач Менеджер, Знач КаталогИсходников, Знач ИмяРасширения, Знач СписокФайлов)

	МассивФайлов = Новый Массив;
	Если ЗначениеЗаполнено(СписокФайлов) Тогда
		МассивФайлов = ПрочитатьМассивФайловИзСписка(СписокФайлов);
	КонецЕсли;

	Если МассивФайлов.Количество() = 0 Тогда
		Менеджер.ЗагрузитьКонфигурациюИзФайлов(КаталогИсходников, ИмяРасширения);
		Возврат;
	КонецЕсли;

	Лог.Отладка("Выборочная загрузка через ibcmd: файлов=%1 (имя=%2)", МассивФайлов.Количество(), ИмяРасширения);
	Менеджер.ЗагрузитьВыбранныеФайлыКонфигурации(КаталогИсходников, МассивФайлов, ИмяРасширения);

КонецПроцедуры

Процедура ОбновитьВсеРасширенияВнутри(Знач Менеджер)

	Лог.Отладка("Обновление всех расширений через ibcmd: получение списка");
	Описания = Менеджер.ОписанияРасширений();
	Если Описания.Количество() = 0 Тогда
		Лог.Информация("✓ Расширений в инфобазе нет - обновление пропущено"); // BSLLS:Typo-off
		Возврат;
	КонецЕсли;

	Лог.Информация("Обновление расширений через ibcmd: найдено %1", Описания.Количество());
	Для Каждого Описание Из Описания Цикл
		Имя = Описание.Получить("name");
		Если НЕ ЗначениеЗаполнено(Имя) Тогда
			Продолжить;
		КонецЕсли;
		Лог.Информация("Обновление расширения '%1' через ibcmd", Имя);
		Менеджер.ОбновитьКонфигурациюБазыДанных(Имя);
	КонецЦикла;
	Лог.Информация("✓ Обновлено расширений через ibcmd: %1", Описания.Количество());

КонецПроцедуры

// Менеджер ibcmd с установленными параметрами ИБ и авторизации.
//
// Параметры:
//   ПараметрыПодключения - Структура - параметры подключения к ИБ
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//
// Возвращаемое значение:
//   УправлениеИБ
//
Функция ПодключенныйМенеджер(Знач ПараметрыПодключения, Знач ПараметрыПлатформы)

	Менеджер = СоздатьМенеджер(ПараметрыПлатформы);
	УстановитьКонтекстИБ(Менеджер, ПараметрыПодключения);
	Возврат Менеджер;

КонецФункции

Функция СоздатьМенеджер(ПараметрыПлатформы)

	ВерсияПлатформы = ПолучитьВерсиюПлатформы(ПараметрыПлатформы);
	Лог.Отладка("Создание УправлениеИБ с версией платформы: ""%1""", ВерсияПлатформы);
	Попытка
		Менеджер = СоздатьЭкземплярУправленияИБ(ВерсияПлатформы);
	Исключение
		Лог.Ошибка("Не удалось создать УправлениеИБ для версии платформы ""%1"": %2", ВерсияПлатформы, ОписаниеОшибки());
		ВызватьИсключение;
	КонецПопытки;
	Менеджер.УстановитьПараметрыАвтономногоСервера(КаталогДанныхАвтономногоСервера());
	Возврат Менеджер;

КонецФункции

// Каталог данных встроенного автономного сервера ibcmd (параметр --data)
// Возвращаемое значение:
//   Строка - путь к существующему каталогу
//
Функция КаталогДанныхАвтономногоСервера()

	Если _КаталогДанныхАвтономногоСервера = Неопределено
		ИЛИ НЕ Новый Файл(_КаталогДанныхАвтономногоСервера).Существует() Тогда
		_КаталогДанныхАвтономногоСервера = ВременныеФайлы.СоздатьКаталог();
		Лог.Отладка("Каталог данных автономного сервера ibcmd: %1", _КаталогДанныхАвтономногоСервера);
	КонецЕсли;

	Возврат _КаталогДанныхАвтономногоСервера;

КонецФункции

Функция СоздатьЭкземплярУправленияИБ(ВерсияПлатформы)
	Если _ФабрикаУправленияИБ <> Неопределено Тогда
		Возврат _ФабрикаУправленияИБ.Создать(ВерсияПлатформы);
	КонецЕсли;
	Возврат Новый УправлениеИБ(ВерсияПлатформы);
КонецФункции

Функция ПолучитьВерсиюПлатформы(ПараметрыПлатформы)

	Если ПараметрыПлатформы <> Неопределено
		И ЗначениеЗаполнено(ПараметрыПлатформы.ВерсияПлатформы) Тогда
		Лог.Отладка("Используется версия платформы из параметров: ""%1""", ПараметрыПлатформы.ВерсияПлатформы);
		Возврат ПараметрыПлатформы.ВерсияПлатформы;
	КонецЕсли;

	Лог.Отладка("Используется версия платформы по умолчанию: 8");
	Возврат "8";

КонецФункции

Процедура УстановитьКонтекстИБ(Менеджер, ПараметрыПодключения)

	ЕстьСУБД = ЗначениеЗаполнено(ЗначениеСвойства(ПараметрыПодключения, "ТипСУБД", ""));

	Если ЕстьСУБД Тогда
		Лог.Отладка("Установка параметров серверной ИБ: СУБД=%1, сервер=%2, БД=%3",
			ПараметрыПодключения.ТипСУБД, ПараметрыПодключения.СерверСУБД, ПараметрыПодключения.ИмяБазыДанных);
		Менеджер.УстановитьПараметрыСервернойИБ(
			ПараметрыПодключения.ТипСУБД,
			ПараметрыПодключения.СерверСУБД,
			ПараметрыПодключения.ИмяБазыДанных,
			ПараметрыПодключения.ПользовательСУБД,
			ПараметрыПодключения.ПарольСУБД);
	Иначе
		КаталогИБ = ИзвлечьКаталогФайловойИБ(ПараметрыПодключения);
		Лог.Отладка("Установка параметров файловой ИБ: каталог=%1", КаталогИБ);
		Менеджер.УстановитьПараметрыФайловойИБ(КаталогИБ);
	КонецЕсли;

	Если ЗначениеЗаполнено(ПараметрыПодключения.Пользователь) Тогда
		Лог.Отладка("Установка параметров авторизации ИБ: пользователь=%1", ПараметрыПодключения.Пользователь);
		Менеджер.УстановитьПараметрыАвторизацииИБ(
			ПараметрыПодключения.Пользователь,
			ПараметрыПодключения.Пароль);
	КонецЕсли;

КонецПроцедуры

Функция ИзвлечьКаталогФайловойИБ(ПараметрыПодключения)

	КаталогБазы = ЗначениеСвойства(ПараметрыПодключения, "КаталогБазы", "");
	Если ЗначениеЗаполнено(КаталогБазы) Тогда
		Лог.Отладка("Извлечен каталог файловой ИБ из КаталогБазы: %1", КаталогБазы);
		Возврат КаталогБазы;
	КонецЕсли;

	Путь = ПараметрыПодключения.СтрокаПодключения;
	Путь = СтрЗаменить(Путь, "/F", "");
	Путь = СтрЗаменить(Путь, """", "");
	Путь = СокрЛП(Путь);
	Путь = Новый Файл(Путь).ПолноеИмя;
	Лог.Отладка("Извлечен каталог файловой ИБ из СтрокаПодключения: %1", Путь);
	Возврат Путь;

КонецФункции

// Значение свойства структуры с подстановкой умолчания: ключ отсутствует
// или равен Неопределено - возвращается значение по умолчанию.
//
// Параметры:
//   Структура - Структура - параметры операции или подключения
//   Имя - Строка - имя свойства
//   ПоУмолчанию - Произвольный - значение при отсутствии свойства
//
// Возвращаемое значение:
//   Произвольный - значение свойства или умолчание
//
Функция ЗначениеСвойства(Знач Структура, Знач Имя, Знач ПоУмолчанию)

	Значение = Неопределено;
	Если Структура.Свойство(Имя, Значение) И Значение <> Неопределено Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат ПоУмолчанию;

КонецФункции

Функция ПрочитатьМассивФайловИзСписка(Знач ПутьКСпискуФайлов)

	МассивФайлов = Новый Массив;
	ФайлСписка = Новый Файл(ПутьКСпискуФайлов);
	Если НЕ ФайлСписка.Существует() Тогда
		Возврат МассивФайлов;
	КонецЕсли;

	Чтение = Новый ЧтениеТекста(ПутьКСпискуФайлов, "UTF-8");
	Строка = Чтение.ПрочитатьСтроку();
	Пока Строка <> Неопределено Цикл
		Строка = СокрЛП(Строка);
		Если ЗначениеЗаполнено(Строка) Тогда
			МассивФайлов.Добавить(Строка);
		КонецЕсли;
		Строка = Чтение.ПрочитатьСтроку();
	КонецЦикла;
	Чтение.Закрыть();

	Возврат МассивФайлов;

КонецФункции

// Привести путь к абсолютному перед передачей в ibcmd.
//
// ibcmd некорректно разбирает относительные пути с префиксом "./" или ".\": корневой каталог
// он открывает, а вложенные файлы ищет уже относительно другого каталога и падает с
// "Операция невозможна: файл <путь> отсутствует либо поврежден" - причём на разных файлах
// от запуска к запуску. Абсолютный путь снимает неоднозначность.
//
// Параметры:
//   Путь - Строка - путь к файлу или каталогу (может быть относительным)
//
// Возвращаемое значение:
//   Строка - абсолютный путь; пустая строка, если путь не задан
//
Функция АбсолютныйПуть(Знач Путь)
	Возврат ФайловыеОперации.ПолныйПуть(Путь);
КонецФункции

#КонецОбласти
