// BSLLS:UnusedLocalMethod-off ПриСозданииОбъекта вызывается рантаймом при Новый.
// Строка подключения к ИБ формата конфигуратора: файловая /F"каталог", серверная /S"сервер\база".
// Голый путь без префикса считается каталогом файловой базы - так строку принимает ibcmd.

Перем _Строка; // Строка - строка подключения без пробелов по краям

Процедура ПриСозданииОбъекта(Знач СтрокаПодключения)

	_Строка = СокрЛП(СтрокаПодключения);

КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Возвращаемое значение:
//   Булево - строка подключения файловой ИБ с префиксом /F (без учёта регистра)
//
Функция ЭтоФайловая() Экспорт
	Возврат СтрНачинаетсяС(ВРег(_Строка), "/F");
КонецФункции

// Возвращаемое значение:
//   Булево - строка подключения серверной ИБ (/S, без учёта регистра)
//
Функция ЭтоСерверная() Экспорт
	Возврат СтрНачинаетсяС(ВРег(_Строка), "/S");
КонецФункции

// Каталог файловой ИБ: путь после /F либо голый путь без префикса - без кавычек, полный.
//
// Возвращаемое значение:
//   Строка - полный путь к каталогу файловой ИБ; пусто - серверная (/S), пустая строка или пустой путь после /F
//
Функция КаталогФайловойБазы() Экспорт

	Если ЭтоСерверная() Тогда
		Возврат "";
	КонецЕсли;

	Путь = ?(ЭтоФайловая(), Сред(_Строка, СтрДлина("/F") + 1), _Строка);
	Путь = СокрЛП(СтрЗаменить(Путь, """", ""));
	Возврат ?(ЗначениеЗаполнено(Путь), Новый Файл(Путь).ПолноеИмя, "");

КонецФункции

#КонецОбласти
