// BSLLS:MissingVariablesDescription-off Поля autumn
// BSLLS:Typo-off (&Лог/&Пластилин/&Напильник) и внутреннее состояние сервиса.
// Сервис окружения приложения.
// Предоставляет пути к корневому каталогу пакета vanessa-runner
// и к рабочему каталогу (CWD на момент запуска).

Перем _КорневойКаталогПакета;
Перем _РабочийКаталог;
Перем _ПутьОСкрипт;

&Желудь
Процедура ПриСозданииОбъекта()

	// Файл находится в <корень>/src/core/Приложение/Классы/ - поднимаемся на 3 уровня вверх
	КаталогФайла = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогSrc = ОбъединитьПути(КаталогФайла, "..", "..");
	_КорневойКаталогПакета = Новый Файл(ОбъединитьПути(КаталогSrc, "..", "..")).ПолноеИмя;

	_РабочийКаталог = ТекущийКаталог();
	_ПутьОСкрипт = НайтиПутьОСкрипт();

КонецПроцедуры

// Корневой каталог установки vanessa-runner (без завершающего разделителя).
// Используется для подстановки переменной $runnerRoot в путях.
//
// Возвращаемое значение:
//   Строка
//
Функция КорневойКаталогПакета() Экспорт
	Возврат _КорневойКаталогПакета;
КонецФункции

// Рабочий каталог на момент запуска (CWD).
//
// Возвращаемое значение:
//   Строка
//
Функция РабочийКаталог() Экспорт
	Возврат _РабочийКаталог;
КонецФункции

// Полный путь к бинарному файлу oscript на текущей платформе.
// Пустая строка, если oscript не найден в PATH.
//
// Возвращаемое значение:
//   Строка
//
Функция ПутьОСкрипт() Экспорт
	Возврат _ПутьОСкрипт;
КонецФункции

// Каталог установки пакета vanessa-add (<каталог oscript>/../lib/add).
// Здесь лежат bddRunner.epf, xddTestRunner.epf и встроенные тесты (tests/smoke).
// Используется для подстановки переменной $addRoot в путях к тестам.
// Пустая строка, если путь к oscript определить не удалось.
//
// Возвращаемое значение:
//   Строка
//
Функция КаталогVanessaADD() Экспорт
	Возврат ВычислитьКаталогVanessaADD(_ПутьОСкрипт);
КонецФункции

// Найти путь к oscript кросс-платформенно.
// На Windows использует «where», на Linux/macOS - «which».
// Это необходимо, т.к. на Windows «which» (из Git) возвращает Unix-путь вида
// /c/Users/..., который неверно интерпретируется в контексте текущего диска.
//
// Возвращаемое значение:
//   Строка
//
Функция НайтиПутьОСкрипт()

	СисИнфо = Новый СистемнаяИнформация;
	ЭтоWindows = СтрНачинаетсяС(Строка(СисИнфо.ТипПлатформы), "Windows");

	Если ЭтоWindows Тогда
		КмдWhere = Новый Команда;
		КмдWhere.УстановитьКоманду("where");
		КмдWhere.ДобавитьПараметр("oscript.exe");
		Если КмдWhere.Исполнить() = 0 Тогда
			Возврат СокрЛП(СтрРазделить(КмдWhere.ПолучитьВывод(), Символы.ПС)[0]);
		КонецЕсли;
	Иначе
		КмдWhich = Новый Команда;
		КмдWhich.УстановитьКоманду("which");
		КмдWhich.ДобавитьПараметр("oscript");
		Если КмдWhich.Исполнить() = 0 Тогда
			Возврат СокрЛП(СтрРазделить(КмдWhich.ПолучитьВывод(), Символы.ПС)[0]);
		КонецЕсли;
	КонецЕсли;

	Возврат "";

КонецФункции

// Вычислить каталог пакета vanessa-add относительно пути к oscript.
// oscript лежит в <установка>/bin, пакеты библиотек - в <установка>/lib,
// поэтому vanessa-add находится в <bin>/../lib/add.
//
// Параметры:
//   ПутьОСкрипт - Строка - полный путь к бинарнику oscript ("" если не найден)
//
// Возвращаемое значение:
//   Строка - полный путь к каталогу add или "" если путь к oscript неизвестен
//
Функция ВычислитьКаталогVanessaADD(Знач ПутьОСкрипт)

	Если НЕ ЗначениеЗаполнено(ПутьОСкрипт) Тогда
		Возврат "";
	КонецЕсли;

	КаталогBin = Новый Файл(ПутьОСкрипт).Путь;
	КаталогLib = ОбъединитьПути(КаталогBin, "..", "lib");
	Возврат Новый Файл(ОбъединитьПути(КаталогLib, "add")).ПолноеИмя;

КонецФункции
