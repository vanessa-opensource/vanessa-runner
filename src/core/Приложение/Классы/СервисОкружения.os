// BSLLS:MissingVariablesDescription-off Поля autumn
// BSLLS:Typo-off (&Лог/&Пластилин/&Напильник) и внутреннее состояние сервиса.
// BSLLS:LatinAndCyrillicSymbolInWord-off Технические имена (vanessa-add, oscript, PATH) в идентификаторах.
// Сервис окружения приложения.
// Предоставляет пути к корневому каталогу пакета vanessa-runner, к рабочему каталогу
// (CWD на момент запуска), к работающему движку OneScript и к пакету vanessa-add.
//
// Пути, зависящие от движка, вычисляются лениво и без запуска внешних процессов:
// каталог движка известен самому OneScript (КаталогПрограммы()), а каталог библиотек,
// куда opm ставит пакеты, - из oscript.cfg рядом с ним (параметр lib.system).
// Поиск oscript в PATH через where/which остаётся запасным вариантом на случай
// нестандартной раскладки установки, когда рядом с движком библиотек нет.

Перем _КорневойКаталогПакета;
Перем _РабочийКаталог;
Перем _ПутьОСкрипт;
Перем _КаталогVanessaADD;

&Желудь
Процедура ПриСозданииОбъекта()

	// Файл находится в <корень>/src/core/Приложение/Классы/ - поднимаемся на 3 уровня вверх
	КаталогФайла = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогSrc = ОбъединитьПути(КаталогФайла, "..", "..");
	_КорневойКаталогПакета = Новый Файл(ОбъединитьПути(КаталогSrc, "..", "..")).ПолноеИмя;

	_РабочийКаталог = ТекущийКаталог();

КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Корневой каталог установки vanessa-runner (без завершающего разделителя).
// Используется для подстановки переменной $runnerRoot в путях.
//
// Возвращаемое значение:
//   Строка
//
Функция КорневойКаталогПакета() Экспорт
	Возврат _КорневойКаталогПакета;
КонецФункции

// Рабочий каталог на момент запуска (CWD).
//
// Возвращаемое значение:
//   Строка
//
Функция РабочийКаталог() Экспорт
	Возврат _РабочийКаталог;
КонецФункции

// Полный путь к исполняемому файлу движка OneScript, под которым работает приложение.
// Пустая строка, если рядом с движком исполняемого файла нет и в PATH oscript не найден.
//
// Возвращаемое значение:
//   Строка
//
Функция ПутьОСкрипт() Экспорт

	Если _ПутьОСкрипт = Неопределено Тогда
		_ПутьОСкрипт = НайтиПутьОСкрипт();
	КонецЕсли;

	Возврат _ПутьОСкрипт;

КонецФункции

// Каталог установки пакета vanessa-add (подкаталог add каталога библиотек OneScript).
// Здесь лежат bddRunner.epf, xddTestRunner.epf и встроенные тесты (tests/smoke).
// Используется для подстановки переменной $addRoot в путях к тестам.
// Пустая строка, если пакет не установлен ни рядом с движком, ни рядом с oscript из PATH.
//
// Возвращаемое значение:
//   Строка
//
Функция КаталогVanessaADD() Экспорт

	Если _КаталогVanessaADD = Неопределено Тогда
		_КаталогVanessaADD = НайтиКаталогVanessaADD();
	КонецЕсли;

	Возврат _КаталогVanessaADD;

КонецФункции

// Каталог системных библиотек OneScript по oscript.cfg рядом с движком: параметр lib.system,
// относительное значение считается от каталога конфига. Экспортирована для юнит-тестов.
//
// Параметры:
//   КаталогДвижка - Строка - каталог с исполняемым файлом oscript и oscript.cfg
//
// Возвращаемое значение:
//   Строка - полный путь к каталогу библиотек; пустая строка, если конфига или параметра нет
//
Функция КаталогСистемныхБиблиотек(Знач КаталогДвижка) Экспорт

	ФайлКонфига = Новый Файл(ОбъединитьПути(КаталогДвижка, "oscript.cfg"));
	Если НЕ ФайлКонфига.Существует() Тогда
		Возврат "";
	КонецЕсли;

	Значение = ЗначениеПараметраКонфига(ФайлКонфига.ПолноеИмя, "lib.system");
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;

	Возврат Новый Файл(ОбъединитьПути(КаталогДвижка, Значение)).ПолноеИмя;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НайтиПутьОСкрипт()

	РядомСДвижком = ОбъединитьПути(КаталогПрограммы(), ИмяИсполняемогоФайлаОСкрипт());
	Если Новый Файл(РядомСДвижком).Существует() Тогда
		Возврат РядомСДвижком;
	КонецЕсли;

	Возврат НайтиОСкриптВPATH();

КонецФункции

// Кандидаты по убыванию надёжности: каталог библиотек из конфига движка, каталог lib рядом
// с движком, каталог lib рядом с oscript из PATH (как искали раньше, ценой запуска процесса).
//
// Возвращаемое значение:
//   Строка - существующий каталог add; пустая строка, если пакет vanessa-add не установлен
//
Функция НайтиКаталогVanessaADD()

	КаталогДвижка = КаталогПрограммы();

	Кандидаты = Новый Массив;
	КаталогБиблиотек = КаталогСистемныхБиблиотек(КаталогДвижка);
	Если ЗначениеЗаполнено(КаталогБиблиотек) Тогда
		Кандидаты.Добавить(ОбъединитьПути(КаталогБиблиотек, "add"));
	КонецЕсли;
	Кандидаты.Добавить(КаталогADDРядомСДвижком(КаталогДвижка));

	Для Каждого Кандидат Из Кандидаты Цикл
		Если Новый Файл(Кандидат).Существует() Тогда
			Возврат Кандидат;
		КонецЕсли;
	КонецЦикла;

	ОСкриптВPATH = НайтиОСкриптВPATH();
	Если ЗначениеЗаполнено(ОСкриптВPATH) Тогда
		Кандидат = КаталогADDРядомСДвижком(Новый Файл(ОСкриптВPATH).Путь);
		Если Новый Файл(Кандидат).Существует() Тогда
			Возврат Кандидат;
		КонецЕсли;
	КонецЕсли;

	Возврат "";

КонецФункции

// oscript лежит в <установка>/bin, пакеты библиотек - в <установка>/lib,
// поэтому vanessa-add находится в <bin>/../lib/add.
//
// Параметры:
//   КаталогДвижка - Строка - каталог с исполняемым файлом oscript
//
// Возвращаемое значение:
//   Строка - полный путь к каталогу add (без проверки существования)
//
Функция КаталогADDРядомСДвижком(Знач КаталогДвижка)

	КаталогLib = ОбъединитьПути(КаталогДвижка, "..", "lib");
	Возврат Новый Файл(ОбъединитьПути(КаталогLib, "add")).ПолноеИмя;

КонецФункции

// Найти oscript в PATH. На Windows используется «where», на Linux/macOS - «which»:
// «which» из Git на Windows возвращает Unix-путь вида /c/Users/..., который неверно
// интерпретируется в контексте текущего диска.
//
// Возвращаемое значение:
//   Строка - полный путь к oscript, пустая строка если не найден
//
Функция НайтиОСкриптВPATH()

	Команда = Новый Команда;
	Команда.УстановитьКоманду(?(ЭтоWindows(), "where", "which"));
	Команда.ДобавитьПараметр(ИмяИсполняемогоФайлаОСкрипт());
	Если Команда.Исполнить() = 0 Тогда
		Возврат СокрЛП(СтрРазделить(Команда.ПолучитьВывод(), Символы.ПС)[0]);
	КонецЕсли;

	Возврат "";

КонецФункции

Функция ИмяИсполняемогоФайлаОСкрипт()
	Возврат ?(ЭтоWindows(), "oscript.exe", "oscript");
КонецФункции

Функция ЭтоWindows()
	Система = Новый СистемнаяИнформация;
	Возврат СтрНачинаетсяС(Строка(Система.ТипПлатформы), "Windows");
КонецФункции

// Значение параметра вида «ключ = значение» из конфига OneScript; строки с # - комментарии.
//
// Параметры:
//   ПутьКФайлу - Строка - путь к oscript.cfg
//   Ключ - Строка - имя параметра, например lib.system
//
// Возвращаемое значение:
//   Строка - значение без обрамляющих пробелов; пустая строка, если параметра нет
//
Функция ЗначениеПараметраКонфига(Знач ПутьКФайлу, Знач Ключ)

	Результат = "";

	Чтение = Новый ЧтениеТекста(ПутьКФайлу, КодировкаТекста.UTF8);
	Строка = Чтение.ПрочитатьСтроку();
	Пока Строка <> Неопределено Цикл
		Строка = СокрЛП(Строка);
		ПозицияРавно = СтрНайти(Строка, "=");
		Если НЕ СтрНачинаетсяС(Строка, "#") И ПозицияРавно > 0
			И СокрЛП(Лев(Строка, ПозицияРавно - 1)) = Ключ Тогда
			Результат = СокрЛП(Сред(Строка, ПозицияРавно + 1));
			Прервать;
		КонецЕсли;
		Строка = Чтение.ПрочитатьСтроку();
	КонецЦикла;
	Чтение.Закрыть();

	Возврат Результат;

КонецФункции

#КонецОбласти
