// BSLLS:UnusedLocalMethod-off ПриСозданииОбъекта вызывается рантаймом при Новый.
// BSLLS:Typo-off Парсеры форматов configor.
// Провайдер деталек configor: файл читается один раз и не монопольно - его одновременно читают
// параллельные запуски, а менеджер параметров опрашивает провайдеры повторно и ошибки чтения глотает.
// Каждый опрос разбирает текст заново: менеджер при слиянии дописывает в значения провайдеров.

Перем _Текст; // Строка - содержимое файла
Перем _Парсер; // Объект - парсер формата configor (РазобратьТекст)

// Параметры:
//   ПутьКФайлу - Строка - путь к файлу деталек: .json, .yaml/.yml или .ini
//
Процедура ПриСозданииОбъекта(Знач ПутьКФайлу)
	Расширение = НРег(Новый Файл(ПутьКФайлу).Расширение);
	Если Расширение = ".json" Тогда
		_Парсер = Новый ПарсерПараметровJSON;
	ИначеЕсли Расширение = ".yaml" ИЛИ Расширение = ".yml" Тогда
		_Парсер = Новый ПарсерПараметровYAML;
	ИначеЕсли Расширение = ".ini" Тогда
		_Парсер = Новый ПарсерПараметровINI;
	Иначе
		ВызватьИсключение СтрШаблон("Неподдерживаемый формат файла настроек %1:"
			+ " ожидается .json, .yaml, .yml или .ini", Расширение);
	КонецЕсли;
	Чтение = Новый ЧтениеТекста(ПутьКФайлу, КодировкаТекста.UTF8, , , Ложь);
	_Текст = Чтение.Прочитать();
	Чтение.Закрыть();
КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Возвращаемое значение:
//   Соответствие - детальки файла, новый экземпляр при каждом вызове
//
Функция ПрочитатьПараметры() Экспорт
	Возврат _Парсер.РазобратьТекст(_Текст);
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Обязательный интерфейс провайдера configor: приоритет и идентификатор задаёт строитель.

Функция Приоритет() Экспорт
	Возврат 0;
КонецФункции

Функция Идентификатор() Экспорт
	Возврат "file";
КонецФункции

Функция ТипПровайдера() Экспорт
	Возврат "memory";
КонецФункции

#КонецОбласти
