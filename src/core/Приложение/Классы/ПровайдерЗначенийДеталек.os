// Провайдер параметров для configor.МенеджерПараметров,
// возвращающий заранее загруженное Соответствие.
//
// Используется в НастройкаПриложения для регистрации источников
// autumn-деталек (файл пакета, файл CWD, файл --settings) с разными
// приоритетами в одном МенеджерПараметров. Слиянием занимается
// сам МенеджерПараметров (ОбъединитьПрочитанныеПараметры — глубокое
// слияние с правилом «побеждает первый по приоритету»).
//
// Это не файловый провайдер (ТипПровайдера = "memory"),
// поэтому МенеджерПараметров не подмешивает в него общие
// настройки поиска файлов.

Перем _Идентификатор;
Перем _Приоритет;
Перем _Параметры;

Процедура ПриСозданииОбъекта(Знач Идентификатор, Знач Приоритет, Знач Параметры)

	Если ТипЗнч(Параметры) <> Тип("Соответствие") Тогда
		ВызватьИсключение "Источником параметров может быть только Соответствие";
	КонецЕсли;

	_Идентификатор = Идентификатор;
	_Приоритет     = Приоритет;
	_Параметры     = Параметры;

КонецПроцедуры

#Область ИнтерфейсПровайдераПараметров

Функция Идентификатор() Экспорт
	Возврат _Идентификатор;
КонецФункции

Функция Приоритет() Экспорт
	Возврат _Приоритет;
КонецФункции

Функция ТипПровайдера() Экспорт
	Возврат "memory";
КонецФункции

Функция ПрочитатьПараметры(Знач НастройкиПровайдера) Экспорт
	Возврат _Параметры;
КонецФункции

#КонецОбласти
