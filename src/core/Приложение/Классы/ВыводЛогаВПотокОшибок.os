// BSLLS:UnusedLocalMethod-off
// Способ вывода logos: события лога пишутся в stderr, stdout остаётся за данными команд.
// Подключается к корневому логгеру через детальки (см. НастройкаПриложения.ВстроенныеДетальки).

#Использовать logos

Перем Запись;        // ЗаписьДанных - поток stderr в кодировке консоли
Перем ЦветаУровней;  // Соответствие - уровень logos -> ЦветКонсоли

// Параметры:
//   СобытиеЛога - СобытиеЛога - событие logos
//
Процедура ВывестиСобытие(Знач СобытиеЛога) Экспорт

	Если НЕ СобытиеПроходитПорог(СобытиеЛога) Тогда
		Возврат;
	КонецЕсли;

	Цвет = ЦветаУровней[СобытиеЛога.ПолучитьУровень()];
	Если Цвет = Неопределено Тогда
		Запись.ЗаписатьСтроку(СобытиеЛога.ПолучитьФорматированноеСообщение());
		Возврат;
	КонецЕсли;

	ИсходныйЦвет = Консоль.ЦветТекста;
	Консоль.ЦветТекста = Цвет;
	Запись.ЗаписатьСтроку(СобытиеЛога.ПолучитьФорматированноеСообщение());
	Консоль.ЦветТекста = ИсходныйЦвет;

КонецПроцедуры

// Уровень аппендера в конфигурации - DEBUG, и logos отдаёт ему события ниже уровня логгера,
// поэтому порог логгера-источника проверяется здесь.
//
// Параметры:
//   СобытиеЛога - СобытиеЛога - событие logos
//
// Возвращаемое значение:
//   Булево - Истина, если уровень события не ниже уровня логгера
//
Функция СобытиеПроходитПорог(Знач СобытиеЛога) Экспорт
	Возврат СобытиеЛога.ПолучитьУровень() >= СобытиеЛога.ПолучитьУровеньЛога();
КонецФункции

// Поток stderr принадлежит процессу и не закрывается.
Процедура Закрыть() Экспорт
КонецПроцедуры

// Параметры:
//   ИмяСвойства - Строка - имя свойства
//   Значение - Произвольный - значение свойства
//
Процедура УстановитьСвойство(Знач ИмяСвойства, Знач Значение) Экспорт
КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта()

	Запись = Новый ЗаписьДанных(Консоль.ОткрытьСтандартныйПотокОшибок(), Консоль.КодировкаВыходногоПотока);

	ЦветаУровней = Новый Соответствие;
	ЦветаУровней.Вставить(УровниЛога.Предупреждение, ЦветКонсоли.Желтый);
	ЦветаУровней.Вставить(УровниЛога.Ошибка, ЦветКонсоли.Красный);
	ЦветаУровней.Вставить(УровниЛога.КритичнаяОшибка, ЦветКонсоли.ТемноКрасный);

КонецПроцедуры
