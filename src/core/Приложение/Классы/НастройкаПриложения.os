// Подготовка СоветДругогоМастера перед созданием контейнера Autumn.
// Парсит --settings из аргументов командной строки и настраивает загрузку файла деталек.
//
// Использование:
//   Настройка = Новый НастройкаПриложения(АргументыКоманднойСтроки);
//   Поделка = Новый Поделка(Настройка.Совет());

Перем _Совет;

Функция Совет() Экспорт
	Возврат _Совет;
КонецФункции

Процедура ПриСозданииОбъекта(Знач Аргументы)

	_Совет = Новый СоветДругогоМастера();

	ФайлНастроек = ИзвлечьФайлНастроек(Аргументы);
	Если ЗначениеЗаполнено(ФайлНастроек) Тогда
		ФайлОбъект = Новый Файл(ФайлНастроек);
		Если НЕ ФайлОбъект.Существует() Тогда
			ВызватьИсключение СтрШаблон("Файл настроек не найден: %1", ФайлНастроек);
		КонецЕсли;
		_Совет.ИмяФайлаСоЗначениямиДеталек(ФайлОбъект.ИмяБезРасширения)
			.ДополнительныйКаталогПоискаФайлаСоЗначениямиДеталек(ФайлОбъект.Путь);
	КонецЕсли;

КонецПроцедуры

Функция ИзвлечьФайлНастроек(Аргументы)

	Для Индекс = 0 По Аргументы.ВГраница() Цикл
		Если Аргументы[Индекс] = "--settings" И Индекс < Аргументы.ВГраница() Тогда
			Возврат Аргументы[Индекс + 1];
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции
