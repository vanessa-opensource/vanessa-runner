// BSLLS:MissingVariablesDescription-off
// BSLLS:MagicNumber-off
// BSLLS:Typo-off
// Совет для Поделки: каскад деталек autumn из встроенных значений, пакетного и проектного
// autumn-properties.json, переменных окружения и файла настроек из опции settings.

#Использовать configor

Перем _Совет;

// Совет с загруженными детальками.
//
// Возвращаемое значение:
//   СоветДругогоМастера - совет для конструктора Поделки
//
Функция Совет() Экспорт
	Возврат _Совет;
КонецФункции

// Параметры:
//   Аргументы - Массив из Строка - аргументы командной строки
//   РабочийКаталог - Строка - каталог проектного autumn-properties.json (по умолчанию - текущий)
//
Процедура ПриСозданииОбъекта(Знач Аргументы = Неопределено, Знач РабочийКаталог = Неопределено)

	Если НЕ ЗначениеЗаполнено(РабочийКаталог) Тогда
		РабочийКаталог = ТекущийКаталог();
	КонецЕсли;

	_Совет = Новый СоветДругогоМастера();

	Слои = Новый Массив;
	ДобавитьСлой(Слои, "autumn-properties-package", ПриоритетПакета(), ПрочитатьФайлJSON(ПутьКНастройкамПакета()));
	ДобавитьСлой(Слои, "autumn-properties-cwd", ПриоритетПроекта(),
		ПрочитатьФайлJSON(ОбъединитьПути(РабочийКаталог, "autumn-properties.json")));
	ДобавитьСлой(Слои, "autumn-properties-env", ПриоритетОкружения(),
		ПрочитатьПеременныеСреды(_Совет.ПрефиксПеременныхСреды()));

	Каскад = СлитьСлои(Слои);
	ФайлНастроек = НайтиФайлНастроек(Аргументы, Каскад.Параметр("vrunner.settings"), РабочийКаталог);
	Если ФайлНастроек <> Неопределено И ФайлНастроек.Существует Тогда
		ДобавитьСлой(Слои, "autumn-properties-settings", ПриоритетФайлаНастроек(),
			ПрочитатьФайлJSON(ФайлНастроек.ПолныйПуть));
		Каскад = СлитьСлои(Слои);
	КонецЕсли;

	Если ВыводЛогов(Каскад) = "stderr" Тогда
		ДобавитьСлой(Слои, "vrunner-log-routing", ПриоритетМаршрутизацииЛога(), ДеталькиВыводаЛоговВПотокОшибок());
		Каскад = СлитьСлои(Слои);
	КонецЕсли;

	Детальки = Каскад.ПрочитанныеПараметры();
	СекцияСтарта = Новый Соответствие;
	СекцияСтарта.Вставить("settings", ОписаниеФайлаНастроек(ФайлНастроек));
	Детальки.Вставить("vrunner-startup", СекцияСтарта);
	_Совет.ЗначенияДеталек(Детальки);

	_Совет.ИмяФайлаСоЗначениямиДеталек("__vrunner_managed_properties__");

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

#Область ПриоритетыСлоев

// Приоритеты провайдеров configor: меньше - важнее, при совпадении ключей побеждает слой
// с меньшим числом. Файл настроек (--settings / VRUNNER_SETTINGS / vrunner.settings) сильнее
// окружения, окружение - проектного файла, проектный - пакетного; маршрутизация лога слабее всех,
// чтобы проектный файл мог переопределить аппендеры.

Функция ПриоритетФайлаНастроек()
	Возврат 1;
КонецФункции

Функция ПриоритетОкружения()
	Возврат 2;
КонецФункции

Функция ПриоритетПроекта()
	Возврат 3;
КонецФункции

Функция ПриоритетПакета()
	Возврат 4;
КонецФункции

Функция ПриоритетМаршрутизацииЛога()
	Возврат 5;
КонецФункции

#КонецОбласти

// Куда писать лог: переменная окружения VRUNNER_LOG_OUTPUT, затем ключ vrunner.log-output.
//
// Параметры:
//   Каскад - МенеджерПараметров - прочитанный каскад деталек
//
// Возвращаемое значение:
//   Строка - "stdout" или "stderr"
//
Функция ВыводЛогов(Знач Каскад)

	Значение = ПолучитьПеременнуюСреды("VRUNNER_LOG_OUTPUT");
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Значение = Каскад.Параметр("vrunner.log-output", "stdout");
	КонецЕсли;

	Значение = НРег(СокрЛП(Значение));
	Если Значение <> "stdout" И Значение <> "stderr" Тогда
		ВызватьИсключение СтрШаблон("Недопустимое значение log-output: %1 (ожидается stdout или stderr)", Значение);
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Маршрутизация всех логгеров в stderr через корневой логгер logos.
// Список аппендеров задан строкой, чтобы проектный файл его заменял, а не дополнял.
// Уровень аппендера DEBUG: порог задаёт логгер (см. ВыводЛогаВПотокОшибок).
//
// Возвращаемое значение:
//   Соответствие - детальки в формате autumn-properties.json
//
Функция ДеталькиВыводаЛоговВПотокОшибок()

	КорневойЛоггер = Новый Соответствие;
	КорневойЛоггер.Вставить("level", "INFO");
	КорневойЛоггер.Вставить("appenders", "stderr");

	Логгеры = Новый Соответствие;
	Логгеры.Вставить("rootLogger", КорневойЛоггер);

	АппендерStderr = Новый Соответствие;
	АппендерStderr.Вставить("type", "ВыводЛогаВПотокОшибок");
	АппендерStderr.Вставить("level", "DEBUG");

	Аппендеры = Новый Соответствие;
	Аппендеры.Вставить("stderr", АппендерStderr);

	Логос = Новый Соответствие;
	Логос.Вставить("logger", Логгеры);
	Логос.Вставить("appender", Аппендеры);

	Результат = Новый Соответствие;
	Результат.Вставить("logos", Логос);

	Возврат Результат;

КонецФункции

// Возвращаемое значение:
//   Строка - путь к autumn-properties.json пакета
//
Функция ПутьКНастройкамПакета()

	// Файл лежит в <корень>/src/core/Приложение/Классы/ - каталог src на 3 уровня выше
	КаталогКласса = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогSrc    = Новый Файл(ОбъединитьПути(КаталогКласса, "..", "..", "..")).ПолноеИмя;

	Возврат ОбъединитьПути(КаталогSrc, "autumn-properties.json");

КонецФункции

// Параметры:
//   Слои - Массив из Структура - слои каскада
//   Имя - Строка - имя провайдера configor
//   Приоритет - Число - приоритет провайдера (меньше - важнее)
//   Значения - Соответствие, Неопределено - значения слоя; пустой слой не добавляется
//
Процедура ДобавитьСлой(Слои, Знач Имя, Знач Приоритет, Знач Значения)

	Если Значения = Неопределено ИЛИ Значения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Слои.Добавить(Новый Структура("Имя, Приоритет, Значения", Имя, Приоритет, Значения));

КонецПроцедуры

// Параметры:
//   Слои - Массив из Структура - слои каскада
//
// Возвращаемое значение:
//   МенеджерПараметров - прочитанный каскад
//
Функция СлитьСлои(Знач Слои)

	Каскад = Новый МенеджерПараметров;
	Для Каждого Слой Из Слои Цикл
		Каскад.ДобавитьПровайдерПараметров(
			Новый ПровайдерЗначенийДеталек(Слой.Имя, Слой.Приоритет, Слой.Значения));
	КонецЦикла;
	Каскад.Прочитать();

	Возврат Каскад;

КонецФункции

// Файл настроек, если он задан. Явно заданный файл (--settings, VRUNNER_SETTINGS) обязан
// существовать, файл из ключа vrunner.settings - необязателен.
//
// Параметры:
//   Аргументы - Массив из Строка, Неопределено - аргументы командной строки
//   ЗначениеКлюча - Произвольный - значение ключа vrunner.settings
//   РабочийКаталог - Строка - каталог для относительного пути
//
// Возвращаемое значение:
//   Структура, Неопределено - Неопределено, если файл не задан:
//     * ПолныйПуть - Строка - полный путь к файлу
//     * Описание - Строка - источник пути для сообщений
//     * Существует - Булево - файл есть на диске
//
Функция НайтиФайлНастроек(Знач Аргументы, Знач ЗначениеКлюча, Знач РабочийКаталог)

	Источник = НайтиИсточникФайлаНастроек(Аргументы, ЗначениеКлюча);
	Если Источник = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПолныйПуть = Новый Файл(ОбъединитьПути(РабочийКаталог, Источник.Путь)).ПолноеИмя;
	Существует = Новый Файл(ПолныйПуть).Существует();

	Если НЕ Существует И Источник.Обязательный Тогда
		ВызватьИсключение СтрШаблон("Файл настроек не найден: %1 (%2)", ПолныйПуть, Источник.Описание);
	КонецЕсли;

	Возврат Новый Структура("ПолныйПуть, Описание, Существует", ПолныйПуть, Источник.Описание, Существует);

КонецФункции

// Параметры:
//   ФайлНастроек - Структура, Неопределено - см. НайтиФайлНастроек
//
// Возвращаемое значение:
//   Строка - описание для отладочного лога
//
Функция ОписаниеФайлаНастроек(Знач ФайлНастроек)

	Если ФайлНастроек = Неопределено Тогда
		Возврат "Файл настроек не задан";
	КонецЕсли;

	Если ФайлНастроек.Существует Тогда
		Возврат СтрШаблон("Файл настроек: %1 (%2)", ФайлНастроек.ПолныйПуть, ФайлНастроек.Описание);
	КонецЕсли;

	Возврат СтрШаблон("Файл настроек %1 (%2) не найден - действуют только настройки проекта",
		ФайлНастроек.ПолныйПуть, ФайлНастроек.Описание);

КонецФункции

// Параметры:
//   Аргументы - Массив из Строка, Неопределено - аргументы командной строки
//   ЗначениеКлюча - Произвольный - значение ключа vrunner.settings
//
// Возвращаемое значение:
//   Структура, Неопределено:
//     * Путь - Строка - путь к файлу
//     * Описание - Строка - источник пути для сообщений
//     * Обязательный - Булево - Истина, если отсутствие файла - ошибка
//
Функция НайтиИсточникФайлаНастроек(Знач Аргументы, Знач ЗначениеКлюча)

	Путь = ИзвлечьФайлНастроек(Аргументы);
	Если ЗначениеЗаполнено(Путь) Тогда
		Возврат ИсточникФайлаНастроек(Путь, "--settings", Истина);
	КонецЕсли;

	Путь = ПолучитьПеременнуюСреды("VRUNNER_SETTINGS");
	Если ЗначениеЗаполнено(Путь) Тогда
		Возврат ИсточникФайлаНастроек(Путь, "VRUNNER_SETTINGS", Истина);
	КонецЕсли;

	Если ТипЗнч(ЗначениеКлюча) = Тип("Строка") И ЗначениеЗаполнено(СокрЛП(ЗначениеКлюча)) Тогда
		Возврат ИсточникФайлаНастроек(СокрЛП(ЗначениеКлюча), "ключ vrunner.settings", Ложь);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ИсточникФайлаНастроек(Знач Путь, Знач Описание, Знач Обязательный)
	Возврат Новый Структура("Путь, Описание, Обязательный", Путь, Описание, Обязательный);
КонецФункции

// Параметры:
//   Аргументы - Массив из Строка, Неопределено - аргументы командной строки
//
// Возвращаемое значение:
//   Строка, Неопределено - значение --settings <файл> или --settings=<файл>
//
Функция ИзвлечьФайлНастроек(Знач Аргументы)

	Если Аргументы = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПрефиксСоЗнакомРавно = "--settings=";

	Для Индекс = 0 По Аргументы.ВГраница() Цикл
		Если Аргументы[Индекс] = "--settings" И Индекс < Аргументы.ВГраница() Тогда
			Возврат Аргументы[Индекс + 1];
		КонецЕсли;
		Если СтрНачинаетсяС(Аргументы[Индекс], ПрефиксСоЗнакомРавно) Тогда
			Возврат Сред(Аргументы[Индекс], СтрДлина(ПрефиксСоЗнакомРавно) + 1);
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Переменные окружения с преобразованием ключей как в configor: "_" -> ".", "__" -> "_".
//
// Параметры:
//   Префикс - Строка - фильтр по имени переменной; может быть пустым
//
// Возвращаемое значение:
//   Соответствие - ключ/значение переменных окружения
//
Функция ПрочитатьПеременныеСреды(Знач Префикс)

	Результат = Новый Соответствие;

	Для Каждого ПеременнаяСреды Из ПеременныеСреды() Цикл

		Ключ = СтрЗаменить(СтрЗаменить(ПеременнаяСреды.Ключ, "_", "."), "..", "_");

		// BSLLS:IfElseIfEndsWithElse-off
		Если ПустаяСтрока(Префикс) Тогда
			Результат.Вставить(Ключ, ПеременнаяСреды.Значение);
		ИначеЕсли СтрНачинаетсяС(НРег(Ключ), НРег(Префикс)) Тогда
			ОчищенныйКлюч = Прав(Ключ, СтрДлина(Ключ) - (СтрДлина(Префикс) + 1));
			Результат.Вставить(ОчищенныйКлюч, ПеременнаяСреды.Значение);
		КонецЕсли;
		// BSLLS:IfElseIfEndsWithElse-on

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Параметры:
//   ПутьКФайлу - Строка - путь к JSON-файлу
//
// Возвращаемое значение:
//   Соответствие, Неопределено - содержимое файла; Неопределено, если файла нет
//
Функция ПрочитатьФайлJSON(Знач ПутьКФайлу)

	Файл = Новый Файл(ПутьКФайлу);
	Если НЕ Файл.Существует() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Результат = Новый ОперацииJSON().Прочитать(ПутьКФайлу);
	Исключение
		ВызватьИсключение СтрШаблон("Не удалось прочитать %1: %2", ПутьКФайлу, ОписаниеОшибки());
	КонецПопытки;

	Если ТипЗнч(Результат) <> Тип("Соответствие") Тогда
		ВызватьИсключение СтрШаблон("Ожидался JSON-объект в %1", ПутьКФайлу);
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти
