// BSLLS:MissingVariablesDescription-off Поля autumn
// BSLLS:MagicNumber-off (&Лог/&Пластилин/&Напильник) и внутреннее состояние сервиса.
// Подготовка СоветДругогоМастера перед созданием контейнера Autumn.
//
// Каскад autumn-деталек (от низшего приоритета к высшему):
//   1. <пакет>/src/autumn-properties.json - встроенные значения по умолчанию;
//   2. <CWD>/autumn-properties.json       - пользовательские override'ы
//                                            из каталога запуска;
//   3. переменные окружения (с префиксом из совета) - override через ENV;
//   4. файл настроек                       - самый высокий приоритет.
//
// Путь к файлу настроек - значение обычной опции settings, и разрешается она как любая
// другая: командная строка (--settings <файл>, --settings=<файл>), переменная окружения
// VRUNNER_SETTINGS, ключ vrunner.settings в уже слитых уровнях 1-3. Разница только в том,
// что происходит это до создания контейнера, потому что значение опции меняет сам каскад.
// Относительный путь считается от рабочего каталога.
//
// Файл, заданный явно (командной строкой или окружением), обязан существовать - иначе
// исключение. Файл из ключа vrunner.settings - необязательный слой (issue #752): проектный
// файл в репозитории его подразумевает, но в CI и у разработчика без своей копии он
// отсутствует, и тогда работают настройки уровней 1-3. Что именно произошло с файлом,
// записывается в детальку vrunner-startup.settings - её выводит в отладочный лог рогатка.
//
// Все источники регистрируются как отдельные провайдеры в локальном
// configor.МенеджерПараметров; глубокое слияние («побеждает первый по
// приоритету») выполняет сам configor через ОбъединитьПрочитанныеПараметры.
// Получившееся Соответствие передаётся в _Совет.ЗначенияДеталек().
//
// Чтобы autumn не пытался ещё раз самостоятельно читать autumn-properties
// из стандартных каталогов, имя файла в совете заменяется на сентинел -
// файл с таким именем заведомо не существует.
//
// Использование: создайте экземпляр НастройкиПриложения с АргументамиКоманднойСтроки
// и передайте результат Настройка.Совет() в конструктор Поделки.
// Второй параметр конструктора (рабочий каталог) нужен тестам; по умолчанию - ТекущийКаталог().

#Использовать configor

Перем _Совет;

// Получить совет для конструктора Поделки с загруженными значениями деталек.
//
// Возвращаемое значение:
//   СоветДругогоМастера - совет с настроенными деталеками для Поделки
//
Функция Совет() Экспорт
	Возврат _Совет;
КонецФункции

Процедура ПриСозданииОбъекта(Знач Аргументы = Неопределено, Знач РабочийКаталог = Неопределено)

	Если НЕ ЗначениеЗаполнено(РабочийКаталог) Тогда
		РабочийКаталог = ТекущийКаталог();
	КонецЕсли;

	_Совет = Новый СоветДругогоМастера();

	Слои = Новый Массив;
	ДобавитьСлой(Слои, "autumn-properties-package", 4, ПрочитатьФайлJSON(ПутьКНастройкамПакета()));
	ДобавитьСлой(Слои, "autumn-properties-cwd", 3,
		ПрочитатьФайлJSON(ОбъединитьПути(РабочийКаталог, "autumn-properties.json")));
	ДобавитьСлой(Слои, "autumn-properties-env", 2, ПрочитатьПеременныеСреды(_Совет.ПрефиксПеременныхСреды()));

	// Ключ vrunner.settings ищется в слитых уровнях 1-3 - как любой другой ключ настроек.
	Каскад = СлитьСлои(Слои);
	СлоевБезФайла = Слои.Количество();
	ОписаниеФайлаНастроек = ДобавитьФайлНастроек(Слои, Аргументы, Каскад.Параметр("vrunner.settings"), РабочийКаталог);
	Если Слои.Количество() > СлоевБезФайла Тогда
		Каскад = СлитьСлои(Слои);
	КонецЕсли;

	Детальки = Каскад.ПрочитанныеПараметры();
	СекцияСтарта = Новый Соответствие;
	СекцияСтарта.Вставить("settings", ОписаниеФайлаНастроек);
	Детальки.Вставить("vrunner-startup", СекцияСтарта);
	_Совет.ЗначенияДеталек(Детальки);

	// autumn по умолчанию ищет autumn-properties.json в стандартных каталогах
	// (CWD/Profile/AppData) - отключаем это, т.к. слияние уже выполнено выше.
	_Совет.ИмяФайлаСоЗначениямиДеталек("__vrunner_managed_properties__");

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

// Путь к файлу autumn-properties.json внутри пакета (рядом с main.os).
// Текущий класс лежит в src/core/Приложение/Классы/, корень src - на 3 уровня выше.
//
// Возвращаемое значение:
//   Строка - полный путь к autumn-properties.json
//
Функция ПутьКНастройкамПакета()

	КаталогКласса = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогSrc    = Новый Файл(ОбъединитьПути(КаталогКласса, "..", "..", "..")).ПолноеИмя;

	Возврат ОбъединитьПути(КаталогSrc, "autumn-properties.json");

КонецФункции

// Зарегистрировать слой каскада, если у него есть содержимое.
//
// Параметры:
//   Слои - Массив из Структура - накопленные слои (Имя, Приоритет, Значения)
//   Имя - Строка - имя провайдера configor
//   Приоритет - Число - приоритет провайдера (меньше - важнее)
//   Значения - Соответствие, Неопределено - значения слоя
//
Процедура ДобавитьСлой(Слои, Знач Имя, Знач Приоритет, Знач Значения)

	Если Значения = Неопределено ИЛИ Значения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Слои.Добавить(Новый Структура("Имя, Приоритет, Значения", Имя, Приоритет, Значения));

КонецПроцедуры

// Слить слои в один менеджер параметров configor и прочитать его.
//
// Параметры:
//   Слои - Массив из Структура - слои каскада (Имя, Приоритет, Значения)
//
// Возвращаемое значение:
//   МенеджерПараметров - прочитанный каскад
//
Функция СлитьСлои(Знач Слои)

	Каскад = Новый МенеджерПараметров;
	Для Каждого Слой Из Слои Цикл
		Каскад.ДобавитьПровайдерПараметров(
			Новый ПровайдерЗначенийДеталек(Слой.Имя, Слой.Приоритет, Слой.Значения));
	КонецЦикла;
	Каскад.Прочитать();

	Возврат Каскад;

КонецФункции

// Добавить слой файла настроек верхнего приоритета, если файл задан и существует.
//
// Параметры:
//   Слои - Массив из Структура - слои каскада, куда добавляется файл
//   Аргументы - Массив из Строка, Неопределено - аргументы командной строки
//   ЗначениеКлюча - Произвольный - значение ключа vrunner.settings из слитых уровней 1-3
//   РабочийКаталог - Строка - каталог, от которого считается относительный путь
//
// Возвращаемое значение:
//   Строка - что произошло с файлом настроек, для отладочного лога
//
Функция ДобавитьФайлНастроек(Слои, Знач Аргументы, Знач ЗначениеКлюча, Знач РабочийКаталог)

	Источник = НайтиИсточникФайлаНастроек(Аргументы, ЗначениеКлюча);
	Если Источник = Неопределено Тогда
		Возврат "Файл настроек не задан";
	КонецЕсли;

	ПолныйПуть = Новый Файл(ОбъединитьПути(РабочийКаталог, Источник.Путь)).ПолноеИмя;

	Если Новый Файл(ПолныйПуть).Существует() Тогда
		ДобавитьСлой(Слои, "autumn-properties-settings", 1, ПрочитатьФайлJSON(ПолныйПуть));
		Возврат СтрШаблон("Файл настроек: %1 (%2)", ПолныйПуть, Источник.Описание);
	КонецЕсли;

	Если Источник.Обязательный Тогда
		ВызватьИсключение СтрШаблон("Файл настроек не найден: %1 (%2)", ПолныйПуть, Источник.Описание);
	КонецЕсли;

	Возврат СтрШаблон("Файл настроек %1 (%2) не найден - действуют только настройки проекта",
		ПолныйПуть, Источник.Описание);

КонецФункции

// Откуда взять путь к файлу настроек: так же, как значение любой опции -
// командная строка, переменная окружения, ключ в настройках.
//
// Параметры:
//   Аргументы - Массив из Строка, Неопределено - аргументы командной строки
//   ЗначениеКлюча - Произвольный - значение ключа vrunner.settings из слитых уровней 1-3
//
// Возвращаемое значение:
//   Структура, Неопределено:
//     * Путь - Строка - путь к файлу, как его задал пользователь
//     * Описание - Строка - источник пути для сообщений
//     * Обязательный - Булево - Истина, если отсутствие файла - ошибка
//
Функция НайтиИсточникФайлаНастроек(Знач Аргументы, Знач ЗначениеКлюча)

	Путь = ИзвлечьФайлНастроек(Аргументы);
	Если ЗначениеЗаполнено(Путь) Тогда
		Возврат ИсточникФайлаНастроек(Путь, "--settings", Истина);
	КонецЕсли;

	Путь = ПолучитьПеременнуюСреды("VRUNNER_SETTINGS");
	Если ЗначениеЗаполнено(Путь) Тогда
		Возврат ИсточникФайлаНастроек(Путь, "VRUNNER_SETTINGS", Истина);
	КонецЕсли;

	Если ТипЗнч(ЗначениеКлюча) = Тип("Строка") И ЗначениеЗаполнено(СокрЛП(ЗначениеКлюча)) Тогда
		Возврат ИсточникФайлаНастроек(СокрЛП(ЗначениеКлюча), "ключ vrunner.settings", Ложь);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ИсточникФайлаНастроек(Знач Путь, Знач Описание, Знач Обязательный)
	Возврат Новый Структура("Путь, Описание, Обязательный", Путь, Описание, Обязательный);
КонецФункции

// Путь из аргументов командной строки: форма "--settings <файл>" и "--settings=<файл>".
//
// Параметры:
//   Аргументы - Массив из Строка, Неопределено - аргументы командной строки
//
// Возвращаемое значение:
//   Строка, Неопределено - путь к файлу или Неопределено, если опция не передана
//
Функция ИзвлечьФайлНастроек(Знач Аргументы)

	Если Аргументы = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПрефиксСоЗнакомРавно = "--settings=";

	Для Индекс = 0 По Аргументы.ВГраница() Цикл
		Если Аргументы[Индекс] = "--settings" И Индекс < Аргументы.ВГраница() Тогда
			Возврат Аргументы[Индекс + 1];
		КонецЕсли;
		Если СтрНачинаетсяС(Аргументы[Индекс], ПрефиксСоЗнакомРавно) Тогда
			Возврат Сред(Аргументы[Индекс], СтрДлина(ПрефиксСоЗнакомРавно) + 1);
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Чтение переменных окружения с тем же преобразованием ключей,
// что делает configor.ПровайдерПараметровENV (внутренний класс,
// не экспонированный наружу): "_" → ".", "__" → "_". Если задан
// префикс - фильтруем по нему и срезаем "<префикс>_".
//
// Параметры:
//   Префикс - Строка - фильтр по имени переменной среды (может быть пустой строкой)
//
// Возвращаемое значение:
//   Соответствие - ключ/значение переменных окружения
//
Функция ПрочитатьПеременныеСреды(Знач Префикс)

	Результат = Новый Соответствие;

	Для Каждого ПеременнаяСреды Из ПеременныеСреды() Цикл

		Ключ = СтрЗаменить(СтрЗаменить(ПеременнаяСреды.Ключ, "_", "."), "..", "_");

		// BSLLS:IfElseIfEndsWithElse-off
		Если ПустаяСтрока(Префикс) Тогда
			Результат.Вставить(Ключ, ПеременнаяСреды.Значение);
		ИначеЕсли СтрНачинаетсяС(НРег(Ключ), НРег(Префикс)) Тогда
			ОчищенныйКлюч = Прав(Ключ, СтрДлина(Ключ) - (СтрДлина(Префикс) + 1));
			Результат.Вставить(ОчищенныйКлюч, ПеременнаяСреды.Значение);
		КонецЕсли;
		// BSLLS:IfElseIfEndsWithElse-on

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПрочитатьФайлJSON(Знач ПутьКФайлу)

	Файл = Новый Файл(ПутьКФайлу);
	Если НЕ Файл.Существует() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(ПутьКФайлу, "UTF-8");
	Попытка
		Результат = ПрочитатьJSON(Чтение, Истина);
	Исключение
		Чтение.Закрыть();
		ВызватьИсключение СтрШаблон("Не удалось прочитать %1: %2", ПутьКФайлу, ОписаниеОшибки());
	КонецПопытки;
	Чтение.Закрыть();

	Если ТипЗнч(Результат) <> Тип("Соответствие") Тогда
		ВызватьИсключение СтрШаблон("Ожидался JSON-объект в %1", ПутьКФайлу);
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти
