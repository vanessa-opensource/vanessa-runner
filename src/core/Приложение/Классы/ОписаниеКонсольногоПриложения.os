// BSLLS:MissingVariablesDescription-off

#Использовать packageinfo

Перем _Версия;

&Желудь("ОписаниеКонсольногоПриложения")
&Верховный
Процедура ПриСозданииОбъекта(&Пластилин СервисОкружения)
	_Версия = ВерсияИзПакета(СервисОкружения.КорневойКаталогПакета());
КонецПроцедуры

Функция ИмяПриложения() Экспорт
	Возврат "vrunner";
КонецФункции

// Заголовок справки.
//
// Возвращаемое значение:
//   Строка - название, версия, назначение и ссылка на документацию
//
Функция ПолноеИмяПриложения() Экспорт
	Возврат СтрШаблон(
		"vanessa-runner %1 - автоматизация повседневных операций разработчика 1С:
		|сборка и загрузка конфигураций, расширений и обработок, хранилище, кластер,
		|запуск тестов (Vanessa-ADD, YAxUnit), проверка кода, MCP-сервер для ИИ-ассистентов.
		|Документация: https://autumn-library.github.io/vanessa-runner", _Версия);
КонецФункции

Функция ВерсияПриложения() Экспорт
	Возврат _Версия;
КонецФункции

// Версия из packagedef в корне пакета; без файла (например, при запуске из усечённой копии)
// приложение остаётся работоспособным, а версия помечается как неизвестная.
//
// Параметры:
//   КорневойКаталогПакета - Строка - каталог, где лежит packagedef
//
// Возвращаемое значение:
//   Строка - версия пакета
//
Функция ВерсияИзПакета(Знач КорневойКаталогПакета)

	ПутьКМанифесту = ОбъединитьПути(КорневойКаталогПакета, "packagedef");
	Если НЕ Новый Файл(ПутьКМанифесту).Существует() Тогда
		Возврат "неизвестна (нет packagedef)";
	КонецЕсли;

	Возврат Новый ИнформацияОПакете(ПутьКМанифесту).Версия();

КонецФункции
