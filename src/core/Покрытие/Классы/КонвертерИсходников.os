// BSLLS:LatinAndCyrillicSymbolInWord-off Технические имена файлов модулей 1С (ObjectModule.bsl и т.п.).
// BSLLS:MissingVariablesDescription-off Внутреннее состояние конвертера.
// BSLLS:MissingParameterDescription-off Внутренние вспомогательные функции.
// BSLLS:MissingReturnedValueDescription-off Внутренние вспомогательные функции.
// BSLLS:Typo-off Доменные термины (mdo, uuid, Recalculations).
// BSLLS:NestedStatements-off Обход XML-узлов метаданных требует вложенных циклов.
// BSLLS:DuplicateStringLiteral-off Технические имена подкаталогов ("Ext") в раскладке XML-дампа.
//
// Маппинг «программный модуль 1С -> файл исходника».
// По виду модуля (PropertyID из отладчика) и идентификатору объекта метаданных (ObjectID)
// находит путь к .bsl-файлу в каталоге исходников формата EDT или XML-дампа.
//
// Поиск задан таблицей правил (см. ЗаполнитьПравила): вид модуля -> имя файла модуля и источники,
// где искать носитель модуля - каталог объекта метаданных или подчинённого объекта (формы,
// команды, перерасчёта). Объекты находятся по атрибуту uuid в *.mdo (EDT) / *.xml (XML-дамп);
// найденные соответствия кешируются. Референс: yukon39/coverage-cli.
//
// Внешние обработки/отчёты (ExtMDModule) не поддерживаются - только конфигурация и расширения.

#Область ОписаниеПеременных

Перем КаталогМетаданных;        // Строка - корень поиска метаданных (для EDT это <проект>/src)
Перем ЭтоEDT;                   // Булево - исходники EDT (*.mdo); иначе XML-дамп Конфигуратора (*.xml)
Перем Правила;                  // Соответствие - НРег(PropertyID вида модуля) -> правило поиска
Перем Кеш;                      // Соответствие - uuid -> каталог носителя модуля
Перем ПроиндексированныеГруппы; // Соответствие - ключ группы -> Истина, группа уже прочитана в кеш

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Найти путь к файлу программного модуля.
//
// Параметры:
//   ВидМодуля - Строка - PropertyID вида модуля (GUID из данных отладчика)
//   ИДОбъекта - Строка - ObjectID объекта метаданных (uuid)
//
// Возвращаемое значение:
//   Строка, Неопределено - полный путь к существующему .bsl-файлу либо Неопределено
//
Функция НайтиФайлМодуля(Знач ВидМодуля, Знач ИДОбъекта) Экспорт

	Правило = Правила.Получить(НРег(ВидМодуля));
	Если Правило = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Носитель = НайтиНосителяМодуля(Правило.Источники, ИДОбъекта);
	Если Носитель = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Путь = ПутьФайлаМодуля(Носитель, Правило);
	Возврат ?(Новый Файл(Путь).Существует(), Путь, Неопределено);

КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриСозданииОбъекта(Знач ПараметрКаталогИсходников, Знач ПараметрФормат)

	ЭтоEDT = ВРег(ПараметрФормат) = "EDT";

	КорневойКаталог = Новый Файл(ПараметрКаталогИсходников).ПолноеИмя;
	КаталогМетаданных = ?(ЭтоEDT, ОбъединитьПути(КорневойКаталог, "src"), КорневойКаталог);

	Кеш = Новый Соответствие;
	ПроиндексированныеГруппы = Новый Соответствие;
	ЗаполнитьПравила();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПравилаПоиска

// Правило: вид модуля (PropertyID) -> имя файла модуля + источники носителя по порядку поиска.
// Для XML-дампа модуль лежит в <носитель>/Ext[/ПодкаталогXML]/<ИмяФайла>, для EDT - в <носитель>/<ИмяФайла>.
Процедура ЗаполнитьПравила()

	Правила = Новый Соответствие;

	Конфигурация = ИсточникКонфигурации();
	ДобавитьПравило("d22e852a-cf8a-4f77-8ccb-3548e7792bea", "ManagedApplicationModule.bsl", Конфигурация);
	ДобавитьПравило("a78d9ce3-4e0c-48d5-9863-ae7342eedf94", "OrdinaryApplicationModule.bsl", Конфигурация);
	ДобавитьПравило("9b7bbbae-9771-46f2-9e4d-2489e0ffc702", "SessionModule.bsl", Конфигурация);
	ДобавитьПравило("a4a9c1e2-1e54-4c7f-af06-4ca341198fac", "ExternalConnectionModule.bsl", Конфигурация);

	ДобавитьПравило("d5963243-262e-4398-b4d7-fb16d06484f6", "Module.bsl",
		ИсточникОбъекта(Группы("CommonModules,HTTPServices,WebServices")));
	ДобавитьПравило("3e58c91f-9aaa-4f42-8999-4baf33907b75", "ValueManagerModule.bsl",
		ИсточникОбъекта(Группы("Constants")));
	ДобавитьПравило("0c8cad23-bf8c-468e-b49e-12f1927c048b", "ManagerModule.bsl",
		ИсточникОбъекта(Группы("SettingsStorages")));
	ДобавитьПравило("d1b64a2c-8078-4982-8190-8f81aefda192", "ManagerModule.bsl",
		ИсточникОбъекта(ГруппыСМодулемМенеджера()));
	ДобавитьПравило("a637f77f-3840-441d-a1c3-699c8c5cb7e0", "ObjectModule.bsl",
		ИсточникОбъекта(ГруппыСМодулемОбъекта()));

	// Набор записей: регистры и последовательности, затем перерасчёты регистров расчёта.
	ДобавитьПравило("9f36fd70-4bf4-47f6-b235-935f73aab43f", "RecordSetModule.bsl",
		ИсточникОбъекта(Объединить(Группы("Sequences"), ГруппыРегистров())),
		ИсточникПодчиненного(Группы("CalculationRegisters"), "Recalculations", "recalculations", ""));

	// Форма объекта, затем общая форма. В XML-дампе модуль формы лежит в Ext/Form.
	ДобавитьПравило("32e087ab-1491-49b6-aba7-43571b41ac2b", "Module.bsl",
		ИсточникПодчиненного(ГруппыСФормамиИКомандами(), "Forms", "forms", ""),
		ИсточникОбъекта(Группы("CommonForms")), "Form");

	// Команда объекта (в XML-дампе описана внутри .xml родителя), затем общая команда.
	ДобавитьПравило("078a6af8-d22c-4248-9c33-7e90075a3d2c", "CommandModule.bsl",
		ИсточникПодчиненного(ГруппыСФормамиИКомандами(), "Commands", "commands", "Command"),
		ИсточникОбъекта(Группы("CommonCommands")));

КонецПроцедуры

Процедура ДобавитьПравило(Знач ВидМодуля, Знач ИмяФайла, Знач Источник,
	Знач ЗапаснойИсточник = Неопределено, Знач ПодкаталогXML = "")

	Источники = Новый Массив;
	Источники.Добавить(Источник);
	Если ЗапаснойИсточник <> Неопределено Тогда
		Источники.Добавить(ЗапаснойИсточник);
	КонецЕсли;

	Правило = Новый Структура("ИмяФайла, Источники, ПодкаталогXML", ИмяФайла, Источники, ПодкаталогXML);
	Правила.Вставить(ВидМодуля, Правило);

КонецПроцедуры

// Модули уровня конфигурации: EDT - <src>/Configuration, XML-дамп - корень дампа.
Функция ИсточникКонфигурации()
	Возврат Новый Структура("Вид", "Конфигурация");
КонецФункции

// Объект метаданных верхнего уровня в одной из групп каталогов.
Функция ИсточникОбъекта(Знач Группы)
	Возврат Новый Структура("Вид, Группы", "Объект", Группы);
КонецФункции

// Подчинённый объект (форма, команда, перерасчёт) объектов из групп каталогов.
//   Подкаталог - подкаталог родителя с подчинёнными (Forms, Commands, Recalculations);
//   ЭлементMdo - элемент .mdo родителя, перечисляющий подчинённые (forms, commands, recalculations);
//   ЭлементXML - узел ChildObjects в .xml родителя (Command); пусто - у подчинённого свой .xml в подкаталоге.
Функция ИсточникПодчиненного(Знач Группы, Знач Подкаталог, Знач ЭлементMdo, Знач ЭлементXML)
	Источник = Новый Структура("Вид, Группы, Подкаталог", "Подчиненный", Группы, Подкаталог);
	Источник.Вставить("ЭлементMdo", ЭлементMdo);
	Источник.Вставить("ЭлементXML", ЭлементXML);
	Возврат Источник;
КонецФункции

Функция Группы(Знач СписокЧерезЗапятую)
	Возврат СтрРазделить(СписокЧерезЗапятую, ",");
КонецФункции

// Ссылочные типы, отчёты и обработки, бизнес-процессы и задачи.
Функция ГруппыСМодулемОбъекта()
	Возврат Группы("ExchangePlans,Catalogs,Documents,Reports,DataProcessors,"
		+ "ChartsOfCharacteristicTypes,ChartsOfAccounts,ChartsOfCalculationTypes,BusinessProcesses,Tasks");
КонецФункции

Функция ГруппыРегистров()
	Возврат Группы("InformationRegisters,AccumulationRegisters,AccountingRegisters,CalculationRegisters");
КонецФункции

// Формы и команды есть у объектов с модулем объекта, регистров и у объектов без своего модуля
// (критерии отбора, перечисления, журналы документов).
Функция ГруппыСФормамиИКомандами()
	Возврат Объединить(
		Объединить(ГруппыСМодулемОбъекта(), ГруппыРегистров()),
		Группы("FilterCriteria,Enums,DocumentJournals"));
КонецФункции

// Модуль менеджера: всё, у чего есть формы и команды, плюс хранилища настроек.
Функция ГруппыСМодулемМенеджера()
	Возврат Объединить(ГруппыСФормамиИКомандами(), Группы("SettingsStorages"));
КонецФункции

Функция Объединить(Знач Первый, Знач Второй)
	Результат = Новый Массив;
	Для Каждого Элемент Из Первый Цикл
		Результат.Добавить(Элемент);
	КонецЦикла;
	Для Каждого Элемент Из Второй Цикл
		Результат.Добавить(Элемент);
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область ПоискНосителя

// Каталог носителя модуля по источникам правила: первый источник, где объект нашёлся.
Функция НайтиНосителяМодуля(Знач Источники, Знач ИДОбъекта)

	Для Каждого Источник Из Источники Цикл

		Если Источник.Вид = "Конфигурация" Тогда
			Возврат ?(ЭтоEDT, ОбъединитьПути(КаталогМетаданных, "Configuration"), КаталогМетаданных);
		КонецЕсли;

		Для Каждого Группа Из Источник.Группы Цикл
			Носитель = Кеш.Получить(ИДОбъекта);
			Если Носитель <> Неопределено Тогда
				Возврат Носитель;
			КонецЕсли;
			ПроиндексироватьГруппу(Источник, Группа);
		КонецЦикла;

	КонецЦикла;

	Возврат Кеш.Получить(ИДОбъекта);

КонецФункции

Функция ПутьФайлаМодуля(Знач Носитель, Знач Правило)

	Если ЭтоEDT Тогда
		Возврат ОбъединитьПути(Носитель, Правило.ИмяФайла);
	КонецЕсли;

	Каталог = ОбъединитьПути(Носитель, "Ext");
	Если ЗначениеЗаполнено(Правило.ПодкаталогXML) Тогда
		Каталог = ОбъединитьПути(Каталог, Правило.ПодкаталогXML);
	КонецЕсли;

	Возврат ОбъединитьПути(Каталог, Правило.ИмяФайла);

КонецФункции

// Прочитать в кеш uuid всех объектов (или их подчинённых) одной группы каталогов; повторно не читается.
Процедура ПроиндексироватьГруппу(Знач Источник, Знач Группа)

	КлючГруппы = СтрШаблон("%1/%2", Группа, ?(Источник.Вид = "Объект", "", Источник.Подкаталог));
	Если ПроиндексированныеГруппы.Получить(КлючГруппы) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПроиндексированныеГруппы.Вставить(КлючГруппы, Истина);

	КаталогГруппы = ОбъединитьПути(КаталогМетаданных, Группа);

	Если Источник.Вид = "Объект" Тогда
		Если ЭтоEDT Тогда
			ПроиндексироватьОбъектыEDT(КаталогГруппы);
		Иначе
			ПроиндексироватьОбъектыXML(КаталогГруппы);
		КонецЕсли;
	ИначеЕсли ЭтоEDT Тогда
		ПроиндексироватьПодчиненныеEDT(КаталогГруппы, Источник);
	ИначеЕсли ЗначениеЗаполнено(Источник.ЭлементXML) Тогда
		ПроиндексироватьПодчиненныеИзОписанияXML(КаталогГруппы, Источник);
	Иначе
		ПроиндексироватьВложенныеXML(КаталогГруппы, Источник.Подкаталог);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ИндексацияEDT

// Объект EDT - каталог группы с файлом .mdo; uuid несёт корневой элемент .mdo.
Процедура ПроиндексироватьОбъектыEDT(Знач КаталогГруппы)

	Для Каждого КаталогОбъекта Из НайтиФайлы(КаталогГруппы, "*", Ложь) Цикл
		ФайлМдо = ПервыйФайлПоМаске(КаталогОбъекта.ПолноеИмя, "*.mdo");
		Если ФайлМдо <> Неопределено Тогда
			ДобавитьВКеш(ПрочитатьUuid(ФайлМдо, Ложь), КаталогОбъекта.ПолноеИмя);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Подчинённые EDT перечислены в .mdo родителя; их каталог - <родитель>/<Подкаталог>/<имя>.
Процедура ПроиндексироватьПодчиненныеEDT(Знач КаталогГруппы, Знач Источник)

	Для Каждого КаталогОбъекта Из НайтиФайлы(КаталогГруппы, "*", Ложь) Цикл

		ФайлМдо = ПервыйФайлПоМаске(КаталогОбъекта.ПолноеИмя, "*.mdo");
		Если ФайлМдо = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого Подчиненный Из ПодчиненныеОбъектыMdo(ФайлМдо, Источник.ЭлементMdo) Цикл
			ДобавитьВКеш(Подчиненный.Ключ,
				ОбъединитьПути(КаталогОбъекта.ПолноеИмя, Источник.Подкаталог, Подчиненный.Значение));
		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

// Прочитать подчинённые объекты (uuid -> имя) из .mdo родителя: элементы forms/commands/recalculations.
Функция ПодчиненныеОбъектыMdo(Знач ФайлМдо, Знач ЛокальноеИмя)

	Результат = Новый Массив;

	Чтение = Новый ЧтениеXML;
	Чтение.ОткрытьФайл(ФайлМдо);
	Чтение.ПерейтиКСодержимому();
	Чтение.Прочитать();

	Пока Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Цикл
		Если Чтение.ЛокальноеИмя = ЛокальноеИмя Тогда
			ИД = Чтение.ЗначениеАтрибута("uuid");
			Имя = ЗначениеВложенногоЭлемента(Чтение, СтрРазделить("name", "/"));
			ДобавитьПодчиненный(Результат, ИД, Имя);
		Иначе
			ПропуститьЭлемент(Чтение);
		КонецЕсли;
	КонецЦикла;

	Чтение.Закрыть();

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ИндексацияXML

// Объект XML-дампа - файл <группа>/<имя>.xml; носитель модулей - одноимённый каталог рядом.
Процедура ПроиндексироватьОбъектыXML(Знач КаталогГруппы)

	Для Каждого ФайлОбъекта Из НайтиФайлы(КаталогГруппы, "*.xml", Ложь) Цикл
		ДобавитьВКеш(ПрочитатьUuid(ФайлОбъекта.ПолноеИмя, Истина), КаталогОбъектаXML(ФайлОбъекта.ПолноеИмя));
	КонецЦикла;

КонецПроцедуры

// Вложенные объекты со своим .xml (формы, перерасчёты) в подкаталоге каталога родителя.
Процедура ПроиндексироватьВложенныеXML(Знач КаталогГруппы, Знач Подкаталог)

	Для Каждого ФайлРодителя Из НайтиФайлы(КаталогГруппы, "*.xml", Ложь) Цикл
		КаталогВложенных = ОбъединитьПути(КаталогОбъектаXML(ФайлРодителя.ПолноеИмя), Подкаталог);
		Для Каждого ФайлВложенного Из НайтиФайлы(КаталогВложенных, "*.xml", Ложь) Цикл
			ДобавитьВКеш(ПрочитатьUuid(ФайлВложенного.ПолноеИмя, Истина), КаталогОбъектаXML(ФайлВложенного.ПолноеИмя));
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Подчинённые без своего .xml (команды): перечислены в ChildObjects родителя,
// каталог - <родитель>/<Подкаталог>/<имя>.
Процедура ПроиндексироватьПодчиненныеИзОписанияXML(Знач КаталогГруппы, Знач Источник)

	Для Каждого ФайлРодителя Из НайтиФайлы(КаталогГруппы, "*.xml", Ложь) Цикл
		КаталогРодителя = КаталогОбъектаXML(ФайлРодителя.ПолноеИмя);
		Для Каждого Подчиненный Из ПодчиненныеОбъектыXML(ФайлРодителя.ПолноеИмя, Источник.ЭлементXML) Цикл
			ДобавитьВКеш(Подчиненный.Ключ, ОбъединитьПути(КаталогРодителя, Источник.Подкаталог, Подчиненный.Значение));
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Прочитать подчинённые объекты (uuid -> имя) из .xml родителя: узлы ChildObjects/<Тип>.
Функция ПодчиненныеОбъектыXML(Знач ФайлРодителя, Знач ЛокальноеИмяТипа)

	Результат = Новый Массив;

	Чтение = Новый ЧтениеXML;
	Чтение.ОткрытьФайл(ФайлРодителя);
	Чтение.ПерейтиКСодержимому();
	Чтение.Прочитать();
	Чтение.Прочитать();

	Пока Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Цикл
		Если Чтение.ЛокальноеИмя = "ChildObjects" Тогда
			Чтение.Прочитать();
			Пока Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Цикл
				Если Чтение.ЛокальноеИмя = ЛокальноеИмяТипа Тогда
					ИД = Чтение.ЗначениеАтрибута("uuid");
					Имя = ЗначениеВложенногоЭлемента(Чтение, СтрРазделить("Properties/Name", "/"));
					ДобавитьПодчиненный(Результат, ИД, Имя);
				Иначе
					ПропуститьЭлемент(Чтение);
				КонецЕсли;
			КонецЦикла;
			Чтение.Прочитать();
		Иначе
			ПропуститьЭлемент(Чтение);
		КонецЕсли;
	КонецЦикла;

	Чтение.Закрыть();

	Возврат Результат;

КонецФункции

Функция КаталогОбъектаXML(Знач ФайлОбъекта)
	Файл = Новый Файл(ФайлОбъекта);
	Возврат ОбъединитьПути(Файл.Путь, Файл.ИмяБезРасширения);
КонецФункции

#КонецОбласти

#Область ОбходXML

// Пропустить текущий элемент вместе с содержимым и встать на следующий узел.
Процедура ПропуститьЭлемент(Чтение)
	Чтение.Пропустить();
	Чтение.Прочитать();
КонецПроцедуры

// Текст вложенного элемента по пути имён от текущего элемента (курсор - на его начале),
// например ["Properties", "Name"]. Остальные дочерние элементы пропускаются. По выходе
// курсор стоит на узле, следующем за концом текущего элемента.
Функция ЗначениеВложенногоЭлемента(Чтение, Знач ПутьИмен, Знач Уровень = 0)

	Значение = "";
	ИмяИскомого = ПутьИмен[Уровень];
	ЭтоЛист = Уровень = ПутьИмен.ВГраница();

	Чтение.Прочитать();
	Пока Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Цикл
		Если Чтение.ЛокальноеИмя = ИмяИскомого И НЕ ЗначениеЗаполнено(Значение) Тогда
			Если ЭтоЛист Тогда
				Значение = ТекстЭлемента(Чтение);
			Иначе
				Значение = ЗначениеВложенногоЭлемента(Чтение, ПутьИмен, Уровень + 1);
			КонецЕсли;
		Иначе
			ПропуститьЭлемент(Чтение);
		КонецЕсли;
	КонецЦикла;
	Чтение.Прочитать();

	Возврат Значение;

КонецФункции

// Текст текущего элемента (курсор - на его начале); по выходе курсор - на следующем узле.
Функция ТекстЭлемента(Чтение)

	Значение = "";
	Чтение.Прочитать();
	Если Чтение.ТипУзла = ТипУзлаXML.Текст Тогда
		Значение = Чтение.Значение;
		Чтение.Прочитать();
	КонецЕсли;
	Чтение.Прочитать();

	Возврат Значение;

КонецФункции

Процедура ДобавитьПодчиненный(Результат, Знач ИД, Знач Имя)
	Если ЗначениеЗаполнено(ИД) И ЗначениеЗаполнено(Имя) Тогда
		Результат.Добавить(Новый Структура("Ключ, Значение", ИД, Имя));
	КонецЕсли;
КонецПроцедуры

// Прочитать атрибут uuid объекта метаданных из файла описания.
//
// Параметры:
//   ФайлОписания - Строка - путь к .mdo (EDT) или .xml (XML-дамп)
//   ОбъектВложенВКорень - Булево - Истина для XML-дампа: uuid несёт элемент объекта под корнем
//       MetaDataObject; Ложь для EDT: uuid несёт сам корневой элемент .mdo
//
Функция ПрочитатьUuid(Знач ФайлОписания, Знач ОбъектВложенВКорень)

	Чтение = Новый ЧтениеXML;
	Чтение.ОткрытьФайл(ФайлОписания);
	Чтение.ПерейтиКСодержимому();
	Если ОбъектВложенВКорень Тогда
		Чтение.Прочитать();
	КонецЕсли;
	ИД = Чтение.ЗначениеАтрибута("uuid");
	Чтение.Закрыть();

	Возврат ИД;

КонецФункции

#КонецОбласти

#Область Вспомогательные

Функция ПервыйФайлПоМаске(Знач Каталог, Знач Маска)
	Найденные = НайтиФайлы(Каталог, Маска, Ложь);
	Если Найденные.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Найденные[0].ПолноеИмя;
КонецФункции

Процедура ДобавитьВКеш(Знач ИДОбъекта, Знач Носитель)
	Если ЗначениеЗаполнено(ИДОбъекта) И Кеш.Получить(ИДОбъекта) = Неопределено Тогда
		Кеш.Вставить(ИДОбъекта, Носитель);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#КонецОбласти
