#Область Вспомогательные

Функция ФайлВКаталоге(Знач Каталог, Знач ИмяФайла)
	Если Каталог = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ОбъединитьПути(Каталог, ИмяФайла);
КонецФункции

Функция ПервыйФайлПоМаске(Знач Каталог, Знач Маска)
	Найденные = НайтиФайлы(Каталог, Маска, Ложь);
	Если Найденные.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Найденные[0].ПолноеИмя;
КонецФункции

// Прочитать атрибут uuid корневого элемента EDT .mdo (корневой элемент несёт uuid непосредственно).
Функция ПрочитатьUuid(Знач ФайлМдо)
	Чтение = Новый ЧтениеXML;
	Чтение.ОткрытьФайл(ФайлМдо);
	Чтение.ПерейтиКСодержимому();
	ИД = Чтение.ЗначениеАтрибута("uuid");
	Чтение.Закрыть();
	Возврат ИД;
КонецФункции

// Прочитать атрибут uuid объекта XML-дампа (уровень элемента объекта под корнем).
Функция ПрочитатьUuidXML(Знач ФайлОбъекта)
	Чтение = Новый ЧтениеXML;
	Чтение.ОткрытьФайл(ФайлОбъекта);
	Чтение.ПерейтиКСодержимому();
	Чтение.Прочитать();
	ИД = Чтение.ЗначениеАтрибута("uuid");
	Чтение.Закрыть();
	Возврат ИД;
КонецФункции

Функция КлючКеша(Знач ИДОбъекта, Знач Корень)
	Возврат СтрШаблон("%1+%2", ИДОбъекта, Корень);
КонецФункции

Процедура ДобавитьВКеш(Знач ИДОбъекта, Знач Корень, Знач Значение)
	Если ЗначениеЗаполнено(ИДОбъекта) И Кеш.Получить(КлючКеша(ИДОбъекта, Корень)) = Неопределено Тогда
		Кеш.Вставить(КлючКеша(ИДОбъекта, Корень), Значение);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#КонецОбласти
