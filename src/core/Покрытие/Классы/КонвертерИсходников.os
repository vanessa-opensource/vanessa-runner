// BSLLS:LatinAndCyrillicSymbolInWord-off Технические имена файлов модулей 1С (ObjectModule.bsl и т.п.).
// BSLLS:MissingVariablesDescription-off Внутреннее состояние конвертера.
// BSLLS:MissingParameterDescription-off Внутренние вспомогательные функции.
// BSLLS:MissingReturnedValueDescription-off Внутренние вспомогательные функции.
// BSLLS:Typo-off Доменные термины (mdo, uuid, Recalculations).
// BSLLS:CognitiveComplexity-off Диспетчер видов модулей - неизбежная развилка по видам модулей 1С.
// BSLLS:IfConditionComplexity-off То же: множественные условия диспетчеризации.
// BSLLS:NestedStatements-off Обход XML-узлов метаданных требует вложенных циклов.
// BSLLS:DuplicateStringLiteral-off Технические имена подкаталогов ("Ext") в раскладке XML-дампа.
//
// Маппинг «программный модуль 1С -> файл исходника».
// По виду модуля (PropertyID из отладчика) и идентификатору объекта метаданных (ObjectID)
// находит путь к соответствующему .bsl-файлу в каталоге исходников формата EDT или XML-дампа.
//
// Алгоритм портирован (как референс) из yukon39/coverage-cli
// (internal/converter/Модули/ОбработчикиФормата{EDT,XML}.os): идентификатор объекта ищется по
// атрибуту uuid в *.mdo (EDT) / *.xml (XML); имя файла модуля определяется видом модуля.
//
// Внешние обработки/отчёты (ExtMDModule) не поддерживаются - только конфигурация и расширения.

#Область ОписаниеПеременных

Перем КаталогМетаданных;   // Строка - корень поиска метаданных (для EDT это <проект>/src)
Перем Формат;              // Строка - "EDT" или "XML"
Перем Кеш;                 // Соответствие - кеш "uuid+корень -> Файл объекта/каталог"

// Идентификаторы (PropertyID) видов программных модулей - фиксированные GUID платформы.
Перем ОбщийМодуль;
Перем МодульОбъекта;
Перем МодульМенеджера;
Перем МодульНабораЗаписей;
Перем МодульОбычногоПриложения;
Перем МодульУправляемогоПриложения;
Перем МодульВнешнегоСоединения;
Перем МодульСеанса;
Перем МодульМенеджераЗначения;
Перем МодульМенеджераНастроек;
Перем МодульФормы;
Перем МодульКоманды;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Формат исходников EDT.
Функция ФорматEDT() Экспорт
	Возврат "EDT";
КонецФункции

// Формат исходников XML-дамп конфигуратора.
Функция ФорматXML() Экспорт
	Возврат "XML";
КонецФункции

// Найти путь к файлу программного модуля.
//
// Параметры:
//   ВидМодуля - Строка - PropertyID вида модуля (GUID из данных отладчика)
//   ИДОбъекта - Строка - ObjectID объекта метаданных (uuid)
//
// Возвращаемое значение:
//   Строка, Неопределено - полный путь к существующему .bsl-файлу либо Неопределено
//
Функция НайтиФайлМодуля(Знач ВидМодуля, Знач ИДОбъекта) Экспорт

	Ключ = НРег(ВидМодуля);

	Если Формат = ФорматEDT() Тогда
		Путь = НайтиФайлМодуляEDT(Ключ, ИДОбъекта);
	Иначе
		Путь = НайтиФайлМодуляXML(Ключ, ИДОбъекта);
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Путь) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если НЕ Новый Файл(Путь).Существует() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Путь;

КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриСозданииОбъекта(Знач ПараметрКаталогИсходников, Знач ПараметрФормат)

	ИнициализироватьВидыМодулей();

	Формат = ?(ВРег(ПараметрФормат) = "EDT", ФорматEDT(), ФорматXML());

	КорневойКаталог = Новый Файл(ПараметрКаталогИсходников).ПолноеИмя;
	Если Формат = ФорматEDT() Тогда
		КаталогМетаданных = ОбъединитьПути(КорневойКаталог, "src");
	Иначе
		КаталогМетаданных = КорневойКаталог;
	КонецЕсли;

	Кеш = Новый Соответствие;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ИнициализироватьВидыМодулей()

	ОбщийМодуль                  = "d5963243-262e-4398-b4d7-fb16d06484f6";
	МодульОбъекта                = "a637f77f-3840-441d-a1c3-699c8c5cb7e0";
	МодульМенеджера              = "d1b64a2c-8078-4982-8190-8f81aefda192";
	МодульНабораЗаписей          = "9f36fd70-4bf4-47f6-b235-935f73aab43f";
	МодульОбычногоПриложения     = "a78d9ce3-4e0c-48d5-9863-ae7342eedf94";
	МодульУправляемогоПриложения = "d22e852a-cf8a-4f77-8ccb-3548e7792bea";
	МодульВнешнегоСоединения     = "a4a9c1e2-1e54-4c7f-af06-4ca341198fac";
	МодульСеанса                 = "9b7bbbae-9771-46f2-9e4d-2489e0ffc702";
	МодульМенеджераЗначения      = "3e58c91f-9aaa-4f42-8999-4baf33907b75";
	МодульМенеджераНастроек      = "0c8cad23-bf8c-468e-b49e-12f1927c048b";
	МодульФормы                  = "32e087ab-1491-49b6-aba7-43571b41ac2b";
	МодульКоманды                = "078a6af8-d22c-4248-9c33-7e90075a3d2c";

КонецПроцедуры

#Область ДиспетчеризацияEDT

Функция НайтиФайлМодуляEDT(Знач ВидМодуля, Знач ИДОбъекта)

	Корень = КаталогМетаданных;

	Если ВидМодуля = МодульУправляемогоПриложения ИЛИ ВидМодуля = МодульОбычногоПриложения
		ИЛИ ВидМодуля = МодульСеанса ИЛИ ВидМодуля = МодульВнешнегоСоединения Тогда
		Возврат ФайлМодуляКонфигурацииEDT(Корень, ВидМодуля);
	КонецЕсли;

	Если ВидМодуля = ОбщийМодуль Тогда
		Каталог = НайтиОбъектВКаталогах(Корень, ИДОбъекта, СписокКаталоговОбщийМодуль());
		Возврат ФайлВКаталоге(Каталог, "Module.bsl");
	КонецЕсли;

	Если ВидМодуля = МодульМенеджераЗначения Тогда
		Каталог = НайтиОбъект(Корень, ИДОбъекта, "Constants");
		Возврат ФайлВКаталоге(Каталог, "ValueManagerModule.bsl");
	КонецЕсли;

	Если ВидМодуля = МодульМенеджераНастроек Тогда
		Каталог = НайтиОбъект(Корень, ИДОбъекта, "SettingsStorages");
		Возврат ФайлВКаталоге(Каталог, "ManagerModule.bsl");
	КонецЕсли;

	Если ВидМодуля = МодульМенеджера Тогда
		Каталог = НайтиОбъектВКаталогах(Корень, ИДОбъекта, СписокКаталоговМодульМенеджера());
		Возврат ФайлВКаталоге(Каталог, "ManagerModule.bsl");
	КонецЕсли;

	Если ВидМодуля = МодульОбъекта Тогда
		Каталог = НайтиОбъектВКаталогах(Корень, ИДОбъекта, СписокКаталоговМодульОбъекта());
		Возврат ФайлВКаталоге(Каталог, "ObjectModule.bsl");
	КонецЕсли;

	Если ВидМодуля = МодульНабораЗаписей Тогда
		Каталог = НайтиОбъектВКаталогах(Корень, ИДОбъекта, СписокКаталоговМодульНабораЗаписей());
		Если Каталог = Неопределено Тогда
			Каталог = НайтиПодчиненныйEDT(Корень, ИДОбъекта, "CalculationRegisters", "Recalculations", "recalculations");
		КонецЕсли;
		Возврат ФайлВКаталоге(Каталог, "RecordSetModule.bsl");
	КонецЕсли;

	Если ВидМодуля = МодульФормы Тогда
		Каталог = НайтиПодОбъектВКаталогахEDT(Корень, ИДОбъекта, СписокКаталоговМодульФормы(), "Forms", "forms");
		Если Каталог = Неопределено Тогда
			Каталог = НайтиОбъект(Корень, ИДОбъекта, "CommonForms");
		КонецЕсли;
		Возврат ФайлВКаталоге(Каталог, "Module.bsl");
	КонецЕсли;

	Если ВидМодуля = МодульКоманды Тогда
		Каталог = НайтиПодОбъектВКаталогахEDT(Корень, ИДОбъекта, СписокКаталоговМодульКоманды(), "Commands", "commands");
		Если Каталог = Неопределено Тогда
			Каталог = НайтиОбъект(Корень, ИДОбъекта, "CommonCommands");
		КонецЕсли;
		Возврат ФайлВКаталоге(Каталог, "CommandModule.bsl");
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Модули уровня конфигурации (управляемого/обычного приложения, сеанса, внешнего соединения)
// лежат в <src>/Configuration независимо от ObjectID.
Функция ФайлМодуляКонфигурацииEDT(Знач Корень, Знач ВидМодуля)

	Соответствие = Новый Соответствие;
	Соответствие.Вставить(МодульУправляемогоПриложения, "ManagedApplicationModule.bsl");
	Соответствие.Вставить(МодульОбычногоПриложения, "OrdinaryApplicationModule.bsl");
	Соответствие.Вставить(МодульСеанса, "SessionModule.bsl");
	Соответствие.Вставить(МодульВнешнегоСоединения, "ExternalConnectionModule.bsl");

	ИмяФайла = Соответствие.Получить(ВидМодуля);
	Если ИмяФайла = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ОбъединитьПути(Корень, "Configuration", ИмяФайла);

КонецФункции

#КонецОбласти

#Область ДиспетчеризацияXML

Функция НайтиФайлМодуляXML(Знач ВидМодуля, Знач ИДОбъекта)

	Корень = КаталогМетаданных;

	Если ВидМодуля = МодульУправляемогоПриложения Тогда
		Возврат ОбъединитьПути(Корень, "Ext", "ManagedApplicationModule.bsl");
	КонецЕсли;
	Если ВидМодуля = МодульОбычногоПриложения Тогда
		Возврат ОбъединитьПути(Корень, "Ext", "OrdinaryApplicationModule.bsl");
	КонецЕсли;
	Если ВидМодуля = МодульСеанса Тогда
		Возврат ОбъединитьПути(Корень, "Ext", "SessionModule.bsl");
	КонецЕсли;
	Если ВидМодуля = МодульВнешнегоСоединения Тогда
		Возврат ОбъединитьПути(Корень, "Ext", "ExternalConnectionModule.bsl");
	КонецЕсли;

	Если ВидМодуля = ОбщийМодуль Тогда
		Файл = НайтиФайлОбъектаВКаталогахXML(Корень, ИДОбъекта, СписокКаталоговОбщийМодуль());
		Возврат ФайлМодуляРядомСОбъектомXML(Файл, "Module.bsl");
	КонецЕсли;

	Если ВидМодуля = МодульМенеджераЗначения Тогда
		Файл = НайтиФайлОбъектаXML(Корень, ИДОбъекта, "Constants");
		Возврат ФайлМодуляРядомСОбъектомXML(Файл, "ValueManagerModule.bsl");
	КонецЕсли;

	Если ВидМодуля = МодульМенеджераНастроек Тогда
		Файл = НайтиФайлОбъектаXML(Корень, ИДОбъекта, "SettingsStorages");
		Возврат ФайлМодуляРядомСОбъектомXML(Файл, "ManagerModule.bsl");
	КонецЕсли;

	Если ВидМодуля = МодульМенеджера Тогда
		Файл = НайтиФайлОбъектаВКаталогахXML(Корень, ИДОбъекта, СписокКаталоговМодульМенеджера());
		Возврат ФайлМодуляРядомСОбъектомXML(Файл, "ManagerModule.bsl");
	КонецЕсли;

	Если ВидМодуля = МодульОбъекта Тогда
		Файл = НайтиФайлОбъектаВКаталогахXML(Корень, ИДОбъекта, СписокКаталоговМодульОбъекта());
		Возврат ФайлМодуляРядомСОбъектомXML(Файл, "ObjectModule.bsl");
	КонецЕсли;

	Если ВидМодуля = МодульНабораЗаписей Тогда
		Файл = НайтиФайлОбъектаВКаталогахXML(Корень, ИДОбъекта, СписокКаталоговМодульНабораЗаписей());
		Если Файл = Неопределено Тогда
			Файл = НайтиВложенныйФайлXML(Корень, ИДОбъекта, "CalculationRegisters", "Recalculations");
		КонецЕсли;
		Возврат ФайлМодуляРядомСОбъектомXML(Файл, "RecordSetModule.bsl");
	КонецЕсли;

	Если ВидМодуля = МодульФормы Тогда
		Файл = НайтиФормуXML(Корень, ИДОбъекта, СписокКаталоговМодульФормы());
		Если Файл = Неопределено Тогда
			Файл = НайтиФайлОбъектаXML(Корень, ИДОбъекта, "CommonForms");
		КонецЕсли;
		Если Файл = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат ОбъединитьПути(КаталогОбъектаXML(Файл), "Ext", "Form", "Module.bsl");
	КонецЕсли;

	Если ВидМодуля = МодульКоманды Тогда
		Файл = НайтиКомандуXML(Корень, ИДОбъекта, СписокКаталоговМодульКоманды());
		Если Файл = Неопределено Тогда
			Файл = НайтиФайлОбъектаXML(Корень, ИДОбъекта, "CommonCommands");
		КонецЕсли;
		Возврат ФайлМодуляРядомСОбъектомXML(Файл, "CommandModule.bsl");
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область ПоискEDT

// Поиск каталога объекта метаданных EDT по uuid в непосредственных подкаталогах указанной группы.
Функция НайтиОбъект(Знач Корень, Знач ИДОбъекта, Знач ГруппаОбъектов)

	ИзКеша = Кеш.Получить(КлючКеша(ИДОбъекта, Корень));
	Если ИзКеша <> Неопределено Тогда
		Возврат ИзКеша;
	КонецЕсли;

	КаталогГруппы = ОбъединитьПути(Корень, ГруппаОбъектов);
	Для Каждого КаталогОбъекта Из НайтиФайлы(КаталогГруппы, "*", Ложь) Цикл

		ФайлМдо = ПервыйФайлПоМаске(КаталогОбъекта.ПолноеИмя, "*.mdo");
		Если ФайлМдо = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ИД = ПрочитатьUuid(ФайлМдо);
		ДобавитьВКеш(ИД, Корень, КаталогОбъекта.ПолноеИмя);

		Если ИД = ИДОбъекта Тогда
			Возврат КаталогОбъекта.ПолноеИмя;
		КонецЕсли;

	КонецЦикла;

	Возврат Кеш.Получить(КлючКеша(ИДОбъекта, Корень));

КонецФункции

Функция НайтиОбъектВКаталогах(Знач Корень, Знач ИДОбъекта, Знач Группы)

	Для Каждого Группа Из Группы Цикл
		Результат = НайтиОбъект(Корень, ИДОбъекта, Группа);
		Если Результат <> Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Поиск каталога подчинённого объекта EDT (форма/команда) по uuid из родительского .mdo.
Функция НайтиПодОбъектВКаталогахEDT(Знач Корень, Знач ИДОбъекта, Знач Группы, Знач ИмяПодкаталога, Знач ЛокальноеИмя)

	Для Каждого Группа Из Группы Цикл
		Результат = НайтиПодчиненныйEDT(Корень, ИДОбъекта, Группа, ИмяПодкаталога, ЛокальноеИмя);
		Если Результат <> Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция НайтиПодчиненныйEDT(Знач Корень, Знач ИДОбъекта, Знач Группа, Знач ИмяПодкаталога, Знач ЛокальноеИмя)

	ИзКеша = Кеш.Получить(КлючКеша(ИДОбъекта, Корень));
	Если ИзКеша <> Неопределено Тогда
		Возврат ИзКеша;
	КонецЕсли;

	КаталогГруппы = ОбъединитьПути(Корень, Группа);
	Для Каждого КаталогОбъекта Из НайтиФайлы(КаталогГруппы, "*", Ложь) Цикл

		ФайлМдо = ПервыйФайлПоМаске(КаталогОбъекта.ПолноеИмя, "*.mdo");
		Если ФайлМдо = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого Подчиненный Из ПодчиненныеОбъектыMdo(ФайлМдо, ЛокальноеИмя) Цикл
			КаталогПодчиненного = ОбъединитьПути(КаталогОбъекта.ПолноеИмя, ИмяПодкаталога, Подчиненный.Значение);
			ДобавитьВКеш(Подчиненный.Ключ, Корень, КаталогПодчиненного);
		КонецЦикла;

	КонецЦикла;

	Возврат Кеш.Получить(КлючКеша(ИДОбъекта, Корень));

КонецФункции

// Прочитать подчинённые объекты (uuid -> имя) из .mdo родителя (EDT): элементы forms/commands/recalculations.
Функция ПодчиненныеОбъектыMdo(Знач ФайлМдо, Знач ЛокальноеИмя)

	Результат = Новый Массив;

	Чтение = Новый ЧтениеXML;
	Чтение.ОткрытьФайл(ФайлМдо);
	Чтение.ПерейтиКСодержимому();
	Чтение.Прочитать();

	Пока Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Цикл

		Если Чтение.ЛокальноеИмя = ЛокальноеИмя Тогда
			ИД = Чтение.ЗначениеАтрибута("uuid");
			Имя = "";
			Чтение.Прочитать();
			Пока Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Цикл
				Если Чтение.ЛокальноеИмя = "name" Тогда
					Чтение.Прочитать();
					Имя = Чтение.Значение;
					Чтение.Прочитать();
				Иначе
					Чтение.Пропустить();
					Чтение.Прочитать();
				КонецЕсли;
			КонецЦикла;
			Если ЗначениеЗаполнено(ИД) И ЗначениеЗаполнено(Имя) Тогда
				Результат.Добавить(Новый Структура("Ключ, Значение", ИД, Имя));
			КонецЕсли;
			Чтение.Прочитать();
		Иначе
			Чтение.Пропустить();
			Чтение.Прочитать();
		КонецЕсли;

	КонецЦикла;

	Чтение.Закрыть();

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ПоискXML

// Поиск .xml-файла объекта метаданных XML-дампа по uuid в указанной группе.
Функция НайтиФайлОбъектаXML(Знач Корень, Знач ИДОбъекта, Знач Группа)

	ИзКеша = Кеш.Получить(КлючКеша(ИДОбъекта, Корень));
	Если ИзКеша <> Неопределено Тогда
		Возврат ИзКеша;
	КонецЕсли;

	КаталогГруппы = ОбъединитьПути(Корень, Группа);
	Для Каждого ФайлОбъекта Из НайтиФайлы(КаталогГруппы, "*.xml", Ложь) Цикл
		ИД = ПрочитатьUuidXML(ФайлОбъекта.ПолноеИмя);
		ДобавитьВКеш(ИД, Корень, ФайлОбъекта.ПолноеИмя);
		Если ИД = ИДОбъекта Тогда
			Возврат ФайлОбъекта.ПолноеИмя;
		КонецЕсли;
	КонецЦикла;

	Возврат Кеш.Получить(КлючКеша(ИДОбъекта, Корень));

КонецФункции

Функция НайтиФайлОбъектаВКаталогахXML(Знач Корень, Знач ИДОбъекта, Знач Группы)

	Для Каждого Группа Из Группы Цикл
		Результат = НайтиФайлОбъектаXML(Корень, ИДОбъекта, Группа);
		Если Результат <> Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Поиск .xml-файла вложенного объекта (перерасчёт) по uuid из подкаталога родителя.
Функция НайтиВложенныйФайлXML(Знач Корень, Знач ИДОбъекта, Знач ТипОбъектов, Знач ТипПодобъектов)

	КаталогГруппы = ОбъединитьПути(Корень, ТипОбъектов);
	Для Каждого ФайлРодителя Из НайтиФайлы(КаталогГруппы, "*.xml", Ложь) Цикл
		КаталогПодобъектов = ОбъединитьПути(КаталогОбъектаXML(ФайлРодителя.ПолноеИмя), ТипПодобъектов);
		Для Каждого ФайлПодобъекта Из НайтиФайлы(КаталогПодобъектов, "*.xml", Ложь) Цикл
			ИД = ПрочитатьUuidXML(ФайлПодобъекта.ПолноеИмя);
			ДобавитьВКеш(ИД, Корень, ФайлПодобъекта.ПолноеИмя);
			Если ИД = ИДОбъекта Тогда
				Возврат ФайлПодобъекта.ПолноеИмя;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Кеш.Получить(КлючКеша(ИДОбъекта, Корень));

КонецФункции

// Поиск формы (XML-дамп): вложенные объекты Forms родительских объектов групп.
Функция НайтиФормуXML(Знач Корень, Знач ИДОбъекта, Знач Группы)

	Для Каждого Группа Из Группы Цикл
		Результат = НайтиВложенныйФайлXML(Корень, ИДОбъекта, Группа, "Forms");
		Если Результат <> Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Поиск команды (XML-дамп): подчинённые Commands в родительском .xml.
Функция НайтиКомандуXML(Знач Корень, Знач ИДОбъекта, Знач Группы)

	Для Каждого Группа Из Группы Цикл
		КаталогГруппы = ОбъединитьПути(Корень, Группа);
		Для Каждого ФайлРодителя Из НайтиФайлы(КаталогГруппы, "*.xml", Ложь) Цикл
			КаталогРодителя = КаталогОбъектаXML(ФайлРодителя.ПолноеИмя);
			Для Каждого Подчиненный Из ПодчиненныеОбъектыXML(ФайлРодителя.ПолноеИмя, "Command") Цикл
				КаталогКоманды = ОбъединитьПути(КаталогРодителя, "Commands", Подчиненный.Значение);
				ДобавитьВКеш(Подчиненный.Ключ, Корень, КаталогКоманды);
			КонецЦикла;
			Возможный = Кеш.Получить(КлючКеша(ИДОбъекта, Корень));
			Если Возможный <> Неопределено Тогда
				Возврат Возможный;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Прочитать подчинённые объекты (uuid -> имя) из .xml родителя (XML-дамп): узлы ChildObjects/<Тип>.
Функция ПодчиненныеОбъектыXML(Знач ФайлРодителя, Знач ЛокальноеИмяТипа)

	Результат = Новый Массив;

	Чтение = Новый ЧтениеXML;
	Чтение.ОткрытьФайл(ФайлРодителя);
	Чтение.ПерейтиКСодержимому();
	Чтение.Прочитать();
	Чтение.Прочитать();

	Пока Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Цикл
		Если Чтение.ЛокальноеИмя = "ChildObjects" Тогда
			Чтение.Прочитать();
			Пока Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Цикл
				Если Чтение.ЛокальноеИмя = ЛокальноеИмяТипа Тогда
					ИД = Чтение.ЗначениеАтрибута("uuid");
					Имя = ИмяВложенногоОбъектаXML(Чтение);
					Если ЗначениеЗаполнено(ИД) И ЗначениеЗаполнено(Имя) Тогда
						Результат.Добавить(Новый Структура("Ключ, Значение", ИД, Имя));
					КонецЕсли;
				Иначе
					Чтение.Пропустить();
					Чтение.Прочитать();
				КонецЕсли;
			КонецЦикла;
			Чтение.Прочитать();
		Иначе
			Чтение.Пропустить();
			Чтение.Прочитать();
		КонецЕсли;
	КонецЦикла;

	Чтение.Закрыть();

	Возврат Результат;

КонецФункции

Функция ИмяВложенногоОбъектаXML(Чтение)

	Имя = Неопределено;

	Чтение.Прочитать();
	Пока Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Цикл
		Если Чтение.ЛокальноеИмя = "Properties" Тогда
			Чтение.Прочитать();
			Пока Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Цикл
				Если Чтение.ЛокальноеИмя = "Name" Тогда
					Чтение.Прочитать();
					Имя = Чтение.Значение;
					Чтение.Прочитать();
				Иначе
					Чтение.Пропустить();
					Чтение.Прочитать();
				КонецЕсли;
			КонецЦикла;
			Чтение.Прочитать();
		Иначе
			Чтение.Пропустить();
			Чтение.Прочитать();
		КонецЕсли;
	КонецЦикла;
	Чтение.Прочитать();

	Возврат Имя;

КонецФункции

Функция КаталогОбъектаXML(Знач ФайлОбъекта)
	Файл = Новый Файл(ФайлОбъекта);
	Возврат ОбъединитьПути(Файл.Путь, Файл.ИмяБезРасширения);
КонецФункции

Функция ФайлМодуляРядомСОбъектомXML(Знач ФайлОбъекта, Знач ИмяФайлаМодуля)
	Если ФайлОбъекта = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ОбъединитьПути(КаталогОбъектаXML(ФайлОбъекта), "Ext", ИмяФайлаМодуля);
КонецФункции

#КонецОбласти

