// BSLLS:LatinAndCyrillicSymbolInWord-off Технические имена полей формата stat.json (#path и т.п.).
// BSLLS:MissingParameterDescription-off Внутренние вспомогательные функции.
// BSLLS:MissingReturnedValueDescription-off Внутренние вспомогательные функции.
//
// Запись карты покрытия в формат stat.json библиотеки coverage (khorevaa/oscript-coverage).
//
// Формат: { "<путь>": { "#path": "<путь>", "Module": { "<строка>": {"count":N,"time":T} } } }.
// coveragebsl не даёт имён методов, поэтому все строки файла помещаются в один синтетический
// метод "Module" - для формата genericCoverage (SonarQube) имена методов не используются.

#Область ПрограммныйИнтерфейс

// Записать карту покрытия в файл формата stat.json.
//
// Параметры:
//   Покрытие   - Соответствие - путь к файлу -> Соответствие "строка" -> Структура{count, time}
//   ФайлВывода - Строка       - путь к результирующему stat.json
//
// Возвращаемое значение:
//   Число - количество файлов, попавших в отчёт
//
Функция Записать(Знач Покрытие, Знач ФайлВывода) Экспорт

	Запись = Новый ЗаписьJSON;
	ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, Символы.Таб);
	Запись.ОткрытьФайл(ФайлВывода, "UTF-8", Ложь, ПараметрыЗаписи);

	Запись.ЗаписатьНачалоОбъекта();

	Количество = 0;
	Для Каждого ФайлИСтроки Из Покрытие Цикл

		Путь = ФайлИСтроки.Ключ;
		Строки = ФайлИСтроки.Значение;

		Запись.ЗаписатьИмяСвойства(Путь);
		Запись.ЗаписатьНачалоОбъекта();

		Запись.ЗаписатьИмяСвойства("#path");
		Запись.ЗаписатьЗначение(Путь);

		Запись.ЗаписатьИмяСвойства("Module");
		Запись.ЗаписатьНачалоОбъекта();
		Для Каждого СтрокаПокрытия Из Строки Цикл
			Запись.ЗаписатьИмяСвойства(СтрокаПокрытия.Ключ);
			Запись.ЗаписатьНачалоОбъекта();
			Запись.ЗаписатьИмяСвойства("count");
			Запись.ЗаписатьЗначение(СтрокаПокрытия.Значение.count);
			Запись.ЗаписатьИмяСвойства("time");
			Запись.ЗаписатьЗначение(СтрокаПокрытия.Значение.time);
			Запись.ЗаписатьКонецОбъекта();
		КонецЦикла;
		Запись.ЗаписатьКонецОбъекта();

		Запись.ЗаписатьКонецОбъекта();
		Количество = Количество + 1;

	КонецЦикла;

	Запись.ЗаписатьКонецОбъекта();
	Запись.Закрыть();

	Возврат Количество;

КонецФункции

#КонецОбласти
