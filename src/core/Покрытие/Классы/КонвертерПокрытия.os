// BSLLS:LatinAndCyrillicSymbolInWord-off Технические имена полей сырого JSON coveragebsl.
// BSLLS:MissingVariablesDescription-off Внутреннее состояние конвертера.
// BSLLS:MissingParameterDescription-off Внутренние вспомогательные функции.
// BSLLS:MissingReturnedValueDescription-off Внутренние вспомогательные функции.
// BSLLS:Typo-off Доменные термины.
// BSLLS:IfElseIfEndsWithElse-off Диспетчер по типу контейнера модуля завершается Возврат "".
//
// Конвертер данных покрытия coveragebsl в карту "файл исходника -> покрытые строки".
//
// На входе - «сырой» JSON, сериализованный компонентой coveragebsl
// (ДанныеПокрытия.СериализоватьJSON): { "TotalDurability": N, "Data": [ { "ModuleId": {...},
// "LineInfo": [ {...} ] } ] }.
// На выходе - Соответствие: полный путь к .bsl-файлу -> Соответствие "номер строки" -> {count, time}.
//
// Поддерживаются модули конфигурации (ConfigModule) и расширений (ExtensionModule).
// Внешние модули (ExtMDModule) и системные модули игнорируются.

#Область ОписаниеПеременных

Перем КонвертерКонфигурации;   // КонвертерИсходников, Неопределено
Перем КонвертерыРасширений;    // Соответствие: НРег(ИмяРасширения) -> КонвертерИсходников

Перем ТипМодуляКонфигурации;
Перем ТипМодуляРасширения;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Задать исходники основной конфигурации.
//
// Параметры:
//   КаталогИсходников - Строка - каталог исходников конфигурации
//   Формат            - Строка - "EDT" или "XML"
//
Процедура УстановитьКонфигурацию(Знач КаталогИсходников, Знач Формат) Экспорт
	КонвертерКонфигурации = Новый КонвертерИсходников(КаталогИсходников, Формат);
КонецПроцедуры

// Добавить исходники расширения.
//
// Параметры:
//   ИмяРасширения     - Строка - имя расширения (как в данных отладчика, ExtensionName)
//   КаталогИсходников - Строка - каталог исходников расширения
//   Формат            - Строка - "EDT" или "XML"
//
Процедура ДобавитьРасширение(Знач ИмяРасширения, Знач КаталогИсходников, Знач Формат) Экспорт
	КонвертерыРасширений.Вставить(НРег(ИмяРасширения), Новый КонвертерИсходников(КаталогИсходников, Формат));
КонецПроцедуры

// Есть ли хотя бы один настроенный источник (конфигурация или расширение).
//
// Возвращаемое значение:
//   Булево
//
Функция ЕстьИсточники() Экспорт
	Возврат КонвертерКонфигурации <> Неопределено ИЛИ КонвертерыРасширений.Количество() > 0;
КонецФункции

// Разобрать сырой JSON покрытия coveragebsl в карту покрытых строк по файлам.
//
// Параметры:
//   ФайлСырогоJSON - Строка - путь к JSON, сериализованному coveragebsl
//
// Возвращаемое значение:
//   Соответствие - полный путь к файлу -> Соответствие "номер строки"(Строка) -> Структура{count, time}
//
Функция Конвертировать(Знач ФайлСырогоJSON) Экспорт

	Данные = ПрочитатьСырыеДанные(ФайлСырогоJSON);
	Покрытие = Новый Соответствие;

	Модули = Поле(Данные, "Data");
	Если Модули = Неопределено Тогда
		Возврат Покрытие;
	КонецЕсли;

	Для Каждого ДанныеМодуля Из Модули Цикл

		МодульИД = Поле(ДанныеМодуля, "ModuleId");
		Если МодульИД = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ПутьФайла = НайтиПутьФайла(МодульИД);
		Если НЕ ЗначениеЗаполнено(ПутьФайла) Тогда
			Продолжить;
		КонецЕсли;

		СтрокиФайла = Покрытие.Получить(ПутьФайла);
		Если СтрокиФайла = Неопределено Тогда
			СтрокиФайла = Новый Соответствие;
			Покрытие.Вставить(ПутьФайла, СтрокиФайла);
		КонецЕсли;

		НакопитьСтроки(СтрокиФайла, Поле(ДанныеМодуля, "LineInfo"));

	КонецЦикла;

	Возврат Покрытие;

КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриСозданииОбъекта()
	КонвертерКонфигурации = Неопределено;
	КонвертерыРасширений = Новый Соответствие;
	ТипМодуляКонфигурации = "ConfigModule";
	ТипМодуляРасширения = "ExtensionModule";
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НайтиПутьФайла(Знач МодульИД)

	ТипМодуля = Поле(МодульИД, "ModuleType");
	ВидМодуля = Поле(МодульИД, "PropertyID");
	ИДОбъекта = Поле(МодульИД, "ObjectID");

	Если НЕ ЗначениеЗаполнено(ВидМодуля) Тогда
		Возврат "";
	КонецЕсли;

	Если ТипМодуля = ТипМодуляКонфигурации Тогда
		Если КонвертерКонфигурации = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		Возврат Строка_(КонвертерКонфигурации.НайтиФайлМодуля(ВидМодуля, ИДОбъекта));
	КонецЕсли;

	Если ТипМодуля = ТипМодуляРасширения Тогда
		ИмяРасширения = Поле(МодульИД, "ExtensionName");
		Конвертер = КонвертерыРасширений.Получить(НРег(?(ИмяРасширения = Неопределено, "", ИмяРасширения)));
		Если Конвертер = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		Возврат Строка_(Конвертер.НайтиФайлМодуля(ВидМодуля, ИДОбъекта));
	КонецЕсли;

	Возврат "";

КонецФункции

Процедура НакопитьСтроки(СтрокиФайла, Знач LineInfo)

	Если LineInfo = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Строка_ Из LineInfo Цикл

		НомерСтроки = Поле(Строка_, "LineNo");
		Если НЕ ЗначениеЗаполнено(НомерСтроки) Тогда
			Продолжить;
		КонецЕсли;

		Ключ = Строка(Число(НомерСтроки));
		Частота = Число(?(Поле(Строка_, "Frequency") = Неопределено, 0, Поле(Строка_, "Frequency")));
		Время = Число(?(Поле(Строка_, "Durability") = Неопределено, 0, Поле(Строка_, "Durability")));

		Текущее = СтрокиФайла.Получить(Ключ);
		Если Текущее = Неопределено Тогда
			СтрокиФайла.Вставить(Ключ, Новый Структура("count, time", Частота, Время));
		Иначе
			Текущее.count = Макс(Текущее.count, Частота);
			Текущее.time = Макс(Текущее.time, Время);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Функция ПрочитатьСырыеДанные(Знач ФайлСырогоJSON)

	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(ФайлСырогоJSON, "UTF-8");
	Попытка
		Данные = ПрочитатьJSON(Чтение);
	Исключение
		Чтение.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	Чтение.Закрыть();

	Возврат Данные;

КонецФункции

// Доступ к полю объекта, прочитанного из JSON (Структура или Соответствие).
Функция Поле(Знач Объект, Знач Имя)

	Если ТипЗнч(Объект) = Тип("Структура") Тогда
		Значение = Неопределено;
		Объект.Свойство(Имя, Значение);
		Возврат Значение;
	ИначеЕсли ТипЗнч(Объект) = Тип("Соответствие") Тогда
		Возврат Объект.Получить(Имя);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция Строка_(Знач Значение)
	Возврат ?(Значение = Неопределено, "", Строка(Значение));
КонецФункции

#КонецОбласти
