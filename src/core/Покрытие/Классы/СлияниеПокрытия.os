// BSLLS:LatinAndCyrillicSymbolInWord-off Технические имена полей (count/time) и путей.
// BSLLS:Typo-off Доменные термины (покрываемые строки).
// BSLLS:MagicNumber-off Множитель процента (100).
// BSLLS:NumberOfValuesInStructureConstructor-off
//
// Слияние двух источников покрытия в единую карту для отчета и подсчет процента:
//   - ИСПОЛНЕННЫЕ строки (из coveragebsl -> КонвертерПокрытия): путь -> "строка" -> {count, time};
//   - ПОКРЫВАЕМЫЕ строки (из утилиты lines-to-cover): путь -> массив номеров строк (знаменатель).
//
// Результат: путь -> "строка" -> {count, time}, где покрываемые, но не исполненные строки
// добавлены с count=0. Так библиотека coverage считает полный знаменатель и корректный процент.
//
// Пути обоих источников приводятся к общему нормализованному ключу (разделители/регистр),
// т.к. КонвертерПокрытия отдает пути в разделителях ОС, а lines-to-cover - через "/".

#Область ПрограммныйИнтерфейс

// Слить исполненное покрытие с покрываемыми строками.
//
// Параметры:
//   ИсполненноеПокрытие - Соответствие - путь -> Соответствие "строка"(Строка) -> Структура{count, time}
//   ПокрываемыеСтроки   - Соответствие, Неопределено - путь(Строка) -> Массив номеров строк (Число)
//
// Возвращаемое значение:
//   Соответствие - путь -> Соответствие "строка"(Строка) -> Структура{count, time} (объединение)
//
Функция Слить(Знач ИсполненноеПокрытие, Знач ПокрываемыеСтроки) Экспорт

	ПоКлючу = Новый Соответствие; // нормализованный ключ пути -> Структура{Путь, Строки}

	Для Каждого ФайлКЗ Из ИсполненноеПокрытие Цикл
		ПоКлючу.Вставить(КлючПути(ФайлКЗ.Ключ), Новый Структура("Путь, Строки", ФайлКЗ.Ключ, ФайлКЗ.Значение));
	КонецЦикла;

	Если ПокрываемыеСтроки <> Неопределено Тогда
		Для Каждого ФайлКЗ Из ПокрываемыеСтроки Цикл

			ОСПуть = Новый Файл(ФайлКЗ.Ключ).ПолноеИмя;
			Ключ = КлючПути(ОСПуть);

			Запись = ПоКлючу.Получить(Ключ);
			Если Запись = Неопределено Тогда
				Запись = Новый Структура("Путь, Строки", ОСПуть, Новый Соответствие);
				ПоКлючу.Вставить(Ключ, Запись);
			КонецЕсли;

			Для Каждого Номер Из ФайлКЗ.Значение Цикл
				КлючСтроки = Строка(Число(Номер));
				Если Запись.Строки.Получить(КлючСтроки) = Неопределено Тогда
					Запись.Строки.Вставить(КлючСтроки, Новый Структура("count, time", 0, 0));
				КонецЕсли;
			КонецЦикла;

		КонецЦикла;
	КонецЕсли;

	Результат = Новый Соответствие;
	Для Каждого КЗ Из ПоКлючу Цикл
		Результат.Вставить(КЗ.Значение.Путь, КЗ.Значение.Строки);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Подсчитать статистику покрытия по итоговой карте.
//
// Параметры:
//   Покрытие - Соответствие - путь -> Соответствие "строка" -> Структура{count, time}
//
// Возвращаемое значение:
//   Структура - Всего (Число), Покрыто (Число), Процент (Число, 0..100)
//
Функция Статистика(Знач Покрытие) Экспорт

	Всего = 0;
	Покрыто = 0;

	Для Каждого ФайлКЗ Из Покрытие Цикл
		Для Каждого СтрокаКЗ Из ФайлКЗ.Значение Цикл
			Всего = Всего + 1;
			Если СтрокаКЗ.Значение.count > 0 Тогда
				Покрыто = Покрыто + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Процент = ?(Всего > 0, Окр(Покрыто / Всего * 100, 1), 0);
	Возврат Новый Структура("Всего, Покрыто, Процент", Всего, Покрыто, Процент);

КонецФункции

// Нормализованный ключ пути для сопоставления источников (разделители -> "/", нижний регистр).
//
// Параметры:
//   Путь - Строка - путь к файлу
//
// Возвращаемое значение:
//   Строка - ключ сравнения
//
Функция КлючПути(Знач Путь) Экспорт
	Возврат НРег(СтрЗаменить(Строка(Путь), "\", "/"));
КонецФункции

#КонецОбласти
