// BSLLS:UnusedLocalMethod-off ПриСозданииОбъекта вызывается рантаймом при Новый.
// BSLLS:NumberOfValuesInStructureConstructor-off Описание тест-кейса - плоская структура.
// BSLLS:DuplicateStringLiteral-off Имена атрибутов JUnit.
// BSLLS:MissingVariablesDescription-off Внутреннее состояние генератора.
// Формирование отчёта проверки в формате JUnit XML: один набор testsuite и по testcase
// на замечание (проваленный - с элементом failure). Общий для validate syntax-check
// и validate edt: различается только то, как команда раскладывает замечания по кейсам.
// Кейс «проверка прошла» при отсутствии замечаний добавляет сама команда: пустой набор
// в отчёте неотличим от прогона, который до отчёта не дошёл.

Перем _ИмяНабора; // Строка - имя набора (атрибут name у testsuite), общее для всех кейсов

Процедура ПриСозданииОбъекта(Знач ИмяНабора)

	_ИмяНабора = ИмяНабора;

КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Описание тест-кейса отчёта.
//
// Параметры:
//   Имя - Строка - имя тест-кейса (атрибут name)
//   ИмяКласса - Строка - атрибут classname; пусто - имя набора
//
// Возвращаемое значение:
//   Структура:
//    * Имя - Строка - имя тест-кейса
//    * ИмяКласса - Строка - атрибут classname
//    * Провален - Булево - писать элемент failure
//    * Сообщение - Строка - текст замечания (атрибут message элемента failure)
//
Функция НовыйСлучай(Знач Имя, Знач ИмяКласса = "") Экспорт

	Возврат Новый Структура("Имя, ИмяКласса, Провален, Сообщение",
		Имя, ?(ЗначениеЗаполнено(ИмяКласса), ИмяКласса, _ИмяНабора), Ложь, "");

КонецФункции

// Записать отчёт.
//
// Параметры:
//   ПутьОтчета - Строка - путь к файлу отчёта; каталог должен существовать
//   Случаи - Массив - Элементы <Структура> (см. НовыйСлучай)
//   ДлительностьСек - Число - длительность проверки в секундах (атрибут time)
//
// Возвращаемое значение:
//   Число - количество проваленных кейсов (атрибут failures)
//
Функция Записать(Знач ПутьОтчета, Знач Случаи, Знач ДлительностьСек) Экспорт

	Провалено = 0;
	Для Каждого Случай Из Случаи Цикл
		Провалено = Провалено + ?(Случай.Провален, 1, 0);
	КонецЦикла;

	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ПутьОтчета);
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	ЗаписьXML.ЗаписатьНачалоЭлемента("testsuites");

	ЗаписьXML.ЗаписатьНачалоЭлемента("testsuite");
	ЗаписьXML.ЗаписатьАтрибут("name", _ИмяНабора);
	ЗаписьXML.ЗаписатьАтрибут("tests", XMLСтрока(Макс(Случаи.Количество(), 1)));
	ЗаписьXML.ЗаписатьАтрибут("failures", XMLСтрока(Провалено));
	ЗаписьXML.ЗаписатьАтрибут("time", XMLСтрока(ДлительностьСек));

	Для Каждого Случай Из Случаи Цикл
		ЗаписьXML.ЗаписатьНачалоЭлемента("testcase");
		ЗаписьXML.ЗаписатьАтрибут("name", Случай.Имя);
		ЗаписьXML.ЗаписатьАтрибут("classname", Случай.ИмяКласса);
		Если Случай.Провален Тогда
			ЗаписьXML.ЗаписатьНачалоЭлемента("failure");
			ЗаписьXML.ЗаписатьАтрибут("message", Случай.Сообщение);
			ЗаписьXML.ЗаписатьКонецЭлемента();
		КонецЕсли;
		ЗаписьXML.ЗаписатьКонецЭлемента();
	КонецЦикла;

	ЗаписьXML.ЗаписатьКонецЭлемента(); // testsuite
	ЗаписьXML.ЗаписатьКонецЭлемента(); // testsuites
	ЗаписьXML.Закрыть();

	Возврат Провалено;

КонецФункции

#КонецОбласти
