// BSLLS:MissingVariablesDescription-off Поля autumn (&Лог/&Желудь).
// BSLLS:MissingReturnedValueDescription-off Внутренние вспомогательные функции.
// BSLLS:MissingParameterDescription-off Внутренние вспомогательные функции.
// BSLLS:NumberOfValuesInStructureConstructor-off Описание источника (5 полей).
// Сервис определения вида источников конфигурации и расширений и их рекурсивного поиска.
//
// Правила распознавания пути (сверху вниз):
//   .cf / .dt                                            -> конфигурация;
//   .cfe                                                 -> расширение;
//   каталог с .project и DT-INF либо *.mdo в src         -> EDT-проект;
//   каталог с Configuration.xml или ConfigDumpInfo.xml   -> XML-дамп Конфигуратора;
//   каталог с единственным вложенным EDT-проектом        -> этот проект (только в Описать).
// Содержимое каталога (конфигурация или расширение) - по дескриптору Configuration.xml /
// Configuration.mdo (см. СодержитМаркерРасширения). В каталоги-источники рекурсия не заходит.

&Лог("vrunner")
Перем Лог;

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Описать источник по пути: вид - по расширению файла или маркерам каталога, содержимое - по дескриптору.
// Существование пути не проверяется: несуществующий .cf/.cfe/.dt описывается по расширению,
// прочие несуществующие пути - не источник. Несколько вложенных EDT-проектов - исключение.
//
// Параметры:
//   Путь - Строка - путь к файлу или каталогу
//
// Возвращаемое значение:
//   Структура:
//     * Вид             - Строка - "cf" | "cfe" | "dt" | "xml" | "edt" | "" (не источник)
//     * Содержимое      - Строка - "Конфигурация" | "Расширение" | ""
//     * КорневойКаталог - Строка - полный путь; для edt - корень проекта (сам каталог или единственный вложенный)
//     * Дескриптор      - Строка - существующий Configuration.xml / src/Configuration/Configuration.mdo либо ""
//     * Имя             - Строка - имя каталога; для .cf/.cfe/.dt - имя файла без расширения
//
Функция Описать(Знач Путь) Экспорт

	Описание = ОписатьПоМаркерам(Путь);
	Если Описание.Вид <> "" Тогда
		Возврат Описание;
	КонецЕсли;

	Проекты = ВложенныеПроектыEDT(Описание.КорневойКаталог);
	Если Проекты.Количество() > 1 Тогда
		ВызватьИсключение СтрШаблон(
			"В каталоге %1 найдено несколько EDT-проектов. Укажите путь к конкретному проекту.", Путь);
	КонецЕсли;
	Если Проекты.Количество() = 1 Тогда
		// Имя остаётся именем указанного каталога: по нему именуются расширение и временный проект.
		Имя = Описание.Имя;
		Описание = ОписатьПоМаркерам(Проекты[0]);
		Описание.Имя = Имя;
	КонецЕсли;

	Возврат Описание;

КонецФункции

// Рекурсивно найти и классифицировать источники в каталоге.
//
// Параметры:
//   КорневойКаталог - Строка - каталог для поиска
//
// Возвращаемое значение:
//   Структура - результат поиска:
//     * Конфигурации - Массив из Строка - пути найденных источников конфигурации
//     * Расширения   - Массив из Строка - пути найденных источников расширений
//
Функция НайтиИсточники(Знач КорневойКаталог) Экспорт

	Лог.Отладка("Рекурсивный поиск источников в: %1", КорневойКаталог);

	Конфигурации = Новый Массив;
	Расширения = Новый Массив;
	СобратьИсточники(КорневойКаталог, Конфигурации, Расширения);

	Возврат Новый Структура("Конфигурации, Расширения", Конфигурации, Расширения);

КонецФункции

// Рекурсивно найти источники конфигурации (расширения исключаются).
//
// Параметры:
//   КорневойКаталог - Строка - каталог для поиска
//
// Возвращаемое значение:
//   Массив из Строка - пути найденных источников конфигурации
//
Функция НайтиКонфигурацию(Знач КорневойКаталог) Экспорт
	Возврат НайтиИсточники(КорневойКаталог).Конфигурации;
КонецФункции

// Рекурсивно найти источники расширений (конфигурация исключается).
//
// Параметры:
//   КорневойКаталог - Строка - каталог для поиска
//
// Возвращаемое значение:
//   Массив из Строка - пути найденных источников расширений
//
Функция НайтиРасширения(Знач КорневойКаталог) Экспорт
	Возврат НайтиИсточники(КорневойКаталог).Расширения;
КонецФункции

// Проверить, что найден не более одного источника конфигурации.
// Ноль источников - допустимо (загрузка будет пропущена).
// Больше одного - ошибка с читабельным описанием.
//
// Параметры:
//   НайденныеИсточники - Массив из Строка - результат поиска конфигураций
//   КорневойКаталог    - Строка           - исходный каталог (для сообщения об ошибке)
//
Процедура ПроверитьОдинИсточникКонфигурации(Знач НайденныеИсточники, Знач КорневойКаталог) Экспорт

	Если НайденныеИсточники.Количество() <= 1 Тогда
		Возврат;
	КонецЕсли;

	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон("Неоднозначность при рекурсивном поиске в ""%1"".", КорневойКаталог));
	Строки.Добавить(СтрШаблон("Найдено источников конфигурации: %1, ожидался один.", НайденныеИсточники.Количество()));
	Строки.Добавить("");
	Строки.Добавить("Обнаруженные конфигурации:");
	Для Каждого ПутьИсточника Из НайденныеИсточники Цикл
		Строки.Добавить(СтрШаблон("    - %1", ПутьИсточника));
	КонецЦикла;
	Строки.Добавить("");
	Строки.Добавить("Оставьте в каталоге одну конфигурацию или укажите ее явно через --src.");

	ВызватьИсключение СтрСоединить(Строки, Символы.ПС);

КонецПроцедуры

// Проверить, что среди найденных расширений нет двух с одинаковым именем.
// Имя определяется из пути: имя .cfe-файла без расширения или имя каталога с исходниками.
//
// Параметры:
//   НайденныеРасширения - Массив из Строка - результат поиска расширений
//
Процедура ПроверитьУникальностьИменРасширений(Знач НайденныеРасширения) Экспорт

	УжеВстреченные = Новый Соответствие;

	Для Каждого Путь Из НайденныеРасширения Цикл
		ИмяРасширения = ОписатьПоМаркерам(Путь).Имя;
		Ключ = НРег(ИмяРасширения);
		ПредыдущийПуть = УжеВстреченные[Ключ];
		Если ПредыдущийПуть <> Неопределено Тогда
			ВызватьИсключение СообщениеОКонфликтеИмен(ИмяРасширения, ПредыдущийПуть, Путь);
		КонецЕсли;
		УжеВстреченные.Вставить(Ключ, Путь);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Рекурсивно обойти путь, классифицируя найденные источники.
// Если путь сам является источником - добавить его и не углубляться внутрь.
Процедура СобратьИсточники(Знач Путь, Конфигурации, Расширения)

	Файл = Новый Файл(Путь);
	Если НЕ Файл.Существует() Тогда
		Возврат;
	КонецЕсли;

	Описание = ОписатьПоМаркерам(Путь);
	Если Описание.Содержимое = ТипКонфигурация() Тогда
		Конфигурации.Добавить(Описание.КорневойКаталог);
		Возврат;
	КонецЕсли;
	Если Описание.Содержимое = ТипРасширение() Тогда
		Расширения.Добавить(Описание.КорневойКаталог);
		Возврат;
	КонецЕсли;

	Если НЕ Файл.ЭтоКаталог() Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Элемент Из НайтиФайлы(Путь, "*", Ложь) Цикл
		СобратьИсточники(Элемент.ПолноеИмя, Конфигурации, Расширения);
	КонецЦикла;

КонецПроцедуры

// Описание по собственным маркерам пути, без поиска вложенных EDT-проектов.
Функция ОписатьПоМаркерам(Знач Путь)

	// По полному пути: имя относительного "." - имя каталога, а не точка.
	Файл = Новый Файл(Новый Файл(Путь).ПолноеИмя);
	ЭтоКаталог = Файл.Существует() И Файл.ЭтоКаталог();
	Вид = ?(ЭтоКаталог, ВидКаталога(Файл.ПолноеИмя), ВидФайла(Файл.Расширение));
	Дескриптор = ФайлДескриптора(Вид, Файл.ПолноеИмя);

	Возврат Новый Структура("Вид, Содержимое, КорневойКаталог, Дескриптор, Имя",
		Вид, СодержимоеИсточника(Вид, Дескриптор), Файл.ПолноеИмя, Дескриптор,
		?(ЭтоКаталог ИЛИ Вид = "", Файл.Имя, Файл.ИмяБезРасширения));

КонецФункции

// Вид файлового источника по расширению: "cf" | "cfe" | "dt" | "".
Функция ВидФайла(Знач Расширение)
	Вид = СтрЗаменить(НРег(Расширение), ".", "");
	Возврат ?(Вид = "cf" ИЛИ Вид = "cfe" ИЛИ Вид = "dt", Вид, "");
КонецФункции

// Вид каталога по его маркерам: EDT-проект, XML-дамп Конфигуратора или "".
Функция ВидКаталога(Знач Путь)
	Если ЭтоКаталогEDT(Путь) Тогда
		Возврат ВидEDT();
	КонецЕсли;
	Возврат ?(ЭтоКаталогXML(Путь), ВидXML(), "");
КонецФункции

// EDT-проект: .project плюс DT-INF или любой *.mdo в src (Configuration.mdo в том числе).
Функция ЭтоКаталогEDT(Знач Путь)
	Возврат Новый Файл(ОбъединитьПути(Путь, ".project")).Существует()
		И (Новый Файл(ОбъединитьПути(Путь, "DT-INF")).Существует()
			ИЛИ НайтиФайлы(ОбъединитьПути(Путь, "src"), "*.mdo", Истина).Количество() > 0);
КонецФункции

// XML-дамп Конфигуратора: Configuration.xml или ConfigDumpInfo.xml в корне.
Функция ЭтоКаталогXML(Знач Путь)
	Возврат ЗначениеЗаполнено(ФайлДескриптора(ВидXML(), Путь))
		ИЛИ Новый Файл(ОбъединитьПути(Путь, "ConfigDumpInfo.xml")).Существует();
КонецФункции

// Дескриптор конфигурации, если он есть: Configuration.xml (XML) или src/Configuration/Configuration.mdo (EDT).
Функция ФайлДескриптора(Знач Вид, Знач Каталог)

	Если Вид = ВидXML() Тогда
		Путь = ОбъединитьПути(Каталог, "Configuration.xml");
	ИначеЕсли Вид = ВидEDT() Тогда
		Путь = ОбъединитьПути(Каталог, "src", "Configuration", "Configuration.mdo");
	Иначе
		Возврат "";
	КонецЕсли;

	Возврат ?(Новый Файл(Путь).Существует(), Путь, "");

КонецФункции

// .cfe и дампы с признаком расширения - расширение; прочие источники - конфигурация.
Функция СодержимоеИсточника(Знач Вид, Знач Дескриптор)

	Если Вид = "" Тогда
		Возврат "";
	КонецЕсли;

	ЭтоРасширение = Вид = "cfe" ИЛИ (ЗначениеЗаполнено(Дескриптор) И СодержитМаркерРасширения(Дескриптор));
	Возврат ?(ЭтоРасширение, ТипРасширение(), ТипКонфигурация());

КонецФункции

// Найти EDT-проекты в непосредственных подкаталогах заданного каталога.
Функция ВложенныеПроектыEDT(Знач Путь)

	Результат = Новый Массив;
	Для Каждого Подкаталог Из НайтиФайлы(Путь, "*", Ложь) Цикл
		Если Подкаталог.ЭтоКаталог() И ЭтоКаталогEDT(Подкаталог.ПолноеИмя) Тогда
			Результат.Добавить(Подкаталог.ПолноеИмя);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ВидEDT()
	Возврат "edt";
КонецФункции

Функция ВидXML()
	Возврат "xml";
КонецФункции

Функция ТипКонфигурация()
	Возврат "Конфигурация";
КонецФункции

Функция ТипРасширение()
	Возврат "Расширение";
КонецФункции

// Прочитать корневой дескриптор конфигурации и определить, описывает ли он расширение.
//
// Достаточно любого из признаков расширения (сравнение без учёта регистра):
//   - configurationExtensionPurpose          - назначение расширения; сериализуется
//                                               в XML-дампе и в EDT, когда назначение задано;
//   - mdclassExtension:ConfigurationExtension - тип элемента <extension> в EDT-дескрипторе;
//   - objectBelonging                         - корневой объект расширения заимствован
//                                               из основной конфигурации.
// В дескрипторе основной конфигурации (Configuration.xml / Configuration.mdo) ни один из
// признаков не встречается, поэтому проверка надёжно отделяет расширение от конфигурации.
// Одного configurationExtensionPurpose недостаточно: в EDT он опускается, когда назначение
// равно значению по умолчанию, из-за чего расширение ошибочно считалось конфигурацией.
Функция СодержитМаркерРасширения(Знач ПутьФайла)

	Чтение = Новый ЧтениеТекста(ПутьФайла, КодировкаТекста.UTF8, , , Ложь); // не монопольно
	Содержимое = Чтение.Прочитать();
	Чтение.Закрыть();

	Если Содержимое = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	СодержимоеВНижнемРегистре = НРег(Содержимое);

	МаркерыРасширения = Новый Массив;
	МаркерыРасширения.Добавить("configurationextensionpurpose");
	МаркерыРасширения.Добавить("mdclassextension:configurationextension");
	МаркерыРасширения.Добавить("objectbelonging");

	Для Каждого Маркер Из МаркерыРасширения Цикл
		Если СтрНайти(СодержимоеВНижнемРегистре, Маркер) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция СообщениеОКонфликтеИмен(Знач ИмяРасширения, Знач ПервыйПуть, Знач ВторойПуть)
	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон("Конфликт имен расширений: ""%1"" встречается более одного раза.", ИмяРасширения));
	Строки.Добавить("");
	Строки.Добавить("Источники с одинаковым именем:");
	Строки.Добавить(СтрШаблон("    - %1", ПервыйПуть));
	Строки.Добавить(СтрШаблон("    - %1", ВторойПуть));
	Строки.Добавить("");
	Строки.Добавить("Имена расширений должны быть уникальны - при загрузке возникнет конфликт.");
	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

#КонецОбласти
