// BSLLS:MissingVariablesDescription-off Поля autumn (&Лог/&Желудь).
// BSLLS:MissingReturnedValueDescription-off Внутренние вспомогательные функции.
// BSLLS:MissingParameterDescription-off Внутренние вспомогательные функции.
// Сервис рекурсивного поиска источников конфигурации и расширений.
// Применяется командой infobase init --recursive для автоматического обнаружения
// загружаемых данных в предоставленных каталогах.
//
// Каждый найденный источник классифицируется как конфигурация или расширение:
//   - .cf / .dt              -> конфигурация;
//   - .cfe                   -> расширение;
//   - XML-дамп / EDT-проект  -> расширение, если в Configuration.xml (или Configuration.mdo)
//                               есть признак расширения (см. СодержитМаркерРасширения),
//                               иначе конфигурация.
//
// В каталоги, которые сами являются источниками, рекурсия не заходит -
// это позволяет корректно обрабатывать произвольно вложенные структуры.

&Лог("vrunner")
Перем Лог;

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Рекурсивно найти и классифицировать источники в каталоге.
//
// Параметры:
//   КорневойКаталог - Строка - каталог для поиска
//
// Возвращаемое значение:
//   Структура - результат поиска:
//     * Конфигурации - Массив из Строка - пути найденных источников конфигурации
//     * Расширения   - Массив из Строка - пути найденных источников расширений
//
Функция НайтиИсточники(Знач КорневойКаталог) Экспорт

	Лог.Отладка("Рекурсивный поиск источников в: %1", КорневойКаталог);

	Конфигурации = Новый Массив;
	Расширения = Новый Массив;
	СобратьИсточники(КорневойКаталог, Конфигурации, Расширения);

	Возврат Новый Структура("Конфигурации, Расширения", Конфигурации, Расширения);

КонецФункции

// Рекурсивно найти источники конфигурации (расширения исключаются).
//
// Параметры:
//   КорневойКаталог - Строка - каталог для поиска
//
// Возвращаемое значение:
//   Массив из Строка - пути найденных источников конфигурации
//
Функция НайтиКонфигурацию(Знач КорневойКаталог) Экспорт
	Возврат НайтиИсточники(КорневойКаталог).Конфигурации;
КонецФункции

// Рекурсивно найти источники расширений (конфигурация исключается).
//
// Параметры:
//   КорневойКаталог - Строка - каталог для поиска
//
// Возвращаемое значение:
//   Массив из Строка - пути найденных источников расширений
//
Функция НайтиРасширения(Знач КорневойКаталог) Экспорт
	Возврат НайтиИсточники(КорневойКаталог).Расширения;
КонецФункции

// Проверить, что найден не более одного источника конфигурации.
// Ноль источников - допустимо (загрузка будет пропущена).
// Больше одного - ошибка с читабельным описанием.
//
// Параметры:
//   НайденныеИсточники - Массив из Строка - результат поиска конфигураций
//   КорневойКаталог    - Строка           - исходный каталог (для сообщения об ошибке)
//
Процедура ПроверитьОдинИсточникКонфигурации(Знач НайденныеИсточники, Знач КорневойКаталог) Экспорт

	Если НайденныеИсточники.Количество() <= 1 Тогда
		Возврат;
	КонецЕсли;

	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон("Неоднозначность при рекурсивном поиске в ""%1"".", КорневойКаталог));
	Строки.Добавить(СтрШаблон("Найдено источников конфигурации: %1, ожидался один.", НайденныеИсточники.Количество()));
	Строки.Добавить("");
	Строки.Добавить("Обнаруженные конфигурации:");
	Для Каждого ПутьИсточника Из НайденныеИсточники Цикл
		Строки.Добавить(СтрШаблон("    - %1", ПутьИсточника));
	КонецЦикла;
	Строки.Добавить("");
	Строки.Добавить("Оставьте в каталоге одну конфигурацию или укажите ее явно через --src.");

	ВызватьИсключение СтрСоединить(Строки, Символы.ПС);

КонецПроцедуры

// Проверить, что среди найденных расширений нет двух с одинаковым именем.
// Имя определяется из пути: имя .cfe-файла без расширения или имя каталога с исходниками.
//
// Параметры:
//   НайденныеРасширения - Массив из Строка - результат поиска расширений
//
Процедура ПроверитьУникальностьИменРасширений(Знач НайденныеРасширения) Экспорт

	УжеВстреченные = Новый Соответствие;

	Для Каждого Путь Из НайденныеРасширения Цикл
		ИмяРасширения = ИмяИзПути(Путь);
		Ключ = НРег(ИмяРасширения);
		ПредыдущийПуть = УжеВстреченные[Ключ];
		Если ПредыдущийПуть <> Неопределено Тогда
			ВызватьИсключение СообщениеОКонфликтеИмен(ИмяРасширения, ПредыдущийПуть, Путь);
		КонецЕсли;
		УжеВстреченные.Вставить(Ключ, Путь);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Рекурсивно обойти путь, классифицируя найденные источники.
// Если путь сам является источником - добавить его и не углубляться внутрь.
Процедура СобратьИсточники(Знач Путь, Конфигурации, Расширения)

	Файл = Новый Файл(Путь);
	Если НЕ Файл.Существует() Тогда
		Возврат;
	КонецЕсли;

	Тип = ОпределитьТипИсточника(Путь);
	Если Тип = "Конфигурация" Тогда
		Конфигурации.Добавить(Файл.ПолноеИмя);
		Возврат;
	КонецЕсли;
	Если Тип = "Расширение" Тогда
		Расширения.Добавить(Файл.ПолноеИмя);
		Возврат;
	КонецЕсли;

	Если НЕ Файл.ЭтоКаталог() Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Элемент Из НайтиФайлы(Путь, "*", Ложь) Цикл
		СобратьИсточники(Элемент.ПолноеИмя, Конфигурации, Расширения);
	КонецЦикла;

КонецПроцедуры

// Классифицировать путь: "" (не источник), "Конфигурация" или "Расширение".
Функция ОпределитьТипИсточника(Знач Путь)

	Файл = Новый Файл(Путь);

	Если НЕ Файл.ЭтоКаталог() Тогда
		Возврат ТипФайловогоИсточника(НРег(Файл.Расширение));
	КонецЕсли;

	Если НЕ ЭтоКаталогИсточников(Путь) Тогда
		Возврат "";
	КонецЕсли;

	Если ЭтоКаталогРасширения(Путь) Тогда
		Возврат "Расширение";
	КонецЕсли;

	Возврат "Конфигурация";

КонецФункции

// Тип источника по расширению файла: .cf/.dt - конфигурация, .cfe - расширение, иначе - не источник.
Функция ТипФайловогоИсточника(Знач Расширение)

	Если Расширение = ".cf" ИЛИ Расширение = ".dt" Тогда
		Возврат "Конфигурация";
	КонецЕсли;

	Если Расширение = ".cfe" Тогда
		Возврат "Расширение";
	КонецЕсли;

	Возврат "";

КонецФункции

// Признак каталога с 1С-исходниками: XML-дамп конфигуратора или EDT-проект.
//
// XML-дамп: Configuration.xml или ConfigDumpInfo.xml в корне каталога.
// EDT-проект: маркер .project + DT-INF или файлы *.mdo внутри src/.
Функция ЭтоКаталогИсточников(Знач Путь)

	Если Новый Файл(ОбъединитьПути(Путь, "Configuration.xml")).Существует() Тогда
		Возврат Истина;
	КонецЕсли;

	Если Новый Файл(ОбъединитьПути(Путь, "ConfigDumpInfo.xml")).Существует() Тогда
		Возврат Истина;
	КонецЕсли;

	// EDT-проект требует маркера .project плюс дополнительного признака
	Если НЕ Новый Файл(ОбъединитьПути(Путь, ".project")).Существует() Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Новый Файл(ОбъединитьПути(Путь, "DT-INF")).Существует() Тогда
		Возврат Истина;
	КонецЕсли;

	Если Новый Файл(ОбъединитьПути(Путь, "src", "Configuration", "Configuration.mdo")).Существует() Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат ЕстьФайлыПоМаске(ОбъединитьПути(Путь, "src"), "*.mdo");

КонецФункции

// Признак того, что каталог-источник является расширением конфигурации.
// XML-дамп: признак расширения в Configuration.xml.
// EDT-проект: признак расширения в src/Configuration/Configuration.mdo.
Функция ЭтоКаталогРасширения(Знач Путь)

	ФайлКонфигурацииXML = ОбъединитьПути(Путь, "Configuration.xml");
	Если Новый Файл(ФайлКонфигурацииXML).Существует() Тогда
		Возврат СодержитМаркерРасширения(ФайлКонфигурацииXML);
	КонецЕсли;

	ФайлКонфигурацииMdo = ОбъединитьПути(Путь, "src", "Configuration", "Configuration.mdo");
	Если Новый Файл(ФайлКонфигурацииMdo).Существует() Тогда
		Возврат СодержитМаркерРасширения(ФайлКонфигурацииMdo);
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Прочитать корневой дескриптор конфигурации и определить, описывает ли он расширение.
//
// Достаточно любого из признаков расширения (сравнение без учёта регистра):
//   - configurationExtensionPurpose          - назначение расширения; сериализуется
//                                               в XML-дампе и в EDT, когда назначение задано;
//   - mdclassExtension:ConfigurationExtension - тип элемента <extension> в EDT-дескрипторе;
//   - objectBelonging                         - корневой объект расширения заимствован
//                                               из основной конфигурации.
// В дескрипторе основной конфигурации (Configuration.xml / Configuration.mdo) ни один из
// признаков не встречается, поэтому проверка надёжно отделяет расширение от конфигурации.
// Одного configurationExtensionPurpose недостаточно: в EDT он опускается, когда назначение
// равно значению по умолчанию, из-за чего расширение ошибочно считалось конфигурацией.
Функция СодержитМаркерРасширения(Знач ПутьФайла)

	Чтение = Новый ЧтениеТекста(ПутьФайла, КодировкаТекста.UTF8);
	Содержимое = Чтение.Прочитать();
	Чтение.Закрыть();

	Если Содержимое = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	СодержимоеВНижнемРегистре = НРег(Содержимое);

	МаркерыРасширения = Новый Массив;
	МаркерыРасширения.Добавить("configurationextensionpurpose");
	МаркерыРасширения.Добавить("mdclassextension:configurationextension");
	МаркерыРасширения.Добавить("objectbelonging");

	Для Каждого Маркер Из МаркерыРасширения Цикл
		Если СтрНайти(СодержимоеВНижнемРегистре, Маркер) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Имя источника из пути (используется для проверки коллизий имен расширений).
// Для .cfe-файла - имя без расширения, для каталога - имя каталога.
Функция ИмяИзПути(Знач Путь)
	Файл = Новый Файл(Путь);
	Если НРег(Файл.Расширение) = ".cfe" Тогда
		Возврат Файл.ИмяБезРасширения;
	КонецЕсли;
	Возврат Файл.Имя;
КонецФункции

// Читабельное сообщение о конфликте имен двух расширений.
Функция СообщениеОКонфликтеИмен(Знач ИмяРасширения, Знач ПервыйПуть, Знач ВторойПуть)
	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон("Конфликт имен расширений: ""%1"" встречается более одного раза.", ИмяРасширения));
	Строки.Добавить("");
	Строки.Добавить("Источники с одинаковым именем:");
	Строки.Добавить(СтрШаблон("    - %1", ПервыйПуть));
	Строки.Добавить(СтрШаблон("    - %1", ВторойПуть));
	Строки.Добавить("");
	Строки.Добавить("Имена расширений должны быть уникальны - при загрузке возникнет конфликт.");
	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

Функция ЕстьФайлыПоМаске(Знач КаталогПуть, Знач Маска)
	Возврат НайтиФайлы(КаталогПуть, Маска, Ложь).Количество() > 0;
КонецФункции

#КонецОбласти
