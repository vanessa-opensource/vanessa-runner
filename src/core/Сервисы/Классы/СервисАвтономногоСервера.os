// BSLLS:NumberOfValuesInStructureConstructor-off
// BSLLS:LatinAndCyrillicSymbolInWord-off
// BSLLS:MissingVariablesDescription-off Поля autumn (&Лог/&Напильник) и внутреннее состояние сервиса.
// Сервис управления автономным сервером 1С (ibsrv).
// Обёртка над УправлениеАС из ibcmdrunner: подбор свободного порта,
// генерация ibsrv.yaml, запуск/остановка процесса либо подключение к уже запущенному.
//
// Перенесено из легаси МенеджерIbsrv (legacy/src/Классы/МенеджерIbsrv.os).
//
// Использование:
//   - вызов СервисАС.ЗапуститьСервер(ПараметрыПодключения, ПараметрыПлатформы, ПараметрыАС) возвращает Контекст;
//   - Контекст.СтрокаПодключения используется вместо файлового /F"...";
//   - вызов СервисАС.ОстановитьСервер() при завершении.

#Использовать ibcmdrunner

&Лог("vrunner")
Перем Лог;

Перем _МенеджерАС;
Перем _КаталогДанныхСервера;
Перем _ПортHttp;
Перем _ПортПрямогоСоединения;
Перем _ПортОтладки;
Перем _ИспользоватьПрямоеСоединение;
Перем _ИспользоватьОтладку;
Перем _Запущен;
// Истина, если сервис лишь ПОДКЛЮЧИЛСЯ к уже запущенному снаружи серверу и НЕ владеет им:
// в этом случае ОстановитьСервер() не останавливает чужой процесс ibsrv (issue #707).
Перем _ПодключенКЧужомуСерверу;
// Окно подтверждения того, что процесс ibsrv реально УДЕРЖАЛСЯ после старта (issue #707):
// реальный Запустить() возвращается успешно, как только появился lock.pid, но процесс
// может тут же упасть на бинде занятого http-порта. Поэтому после старта поллим Запущен().
Перем _ТаймаутПодтвержденияМс;
Перем _ШагПодтвержденияМс;

&Желудь
Процедура ПриСозданииОбъекта()

	_МенеджерАС = Неопределено;
	_КаталогДанныхСервера = "";
	_ПортHttp = ПортHttp();
	_ПортПрямогоСоединения = ПортПрямогоПоУмолчанию();
	_ПортОтладки = ПортОтладкиПоУмолчанию();
	_ИспользоватьПрямоеСоединение = Ложь;
	_ИспользоватьОтладку = Ложь;
	_Запущен = Ложь;
	_ПодключенКЧужомуСерверу = Ложь;
	_ТаймаутПодтвержденияМс = 2000; // BSLLS:MagicNumber-off
	_ШагПодтвержденияМс = 250; // BSLLS:MagicNumber-off

КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Запустить ibsrv для указанной файловой ИБ либо подключиться к уже запущенному.
//
// Концепция issue #707 (редизайн):
//   Сервер ibsrv запускает кто-то СНАРУЖИ; vrunner либо стартует свой собственный
//   процесс, либо просто ПОДКЛЮЧАЕТСЯ к уже работающему по явно указанному порту.
//   Межпроцессного реестра/дискавери нет - порт задаёт пользователь.
//
//   Матрица поведения (см. ПараметрыАС):
//     ПодключитьсяКСуществующему=Ложь, Порт=0 - старт ibsrv с АВТО-подбором свободного
//        порта. Фикс гонки портов (TOCTOU): вместо предварительной (неатомарной) проверки
//        делается реальная попытка старта; при ошибке занятого порта пробуется следующий.
//     ПодключитьсяКСуществующему=Ложь, Порт=P - старт строго на порту P. Если порт занят -
//        ВызватьИсключение (НИКАКОГО перебора портов).
//     ПодключитьсяКСуществующему=Истина, Порт=P - НЕ запускать ibsrv; собрать строку
//        подключения к серверу на localhost:P и вернуть Контекст. ОстановитьСервер() в этом
//        режиме - NO-OP (чужой сервер не останавливается и не очищается).
//     ПодключитьсяКСуществующему=Истина, Порт=0 - ВызватьИсключение: для подключения
//        к существующему серверу обязателен порт.
//
// Параметры:
//   ПараметрыПодключения - Структура - содержит СтрокаПодключения вида /F"путь" или КаталогБазы
//   ПараметрыПлатформы - Структура, Неопределено - ВерсияПлатформы
//   ПараметрыАС - Структура, Неопределено - см. НовыеПараметрыАС
//
// Возвращаемое значение:
//   Структура - СтрокаПодключения, ПортHttp, ПортПрямой
//
Функция ЗапуститьСервер(Знач ПараметрыПодключения, Знач ПараметрыПлатформы = Неопределено,
		Знач ПараметрыАС = Неопределено) Экспорт

	Если _Запущен Тогда
		ВызватьИсключение "ibsrv уже запущен. Сначала вызовите ОстановитьСервер().";
	КонецЕсли;

	Если ПараметрыАС = Неопределено Тогда
		ПараметрыАС = НовыеПараметрыАС();
	КонецЕсли;

	_ИспользоватьПрямоеСоединение = ПараметрыАС.ИспользоватьПрямоеСоединение = Истина;
	_ИспользоватьОтладку = ПараметрыАС.ИспользоватьОтладку = Истина;

	ПодключитьсяКСуществующему = ПрочитатьФлаг(ПараметрыАС, "ПодключитьсяКСуществующему");
	ЗаданныйПорт = ПрочитатьПорт(ПараметрыАС);

	Если ПодключитьсяКСуществующему Тогда
		Возврат ПодключитьсяКСуществующему(ЗаданныйПорт);
	КонецЕсли;

	КаталогБазы = ИзвлечьКаталогФайловойИБ(ПараметрыПодключения);

	_КаталогДанныхСервера = ВременныеФайлы.СоздатьКаталог();

	// Если менеджер уже внедрён (например, стаб в юнит-тестах) - переиспользуем его,
	// иначе создаём реальный УправлениеАС. Это даёт тестам seam без реальной платформы 1С.
	Если _МенеджерАС = Неопределено Тогда
		_МенеджерАС = Новый УправлениеАС();
	КонецЕсли;
	_МенеджерАС.УстановитьКаталогДанных(_КаталогДанныхСервера);

	Если ПараметрыПлатформы <> Неопределено
		И ПараметрыПлатформы.Свойство("ВерсияПлатформы")
		И ЗначениеЗаполнено(ПараметрыПлатформы.ВерсияПлатформы) Тогда
		_МенеджерАС.УстановитьВерсиюПлатформы(ПараметрыПлатформы.ВерсияПлатформы);
	КонецЕсли;

	Лог.Информация("Используется ibsrv платформы %1", _МенеджерАС.Версия());

	_МенеджерАС.УстановитьПараметрыФайловойИБ(КаталогБазы);

	Если ЗаданныйПорт > 0 Тогда
		ЗапуститьНаЗаданномПорту(ЗаданныйПорт);
	Иначе
		ЗапуститьСНадежнымПодборомПорта();
	КонецЕсли;

	Лог.Информация("Запущен ibsrv на основном порту %1", _ПортHttp);

	Возврат Контекст();

КонецФункции

// Остановить ibsrv и удалить временный каталог данных.
//
// Если сервис лишь ПОДКЛЮЧИЛСЯ к чужому серверу, процесс ibsrv НЕ останавливается -
// он принадлежит другому процессу и должен пережить текущий (issue #707).
//
Процедура ОстановитьСервер() Экспорт

	Если _ПодключенКЧужомуСерверу Тогда
		Лог.Отладка("Сервис подключался к чужому ibsrv - процесс не останавливается");
		Сбросить();
		Возврат;
	КонецЕсли;

	Если _МенеджерАС <> Неопределено Тогда
		Попытка
			_МенеджерАС.Остановить();
			Лог.Информация("Процесс ibsrv остановлен");
		Исключение
			Лог.Предупреждение("Не удалось корректно остановить ibsrv: %1", ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;

	Если ЗначениеЗаполнено(_КаталогДанныхСервера) Тогда
		Попытка
			ВременныеФайлы.УдалитьФайл(_КаталогДанныхСервера);
		Исключение
			Лог.Отладка("Не удалось удалить временный каталог данных ibsrv: %1", ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;

	Сбросить();

КонецПроцедуры

// Строка подключения к запущенному ibsrv (формат /WS или /S).
//
// Возвращаемое значение:
//   Строка
//
Функция СтрокаПодключения() Экспорт

	Если _ИспользоватьПрямоеСоединение Тогда
		Возврат СтрШаблон("/S localhost:%1\DefAlias", XMLСтрока(_ПортПрямогоСоединения));
	Иначе
		Возврат СтрШаблон("/WS http://localhost:%1/", XMLСтрока(_ПортHttp));
	КонецЕсли;

КонецФункции

// Проверить, жив ли запущенный (или подключённый) автономный сервер.
// Для HTTP/WS-режима выполняется РЕАЛЬНЫЙ http-запрос с таймаутом: любой ответ означает,
// что сервер отвечает (жив); отказ соединения ИЛИ таймаут (в т.ч. сервер завис, но порт
// ещё держит) означает, что сервер мёртв. Для прямого соединения протокол не http,
// поэтому проверяется лишь доступность (занятость) прямого порта.
// Используется healthcheck-watchdog'ом при ожидании платформы.
//
// Параметры:
//   ТаймаутСек - Число - таймаут проверки в секундах
//
// Возвращаемое значение:
//   Булево - Истина, если сервер отвечает; Ложь, если недоступен или завис
//
Функция СерверЖив(Знач ТаймаутСек = 5) Экспорт

	Если _ИспользоватьПрямоеСоединение Тогда
		// Прямое соединение использует бинарный протокол 1С (не http) - доступной
		// проверкой остаётся занятость прямого порта.
		Возврат НЕ ПортДоступен(_ПортПрямогоСоединения);
	КонецЕсли;

	Попытка
		Соединение = Новый HTTPСоединение("localhost", _ПортHttp, , , , ТаймаутСек);
		Соединение.Получить(Новый HTTPЗапрос("/"));
		Возврат Истина;
	Исключение
		Лог.Отладка("ibsrv не отвечает на http://localhost:%1 - %2", _ПортHttp, ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Шаблон параметров запуска ibsrv (см. ЗапуститьСервер).
//
// Возвращаемое значение:
//   Структура - ИспользоватьПрямоеСоединение (Булево), ИспользоватьОтладку (Булево),
//               ПодключитьсяКСуществующему (Булево) - подключиться к уже запущенному серверу,
//               Порт (Число) - конкретный порт (0 = не задан)
//
Функция НовыеПараметрыАС() Экспорт

	Возврат Новый Структура(
		"ИспользоватьПрямоеСоединение, ИспользоватьОтладку, ПодключитьсяКСуществующему, Порт",
		Ложь, Ложь, Ложь, 0);

КонецФункции

// Является ли указанная строка подключения файловой ИБ.
//
// Параметры:
//   СтрокаПодключения - Строка
//
// Возвращаемое значение:
//   Булево
//
Функция ЭтоФайловаяИБ(Знач СтрокаПодключения) Экспорт

	Если НЕ ЗначениеЗаполнено(СтрокаПодключения) Тогда
		Возврат Ложь;
	КонецЕсли;
	ВерхняяРегистр = ВРег(СокрЛП(СтрокаПодключения));
	Возврат СтрНачинаетсяС(ВерхняяРегистр, "/F");

КонецФункции

// Тайм-аут (мс) подтверждения, что процесс ibsrv удержался после старта. 0 = мгновенно
// (для юнит-тестов со стабом, где нет реального процесса и гонки падения).
//
// Параметры:
//   Мс - Число - длительность окна подтверждения в миллисекундах
//
Процедура УстановитьТаймаутПодтвержденияЗапуска(Знач Мс) Экспорт
	_ТаймаутПодтвержденияМс = Мс;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИзвлечьКаталогФайловойИБ(Знач ПараметрыПодключения)

	Если ПараметрыПодключения = Неопределено Тогда
		ВызватьИсключение "ibsrv требует параметры подключения с файловой ИБ";
	КонецЕсли;

	Если ПараметрыПодключения.Свойство("КаталогБазы")
		И ЗначениеЗаполнено(ПараметрыПодключения.КаталогБазы) Тогда
		Возврат ПараметрыПодключения.КаталогБазы;
	КонецЕсли;

	Если НЕ ПараметрыПодключения.Свойство("СтрокаПодключения")
		ИЛИ НЕ ЗначениеЗаполнено(ПараметрыПодключения.СтрокаПодключения) Тогда
		ВызватьИсключение "ibsrv требует строку подключения к файловой ИБ (/F""путь"")";
	КонецЕсли;

	Если НЕ ЭтоФайловаяИБ(ПараметрыПодключения.СтрокаПодключения) Тогда
		ВызватьИсключение СтрШаблон(
			"ibsrv поддерживает только файловые ИБ. Получено: %1",
			ПараметрыПодключения.СтрокаПодключения);
	КонецЕсли;

	Путь = ПараметрыПодключения.СтрокаПодключения;
	Путь = СтрЗаменить(Путь, "/F", "");
	Путь = СтрЗаменить(Путь, """", "");
	Путь = СокрЛП(Путь);
	Возврат Новый Файл(Путь).ПолноеИмя;

КонецФункции

// Прочитать булев флаг из структуры параметров с нормализацией Неопределено.
//
// Параметры:
//   ПараметрыАС - Структура - параметры запуска АС
//   Ключ - Строка - имя флага
//
// Возвращаемое значение:
//   Булево
//
Функция ПрочитатьФлаг(Знач ПараметрыАС, Знач Ключ)
	Значение = Неопределено;
	ПараметрыАС.Свойство(Ключ, Значение);
	Если Значение = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Значение = Истина;
КонецФункции

// Прочитать заданный порт из структуры параметров (0 = не задан).
//
// Параметры:
//   ПараметрыАС - Структура - параметры запуска АС
//
// Возвращаемое значение:
//   Число
//
Функция ПрочитатьПорт(Знач ПараметрыАС)
	Значение = Неопределено;
	ПараметрыАС.Свойство("Порт", Значение);
	Если Значение = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Число(Значение);
КонецФункции

// Контекст результата запуска/подключения. Совместим с предыдущей версией.
//
// Возвращаемое значение:
//   Структура - СтрокаПодключения, ПортHttp, ПортПрямой
//
Функция Контекст()
	Возврат Новый Структура(
		"СтрокаПодключения, ПортHttp, ПортПрямой",
		СтрокаПодключения(),
		_ПортHttp,
		_ПортПрямогоСоединения);
КонецФункции

// Подключиться к уже запущенному снаружи серверу ibsrv на localhost:Порт.
// Процесс ibsrv НЕ запускается, каталог данных НЕ создаётся.
//
// Параметры:
//   Порт - Число - порт уже запущенного сервера (обязателен)
//
// Возвращаемое значение:
//   Структура - см. Контекст
//
Функция ПодключитьсяКСуществующему(Знач Порт)

	Если Порт <= 0 Тогда
		ВызватьИсключение "Для подключения к уже запущенному ibsrv обязателен порт (--ibsrv-port).";
	КонецЕсли;

	_ПортHttp = Порт;
	_ПортПрямогоСоединения = Порт;
	_ПодключенКЧужомуСерверу = Истина;
	_Запущен = Истина;

	Лог.Информация("Подключение к уже запущенному ibsrv на localhost:%1", _ПортHttp);

	Возврат Контекст();

КонецФункции

// Запуск ibsrv строго на заданном порту. Если порт занят - исключение без перебора.
//
// Параметры:
//   Порт - Число - порт, на котором должен стартовать ibsrv
//
Процедура ЗапуститьНаЗаданномПорту(Знач Порт)

	СдвигПортов = Порт - ПортHttp();
	УстановитьПортыПоСдвигу(СдвигПортов);
	_ПортHttp = Порт;

	СформироватьКонфигурационныйФайл(СдвигПортов);

	Если НЕ ПопытатьсяЗапуститьМенеджер() Тогда
		ВызватьИсключение СтрШаблон(
			"Не удалось запустить автономный сервер: порт %1 занят.", XMLСтрока(Порт));
	КонецЕсли;
	_Запущен = Истина;

КонецПроцедуры

// Надёжный запуск ibsrv с подбором свободного порта через АТОМАРНЫЙ бинд (issue #707).
//
// Вместо предварительной (неатомарной) проверки порта делается реальная попытка старта
// ibsrv на кандидате-порту. Если порт занят, УправлениеАС.Запустить бросает исключение
// "сервер не запустился" - его ловим и пробуем следующий сдвиг. Стартовый сдвиг
// рандомизирован по процессу, что снижает вероятность одновременного выбора одного порта
// несколькими параллельными инстансами.
Процедура ЗапуститьСНадежнымПодборомПорта()

	КоличествоПопыток = 8;
	КоличествоДиапазонов = 32;

	Генератор = Новый ГенераторСлучайныхЧисел(ТекущаяУниверсальнаяДатаВМиллисекундах());

	// Первая попытка - базовый порт; далее случайные сдвиги (рандомизация старта по процессу).
	СдвигПортов = 0;
	ТекущаяПопытка = 0;

	Пока ТекущаяПопытка < КоличествоПопыток Цикл

		УстановитьПортыПоСдвигу(СдвигПортов);

		Если ТекущаяПопытка > 0 Тогда
			// Свежий каталог данных на повторную попытку: старый может содержать stale lock.pid
			// от частично стартовавшего процесса, что собьёт детекцию запуска.
			ПересоздатьКаталогДанных();
		КонецЕсли;

		СформироватьКонфигурационныйФайл(СдвигПортов);

		Если ПопытатьсяЗапуститьМенеджер() Тогда
			_Запущен = Истина;
			Возврат;
		КонецЕсли;

		Лог.Отладка("Порт %1 занят или сервер не стартовал, пробуем другой порт", _ПортHttp);

		ТекущаяПопытка = ТекущаяПопытка + 1;
		СдвигПортов = 100 * Генератор.СлучайноеЧисло(1, КоличествоДиапазонов); // BSLLS:MagicNumber-off

	КонецЦикла;

	ВызватьИсключение "Не удалось запустить автономный сервер: все кандидаты-порты заняты!";

КонецПроцедуры

// Попытаться запустить менеджер автономного сервера на текущих портах/конфиге.
// Реальный Запустить() считает старт успешным по появлению lock.pid, но ibsrv создаёт
// lock.pid ДО привязки http-порта: при занятом порте процесс стартует, пишет lock.pid и
// тут же падает на бинде. Поэтому успехом считаем только то, что процесс УДЕРЖАЛСЯ живым
// (см. ПодтвердитьЗапускСервера). Запустить() бросает исключение лишь при полном провале
// (lock.pid так и не появился) - такую "портовую" ошибку трактуем как занятый порт.
//
// Возвращаемое значение:
//   Булево - Истина, если сервер реально поднялся и удержался; Ложь, если порт занят
//
Функция ПопытатьсяЗапуститьМенеджер()

	Попытка
		_МенеджерАС.Запустить();
	Исключение
		// Запустить бросает только при полном провале (lock.pid не появился).
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		Если НЕ ЭтоОшибкаЗанятогоПорта(ИнформацияОбОшибке) Тогда
			ВызватьИсключение; // непортовая ошибка - пробрасываем
		КонецЕсли;
		Возврат Ложь;
	КонецПопытки;

	Если ПодтвердитьЗапускСервера() Тогда
		Возврат Истина;
	КонецЕсли;

	// lock.pid появился, но процесс упал на бинде порта - чистим перед следующей попыткой
	Попытка
		_МенеджерАС.Остановить();
	Исключение
		Лог.Отладка("Не удалось остановить упавший ibsrv: %1", ОписаниеОшибки());
	КонецПопытки;
	Возврат Ложь;

КонецФункции

// Подтвердить, что процесс ibsrv удержался живым после старта.
// Поллит _МенеджерАС.Запущен() в течение _ТаймаутПодтвержденияМс с шагом _ШагПодтвержденияМс:
// если на любой итерации процесс уже мёртв (упал на бинде порта) - сразу Ложь. При тайм-ауте 0
// (юнит-тесты со стабом, где нет реального процесса и гонки) цикл не выполняется и состояние
// проверяется мгновенно.
//
// Возвращаемое значение:
//   Булево - Истина, если процесс удержался всё окно подтверждения
//
Функция ПодтвердитьЗапускСервера()

	Прошло = 0;
	Пока Прошло < _ТаймаутПодтвержденияМс Цикл
		Приостановить(_ШагПодтвержденияМс);
		Если НЕ _МенеджерАС.Запущен() Тогда
			Возврат Ложь;
		КонецЕсли;
		Прошло = Прошло + _ШагПодтвержденияМс;
	КонецЦикла;

	Возврат _МенеджерАС.Запущен();

КонецФункции

// Является ли ошибка следствием занятого порта / неудавшегося старта ibsrv.
// Делегирует определение менеджеру (УправлениеАС), если он умеет это распознавать.
//
// Параметры:
//   ИнформацияОбОшибке - ИнформацияОбОшибке - описание перехваченного исключения
//
// Возвращаемое значение:
//   Булево - Истина, если ошибку стоит трактовать как занятый порт
//
Функция ЭтоОшибкаЗанятогоПорта(Знач ИнформацияОбОшибке)

	Попытка
		Возврат _МенеджерАС.ЭтоИсключенияЗапускаАС(ИнформацияОбОшибке);
	Исключение
		// Менеджер не умеет распознавать (например, мок без этого метода) - считаем ошибку
		// потенциально связанной с портом и даём шанс повторной попытке.
		Возврат Истина;
	КонецПопытки;

КонецФункции

Процедура УстановитьПортыПоСдвигу(Знач СдвигПортов)
	_ПортHttp = ПортHttp() + СдвигПортов;
	_ПортПрямогоСоединения = ПортПрямогоПоУмолчанию() + СдвигПортов;
	_ПортОтладки = ПортОтладкиПоУмолчанию() + СдвигПортов;
КонецПроцедуры

Процедура ПересоздатьКаталогДанных()

	Попытка
		ВременныеФайлы.УдалитьФайл(_КаталогДанныхСервера);
	Исключение
		Лог.Отладка("Не удалось удалить старый каталог данных ibsrv: %1", ОписаниеОшибки());
	КонецПопытки;

	_КаталогДанныхСервера = ВременныеФайлы.СоздатьКаталог();
	_МенеджерАС.УстановитьКаталогДанных(_КаталогДанныхСервера);

КонецПроцедуры

Процедура Сбросить()
	_МенеджерАС = Неопределено;
	_КаталогДанныхСервера = "";
	_Запущен = Ложь;
	_ПодключенКЧужомуСерверу = Ложь;
КонецПроцедуры

Процедура СформироватьКонфигурационныйФайл(Знач СдвигПортов)

	СетевойИнтерфейс = "any";
	ИмяИБ = "DefAlias";
	РазрешитьВыдачуЛицензий = Истина;
	РазрешитьРегламентныеЗадания = Ложь;

	Конфиг = Новый КонфигурационныйФайлАС;
	Конфиг.ПараметрыСервера(СетевойИнтерфейс, _ПортHttp);
	Конфиг.ПараметрыИБ(ИмяИБ, РазрешитьВыдачуЛицензий, РазрешитьРегламентныеЗадания);

	ИспользоватьШлюзПрямогоДоступа = _ИспользоватьПрямоеСоединение;
	ИспользоватьШлюзHTTP = Неопределено;
	ИспользоватьШлюзSSH = Ложь;
	ИспользоватьРасширеннуюФункциональностьКонфигуратора = Неопределено;
	Конфиг.ПараметрыФункциональностиСервера(
		ИспользоватьШлюзПрямогоДоступа,
		ИспользоватьШлюзHTTP,
		ИспользоватьШлюзSSH,
		ИспользоватьРасширеннуюФункциональностьКонфигуратора);

	Если _ИспользоватьПрямоеСоединение Тогда
		Конфиг.ПараметрыШлюзаПрямогоДоступа(
			_ПортПрямогоСоединения,
			МинимальныйПортПодключения(СдвигПортов),
			МаксимальныйПортПодключения(СдвигПортов));
	КонецЕсли;

	Если _ИспользоватьОтладку Тогда
		Конфиг.ПараметрыОтладкиСервера("http", _ПортОтладки, СетевойИнтерфейс);
	КонецЕсли;

	ФайлКонфигурации = ОбъединитьПути(_КаталогДанныхСервера, "ibsrv.yaml");
	Конфиг.СоздатьКонфигурационныйФайл(ФайлКонфигурации);

	_МенеджерАС.УстановитьКонфигурационныйФайл(ФайлКонфигурации);

КонецПроцедуры

// Свободен ли указанный порт (можно ли на нём поднять слушающий сокет).
// Реализовано через попытку поднять TCPСервер: успех - порт свободен.
//
// Параметры:
//   ПортПроверки - Число - проверяемый TCP-порт
//
// Возвращаемое значение:
//   Булево - Истина, если порт свободен; Ложь, если порт занят
//
Функция ПортДоступен(Знач ПортПроверки)

	TCPСервер = Новый TCPСервер(ПортПроверки);
	Попытка
		TCPСервер.Запустить();
	Исключение
		Возврат Ложь;
	КонецПопытки;

	TCPСервер.Остановить();
	Возврат Истина;

КонецФункции

Функция ПортHttp()
	Возврат 8314; // BSLLS:MagicNumber-off
КонецФункции

Функция ПортПрямогоПоУмолчанию()
	Возврат 8341; // BSLLS:MagicNumber-off
КонецФункции

Функция ПортОтладкиПоУмолчанию()
	Возврат 8350; // BSLLS:MagicNumber-off
КонецФункции

Функция МинимальныйПортПодключения(Знач СдвигПортов)
	Возврат 8360 + СдвигПортов; // BSLLS:MagicNumber-off
КонецФункции

Функция МаксимальныйПортПодключения(Знач СдвигПортов)
	Возврат 8391 + СдвигПортов; // BSLLS:MagicNumber-off
КонецФункции

#КонецОбласти
