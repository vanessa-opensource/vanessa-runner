// BSLLS:MissingVariablesDescription-off Поля autumn (&Лог/&Пластилин/&Напильник) и внутреннее состояние сервиса.
// Сервис управления кластером 1С через библиотеку irac.
// Фасад: единый интерфейс к операциям с кластером серверов.
// Делегирует работу объектам irac: УправлениеКластером1С, ИнформационныеБазы, Сеансы.

#Использовать irac

&Лог("vrunner")
Перем Лог;

// Опциональный делегат-фабрика УправлениеКластером1С (для юнит-тестов).
// Если не Неопределено, должен реализовать метод Создать(ВерсияПлатформы, АдресRAS).
Перем _ФабрикаУправленияКластером;

&Желудь
Процедура ПриСозданииОбъекта()
	_ФабрикаУправленияКластером = Неопределено;
КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Создать информационную базу в кластере.
//
// Параметры:
//   ПараметрыКластера - Структура - параметры подключения к кластеру
//     * ВерсияПлатформы - Строка
//     * АдресRAS - Строка
//     * АдминистраторКластера - Строка
//     * ПарольКластера - Строка
//     * ИдентификаторКластера - Строка (необязательный)
//     * ИмяКластера - Строка (необязательный)
//   ПараметрыИБ - Структура - параметры создаваемой ИБ
//     * ИмяИБ - Строка
//     * ТипСУБД - Строка (MSSQLServer|PostgreSQL|IBMDB2|OracleDatabase)
//     * АдресСервераСУБД - Строка
//     * ИмяБазыСУБД - Строка
//     * ИмяПользователяБазыСУБД - Строка
//     * ПарольПользователяБазыСУБД - Строка
//     * Локализация - Строка (по умолчанию "ru_RU")
//     * СмещениеДат - Число (по умолчанию 2000)
//     * СоздаватьБДСУБД - Булево (по умолчанию Истина)
//     * БлокироватьРегламентныеЗадания - Булево (по умолчанию Ложь)
//
Процедура СоздатьИБ(Знач ПараметрыКластера, Знач ПараметрыИБ) Экспорт

	Лог.Информация("Создаю клиент-серверную информационную базу %1", ПараметрыИБ.ИмяИБ);

	Кластер = ПодключитьсяККластеру(ПараметрыКластера);

	ПараметрыСоздания = Новый Структура;

	Если ПараметрыИБ.Свойство("ТипСУБД") И ЗначениеЗаполнено(ПараметрыИБ.ТипСУБД) Тогда
		ПараметрыСоздания.Вставить("ТипСУБД", ПараметрыИБ.ТипСУБД);
	КонецЕсли;
	Если ПараметрыИБ.Свойство("АдресСервераСУБД") И ЗначениеЗаполнено(ПараметрыИБ.АдресСервераСУБД) Тогда
		ПараметрыСоздания.Вставить("АдресСервераСУБД", ПараметрыИБ.АдресСервераСУБД);
	КонецЕсли;
	Если ПараметрыИБ.Свойство("ИмяБазыСУБД") И ЗначениеЗаполнено(ПараметрыИБ.ИмяБазыСУБД) Тогда
		ПараметрыСоздания.Вставить("ИмяБазыСУБД", ПараметрыИБ.ИмяБазыСУБД);
	КонецЕсли;
	Если ПараметрыИБ.Свойство("ИмяПользователяБазыСУБД") И ЗначениеЗаполнено(ПараметрыИБ.ИмяПользователяБазыСУБД) Тогда
		ПараметрыСоздания.Вставить("ИмяПользователяБазыСУБД", ПараметрыИБ.ИмяПользователяБазыСУБД);
	КонецЕсли;
	Если ПараметрыИБ.Свойство("ПарольПользователяБазыСУБД")
		И ЗначениеЗаполнено(ПараметрыИБ.ПарольПользователяБазыСУБД) Тогда
		ПараметрыСоздания.Вставить("ПарольПользователяБазыСУБД", ПараметрыИБ.ПарольПользователяБазыСУБД);
	КонецЕсли;
	Если ПараметрыИБ.Свойство("БлокироватьРегламентныеЗадания") И ПараметрыИБ.БлокироватьРегламентныеЗадания Тогда
		ПараметрыСоздания.Вставить("БлокировкаРегламентныхЗаданийВключена",
			Перечисления.СостоянияВыключателя.Включено);
	КонецЕсли;

	Локализация = "ru_RU";
	Если ПараметрыИБ.Свойство("Локализация") И ЗначениеЗаполнено(ПараметрыИБ.Локализация) Тогда
		Локализация = ПараметрыИБ.Локализация;
	КонецЕсли;

	СоздаватьБД = Истина;
	Если ПараметрыИБ.Свойство("СоздаватьБДСУБД") Тогда
		СоздаватьБД = ПараметрыИБ.СоздаватьБДСУБД;
	КонецЕсли;

	Кластер.ИнформационныеБазы().Добавить(ПараметрыИБ.ИмяИБ, Локализация, СоздаватьБД, ПараметрыСоздания);

	Лог.Информация("ИБ создана: %1", ПараметрыИБ.ИмяИБ);

КонецПроцедуры

// Удалить информационную базу из кластера.
//
// Параметры:
//   ПараметрыКластера - Структура - параметры подключения к кластеру
//   ИмяИБ             - Строка - имя удаляемой ИБ
//   ДействияСБД       - Строка - "drop"|"clear"|"" (по умолчанию "")
//
Процедура УдалитьИБ(Знач ПараметрыКластера, Знач ИмяИБ, Знач ДействияСБД = "") Экспорт

	Лог.Информация("Удаляю клиент-серверную информационную базу %1", ИмяИБ);

	Кластер = ПодключитьсяККластеру(ПараметрыКластера);
	УстановитьАдминистратораИБ(Кластер, ИмяИБ, ПараметрыКластера);

	Кластер.ИнформационныеБазы().Удалить(ИмяИБ, ДействияСБД);

	Лог.Информация("ИБ удалена: %1", ИмяИБ);

КонецПроцедуры

// Получить информацию об ИБ в кластере.
//
// Параметры:
//   ПараметрыКластера - Структура
//   ИмяИБ             - Строка
//
// Возвращаемое значение:
//   ИнформационнаяБаза - объект irac
//
Функция ИнформацияОбИБ(Знач ПараметрыКластера, Знач ИмяИБ) Экспорт

	Кластер = ПодключитьсяККластеру(ПараметрыКластера);
	ИБ = ПолучитьИБ(Кластер, ИмяИБ, ПараметрыКластера);

	ИБ.ОбновитьДанные();

	Возврат ИБ;

КонецФункции

// Заблокировать начало сеансов ИБ.
//
// Параметры:
//   ПараметрыКластера   - Структура
//   ИмяИБ               - Строка
//   ПараметрыБлокировки - Структура, Неопределено - КодРазрешения, СообщениеБлокировки (необязательный)
//
Процедура ЗаблокироватьСеансы(Знач ПараметрыКластера, Знач ИмяИБ, Знач ПараметрыБлокировки = Неопределено) Экспорт

	Кластер = ПодключитьсяККластеру(ПараметрыКластера);
	ИБ = ПолучитьИБ(Кластер, ИмяИБ, ПараметрыКластера);

	ПараметрыИзменения = Новый Структура;
	ПараметрыИзменения.Вставить("БлокировкаСеансовВключена",
		Перечисления.СостоянияВыключателя.Включено);

	Если ПараметрыБлокировки <> Неопределено Тогда
		Если ПараметрыБлокировки.Свойство("КодРазрешения")
			И ЗначениеЗаполнено(ПараметрыБлокировки.КодРазрешения) Тогда
			ПараметрыИзменения.Вставить("КодРазрешения", ПараметрыБлокировки.КодРазрешения);
		КонецЕсли;
		Если ПараметрыБлокировки.Свойство("СообщениеБлокировки")
			И ЗначениеЗаполнено(ПараметрыБлокировки.СообщениеБлокировки) Тогда
			ПараметрыИзменения.Вставить("СообщениеБлокировкиСеансов", ПараметрыБлокировки.СообщениеБлокировки);
		КонецЕсли;
	КонецЕсли;

	ИБ.Изменить(ПараметрыИзменения);

	Лог.Информация("Сеансы заблокированы: %1", ИмяИБ);

КонецПроцедуры

// Разблокировать начало сеансов ИБ.
//
// Параметры:
//   ПараметрыКластера - Структура
//   ИмяИБ             - Строка
//
Процедура РазблокироватьСеансы(Знач ПараметрыКластера, Знач ИмяИБ) Экспорт

	Кластер = ПодключитьсяККластеру(ПараметрыКластера);
	ИБ = ПолучитьИБ(Кластер, ИмяИБ, ПараметрыКластера);

	ПараметрыИзменения = Новый Структура;
	ПараметрыИзменения.Вставить("БлокировкаСеансовВключена",
		Перечисления.СостоянияВыключателя.Выключено);

	ИБ.Изменить(ПараметрыИзменения);

	Лог.Информация("Сеансы разблокированы: %1", ИмяИБ);

КонецПроцедуры

// Завершить все сеансы ИБ.
//
// Параметры:
//   ПараметрыКластера - Структура
//   ИмяИБ             - Строка
//   БлокироватьНовые  - Булево - блокировать начало новых сеансов (по умолчанию Истина)
//
Процедура ЗавершитьСеансы(Знач ПараметрыКластера, Знач ИмяИБ, Знач БлокироватьНовые = Истина) Экспорт

	Если БлокироватьНовые Тогда
		ЗаблокироватьСеансы(ПараметрыКластера, ИмяИБ);
	КонецЕсли;

	Кластер = ПодключитьсяККластеру(ПараметрыКластера);
	ИБ = ПолучитьИБ(Кластер, ИмяИБ, ПараметрыКластера);

	Сеансы = ИБ.Сеансы().Список();
	Для Каждого Сеанс Из Сеансы Цикл
		Лог.Информация("Завершаю сеанс: %1 [%2]",
			Сеанс.Получить("session-id"), Сеанс.Получить("app-id"));
		Попытка
			Сеанс.Завершить();
		Исключение
			Лог.Отладка("Пропускаю ошибку: %1", ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

	Лог.Информация("Сеансы завершены: %1", ИмяИБ);

КонецПроцедуры

// Заблокировать регламентные задания ИБ.
//
// Параметры:
//   ПараметрыКластера - Структура
//   ИмяИБ             - Строка
//
Процедура ЗаблокироватьРегламентныеЗадания(Знач ПараметрыКластера, Знач ИмяИБ) Экспорт
	УстановитьБлокировкуРЗ(ПараметрыКластера, ИмяИБ, Истина);
КонецПроцедуры

// Разблокировать регламентные задания ИБ.
//
// Параметры:
//   ПараметрыКластера - Структура
//   ИмяИБ             - Строка
//
Процедура РазблокироватьРегламентныеЗадания(Знач ПараметрыКластера, Знач ИмяИБ) Экспорт
	УстановитьБлокировкуРЗ(ПараметрыКластера, ИмяИБ, Ложь);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПодключитьсяККластеру(ПараметрыКластера)

	АдресRAS = "localhost:1545";
	Если ПараметрыКластера.Свойство("АдресRAS") И ЗначениеЗаполнено(ПараметрыКластера.АдресRAS) Тогда
		АдресRAS = ПараметрыКластера.АдресRAS;
	КонецЕсли;

	ВерсияПлатформы = "8.3";
	Если ПараметрыКластера.Свойство("ВерсияПлатформы") И ЗначениеЗаполнено(ПараметрыКластера.ВерсияПлатформы) Тогда
		ВерсияПлатформы = ПараметрыКластера.ВерсияПлатформы;
	КонецЕсли;

	Управление = СоздатьУправлениеКластером(ВерсияПлатформы, АдресRAS);

	Лог.Отладка("Подключение к RAS: %1, платформа %2", АдресRAS, ВерсияПлатформы);

	Кластеры = Управление.Кластеры().Список();

	Если Кластеры.Количество() = 0 Тогда
		ВызватьИсключение "Кластер серверов не найден";
	КонецЕсли;

	ИдентификаторКластера = "";
	ИмяКластера = "";
	Если ПараметрыКластера.Свойство("ИдентификаторКластера") Тогда
		ИдентификаторКластера = ПараметрыКластера.ИдентификаторКластера;
	КонецЕсли;
	Если ПараметрыКластера.Свойство("ИмяКластера") Тогда
		ИмяКластера = ПараметрыКластера.ИмяКластера;
	КонецЕсли;
	Кластер = НайтиКластерВСписке(Кластеры, ИдентификаторКластера, ИмяКластера);

	АдминистраторКластера = "";
	ПарольКластера = "";
	Если ПараметрыКластера.Свойство("АдминистраторКластера") Тогда
		АдминистраторКластера = ПараметрыКластера.АдминистраторКластера;
	КонецЕсли;
	Если ПараметрыКластера.Свойство("ПарольКластера") Тогда
		ПарольКластера = ПараметрыКластера.ПарольКластера;
	КонецЕсли;
	Если ЗначениеЗаполнено(АдминистраторКластера) Тогда
		Кластер.УстановитьАдминистратора(АдминистраторКластера, ПарольКластера);
	КонецЕсли;

	Лог.Отладка("Кластер: %1 (%2)", Кластер.Имя(), Кластер.Ид());

	Возврат Кластер;

КонецФункции

Функция НайтиКластерВСписке(Кластеры, Знач ИдентификаторКластера, Знач ИмяКластера)

	Если НЕ ЗначениеЗаполнено(ИдентификаторКластера) И НЕ ЗначениеЗаполнено(ИмяКластера) Тогда
		Возврат Кластеры[0];
	КонецЕсли;

	Для Каждого ТекКластер Из Кластеры Цикл
		Если ЗначениеЗаполнено(ИдентификаторКластера) И ТекКластер.Ид() = ИдентификаторКластера Тогда
			Возврат ТекКластер;
		КонецЕсли;
		Если ЗначениеЗаполнено(ИмяКластера) И ТекКластер.Имя() = ИмяКластера Тогда
			Возврат ТекКластер;
		КонецЕсли;
	КонецЦикла;

	ВызватьИсключение "Кластер серверов не найден";

КонецФункции

Функция ПолучитьИБ(Кластер, ИмяИБ, ПараметрыКластера)

	ИБ = Кластер.ИнформационныеБазы().Получить(ИмяИБ);
	Если ИБ = Неопределено Тогда
		ВызватьИсключение СтрШаблон("ИБ ""%1"" не найдена в кластере", ИмяИБ);
	КонецЕсли;

	УстановитьАдминистратораИБПоПараметрам(ИБ, ПараметрыКластера);

	Возврат ИБ;

КонецФункции

Процедура УстановитьАдминистратораИБ(Кластер, ИмяИБ, ПараметрыКластера)

	Пользователь = "";
	Пароль = "";
	Если ПараметрыКластера.Свойство("Пользователь") Тогда
		Пользователь = ПараметрыКластера.Пользователь;
	КонецЕсли;
	Если ПараметрыКластера.Свойство("Пароль") Тогда
		Пароль = ПараметрыКластера.Пароль;
	КонецЕсли;

	Если ЗначениеЗаполнено(Пользователь) Тогда
		ИБ = Кластер.ИнформационныеБазы().Получить(ИмяИБ);
		Если ИБ <> Неопределено Тогда
			ИБ.УстановитьАдминистратора(Пользователь, Пароль);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура УстановитьАдминистратораИБПоПараметрам(ИБ, ПараметрыКластера)

	Пользователь = "";
	Пароль = "";
	Если ПараметрыКластера.Свойство("Пользователь") Тогда
		Пользователь = ПараметрыКластера.Пользователь;
	КонецЕсли;
	Если ПараметрыКластера.Свойство("Пароль") Тогда
		Пароль = ПараметрыКластера.Пароль;
	КонецЕсли;
	Если ЗначениеЗаполнено(Пользователь) Тогда
		ИБ.УстановитьАдминистратора(Пользователь, Пароль);
	КонецЕсли;

КонецПроцедуры

Процедура УстановитьБлокировкуРЗ(ПараметрыКластера, ИмяИБ, Блокировать)

	Кластер = ПодключитьсяККластеру(ПараметрыКластера);
	ИБ = ПолучитьИБ(Кластер, ИмяИБ, ПараметрыКластера);

	ПараметрыИзменения = Новый Структура;
	Если Блокировать Тогда
		ПараметрыИзменения.Вставить("БлокировкаРегламентныхЗаданийВключена",
			Перечисления.СостоянияВыключателя.Включено);
	Иначе
		ПараметрыИзменения.Вставить("БлокировкаРегламентныхЗаданийВключена",
			Перечисления.СостоянияВыключателя.Выключено);
	КонецЕсли;

	ИБ.Изменить(ПараметрыИзменения);

	Лог.Информация("Регламентные задания %1: %2",
		?(Блокировать, "заблокированы", "разблокированы"), ИмяИБ);

КонецПроцедуры

Функция СоздатьУправлениеКластером(Знач ВерсияПлатформы, Знач АдресRAS)
	Если _ФабрикаУправленияКластером <> Неопределено Тогда
		Возврат _ФабрикаУправленияКластером.Создать(ВерсияПлатформы, АдресRAS);
	КонецЕсли;
	Возврат Новый УправлениеКластером1С(ВерсияПлатформы, АдресRAS);
КонецФункции

#КонецОбласти
