// BSLLS:MissingVariablesDescription-off Поля autumn (&Лог) и внутреннее состояние сервиса.
// BSLLS:MissingParameterDescription-off Внутренние служебные методы.
// BSLLS:MissingReturnedValueDescription-off Внутренние служебные методы.
// BSLLS:NestedFunctionInParameters-off Идиоматичное построение строк (Добавить(СтрШаблон(...))).
// BSLLS:LatinAndCyrillicSymbolInWord-off Идентификаторы с аббревиатурой RAS (_ФабрикаКлиентаRAS).
// Сервис управления кластером 1С через RAS напрямую (библиотека v8ras): rac и платформа не нужны.
// ИБ, сеансы и соединения отдаёт как Соответствие с именами полей rac.

#Использовать v8ras

&Лог("vrunner")
Перем Лог;

// Опциональная фабрика клиента RAS (для юнит-тестов): Создать(Хост, Порт) возвращает КлиентКластераRAS.
Перем _ФабрикаКлиентаRAS;

&Желудь
Процедура ПриСозданииОбъекта()
	_ФабрикаКлиентаRAS = Неопределено;
КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Создать информационную базу в кластере.
//
// Параметры:
//   ПараметрыКластера - Структура - параметры подключения к кластеру
//     * АдресRAS - Строка - host[:port] (по умолчанию localhost:1545)
//     * ПутьRac - Строка - устарел и игнорируется
//     * АдминистраторКластера - Строка
//     * ПарольКластера - Строка
//     * ИдентификаторКластера - Строка (необязательный)
//     * ИмяКластера - Строка (необязательный)
//   ПараметрыИБ - Структура - параметры создаваемой ИБ
//     * ИмяИБ - Строка
//     * ТипСУБД - Строка (MSSQLServer|PostgreSQL|IBMDB2|OracleDatabase, по умолчанию MSSQLServer)
//     * АдресСервераСУБД - Строка
//     * ИмяБазыСУБД - Строка
//     * ИмяПользователяБазыСУБД - Строка
//     * ПарольПользователяБазыСУБД - Строка
//     * Локализация - Строка (по умолчанию "ru_RU")
//     * СоздаватьБДСУБД - Булево (по умолчанию Истина)
//     * БлокироватьРегламентныеЗадания - Булево (по умолчанию Ложь)
//
Процедура СоздатьИБ(Знач ПараметрыКластера, Знач ПараметрыИБ) Экспорт

	Лог.Информация("Создаю клиент-серверную информационную базу %1", ПараметрыИБ.ИмяИБ);

	Настройки = НастройкиПодключения(ПараметрыКластера);

	// Умолчания rac create: у v8ras свои (0 и пустые строки).
	Инфо = Новый Структура("Имя, СУБД, Локаль", ПараметрыИБ.ИмяИБ, "MSSQLServer", ЛокализацияПоУмолчанию());
	Инфо.Вставить("СмещениеДат", 2000); // BSLLS:MagicNumber-off
	Инфо.Вставить("ВыдачаЛицензийСервером", 1);
	ПеренестиЗаполненное(Инфо, ПараметрыИБ, "ТипСУБД", "СУБД");
	ПеренестиЗаполненное(Инфо, ПараметрыИБ, "АдресСервераСУБД", "СерверБД");
	ПеренестиЗаполненное(Инфо, ПараметрыИБ, "ИмяБазыСУБД", "ИмяБД");
	ПеренестиЗаполненное(Инфо, ПараметрыИБ, "ИмяПользователяБазыСУБД", "ПользовательБД");
	ПеренестиЗаполненное(Инфо, ПараметрыИБ, "ПарольПользователяБазыСУБД", "ПарольБД");
	ПеренестиЗаполненное(Инфо, ПараметрыИБ, "Локализация", "Локаль");
	ПеренестиЗаполненное(Инфо, ПараметрыИБ, "БлокироватьРегламентныеЗадания", "БлокировкаРегламентных");

	// Режим v8ras: 1 - создать базу данных в СУБД, 0 - только зарегистрировать.
	Режим = ?(ПараметрыИБ.Свойство("СоздаватьБДСУБД") И НЕ ПараметрыИБ.СоздаватьБДСУБД, 0, 1);

	Клиент = НовыйКлиентRAS(Настройки);
	Попытка
		Клиент.СоздатьБазу(ВойтиВКластер(Клиент, Настройки), Инфо, Режим);
	Исключение
		Клиент.Отключить();
		ВызватьИсключение;
	КонецПопытки;
	Клиент.Отключить();

	Лог.Информация("ИБ создана: %1", ПараметрыИБ.ИмяИБ);

КонецПроцедуры

// Удалить информационную базу из кластера. Отсутствующая ИБ - не ошибка.
//
// Параметры:
//   ПараметрыКластера - Структура - параметры подключения к кластеру
//   ИмяИБ             - Строка - имя удаляемой ИБ
//   ДействияСБД       - Строка - "drop"|"clear"|"" (по умолчанию "")
//
Процедура УдалитьИБ(Знач ПараметрыКластера, Знач ИмяИБ, Знач ДействияСБД = "") Экспорт

	Лог.Информация("Удаляю клиент-серверную информационную базу %1", ИмяИБ);

	Настройки = НастройкиПодключения(ПараметрыКластера);

	// Индекс - режим v8ras: 0 - снять с регистрации, 1 - удалить базу данных, 2 - очистить её.
	Режим = СтрРазделить(",drop,clear", ",").Найти(ДействияСБД);
	Если Режим = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Неизвестное действие с базой данных СУБД: %1", ДействияСБД);
	КонецЕсли;

	Клиент = НовыйКлиентRAS(Настройки);
	Попытка
		ИдКластера = ВойтиВКластер(Клиент, Настройки);
		ИдБазы = НайтиИБ(Клиент, ИдКластера, ИмяИБ);
		Если ИдБазы <> Неопределено Тогда
			АутентифицироватьВИБ(Клиент, ИдКластера, Настройки);
			Клиент.УдалитьБазу(ИдКластера, ИдБазы, Режим);
		КонецЕсли;
	Исключение
		Клиент.Отключить();
		ВызватьИсключение;
	КонецПопытки;
	Клиент.Отключить();

	Если ИдБазы = Неопределено Тогда
		Лог.Информация("ИБ %1 не найдена в кластере - удалять нечего", ИмяИБ);
	Иначе
		Лог.Информация("ИБ удалена: %1", ИмяИБ);
	КонецЕсли;

КонецПроцедуры

// Получить информацию об ИБ в кластере.
//
// Параметры:
//   ПараметрыКластера - Структура
//   ИмяИБ             - Строка - имя или идентификатор ИБ
//
// Возвращаемое значение:
//   Соответствие - поля rac: infobase, name, dbms, db-server, db-name,
//                  sessions-deny и scheduled-jobs-deny (on|off), license-distribution (allow|deny)
//
Функция ИнформацияОбИБ(Знач ПараметрыКластера, Знач ИмяИБ) Экспорт
	Возврат ПредставлениеИБ(ИзменитьИБ(НастройкиПодключения(ПараметрыКластера), ИмяИБ));
КонецФункции

// Заблокировать начало сеансов ИБ. Незаданные код и сообщение остаются прежними.
//
// Параметры:
//   ПараметрыКластера   - Структура
//   ИмяИБ               - Строка
//   ПараметрыБлокировки - Структура, Неопределено - КодРазрешения, СообщениеБлокировки (необязательный)
//
Процедура ЗаблокироватьСеансы(Знач ПараметрыКластера, Знач ИмяИБ, Знач ПараметрыБлокировки = Неопределено) Экспорт
	ЗаблокироватьСеансыИБ(НастройкиПодключения(ПараметрыКластера), ИмяИБ, ПараметрыБлокировки);
КонецПроцедуры

// Разблокировать начало сеансов ИБ.
//
// Параметры:
//   ПараметрыКластера - Структура
//   ИмяИБ             - Строка
//
Процедура РазблокироватьСеансы(Знач ПараметрыКластера, Знач ИмяИБ) Экспорт

	ИзменитьИБ(НастройкиПодключения(ПараметрыКластера), ИмяИБ, Новый Структура("БлокировкаСеансов", Ложь));

	Лог.Информация("Сеансы разблокированы: %1", ИмяИБ);

КонецПроцедуры

// Завершить сеансы ИБ с проверкой фактического завершения.
//
// Сервер завершает сеансы асинхронно, а зависшие сеансы могут не завершаться с первой
// попытки. Поэтому после каждой попытки выдерживается пауза и список перечитывается;
// оставшиеся сеансы завершаются повторно - до успеха либо до исчерпания лимита
// (количество попыток или таймаут). Если сеансы так и остались - исключение.
//
// Параметры:
//   ПараметрыКластера - Структура
//   ИмяИБ             - Строка
//   БлокироватьНовые  - Булево - блокировать начало новых сеансов (по умолчанию Истина)
//   Отбор             - ОтборСеансов, Неопределено - завершать только подходящие под отбор сеансы
//   ПараметрыПовтора  - Структура, Неопределено - лимиты повторных попыток:
//     * ТаймаутСек - Число - максимальное время завершения, сек; если > 0,
//                            попытки идут до успеха или таймаута, а Попыток игнорируется
//     * Попыток    - Число - количество попыток при незаданном таймауте (по умолчанию 3)
//     * ПаузаМс    - Число - пауза после каждой попытки, мс (по умолчанию 3000)
//
Процедура ЗавершитьСеансы(Знач ПараметрыКластера, Знач ИмяИБ,
		Знач БлокироватьНовые = Истина, Знач Отбор = Неопределено, Знач ПараметрыПовтора = Неопределено) Экспорт

	Настройки = НастройкиПодключения(ПараметрыКластера);
	Повтор = НормализованныеПараметрыПовтора(ПараметрыПовтора);

	Если БлокироватьНовые Тогда
		ЗаблокироватьСеансыИБ(Настройки, ИмяИБ);
	КонецЕсли;

	НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	НомерПопытки = 0;

	Пока Истина Цикл

		НомерПопытки = НомерПопытки + 1;

		Сеансы = СеансыИБ(Настройки, ИмяИБ, Отбор);
		Если Сеансы.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;

		ЗавершитьКаждыйСеанс(Настройки, Сеансы);
		Приостановить(Повтор.ПаузаМс);

		Остались = СеансыИБ(Настройки, ИмяИБ, Отбор);
		Если Остались.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;

		Если ЛимитПопытокДостигнут(Повтор, НомерПопытки, НачалоМс) Тогда
			ВызватьИсключение СтрШаблон("Не удалось завершить сеансы ИБ %1 (попыток: %2): осталось %3 - %4",
				ИмяИБ, НомерПопытки, Остались.Количество(), ПредставлениеСеансов(Остались));
		КонецЕсли;

		Лог.Предупреждение("После попытки %1 остались сеансы (%2): %3 - повторяю",
			НомерПопытки, Остались.Количество(), ПредставлениеСеансов(Остались));

	КонецЦикла;

	Лог.Информация("Сеансы завершены: %1", ИмяИБ);

КонецПроцедуры

// Дождаться отсутствия сеансов ИБ.
//
// Параметры:
//   ПараметрыКластера - Структура
//   ИмяИБ             - Строка
//   Отбор             - ОтборСеансов, Неопределено - учитывать только подходящие под отбор сеансы
//   ТаймаутСек        - Число - время ожидания, сек; 0 - одна проверка без ожидания
//   ПаузаМс           - Число - пауза между проверками, мс (по умолчанию 3000)
//
// Возвращаемое значение:
//   Массив из Соответствие - оставшиеся сеансы (пустой, если сеансов нет), см. СписокСеансов
//
Функция ДождатьсяОтсутствияСеансов(Знач ПараметрыКластера, Знач ИмяИБ,
		Знач Отбор = Неопределено, Знач ТаймаутСек = 0, Знач ПаузаМс = 3000) Экспорт

	Настройки = НастройкиПодключения(ПараметрыКластера);
	НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Пока Истина Цикл

		Сеансы = СеансыИБ(Настройки, ИмяИБ, Отбор);
		Если Сеансы.Количество() = 0 Тогда
			Возврат Сеансы;
		КонецЕсли;

		Если ПрошлоСекунд(НачалоМс) >= ТаймаутСек Тогда
			Возврат Сеансы;
		КонецЕсли;

		Лог.Информация("Ожидаю завершения сеансов ИБ %1: осталось %2", ИмяИБ, Сеансы.Количество());
		Приостановить(ПаузаМс);

	КонецЦикла;

КонецФункции

// Получить список соединений ИБ.
//
// Параметры:
//   ПараметрыКластера - Структура
//   ИмяИБ             - Строка
//
// Возвращаемое значение:
//   Массив из Соответствие - поля rac: connection, conn-id, application, host, session-number, connected-at
//
Функция СписокСоединений(Знач ПараметрыКластера, Знач ИмяИБ) Экспорт

	Настройки = НастройкиПодключения(ПараметрыКластера);
	Клиент = НовыйКлиентRAS(Настройки);
	Попытка
		ИдКластера = ВойтиВКластер(Клиент, Настройки);
		ИдБазы = ИдИБ(Клиент, ИдКластера, ИмяИБ);
		Соединения = Клиент.Соединения(ИдКластера);
	Исключение
		Клиент.Отключить();
		ВызватьИсключение;
	КонецПопытки;
	Клиент.Отключить();

	Результат = Новый Массив;
	Для Каждого Соединение Из Соединения Цикл
		Если Соединение.ИдБазы = ИдБазы Тогда
			Результат.Добавить(ПоляRac(Соединение, "connection=Ид,conn-id=Номер,application=Приложение,"
				+ "host=Хост,session-number=НомерСеанса,connected-at=Подключено"));
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Получить список сеансов ИБ, при необходимости отфильтрованный.
//
// Параметры:
//   ПараметрыКластера - Структура
//   ИмяИБ             - Строка
//   Отбор             - ОтборСеансов, Неопределено - отбор сеансов; пустой отбор пропускает все
//
// Возвращаемое значение:
//   Массив из Соответствие - сеансы, подходящие под отбор; поля rac: session, session-id, app-id,
//                            user-name, host, started-at, last-active-at
//
Функция СписокСеансов(Знач ПараметрыКластера, Знач ИмяИБ, Знач Отбор = Неопределено) Экспорт
	Возврат СеансыИБ(НастройкиПодключения(ПараметрыКластера), ИмяИБ, Отбор);
КонецФункции

// Заблокировать регламентные задания ИБ.
//
// Параметры:
//   ПараметрыКластера - Структура
//   ИмяИБ             - Строка
//
Процедура ЗаблокироватьРегламентныеЗадания(Знач ПараметрыКластера, Знач ИмяИБ) Экспорт

	ИзменитьИБ(НастройкиПодключения(ПараметрыКластера), ИмяИБ, Новый Структура("БлокировкаРегламентных", Истина));

	Лог.Информация("Регламентные задания заблокированы: %1", ИмяИБ);

КонецПроцедуры

// Разблокировать регламентные задания ИБ.
//
// Параметры:
//   ПараметрыКластера - Структура
//   ИмяИБ             - Строка
//
Процедура РазблокироватьРегламентныеЗадания(Знач ПараметрыКластера, Знач ИмяИБ) Экспорт

	ИзменитьИБ(НастройкиПодключения(ПараметрыКластера), ИмяИБ, Новый Структура("БлокировкаРегламентных", Ложь));

	Лог.Информация("Регламентные задания разблокированы: %1", ИмяИБ);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Параметры кластера без Неопределено, с хостом и портом RAS.
Функция НастройкиПодключения(Знач ПараметрыКластера)

	Настройки = Новый Структура;
	Для Каждого Ключ Из СтрРазделить("АдресRAS,ПутьRac,АдминистраторКластера,ПарольКластера,"
			+ "ИдентификаторКластера,ИмяКластера,Пользователь,Пароль", ",") Цикл
		Значение = Неопределено;
		ПараметрыКластера.Свойство(Ключ, Значение);
		Настройки.Вставить(Ключ, ?(Значение = Неопределено, "", Значение));
	КонецЦикла;

	Если ЗначениеЗаполнено(Настройки.ПутьRac) Тогда
		Лог.Предупреждение("Опция --rac устарела и игнорируется: rac не используется");
	КонецЕсли;

	Адрес = ?(ЗначениеЗаполнено(Настройки.АдресRAS), Настройки.АдресRAS, АдресПоУмолчаниюRAS());
	Совпадения = Новый РегулярноеВыражение("^([^:]+)(?::(\d+))?$").НайтиСовпадения(Адрес);
	Если Совпадения.Количество() = 0 Тогда
		ВызватьИсключение СтрШаблон("Неверный адрес RAS ""%1"": ожидается host[:port]", Адрес);
	КонецЕсли;
	Группы = Совпадения[0].Группы;
	Настройки.Вставить("Хост", Группы[1].Значение);
	Настройки.Вставить("Порт", ?(ПустаяСтрока(Группы[2].Значение), ПортПоУмолчаниюRAS(), Число(Группы[2].Значение)));

	Возврат Настройки;

КонецФункции

Функция НовыйКлиентRAS(Знач Настройки)

	Лог.Отладка("Подключение к RAS: %1:%2", Настройки.Хост, Настройки.Порт);

	Если _ФабрикаКлиентаRAS <> Неопределено Тогда
		Возврат _ФабрикаКлиентаRAS.Создать(Настройки.Хост, Настройки.Порт);
	КонецЕсли;
	Возврат Новый КлиентКластераRAS(Настройки.Хост, Настройки.Порт, Неопределено, ТаймаутRASСекунд());

КонецФункции

// Подключает клиент и аутентифицирует в кластере (пустые имя и пароль - для кластера без администраторов).
Функция ВойтиВКластер(Знач Клиент, Знач Настройки)

	Клиент.Подключить();
	Кластеры = Клиент.Кластеры();

	Если Кластеры.Количество() = 0 Тогда
		ВызватьИсключение "Кластер серверов не найден";
	КонецЕсли;

	Кластер = НайтиКластерВСписке(Кластеры, Настройки.ИдентификаторКластера, Настройки.ИмяКластера);
	Клиент.АутентифицироватьКластер(Кластер.Ид, Настройки.АдминистраторКластера, Настройки.ПарольКластера);

	Лог.Отладка("Кластер: %1 (%2)", Кластер.Имя, Кластер.Ид);

	Возврат Кластер.Ид;

КонецФункции

Функция НайтиКластерВСписке(Кластеры, Знач ИдентификаторКластера, Знач ИмяКластера)

	Если НЕ ЗначениеЗаполнено(ИдентификаторКластера) И НЕ ЗначениеЗаполнено(ИмяКластера) Тогда
		Возврат Кластеры[0];
	КонецЕсли;

	Для Каждого ТекКластер Из Кластеры Цикл
		Если ЗначениеЗаполнено(ИдентификаторКластера) И НРег(ТекКластер.Ид) = НРег(ИдентификаторКластера) Тогда
			Возврат ТекКластер;
		КонецЕсли;
		Если ЗначениеЗаполнено(ИмяКластера) И ТекКластер.Имя = ИмяКластера Тогда
			Возврат ТекКластер;
		КонецЕсли;
	КонецЦикла;

	ВызватьИсключение "Кластер серверов не найден";

КонецФункции

// Идентификатор ИБ по имени или UUID; Неопределено, если ИБ нет.
Функция НайтиИБ(Знач Клиент, Знач ИдКластера, Знач ИмяИБ)

	Для Каждого База Из Клиент.Инфобазы(ИдКластера) Цикл
		Если База.Имя = ИмяИБ ИЛИ НРег(База.Ид) = НРег(ИмяИБ) Тогда
			Возврат База.Ид;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция ИдИБ(Знач Клиент, Знач ИдКластера, Знач ИмяИБ)

	ИдБазы = НайтиИБ(Клиент, ИдКластера, ИмяИБ);
	Если ИдБазы = Неопределено Тогда
		ВызватьИсключение СтрШаблон("ИБ ""%1"" не найдена в кластере", ИмяИБ);
	КонецЕсли;

	Возврат ИдБазы;

КонецФункции

// Пользователь ИБ из параметров кластера (Пользователь/Пароль), если задан.
Процедура АутентифицироватьВИБ(Знач Клиент, Знач ИдКластера, Знач Настройки)
	Если ЗначениеЗаполнено(Настройки.Пользователь) Тогда
		Клиент.АутентифицироватьБазу(ИдКластера, Настройки.Пользователь, Настройки.Пароль);
	КонецЕсли;
КонецПроцедуры

// Полное описание ИБ (структура База v8ras); заданные Изменения записываются в ИБ поверх прежних значений.
Функция ИзменитьИБ(Знач Настройки, Знач ИмяИБ, Знач Изменения = Неопределено)

	Клиент = НовыйКлиентRAS(Настройки);
	Попытка
		ИдКластера = ВойтиВКластер(Клиент, Настройки);
		ИдБазы = ИдИБ(Клиент, ИдКластера, ИмяИБ);
		АутентифицироватьВИБ(Клиент, ИдКластера, Настройки);
		Инфо = Клиент.ИнформацияОБазе(ИдКластера, ИдБазы);
		Если Изменения <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(Инфо, Изменения);
			Клиент.ОбновитьБазу(ИдКластера, Инфо);
		КонецЕсли;
	Исключение
		Клиент.Отключить();
		ВызватьИсключение;
	КонецПопытки;
	Клиент.Отключить();

	Возврат Инфо;

КонецФункции

Процедура ЗаблокироватьСеансыИБ(Знач Настройки, Знач ИмяИБ, Знач ПараметрыБлокировки = Неопределено)

	Изменения = Новый Структура("БлокировкаСеансов", Истина);
	Если ПараметрыБлокировки <> Неопределено Тогда
		ПеренестиЗаполненное(Изменения, ПараметрыБлокировки, "КодРазрешения");
		ПеренестиЗаполненное(Изменения, ПараметрыБлокировки, "СообщениеБлокировки");
	КонецЕсли;

	ИзменитьИБ(Настройки, ИмяИБ, Изменения);

	Лог.Информация("Сеансы заблокированы: %1", ИмяИБ);

КонецПроцедуры

Функция СеансыИБ(Знач Настройки, Знач ИмяИБ, Знач Отбор)

	Клиент = НовыйКлиентRAS(Настройки);
	Попытка
		ИдКластера = ВойтиВКластер(Клиент, Настройки);
		ИдБазы = ИдИБ(Клиент, ИдКластера, ИмяИБ);
		Сеансы = Клиент.Сеансы(ИдКластера);
	Исключение
		Клиент.Отключить();
		ВызватьИсключение;
	КонецПопытки;
	Клиент.Отключить();

	Результат = Новый Массив;
	Для Каждого Сеанс Из Сеансы Цикл

		Если Сеанс.ИдБазы <> ИдБазы Тогда
			Продолжить;
		КонецЕсли;

		ПоляСеанса = ПоляRac(Сеанс, "session=Ид,session-id=Номер,app-id=Приложение,user-name=ИмяПользователя,"
			+ "host=Хост,started-at=Начало,last-active-at=ПоследняяАктивность");

		Если Отбор <> Неопределено И НЕ Отбор.СеансПодходит(ПоляСеанса) Тогда
			Лог.Отладка("Сеанс %1 [%2] не подходит под отбор, пропускаю", Сеанс.Номер, Сеанс.Приложение);
			Продолжить;
		КонецЕсли;

		Результат.Добавить(ПоляСеанса);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Завершить каждый сеанс из списка; ошибки завершения отдельных сеансов не прерывают обход.
Процедура ЗавершитьКаждыйСеанс(Знач Настройки, Знач Сеансы)

	Клиент = НовыйКлиентRAS(Настройки);
	Попытка
		ИдКластера = ВойтиВКластер(Клиент, Настройки);
		Для Каждого Сеанс Из Сеансы Цикл
			Лог.Информация("Завершаю сеанс: %1 [%2]",
				Сеанс.Получить("session-id"), Сеанс.Получить("app-id"));
			Попытка
				Клиент.ЗавершитьСеанс(ИдКластера, Сеанс.Получить("session"));
			Исключение
				Лог.Отладка("Пропускаю ошибку: %1", ОписаниеОшибки());
			КонецПопытки;
		КонецЦикла;
	Исключение
		Клиент.Отключить();
		ВызватьИсключение;
	КонецПопытки;
	Клиент.Отключить();

КонецПроцедуры

Функция ПредставлениеИБ(Знач Инфо)

	Представление = ПоляRac(Инфо, "infobase=Ид,name=Имя,dbms=СУБД,db-server=СерверБД,db-name=ИмяБД");
	Представление.Вставить("sessions-deny", ?(Инфо.БлокировкаСеансов, "on", "off"));
	Представление.Вставить("scheduled-jobs-deny", ?(Инфо.БлокировкаРегламентных, "on", "off"));
	Представление.Вставить("license-distribution", ?(Инфо.ВыдачаЛицензийСервером = 1, "allow", "deny"));

	Возврат Представление;

КонецФункции

// Поля структуры v8ras под именами rac по парам "rac=v8ras" через запятую.
Функция ПоляRac(Знач Объект, Знач Пары)

	Результат = Новый Соответствие;
	Для Каждого Пара Из СтрРазделить(Пары, ",") Цикл
		Имена = СтрРазделить(Пара, "=");
		Результат.Вставить(Имена[0], Объект[Имена[1]]);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Перенести свойство источника в приёмник, если оно есть и заполнено (при необходимости под другим именем).
Процедура ПеренестиЗаполненное(Приемник, Знач Источник, Знач ИмяСвойства, Знач ИмяВПриемнике = "")

	Если Источник.Свойство(ИмяСвойства) И ЗначениеЗаполнено(Источник[ИмяСвойства]) Тогда
		Приемник.Вставить(?(ЗначениеЗаполнено(ИмяВПриемнике), ИмяВПриемнике, ИмяСвойства), Источник[ИмяСвойства]);
	КонецЕсли;

КонецПроцедуры

Функция НормализованныеПараметрыПовтора(Знач ПараметрыПовтора)

	Повтор = Новый Структура("ТаймаутСек, Попыток, ПаузаМс", 0, ПопытокПоУмолчанию(), ПаузаМсПоУмолчанию());

	Если ПараметрыПовтора <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Повтор, ПараметрыПовтора);
	КонецЕсли;

	Возврат Повтор;

КонецФункции

Функция ЛимитПопытокДостигнут(Знач Повтор, Знач НомерПопытки, Знач НачалоМс)

	Если Повтор.ТаймаутСек > 0 Тогда
		Возврат ПрошлоСекунд(НачалоМс) >= Повтор.ТаймаутСек;
	КонецЕсли;

	Возврат НомерПопытки >= Повтор.Попыток;

КонецФункции

Функция ПрошлоСекунд(Знач НачалоМс)

	МиллисекундВСекунде = 1000; // BSLLS:MagicNumber-off
	Возврат (ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс) / МиллисекундВСекунде;

КонецФункции

Функция ПредставлениеСеансов(Знач Сеансы)

	Части = Новый Массив;
	Для Каждого Сеанс Из Сеансы Цикл
		Части.Добавить(СтрШаблон("%1 [%2] %3",
			Сеанс.Получить("session-id"), Сеанс.Получить("app-id"), Сеанс.Получить("user-name")));
	КонецЦикла;

	Возврат СтрСоединить(Части, "; ");

КонецФункции

Функция АдресПоУмолчаниюRAS()
	Возврат "localhost";
КонецФункции

Функция ПортПоУмолчаниюRAS()
	Возврат 1545; // BSLLS:MagicNumber-off
КонецФункции

// Создание и удаление базы данных в СУБД бывает дольше 30 с - умолчания v8ras.
Функция ТаймаутRASСекунд()
	Возврат 300; // BSLLS:MagicNumber-off
КонецФункции

Функция ЛокализацияПоУмолчанию()
	Возврат "ru_RU";
КонецФункции

Функция ПопытокПоУмолчанию()
	Возврат 3; // BSLLS:MagicNumber-off
КонецФункции

Функция ПаузаМсПоУмолчанию()
	Возврат 3000; // BSLLS:MagicNumber-off
КонецФункции

#КонецОбласти
