// BSLLS:MissingVariablesDescription-off Поля autumn (&Лог/&Пластилин)
// BSLLS:MissingParameterDescription-off Внутренние служебные методы.
// BSLLS:MissingReturnedValueDescription-off Внутренние служебные методы.
// BSLLS:NumberOfOptionalParams-off
// BSLLS:PublicMethodsDescription-off
// Сервис операций с конфигурацией (CF).
// Фасад: загрузка, выгрузка, сборка, разборка, сравнение, объединение CF.
// Маршрутизирует вызовы к нужному движку (конфигуратор или ibcmd),
// оркестрирует пайплайны (создание базы → загрузка → выгрузка → очистка).

&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисВременнойБазы;

&Пластилин
Перем СервисРасчетаИнкремента;

&Пластилин
Перем СервисEDT;

&Пластилин
Перем СервисПоискаИсточников;

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#Область ПрограммныйИнтерфейс

Процедура ЗагрузитьКонфигурациюИзФайлов(Знач ПараметрыПодключения, Знач КаталогИсходников,
		Знач ПараметрыПлатформы = Неопределено,
		Знач СписокФайлов = "", Знач ИнкрементальнаяЗагрузка = Ложь,
		Знач ПараметрыИсходников = Неопределено) Экспорт

	Ресурсы = Новый СтекОсвобождения(Лог);
	Попытка
		КонтекстEDT = СервисEDT.ПодготовитьXML(КаталогИсходников, ПараметрыИсходников);
		Ресурсы.Добавить(СервисEDT, КонтекстEDT, "ЗавершитьXML");
		ВыполнитьЗагрузкуКонфигурацииИзФайлов(ПараметрыПодключения, КонтекстEDT.Путь,
			ПараметрыПлатформы, СписокФайлов, ИнкрементальнаяЗагрузка, КонтекстEDT);
	Исключение
		Ресурсы.Отменить();
		ВызватьИсключение;
	КонецПопытки;
	Ресурсы.Завершить();

КонецПроцедуры

Процедура ЗагрузитьКонфигурациюИзФайла(Знач ПараметрыПодключения, Знач ПутьКФайлуCf,
		Знач ПараметрыПлатформы = Неопределено) Экспорт

	Движок = СервисВременнойБазы.ВыбратьДвижок(ПараметрыПлатформы);
	Лог.Отладка("Загрузка конфигурации из файла: файл=%1, движок=%2", ПутьКФайлуCf, Движок);
	Движок.ЗагрузитьКонфигурациюИзФайла(ПараметрыПодключения, ПутьКФайлуCf, ПараметрыПлатформы);
	Лог.Информация("Конфигурация загружена из файла %1", ПутьКФайлуCf);

КонецПроцедуры

// Загрузить конфигурацию из файла .cf или каталога исходников - по виду источника
// (см. СервисПоискаИсточников.ВидИсточника).
//
// Параметры:
//   ПараметрыПодключения - Структура - параметры подключения к ИБ
//   Источник - Строка - путь к файлу .cf или каталогу исходников
//   ПараметрыПлатформы - Структура, Неопределено - параметры платформы
//   ПараметрыИсходников - Структура, Неопределено - параметры подготовки исходников (только для каталога)
//   ИнкрементальнаяЗагрузка - Булево - загрузка по индексу изменений (только для каталога)
//   СписокФайлов - Строка - список файлов для выборочной загрузки (только для каталога)
//
// Возвращаемое значение:
//   Строка - вид источника: "cf", "xml" или "edt"
//
Функция ЗагрузитьИсточник(Знач ПараметрыПодключения, Знач Источник, Знач ПараметрыПлатформы = Неопределено,
		Знач ПараметрыИсходников = Неопределено, Знач ИнкрементальнаяЗагрузка = Ложь, Знач СписокФайлов = "") Экспорт

	Вид = СервисПоискаИсточников.ВидИсточника(Источник);
	Если Вид = "cf" Тогда
		Лог.Информация("Загрузка конфигурации из файла: %1", Источник);
		ЗагрузитьКонфигурациюИзФайла(ПараметрыПодключения, Источник, ПараметрыПлатформы);
	Иначе
		Лог.Информация("Загрузка конфигурации из исходников: %1", Источник);
		ЗагрузитьКонфигурациюИзФайлов(ПараметрыПодключения, Источник, ПараметрыПлатформы,
			СписокФайлов, ИнкрементальнаяЗагрузка, ПараметрыИсходников);
	КонецЕсли;

	Возврат Вид;

КонецФункции

Процедура ВыгрузитьКонфигурациюВФайл(Знач ПараметрыПодключения, Знач ПутьКФайлуCf,
		Знач ПараметрыПлатформы = Неопределено) Экспорт

	Движок = СервисВременнойБазы.ВыбратьДвижок(ПараметрыПлатформы);
	Лог.Отладка("Выгрузка конфигурации: выход=%1, движок=%2", ПутьКФайлуCf, Движок);
	Движок.ВыгрузитьКонфигурациюВФайл(ПараметрыПодключения, ПутьКФайлуCf, ПараметрыПлатформы);
	Лог.Информация("Конфигурация выгружена в файл %1", ПутьКФайлуCf);

КонецПроцедуры

// Создать полный файл поставки конфигурации из конфигурации указанной ИБ.
// Формирование поставки является операцией Конфигуратора и не поддерживается ibcmd.
//
// Параметры:
//   ПараметрыПодключения - Структура - параметры подключения к ИБ
//   ПутьКФайлуCf - Строка - путь к полному файлу поставки (*.cf)
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//
Процедура СоздатьФайлПоставки(Знач ПараметрыПодключения, Знач ПутьКФайлуCf,
		Знач ПараметрыПлатформы = Неопределено) Экспорт

	Движок = СервисВременнойБазы.ДвижокКонфигуратор();
	Лог.Отладка("Создание файла поставки: выход=%1, движок=%2", ПутьКФайлуCf, Движок);
	Движок.СоздатьФайлыПоставки(ПараметрыПодключения, ПутьКФайлуCf, ПараметрыПлатформы);
	Лог.Информация("Файл поставки конфигурации создан: %1", ПутьКФайлуCf);

КонецПроцедуры

Процедура СобратьВФайлCf(Знач КаталогИсходников, Знач ПутьКФайлуCf,
		Знач ПараметрыПлатформы = Неопределено,
		Знач СписокФайлов = "", Знач ПараметрыПодключения = Неопределено,
		Знач ПараметрыИсходников = Неопределено) Экспорт

	Движок = СервисВременнойБазы.ВыбратьДвижок(ПараметрыПлатформы);
	Лог.Отладка("Сборка CF: исходники=%1, выход=%2, движок=%3", КаталогИсходников, ПутьКФайлуCf, Движок);

	Ресурсы = Новый СтекОсвобождения(Лог);
	Попытка
		КонтекстEDT = СервисEDT.ПодготовитьXML(КаталогИсходников, ПараметрыИсходников);
		Ресурсы.Добавить(СервисEDT, КонтекстEDT, "ЗавершитьXML");
		КонтекстБазы = СервисВременнойБазы.Подготовить(Движок, ПараметрыПодключения, ПараметрыПлатформы);
		Ресурсы.Добавить(СервисВременнойБазы, КонтекстБазы, "Очистить");
		Лог.Информация("Загрузка конфигурации в базу из исходников %1…", КаталогИсходников);
		Движок.ЗагрузитьКонфигурациюИзФайлов(
			КонтекстБазы.ПараметрыПодключения, КонтекстEDT.Путь, ПараметрыПлатформы, СписокФайлов);
		Лог.Информация("Выгрузка конфигурации в файл %1…", ПутьКФайлуCf);
		Движок.ВыгрузитьКонфигурациюВФайл(КонтекстБазы.ПараметрыПодключения, ПутьКФайлуCf, ПараметрыПлатформы);
	Исключение
		Ресурсы.Отменить();
		ВызватьИсключение;
	КонецПопытки;
	Ресурсы.Завершить();

	Лог.Информация("Конфигурация успешно собрана в файл %1", ПутьКФайлуCf);

КонецПроцедуры

Процедура РазобратьКонфигурациюВИсходники(Знач ПутьКФайлуCf, Знач КаталогВыгрузки,
		Знач ПараметрыПлатформы = Неопределено,
		Знач ПараметрыПодключения = Неопределено, Знач ПараметрыИсходников = Неопределено) Экспорт

	ЗагружатьИзФайла = ЗначениеЗаполнено(ПутьКФайлуCf);
	БазаПередана = ПараметрыПодключения <> Неопределено
		И ЗначениеЗаполнено(ПараметрыПодключения.СтрокаПодключения);

	Если НЕ ЗагружатьИзФайла И НЕ БазаПередана Тогда
		ВызватьИсключение "Не задан файл cf и не передана информационная база: нечего выгружать в исходники";
	КонецЕсли;

	Движок = СервисВременнойБазы.ВыбратьДвижок(ПараметрыПлатформы);
	Лог.Отладка("Разборка CF: файл=%1, выход=%2, движок=%3", ПутьКФайлуCf, КаталогВыгрузки, Движок);

	Ресурсы = Новый СтекОсвобождения(Лог);
	Попытка
		КонтекстВыгрузки = СервисEDT.НачатьВыгрузку(КаталогВыгрузки, ПараметрыИсходников);
		Ресурсы.Добавить(СервисEDT, КонтекстВыгрузки, "ЗавершитьВыгрузку", "ПрерватьВыгрузку");
		КонтекстБазы = СервисВременнойБазы.Подготовить(Движок, ПараметрыПодключения, ПараметрыПлатформы);
		Ресурсы.Добавить(СервисВременнойБазы, КонтекстБазы, "Очистить");
		Если ЗагружатьИзФайла Тогда
			Лог.Информация("Загрузка конфигурации из файла %1…", ПутьКФайлуCf);
			Движок.ЗагрузитьКонфигурациюИзФайла(КонтекстБазы.ПараметрыПодключения, ПутьКФайлуCf, ПараметрыПлатформы);
		КонецЕсли;
		Лог.Информация("Выгрузка конфигурации в исходники %1…", КаталогВыгрузки);
		Движок.ВыгрузитьКонфигурациюВФайлы(КонтекстБазы.ПараметрыПодключения, КонтекстВыгрузки.Путь, ПараметрыПлатформы);
	Исключение
		Ресурсы.Отменить();
		ВызватьИсключение;
	КонецПопытки;
	Ресурсы.Завершить();

	Лог.Информация("Конфигурация успешно разобрана в каталог %1", КаталогВыгрузки);

КонецПроцедуры

Процедура ОбъединитьКонфигурациюСФайлом(Знач ПараметрыПодключения, Знач ПутьКCf, Знач ФайлНастроек,
	Знач ПоставитьНаПоддержку = Неопределено,
	Знач ВключитьВОбъединениеОбъектыПоНеразрешеннымСсылкам = Неопределено,
	Знач Принудительно = Ложь,
	Знач ПараметрыПлатформы = Неопределено) Экспорт

	Движок = СервисВременнойБазы.ДвижокКонфигуратор();
	Лог.Отладка("Объединение конфигурации с файлом: %1", ПутьКCf);
	Движок.ОбъединитьКонфигурациюСФайлом(
		ПараметрыПодключения, ПутьКCf, ФайлНастроек,
		ПоставитьНаПоддержку,
		ВключитьВОбъединениеОбъектыПоНеразрешеннымСсылкам,
		Принудительно,
		ПараметрыПлатформы);
	Лог.Информация("Конфигурация успешно объединена с файлом %1", ПутьКCf);

КонецПроцедуры

// Обновить конфигурацию ИБ, находящуюся на поддержке, из файла поставщика.
// Обновление на поддержке является операцией Конфигуратора и не поддерживается ibcmd.
//
// Параметры:
//   ПараметрыПодключения - Структура - параметры подключения к ИБ
//   ПутьКФайлу - Строка - путь к файлу обновления (.cfu) или полному дистрибутиву поставщика (.cf)
//   ФайлНастроек - Строка, Неопределено - путь к файлу настроек объединения
//   ВключитьВОбъединениеОбъектыПоНеразрешеннымСсылкам - Булево, Неопределено - включать по неразрешённым ссылкам
//   Принудительно - Булево - выполнить принудительное обновление при наличии предупреждений
//   ВывестиДваждыИзмененныеСвойства - Булево - вывести список дважды изменённых свойств
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//
Процедура ОбновитьКонфигурациюИзФайла(Знач ПараметрыПодключения, Знач ПутьКФайлу,
	Знач ФайлНастроек = Неопределено,
	Знач ВключитьВОбъединениеОбъектыПоНеразрешеннымСсылкам = Неопределено,
	Знач Принудительно = Ложь,
	Знач ВывестиДваждыИзмененныеСвойства = Ложь,
	Знач ПараметрыПлатформы = Неопределено) Экспорт

	Движок = СервисВременнойБазы.ДвижокКонфигуратор();
	Лог.Отладка("Обновление конфигурации на поддержке из файла: %1", ПутьКФайлу);
	Движок.ОбновитьКонфигурациюИзФайла(
		ПараметрыПодключения, ПутьКФайлу, ФайлНастроек,
		ВключитьВОбъединениеОбъектыПоНеразрешеннымСсылкам,
		Принудительно,
		ВывестиДваждыИзмененныеСвойства,
		ПараметрыПлатформы);
	Лог.Информация("Конфигурация успешно обновлена из файла %1", ПутьКФайлу);

КонецПроцедуры

Функция СравнитьКонфигурации(Знач ПараметрыПодключения, Знач ПутьКВторомуCf, Знач КаталогОтчета,
	Знач ТипОтчета, Знач ФорматОтчета,
	Знач ПутьКПервомуCf = Неопределено,
	Знач ПараметрыПлатформы = Неопределено) Экспорт

	Движок = СервисВременнойБазы.ДвижокКонфигуратор();
	Лог.Отладка("Сравнение конфигураций: второй=%1, каталог=%2", ПутьКВторомуCf, КаталогОтчета);
	ПутьКОтчету = ПутьКОтчетуСравнения(КаталогОтчета, ТипОтчета, ФорматОтчета);

	Ресурсы = Новый СтекОсвобождения(Лог);
	Попытка
		КонтекстБазы = СервисВременнойБазы.Подготовить(Движок, ПараметрыПодключения, ПараметрыПлатформы);
		Ресурсы.Добавить(СервисВременнойБазы, КонтекстБазы, "Очистить");
		Лог.Информация("Сравнение конфигураций, отчёт: %1…", ПутьКОтчету);
		Движок.СравнитьКонфигурации(
			КонтекстБазы.ПараметрыПодключения,
			ПутьКВторомуCf,
			ПутьКОтчету,
			ТипОтчета,
			ФорматОтчета,
			ПутьКПервомуCf,
			ПараметрыПлатформы);
	Исключение
		Ресурсы.Отменить();
		ВызватьИсключение;
	КонецПопытки;
	Ресурсы.Завершить();

	Лог.Информация("Отчет о сравнении сохранен: %1", ПутьКОтчету);
	Возврат ПутьКОтчету;

КонецФункции

// Путь к файлу отчёта сравнения: compare_report_<тип>_<дата_время>.<формат> в каталоге отчёта.
// Одна и та же схема имени для отчётов сравнения конфигураций и расширений.
//
// Параметры:
//   КаталогОтчета - Строка - каталог, в котором создаётся файл отчёта
//   ТипОтчета     - Строка - Full или Brief
//   ФорматОтчета  - Строка - txt или mxl
//
// Возвращаемое значение:
//   Строка - полный путь к файлу отчёта
//
Функция ПутьКОтчетуСравнения(Знач КаталогОтчета, Знач ТипОтчета, Знач ФорматОтчета) Экспорт

	ДатаВремя = Формат(ТекущаяДата(), "ДФ=yyyyMMdd_HHmmss");
	ИмяФайла = "compare_report_" + НРег(ТипОтчета) + "_" + ДатаВремя + "." + НРег(ФорматОтчета);
	Возврат ОбъединитьПути(КаталогОтчета, ИмяФайла);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Загрузка конфигурации из XML выбранным движком с учётом инкремента.
// КонтекстEDT - результат СервисEDT.ПодготовитьXML: для EDT изменения детектируются по исходникам
// EDT-проекта, а список файлов собирается из временного XML-дампа (КаталогИсходников).
Процедура ВыполнитьЗагрузкуКонфигурацииИзФайлов(Знач ПараметрыПодключения, Знач КаталогИсходников,
		Знач ПараметрыПлатформы, Знач СписокФайлов, Знач ИнкрементальнаяЗагрузка,
		Знач КонтекстEDT = Неопределено)

	Движок = СервисВременнойБазы.ВыбратьДвижок(ПараметрыПлатформы);
	КонтекстИнкремента = Неопределено;
	Если ИнкрементальнаяЗагрузка И НЕ ЗначениеЗаполнено(СписокФайлов) Тогда
		Если КонтекстEDT <> Неопределено И КонтекстEDT.ЭтоEDT Тогда
			РезультатИнкремента = СервисРасчетаИнкремента.РассчитатьИнкрементEDTДляЗагрузкиКонфигурации(
				КонтекстEDT.КаталогEDT,
				КаталогИсходников,
				ПараметрыПодключения);
		Иначе
			РезультатИнкремента = СервисРасчетаИнкремента.РассчитатьИнкрементДляЗагрузкиКонфигурации(
				КаталогИсходников,
				ПараметрыПодключения,
				ПараметрыПлатформы,
				СписокФайлов);
		КонецЕсли;
		КонтекстИнкремента = РезультатИнкремента.КонтекстИнкремента;
		Если РезультатИнкремента.ПропуститьЗагрузку Тогда
			Возврат;
		КонецЕсли;
		СписокФайлов = РезультатИнкремента.СписокФайловДляЗагрузки;
	КонецЕсли;

	Лог.Отладка("Загрузка конфигурации: исходники=%1, движок=%2", КаталогИсходников, Движок);
	Движок.ЗагрузитьКонфигурациюИзФайлов(ПараметрыПодключения, КаталогИсходников, ПараметрыПлатформы, СписокФайлов);
	Если КонтекстИнкремента <> Неопределено Тогда
		СервисРасчетаИнкремента.ЗафиксироватьИнкремент(КонтекстИнкремента);
	КонецЕсли;
	Лог.Информация("Конфигурация загружена из файлов %1", КаталогИсходников);

КонецПроцедуры

#КонецОбласти
