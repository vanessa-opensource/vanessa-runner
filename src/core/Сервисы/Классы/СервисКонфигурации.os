// BSLLS:MissingVariablesDescription-off Поля autumn
// BSLLS:NumberOfOptionalParams-off
// BSLLS:PublicMethodsDescription-off (&Лог/&Пластилин/&Напильник) и внутреннее состояние сервиса.
// Сервис операций с конфигурацией (CF).
// Фасад: загрузка, выгрузка, сборка, разборка, сравнение, объединение CF.
// Маршрутизирует вызовы к нужному движку (конфигуратор или ibcmd),
// оркестрирует пайплайны (создание базы → загрузка → выгрузка → очистка).

&Лог("vrunner")
Перем Лог;

&Пластилин(Значение = "ДвижокПлатформы", Тип = "Соответствие")
Перем Движки;

&Пластилин
Перем СервисРасчетаИнкремента;

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#Область ПрограммныйИнтерфейс

Процедура ЗагрузитьКонфигурациюИзФайлов(Знач ПараметрыПодключения, Знач КаталогИсходников,
		Знач ИспользоватьIbcmd = Ложь, Знач ПараметрыПлатформы = Неопределено,
		Знач СписокФайлов = "", Знач ИнкрементальнаяЗагрузка = Ложь) Экспорт

	Движок = ВыбратьДвижок(ИспользоватьIbcmd);
	КонтекстИнкремента = Неопределено;
	Если ИнкрементальнаяЗагрузка = Истина И НЕ ЗначениеЗаполнено(СписокФайлов) Тогда
		РезультатИнкремента = СервисРасчетаИнкремента.РассчитатьИнкрементДляЗагрузкиКонфигурации(
			КаталогИсходников,
			ПараметрыПодключения,
			ИспользоватьIbcmd,
			ПараметрыПлатформы,
			СписокФайлов);
		КонтекстИнкремента = РезультатИнкремента.КонтекстИнкремента;
		Если РезультатИнкремента.ПропуститьЗагрузку Тогда
			Возврат;
		КонецЕсли;
		СписокФайлов = РезультатИнкремента.СписокФайловДляЗагрузки;
	КонецЕсли;

	Лог.Отладка("Загрузка конфигурации: исходники=%1, движок=%2", КаталогИсходников, Движок);
	Движок.ЗагрузитьКонфигурациюИзФайлов(ПараметрыПодключения, КаталогИсходников, ПараметрыПлатформы, СписокФайлов);
	Если КонтекстИнкремента <> Неопределено Тогда
		СервисРасчетаИнкремента.ЗафиксироватьИнкремент(КонтекстИнкремента);
	КонецЕсли;
	Лог.Информация("Конфигурация загружена из файлов %1", КаталогИсходников);

КонецПроцедуры

Процедура ЗагрузитьКонфигурациюИзФайла(Знач ПараметрыПодключения, Знач ПутьКФайлуCf,
		Знач ИспользоватьIbcmd = Ложь, Знач ПараметрыПлатформы = Неопределено) Экспорт

	Движок = ВыбратьДвижок(ИспользоватьIbcmd);
	Лог.Отладка("Загрузка конфигурации из файла: файл=%1, движок=%2", ПутьКФайлуCf, Движок);
	Движок.ЗагрузитьКонфигурациюИзФайла(ПараметрыПодключения, ПутьКФайлуCf, ПараметрыПлатформы);
	Лог.Информация("Конфигурация загружена из файла %1", ПутьКФайлуCf);

КонецПроцедуры

Процедура ВыгрузитьКонфигурациюВФайл(Знач ПараметрыПодключения, Знач ПутьКФайлуCf,
		Знач ИспользоватьIbcmd = Ложь, Знач ПараметрыПлатформы = Неопределено) Экспорт

	Движок = ВыбратьДвижок(ИспользоватьIbcmd);
	Лог.Отладка("Выгрузка конфигурации: выход=%1, движок=%2", ПутьКФайлуCf, Движок);
	Движок.ВыгрузитьКонфигурациюВФайл(ПараметрыПодключения, ПутьКФайлуCf, ПараметрыПлатформы);
	Лог.Информация("Конфигурация выгружена в файл %1", ПутьКФайлуCf);

КонецПроцедуры

Процедура СобратьВФайлCf(Знач КаталогИсходников, Знач ПутьКФайлуCf,
		Знач ИспользоватьIbcmd = Ложь, Знач ПараметрыПлатформы = Неопределено,
		Знач СписокФайлов = "", Знач ПараметрыПодключения = Неопределено) Экспорт

	Движок = ВыбратьДвижок(ИспользоватьIbcmd);
	Лог.Отладка("Сборка CF: исходники=%1, выход=%2, движок=%3", КаталогИсходников, ПутьКФайлуCf, Движок);

	КонтекстБазы = ПодготовитьБазу(Движок, ПараметрыПодключения, ПараметрыПлатформы);

	Попытка
		Движок.ЗагрузитьКонфигурациюИзФайлов(
			КонтекстБазы.ПараметрыПодключения, КаталогИсходников, ПараметрыПлатформы, СписокФайлов);
		Движок.ВыгрузитьКонфигурациюВФайл(КонтекстБазы.ПараметрыПодключения, ПутьКФайлуCf, ПараметрыПлатформы);
	Исключение
		ОчиститьВременнуюБазу(КонтекстБазы);
		ВызватьИсключение;
	КонецПопытки;

	ОчиститьВременнуюБазу(КонтекстБазы);
	Лог.Информация("Конфигурация успешно собрана в файл %1", ПутьКФайлуCf);

КонецПроцедуры

Процедура РазобратьИзФайлаCf(Знач ПутьКФайлуCf, Знач КаталогВыгрузки,
		Знач ИспользоватьIbcmd = Ложь, Знач ПараметрыПлатформы = Неопределено,
		Знач ПараметрыПодключения = Неопределено) Экспорт

	Движок = ВыбратьДвижок(ИспользоватьIbcmd);
	Лог.Отладка("Разборка CF: файл=%1, выход=%2, движок=%3", ПутьКФайлуCf, КаталогВыгрузки, Движок);

	КонтекстБазы = ПодготовитьБазу(Движок, ПараметрыПодключения, ПараметрыПлатформы);

	Попытка
		Движок.ЗагрузитьКонфигурациюИзФайла(КонтекстБазы.ПараметрыПодключения, ПутьКФайлуCf, ПараметрыПлатформы);
		Движок.ВыгрузитьКонфигурациюВФайлы(КонтекстБазы.ПараметрыПодключения, КаталогВыгрузки, ПараметрыПлатформы);
	Исключение
		ОчиститьВременнуюБазу(КонтекстБазы);
		ВызватьИсключение;
	КонецПопытки;

	ОчиститьВременнуюБазу(КонтекстБазы);
	Лог.Информация("Конфигурация успешно разобрана в каталог %1", КаталогВыгрузки);

КонецПроцедуры

Процедура ОбъединитьКонфигурациюСФайлом(Знач ПараметрыПодключения, Знач ПутьКCf, Знач ФайлНастроек,
	Знач ПоставитьНаПоддержку = Неопределено,
	Знач ВключитьВОбъединениеОбъектыПоНеразрешеннымСсылкам = Неопределено,
	Знач Принудительно = Ложь,
	Знач ПараметрыПлатформы = Неопределено) Экспорт

	Движок = Движки["ДвижокКонфигуратор"];
	Лог.Отладка("Объединение конфигурации с файлом: %1", ПутьКCf);
	Движок.ОбъединитьКонфигурациюСФайлом(
		ПараметрыПодключения, ПутьКCf, ФайлНастроек,
		ПоставитьНаПоддержку,
		ВключитьВОбъединениеОбъектыПоНеразрешеннымСсылкам,
		Принудительно,
		ПараметрыПлатформы);
	Лог.Информация("Конфигурация успешно объединена с файлом %1", ПутьКCf);

КонецПроцедуры

Функция СравнитьКонфигурации(Знач ПараметрыПодключения, Знач ПутьКВторомуCf, Знач КаталогОтчета,
	Знач ТипОтчета, Знач ФорматОтчета,
	Знач ПутьКПервомуCf = Неопределено,
	Знач ПараметрыПлатформы = Неопределено) Экспорт

	Движок = Движки["ДвижокКонфигуратор"];
	Лог.Отладка("Сравнение конфигураций: второй=%1, каталог=%2", ПутьКВторомуCf, КаталогОтчета);

	КонтекстБазы = ПодготовитьБазу(Движок, ПараметрыПодключения, ПараметрыПлатформы);

	ДатаВремя = Формат(ТекущаяДата(), "ДФ=yyyyMMdd_HHmmss");
	ИмяФайла = "compare_report_" + НРег(ТипОтчета) + "_" + ДатаВремя + "." + НРег(ФорматОтчета);
	ПутьКОтчету = ОбъединитьПути(КаталогОтчета, ИмяФайла);

	Попытка
		Движок.СравнитьКонфигурации(
			КонтекстБазы.ПараметрыПодключения,
			ПутьКВторомуCf,
			ПутьКОтчету,
			ТипОтчета,
			ФорматОтчета,
			ПутьКПервомуCf,
			ПараметрыПлатформы);
	Исключение
		ОчиститьВременнуюБазу(КонтекстБазы);
		ВызватьИсключение;
	КонецПопытки;

	ОчиститьВременнуюБазу(КонтекстБазы);
	Лог.Информация("Отчет о сравнении сохранен: %1", ПутьКОтчету);
	Возврат ПутьКОтчету;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВыбратьДвижок(ИспользоватьIbcmd)

	Если ЗначениеЗаполнено(ИспользоватьIbcmd) И Булево(ИспользоватьIbcmd) Тогда
		Возврат Движки["ДвижокIbcmd"];
	КонецЕсли;

	Возврат Движки["ДвижокКонфигуратор"];

КонецФункции

Функция ПодготовитьБазу(Движок, ПараметрыПодключения, ПараметрыПлатформы)

	Результат = Новый Структура("ПараметрыПодключения, Временная", ПараметрыПодключения, Ложь);

	Если ПараметрыПодключения <> Неопределено
		И ЗначениеЗаполнено(ПараметрыПодключения.СтрокаПодключения) Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.ПараметрыПодключения = Движок.СоздатьВременнуюБазу(ПараметрыПлатформы);
	Результат.Временная = Истина;
	Лог.Отладка("Создана временная ИБ: %1", Результат.ПараметрыПодключения.КаталогБазы);

	Возврат Результат;

КонецФункции

Процедура ОчиститьВременнуюБазу(КонтекстБазы)

	Если НЕ КонтекстБазы.Временная Тогда
		Возврат;
	КонецЕсли;

	Лог.Отладка("Удаление временной ИБ: %1", КонтекстБазы.ПараметрыПодключения.КаталогБазы);
	Попытка
		УдалитьФайлы(КонтекстБазы.ПараметрыПодключения.КаталогБазы);
	Исключение
		Лог.Предупреждение("Не удалось удалить временную ИБ: %1", ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

#КонецОбласти
