// BSLLS:MissingVariablesDescription-off Поля autumn
// BSLLS:NumberOfOptionalParams-off
// BSLLS:Typo-off (&Лог/&Пластилин) и внутреннее состояние сервиса.
// Сервис работы с исходниками в формате 1С:EDT.
// Платформа 1С (Конфигуратор/ibcmd) не читает формат EDT напрямую - только XML-дамп
// Конфигуратора. Поэтому EDT экспортируется во временный XML-каталог (и наоборот) утилитой
// 1cedtcli, а затем XML подаётся в существующий пайплайн сервисов.
//
// Поиск установленной 1cedtcli делегируется библиотеке edtfind (класс ПоискEDT).
// Запуск 1cedtcli и поиск EDT вынесены за фабрики (_ФабрикаКоманды/_ФабрикаПоискаEDT),
// чтобы юнит-тесты могли подменить исполнение, не завися от реальной установки EDT.

#Использовать edtfind

&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисОкружения; // BSLLS:UnusedLocalVariable-off зарезервировано под будущие зависимости

// Фабрики для подмены в юнит-тестах (Неопределено => создаём реальные объекты).
Перем _ФабрикаКоманды;
Перем _ФабрикаПоискаEDT;

&Желудь
Процедура ПриСозданииОбъекта()
	_ФабрикаКоманды = Неопределено;
	_ФабрикаПоискаEDT = Неопределено;
КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Определить формат каталога исходников по маркерам на диске.
//
// Параметры:
//   Путь - Строка - путь к каталогу исходников
//
// Возвращаемое значение:
//   Строка - "edt" | "xml"
//
Функция ОпределитьФорматИсточника(Знач Путь) Экспорт

	Если ЭтоКаталогEDT(Путь) Тогда
		Возврат "edt";
	КонецЕсли;

	Если ЭтоКаталогXML(Путь) Тогда
		Возврат "xml";
	КонецЕсли;

	ВложенныеПроекты = ВложенныеПроектыEDT(Путь);
	Если ВложенныеПроекты.Количество() = 1 Тогда
		Возврат "edt";
	ИначеЕсли ВложенныеПроекты.Количество() > 1 Тогда
		ВызватьИсключение СтрШаблон(
			"В каталоге %1 найдено несколько EDT-проектов. Укажите путь к конкретному проекту"
			+ " или формат опцией --src-format.", Путь);
	КонецЕсли;

	Возврат "xml";

КонецФункции

// Подготовить XML-исходники для подачи в платформу.
// Если формат (форсированный опцией или определённый автоматически) = EDT,
// экспортирует EDT во временный XML-каталог через 1cedtcli.
//
// Параметры:
//   ПутьИсточника      - Строка    - каталог исходников (EDT или XML)
//   ПараметрыИсходников - Структура - {Формат, Версия, Workspace}; Неопределено => XML как есть
//
// Возвращаемое значение:
//   Структура - {Путь, Временный}: путь к XML-исходникам и признак временного каталога
//
Функция ПодготовитьXML(Знач ПутьИсточника, Знач ПараметрыИсходников = Неопределено) Экспорт

	Формат = РазрешитьФорматВвода(ПутьИсточника, ПараметрыИсходников);
	Если Формат <> "edt" Тогда
		Возврат Новый Структура("Путь, Временный", ПутьИсточника, Ложь);
	КонецЕсли;

	КаталогEDT = ОпределитьКорневойКаталогEDT(ПутьИсточника);
	ВременныйXML = ПолучитьИмяВременногоФайла();
	СоздатьКаталог(ВременныйXML);

	Лог.Информация("Конвертация EDT → XML: %1 → %2", КаталогEDT, ВременныйXML);
	Попытка
		ЭкспортироватьИзEDT(КаталогEDT, ВременныйXML, ПараметрыИсходников);
	Исключение
		УдалитьКаталогБезопасно(ВременныйXML);
		ВызватьИсключение;
	КонецПопытки;

	Возврат Новый Структура("Путь, Временный", ВременныйXML, Истина);

КонецФункции

// Завершить работу с подготовленными XML-исходниками (очистить временный каталог).
//
// Параметры:
//   Контекст - Структура - результат ПодготовитьXML
//
Процедура ЗавершитьXML(Знач Контекст) Экспорт

	Если Контекст <> Неопределено И Контекст.Временный Тогда
		УдалитьКаталогБезопасно(Контекст.Путь);
	КонецЕсли;

КонецПроцедуры

// Начать выгрузку исходников: вернуть каталог, в который сервис будет писать XML.
// Если целевой формат = EDT, возвращается временный XML-каталог (импорт в EDT выполнит
// ЗавершитьВыгрузку). Иначе сервис пишет напрямую в целевой каталог.
//
// Параметры:
//   ЦелевойКаталог      - Строка    - итоговый каталог исходников
//   ПараметрыИсходников - Структура - {Формат, ПутьКCli, Версия, Workspace}; Неопределено => XML
//
// Возвращаемое значение:
//   Структура - {Путь, ЦелевойКаталог, Временный, ПараметрыИсходников}
//
Функция НачатьВыгрузку(Знач ЦелевойКаталог, Знач ПараметрыИсходников = Неопределено) Экспорт

	Формат = РазрешитьФорматВывода(ЦелевойКаталог, ПараметрыИсходников);
	Если Формат <> "edt" Тогда
		Возврат Новый Структура("Путь, ЦелевойКаталог, Временный, ПараметрыИсходников",
			ЦелевойКаталог, ЦелевойКаталог, Ложь, ПараметрыИсходников);
	КонецЕсли;

	ВременныйXML = ПолучитьИмяВременногоФайла();
	СоздатьКаталог(ВременныйXML);

	Возврат Новый Структура("Путь, ЦелевойКаталог, Временный, ПараметрыИсходников",
		ВременныйXML, ЦелевойКаталог, Истина, ПараметрыИсходников);

КонецФункции

// Завершить выгрузку: при EDT-формате импортировать временный XML в целевой EDT-проект.
//
// Параметры:
//   Контекст - Структура - результат НачатьВыгрузку
//
Процедура ЗавершитьВыгрузку(Знач Контекст) Экспорт

	Если Контекст = Неопределено ИЛИ НЕ Контекст.Временный Тогда
		Возврат;
	КонецЕсли;

	Лог.Информация("Конвертация XML → EDT: %1 → %2", Контекст.Путь, Контекст.ЦелевойКаталог);
	Попытка
		ОбеспечитьКаталог(Контекст.ЦелевойКаталог);
		ИмпортироватьВEDT(Контекст.Путь, Контекст.ЦелевойКаталог, Контекст.ПараметрыИсходников);
	Исключение
		УдалитьКаталогБезопасно(Контекст.Путь);
		ВызватьИсключение;
	КонецПопытки;
	УдалитьКаталогБезопасно(Контекст.Путь);

КонецПроцедуры

// Проверить EDT-проект штатной проверкой 1С:EDT (команда validate утилиты 1cedtcli).
// Результаты валидации EDT выгружает в .tsv-файл, который здесь разбирается в массив замечаний.
//
// Параметры:
//   ПутьИсточника       - Строка    - каталог EDT-проекта (или каталог с единственным вложенным проектом)
//   ПараметрыИсходников - Структура - {Версия, Workspace}; Неопределено допустимо
//
// Возвращаемое значение:
//   Массив из Структура - замечания с полями
//     Дата, Важность, Категория, Проект, Проверка, Объект, Место, Описание (значения - строки).
//
Функция Проверить(Знач ПутьИсточника, Знач ПараметрыИсходников = Неопределено) Экспорт

	КаталогEDT = ОпределитьКорневойКаталогEDT(ПутьИсточника);
	ПутьКCli = РазрешитьПутьКCli(ПараметрыИсходников);
	Workspace = СоздатьWorkspace(ПараметрыИсходников);
	ФайлРезультата = ПолучитьИмяВременногоФайла("tsv");

	Аргументы = Новый Массив;
	Аргументы.Добавить("-data");
	Аргументы.Добавить(Workspace);
	Аргументы.Добавить("-command");
	Аргументы.Добавить("validate");
	Аргументы.Добавить("--file");
	Аргументы.Добавить(ФайлРезультата);
	Аргументы.Добавить("--project-list");
	Аргументы.Добавить(КаталогEDT);
	ДополнитьВерсией(Аргументы, ПараметрыИсходников);

	Лог.Информация("Проверка EDT-проекта: %1", КаталогEDT);
	Попытка
		Результат = ВыполнитьCli(ПутьКCli, Аргументы);
	Исключение
		УдалитьКаталогБезопасно(Workspace);
		ВызватьИсключение;
	КонецПопытки;
	УдалитьКаталогБезопасно(Workspace);

	// 1cedtcli возвращает 0 даже при тихом сбое - проверяем результат по наличию .tsv-файла.
	Если НЕ Новый Файл(ФайлРезультата).Существует() Тогда
		ВызватьИсключение СтрШаблон(
			"Проверка EDT не создала файл результатов (%1)."
			+ " Код возврата 1cedtcli: %2.%3Вывод:%3%4",
			ФайлРезультата, Результат.КодВозврата, Символы.ПС, Результат.Вывод);
	КонецЕсли;

	Замечания = ПрочитатьЗамечанияTSV(ФайлРезультата);
	УдалитьКаталогБезопасно(ФайлРезультата);

	Возврат Замечания;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Разобрать .tsv-файл результатов проверки EDT в массив структур-замечаний.
Функция ПрочитатьЗамечанияTSV(Знач ПутьФайла)

	Замечания = Новый Массив;
	Чтение = Новый ЧтениеТекста(ПутьФайла, КодировкаТекста.UTF8);
	Попытка
		Строка = Чтение.ПрочитатьСтроку();
		Пока Строка <> Неопределено Цикл
			Если ЗначениеЗаполнено(СокрЛП(Строка)) Тогда
				Замечания.Добавить(РазобратьСтрокуTSV(Строка));
			КонецЕсли;
			Строка = Чтение.ПрочитатьСтроку();
		КонецЦикла;
	Исключение
		Чтение.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	Чтение.Закрыть();

	Возврат Замечания;

КонецФункции

// Разобрать строку .tsv в структуру замечания (8 колонок, разделитель - табуляция).
Функция РазобратьСтрокуTSV(Знач Строка)

	Поля = СтрРазделить(Строка, Символы.Таб, Истина);
	Возврат Новый Структура(
		"Дата, Важность, Категория, Проект, Проверка, Объект, Место, Описание",
		ПолеTSV(Поля, 0), ПолеTSV(Поля, 1), ПолеTSV(Поля, 2), ПолеTSV(Поля, 3),
		ПолеTSV(Поля, 4), ПолеTSV(Поля, 5), ПолеTSV(Поля, 6), ПолеTSV(Поля, 7));

КонецФункции

Функция ПолеTSV(Знач Поля, Знач Индекс)

	Если Индекс <= Поля.ВГраница() Тогда
		Возврат СокрЛП(Поля[Индекс]);
	КонецЕсли;
	Возврат "";

КонецФункции

// При явно указанном формате проверить, что каталог не противоречит ему очевидными маркерами
// другого формата - иначе выдать осмысленную ошибку вместо непонятного сбоя ниже по пайплайну.
Процедура ПроверитьСоответствиеФормата(Знач Путь, Знач Формат)

	Файл = Новый Файл(Путь);
	Если НЕ (Файл.Существует() И Файл.ЭтоКаталог()) Тогда
		// Несуществующий/некаталоговый путь - пусть разбираются другие проверки и сами команды.
		Возврат;
	КонецЕсли;

	// Только явно ошибочный случай: формат форсирован как edt, но каталог - очевидно XML-дамп
	// Конфигуратора без признаков EDT-проекта. Обратный случай (--src-format xml на EDT-каталоге)
	// трактуется как осознанный passthrough пользователя и ошибкой не считается.
	ЭтоEDT = ЭтоКаталогEDT(Путь) ИЛИ ВложенныеПроектыEDT(Путь).Количество() > 0;
	ЭтоXML = ЭтоКаталогXML(Путь);

	Если Формат = "edt" И ЭтоXML И НЕ ЭтоEDT Тогда
		ВызватьИсключение СтрШаблон(
			"Указан формат исходников ""edt"" (--src-format edt), но каталог %1 является XML-дампом"
			+ " Конфигуратора (найден Configuration.xml/ConfigDumpInfo.xml) и не содержит признаков"
			+ " EDT-проекта (нет .project). Уберите опцию --src-format (auto) или укажите --src-format xml.",
			Путь);
	КонецЕсли;

КонецПроцедуры

// Разрешить формат на вводе: явная опция edt/xml имеет приоритет, иначе автоопределение.
// ПараметрыИсходников = Неопределено - обратная совместимость: трактуем как XML без детекта.
Функция РазрешитьФорматВвода(Знач Путь, Знач ПараметрыИсходников)

	ЯвныйФормат = ИзвлечьФормат(ПараметрыИсходников);
	Если ЯвныйФормат = "edt" ИЛИ ЯвныйФормат = "xml" Тогда
		ПроверитьСоответствиеФормата(Путь, ЯвныйФормат);
		Возврат ЯвныйФормат;
	КонецЕсли;
	Если ЯвныйФормат = "" Тогда
		// Старые вызовы без ПараметрыИсходников - поведение как раньше (чистый XML).
		Возврат "xml";
	КонецЕсли;

	Возврат ОпределитьФорматИсточника(Путь);

КонецФункции

// Разрешить формат на выводе. auto определяется по существующей цели (если это EDT-проект),
// иначе XML - несуществующую цель определить нельзя.
Функция РазрешитьФорматВывода(Знач ЦелевойКаталог, Знач ПараметрыИсходников)

	ЯвныйФормат = ИзвлечьФормат(ПараметрыИсходников);
	Если ЯвныйФормат = "edt" Тогда
		Возврат "edt";
	ИначеЕсли ЯвныйФормат = "xml" ИЛИ ЯвныйФормат = "" Тогда
		Возврат "xml";
	КонецЕсли;

	Файл = Новый Файл(ЦелевойКаталог);
	Если Файл.Существует() И Файл.ЭтоКаталог() Тогда
		Возврат ОпределитьФорматИсточника(ЦелевойКаталог);
	КонецЕсли;

	Возврат "xml";

КонецФункции

// Извлечь значение формата из структуры параметров.
// Возвращает: "edt"|"xml"|"auto" если параметры заданы; "" если параметры не переданы.
Функция ИзвлечьФормат(Знач ПараметрыИсходников)

	Если ПараметрыИсходников = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Значение = "";
	ПараметрыИсходников.Свойство("Формат", Значение);
	Значение = НРег(СокрЛП(Строка(?(Значение = Неопределено, "", Значение))));
	Если Значение = "" Тогда
		Возврат "auto";
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Определить корневой каталог EDT-проекта: сам путь или единственный вложенный проект.
Функция ОпределитьКорневойКаталогEDT(Знач Путь)

	Если ЭтоКаталогEDT(Путь) Тогда
		Возврат Путь;
	КонецЕсли;

	ВложенныеПроекты = ВложенныеПроектыEDT(Путь);
	Если ВложенныеПроекты.Количество() = 1 Тогда
		Возврат ВложенныеПроекты[0];
	ИначеЕсли ВложенныеПроекты.Количество() > 1 Тогда
		ВызватьИсключение СтрШаблон(
			"В каталоге %1 найдено несколько EDT-проектов. Укажите путь к конкретному проекту.", Путь);
	КонецЕсли;

	// Формат форсирован как edt, но маркеры не найдены - пробуем работать с каталогом как есть.
	Возврат Путь;

КонецФункции

// Признак каталога EDT-проекта: наличие .project и исходников .mdo (или служебного DT-INF).
Функция ЭтоКаталогEDT(Знач Путь)

	ФайлКаталога = Новый Файл(Путь);
	Если НЕ (ФайлКаталога.Существует() И ФайлКаталога.ЭтоКаталог()) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если НЕ Новый Файл(ОбъединитьПути(Путь, ".project")).Существует() Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Новый Файл(ОбъединитьПути(Путь, "src", "Configuration", "Configuration.mdo")).Существует() Тогда
		Возврат Истина;
	КонецЕсли;
	Если Новый Файл(ОбъединитьПути(Путь, "DT-INF")).Существует() Тогда
		Возврат Истина;
	КонецЕсли;
	Если ЕстьФайлыПоМаске(ОбъединитьПути(Путь, "src"), "*.mdo") Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Признак каталога с XML-дампом Конфигуратора.
Функция ЭтоКаталогXML(Знач Путь)

	Если Новый Файл(ОбъединитьПути(Путь, "Configuration.xml")).Существует() Тогда
		Возврат Истина;
	КонецЕсли;
	Если Новый Файл(ОбъединитьПути(Путь, "ConfigDumpInfo.xml")).Существует() Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Найти EDT-проекты в непосредственных подкаталогах заданного каталога.
Функция ВложенныеПроектыEDT(Знач Путь)

	Результат = Новый Массив;
	ФайлКаталога = Новый Файл(Путь);
	Если НЕ (ФайлКаталога.Существует() И ФайлКаталога.ЭтоКаталог()) Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Подкаталог Из НайтиФайлы(Путь, "*", Ложь) Цикл
		Если Подкаталог.ЭтоКаталог() И ЭтоКаталогEDT(Подкаталог.ПолноеИмя) Тогда
			Результат.Добавить(Подкаталог.ПолноеИмя);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЕстьФайлыПоМаске(Знач Каталог, Знач Маска)

	ФайлКаталога = Новый Файл(Каталог);
	Если НЕ (ФайлКаталога.Существует() И ФайлКаталога.ЭтоКаталог()) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат НайтиФайлы(Каталог, Маска, Истина).Количество() > 0;

КонецФункции

// Экспорт EDT-проекта в XML-дамп Конфигуратора через 1cedtcli.
Процедура ЭкспортироватьИзEDT(Знач КаталогEDT, Знач КаталогXML, Знач ПараметрыИсходников)

	ПутьКCli = РазрешитьПутьКCli(ПараметрыИсходников);
	Workspace = СоздатьWorkspace(ПараметрыИсходников);

	Аргументы = Новый Массив;
	Аргументы.Добавить("-data");
	Аргументы.Добавить(Workspace);
	Аргументы.Добавить("-command");
	Аргументы.Добавить("export");
	Аргументы.Добавить("--project");
	Аргументы.Добавить(КаталогEDT);
	Аргументы.Добавить("--configuration-files");
	Аргументы.Добавить(КаталогXML);
	ДополнитьВерсией(Аргументы, ПараметрыИсходников);

	Попытка
		Результат = ВыполнитьCli(ПутьКCli, Аргументы);
	Исключение
		УдалитьКаталогБезопасно(Workspace);
		ВызватьИсключение;
	КонецПопытки;
	УдалитьКаталогБезопасно(Workspace);

	// 1cedtcli возвращает 0 даже при тихом сбое - проверяем результат по наличию исходников.
	Если НЕ Новый Файл(ОбъединитьПути(КаталогXML, "Configuration.xml")).Существует() Тогда
		ВызватьИсключение СтрШаблон(
			"Экспорт EDT не создал XML-исходники (нет Configuration.xml в %1)."
			+ " Код возврата 1cedtcli: %2.%3Вывод:%3%4",
			КаталогXML, Результат.КодВозврата, Символы.ПС, Результат.Вывод);
	КонецЕсли;

КонецПроцедуры

// Импорт XML-дампа Конфигуратора в EDT-проект через 1cedtcli.
Процедура ИмпортироватьВEDT(Знач КаталогXML, Знач КаталогEDT, Знач ПараметрыИсходников)

	ПутьКCli = РазрешитьПутьКCli(ПараметрыИсходников);
	Workspace = СоздатьWorkspace(ПараметрыИсходников);

	Аргументы = Новый Массив;
	Аргументы.Добавить("-data");
	Аргументы.Добавить(Workspace);
	Аргументы.Добавить("-command");
	Аргументы.Добавить("import");
	Аргументы.Добавить("--configuration-files");
	Аргументы.Добавить(КаталогXML);
	Аргументы.Добавить("--project");
	Аргументы.Добавить(КаталогEDT);
	ДополнитьВерсией(Аргументы, ПараметрыИсходников);

	Попытка
		Результат = ВыполнитьCli(ПутьКCli, Аргументы);
	Исключение
		УдалитьКаталогБезопасно(Workspace);
		ВызватьИсключение;
	КонецПопытки;
	УдалитьКаталогБезопасно(Workspace);

	Если НЕ Новый Файл(ОбъединитьПути(КаталогEDT, ".project")).Существует() Тогда
		ВызватьИсключение СтрШаблон(
			"Импорт в EDT не создал проект (нет .project в %1)."
			+ " Код возврата 1cedtcli: %2.%3Вывод:%3%4",
			КаталогEDT, Результат.КодВозврата, Символы.ПС, Результат.Вывод);
	КонецЕсли;

КонецПроцедуры

Процедура ДополнитьВерсией(Аргументы, Знач ПараметрыИсходников)

	Версия = ПолучитьВерсию(ПараметрыИсходников);
	Если ЗначениеЗаполнено(Версия) Тогда
		Аргументы.Добавить("--version");
		Аргументы.Добавить(Версия);
	КонецЕсли;

КонецПроцедуры

Функция ВыполнитьCli(Знач ПутьКФайлу, Знач Аргументы)

	Команда = СоздатьКоманду();
	Команда.УстановитьКоманду(ПутьКФайлу);
	Для Каждого Арг Из Аргументы Цикл
		Команда.ДобавитьПараметр(Арг);
	КонецЦикла;

	Лог.Отладка("Запуск 1cedtcli: %1 %2", ПутьКФайлу, СтрСоединить(Аргументы, " "));
	КодВозврата = Команда.Исполнить();
	Вывод = Команда.ПолучитьВывод();
	Лог.Отладка("1cedtcli завершён, код возврата: %1", КодВозврата);

	Возврат Новый Структура("КодВозврата, Вывод", КодВозврата, Вывод);

КонецФункции

// Разрешить путь к 1cedtcli: edtfind (по версии --edt-version) -> PATH.
Функция РазрешитьПутьКCli(Знач ПараметрыИсходников)

	ПутьЧерезEdtfind = НайтиЧерезEdtfind(ПараметрыИсходников);
	Если ЗначениеЗаполнено(ПутьЧерезEdtfind) Тогда
		Лог.Отладка("1cedtcli (edtfind): %1", ПутьЧерезEdtfind);
		Возврат ПутьЧерезEdtfind;
	КонецЕсли;

	ПутьВPATH = НайтиВPATH();
	Если ЗначениеЗаполнено(ПутьВPATH) Тогда
		Лог.Отладка("1cedtcli (PATH): %1", ПутьВPATH);
		Возврат ПутьВPATH;
	КонецЕсли;

	ВызватьИсключение
		"Не удалось найти 1cedtcli. Укажите версию --edt-version (VRUNNER_EDT_VERSION)"
		+ " или установите 1С:EDT.";

КонецФункции

Функция НайтиЧерезEdtfind(Знач ПараметрыИсходников)

	Версия = ПолучитьВерсию(ПараметрыИсходников);

	Попытка
		Поиск = СоздатьПоискEDT();
		Информация = Поиск.НайтиИнформациюОEDT(Версия);
	Исключение
		Лог.Отладка("edtfind не нашёл установленную EDT: %1", ОписаниеОшибки());
		Возврат "";
	КонецПопытки;

	ПутьКcli = "";
	Информация.Свойство("ПутьКcli", ПутьКcli);
	ПутьКcli = СокрЛП(Строка(?(ПутьКcli = Неопределено, "", ПутьКcli)));

	Если ЗначениеЗаполнено(ПутьКcli) И Новый Файл(ПутьКcli).Существует() Тогда
		Возврат ПутьКcli;
	КонецЕсли;

	Лог.Предупреждение("edtfind нашёл установку EDT, но 1cedtcli не найден");
	Возврат "";

КонецФункции

Функция НайтиВPATH()

	Если ЭтоWindows() Тогда
		Кмд = СоздатьКоманду();
		Кмд.УстановитьКоманду("where");
		Кмд.ДобавитьПараметр(ИмяБинаряEDT());
		Если Кмд.Исполнить() = 0 Тогда
			Возврат СокрЛП(СтрРазделить(Кмд.ПолучитьВывод(), Символы.ПС)[0]);
		КонецЕсли;
	Иначе
		Кмд = СоздатьКоманду();
		Кмд.УстановитьКоманду("which");
		Кмд.ДобавитьПараметр(ИмяБинаряEDT());
		Если Кмд.Исполнить() = 0 Тогда
			Возврат СокрЛП(СтрРазделить(Кмд.ПолучитьВывод(), Символы.ПС)[0]);
		КонецЕсли;
	КонецЕсли;

	Возврат "";

КонецФункции

Функция СоздатьWorkspace(Знач ПараметрыИсходников)

	БазовыйКаталог = ПолучитьСвойствоСтрока(ПараметрыИсходников, "Workspace");
	Если ЗначениеЗаполнено(БазовыйКаталог) Тогда
		Workspace = ОбъединитьПути(БазовыйКаталог,
			"ws_" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", ""));
	Иначе
		Workspace = ПолучитьИмяВременногоФайла();
	КонецЕсли;
	СоздатьКаталог(Workspace);

	Возврат Workspace;

КонецФункции

Функция ПолучитьВерсию(Знач ПараметрыИсходников)
	Возврат ПолучитьСвойствоСтрока(ПараметрыИсходников, "Версия");
КонецФункции

Функция ПолучитьСвойствоСтрока(Знач Структура, Знач ИмяСвойства)

	Если Структура = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Значение = "";
	Структура.Свойство(ИмяСвойства, Значение);
	Возврат СокрЛП(Строка(?(Значение = Неопределено, "", Значение)));

КонецФункции

Функция ИмяБинаряEDT()
	Возврат "1cedtcli" + ?(ЭтоWindows(), ".exe", "");
КонецФункции

Функция ЭтоWindows()
	СисИнфо = Новый СистемнаяИнформация;
	Возврат СтрНачинаетсяС(Строка(СисИнфо.ТипПлатформы), "Windows");
КонецФункции

Процедура ОбеспечитьКаталог(Знач Путь)
	Если НЕ Новый Файл(Путь).Существует() Тогда
		СоздатьКаталог(Путь);
	КонецЕсли;
КонецПроцедуры

Процедура УдалитьКаталогБезопасно(Знач Путь)

	Если НЕ ЗначениеЗаполнено(Путь) Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Если Новый Файл(Путь).Существует() Тогда
			УдалитьФайлы(Путь);
		КонецЕсли;
	Исключение
		Лог.Предупреждение("Не удалось удалить временный каталог %1: %2", Путь, ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

Функция СоздатьКоманду()
	Если _ФабрикаКоманды <> Неопределено Тогда
		Возврат _ФабрикаКоманды.Создать();
	КонецЕсли;
	Возврат Новый Команда;
КонецФункции

Функция СоздатьПоискEDT()
	Если _ФабрикаПоискаEDT <> Неопределено Тогда
		Возврат _ФабрикаПоискаEDT.Создать();
	КонецЕсли;
	Возврат Новый ПоискEDT;
КонецФункции

#КонецОбласти
