// BSLLS:MissingVariablesDescription-off Поля autumn (&Лог/&Пластилин) и внутреннее состояние сервиса.
// BSLLS:NumberOfOptionalParams-off
// BSLLS:Typo-off
// BSLLS:LatinAndCyrillicSymbolInWord-off Технические идентификаторы EDT/Cli/XML/TSV.
// BSLLS:MissingParameterDescription-off Внутренние служебные методы сервиса.
// BSLLS:MissingReturnedValueDescription-off Внутренние служебные методы сервиса.
// BSLLS:NumberOfValuesInStructureConstructor-off Контекстные структуры и строка .tsv (8 колонок).
// BSLLS:MissingTemporaryFileDeletion-off Удаляются в парных методах/УдалитьКаталогБезопасно.
// BSLLS:DuplicateStringLiteral-off Литералы ключей 1cedtcli ("-data", "--project" и т.п.).
// BSLLS:MagicNumber-off Индексы колонок .tsv (0..7).
// Сервис работы с исходниками в формате 1С:EDT.
// Платформа 1С (Конфигуратор/ibcmd) не читает формат EDT напрямую - только XML-дамп
// Конфигуратора. Поэтому EDT экспортируется во временный XML-каталог (и наоборот) утилитой
// 1cedtcli, а затем XML подаётся в существующий пайплайн сервисов.
//
// Поиск установленной 1cedtcli делегируется библиотеке edtfind (класс ПоискEDT).
// Запуск 1cedtcli и поиск EDT вынесены за фабрики (_ФабрикаКоманды/_ФабрикаПоискаEDT),
// чтобы юнит-тесты могли подменить исполнение, не завися от реальной установки EDT.

#Использовать edtfind
#Использовать tempfiles

&Лог("vrunner")
Перем Лог;

&Пластилин
Перем ФайловыеОперации;

&Пластилин
Перем СервисОкружения;

&Пластилин
Перем СервисПоискаИсточников;

// Фабрики для подмены в юнит-тестах (Неопределено => создаём реальные объекты).
Перем _ФабрикаКоманды;
Перем _ФабрикаПоискаEDT;

&Желудь
Процедура ПриСозданииОбъекта()
	_ФабрикаКоманды = Неопределено;
	_ФабрикаПоискаEDT = Неопределено;
КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Определить формат каталога исходников по маркерам на диске.
// Каталог без распознаваемых маркеров трактуется как XML.
//
// Параметры:
//   Путь - Строка - путь к каталогу исходников
//
// Возвращаемое значение:
//   Строка - "edt" | "xml"
//
Функция ОпределитьФорматИсточника(Знач Путь) Экспорт

	Возврат ?(СервисПоискаИсточников.Описать(Путь).Вид = ФорматEDT(), ФорматEDT(), ФорматXML());

КонецФункции

// Тип внешнего объекта Конфигуратора по корневому тегу XML-файла.
//
// Параметры:
//   ПутьКФайлу - Строка - путь к XML-файлу
//
// Возвращаемое значение:
//   Строка - "epf" (ExternalDataProcessor), "erf" (ExternalReport)
//     или "" - если файл не является корневым XML внешнего объекта
//
Функция ТипВнешнегоОбъекта(Знач ПутьКФайлу) Экспорт

	ЧтениеТекста = Новый ЧтениеТекста(ПутьКФайлу);
	Содержимое = ЧтениеТекста.Прочитать();
	ЧтениеТекста.Закрыть();

	СодержимоеВРег = ВРег(Содержимое);
	Если СтрНайти(СодержимоеВРег, "<EXTERNALDATAPROCESSOR UUID=") > 0 Тогда
		Возврат "epf";
	КонецЕсли;
	Если СтрНайти(СодержимоеВРег, "<EXTERNALREPORT UUID=") > 0 Тогда
		Возврат "erf";
	КонецЕсли;

	Возврат "";

КонецФункции

// Тип внешнего объекта, выгруженного 1С:EDT (export): по корневому тегу, а если он
// не распознан - по каталогу раскладки export (ExternalDataProcessors/ или ExternalReports/).
//
// Параметры:
//   ПутьКФайлу - Строка - путь к корневому XML внешнего объекта в каталоге выгрузки
//
// Возвращаемое значение:
//   Строка - "epf" или "erf"
//
Функция ТипВыгруженногоВнешнегоОбъекта(Знач ПутьКФайлу) Экспорт

	Тип = ТипВнешнегоОбъекта(ПутьКФайлу);
	Если ЗначениеЗаполнено(Тип) Тогда
		Возврат Тип;
	КонецЕсли;

	КаталогОбъекта = УбратьЗавершающийРазделитель(Новый Файл(ПутьКФайлу).Путь);
	Возврат ?(ВРег(Новый Файл(КаталогОбъекта).Имя) = "EXTERNALREPORTS", "erf", "epf");

КонецФункции

// Конвертировать каталог исходников в противоположный формат (EDT ⇄ XML).
// Тип исходников определяется автоматически (строго); результат пишется в каталог назначения
// в противоположном формате. Если тип определить не удалось - исключение.
//
// Параметры:
//   ПутьИсточника       - Строка    - каталог исходников (EDT или XML)
//   ПутьНазначения      - Строка    - каталог для результата конвертации
//   ПараметрыИсходников - Структура - {ПутьКCli, Версия, Workspace, Таймаут, VmАргументы}; Неопределено допустимо
//
// Возвращаемое значение:
//   Структура - {ИсходныйФормат, ЦелевойФормат}: определённый формат источника и формат результата
//
Функция Конвертировать(Знач ПутьИсточника, Знач ПутьНазначения, Знач ПараметрыИсходников = Неопределено) Экспорт

	Источник = ОписатьИсходникиСтрого(ПутьИсточника);
	ЭтоEDT = Источник.Вид = ФорматEDT();
	ВыполнитьКонвертацию(Источник.КорневойКаталог, Источник.Вид, ПутьНазначения, ПараметрыИсходников);

	Возврат Новый Структура("ИсходныйФормат, ЦелевойФормат", Источник.Вид, ?(ЭтоEDT, ФорматXML(), ФорматEDT()));

КонецФункции

// Обеспечить исходники в целевом формате: формат источника берётся из --src-format или
// определяется по маркерам; при несовпадении конвертируется 1cedtcli во временный каталог.
//
// Параметры:
//   ПутьИсточника       - Строка    - каталог исходников (EDT или XML)
//   ЦелевойФормат       - Строка    - "edt" | "xml"
//   ПараметрыИсходников - Структура - {Формат, ПутьКCli, Версия, Workspace, Таймаут, VmАргументы};
//                                     Неопределено => исходники уже в целевом формате: путь берётся как есть,
//                                     без чтения маркеров и разрешения вложенного EDT-проекта
//
// Возвращаемое значение:
//   Структура - {Путь, Временный, ЭтоEDT, КаталогEDT, ВременныйКаталог}:
//     Путь - исходники в целевом формате; ЭтоEDT, КаталогEDT - признак и корень исходного EDT-проекта
//
Функция ПодготовитьИсходники(Знач ПутьИсточника, Знач ЦелевойФормат, Знач ПараметрыИсходников = Неопределено) Экспорт

	ИсходныйФормат = ?(ПараметрыИсходников = Неопределено, ЦелевойФормат,
		РазрешитьФорматВвода(ПутьИсточника, ПараметрыИсходников));
	ЭтоEDT = ИсходныйФормат = ФорматEDT();
	Источник = ПутьИсточника;
	// Без параметров маркеры на диске не читаются: исходники считаются готовыми в целевом формате.
	Если ПараметрыИсходников <> Неопределено Тогда
		Описание = СервисПоискаИсточников.Описать(ПутьИсточника);
		Источник = ?(ЭтоEDT, Описание.КорневойКаталог, ПутьИсточника);
	КонецЕсли;

	Контекст = Новый Структура("Путь, Временный, ЭтоEDT, КаталогEDT, ВременныйКаталог",
		Источник, Ложь, ЭтоEDT, ?(ЭтоEDT, Источник, ""), "");
	Если ИсходныйФормат = ЦелевойФормат Тогда
		Возврат Контекст;
	КонецЕсли;

	Если НЕ ЭтоEDT И Описание.Вид <> ФорматXML() Тогда
		ВызватьИсключение СтрШаблон(
			"В каталоге %1 нет XML-выгрузки Конфигуратора (Configuration.xml/ConfigDumpInfo.xml)."
			+ " Проверьте путь и опцию --src-format.", ПутьИсточника);
	КонецЕсли;

	// Имя EDT-проекта равно имени его каталога - временный проект называется как каталог исходников.
	Контекст.Временный = Истина;
	Контекст.ВременныйКаталог = ВременныеФайлы.НовоеИмяФайла();
	Контекст.Путь = ?(ЭтоEDT, Контекст.ВременныйКаталог, ОбъединитьПути(Контекст.ВременныйКаталог, Описание.Имя));
	Попытка
		ВыполнитьКонвертацию(Источник, ИсходныйФормат, Контекст.Путь, ПараметрыИсходников);
	Исключение
		ЗавершитьИсходники(Контекст);
		ВызватьИсключение;
	КонецПопытки;

	Возврат Контекст;

КонецФункции

// Завершить работу с исходниками из ПодготовитьИсходники: удалить временный каталог конвертации.
//
// Параметры:
//   Контекст - Структура - результат ПодготовитьИсходники
//
Процедура ЗавершитьИсходники(Знач Контекст) Экспорт

	Если Контекст <> Неопределено И Контекст.Временный Тогда
		УдалитьКаталогБезопасно(Контекст.ВременныйКаталог);
	КонецЕсли;

КонецПроцедуры

// Подготовить XML-исходники для подачи в платформу.
// Если формат (форсированный опцией или определённый автоматически) = EDT,
// экспортирует EDT во временный XML-каталог через 1cedtcli.
// Частный случай ПодготовитьИсходники с целевым форматом XML.
//
// Параметры:
//   ПутьИсточника      - Строка    - каталог исходников (EDT или XML)
//   ПараметрыИсходников - Структура - {Формат, ПутьКCli, Версия, Workspace, Таймаут, VmАргументы};
//                                     Неопределено => XML как есть
//
// Возвращаемое значение:
//   Структура - {Путь, Временный, ЭтоEDT, КаталогEDT}: путь к XML-исходникам, признак временного
//     каталога, признак исходного формата EDT и корневой каталог EDT-проекта (для EDT-инкремента)
//
Функция ПодготовитьXML(Знач ПутьИсточника, Знач ПараметрыИсходников = Неопределено) Экспорт

	Возврат ПодготовитьИсходники(ПутьИсточника, ФорматXML(), ПараметрыИсходников);

КонецФункции

// Завершить работу с подготовленными XML-исходниками (очистить временный каталог).
//
// Параметры:
//   Контекст - Структура - результат ПодготовитьXML
//
Процедура ЗавершитьXML(Знач Контекст) Экспорт

	ЗавершитьИсходники(Контекст);

КонецПроцедуры

// Начать выгрузку исходников: вернуть каталог, в который сервис будет писать XML.
// Если целевой формат = EDT, возвращается временный XML-каталог (импорт в EDT выполнит
// ЗавершитьВыгрузку). Иначе сервис пишет напрямую в целевой каталог.
//
// Параметры:
//   ЦелевойКаталог      - Строка    - итоговый каталог исходников
//   ПараметрыИсходников - Структура - {Формат, ПутьКCli, Версия, Workspace, Таймаут, VmАргументы}; Неопределено => XML
//
// Возвращаемое значение:
//   Структура - {Путь, ЦелевойКаталог, Временный, ПараметрыИсходников}
//
Функция НачатьВыгрузку(Знач ЦелевойКаталог, Знач ПараметрыИсходников = Неопределено) Экспорт

	Возврат НовыйКонтекстВыгрузки(ЦелевойКаталог, ПараметрыИсходников);

КонецФункции

// Завершить выгрузку: при EDT-формате импортировать временный XML в целевой EDT-проект.
//
// Параметры:
//   Контекст - Структура - результат НачатьВыгрузку
//
Процедура ЗавершитьВыгрузку(Знач Контекст) Экспорт

	Если Контекст = Неопределено ИЛИ НЕ Контекст.Временный Тогда
		Возврат;
	КонецЕсли;

	Лог.Информация("Конвертация XML → EDT: %1 → %2", Контекст.Путь, Контекст.ЦелевойКаталог);
	Попытка
		ФайловыеОперации.ОбеспечитьКаталог(Контекст.ЦелевойКаталог);
		ИмпортироватьВEDT(Контекст.Путь, Контекст.ЦелевойКаталог, Контекст.ПараметрыИсходников);
	Исключение
		УдалитьКаталогБезопасно(Контекст.Путь);
		ВызватьИсключение;
	КонецПопытки;
	УдалитьКаталогБезопасно(Контекст.Путь);
	Лог.Информация("✓ Конвертация XML → EDT завершена: %1", Контекст.ЦелевойКаталог);

КонецПроцедуры

// Прервать выгрузку без импорта в EDT: убрать временный XML-каталог, если он создавался.
// Вызывается из веток Исключение вместо ЗавершитьВыгрузку/ЗавершитьВыгрузкуВнешнихОбъектов.
//
// Параметры:
//   Контекст - Структура - результат НачатьВыгрузку или НачатьВыгрузкуВнешнихОбъектов
//
Процедура ПрерватьВыгрузку(Знач Контекст) Экспорт

	Если Контекст <> Неопределено И Контекст.Временный Тогда
		УдалитьКаталогБезопасно(Контекст.Путь);
	КонецЕсли;

КонецПроцедуры

// Выгрузить внешние отчёты и обработки из EDT-проекта в XML-исходники Конфигуратора.
// Выполняется штатным export 1cedtcli (без сборки .epf и временной информационной базы):
// 1С:EDT раскладывает объекты по подкаталогам ExternalDataProcessors/ и ExternalReports/
// каталога выгрузки - по одному корневому <Имя>.xml на объект (плюс подкаталог составных файлов).
//
// Параметры:
//   ПутьИсточника       - Строка    - каталог EDT-проекта внешних отчётов и обработок
//   КаталогВыгрузки     - Строка    - каталог для XML-исходников Конфигуратора
//   ПараметрыИсходников - Структура - {ПутьКCli, Версия, Workspace, Таймаут, VmАргументы}; Неопределено допустимо
//
// Возвращаемое значение:
//   Массив из Файл - корневые XML-файлы выгруженных внешних объектов
//
Функция ЭкспортироватьВнешниеОбъекты(Знач ПутьИсточника, Знач КаталогВыгрузки,
	Знач ПараметрыИсходников = Неопределено) Экспорт

	Источник = ОписатьИсходникиСтрого(ПутьИсточника);
	Если Источник.Вид <> ФорматEDT() Тогда
		ВызватьИсключение СтрШаблон("Каталог %1 не является проектом 1С:EDT", ПутьИсточника);
	КонецЕсли;

	КаталогEDT = Источник.КорневойКаталог;
	ФайловыеОперации.ОбеспечитьКаталог(КаталогВыгрузки);

	Лог.Информация("Экспорт внешних отчётов и обработок из EDT: %1 → %2", КаталогEDT, КаталогВыгрузки);
	Результат = ЗапуститьЭкспортEDT(КаталогEDT, КаталогВыгрузки, ПараметрыИсходников);

	// 1cedtcli возвращает 0 даже при тихом сбое - проверяем результат по факту наличия XML.
	Файлы = НайтиВыгруженныеВнешниеОбъекты(КаталогВыгрузки);
	Если Файлы.Количество() = 0 Тогда
		Описание = СтрШаблон(
			"Экспорт EDT не создал XML внешних объектов в %1 (нет ExternalDataProcessors/ExternalReports).",
			КаталогВыгрузки);
		ВызватьИсключение ТекстОшибкиПустогоРезультата(Описание, Результат);
	КонецЕсли;

	Лог.Информация("✓ EDT выгрузила внешних отчётов и обработок: %1", Файлы.Количество());
	Возврат Файлы;

КонецФункции

// Конвертировать внешние отчёты и обработки между форматами 1С:EDT и XML Конфигуратора.
// Направление определяется автоматически по каталогу источника:
//   EDT-проект внешних объектов        → выгрузка (export) в XML;
//   XML-дампы (ExternalDataProcessors/  → импорт (import) в EDT-проект.
//   ExternalReports/)
//
// Параметры:
//   ПутьИсточника       - Строка    - каталог источника (EDT-проект или XML-дампы)
//   ПутьНазначения      - Строка    - каталог результата в противоположном формате
//   ПараметрыИсходников - Структура - {ПутьКCli, Версия, Workspace, Таймаут, VmАргументы}; Неопределено допустимо
//
// Возвращаемое значение:
//   Структура - {ИсходныйФормат, ЦелевойФормат, Количество}: определённый формат источника,
//     формат результата ("edt"/"xml") и количество внешних объектов
//
Функция КонвертироватьВнешниеОбъекты(Знач ПутьИсточника, Знач ПутьНазначения,
	Знач ПараметрыИсходников = Неопределено) Экспорт

	Если ОпределитьНаправлениеВнешнихОбъектов(ПутьИсточника) = ФорматEDT() Тогда
		Файлы = ЭкспортироватьВнешниеОбъекты(ПутьИсточника, ПутьНазначения, ПараметрыИсходников);
		Возврат Новый Структура("ИсходныйФормат, ЦелевойФормат, Количество",
			ФорматEDT(), ФорматXML(), Файлы.Количество());
	КонецЕсли;

	Количество = ИмпортироватьВнешниеОбъекты(ПутьИсточника, ПутьНазначения, ПараметрыИсходников);
	Возврат Новый Структура("ИсходныйФормат, ЦелевойФормат, Количество", ФорматXML(), ФорматEDT(), Количество);

КонецФункции

// Признак того, что каталог исходников внешних объектов - проект 1С:EDT (с учётом
// форсированного формата --src-format). Используется epf compile для выбора: собирать
// напрямую из XML или предварительно выгрузить EDT-проект через 1cedtcli.
//
// Параметры:
//   Путь                - Строка    - каталог исходников внешних объектов
//   ПараметрыИсходников - Структура - {Формат, ...}; Неопределено => не EDT
//
// Возвращаемое значение:
//   Булево
//
Функция ЭтоПроектВнешнихОбъектовEDT(Знач Путь, Знач ПараметрыИсходников = Неопределено) Экспорт
	Возврат РазрешитьФорматВвода(Путь, ПараметрыИсходников) = ФорматEDT();
КонецФункции

// Начать выгрузку внешних объектов: вернуть каталог, в который писать XML.
// Если целевой формат = EDT, возвращается временный XML-каталог (импорт в EDT выполнит
// ЗавершитьВыгрузкуВнешнихОбъектов). Иначе XML пишется напрямую в целевой каталог.
//
// Параметры:
//   ЦелевойКаталог      - Строка    - итоговый каталог исходников/EDT-проекта
//   ПараметрыИсходников - Структура - {Формат, ПутьКCli, Версия, Workspace, Таймаут, VmАргументы}; Неопределено => XML
//
// Возвращаемое значение:
//   Структура - {Путь, ЦелевойКаталог, Временный, ПараметрыИсходников}
//
Функция НачатьВыгрузкуВнешнихОбъектов(Знач ЦелевойКаталог, Знач ПараметрыИсходников = Неопределено) Экспорт

	Возврат НовыйКонтекстВыгрузки(ЦелевойКаталог, ПараметрыИсходников);

КонецФункции

// Завершить выгрузку внешних объектов: при EDT-формате импортировать временный XML в EDT-проект.
//
// Параметры:
//   Контекст - Структура - результат НачатьВыгрузкуВнешнихОбъектов
//
Процедура ЗавершитьВыгрузкуВнешнихОбъектов(Знач Контекст) Экспорт

	Если Контекст = Неопределено ИЛИ НЕ Контекст.Временный Тогда
		Возврат;
	КонецЕсли;

	Лог.Информация("Конвертация XML → EDT: %1 → %2", Контекст.Путь, Контекст.ЦелевойКаталог);
	Попытка
		ФайловыеОперации.ОбеспечитьКаталог(Контекст.ЦелевойКаталог);
		ИмпортироватьВнешниеОбъекты(Контекст.Путь, Контекст.ЦелевойКаталог, Контекст.ПараметрыИсходников);
	Исключение
		УдалитьКаталогБезопасно(Контекст.Путь);
		ВызватьИсключение;
	КонецПопытки;
	УдалитьКаталогБезопасно(Контекст.Путь);
	Лог.Информация("✓ Конвертация XML → EDT завершена: %1", Контекст.ЦелевойКаталог);

КонецПроцедуры

// Проверить EDT-проект штатной проверкой 1С:EDT (команда validate утилиты 1cedtcli).
// Результаты валидации EDT выгружает в текстовый файл (TSV, по замечанию на строку),
// который здесь разбирается в массив замечаний.
//
// Параметры:
//   ПутьИсточника       - Строка    - каталог EDT-проекта (или каталог с единственным вложенным проектом)
//                                     либо XML-выгрузка Конфигуратора - конвертируется во временный EDT-проект
//   ПараметрыИсходников - Структура - {Формат, ПутьКCli, Версия, Workspace, Таймаут, VmАргументы};
//                                     Неопределено => путь проверяется как есть, без чтения маркеров
//                                     и разрешения вложенного проекта
//   ФайлОтчета          - Строка    - путь, по которому сохранить файл результатов проверки
//                                     в исходном формате 1С:EDT (как его пишет 1cedtcli validate --file);
//                                     пустая строка - результат читается из временного файла и удаляется
//
// Возвращаемое значение:
//   Массив из Структура - замечания с полями
//     Дата, Важность, Категория, Проект, Проверка, Объект, Место, Описание (значения - строки).
//
Функция Проверить(Знач ПутьИсточника, Знач ПараметрыИсходников = Неопределено, Знач ФайлОтчета = "") Экспорт

	Если ЗначениеЗаполнено(ФайлОтчета) Тогда
		ФайлОтчета = ПодготовитьФайлОтчета(ФайлОтчета);
	КонецЕсли;

	Контекст = ПодготовитьИсходники(ПутьИсточника, ФорматEDT(), ПараметрыИсходников);
	Попытка
		Если СервисПоискаИсточников.НайтиРасширения(Контекст.Путь).Количество() > 0 Тогда
			Лог.Предупреждение("Исходники расширения проверяются без проекта основной конфигурации:"
				+ " замечания по заимствованным объектам могут быть ложными.");
		КонецЕсли;
		Замечания = ПроверитьПроект(Контекст.Путь, ПараметрыИсходников, ФайлОтчета);
	Исключение
		ЗавершитьИсходники(Контекст);
		ВызватьИсключение;
	КонецПопытки;
	ЗавершитьИсходники(Контекст);

	Возврат Замечания;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Запустить 1cedtcli validate по каталогу EDT-проекта и разобрать .tsv с замечаниями.
// ФайлОтчета - путь после ПодготовитьФайлОтчета или пустая строка.
Функция ПроверитьПроект(Знач КаталогEDT, Знач ПараметрыИсходников, Знач ФайлОтчета)

	СохранятьОтчет = ЗначениеЗаполнено(ФайлОтчета);
	ФайлРезультата = ?(СохранятьОтчет, ФайлОтчета, ПолучитьИмяВременногоФайла("tsv"));

	Аргументы = Новый Массив;
	Аргументы.Добавить("--file");
	Аргументы.Добавить(ФайлРезультата);
	Аргументы.Добавить("--project-list");
	Аргументы.Добавить(КаталогEDT);

	Лог.Информация("Проверка EDT-проекта: %1", КаталогEDT);
	Результат = ВыполнитьКоманду1cedtcli("validate", Аргументы, ПараметрыИсходников);

	// 1cedtcli возвращает 0 даже при тихом сбое - проверяем результат по наличию .tsv-файла.
	Если НЕ Новый Файл(ФайлРезультата).Существует() Тогда
		Описание = СтрШаблон("Проверка EDT не создала файл результатов (%1).", ФайлРезультата);
		ВызватьИсключение ТекстОшибкиПустогоРезультата(Описание, Результат);
	КонецЕсли;

	Замечания = ПрочитатьЗамечанияTSV(ФайлРезультата);
	Если СохранятьОтчет Тогда
		Лог.Информация("Отчёт проверки EDT сохранён: %1", ФайлРезультата);
	Иначе
		УдалитьКаталогБезопасно(ФайлРезультата);
	КонецЕсли;

	Возврат Замечания;

КонецФункции

Функция ФорматEDT()
	Возврат "edt";
КонецФункции

Функция ФорматXML()
	Возврат "xml";
КонецФункции

// Описание каталога исходников для конвертации: путь обязан существовать и распознаваться как EDT или XML.
Функция ОписатьИсходникиСтрого(Знач Путь)

	Если НЕ ЭтоСуществующийКаталог(Путь) Тогда
		ВызватьИсключение СтрШаблон("Каталог исходников не найден: %1", Путь);
	КонецЕсли;

	Источник = СервисПоискаИсточников.Описать(Путь);
	Если Источник.Вид <> ФорматEDT() И Источник.Вид <> ФорматXML() Тогда
		ВызватьИсключение СтрШаблон(
			"Не удалось определить тип исходников в каталоге %1: не найдены маркеры ни 1С:EDT"
			+ " (.project и src/*.mdo), ни XML-дампа Конфигуратора (Configuration.xml/ConfigDumpInfo.xml).", Путь);
	КонецЕсли;

	Возврат Источник;

КонецФункции

// Контекст выгрузки: при целевом формате EDT XML пишется во временный каталог, иначе - в целевой.
Функция НовыйКонтекстВыгрузки(Знач ЦелевойКаталог, Знач ПараметрыИсходников)

	Формат = РазрешитьФорматВывода(ЦелевойКаталог, ПараметрыИсходников);
	Если Формат <> ФорматEDT() Тогда
		Возврат Новый Структура("Путь, ЦелевойКаталог, Временный, ПараметрыИсходников",
			ЦелевойКаталог, ЦелевойКаталог, Ложь, ПараметрыИсходников);
	КонецЕсли;

	ВременныйXML = ПолучитьИмяВременногоФайла();
	СоздатьКаталог(ВременныйXML);

	Возврат Новый Структура("Путь, ЦелевойКаталог, Временный, ПараметрыИсходников",
		ВременныйXML, ЦелевойКаталог, Истина, ПараметрыИсходников);

КонецФункции

// Текст ошибки для случая «1cedtcli вернул код 0, но ожидаемого результата нет».
Функция ТекстОшибкиПустогоРезультата(Знач Описание, Знач РезультатЗапуска)

	Возврат СтрШаблон("%1 Код возврата 1cedtcli: %2.%3Вывод:%3%4",
		Описание, РезультатЗапуска.КодВозврата, Символы.ПС, РезультатЗапуска.Вывод);

КонецФункции

// Подготовить путь файла отчёта проверки для 1cedtcli validate --file:
// создать каталог назначения и убрать файл от прошлого запуска
// (иначе устаревший отчёт был бы принят за результат текущей проверки).
Функция ПодготовитьФайлОтчета(Знач ФайлОтчета)

	Файл = Новый Файл(ФайлОтчета);
	ПолныйПуть = Файл.ПолноеИмя;

	ФайловыеОперации.ОбеспечитьКаталогДляФайла(ПолныйПуть);

	Если Файл.Существует() Тогда
		Если Файл.ЭтоКаталог() Тогда
			ВызватьИсключение СтрШаблон("Путь файла отчёта проверки EDT указывает на каталог: %1", ПолныйПуть);
		КонецЕсли;
		УдалитьФайлы(ПолныйПуть);
	КонецЕсли;

	Возврат ПолныйПуть;

КонецФункции

// Разобрать .tsv-файл результатов проверки EDT в массив структур-замечаний.
Функция ПрочитатьЗамечанияTSV(Знач ПутьФайла)

	Замечания = Новый Массив;
	Чтение = Новый ЧтениеТекста(ПутьФайла, КодировкаТекста.UTF8);
	Попытка
		СтрокаФайла = Чтение.ПрочитатьСтроку();
		Пока СтрокаФайла <> Неопределено Цикл
			Если ЗначениеЗаполнено(СокрЛП(СтрокаФайла)) Тогда
				Замечания.Добавить(РазобратьСтрокуTSV(СтрокаФайла));
			КонецЕсли;
			СтрокаФайла = Чтение.ПрочитатьСтроку();
		КонецЦикла;
	Исключение
		Чтение.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	Чтение.Закрыть();

	Возврат Замечания;

КонецФункции

// Разобрать строку .tsv в структуру замечания (8 колонок, разделитель - табуляция).
Функция РазобратьСтрокуTSV(Знач СтрокаФайла)

	Поля = СтрРазделить(СтрокаФайла, Символы.Таб, Истина);
	Возврат Новый Структура(
		"Дата, Важность, Категория, Проект, Проверка, Объект, Место, Описание",
		ПолеTSV(Поля, 0), ПолеTSV(Поля, 1), ПолеTSV(Поля, 2), ПолеTSV(Поля, 3),
		ПолеTSV(Поля, 4), ПолеTSV(Поля, 5), ПолеTSV(Поля, 6), ПолеTSV(Поля, 7));

КонецФункции

Функция ПолеTSV(Знач Поля, Знач Индекс)

	Если Индекс <= Поля.ВГраница() Тогда
		Возврат СокрЛП(Поля[Индекс]);
	КонецЕсли;
	Возврат "";

КонецФункции

// Формат форсирован как edt, а каталог - XML-дамп Конфигуратора: осмысленная ошибка вместо сбоя ниже
// по пайплайну. Обратный случай (--src-format xml на EDT-каталоге) - осознанный passthrough пользователя.
Процедура ПроверитьСоответствиеФормата(Знач Путь, Знач Формат)

	Если Формат = ФорматEDT() И СервисПоискаИсточников.Описать(Путь).Вид = ФорматXML() Тогда
		ВызватьИсключение СтрШаблон(
			"Указан формат исходников ""edt"" (--src-format edt), но каталог %1 является XML-дампом"
			+ " Конфигуратора (найден Configuration.xml/ConfigDumpInfo.xml) и не содержит признаков"
			+ " EDT-проекта (нет .project). Уберите опцию --src-format (auto) или укажите --src-format xml.",
			Путь);
	КонецЕсли;

КонецПроцедуры

// Разрешить формат на вводе: явная опция edt/xml имеет приоритет, иначе автоопределение.
// ПараметрыИсходников = Неопределено - обратная совместимость: трактуем как XML без детекта.
Функция РазрешитьФорматВвода(Знач Путь, Знач ПараметрыИсходников)

	ЯвныйФормат = ИзвлечьФормат(ПараметрыИсходников);
	Если ЯвныйФормат = ФорматEDT() ИЛИ ЯвныйФормат = ФорматXML() Тогда
		ПроверитьСоответствиеФормата(Путь, ЯвныйФормат);
		Возврат ЯвныйФормат;
	КонецЕсли;
	Если ЯвныйФормат = "" Тогда
		// Старые вызовы без ПараметрыИсходников - поведение как раньше (чистый XML).
		Возврат ФорматXML();
	КонецЕсли;

	Возврат ОпределитьФорматИсточника(Путь);

КонецФункции

// Разрешить формат на выводе. auto определяется по существующей цели (если это EDT-проект),
// иначе XML - несуществующую цель определить нельзя.
Функция РазрешитьФорматВывода(Знач ЦелевойКаталог, Знач ПараметрыИсходников)

	ЯвныйФормат = ИзвлечьФормат(ПараметрыИсходников);
	Если ЯвныйФормат = ФорматEDT() Тогда
		Возврат ФорматEDT();
	ИначеЕсли ЯвныйФормат = ФорматXML() ИЛИ ЯвныйФормат = "" Тогда
		Возврат ФорматXML();
	Иначе
		// auto - формат определяется по существующему целевому каталогу.
		Если ЭтоСуществующийКаталог(ЦелевойКаталог) Тогда
			Возврат ОпределитьФорматИсточника(ЦелевойКаталог);
		КонецЕсли;
		Возврат ФорматXML();
	КонецЕсли;

КонецФункции

// Извлечь значение формата из структуры параметров.
// Возвращает: "edt"|"xml"|"auto" если параметры заданы; "" если параметры не переданы.
Функция ИзвлечьФормат(Знач ПараметрыИсходников)

	Если ПараметрыИсходников = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Значение = ПолучитьСвойствоСтрока(ПараметрыИсходников, "Формат");
	Если Значение = "" Тогда
		Возврат "auto";
	КонецЕсли;

	Возврат НРег(Значение);

КонецФункции

Функция ЭтоСуществующийКаталог(Знач Путь)

	Файл = Новый Файл(Путь);
	Возврат Файл.Существует() И Файл.ЭтоКаталог();

КонецФункции

// Найти корневые XML выгруженных внешних объектов.
// 1С:EDT кладёт их в подкаталоги ExternalDataProcessors/ и ExternalReports/ каталога
// выгрузки; берём только корневые <Имя>.xml (без рекурсии по составным файлам объекта).
Функция НайтиВыгруженныеВнешниеОбъекты(Знач КаталогВыгрузки)

	Результат = Новый Массив;
	ТипыОбъектов = Новый Массив;
	ТипыОбъектов.Добавить("ExternalDataProcessors");
	ТипыОбъектов.Добавить("ExternalReports");

	Для Каждого ТипОбъекта Из ТипыОбъектов Цикл
		КаталогТипа = ОбъединитьПути(КаталогВыгрузки, ТипОбъекта);
		Если НЕ ЭтоСуществующийКаталог(КаталогТипа) Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого ФайлXml Из НайтиФайлы(КаталогТипа, "*.xml", Ложь) Цикл
			Результат.Добавить(ФайлXml);
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Определить направление конвертации внешних объектов по каталогу источника: "edt" | "xml".
Функция ОпределитьНаправлениеВнешнихОбъектов(Знач Путь)

	Если НЕ ЭтоСуществующийКаталог(Путь) Тогда
		ВызватьИсключение СтрШаблон("Каталог источника не найден: %1", Путь);
	КонецЕсли;

	Если СервисПоискаИсточников.Описать(Путь).Вид = ФорматEDT() Тогда
		Возврат ФорматEDT();
	КонецЕсли;

	Если НайтиКаталогиВнешнихXml(Путь).Количество() > 0 Тогда
		Возврат ФорматXML();
	КонецЕсли;

	ВызватьИсключение СтрШаблон(
		"Не удалось определить тип исходников внешних объектов в каталоге %1: не EDT-проект (нет .project)"
		+ " и нет XML-дампов внешних объектов (ExternalDataProcessor/ExternalReport).", Путь);

КонецФункции

// Найти каталоги, в корне которых лежит корневой XML внешнего объекта (ExternalDataProcessor/
// ExternalReport). Именно такой каталог подаётся на --configuration-files (1cedtcli читает
// <Имя>.xml из его корня). Поиск рекурсивный, каталоги дедуплицируются - работает с обеими
// раскладками: export (ExternalDataProcessors/<Имя>.xml) и разборки (<Имя>/<Имя>.xml).
Функция НайтиКаталогиВнешнихXml(Знач Путь)

	Результат = Новый Массив;
	Виденные = Новый Соответствие;

	Для Каждого ФайлXml Из НайтиФайлы(Путь, "*.xml", Истина) Цикл
		Если НЕ ЗначениеЗаполнено(ТипВнешнегоОбъекта(ФайлXml.ПолноеИмя)) Тогда
			Продолжить;
		КонецЕсли;
		// --configuration-files не должен получить хвостовой слэш.
		КаталогОбъекта = УбратьЗавершающийРазделитель(ФайлXml.Путь);
		Ключ = НРег(КаталогОбъекта);
		Если Виденные.Получить(Ключ) = Неопределено Тогда
			Виденные.Вставить(Ключ, Истина);
			Результат.Добавить(КаталогОбъекта);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Убрать завершающий разделитель пути (Файл.Путь возвращает каталог со слэшем на конце,
// из-за чего Файл.Имя такого пути - пустая строка вместо имени каталога).
Функция УбратьЗавершающийРазделитель(Знач Путь)

	Пока СтрДлина(Путь) > 1 И (Прав(Путь, 1) = "\" ИЛИ Прав(Путь, 1) = "/") Цикл
		Путь = Лев(Путь, СтрДлина(Путь) - 1);
	КонецЦикла;
	Возврат Путь;

КонецФункции

// Импортировать XML-дампы внешних объектов в EDT-проект.
// Каждый найденный каталог с корневыми <Имя>.xml импортируется отдельным вызовом import
// (аддитивно в один --project): 1cedtcli читает <Имя>.xml из корня каталога.
Функция ИмпортироватьВнешниеОбъекты(Знач ПутьИсточника, Знач ПутьНазначения, Знач ПараметрыИсходников)

	КаталогиИсходников = НайтиКаталогиВнешнихXml(ПутьИсточника);
	Если КаталогиИсходников.Количество() = 0 Тогда
		ВызватьИсключение СтрШаблон(
			"В каталоге %1 не найдены XML-дампы внешних объектов (файлы с ExternalDataProcessor/ExternalReport).",
			ПутьИсточника);
	КонецЕсли;

	Лог.Информация("Импорт внешних отчётов и обработок в EDT: %1 → %2", ПутьИсточника, ПутьНазначения);
	Количество = 0;
	Для Каждого КаталогОбъектов Из КаталогиИсходников Цикл
		ИмпортироватьВEDT(КаталогОбъектов, ПутьНазначения, ПараметрыИсходников);
		Количество = Количество + КоличествоВнешнихXml(КаталогОбъектов);
	КонецЦикла;
	Лог.Информация("✓ EDT импортировала внешних отчётов и обработок: %1", Количество);

	Возврат Количество;

КонецФункции

// Число корневых XML внешних объектов в каталоге (без рекурсии).
Функция КоличествоВнешнихXml(Знач Каталог)

	Количество = 0;
	Для Каждого ФайлXml Из НайтиФайлы(Каталог, "*.xml", Ложь) Цикл
		Если ЗначениеЗаполнено(ТипВнешнегоОбъекта(ФайлXml.ПолноеИмя)) Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Количество;

КонецФункции

// Конвертировать каталог исходников в противоположный формат через 1cedtcli.
Процедура ВыполнитьКонвертацию(Знач Источник, Знач ИсходныйФормат, Знач Назначение, Знач ПараметрыИсходников)

	ФайловыеОперации.ОбеспечитьКаталог(Назначение);
	Если ИсходныйФормат = ФорматEDT() Тогда
		Лог.Информация("Конвертация EDT → XML: %1 → %2", Источник, Назначение);
		ЭкспортироватьИзEDT(Источник, Назначение, ПараметрыИсходников);
	Иначе
		Лог.Информация("Конвертация XML → EDT: %1 → %2", Источник, Назначение);
		ИмпортироватьВEDT(Источник, Назначение, ПараметрыИсходников);
	КонецЕсли;
	Лог.Информация("✓ Конвертация завершена: %1", Назначение);

КонецПроцедуры

// Экспорт EDT-проекта в XML-дамп Конфигуратора через 1cedtcli.
Процедура ЭкспортироватьИзEDT(Знач КаталогEDT, Знач КаталогXML, Знач ПараметрыИсходников)

	Результат = ЗапуститьЭкспортEDT(КаталогEDT, КаталогXML, ПараметрыИсходников);

	// 1cedtcli возвращает 0 даже при тихом сбое - проверяем результат по наличию исходников.
	Если НЕ Новый Файл(ОбъединитьПути(КаталогXML, "Configuration.xml")).Существует() Тогда
		Описание = СтрШаблон("Экспорт EDT не создал XML-исходники (нет Configuration.xml в %1).", КаталогXML);
		ВызватьИсключение ТекстОшибкиПустогоРезультата(Описание, Результат);
	КонецЕсли;

КонецПроцедуры

// Запустить 1cedtcli export --project → --configuration-files.
// Проверку результата (наличие ожидаемых XML) выполняет вызывающий код.
Функция ЗапуститьЭкспортEDT(Знач КаталогEDT, Знач КаталогXML, Знач ПараметрыИсходников)

	Аргументы = Новый Массив;
	Аргументы.Добавить("--project");
	Аргументы.Добавить(КаталогEDT);
	Аргументы.Добавить("--configuration-files");
	Аргументы.Добавить(КаталогXML);

	Возврат ВыполнитьКоманду1cedtcli("export", Аргументы, ПараметрыИсходников);

КонецФункции

// Импорт XML-дампа Конфигуратора в EDT-проект через 1cedtcli.
Процедура ИмпортироватьВEDT(Знач КаталогXML, Знач КаталогEDT, Знач ПараметрыИсходников)

	Аргументы = Новый Массив;
	Аргументы.Добавить("--configuration-files");
	Аргументы.Добавить(КаталогXML);
	Аргументы.Добавить("--project");
	Аргументы.Добавить(КаталогEDT);

	Результат = ВыполнитьКоманду1cedtcli("import", Аргументы, ПараметрыИсходников);

	Если НЕ Новый Файл(ОбъединитьПути(КаталогEDT, ".project")).Существует() Тогда
		Описание = СтрШаблон("Импорт в EDT не создал проект (нет .project в %1).", КаталогEDT);
		ВызватьИсключение ТекстОшибкиПустогоРезультата(Описание, Результат);
	КонецЕсли;

КонецПроцедуры

// Запустить команду 1cedtcli в одноразовой рабочей области:
//   1cedtcli -data <workspace> [-timeout N] [-vmargs ...] -command <Команда> <ХвостАргументов>
// Рабочая область удаляется после запуска (в т.ч. при исключении).
Функция ВыполнитьКоманду1cedtcli(Знач Команда, Знач ХвостАргументов, Знач ПараметрыИсходников)

	ПутьКCli = РазрешитьПутьКCli(ПараметрыИсходников);
	Workspace = СоздатьWorkspace(ПараметрыИсходников);

	Аргументы = Новый Массив;
	Аргументы.Добавить("-data");
	Аргументы.Добавить(Workspace);
	ДополнитьТаймаутом(Аргументы, ПараметрыИсходников);
	ДополнитьVmАргументами(Аргументы, ПараметрыИсходников);
	Аргументы.Добавить("-command");
	Аргументы.Добавить(Команда);
	Для Каждого Аргумент Из ХвостАргументов Цикл
		Аргументы.Добавить(Аргумент);
	КонецЦикла;

	Попытка
		Результат = ВыполнитьCli(ПутьКCli, Аргументы);
	Исключение
		УдалитьКаталогБезопасно(Workspace);
		ВызватьИсключение;
	КонецПопытки;
	УдалитьКаталогБезопасно(Workspace);

	Возврат Результат;

КонецФункции

// Добавить глобальную опцию -timeout (сек) 1cedtcli, если задан таймаут.
// По соглашению 1cedtcli -timeout указывается до -command, поэтому вызывается
// сразу после -data/рабочей области.
Процедура ДополнитьТаймаутом(Аргументы, Знач ПараметрыИсходников)

	Таймаут = ПолучитьТаймаут(ПараметрыИсходников);
	Если ЗначениеЗаполнено(Таймаут) Тогда
		Аргументы.Добавить("-timeout");
		Аргументы.Добавить(Таймаут);
	КонецЕсли;

КонецПроцедуры

// Добавить JVM-аргументы запуска 1cedtcli (--edt-vmargs), если заданы.
// По документации 1C:EDT CLI опция -vmargs должна идти ПЕРЕД -command: всё, что
// между -vmargs и -command, трактуется как аргументы JVM. Поэтому метод вызывается
// после -data/-timeout и строго до добавления -command.
Процедура ДополнитьVmАргументами(Аргументы, Знач ПараметрыИсходников)

	СписокVmАргументов = НормализоватьVmАргументы(ПараметрыИсходников);
	Если СписокVmАргументов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Аргументы.Добавить("-vmargs");
	Для Каждого VmАргумент Из СписокVmАргументов Цикл
		Аргументы.Добавить(VmАргумент);
	КонецЦикла;

КонецПроцедуры

// Нормализовать --edt-vmargs к массиву отдельных JVM-токенов.
// Значение приходит массивом (&ТМассивСтрок: опцию можно указать несколько раз),
// но метод терпим и к строке (например из MCP) - элементы дополнительно дробятся по пробелу.
Функция НормализоватьVmАргументы(Знач ПараметрыИсходников)

	Результат = Новый Массив;
	Если ПараметрыИсходников = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Значение = Неопределено;
	ПараметрыИсходников.Свойство("VmАргументы", Значение);
	Если Значение = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Элементы = Значение;
	Иначе
		Элементы = Новый Массив;
		Элементы.Добавить(Строка(Значение));
	КонецЕсли;

	Для Каждого Элемент Из Элементы Цикл
		Для Каждого VmАргумент Из СтрРазделить(СокрЛП(Строка(Элемент)), " ", Ложь) Цикл
			Если ЗначениеЗаполнено(СокрЛП(VmАргумент)) Тогда
				Результат.Добавить(СокрЛП(VmАргумент));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ВыполнитьCli(Знач ПутьКФайлу, Знач Аргументы)

	Команда = СоздатьКоманду();
	Команда.УстановитьКоманду(ПутьКФайлу);
	Для Каждого Арг Из Аргументы Цикл
		Команда.ДобавитьПараметр(Арг);
	КонецЦикла;

	Лог.Отладка("Запуск 1cedtcli: %1 %2", ПутьКФайлу, СтрСоединить(Аргументы, " "));
	КодВозврата = Команда.Исполнить();
	Вывод = Команда.ПолучитьВывод();
	Лог.Отладка("1cedtcli завершён, код возврата: %1", КодВозврата);

	Возврат Новый Структура("КодВозврата, Вывод", КодВозврата, Вывод);

КонецФункции

// Разрешить путь к 1cedtcli. То, что задано явно, имеет приоритет над автопоиском:
//   1. явный путь (--edt-path / VRUNNER_EDT_PATH) - используется как есть, поиск не выполняется;
//   2. при заданной версии (--edt-version) - установка EDT этой версии (edtfind);
//   3. 1cedtcli в PATH;
//   4. максимальная установленная EDT (edtfind) - только если версия не задана.
Функция РазрешитьПутьКCli(Знач ПараметрыИсходников)

	ЯвныйПуть = ПолучитьСвойствоСтрока(ПараметрыИсходников, "ПутьКCli");
	Если ЗначениеЗаполнено(ЯвныйПуть) Тогда
		ПутьКCli = РазрешитьЯвныйПутьКCli(ЯвныйПуть);
		Лог.Отладка("1cedtcli (--edt-path): %1", ПутьКCli);
		Возврат ПутьКCli;
	КонецЕсли;

	Версия = ПолучитьСвойствоСтрока(ПараметрыИсходников, "Версия");
	Если ЗначениеЗаполнено(Версия) Тогда
		ПутьЧерезEdtfind = НайтиЧерезEdtfind(Версия);
		Если ЗначениеЗаполнено(ПутьЧерезEdtfind) Тогда
			Лог.Отладка("1cedtcli (edtfind, версия %1): %2", Версия, ПутьЧерезEdtfind);
			Возврат ПутьЧерезEdtfind;
		КонецЕсли;
		Лог.Предупреждение("Установленная 1С:EDT версии %1 не найдена - 1cedtcli будет взят из PATH", Версия);
	КонецЕсли;

	ПутьВPATH = НайтиВPATH();
	Если ЗначениеЗаполнено(ПутьВPATH) Тогда
		Лог.Отладка("1cedtcli (PATH): %1", ПутьВPATH);
		Возврат ПутьВPATH;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Версия) Тогда
		ПутьЧерезEdtfind = НайтиЧерезEdtfind("");
		Если ЗначениеЗаполнено(ПутьЧерезEdtfind) Тогда
			Лог.Отладка("1cedtcli (edtfind, максимальная версия): %1", ПутьЧерезEdtfind);
			Возврат ПутьЧерезEdtfind;
		КонецЕсли;
	КонецЕсли;

	ВызватьИсключение
		"Не удалось найти 1cedtcli. Укажите путь --edt-path (VRUNNER_EDT_PATH),"
		+ " версию установленной 1С:EDT --edt-version (VRUNNER_EDT_VERSION)"
		+ " или добавьте 1cedtcli в PATH.";

КонецФункции

// Явно заданный путь к 1cedtcli может указывать как на сам исполняемый файл,
// так и на каталог установки EDT (тогда исполняемый файл ищется в нём).
Функция РазрешитьЯвныйПутьКCli(Знач Путь)

	Файл = Новый Файл(Путь);
	Если НЕ Файл.Существует() Тогда
		ВызватьИсключение СтрШаблон("Указанный путь к 1cedtcli не найден: %1", Путь);
	КонецЕсли;

	Если НЕ Файл.ЭтоКаталог() Тогда
		Возврат Файл.ПолноеИмя;
	КонецЕсли;

	ПутьКCli = ОбъединитьПути(Файл.ПолноеИмя, ИмяБинаряEDT());
	Если НЕ Новый Файл(ПутьКCli).Существует() Тогда
		ВызватьИсключение СтрШаблон("В указанном каталоге EDT не найден %1: %2", ИмяБинаряEDT(), Файл.ПолноеИмя);
	КонецЕсли;

	Возврат ПутьКCli;

КонецФункции

Функция НайтиЧерезEdtfind(Знач Версия)

	Попытка
		Поиск = СоздатьПоискEDT();
		Информация = Поиск.НайтиИнформациюОEDT(Версия);
	Исключение
		Лог.Отладка("edtfind не нашёл установленную EDT: %1", ОписаниеОшибки());
		Возврат "";
	КонецПопытки;

	ПутьКCli = ПолучитьСвойствоСтрока(Информация, "ПутьКCli");
	Если ЗначениеЗаполнено(ПутьКCli) И Новый Файл(ПутьКCli).Существует() Тогда
		Возврат ПутьКCli;
	КонецЕсли;

	Лог.Предупреждение("edtfind нашёл установку EDT, но 1cedtcli не найден");
	Возврат "";

КонецФункции

Функция НайтиВPATH()
	Возврат СервисОкружения.НайтиВPATH(ИмяБинаряEDT());
КонецФункции

Функция СоздатьWorkspace(Знач ПараметрыИсходников)

	БазовыйКаталог = ПолучитьСвойствоСтрока(ПараметрыИсходников, "Workspace");
	Если ЗначениеЗаполнено(БазовыйКаталог) Тогда
		Workspace = ОбъединитьПути(БазовыйКаталог,
			"ws_" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", ""));
	Иначе
		Workspace = ПолучитьИмяВременногоФайла();
	КонецЕсли;
	СоздатьКаталог(Workspace);

	Возврат Workspace;

КонецФункции

// Таймаут 1cedtcli (сек) в виде строки-аргумента или "" если не задан.
// Значение может прийти числом (опция &ТЧисло), поэтому форматируется без
// группового разделителя - иначе Строка(5400) дала бы "5 400" с пробелом.
Функция ПолучитьТаймаут(Знач ПараметрыИсходников)

	Если ПараметрыИсходников = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Значение = Неопределено;
	ПараметрыИсходников.Свойство("Таймаут", Значение);
	Если Значение = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;

	Возврат Формат(Число(Значение), "ЧГ=0; ЧДЦ=0");

КонецФункции

// Строковое свойство структуры: "" если структуры нет, свойства нет или оно Неопределено.
Функция ПолучитьСвойствоСтрока(Знач Структура, Знач ИмяСвойства)

	Если Структура = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Значение = "";
	Структура.Свойство(ИмяСвойства, Значение);
	Возврат СокрЛП(Строка(?(Значение = Неопределено, "", Значение)));

КонецФункции

Функция ИмяБинаряEDT()
	Возврат СервисОкружения.ИмяИсполняемогоФайла("1cedtcli");
КонецФункции

Процедура УдалитьКаталогБезопасно(Знач Путь)

	Если НЕ ФайловыеОперации.УдалитьБезопасно(Путь) Тогда
		Лог.Предупреждение("Не удалось удалить временный каталог %1", Путь);
	КонецЕсли;

КонецПроцедуры

Функция СоздатьКоманду()
	Если _ФабрикаКоманды <> Неопределено Тогда
		Возврат _ФабрикаКоманды.Создать();
	КонецЕсли;
	Возврат Новый Команда;
КонецФункции

Функция СоздатьПоискEDT()
	Если _ФабрикаПоискаEDT <> Неопределено Тогда
		Возврат _ФабрикаПоискаEDT.Создать();
	КонецЕсли;
	Возврат Новый ПоискEDT;
КонецФункции

#КонецОбласти
