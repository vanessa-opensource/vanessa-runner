// BSLLS:UnusedLocalMethod-off ПриСозданииОбъекта вызывается рантаймом при Новый.
// BSLLS:NumberOfValuesInStructureConstructor-off Описание одного замечания - плоская структура.
// Разбор строк лога синтаксической проверки конфигуратора (/CheckConfig)
// и их группировка по объектам метаданных - опция --groupbymetadata.
//
// Конфигуратор пишет замечания в двух форматах:
//   {Обработка.Обработка1.Форма.Форма.Форма(12,3)}: Текст замечания
//   ОбщийМодуль.ОбщегоНазначения.Модуль Не обнаружено ссылок на функцию: "ВернутьЧисло"
// Первый - ошибки компиляции модуля, с позицией; второй - проверки вида
// UnreferenceProcedures, где позиции нет и объект идёт первым словом.
// У объектов расширения второму формату предшествует имя расширения:
//   ТестРасширения ОбщийМодуль.Расш1_Модуль1.Модуль Не обнаружено ссылок на процедуру: "..."
// Имя расширения остаётся частью группы - иначе одноимённые модули разных расширений
// слились бы в один тест-кейс.
// Строки, не подходящие ни под один формат (заголовки, итоги), попадают в группу
// по умолчанию.

Перем _ИмяГруппыПоУмолчанию; // Строка - группа для строк без привязки к объекту метаданных

Процедура ПриСозданииОбъекта(Знач ИмяГруппыПоУмолчанию = "Синтаксическая проверка конфигурации")

	_ИмяГруппыПоУмолчанию = ИмяГруппыПоУмолчанию;

КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Склеить строки замечания в одну.
//
// Конфигуратор печатает одно замечание двумя строками - заголовком с объектом
// метаданных и фрагментом кода с режимом проверки:
//   {Справочник.Справочник1.МодульОбъекта(4,1)}: Определения процедур должны идти...
//   <<?>>Процедура ПлохаяПроцедура() Экспорт (Проверка: Сервер)
// Дальше по конвейеру замечание должно быть одной строкой: иначе фильтр исключений
// не видит фрагмент кода, а в отчёт попадают два тест-кейса вместо одного.
//
// Параметры:
//   СтрокиЛога - Массив - Элементы <Строка>, строки лога проверки
//
// Возвращаемое значение:
//   Массив - Элементы <Строка>, по одной строке на замечание
//
Функция СклеитьПродолжения(Знач СтрокиЛога) Экспорт

	Результат = Новый Массив;

	Индекс = 0;
	Пока Индекс <= СтрокиЛога.ВГраница() Цикл

		Строка = СтрокиЛога[Индекс];
		Индекс = Индекс + 1;

		Если СтрНачинаетсяС(СокрЛП(Строка), "{") И НЕ ЭтоПродолжениеЗамечания(Строка)
			И Индекс <= СтрокиЛога.ВГраница() Тогда

			Следующая = СокрЛП(СтрокиЛога[Индекс]);
			Если ЭтоПродолжениеЗамечания(Следующая) Тогда
				Строка = Строка + РазделительПродолжения() + Следующая;
				Индекс = Индекс + 1;
			КонецЕсли;

		КонецЕсли;

		Результат.Добавить(Строка);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Сгруппировать строки замечаний по объектам метаданных.
// Порядок групп - по первому появлению объекта в логе.
// Ожидает строки после СклеитьПродолжения(): по одной на замечание.
//
// Параметры:
//   СтрокиЗамечаний - Массив - Элементы <Строка>, строки лога проверки
//
// Возвращаемое значение:
//   Массив - Элементы <Структура>:
//    * ИмяГруппы  - Строка - имя объекта метаданных либо имя группы по умолчанию
//    * Замечания  - Массив - Элементы <Структура> с полями Позиция, Текст, Исходный
//
Функция Сгруппировать(Знач СтрокиЗамечаний) Экспорт

	Группы = Новый Массив;
	Индекс = Новый Соответствие;

	Для Каждого СтрокаЗамечания Из СтрокиЗамечаний Цикл

		Замечание = Разобрать(СтрокаЗамечания);

		Группа = Индекс[Замечание.ИмяГруппы];
		Если Группа = Неопределено Тогда
			Группа = Новый Структура("ИмяГруппы, Замечания", Замечание.ИмяГруппы, Новый Массив);
			Индекс.Вставить(Замечание.ИмяГруппы, Группа);
			Группы.Добавить(Группа);
		КонецЕсли;

		Группа.Замечания.Добавить(Замечание);

	КонецЦикла;

	Возврат Группы;

КонецФункции

// Разобрать одну строку лога проверки.
//
// Параметры:
//   СтрокаЗамечания - Строка - строка лога проверки
//
// Возвращаемое значение:
//   Структура:
//    * ИмяГруппы - Строка - имя объекта метаданных либо имя группы по умолчанию
//    * Позиция   - Строка - позиция в модуле ("12,3"), пустая, если не указана
//    * Текст     - Строка - текст замечания без префикса объекта
//    * Исходный  - Строка - исходная строка лога
//
Функция Разобрать(Знач СтрокаЗамечания) Экспорт

	Результат = Новый Структура("ИмяГруппы, Позиция, Текст, Исходный",
		_ИмяГруппыПоУмолчанию, "", СокрЛП(СтрокаЗамечания), СтрокаЗамечания);

	НачалоЗаголовка = "{";
	КонецЗаголовка = "}";
	РазделительТекста = ":";
	НачалоПозиции = "(";
	КонецПозиции = ")";

	Текст = СокрЛП(СтрокаЗамечания);
	Если НЕ СтрНачинаетсяС(Текст, НачалоЗаголовка) Тогда
		ДополнитьПоПутиОбъекта(Результат, Текст);
		Возврат Результат;
	КонецЕсли;

	ПерваяПозицияЗаголовка = СтрДлина(НачалоЗаголовка) + 1;
	ПозицияКонцаЗаголовка = СтрНайти(Текст, КонецЗаголовка);
	Если ПозицияКонцаЗаголовка <= ПерваяПозицияЗаголовка Тогда
		Возврат Результат;
	КонецЕсли;

	Заголовок = Сред(Текст, ПерваяПозицияЗаголовка, ПозицияКонцаЗаголовка - ПерваяПозицияЗаголовка);

	Остаток = СокрЛП(Сред(Текст, ПозицияКонцаЗаголовка + СтрДлина(КонецЗаголовка)));
	Если СтрНачинаетсяС(Остаток, РазделительТекста) Тогда
		Остаток = СокрЛП(Сред(Остаток, СтрДлина(РазделительТекста) + 1));
	КонецЕсли;

	ИмяОбъекта = Заголовок;
	Позиция = "";

	ПозицияНачалаПозиции = СтрНайти(Заголовок, НачалоПозиции);
	Если ПозицияНачалаПозиции > 1 Тогда
		ИмяОбъекта = Лев(Заголовок, ПозицияНачалаПозиции - 1);
		ПозицияКонцаПозиции = СтрНайти(Заголовок, КонецПозиции);
		Если ПозицияКонцаПозиции > ПозицияНачалаПозиции Тогда
			ПерваяПозицияЗначения = ПозицияНачалаПозиции + СтрДлина(НачалоПозиции);
			Позиция = Сред(Заголовок, ПерваяПозицияЗначения, ПозицияКонцаПозиции - ПерваяПозицияЗначения);
		КонецЕсли;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(СокрЛП(ИмяОбъекта)) Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.ИмяГруппы = СокрЛП(ИмяОбъекта);
	Результат.Позиция = СокрЛП(Позиция);
	Результат.Текст = ?(ЗначениеЗаполнено(Остаток), Остаток, Текст);

	Возврат Результат;

КонецФункции

// Собрать текст всех замечаний группы для сообщения в отчёте.
//
// Параметры:
//   Группа - Структура - элемент результата Сгруппировать()
//
// Возвращаемое значение:
//   Строка - замечания по строке на каждое, с позицией в модуле, если она известна
//
Функция ТекстЗамечанийГруппы(Знач Группа) Экспорт

	Строки = Новый Массив;

	Для Каждого Замечание Из Группа.Замечания Цикл
		Если ЗначениеЗаполнено(Замечание.Позиция) Тогда
			Строки.Добавить(СтрШаблон("(%1): %2", Замечание.Позиция, Замечание.Текст));
		Иначе
			Строки.Добавить(Замечание.Текст);
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Разобрать строку второго формата:
//   "<ПутьОбъекта> <текст>"                   - объект конфигурации
//   "<ИмяРасширения> <ПутьОбъекта> <текст>"   - объект расширения
// Дальше второго слова не заглядываем: имя расширения - один идентификатор, а иначе
// за объект можно принять слово из текста замечания.
//
// Параметры:
//   Результат - Структура - описание замечания, дополняется ИмяГруппы и Текст
//   Текст     - Строка    - строка лога без ведущих пробелов
//
Процедура ДополнитьПоПутиОбъекта(Результат, Знач Текст)

	Первое = ПервоеСлово(Текст);
	Если НЕ ЗначениеЗаполнено(Первое) Тогда
		Возврат;
	КонецЕсли;

	ОстатокПослеПервого = СокрЛП(Сред(Текст, СтрДлина(Первое) + 1));

	Если ЭтоПутьОбъектаМетаданных(Первое) Тогда
		Результат.ИмяГруппы = Первое;
		Результат.Текст = ОстатокПослеПервого;
		Возврат;
	КонецЕсли;

	Второе = ПервоеСлово(ОстатокПослеПервого);
	Если НЕ ЗначениеЗаполнено(Второе) ИЛИ НЕ ЭтоПутьОбъектаМетаданных(Второе) Тогда
		Возврат;
	КонецЕсли;

	Результат.ИмяГруппы = Первое + " " + Второе;
	Результат.Текст = СокрЛП(Сред(ОстатокПослеПервого, СтрДлина(Второе) + 1));

КонецПроцедуры

// Первое слово строки - до ближайшего пробела.
//
// Параметры:
//   Текст - Строка - строка лога
//
// Возвращаемое значение:
//   Строка - первое слово; пустая строка, если пробела нет или строка начинается с него
//
Функция ПервоеСлово(Знач Текст)

	ПозицияПробела = СтрНайти(Текст, " ");
	Возврат ?(ПозицияПробела > 1, Лев(Текст, ПозицияПробела - 1), "");

КонецФункции

// Путь объекта метаданных - точки-разделители внутри слова: ОбщийМодуль.Хххх.Модуль.
// Двоеточие отсекает предложения ("Проверка конфигурации: ...").
//
// Параметры:
//   Значение - Строка - первое слово строки лога
//
// Возвращаемое значение:
//   Булево - Истина, если слово похоже на путь объекта метаданных
//
Функция ЭтоПутьОбъектаМетаданных(Знач Значение)

	ПозицияТочки = СтрНайти(Значение, ".");
	Возврат ПозицияТочки > 1 И ПозицияТочки < СтрДлина(Значение) И СтрНайти(Значение, ":") = 0;

КонецФункции

// Строка-продолжение - вторая строка замечания: фрагмент кода с режимом проверки
// в скобках, например "<<?>>Процедура ПлохаяПроцедура() Экспорт (Проверка: Сервер)".
//
// Параметры:
//   Строка - Строка - проверяемая строка лога
//
// Возвращаемое значение:
//   Булево - Истина, если строка является продолжением предыдущего замечания
//
Функция ЭтоПродолжениеЗамечания(Знач Строка)
	Возврат СтрНайти(Строка, " (Проверка") > 0;
КонецФункции

Функция РазделительПродолжения()
	Возврат " #> ";
КонецФункции

#КонецОбласти
