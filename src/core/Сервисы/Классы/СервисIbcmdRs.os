// BSLLS:MissingVariablesDescription-off Поля autumn (&Лог/&Деталька) и внутреннее состояние сервиса.
// BSLLS:LatinAndCyrillicSymbolInWord-off Технические идентификаторы (ibcmd-rs, HTTP, URL, GitHub).
// BSLLS:MissingParameterDescription-off Внутренние вспомогательные функции.
// BSLLS:MissingReturnedValueDescription-off Внутренние вспомогательные функции.
// BSLLS:MagicNumber-off Таймаут загрузки.
// BSLLS:LineLength-off Длинные значения по умолчанию (URL релиза) в аннотациях.
// Путь к ibcmd-rs: ibcmd-rs.home, иначе кеш релиза GitHub.

#Использовать tempfiles
#Использовать 1commands

&Лог("vrunner")
Перем Лог;

&Пластилин
Перем ФайловыеОперации;

&Пластилин
Перем СервисОкружения;

Перем _Версия;
Перем _БазовыйURL;
Перем _ДомашнийКаталог;
Перем _БазаУтилит;
Перем _ТаймаутЗагрузкиСек;

&Желудь
Процедура ПриСозданииОбъекта(
	&Деталька(Значение = "ibcmd-rs.version", ЗначениеПоУмолчанию = "0.4.0") Версия,
	&Деталька(Значение = "ibcmd-rs.base-url", ЗначениеПоУмолчанию = "https://github.com/Untru/ibcmd-rs/releases/download") БазовыйURL,
	&Деталька(Значение = "ibcmd-rs.home", ЗначениеПоУмолчанию = "") ДомашнийКаталог,
	&Деталька(Значение = "ibcmd-rs.tools-dir", ЗначениеПоУмолчанию = "") КаталогУтилит)

	_Версия = НормализоватьВерсию(Версия);
	_БазовыйURL = СокрЛП(Строка(БазовыйURL));
	_ДомашнийКаталог = СокрЛП(Строка(ДомашнийКаталог));
	_БазаУтилит = СокрЛП(Строка(КаталогУтилит));
	_ТаймаутЗагрузкиСек = 600;

КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Установлена ли утилита: задан существующий ibcmd-rs.home либо файл уже лежит в кеше.
//
// Возвращаемое значение:
//   Булево
//
Функция Установлена() Экспорт

	Если ЗначениеЗаполнено(_ДомашнийКаталог) Тогда
		Возврат ЗначениеЗаполнено(ПутьПоДомашнемуКаталогу(Ложь));
	КонецЕсли;

	Возврат ЗначениеЗаполнено(НайтиИсполняемыйФайл(КаталогВерсии()));

КонецФункции

// Путь к исполняемому файлу. Если его нет, скачивает релиз в кеш.
// При заданном ibcmd-rs.home ничего не скачивает и требует, чтобы файл уже был.
//
// Возвращаемое значение:
//   Строка - полный путь к ibcmd-rs или ibcmd-rs.exe
//
Функция ОбеспечитьУстановку() Экспорт

	Если ЗначениеЗаполнено(_ДомашнийКаталог) Тогда
		Возврат ПутьПоДомашнемуКаталогу(Истина);
	КонецЕсли;

	Найденный = НайтиИсполняемыйФайл(КаталогВерсии());
	Если ЗначениеЗаполнено(Найденный) Тогда
		Лог.Отладка("ibcmd-rs уже установлен: %1", Найденный);
		Возврат Найденный;
	КонецЕсли;

	УстановитьИзРелиза();
	Найденный = НайтиИсполняемыйФайл(КаталогВерсии());
	Если НЕ ЗначениеЗаполнено(Найденный) Тогда
		ВызватьИсключение СтрШаблон("После установки ibcmd-rs не найден в %1.", КаталогВерсии());
	КонецЕсли;

	Возврат Найденный;

КонецФункции

// Путь к ibcmd-rs для движка. При флаге --ibcmd-rs команды идут через ibcmd.
//
// Параметры:
//   Движок - ДвижокIbcmd - движок, которому передаётся путь к исполняемому файлу
//   ИспользоватьIbcmd - Булево - флаг --ibcmd
//   ИспользоватьIbcmdRs - Булево - флаг --ibcmd-rs
//
// Возвращаемое значение:
//   Булево - Истина, если команды нужно вести через движок ibcmd
//
Функция ПрименитьРежим(Знач Движок, Знач ИспользоватьIbcmd, Знач ИспользоватьIbcmdRs) Экспорт

	Штатный = ЭтоИстина(ИспользоватьIbcmd);
	Замена = ЭтоИстина(ИспользоватьIbcmdRs);

	Если Штатный И Замена Тогда
		ВызватьИсключение "Флаги --ibcmd и --ibcmd-rs вместе не используются.";
	КонецЕсли;

	Если Замена Тогда
		Путь = ОбеспечитьУстановку();
		Движок.ИспользоватьПриложение(Путь);
		Лог.Информация("Используется ibcmd-rs: %1", Путь);
		Возврат Истина;
	КонецЕсли;

	Движок.ИспользоватьПриложение("");

	Возврат Штатный;

КонецФункции

// Тройка цели релиза для строки типа платформы (Экспорт для юнит-тестов).
//
// Параметры:
//   ТипПлатформыСтрока - Строка - представление СистемнаяИнформация.ТипПлатформы
//
// Возвращаемое значение:
//   Строка - например x86_64-pc-windows-msvc
//
Функция ЦельСборки(Знач ТипПлатформыСтрока) Экспорт

	ИмяПлатформы = НРег(СокрЛП(ТипПлатформыСтрока));
	Если СтрНачинаетсяС(ИмяПлатформы, "windows") Тогда
		Цель = "x86_64-pc-windows-msvc";
	ИначеЕсли СтрНачинаетсяС(ИмяПлатформы, "linux") Тогда
		Цель = "x86_64-unknown-linux-gnu";
	Иначе
		ВызватьИсключение СтрШаблон(
			"ibcmd-rs не публикует сборку для платформы %1", ТипПлатформыСтрока);
	КонецЕсли;

	Если СтрНайти(ИмяПлатформы, "x86_64") = 0 И СтрНайти(ИмяПлатформы, "amd64") = 0 Тогда
		ВызватьИсключение СтрШаблон(
			"ibcmd-rs публикует сборки только для x86_64, текущая платформа: %1", ТипПлатформыСтрока);
	КонецЕсли;

	Возврат Цель;

КонецФункции

// Имя zip-архива релиза (Экспорт для юнит-тестов).
//
// Параметры:
//   ТипПлатформыСтрока - Строка - представление СистемнаяИнформация.ТипПлатформы
//
// Возвращаемое значение:
//   Строка - имя файла архива
//
Функция ИмяАрхиваДляПлатформы(Знач ТипПлатформыСтрока) Экспорт
	Возврат СтрШаблон("ibcmd-rs-%1-%2.zip", _Версия, ЦельСборки(ТипПлатформыСтрока));
КонецФункции

// Полный URL загрузки архива релиза для текущей ОС (Экспорт для юнит-тестов).
//
// Возвращаемое значение:
//   Строка - https://.../download/v<версия>/ibcmd-rs-<версия>-<цель>.zip
//
Функция URLЗагрузки() Экспорт
	Возврат Новый ЗагрузкаHTTP().АдресРелиза(_БазовыйURL, _Версия, ИмяАрхива());
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УстановитьИзРелиза()

	ИмяФайла = ИмяАрхива();
	URL = URLЗагрузки();
	КаталогВерсии = КаталогВерсии();

	// Возможная частичная установка от прерванного запуска - удаляем.
	Если Новый Файл(КаталогВерсии).Существует() Тогда
		Попытка
			УдалитьФайлы(КаталогВерсии);
		Исключение
			Лог.Отладка("Не удалось очистить каталог %1: %2", КаталогВерсии, ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;

	ФайловыеОперации.ОбеспечитьКаталог(КаталогВерсии);

	ВрКаталог = ВременныеФайлы.СоздатьКаталог();
	ФайлАрхива = ОбъединитьПути(ВрКаталог, ИмяФайла);

	Лог.Информация("Загрузка ibcmd-rs %1 (%2)...", _Версия, ИмяФайла);
	Попытка
		Загрузка = Новый ЗагрузкаHTTP();
		Загрузка.Скачать(URL, ФайлАрхива, _ТаймаутЗагрузкиСек, ФайловыеОперации);
		Лог.Отладка("Распаковка %1 -> %2", ФайлАрхива, КаталогВерсии);
		Загрузка.Распаковать(ФайлАрхива, КаталогВерсии);
	Исключение
		Ошибка = ОписаниеОшибки();
		ФайловыеОперации.УдалитьБезопасно(ВрКаталог);
		ВызватьИсключение ИнструкцияПоУстановке(Ошибка, URL);
	КонецПопытки;

	ФайловыеОперации.УдалитьБезопасно(ВрКаталог);

	Исполняемый = НайтиИсполняемыйФайл(КаталогВерсии);
	ПодготовитьПрава(Исполняемый);
	Лог.Информация("ibcmd-rs установлен: %1", Исполняемый);

КонецПроцедуры

Функция ИнструкцияПоУстановке(Знач Ошибка, Знач URL)

	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон("Не удалось установить ibcmd-rs: %1.", Ошибка));
	Строки.Добавить(СтрШаблон("Ручная установка: скачайте %1, распакуйте архив", URL));
	Строки.Добавить("и укажите файл ibcmd-rs (или каталог с ним) настройкой ibcmd-rs.home");
	Строки.Добавить(СтрШаблон("(либо положите распакованное в %1).", КаталогВерсии()));

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// На UNIX zip не сохраняет бит исполнения. Ошибка не фатальна: она всплывёт при запуске.
Процедура ПодготовитьПрава(Знач ПутьКФайлу)

	Если СервисОкружения.ЭтоWindows() ИЛИ НЕ ЗначениеЗаполнено(ПутьКФайлу) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		КомандаЗапуска = Новый Команда;
		КомандаЗапуска.УстановитьКоманду("chmod");
		КомандаЗапуска.ДобавитьПараметр("+x");
		КомандаЗапуска.ДобавитьПараметр(ПутьКФайлу);
		КомандаЗапуска.Исполнить();
	Исключение
		Лог.Предупреждение("Не удалось выставить права на исполнение ibcmd-rs: %1", ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Путь по настройке ibcmd-rs.home: сам файл либо исполняемый файл внутри каталога.
//
// Параметры:
//   Строго - Булево - Истина: отсутствие файла завершает работу исключением
//
// Возвращаемое значение:
//   Строка - полный путь; пустая строка, если файла нет и Строго = Ложь
//
Функция ПутьПоДомашнемуКаталогу(Знач Строго)

	Файл = Новый Файл(_ДомашнийКаталог);
	Если НЕ Файл.Существует() Тогда
		Если Строго Тогда
			ВызватьИсключение СтрШаблон(
				"Задан ibcmd-rs.home=%1, но такого файла или каталога нет.", _ДомашнийКаталог);
		КонецЕсли;

		Возврат "";
	КонецЕсли;

	Если НЕ Файл.ЭтоКаталог() Тогда
		Возврат Файл.ПолноеИмя;
	КонецЕсли;

	Найденный = НайтиИсполняемыйФайл(Файл.ПолноеИмя);
	Если НЕ ЗначениеЗаполнено(Найденный) И Строго Тогда
		ВызватьИсключение СтрШаблон(
			"Задан ibcmd-rs.home=%1, но в нём нет %2.", _ДомашнийКаталог, ИмяИсполняемогоФайла());
	КонецЕсли;

	Возврат Найденный;

КонецФункции

Функция НайтиИсполняемыйФайл(Знач Каталог)

	Если НЕ ЗначениеЗаполнено(Каталог) ИЛИ НЕ Новый Файл(Каталог).Существует() Тогда
		Возврат "";
	КонецЕсли;

	Имя = ИмяИсполняемогоФайла();
	Для Каждого Найденный Из НайтиФайлы(Каталог, Имя, Истина) Цикл
		Если НЕ Найденный.ЭтоКаталог() Тогда
			Возврат Найденный.ПолноеИмя;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция ИмяИсполняемогоФайла()
	Возврат СервисОкружения.ИмяИсполняемогоФайла("ibcmd-rs");
КонецФункции

Функция КаталогВерсии()
	Возврат ОбъединитьПути(БазаУтилит(), "ibcmd-rs", _Версия);
КонецФункции

Функция БазаУтилит()

	Если ЗначениеЗаполнено(_БазаУтилит) Тогда
		Возврат _БазаУтилит;
	КонецЕсли;

	Возврат ОбъединитьПути(КаталогВременныхФайлов(), "vanessa-runner", "tools");

КонецФункции

Функция ИмяАрхива()
	Возврат ИмяАрхиваДляПлатформы(СервисОкружения.ТипПлатформы());
КонецФункции

Функция НормализоватьВерсию(Знач Версия)

	Версия = СокрЛП(Строка(Версия));
	Если СтрНачинаетсяС(НРег(Версия), "v") И СтрДлина(Версия) > 1 Тогда
		Версия = Сред(Версия, 2);
	КонецЕсли;

	Возврат Версия;

КонецФункции

Функция ЭтоИстина(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;

	Текст = НРег(СокрЛП(Строка(Значение)));

	Возврат Текст = "true" ИЛИ Текст = "да" ИЛИ Текст = "1";

КонецФункции

#КонецОбласти
