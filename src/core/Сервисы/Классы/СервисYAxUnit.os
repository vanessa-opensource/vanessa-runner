// BSLLS:MissingVariablesDescription-off Поля autumn (&Лог/&Пластилин).
// BSLLS:LatinAndCyrillicSymbolInWord-off Идентификатор сервиса с латинской аббревиатурой (YAxUnit).
// BSLLS:NumberOfValuesInStructureConstructor-off Шаблон параметров тестов.
// BSLLS:Typo-off Доменные термины (Конфигу/YAxUnit).
// Сервис запуска модульных тестов YAxUnit (bia-technologies/yaxunit).
//
// YAxUnit запускается клиентом 1С:Предприятия с параметром /C "RunUnitTests=<config.json>".
// Сервис формирует конфигурационный файл запуска из опций командной строки и делегирует
// фактический запуск платформы в СервисПлатформы (что даёт бесплатно ibsrv и сбор покрытия).
//
// Если путь к отчёту не задан, отчёт jUnit формируется во временном файле - это позволяет
// запустить тесты с минимумом параметров (только строка подключения) и получить результат.
// После прогона сервис разбирает jUnit-отчёт и возвращает сводку (всего/успешно/провалено),
// по которой команда печатает короткое саммари и выставляет код возврата.
//
// Предполагается, что расширения YAxUnit и тестов уже загружены в ИБ (vrunner cfe load).

&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисПлатформы;

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Шаблон параметров запуска тестов YAxUnit.
//
// Возвращаемое значение:
//   Структура - все поля необязательны:
//     * ПутьКонфигу - Строка - путь к готовому yaxunit.json (если задан - используется как есть)
//     * Расширения - Строка - имена расширений с тестами через запятую (filter.extensions)
//     * Модули - Строка - имена модулей через запятую (filter.modules)
//     * Тесты - Строка - полные пути тестов через запятую (filter.tests)
//     * Теги - Строка - теги через запятую (filter.tags)
//     * Наборы - Строка - имена наборов через запятую (filter.suites)
//     * ПутьОтчета - Строка - путь к отчёту (reportPath)
//     * ФорматОтчета - Строка - формат отчёта (reportFormat), по умолчанию "jUnit"
//     * ПутьСтатуса - Строка - путь к файлу кода возврата 0/1 (exitCode)
//     * КаталогПроекта - Строка - корневой каталог проекта для зависимостей ФайлыПроекта (projectPath)
//     * КаталогWorkspace - Строка - рабочий каталог пространства YAxUnit (workspacePath)
//     * ЗакрыватьПослеТестов - Булево - закрывать 1С после тестов (closeAfterTests), по умолчанию Истина
//     * ПоказыватьОтчет - Булево - открывать форму отчёта (showReport), по умолчанию Ложь
//     * ЛогФайл - Строка - путь к файлу лога (logging.file)
//     * ЛогКонсоль - Булево - писать лог в консоль (logging.console)
//     * ЛогУровень - Строка - уровень лога (logging.level): debug/info/warning/error
//
Функция НовыеПараметрыТестов() Экспорт

	Возврат Новый Структура(
		"ПутьКонфигу, Расширения, Модули, Тесты, Теги, Наборы,"
		+ " ПутьОтчета, ФорматОтчета, ПутьСтатуса, КаталогПроекта, КаталогWorkspace,"
		+ " ЗакрыватьПослеТестов, ПоказыватьОтчет, ЛогФайл, ЛогКонсоль, ЛогУровень",
		"", "", "", "", "", "",
		"", "jUnit", "", "", "",
		Истина, Ложь, "", Ложь, "");

КонецФункции

// Запустить тесты YAxUnit.
// Готовит конфигурационный файл, формирует ключ /C "RunUnitTests=..." и делегирует
// запуск 1С:Предприятия в СервисПлатформы. Если путь к отчёту не задан - подставляет
// временный jUnit-файл. После прогона разбирает jUnit-отчёт и возвращает сводку.
//
// Параметры:
//   ПараметрыПодключения - Структура - параметры подключения к ИБ
//   ПараметрыТестов - Структура - параметры тестов (см. НовыеПараметрыТестов)
//   ПараметрыЗапуска - Структура - параметры запуска платформы; ключ КомандаЗапуска будет
//       перезаписан, остальные ключи (РежимЗапуска, НеОжидать, Покрытие и т.п.) сохраняются
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//
// Возвращаемое значение:
//   Структура - сводка результатов (см. НовыйРезультатТестов)
//
Функция ЗапуститьТесты(Знач ПараметрыПодключения, Знач ПараметрыТестов,
		Знач ПараметрыЗапуска, Знач ПараметрыПлатформы = Неопределено) Экспорт

	ЭффективныйПутьОтчета = ОбеспечитьПутьОтчета(ПараметрыТестов);
	ЭтоJUnit = ЭтоФорматJUnit(ПараметрыТестов);

	ПутьКонфига = ПодготовитьФайлНастроек(ПараметрыТестов);
	Лог.Информация("Запуск тестов YAxUnit, конфигурация: %1", ПутьКонфига);

	ПараметрыЗапуска.Вставить("КомандаЗапуска", СформироватьКлючЗапуска(ПутьКонфига));
	// YAxUnit пишет собственный файл exitCode (0/1), не xdd-формат статуса платформы.
	ПараметрыЗапуска.Вставить("ПутьКФайлуСтатуса", "");

	СервисПлатформы.ЗапуститьПредприятие(ПараметрыПодключения, ПараметрыЗапуска, ПараметрыПлатформы);

	Лог.Информация("Запуск тестов YAxUnit завершён");

	// Авто-разбор отчёта возможен только для jUnit и только если путь отчёта известен.
	Если ЗначениеЗаполнено(ЭффективныйПутьОтчета) И ЭтоJUnit Тогда
		Результат = РазобратьОтчетJUnit(ЭффективныйПутьОтчета);
	Иначе
		Результат = НовыйРезультатТестов();
	КонецЕсли;
	Результат.ПутьОтчета = ЭффективныйПутьОтчета;
	Результат.ФорматJUnit = ЭтоJUnit;
	Возврат Результат;

КонецФункции

// Шаблон сводки результатов прогона тестов.
//
// Возвращаемое значение:
//   Структура:
//     * Всего, Успешно, Провалено, Ошибок, Пропущено - Число - агрегаты по наборам отчёта
//     * Провалившиеся - Массив из Структур {Имя, Тип, Сообщение} - детали провалов/ошибок
//     * ЕстьОтчет - Булево - отчёт найден и разобран
//     * Успех - Булево - провалов и ошибок нет
//     * ФорматJUnit - Булево - отчёт в формате jUnit (для прочих авто-разбор не выполняется)
//     * ПутьОтчета - Строка - фактический путь сформированного отчёта
//
Функция НовыйРезультатТестов() Экспорт

	Возврат Новый Структура(
		"Всего, Успешно, Провалено, Ошибок, Пропущено,"
		+ " Провалившиеся, ЕстьОтчет, Успех, ФорматJUnit, ПутьОтчета",
		0, 0, 0, 0, 0,
		Новый Массив, Ложь, Истина, Истина, "");

КонецФункции

// Разобрать jUnit-отчёт YAxUnit в сводку результатов.
// Агрегаты берутся из атрибутов элементов <testsuite> (tests/failures/errors/skipped),
// детали провалов - из дочерних элементов <failure>/<error> элементов <testcase>.
//
// Параметры:
//   ПутьОтчета - Строка - путь к jUnit-файлу
//
// Возвращаемое значение:
//   Структура - сводка результатов (см. НовыйРезультатТестов)
//
Функция РазобратьОтчетJUnit(Знач ПутьОтчета) Экспорт

	Результат = НовыйРезультатТестов();

	Если НЕ ЗначениеЗаполнено(ПутьОтчета) ИЛИ НЕ Новый Файл(ПутьОтчета).Существует() Тогда
		Результат.Успех = Ложь;
		Возврат Результат;
	КонецЕсли;

	Результат.ЕстьОтчет = Истина;

	Чтение = Новый ЧтениеXML;
	Чтение.ОткрытьФайл(Новый Файл(ПутьОтчета).ПолноеИмя);
	ИмяТекущегоТеста = "";
	Пока Чтение.Прочитать() Цикл

		Если Чтение.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда
			Продолжить;
		КонецЕсли;

		// Имена элементов взаимоисключающие, поэтому используем независимые Если.
		Если Чтение.Имя = "testsuite" Тогда
			Результат.Всего = Результат.Всего + ЦелоеАтрибут(Чтение, "tests");
			Результат.Провалено = Результат.Провалено + ЦелоеАтрибут(Чтение, "failures");
			Результат.Ошибок = Результат.Ошибок + ЦелоеАтрибут(Чтение, "errors");
			Результат.Пропущено = Результат.Пропущено + ЦелоеАтрибут(Чтение, "skipped");
		КонецЕсли;

		Если Чтение.Имя = "testcase" Тогда
			ИмяТекущегоТеста = ИмяТесткейса(Чтение);
		КонецЕсли;

		Если Чтение.Имя = "failure" ИЛИ Чтение.Имя = "error" Тогда
			Сообщение = СтрокаАтрибут(Чтение, "message");
			Сбой = Новый Структура("Имя, Тип, Сообщение", ИмяТекущегоТеста, Чтение.Имя, Сообщение);
			Результат.Провалившиеся.Добавить(Сбой);
		КонецЕсли;

	КонецЦикла;
	Чтение.Закрыть();

	Результат.Успешно = Макс(0, Результат.Всего - Результат.Провалено - Результат.Ошибок - Результат.Пропущено);
	Результат.Успех = (Результат.Провалено + Результат.Ошибок) = 0;
	Возврат Результат;

КонецФункции

// Сформировать короткое текстовое саммари по сводке результатов.
//
// Параметры:
//   Результат - Структура - сводка результатов (см. НовыйРезультатТестов)
//
// Возвращаемое значение:
//   Строка - многострочный текст саммари
//
Функция СформироватьСаммари(Знач Результат) Экспорт

	Если НЕ Результат.ЕстьОтчет Тогда
		Возврат "YAxUnit: отчёт не сформирован.";
	КонецЕсли;

	Саммари = СтрШаблон(
		"YAxUnit: всего %1, успешно %2, провалено %3, ошибок %4, пропущено %5",
		Результат.Всего, Результат.Успешно, Результат.Провалено, Результат.Ошибок, Результат.Пропущено);

	Если Результат.Всего = 0 Тогда
		Саммари = Саммари + Символы.ПС
			+ "  Не найдено ни одного теста - проверьте фильтр (--ext/--modules) и загрузку расширений.";
	КонецЕсли;

	Для Каждого Сбой Из Результат.Провалившиеся Цикл
		СтрокаСбоя = "  [x] " + Сбой.Имя;
		Если ЗначениеЗаполнено(Сбой.Сообщение) Тогда
			СтрокаСбоя = СтрокаСбоя + " - " + Сбой.Сообщение;
		КонецЕсли;
		Саммари = Саммари + Символы.ПС + СтрокаСбоя;
	КонецЦикла;

	Возврат Саммари;

КонецФункции

// Сформировать значение ключа /C для запуска YAxUnit.
//
// Параметры:
//   ПутьКонфига - Строка - путь к конфигурационному файлу yaxunit.json
//
// Возвращаемое значение:
//   Строка - "RunUnitTests=<путь>"
//
Функция СформироватьКлючЗапуска(Знач ПутьКонфига) Экспорт
	Возврат "RunUnitTests=" + ПутьКонфига;
КонецФункции

// Подготовить конфигурационный файл запуска YAxUnit.
// Если задан ПутьКонфигу и файл существует - возвращается его полный путь без изменений.
// Иначе настройки формируются из параметров и записываются во временный файл.
//
// Параметры:
//   ПараметрыТестов - Структура - параметры тестов (см. НовыеПараметрыТестов)
//
// Возвращаемое значение:
//   Строка - полный путь к конфигурационному файлу
//
Функция ПодготовитьФайлНастроек(Знач ПараметрыТестов) Экспорт

	ПутьГотовогоКонфига = ЗначениеПоля(ПараметрыТестов, "ПутьКонфигу", "");
	Если ЗначениеЗаполнено(ПутьГотовогоКонфига) Тогда
		Файл = Новый Файл(ПутьГотовогоКонфига);
		Если НЕ Файл.Существует() Тогда
			ВызватьИсключение СтрШаблон(
				"Конфигурационный файл YAxUnit не найден: %1", ПутьГотовогоКонфига);
		КонецЕсли;
		Возврат Файл.ПолноеИмя;
	КонецЕсли;

	Настройки = СформироватьНастройки(ПараметрыТестов);
	// BSLLS:MissingTemporaryFileDeletion-off файл читается платформой при запуске, удаляется ОС
	ПутьФайла = ПолучитьИмяВременногоФайла("json");
	// BSLLS:MissingTemporaryFileDeletion-on

	ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, Символы.Таб);
	Запись = Новый ЗаписьJSON;
	Запись.ОткрытьФайл(ПутьФайла, "UTF-8", Ложь, ПараметрыЗаписи);
	ЗаписатьJSON(Запись, Настройки);
	Запись.Закрыть();

	Лог.Отладка("Сформирован конфигурационный файл YAxUnit: %1", ПутьФайла);
	Возврат ПутьФайла;

КонецФункции

// Сформировать настройки запуска YAxUnit в виде объекта, готового к сериализации в JSON.
// Включаются только заданные пользователем поля (пустые опускаются, чтобы YAxUnit применил
// собственные значения по умолчанию).
//
// Параметры:
//   ПараметрыТестов - Структура - параметры тестов (см. НовыеПараметрыТестов)
//
// Возвращаемое значение:
//   Соответствие - объект настроек YAxUnit (ключи в camelCase)
//
Функция СформироватьНастройки(Знач ПараметрыТестов) Экспорт

	Настройки = Новый Соответствие;

	Фильтр = СформироватьФильтр(ПараметрыТестов);
	Если Фильтр.Количество() > 0 Тогда
		Настройки.Вставить("filter", Фильтр);
	КонецЕсли;

	ФорматОтчета = ЗначениеПоля(ПараметрыТестов, "ФорматОтчета", "jUnit");
	Если ЗначениеЗаполнено(ФорматОтчета) Тогда
		Настройки.Вставить("reportFormat", ФорматОтчета);
	КонецЕсли;

	ПутьОтчета = ЗначениеПоля(ПараметрыТестов, "ПутьОтчета", "");
	Если ЗначениеЗаполнено(ПутьОтчета) Тогда
		Настройки.Вставить("reportPath", ПолныйПуть(ПутьОтчета));
	КонецЕсли;

	ПутьСтатуса = ЗначениеПоля(ПараметрыТестов, "ПутьСтатуса", "");
	Если ЗначениеЗаполнено(ПутьСтатуса) Тогда
		Настройки.Вставить("exitCode", ПолныйПуть(ПутьСтатуса));
	КонецЕсли;

	КаталогПроекта = ЗначениеПоля(ПараметрыТестов, "КаталогПроекта", "");
	Если ЗначениеЗаполнено(КаталогПроекта) Тогда
		Настройки.Вставить("projectPath", ПолныйПуть(КаталогПроекта));
	КонецЕсли;

	КаталогWorkspace = ЗначениеПоля(ПараметрыТестов, "КаталогWorkspace", "");
	Если ЗначениеЗаполнено(КаталогWorkspace) Тогда
		Настройки.Вставить("workspacePath", ПолныйПуть(КаталогWorkspace));
	КонецЕсли;

	Настройки.Вставить("closeAfterTests", ЛогическоеПоле(ПараметрыТестов, "ЗакрыватьПослеТестов", Истина));
	Настройки.Вставить("showReport", ЛогическоеПоле(ПараметрыТестов, "ПоказыватьОтчет", Ложь));

	НастройкиЛога = СформироватьЛогирование(ПараметрыТестов);
	Если НастройкиЛога.Количество() > 0 Тогда
		Настройки.Вставить("logging", НастройкиЛога);
	КонецЕсли;

	Возврат Настройки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СформироватьФильтр(Знач ПараметрыТестов)

	Фильтр = Новый Соответствие;
	ДобавитьСписок(Фильтр, "extensions", ЗначениеПоля(ПараметрыТестов, "Расширения", ""));
	ДобавитьСписок(Фильтр, "modules", ЗначениеПоля(ПараметрыТестов, "Модули", ""));
	ДобавитьСписок(Фильтр, "tests", ЗначениеПоля(ПараметрыТестов, "Тесты", ""));
	ДобавитьСписок(Фильтр, "tags", ЗначениеПоля(ПараметрыТестов, "Теги", ""));
	ДобавитьСписок(Фильтр, "suites", ЗначениеПоля(ПараметрыТестов, "Наборы", ""));
	Возврат Фильтр;

КонецФункции

Функция СформироватьЛогирование(Знач ПараметрыТестов)

	НастройкиЛога = Новый Соответствие;

	ЛогФайл = ЗначениеПоля(ПараметрыТестов, "ЛогФайл", "");
	Если ЗначениеЗаполнено(ЛогФайл) Тогда
		НастройкиЛога.Вставить("file", ПолныйПуть(ЛогФайл));
	КонецЕсли;

	Если ЛогическоеПоле(ПараметрыТестов, "ЛогКонсоль", Ложь) Тогда
		НастройкиЛога.Вставить("console", Истина);
	КонецЕсли;

	ЛогУровень = ЗначениеПоля(ПараметрыТестов, "ЛогУровень", "");
	Если ЗначениеЗаполнено(ЛогУровень) Тогда
		НастройкиЛога.Вставить("level", ЛогУровень);
	КонецЕсли;

	Возврат НастройкиЛога;

КонецФункции

// Разобрать строку со списком значений через запятую в массив (пустые элементы отбрасываются).
//
// Параметры:
//   Объект - Соответствие - объект, в который добавляется ключ при непустом списке
//   Ключ - Строка - имя ключа JSON
//   Значение - Строка - исходная строка со значениями через запятую
//
Процедура ДобавитьСписок(Объект, Знач Ключ, Знач Значение)

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат;
	КонецЕсли;

	Массив = Новый Массив;
	Для Каждого Элемент Из СтрРазделить(Значение, ",") Цикл
		Очищенный = СокрЛП(Элемент);
		Если ЗначениеЗаполнено(Очищенный) Тогда
			Массив.Добавить(Очищенный);
		КонецЕсли;
	КонецЦикла;

	Если Массив.Количество() > 0 Тогда
		Объект.Вставить(Ключ, Массив);
	КонецЕсли;

КонецПроцедуры

Функция ЗначениеПоля(Знач Источник, Знач Ключ, Знач ПоУмолчанию)
	Значение = Неопределено;
	Если Источник.Свойство(Ключ, Значение) И Значение <> Неопределено Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат ПоУмолчанию;
КонецФункции

Функция ЛогическоеПоле(Знач Источник, Знач Ключ, Знач ПоУмолчанию)
	Значение = Неопределено;
	Если Источник.Свойство(Ключ, Значение) И Значение <> Неопределено Тогда
		Возврат Булево(Значение);
	КонецЕсли;
	Возврат ПоУмолчанию;
КонецФункции

Функция ПолныйПуть(Знач Путь)
	Если НЕ ЗначениеЗаполнено(Путь) Тогда
		Возврат "";
	КонецЕсли;
	Возврат Новый Файл(Путь).ПолноеИмя;
КонецФункции

// Определить фактический путь отчёта и при необходимости подставить временный файл.
// Для готового конфига путь берётся из его reportPath (если задан), иначе ничего не подставляем.
// Если путь отчёта не задан вовсе - формируется временный jUnit-файл (zero-config режим).
//
// Параметры:
//   ПараметрыТестов - Структура - параметры тестов; при подстановке в неё пишется ПутьОтчета
//
// Возвращаемое значение:
//   Строка - фактический путь отчёта ("" - отчёт не ожидается, авто-саммари недоступно)
//
Функция ОбеспечитьПутьОтчета(ПараметрыТестов)

	ПутьКонфигу = ЗначениеПоля(ПараметрыТестов, "ПутьКонфигу", "");
	Если ЗначениеЗаполнено(ПутьКонфигу) Тогда
		Возврат ПутьОтчетаИзКонфига(ПутьКонфигу);
	КонецЕсли;

	ПутьОтчета = ЗначениеПоля(ПараметрыТестов, "ПутьОтчета", "");
	Если ЗначениеЗаполнено(ПутьОтчета) Тогда
		Возврат ПолныйПуть(ПутьОтчета);
	КонецЕсли;

	// BSLLS:MissingTemporaryFileDeletion-off отчёт остаётся для анализа, удаляется ОС
	ВременныйОтчет = ПолучитьИмяВременногоФайла("xml");
	// BSLLS:MissingTemporaryFileDeletion-on
	ПараметрыТестов.Вставить("ПутьОтчета", ВременныйОтчет);
	Лог.Информация("Путь отчёта не задан - отчёт jUnit будет сформирован во временном файле: %1", ВременныйОтчет);
	Возврат ВременныйОтчет;

КонецФункции

Функция ПутьОтчетаИзКонфига(Знач ПутьКонфигу)

	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.ОткрытьФайл(ПутьКонфигу);
		Данные = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
	Исключение
		Возврат "";
	КонецПопытки;

	Если ТипЗнч(Данные) = Тип("Соответствие") Тогда
		ПутьОтчета = Данные.Получить("reportPath");
		Если ЗначениеЗаполнено(ПутьОтчета) Тогда
			Возврат ПолныйПуть(ПутьОтчета);
		КонецЕсли;
	КонецЕсли;

	Возврат "";

КонецФункции

Функция ЭтоФорматJUnit(Знач ПараметрыТестов)
	Формат = ЗначениеПоля(ПараметрыТестов, "ФорматОтчета", "jUnit");
	Если НЕ ЗначениеЗаполнено(Формат) Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат ВРег(Формат) = ВРег("jUnit");
КонецФункции

Функция ИмяТесткейса(Знач Чтение)
	Имя = СтрокаАтрибут(Чтение, "classname");
	Если НЕ ЗначениеЗаполнено(Имя) Тогда
		Имя = СтрокаАтрибут(Чтение, "name");
	КонецЕсли;
	Контекст = СтрокаАтрибут(Чтение, "context");
	Если ЗначениеЗаполнено(Контекст) Тогда
		Имя = Имя + " [" + Контекст + "]";
	КонецЕсли;
	Возврат Имя;
КонецФункции

Функция СтрокаАтрибут(Знач Чтение, Знач Имя)
	Значение = Чтение.ПолучитьАтрибут(Имя);
	Возврат ?(Значение = Неопределено, "", Значение);
КонецФункции

Функция ЦелоеАтрибут(Знач Чтение, Знач Имя)
	Текст = СокрЛП(СтрокаАтрибут(Чтение, Имя));
	Если НЕ ЭтоЦелоеЧисло(Текст) Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Число(Текст);
КонецФункции

Функция ЭтоЦелоеЧисло(Знач Текст)
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Если СтрНайти("0123456789", Сред(Текст, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

#КонецОбласти
