// BSLLS:MissingVariablesDescription-off Поля autumn (&Лог/&Пластилин).
// BSLLS:LatinAndCyrillicSymbolInWord-off Идентификатор сервиса с латинской аббревиатурой (YAxUnit).
// BSLLS:NumberOfValuesInStructureConstructor-off Шаблон параметров тестов.
// BSLLS:Typo-off Доменные термины (Конфигу/YAxUnit).
// Сервис запуска модульных тестов YAxUnit (bia-technologies/yaxunit).
//
// YAxUnit запускается клиентом 1С:Предприятия с параметром /C "RunUnitTests=<config.json>".
// Сервис формирует конфигурационный файл запуска из опций командной строки и делегирует
// фактический запуск платформы в СервисПлатформы (что даёт бесплатно ibsrv и сбор покрытия).
//
// Предполагается, что расширения YAxUnit и тестов уже загружены в ИБ (vrunner cfe load).

&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисПлатформы;

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Шаблон параметров запуска тестов YAxUnit.
//
// Возвращаемое значение:
//   Структура - все поля необязательны:
//     * ПутьКонфигу - Строка - путь к готовому yaxunit.json (если задан - используется как есть)
//     * Расширения - Строка - имена расширений с тестами через запятую (filter.extensions)
//     * Модули - Строка - имена модулей через запятую (filter.modules)
//     * Тесты - Строка - полные пути тестов через запятую (filter.tests)
//     * Теги - Строка - теги через запятую (filter.tags)
//     * Наборы - Строка - имена наборов через запятую (filter.suites)
//     * ПутьОтчета - Строка - путь к отчёту (reportPath)
//     * ФорматОтчета - Строка - формат отчёта (reportFormat), по умолчанию "jUnit"
//     * ПутьСтатуса - Строка - путь к файлу кода возврата 0/1 (exitCode)
//     * РабочийКаталог - Строка - базовый каталог разрешения путей (workspacePath)
//     * ЗакрыватьПослеТестов - Булево - закрывать 1С после тестов (closeAfterTests), по умолчанию Истина
//     * ПоказыватьОтчет - Булево - открывать форму отчёта (showReport), по умолчанию Ложь
//     * ЛогФайл - Строка - путь к файлу лога (logging.file)
//     * ЛогКонсоль - Булево - писать лог в консоль (logging.console)
//     * ЛогУровень - Строка - уровень лога (logging.level): debug/info/warning/error
//
Функция НовыеПараметрыТестов() Экспорт

	Возврат Новый Структура(
		"ПутьКонфигу, Расширения, Модули, Тесты, Теги, Наборы,"
		+ " ПутьОтчета, ФорматОтчета, ПутьСтатуса, РабочийКаталог,"
		+ " ЗакрыватьПослеТестов, ПоказыватьОтчет, ЛогФайл, ЛогКонсоль, ЛогУровень",
		"", "", "", "", "", "",
		"", "jUnit", "", "",
		Истина, Ложь, "", Ложь, "");

КонецФункции

// Запустить тесты YAxUnit.
// Готовит конфигурационный файл, формирует ключ /C "RunUnitTests=..." и делегирует
// запуск 1С:Предприятия в СервисПлатформы.
//
// Параметры:
//   ПараметрыПодключения - Структура - параметры подключения к ИБ
//   ПараметрыТестов - Структура - параметры тестов (см. НовыеПараметрыТестов)
//   ПараметрыЗапуска - Структура - параметры запуска платформы; ключ КомандаЗапуска будет
//       перезаписан, остальные ключи (РежимЗапуска, НеОжидать, Покрытие и т.п.) сохраняются
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//
Процедура ЗапуститьТесты(Знач ПараметрыПодключения, Знач ПараметрыТестов,
		Знач ПараметрыЗапуска, Знач ПараметрыПлатформы = Неопределено) Экспорт

	ПутьКонфига = ПодготовитьФайлНастроек(ПараметрыТестов);
	Лог.Информация("Запуск тестов YAxUnit, конфигурация: %1", ПутьКонфига);

	ПараметрыЗапуска.Вставить("КомандаЗапуска", СформироватьКлючЗапуска(ПутьКонфига));
	// YAxUnit пишет собственный файл exitCode (0/1), не xdd-формат статуса платформы.
	ПараметрыЗапуска.Вставить("ПутьКФайлуСтатуса", "");

	СервисПлатформы.ЗапуститьПредприятие(ПараметрыПодключения, ПараметрыЗапуска, ПараметрыПлатформы);

	Лог.Информация("Запуск тестов YAxUnit завершён");

КонецПроцедуры

// Сформировать значение ключа /C для запуска YAxUnit.
//
// Параметры:
//   ПутьКонфига - Строка - путь к конфигурационному файлу yaxunit.json
//
// Возвращаемое значение:
//   Строка - "RunUnitTests=<путь>"
//
Функция СформироватьКлючЗапуска(Знач ПутьКонфига) Экспорт
	Возврат "RunUnitTests=" + ПутьКонфига;
КонецФункции

// Подготовить конфигурационный файл запуска YAxUnit.
// Если задан ПутьКонфигу и файл существует - возвращается его полный путь без изменений.
// Иначе настройки формируются из параметров и записываются во временный файл.
//
// Параметры:
//   ПараметрыТестов - Структура - параметры тестов (см. НовыеПараметрыТестов)
//
// Возвращаемое значение:
//   Строка - полный путь к конфигурационному файлу
//
Функция ПодготовитьФайлНастроек(Знач ПараметрыТестов) Экспорт

	ПутьГотовогоКонфига = ЗначениеПоля(ПараметрыТестов, "ПутьКонфигу", "");
	Если ЗначениеЗаполнено(ПутьГотовогоКонфига) Тогда
		Файл = Новый Файл(ПутьГотовогоКонфига);
		Если НЕ Файл.Существует() Тогда
			ВызватьИсключение СтрШаблон(
				"Конфигурационный файл YAxUnit не найден: %1", ПутьГотовогоКонфига);
		КонецЕсли;
		Возврат Файл.ПолноеИмя;
	КонецЕсли;

	Настройки = СформироватьНастройки(ПараметрыТестов);
	// BSLLS:MissingTemporaryFileDeletion-off файл читается платформой при запуске, удаляется ОС
	ПутьФайла = ПолучитьИмяВременногоФайла("json");
	// BSLLS:MissingTemporaryFileDeletion-on

	ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, Символы.Таб);
	Запись = Новый ЗаписьJSON;
	Запись.ОткрытьФайл(ПутьФайла, "UTF-8", Ложь, ПараметрыЗаписи);
	ЗаписатьJSON(Запись, Настройки);
	Запись.Закрыть();

	Лог.Отладка("Сформирован конфигурационный файл YAxUnit: %1", ПутьФайла);
	Возврат ПутьФайла;

КонецФункции

// Сформировать настройки запуска YAxUnit в виде объекта, готового к сериализации в JSON.
// Включаются только заданные пользователем поля (пустые опускаются, чтобы YAxUnit применил
// собственные значения по умолчанию).
//
// Параметры:
//   ПараметрыТестов - Структура - параметры тестов (см. НовыеПараметрыТестов)
//
// Возвращаемое значение:
//   Соответствие - объект настроек YAxUnit (ключи в camelCase)
//
Функция СформироватьНастройки(Знач ПараметрыТестов) Экспорт

	Настройки = Новый Соответствие;

	Фильтр = СформироватьФильтр(ПараметрыТестов);
	Если Фильтр.Количество() > 0 Тогда
		Настройки.Вставить("filter", Фильтр);
	КонецЕсли;

	ФорматОтчета = ЗначениеПоля(ПараметрыТестов, "ФорматОтчета", "jUnit");
	Если ЗначениеЗаполнено(ФорматОтчета) Тогда
		Настройки.Вставить("reportFormat", ФорматОтчета);
	КонецЕсли;

	ПутьОтчета = ЗначениеПоля(ПараметрыТестов, "ПутьОтчета", "");
	Если ЗначениеЗаполнено(ПутьОтчета) Тогда
		Настройки.Вставить("reportPath", ПолныйПуть(ПутьОтчета));
	КонецЕсли;

	ПутьСтатуса = ЗначениеПоля(ПараметрыТестов, "ПутьСтатуса", "");
	Если ЗначениеЗаполнено(ПутьСтатуса) Тогда
		Настройки.Вставить("exitCode", ПолныйПуть(ПутьСтатуса));
	КонецЕсли;

	РабочийКаталог = ЗначениеПоля(ПараметрыТестов, "РабочийКаталог", "");
	Если ЗначениеЗаполнено(РабочийКаталог) Тогда
		Настройки.Вставить("workspacePath", ПолныйПуть(РабочийКаталог));
	КонецЕсли;

	Настройки.Вставить("closeAfterTests", ЛогическоеПоле(ПараметрыТестов, "ЗакрыватьПослеТестов", Истина));
	Настройки.Вставить("showReport", ЛогическоеПоле(ПараметрыТестов, "ПоказыватьОтчет", Ложь));

	НастройкиЛога = СформироватьЛогирование(ПараметрыТестов);
	Если НастройкиЛога.Количество() > 0 Тогда
		Настройки.Вставить("logging", НастройкиЛога);
	КонецЕсли;

	Возврат Настройки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СформироватьФильтр(Знач ПараметрыТестов)

	Фильтр = Новый Соответствие;
	ДобавитьСписок(Фильтр, "extensions", ЗначениеПоля(ПараметрыТестов, "Расширения", ""));
	ДобавитьСписок(Фильтр, "modules", ЗначениеПоля(ПараметрыТестов, "Модули", ""));
	ДобавитьСписок(Фильтр, "tests", ЗначениеПоля(ПараметрыТестов, "Тесты", ""));
	ДобавитьСписок(Фильтр, "tags", ЗначениеПоля(ПараметрыТестов, "Теги", ""));
	ДобавитьСписок(Фильтр, "suites", ЗначениеПоля(ПараметрыТестов, "Наборы", ""));
	Возврат Фильтр;

КонецФункции

Функция СформироватьЛогирование(Знач ПараметрыТестов)

	НастройкиЛога = Новый Соответствие;

	ЛогФайл = ЗначениеПоля(ПараметрыТестов, "ЛогФайл", "");
	Если ЗначениеЗаполнено(ЛогФайл) Тогда
		НастройкиЛога.Вставить("file", ПолныйПуть(ЛогФайл));
	КонецЕсли;

	Если ЛогическоеПоле(ПараметрыТестов, "ЛогКонсоль", Ложь) Тогда
		НастройкиЛога.Вставить("console", Истина);
	КонецЕсли;

	ЛогУровень = ЗначениеПоля(ПараметрыТестов, "ЛогУровень", "");
	Если ЗначениеЗаполнено(ЛогУровень) Тогда
		НастройкиЛога.Вставить("level", ЛогУровень);
	КонецЕсли;

	Возврат НастройкиЛога;

КонецФункции

// Разобрать строку со списком значений через запятую в массив (пустые элементы отбрасываются).
//
// Параметры:
//   Объект - Соответствие - объект, в который добавляется ключ при непустом списке
//   Ключ - Строка - имя ключа JSON
//   Значение - Строка - исходная строка со значениями через запятую
//
Процедура ДобавитьСписок(Объект, Знач Ключ, Знач Значение)

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат;
	КонецЕсли;

	Массив = Новый Массив;
	Для Каждого Элемент Из СтрРазделить(Значение, ",") Цикл
		Очищенный = СокрЛП(Элемент);
		Если ЗначениеЗаполнено(Очищенный) Тогда
			Массив.Добавить(Очищенный);
		КонецЕсли;
	КонецЦикла;

	Если Массив.Количество() > 0 Тогда
		Объект.Вставить(Ключ, Массив);
	КонецЕсли;

КонецПроцедуры

Функция ЗначениеПоля(Знач Источник, Знач Ключ, Знач ПоУмолчанию)
	Значение = Неопределено;
	Если Источник.Свойство(Ключ, Значение) И Значение <> Неопределено Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат ПоУмолчанию;
КонецФункции

Функция ЛогическоеПоле(Знач Источник, Знач Ключ, Знач ПоУмолчанию)
	Значение = Неопределено;
	Если Источник.Свойство(Ключ, Значение) И Значение <> Неопределено Тогда
		Возврат Булево(Значение);
	КонецЕсли;
	Возврат ПоУмолчанию;
КонецФункции

Функция ПолныйПуть(Знач Путь)
	Если НЕ ЗначениеЗаполнено(Путь) Тогда
		Возврат "";
	КонецЕсли;
	Возврат Новый Файл(Путь).ПолноеИмя;
КонецФункции

#КонецОбласти
