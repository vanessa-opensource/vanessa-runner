// BSLLS:MissingParameterDescription-off Внутренние служебные методы.
// BSLLS:MissingReturnedValueDescription-off Внутренние служебные методы.
// BSLLS:NumberOfValuesInStructureConstructor-off Строка .tsv - 8 колонок.
// BSLLS:MagicNumber-off Индексы колонок .tsv (0..7).
// BSLLS:Typo-off Подстроки уровней важности EDT ("критич"/"незначительн").
// Разбор результатов проверки 1С:EDT (1cedtcli validate --file): .tsv по замечанию на строку,
// ранги важности замечаний (выше - серьёзнее) и порог по уровню --min-severity.

#Область ПрограммныйИнтерфейс

// Разобрать .tsv-файл результатов проверки EDT в массив замечаний. Пустые строки пропускаются.
//
// Параметры:
//   ПутьФайла - Строка - путь к файлу результатов 1cedtcli validate
//
// Возвращаемое значение:
//   Массив из Структура - замечания с полями
//     Дата, Важность, Категория, Проект, Проверка, Объект, Место, Описание (значения - строки).
//
Функция Разобрать(Знач ПутьФайла) Экспорт

	Замечания = Новый Массив;
	Чтение = Новый ЧтениеТекста(ПутьФайла, КодировкаТекста.UTF8);
	Попытка
		СтрокаФайла = Чтение.ПрочитатьСтроку();
		Пока СтрокаФайла <> Неопределено Цикл
			Если ЗначениеЗаполнено(СокрЛП(СтрокаФайла)) Тогда
				Замечания.Добавить(РазобратьСтроку(СтрокаФайла));
			КонецЕсли;
			СтрокаФайла = Чтение.ПрочитатьСтроку();
		КонецЦикла;
	Исключение
		Чтение.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	Чтение.Закрыть();

	Возврат Замечания;

КонецФункции

// Ранг важности замечания EDT; неизвестный уровень трактуется как значительный.
//
// Параметры:
//   Важность - Строка - уровень важности из результата проверки
//
// Возвращаемое значение:
//   Число - 3 - критическое, 2 - значительное, 1 - незначительное
//
Функция РангВажности(Знач Важность) Экспорт

	Норм = НРег(СокрЛП(Строка(Важность)));
	Если СтрНайти(Норм, "критич") > 0 Тогда
		Возврат РангКритический();
	ИначеЕсли СтрНайти(Норм, "незначительн") > 0 Тогда
		Возврат РангНезначительный();
	Иначе
		Возврат РангЗначительный();
	КонецЕсли;

КонецФункции

// Порог-ранг по значению опции --min-severity (выше - строже).
//
// Параметры:
//   Уровень - Строка - critical | major | minor | none; прочие значения - major
//
// Возвращаемое значение:
//   Число - минимальный ранг блокирующего замечания; для none - недостижимый
//
Функция ПорогУровня(Знач Уровень) Экспорт

	Если Уровень = "critical" Тогда
		Возврат РангКритический();
	ИначеЕсли Уровень = "minor" Тогда
		Возврат РангНезначительный();
	ИначеЕсли Уровень = "none" Тогда
		Возврат РангНедостижимый();
	Иначе
		Возврат РангЗначительный();
	КонецЕсли;

КонецФункции

// Отобрать замечания, ранг важности которых не ниже порога.
//
// Параметры:
//   Замечания - Массив из Структура - результат Разобрать()
//   Порог - Число - результат ПорогУровня()
//
// Возвращаемое значение:
//   Массив из Структура - замечания, достигшие порога
//
Функция ОтобратьПоПорогу(Знач Замечания, Знач Порог) Экспорт

	Результат = Новый Массив;
	Для Каждого Замечание Из Замечания Цикл
		Если РангВажности(Замечание.Важность) >= Порог Тогда
			Результат.Добавить(Замечание);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Важность Allure (severity) по рангу замечания EDT.
//
// Параметры:
//   Ранг - Число - результат РангВажности()
//
// Возвращаемое значение:
//   Строка - critical | normal | minor
//
Функция ВажностьAllure(Знач Ранг) Экспорт

	Если Ранг = РангКритический() Тогда
		Возврат "critical";
	ИначеЕсли Ранг = РангНезначительный() Тогда
		Возврат "minor";
	Иначе
		Возврат "normal";
	КонецЕсли;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Строка .tsv (8 колонок, разделитель - табуляция) -> структура замечания; недостающие колонки - пустые.
Функция РазобратьСтроку(Знач СтрокаФайла)

	Поля = СтрРазделить(СтрокаФайла, Символы.Таб, Истина);
	Возврат Новый Структура(
		"Дата, Важность, Категория, Проект, Проверка, Объект, Место, Описание",
		Поле(Поля, 0), Поле(Поля, 1), Поле(Поля, 2), Поле(Поля, 3),
		Поле(Поля, 4), Поле(Поля, 5), Поле(Поля, 6), Поле(Поля, 7));

КонецФункции

Функция Поле(Знач Поля, Знач Индекс)

	Если Индекс <= Поля.ВГраница() Тогда
		Возврат СокрЛП(Поля[Индекс]);
	КонецЕсли;
	Возврат "";

КонецФункции

Функция РангКритический()
	Возврат 3;
КонецФункции

Функция РангЗначительный()
	Возврат 2;
КонецФункции

Функция РангНезначительный()
	Возврат 1;
КонецФункции

// Порог, которого не достигает ни одно замечание: --min-severity none.
Функция РангНедостижимый()
	Возврат 999;
КонецФункции

#КонецОбласти
