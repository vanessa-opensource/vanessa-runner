// BSLLS:Typo-off Доменный термин (алиас).
// BSLLS:UnusedLocalMethod-off ПриСозданииОбъекта вызывается рантаймом при Новый.
// Разбор значения опции --reportsxunit команды test xunit.
//
// Формат значения: "Формат{Путь}[;Формат{Путь}...]".
// Формат - короткий алиас (junit, allure, json, mxl, genericexecution) либо полное имя
// генератора Vanessa-ADD: ГенераторОтчетаJUnitXML / GenerateReportJUnitXML и т.п.
// Полные имена не проверяются по списку - генераторы отчётов Vanessa-ADD расширяемы плагинами.

Перем _Алиасы; // Соответствие - короткий формат -> полное имя генератора Vanessa-ADD

Процедура ПриСозданииОбъекта()

	_Алиасы = Новый Соответствие;
	_Алиасы.Вставить("junit", "ГенераторОтчетаJUnitXML");
	_Алиасы.Вставить("allure", "ГенераторОтчетаAllureXMLВерсия2");
	_Алиасы.Вставить("json", "ГенераторОтчетаJSON");
	_Алиасы.Вставить("mxl", "ГенераторОтчетаMXL");
	_Алиасы.Вставить("genericexecution", "ГенераторОтчетаGenericExecution");

КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Разобрать параметры формирования отчётов.
//
// Параметры:
//   СтрокаПараметров       - Строка - значение опции --reportsxunit: "Формат{Путь}[;Формат{Путь}...]"
//   УстаревшийКаталогОтчета - Строка - значение опции --reportxunit (jUnit-отчёт, устаревшая)
//
// Возвращаемое значение:
//   Массив - элементы Структура:
//     * Генератор - Строка - полное имя генератора отчёта Vanessa-ADD
//     * Путь      - Строка - абсолютный путь вывода отчёта
//
Функция Разобрать(Знач СтрокаПараметров, Знач УстаревшийКаталогОтчета = "") Экспорт

	Отчеты = Новый Массив;

	Если ЗначениеЗаполнено(УстаревшийКаталогОтчета) Тогда
		ДобавитьОтчет(Отчеты, "ГенераторОтчетаJUnitXML", УстаревшийКаталогОтчета);
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(СтрокаПараметров) Тогда
		Возврат Отчеты;
	КонецЕсли;

	Для Каждого ПараметрВывода Из СтрРазделить(СтрокаПараметров, ";", Ложь) Цикл

		Если НЕ ЗначениеЗаполнено(СокрЛП(ПараметрВывода)) Тогда
			Продолжить;
		КонецЕсли;

		Отчет = РазобратьПараметрОтчета(ПараметрВывода);
		ДобавитьОтчет(Отчеты, Отчет.Генератор, Отчет.Путь);

	КонецЦикла;

	Возврат Отчеты;

КонецФункции

// Полное имя генератора Vanessa-ADD по формату отчёта.
//
// Параметры:
//   Формат - Строка - короткий алиас (junit, allure, json, mxl, genericexecution)
//                     либо полное имя генератора Vanessa-ADD
//
// Возвращаемое значение:
//   Строка - полное имя генератора отчёта Vanessa-ADD
//
Функция ГенераторПоФормату(Знач Формат) Экспорт

	Возврат ИмяГенератора(Формат);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РазобратьПараметрОтчета(Знач ПараметрВывода)

	ПозицияОткрытия = СтрНайти(ПараметрВывода, "{");
	ПозицияЗакрытия = СтрНайти(ПараметрВывода, "}", НаправлениеПоиска.СКонца);

	Если ПозицияОткрытия = 0 ИЛИ ПозицияЗакрытия < ПозицияОткрытия Тогда
		ВызватьИсключение СтрШаблон(
			"Неверный формат параметра отчёта: ""%1"". Ожидается ""Формат{Путь}"", например ""junit{./build/junit.xml}""",
			СокрЛП(ПараметрВывода));
	КонецЕсли;

	Формат = СокрЛП(Лев(ПараметрВывода, ПозицияОткрытия - 1));
	Путь = СокрЛП(Сред(ПараметрВывода, ПозицияОткрытия + 1, ПозицияЗакрытия - ПозицияОткрытия - 1));

	Если НЕ ЗначениеЗаполнено(Путь) Тогда
		ВызватьИсключение СтрШаблон("Не задан путь вывода отчёта: ""%1""", СокрЛП(ПараметрВывода));
	КонецЕсли;

	Возврат Новый Структура("Генератор, Путь", ИмяГенератора(Формат), Путь);

КонецФункции

Функция ИмяГенератора(Знач Формат)

	Алиас = _Алиасы[НРег(Формат)];
	Если Алиас <> Неопределено Тогда
		Возврат Алиас;
	КонецЕсли;

	Если СтрНачинаетсяС(Формат, "ГенераторОтчета") Тогда
		Возврат Формат;
	КонецЕсли;

	Если СтрНачинаетсяС(Формат, "GenerateReport") Тогда
		Возврат СтрЗаменить(Формат, "GenerateReport", "ГенераторОтчета");
	КонецЕсли;

	ВызватьИсключение СтрШаблон(
		"Неизвестный формат отчёта: ""%1"". Доступны: junit, allure, json, mxl, genericexecution"
		+ " либо полное имя генератора Vanessa-ADD (ГенераторОтчетаJUnitXML, GenerateReportJUnitXML...)",
		Формат);

КонецФункции

// Добавить отчёт; повторное указание генератора перекрывает предыдущее (поведение 2.x).
//
// Параметры:
//   Отчеты    - Массив - накопленные отчёты (модифицируется)
//   Генератор - Строка - полное имя генератора отчёта
//   Путь      - Строка - путь вывода отчёта
//
Процедура ДобавитьОтчет(Отчеты, Знач Генератор, Знач Путь)

	АбсолютныйПуть = Новый Файл(Путь).ПолноеИмя;

	Для Каждого Отчет Из Отчеты Цикл
		Если Отчет.Генератор = Генератор Тогда
			Отчет.Путь = АбсолютныйПуть;
			Возврат;
		КонецЕсли;
	КонецЦикла;

	Отчеты.Добавить(Новый Структура("Генератор, Путь", Генератор, АбсолютныйПуть));

КонецПроцедуры

#КонецОбласти
