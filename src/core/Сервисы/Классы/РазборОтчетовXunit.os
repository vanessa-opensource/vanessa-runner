// BSLLS:Typo-off Доменный термин (алиас).
// BSLLS:MissingParameterDescription-off Внутренние служебные методы.
// BSLLS:MissingReturnedValueDescription-off Внутренние служебные методы.
// BSLLS:UnusedLocalMethod-off ПриСозданииОбъекта вызывается рантаймом при Новый.
// Разбор устаревших опций отчётов команды test xunit: --reportsxunit и --reportxunit.
//
// Формат значения --reportsxunit: "Формат{Путь}[;Формат{Путь}...]".
// Формат - короткий алиас (junit, allure, json, mxl, genericexecution) либо полное имя
// генератора Vanessa-ADD: ГенераторОтчетаJUnitXML / GenerateReportJUnitXML и т.п.
// Полные имена не проверяются по списку - генераторы отчётов Vanessa-ADD расширяемы плагинами.
//
// Форматы приводятся к каноническому виду, общему с парой --report-format/--report-path
// (см. РазборПараметровОтчетов): алиас известного генератора либо имя генератора ГенераторОтчета...
// Так "junit", "ГенераторОтчетаJUnitXML" и "GenerateReportJUnitXML" - один отчёт, откуда бы он ни пришёл.

Перем _Алиасы;            // Соответствие - короткий формат -> полное имя генератора Vanessa-ADD
Перем _АлиасыГенераторов; // Соответствие - полное имя генератора Vanessa-ADD -> короткий формат

Процедура ПриСозданииОбъекта()

	_Алиасы = Новый Соответствие;
	_Алиасы.Вставить("junit", "ГенераторОтчетаJUnitXML");
	_Алиасы.Вставить("allure", "ГенераторОтчетаAllureXMLВерсия2");
	_Алиасы.Вставить("json", "ГенераторОтчетаJSON");
	_Алиасы.Вставить("mxl", "ГенераторОтчетаMXL");
	_Алиасы.Вставить("genericexecution", "ГенераторОтчетаGenericExecution");

	_АлиасыГенераторов = Новый Соответствие;
	Для Каждого Алиас Из _Алиасы Цикл
		_АлиасыГенераторов.Вставить(Алиас.Значение, Алиас.Ключ);
	КонецЦикла;

КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Разобрать устаревшие опции в список отчётов для НаборОпцийОтчетов.СобратьОтчеты.
// Повторы формата не схлопываются - это делает СобратьОтчеты, побеждает последний.
//
// Параметры:
//   СтрокаПараметров        - Строка - значение опции --reportsxunit: "Формат{Путь}[;Формат{Путь}...]"
//   УстаревшийКаталогОтчета - Строка - значение опции --reportxunit (путь jUnit-отчёта)
//
// Возвращаемое значение:
//   Массив - элементы Структура (см. НаборОпцийОтчетов.УстаревшийОтчет):
//     * ИмяОпции - Строка - опция, задавшая отчёт: --reportxunit или --reportsxunit
//     * Формат   - Строка - канонический формат (см. КаноническийФормат)
//     * Путь     - Строка - абсолютный путь вывода отчёта
//
Функция Разобрать(Знач СтрокаПараметров, Знач УстаревшийКаталогОтчета = "") Экспорт

	Отчеты = Новый Массив;

	Если ЗначениеЗаполнено(УстаревшийКаталогОтчета) Тогда
		Отчеты.Добавить(НовыйОтчет("--reportxunit", КаноническийФормат("junit"), УстаревшийКаталогОтчета));
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(СтрокаПараметров) Тогда
		Возврат Отчеты;
	КонецЕсли;

	Для Каждого ПараметрВывода Из СтрРазделить(СтрокаПараметров, ";", Ложь) Цикл

		Если НЕ ЗначениеЗаполнено(СокрЛП(ПараметрВывода)) Тогда
			Продолжить;
		КонецЕсли;

		Отчеты.Добавить(РазобратьПараметрОтчета(ПараметрВывода));

	КонецЦикла;

	Возврат Отчеты;

КонецФункции

// Канонический формат отчёта - общий для устаревших опций и пары --report-format/--report-path.
//
// Параметры:
//   Формат - Строка - короткий алиас (в любом регистре) либо полное имя генератора Vanessa-ADD
//                     (ГенераторОтчета... или GenerateReport...)
//
// Возвращаемое значение:
//   Строка - алиас в нижнем регистре, если генератор известен, иначе имя генератора ГенераторОтчета...
//
Функция КаноническийФормат(Знач Формат) Экспорт

	Генератор = ГенераторПоФормату(Формат);

	Алиас = _АлиасыГенераторов[Генератор];
	Возврат ?(Алиас = Неопределено, Генератор, Алиас);

КонецФункции

// Полное имя генератора Vanessa-ADD по формату отчёта.
//
// Параметры:
//   Формат - Строка - короткий алиас (junit, allure, json, mxl, genericexecution)
//                     либо полное имя генератора Vanessa-ADD
//
// Возвращаемое значение:
//   Строка - полное имя генератора отчёта Vanessa-ADD
//
Функция ГенераторПоФормату(Знач Формат) Экспорт

	Алиас = _Алиасы[НРег(Формат)];
	Если Алиас <> Неопределено Тогда
		Возврат Алиас;
	КонецЕсли;

	Если СтрНачинаетсяС(Формат, "ГенераторОтчета") Тогда
		Возврат Формат;
	КонецЕсли;

	Если СтрНачинаетсяС(Формат, "GenerateReport") Тогда
		Возврат СтрЗаменить(Формат, "GenerateReport", "ГенераторОтчета");
	КонецЕсли;

	ВызватьИсключение СтрШаблон(
		"Неизвестный формат отчёта: ""%1"". Доступны: junit, allure, json, mxl, genericexecution"
		+ " либо полное имя генератора Vanessa-ADD (ГенераторОтчетаJUnitXML, GenerateReportJUnitXML...)",
		Формат);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РазобратьПараметрОтчета(Знач ПараметрВывода)

	ПозицияОткрытия = СтрНайти(ПараметрВывода, "{");
	ПозицияЗакрытия = СтрНайти(ПараметрВывода, "}", НаправлениеПоиска.СКонца);

	Если ПозицияОткрытия = 0 ИЛИ ПозицияЗакрытия < ПозицияОткрытия Тогда
		ВызватьИсключение СтрШаблон(
			"Неверный формат параметра отчёта: ""%1"". Ожидается ""Формат{Путь}"", например ""junit{./build/junit.xml}""",
			СокрЛП(ПараметрВывода));
	КонецЕсли;

	Формат = СокрЛП(Лев(ПараметрВывода, ПозицияОткрытия - 1));
	Путь = СокрЛП(Сред(ПараметрВывода, ПозицияОткрытия + 1, ПозицияЗакрытия - ПозицияОткрытия - 1));

	Если НЕ ЗначениеЗаполнено(Путь) Тогда
		ВызватьИсключение СтрШаблон("Не задан путь вывода отчёта: ""%1""", СокрЛП(ПараметрВывода));
	КонецЕсли;

	Возврат НовыйОтчет("--reportsxunit", КаноническийФормат(Формат), Путь);

КонецФункции

Функция НовыйОтчет(Знач ИмяОпции, Знач Формат, Знач Путь)

	АбсолютныйПуть = Новый Файл(Путь).ПолноеИмя;
	Возврат Новый Структура("ИмяОпции, Формат, Путь", ИмяОпции, Формат, АбсолютныйПуть);

КонецФункции

#КонецОбласти
