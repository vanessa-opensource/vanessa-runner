// BSLLS:NumberOfValuesInStructureConstructor-off
// BSLLS:MissingVariablesDescription-off Поля autumn
// BSLLS:NumberOfOptionalParams-off
// BSLLS:NumberOfParams-off
// BSLLS:Typo-off (&Лог/&Пластилин/&Напильник) и внутреннее состояние сервиса.
// BSLLS:LatinAndCyrillicSymbolInWord-off Технические идентификаторы EDT/Cli/XML.
// BSLLS:MissingParameterDescription-off Внутренние пробросы параметров (описаны на уровне CLI/СервисEDT).
// BSLLS:MissingTemporaryFileDeletion-off Временные каталоги удаляются в парных методах СервисEDT/через очистку.
// BSLLS:LineLength-off Длинные XML-литералы в шаблонах пустого расширения.
// BSLLS:NestedFunctionInParameters-off Идиоматичное построение XML-строк (Добавить(СтрШаблон(...))).
// Сервис операций с расширениями конфигурации.
// Фасад: единый интерфейс к операциям с расширениями.
// Маршрутизирует вызовы к нужному движку (конфигуратор или ibcmd),
// оркестрирует пайплайны (создание базы → загрузка → выгрузка → очистка).

&Лог("vrunner")
Перем Лог;

&Пластилин(Значение = "ДвижокПлатформы", Тип = "Соответствие")
Перем Движки;

&Пластилин
Перем СервисРасчетаИнкремента;

&Пластилин
Перем СервисЗапускаОбработок;

&Пластилин
Перем СервисEDT;

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Загрузить расширение в базу из файла (.cfe).
// Грузит напрямую движком (конфигуратор или ibcmd) в целевую базу - универсально,
// в т.ч. для расширений, которые компилируются только поверх основной конфигурации.
// Свойства расширения устанавливаются отдельным шагом вызывающим кодом
// (УстановитьПараметрыРасширенияЧерезОбработку для конфигуратора, ИзменитьСвойстваРасширения для ibcmd).
// Параметры:
//   ПараметрыПодключения - Структура - строка подключения, пользователь, пароль
//   ПутьКФайлуCfe        - Строка    - путь к .cfe-файлу
//   ИмяРасширения        - Строка    - имя расширения в базе
//   ИспользоватьIbcmd    - Булево    - использовать ibcmd вместо конфигуратора
//   ПараметрыПлатформы   - Структура - необязательные параметры платформы
Процедура ЗагрузитьРасширениеВБазуИзФайла(Знач ПараметрыПодключения, Знач ПутьКФайлуCfe, Знач ИмяРасширения,
	Знач ИспользоватьIbcmd = Ложь, Знач ПараметрыПлатформы = Неопределено) Экспорт

	Движок = ВыбратьДвижок(ИспользоватьIbcmd);
	Лог.Отладка("Загрузка расширения из файла: файл=%1, имя=%2, движок=%3", ПутьКФайлуCfe, ИмяРасширения, Движок);
	Движок.ЗагрузитьРасширениеИзФайла(ПараметрыПодключения, ПутьКФайлуCfe, ИмяРасширения, ПараметрыПлатформы);
	Лог.Информация("Расширение '%1' загружено из файла %2", ИмяРасширения, ПутьКФайлуCfe);

КонецПроцедуры

// Загрузить расширение в базу из XML-исходников.
// Грузит напрямую движком (конфигуратор или ibcmd) в целевую базу - универсально,
// в т.ч. для расширений, которые компилируются только поверх основной конфигурации.
// Свойства расширения устанавливаются отдельным шагом вызывающим кодом.
// Параметры:
//   ПараметрыПодключения    - Структура - строка подключения, пользователь, пароль
//   КаталогИсходников       - Строка    - каталог с XML-файлами расширения
//   ИмяРасширения           - Строка    - имя расширения в базе
//   ИспользоватьIbcmd       - Булево    - использовать ibcmd вместо конфигуратора
//   ПараметрыПлатформы      - Структура - необязательные параметры платформы
//   ИнкрементальнаяЗагрузка - Булево    - инкрементальная загрузка по индексу изменений
//   ПараметрыИсходников     - Структура - параметры подготовки исходников (формат/EDT)
Процедура ЗагрузитьРасширениеВБазуИзФайлов(Знач ПараметрыПодключения, Знач КаталогИсходников, Знач ИмяРасширения,
	Знач ИспользоватьIbcmd = Ложь, Знач ПараметрыПлатформы = Неопределено, Знач ИнкрементальнаяЗагрузка = Ложь,
	Знач ПараметрыИсходников = Неопределено) Экспорт

	КонтекстEDT = СервисEDT.ПодготовитьXML(КаталогИсходников, ПараметрыИсходников);
	Попытка
		ВыполнитьЗагрузкуРасширенияИзФайлов(ПараметрыПодключения, КонтекстEDT.Путь, ИмяРасширения,
			ИспользоватьIbcmd, ПараметрыПлатформы, ИнкрементальнаяЗагрузка);
	Исключение
		СервисEDT.ЗавершитьXML(КонтекстEDT);
		ВызватьИсключение;
	КонецПопытки;
	СервисEDT.ЗавершитьXML(КонтекстEDT);

КонецПроцедуры

// BSLLS:NonExportMethodsInApiRegion-off Приватный помощник намеренно расположен рядом со своим публичным методом.
Процедура ВыполнитьЗагрузкуРасширенияИзФайлов(Знач ПараметрыПодключения, Знач КаталогИсходников, Знач ИмяРасширения,
	Знач ИспользоватьIbcmd, Знач ПараметрыПлатформы, Знач ИнкрементальнаяЗагрузка)

	Движок = ВыбратьДвижок(ИспользоватьIbcmd);
	КонтекстИнкремента = Неопределено;
	СписокФайлов = "";
	Если ИнкрементальнаяЗагрузка = Истина Тогда
		РезультатИнкремента = СервисРасчетаИнкремента.РассчитатьИнкрементДляЗагрузкиРасширения(
			КаталогИсходников,
			ПараметрыПодключения,
			ИмяРасширения,
			ИспользоватьIbcmd,
			ПараметрыПлатформы);
		КонтекстИнкремента = РезультатИнкремента.КонтекстИнкремента;
		Если РезультатИнкремента.ПропуститьЗагрузку Тогда
			Возврат;
		КонецЕсли;
		СписокФайлов = РезультатИнкремента.СписокФайловДляЗагрузки;
	КонецЕсли;

	Лог.Отладка("Загрузка расширения из файлов: каталог=%1, имя=%2, движок=%3", КаталогИсходников, ИмяРасширения, Движок);
	Движок.ЗагрузитьРасширениеИзФайлов(
		ПараметрыПодключения, КаталогИсходников, ИмяРасширения, ПараметрыПлатформы, СписокФайлов);
	Если КонтекстИнкремента <> Неопределено Тогда
		СервисРасчетаИнкремента.ЗафиксироватьИнкремент(КонтекстИнкремента);
	КонецЕсли;
	Лог.Информация("Расширение '%1' загружено из файлов %2", ИмяРасширения, КаталогИсходников);

КонецПроцедуры

// Выгрузить расширение из базы в файл (.cfe).
// Параметры:
//   ПараметрыПодключения - Структура - строка подключения, пользователь, пароль
//   ПутьКФайлуCfe        - Строка    - путь к выходному .cfe-файлу
//   ИмяРасширения        - Строка    - имя расширения в базе
//   ИспользоватьIbcmd    - Булево    - использовать ibcmd вместо конфигуратора
//   ПараметрыПлатформы   - Структура - необязательные параметры платформы
Процедура ВыгрузитьРасширениеВФайл(Знач ПараметрыПодключения, Знач ПутьКФайлуCfe, Знач ИмяРасширения,
	Знач ИспользоватьIbcmd = Ложь, Знач ПараметрыПлатформы = Неопределено) Экспорт

	Движок = ВыбратьДвижок(ИспользоватьIbcmd);
	Лог.Отладка("Выгрузка расширения в файл: файл=%1, имя=%2, движок=%3", ПутьКФайлуCfe, ИмяРасширения, Движок);
	Движок.ВыгрузитьРасширениеВФайл(ПараметрыПодключения, ПутьКФайлуCfe, ИмяРасширения, ПараметрыПлатформы);
	Лог.Информация("Расширение '%1' выгружено в файл %2", ИмяРасширения, ПутьКФайлуCfe);

КонецПроцедуры

// Собрать расширение в .cfe-файл из XML-исходников.
// Использует временную базу: загружает XML-исходники, затем выгружает .cfe.
// Параметры:
//   КаталогИсходников    - Строка    - каталог с XML-файлами расширения
//   ПутьКФайлуCfe        - Строка    - путь к выходному .cfe-файлу
//   ИмяРасширения        - Строка    - имя расширения
//   ИспользоватьIbcmd    - Булево    - использовать ibcmd вместо конфигуратора
//   ПараметрыПлатформы   - Структура - необязательные параметры платформы
//   ПараметрыПодключения - Структура - если задано - использовать реальную базу вместо временной
Процедура СобратьВФайлCfe(Знач КаталогИсходников, Знач ПутьКФайлуCfe, Знач ИмяРасширения,
	Знач ИспользоватьIbcmd = Ложь, Знач ПараметрыПлатформы = Неопределено,
	Знач ПараметрыПодключения = Неопределено, Знач ПараметрыИсходников = Неопределено) Экспорт

	Движок = ВыбратьДвижок(ИспользоватьIbcmd);
	Лог.Отладка("Сборка CFE: исходники=%1, выход=%2, имя=%3, движок=%4",
		КаталогИсходников, ПутьКФайлуCfe, ИмяРасширения, Движок);

	КонтекстEDT = СервисEDT.ПодготовитьXML(КаталогИсходников, ПараметрыИсходников);
	Попытка
		КонтекстБазы = ПодготовитьБазу(Движок, ПараметрыПодключения, ПараметрыПлатформы);
		Попытка
			Лог.Информация("Загрузка расширения '%1' в базу из исходников %2…", ИмяРасширения, КаталогИсходников);
			Движок.ЗагрузитьРасширениеИзФайлов(
				КонтекстБазы.ПараметрыПодключения, КонтекстEDT.Путь, ИмяРасширения, ПараметрыПлатформы);
			Лог.Информация("Выгрузка расширения '%1' в файл %2…", ИмяРасширения, ПутьКФайлуCfe);
			Движок.ВыгрузитьРасширениеВФайл(КонтекстБазы.ПараметрыПодключения, ПутьКФайлуCfe, ИмяРасширения, ПараметрыПлатформы);
		Исключение
			ОчиститьВременнуюБазу(КонтекстБазы);
			ВызватьИсключение;
		КонецПопытки;
		ОчиститьВременнуюБазу(КонтекстБазы);
	Исключение
		СервисEDT.ЗавершитьXML(КонтекстEDT);
		ВызватьИсключение;
	КонецПопытки;
	СервисEDT.ЗавершитьXML(КонтекстEDT);

	Лог.Информация("Расширение '%1' успешно собрано в файл %2", ИмяРасширения, ПутьКФайлуCfe);

КонецПроцедуры

// Разобрать расширение в XML-исходники: из файла .cfe либо напрямую из указанной базы.
// Если ПутьКФайлуCfe задан - расширение загружается во временную (или указанную) базу,
// после чего выгружается в исходники. Если путь не задан - стадия загрузки пропускается
// и расширение выгружается из переданной базы (ПараметрыПодключения).
// Параметры:
//   ПутьКФайлуCfe        - Строка    - путь к .cfe-файлу (пусто => выгрузка из переданной базы)
//   КаталогВыгрузки      - Строка    - каталог для XML-исходников
//   ИмяРасширения        - Строка    - имя расширения
//   ИспользоватьIbcmd    - Булево    - использовать ibcmd вместо конфигуратора
//   ПараметрыПлатформы   - Структура - необязательные параметры платформы
//   ПараметрыПодключения - Структура - если задано - использовать реальную базу вместо временной
Процедура РазобратьРасширениеВИсходники(Знач ПутьКФайлуCfe, Знач КаталогВыгрузки, Знач ИмяРасширения,
	Знач ИспользоватьIbcmd = Ложь, Знач ПараметрыПлатформы = Неопределено,
	Знач ПараметрыПодключения = Неопределено, Знач ПараметрыИсходников = Неопределено) Экспорт

	ЗагружатьИзФайла = ЗначениеЗаполнено(ПутьКФайлуCfe);
	БазаПередана = ПараметрыПодключения <> Неопределено
		И ЗначениеЗаполнено(ПараметрыПодключения.СтрокаПодключения);

	Если НЕ ЗагружатьИзФайла И НЕ БазаПередана Тогда
		ВызватьИсключение "Не задан файл cfe и не передана информационная база: нечего выгружать в исходники";
	КонецЕсли;

	Движок = ВыбратьДвижок(ИспользоватьIbcmd);
	Лог.Отладка("Разборка CFE: файл=%1, выход=%2, имя=%3, движок=%4",
		ПутьКФайлуCfe, КаталогВыгрузки, ИмяРасширения, Движок);

	КонтекстВыгрузки = СервисEDT.НачатьВыгрузку(КаталогВыгрузки, ПараметрыИсходников);
	Попытка
		КонтекстБазы = ПодготовитьБазу(Движок, ПараметрыПодключения, ПараметрыПлатформы);
		Попытка
			Если ЗагружатьИзФайла Тогда
				Лог.Информация("Загрузка расширения '%1' из файла %2…", ИмяРасширения, ПутьКФайлуCfe);
				Движок.ЗагрузитьРасширениеИзФайла(
					КонтекстБазы.ПараметрыПодключения, ПутьКФайлуCfe, ИмяРасширения, ПараметрыПлатформы);
			КонецЕсли;
			Лог.Информация("Выгрузка расширения '%1' в исходники %2…", ИмяРасширения, КаталогВыгрузки);
			Движок.ВыгрузитьРасширениеВФайлы(
				КонтекстБазы.ПараметрыПодключения, КонтекстВыгрузки.Путь, ИмяРасширения, ПараметрыПлатформы);
		Исключение
			ОчиститьВременнуюБазу(КонтекстБазы);
			ВызватьИсключение;
		КонецПопытки;
		ОчиститьВременнуюБазу(КонтекстБазы);
		СервисEDT.ЗавершитьВыгрузку(КонтекстВыгрузки);
	Исключение
		СервисEDT.ЗавершитьXML(КонтекстВыгрузки);
		ВызватьИсключение;
	КонецПопытки;

	Лог.Информация("Расширение '%1' успешно разобрано в каталог %2", ИмяРасширения, КаталогВыгрузки);

КонецПроцедуры

// Изменить свойства расширения в базе (только ibcmd).
// Параметры:
//   ПараметрыПодключения - Структура - строка подключения, пользователь, пароль
//   ИмяРасширения        - Строка    - имя расширения в базе
//   Свойства             - Структура - свойства: Активность, БезопасныйРежим,
//                                       ИмяПрофиляБезопасности, ЗащитаОтОпасныхДействий,
//                                       ИспользуетсяВ_РИБ, ОбластьДействия_ИБ
//   ПараметрыПлатформы   - Структура - необязательные параметры платформы
Процедура ИзменитьСвойстваРасширения(Знач ПараметрыПодключения, Знач ИмяРасширения, Знач Свойства,
	Знач ПараметрыПлатформы = Неопределено) Экспорт

	Движок = Движки["ДвижокIbcmd"];
	Лог.Отладка("Изменение свойств расширения '%1' через ibcmd", ИмяРасширения);
	Движок.ИзменитьСвойстваРасширения(ПараметрыПодключения, ИмяРасширения, Свойства, ПараметрыПлатформы);
	Лог.Информация("Свойства расширения '%1' обновлены", ИмяРасширения);

КонецПроцедуры

// Установить свойства уже загруженного расширения через обработку РаботаСРасширениями
// (режим ТолькоУстановитьПараметрыРасширения). Применяется в конфигураторном режиме, где
// свойства расширения нельзя задать средствами командной строки конфигуратора.
// Параметры:
//   ПараметрыПодключения - Структура - строка подключения, пользователь, пароль
//   ИмяРасширения        - Строка    - имя расширения в базе
//   Свойства             - Структура - булевы свойства: Активность, БезопасныйРежим,
//                                       ЗащитаОтОпасныхДействий (Истина -> включить;
//                                       Ложь -> свойство не меняется)
//   ПараметрыПлатформы   - Структура - необязательные параметры платформы
Процедура УстановитьПараметрыРасширенияЧерезОбработку(Знач ПараметрыПодключения, Знач ИмяРасширения,
	Знач Свойства, Знач ПараметрыПлатформы = Неопределено) Экспорт

	Параметры = Новый Структура;
	Параметры.Вставить("ТолькоУстановитьПараметрыРасширения", Истина);
	Параметры.Вставить("Имя", ИмяРасширения);
	// Булево Истина -> голый флаг (включить свойство), Булево Ложь -> опускается
	// (СформироватьСтрокуПараметров), и обработка не меняет неуказанное свойство.
	Для Каждого КлючЗначение Из Свойства Цикл
		Параметры.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;

	Лог.Отладка("Установка свойств расширения '%1' через обработку РаботаСРасширениями", ИмяРасширения);
	СервисЗапускаОбработок.ВыполнитьОбработку(
		"РаботаСРасширениями", ПараметрыПодключения, Параметры, ПараметрыПлатформы);
	Лог.Информация("Свойства расширения '%1' обновлены", ИмяРасширения);

КонецПроцедуры

// Создать пустое расширение конфигурации с заданным именем.
// Имя расширения нельзя задать через API РасширенияКонфигурации (свойство Имя только на чтение),
// поэтому создаём минимальные XML-исходники пустого расширения и загружаем их конфигуратором
// с ключом -Extension. Конфигуратор молча перезаписывает существующее расширение, поэтому при
// ОтсутствииПерезаписи сначала проверяем, что расширения с таким именем ещё нет.
// Параметры:
//   ПараметрыПодключения - Структура - строка подключения, пользователь, пароль
//   ИмяРасширения        - Строка    - имя создаваемого расширения
//   Перезаписывать       - Булево    - пересоздать, если расширение уже существует
//   ПараметрыПлатформы   - Структура - необязательные параметры платформы
Процедура СоздатьПустоеРасширение(Знач ПараметрыПодключения, Знач ИмяРасширения,
	Знач Перезаписывать = Ложь, Знач ПараметрыПлатформы = Неопределено) Экспорт

	Если НЕ Булево(Перезаписывать)
		И РасширениеУстановлено(ПараметрыПодключения, ИмяРасширения, ПараметрыПлатформы) Тогда
		ВызватьИсключение СтрШаблон("Расширение '%1' уже существует."
			+ " Для пересоздания укажите параметр --overwrite.", ИмяРасширения);
	КонецЕсли;

	Движок = Движки["ДвижокКонфигуратор"];
	КаталогИсточников = СоздатьИсходникиПустогоРасширения(ИмяРасширения);
	Лог.Отладка("Создание пустого расширения '%1' из исходников %2", ИмяРасширения, КаталогИсточников);

	Попытка
		Движок.ЗагрузитьРасширениеИзФайлов(ПараметрыПодключения, КаталогИсточников, ИмяРасширения, ПараметрыПлатформы);
	Исключение
		УдалитьФайлы(КаталогИсточников);
		ВызватьИсключение;
	КонецПопытки;
	УдалитьФайлы(КаталогИсточников);

	Лог.Информация("Создано пустое расширение '%1'", ИмяРасширения);

КонецПроцедуры

// Сравнить расширения (только конфигуратор).
// Параметры:
//   ПараметрыПодключения - Структура - строка подключения, пользователь, пароль
//   ИмяРасширения  - Строка    - имя расширения в базе (используется как ПервыйФайл, если ПервыйФайл не задан)
//   ВторойФайл     - Строка    - путь ко .cfe-файлу, с которым сравниваем
//   ПутьКФайлуОтчета - Строка    - путь к выходному файлу отчета
//   ТипОтчета         - Строка    - Full или Brief
//   ФорматОтчета      - Строка    - txt или mxl
//   ПервыйФайл       - Строка    - если задан, сравниваем два .cfe-файла; иначе - расширение из базы
//   ПараметрыПлатформы - Структура - необязательные параметры платформы
//
// Возвращаемое значение:
//   Строка - путь к файлу отчета о сравнении
//
Функция СравнитьРасширения(Знач ПараметрыПодключения, Знач ИмяРасширения, Знач Второйфайл,
	Знач ПутьКФайлуОтчета, Знач ТипОтчета, Знач ФорматОтчета,
	Знач ПервыйФайл = Неопределено,
	Знач ПараметрыПлатформы = Неопределено) Экспорт

	Движок = Движки["ДвижокКонфигуратор"];
	Лог.Отладка("Сравнение расширений: имя=%1, второй=%2", ИмяРасширения, ВторойФайл);

	КонтекстБазы = ПодготовитьБазу(Движок, ПараметрыПодключения, ПараметрыПлатформы);

	Попытка
		Лог.Информация("Сравнение расширения '%1', отчёт: %2…", ИмяРасширения, ПутьКФайлуОтчета);
		ПутьОтчета = Движок.СравнитьРасширения(
			КонтекстБазы.ПараметрыПодключения,
			ИмяРасширения,
			Второйфайл,
			ПутьКФайлуОтчета,
			ТипОтчета,
			ФорматОтчета,
			ПервыйФайл,
			ПараметрыПлатформы);
	Исключение
		ОчиститьВременнуюБазу(КонтекстБазы);
		ВызватьИсключение;
	КонецПопытки;

	ОчиститьВременнуюБазу(КонтекстБазы);
	Лог.Информация("Отчет о сравнении расширений сохранен: %1", ПутьОтчета);
	Возврат ПутьОтчета;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Проверяет, установлено ли расширение с заданным именем (через обработку, режим списка).
// Возвращаемое значение:
//   Булево - Истина, если расширение с таким именем уже установлено
Функция РасширениеУстановлено(Знач ПараметрыПодключения, Знач ИмяРасширения, Знач ПараметрыПлатформы)

	Параметры = Новый Структура("СписокРасширений", Истина);
	Результат = СервисЗапускаОбработок.ВыполнитьОбработку(
		"РаботаСРасширениями", ПараметрыПодключения, Параметры, ПараметрыПлатформы);

	Для Каждого Сообщение Из Результат.Сообщения Цикл
		// Имена расширений выводятся отдельными строками; служебные строки содержат пробелы/двоеточия
		// и не совпадут с именем-идентификатором точным сравнением.
		Если СокрЛП(Сообщение) = ИмяРасширения Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Создаёт во временном каталоге минимальные XML-исходники пустого расширения и возвращает путь.
// Возвращаемое значение:
//   Строка - путь к каталогу с исходниками (удаляется вызывающим кодом)
Функция СоздатьИсходникиПустогоРасширения(Знач ИмяРасширения)

	КаталогИсточников = ПолучитьИмяВременногоФайла();
	СоздатьКаталог(КаталогИсточников);
	СоздатьКаталог(ОбъединитьПути(КаталогИсточников, "Languages"));

	ЗаписатьТекстВФайл(
		ОбъединитьПути(КаталогИсточников, "Configuration.xml"),
		ТекстConfigurationXmlПустогоРасширения(ИмяРасширения));
	ЗаписатьТекстВФайл(
		ОбъединитьПути(КаталогИсточников, "Languages", "Русский.xml"),
		ТекстЯзыкаРусский());

	Возврат КаталогИсточников;

КонецФункции

Процедура ЗаписатьТекстВФайл(Знач ПутьКФайлу, Знач Текст)

	Запись = Новый ЗаписьТекста(ПутьКФайлу, КодировкаТекста.UTF8);
	Запись.Записать(Текст);
	Запись.Закрыть();

КонецПроцедуры

Функция ТекстConfigurationXmlПустогоРасширения(Знач ИмяРасширения)

	Строки = Новый Массив;
	Строки.Добавить("<?xml version=""1.0"" encoding=""UTF-8""?>");
	Строки.Добавить("<MetaDataObject xmlns=""http://v8.1c.ru/8.3/MDClasses"" xmlns:v8=""http://v8.1c.ru/8.1/data/core"""
		+ " xmlns:xr=""http://v8.1c.ru/8.3/xcf/readable"" xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance"" version=""2.4"">");
	Строки.Добавить("	<Configuration uuid=""11111111-1111-4111-8111-111111111111"">");
	Строки.Добавить("		<InternalInfo>");
	// ClassId - стабильные идентификаторы типов содержимого конфигурации; ObjectId - уникальные.
	СодержимоеКонфигурации = Новый Соответствие;
	СодержимоеКонфигурации.Вставить("9cd510cd-abfc-11d4-9434-004095e12fc7", "a1000000-0000-4000-8000-000000000001");
	СодержимоеКонфигурации.Вставить("9fcd25a0-4822-11d4-9414-008048da11f9", "a1000000-0000-4000-8000-000000000002");
	СодержимоеКонфигурации.Вставить("e3687481-0a87-462c-a166-9f34594f9bba", "a1000000-0000-4000-8000-000000000003");
	СодержимоеКонфигурации.Вставить("9de14907-ec23-4a07-96f0-85521cb6b53b", "a1000000-0000-4000-8000-000000000004");
	СодержимоеКонфигурации.Вставить("51f2d5d8-ea4d-4064-8892-82951750031e", "a1000000-0000-4000-8000-000000000005");
	СодержимоеКонфигурации.Вставить("e68182ea-4237-4383-967f-90c1e3370bc7", "a1000000-0000-4000-8000-000000000006");
	Для Каждого КлассИОбъект Из СодержимоеКонфигурации Цикл
		Строки.Добавить(СтрШаблон(
			"			<xr:ContainedObject><xr:ClassId>%1</xr:ClassId><xr:ObjectId>%2</xr:ObjectId></xr:ContainedObject>",
			КлассИОбъект.Ключ, КлассИОбъект.Значение));
	КонецЦикла;
	Строки.Добавить("		</InternalInfo>");
	Строки.Добавить("		<Properties>");
	Строки.Добавить(СтрШаблон("			<Name>%1</Name>", ИмяРасширения));
	Строки.Добавить(СтрШаблон("			<Synonym><v8:item><v8:lang>ru</v8:lang><v8:content>%1</v8:content></v8:item></Synonym>", ИмяРасширения));
	Строки.Добавить("			<ConfigurationExtensionPurpose>Customization</ConfigurationExtensionPurpose>");
	Строки.Добавить("			<ObjectBelonging>Adopted</ObjectBelonging>");
	Строки.Добавить(СтрШаблон("			<NamePrefix>%1_</NamePrefix>", ИмяРасширения));
	Строки.Добавить("			<ScriptVariant>Russian</ScriptVariant>");
	Строки.Добавить("			<Version>1.0.0.0</Version>");
	Строки.Добавить("			<DefaultLanguage>Language.Русский</DefaultLanguage>");
	Строки.Добавить("		</Properties>");
	Строки.Добавить("		<ChildObjects><Language>Русский</Language></ChildObjects>");
	Строки.Добавить("	</Configuration>");
	Строки.Добавить("</MetaDataObject>");

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция ТекстЯзыкаРусский()

	Строки = Новый Массив;
	Строки.Добавить("<?xml version=""1.0"" encoding=""UTF-8""?>");
	Строки.Добавить("<MetaDataObject xmlns=""http://v8.1c.ru/8.3/MDClasses"" xmlns:v8=""http://v8.1c.ru/8.1/data/core"""
		+ " xmlns:xr=""http://v8.1c.ru/8.3/xcf/readable"" xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance"" version=""2.4"">");
	Строки.Добавить("	<Language uuid=""22222222-2222-4222-8222-222222222222"">");
	Строки.Добавить("		<Properties>");
	Строки.Добавить("			<Name>Русский</Name>");
	Строки.Добавить("			<Synonym><v8:item><v8:lang>ru</v8:lang><v8:content>Русский</v8:content></v8:item></Synonym>");
	Строки.Добавить("			<LanguageCode>ru</LanguageCode>");
	Строки.Добавить("		</Properties>");
	Строки.Добавить("	</Language>");
	Строки.Добавить("</MetaDataObject>");

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция ВыбратьДвижок(ИспользоватьIbcmd)

	Если ЗначениеЗаполнено(ИспользоватьIbcmd) И Булево(ИспользоватьIbcmd) Тогда
		Возврат Движки["ДвижокIbcmd"];
	КонецЕсли;

	Возврат Движки["ДвижокКонфигуратор"];

КонецФункции

Функция ПодготовитьБазу(Движок, ПараметрыПодключения, ПараметрыПлатформы)

	Результат = Новый Структура("ПараметрыПодключения, Временная", ПараметрыПодключения, Ложь);

	Если ПараметрыПодключения <> Неопределено
		И ЗначениеЗаполнено(ПараметрыПодключения.СтрокаПодключения) Тогда
		Возврат Результат;
	КонецЕсли;

	Лог.Информация("Создаётся временная информационная база…");
	Результат.ПараметрыПодключения = Движок.СоздатьВременнуюБазу(ПараметрыПлатформы);
	Результат.Временная = Истина;
	Лог.Отладка("Создана временная ИБ: %1", Результат.ПараметрыПодключения.КаталогБазы);

	Возврат Результат;

КонецФункции

Процедура ОчиститьВременнуюБазу(КонтекстБазы)

	Если НЕ КонтекстБазы.Временная Тогда
		Возврат;
	КонецЕсли;

	Лог.Отладка("Удаление временной ИБ: %1", КонтекстБазы.ПараметрыПодключения.КаталогБазы);
	Попытка
		УдалитьФайлы(КонтекстБазы.ПараметрыПодключения.КаталогБазы);
	Исключение
		Лог.Предупреждение("Не удалось удалить временную ИБ: %1", ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

#КонецОбласти
