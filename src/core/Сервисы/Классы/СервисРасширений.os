// BSLLS:NumberOfValuesInStructureConstructor-off
// BSLLS:MissingVariablesDescription-off Поля autumn
// BSLLS:NumberOfOptionalParams-off
// BSLLS:NumberOfParams-off
// BSLLS:Typo-off (&Лог/&Пластилин/&Напильник) и внутреннее состояние сервиса.
// Сервис операций с расширениями конфигурации.
// Фасад: единый интерфейс к операциям с расширениями.
// Маршрутизирует вызовы к нужному движку (конфигуратор или ibcmd),
// оркестрирует пайплайны (создание базы → загрузка → выгрузка → очистка).

&Лог("vrunner")
Перем Лог;

&Пластилин(Значение = "ДвижокПлатформы", Тип = "Соответствие")
Перем Движки;

&Пластилин
Перем СервисРасчетаИнкремента;

&Пластилин
Перем СервисОкружения;

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Загрузить расширение в базу из файла (.cfe).
// При конфигураторном режиме по умолчанию загружает через 1С:Предприятие (EPF),
// что позволяет установить свойства расширения при загрузке.
// Параметры:
//   ПараметрыПодключения      - Структура - строка подключения, пользователь, пароль
//   ПутьКФайлуCfe             - Строка    - путь к .cfe-файлу
//   ИмяРасширения             - Строка    - имя расширения в базе
//   ИспользоватьIbcmd         - Булево    - использовать ibcmd вместо конфигуратора
//   ПараметрыПлатформы        - Структура - необязательные параметры платформы
//   ПараметрыРасширения       - Структура - свойства: БезопасныйРежим, ЗащитаОтОпасныхДействий
//   ОтключитьЭнтерпрайзРежим - Булево    - загружать через конфигуратор напрямую, без EPF
Процедура ЗагрузитьРасширениеВБазуИзФайла(Знач ПараметрыПодключения, Знач ПутьКФайлуCfe, Знач ИмяРасширения,
	Знач ИспользоватьIbcmd = Ложь, Знач ПараметрыПлатформы = Неопределено,
	Знач ПараметрыРасширения = Неопределено, Знач ОтключитьЭнтерпрайзРежим = Ложь) Экспорт

	Если НЕ ИспользоватьIbcmd И НЕ ОтключитьЭнтерпрайзРежим Тогда
		ЗагрузитьИзФайлаЧерезЭнтерпрайз(ПараметрыПодключения, ПутьКФайлуCfe, ИмяРасширения,
			ПараметрыРасширения, ПараметрыПлатформы);
		Возврат;
	КонецЕсли;

	Движок = ВыбратьДвижок(ИспользоватьIbcmd);
	Лог.Отладка("Загрузка расширения из файла: файл=%1, имя=%2, движок=%3", ПутьКФайлуCfe, ИмяРасширения, Движок);
	Движок.ЗагрузитьРасширениеИзФайла(ПараметрыПодключения, ПутьКФайлуCfe, ИмяРасширения, ПараметрыПлатформы);
	Лог.Информация("Расширение '%1' загружено из файла %2", ИмяРасширения, ПутьКФайлуCfe);

КонецПроцедуры

// Загрузить расширение в базу из XML-исходников.
// При конфигураторном режиме по умолчанию загружает через 1С:Предприятие (EPF),
// компилируя исходники во временный .cfe. Инкремент не поддерживается в режиме EPF.
// Параметры:
//   ПараметрыПодключения      - Структура - строка подключения, пользователь, пароль
//   КаталогИсходников         - Строка    - каталог с XML-файлами расширения
//   ИмяРасширения             - Строка    - имя расширения в базе
//   ИспользоватьIbcmd         - Булево    - использовать ibcmd вместо конфигуратора
//   ПараметрыПлатформы        - Структура - необязательные параметры платформы
//   ИнкрементальнаяЗагрузка   - Булево    - инкрементальная загрузка по индексу изменений (только ibcmd/прямой конфигуратор)
//   ПараметрыРасширения       - Структура - свойства: БезопасныйРежим, ЗащитаОтОпасныхДействий
//   ОтключитьЭнтерпрайзРежим - Булево    - загружать через конфигуратор напрямую, без EPF
Процедура ЗагрузитьРасширениеВБазуИзФайлов(Знач ПараметрыПодключения, Знач КаталогИсходников, Знач ИмяРасширения,
	Знач ИспользоватьIbcmd = Ложь, Знач ПараметрыПлатформы = Неопределено, Знач ИнкрементальнаяЗагрузка = Ложь,
	Знач ПараметрыРасширения = Неопределено, Знач ОтключитьЭнтерпрайзРежим = Ложь) Экспорт

	Если НЕ ИспользоватьIbcmd И НЕ ОтключитьЭнтерпрайзРежим Тогда
		Если ИнкрементальнаяЗагрузка Тогда
			Лог.Предупреждение("Инкрементальная загрузка не поддерживается в режиме 1С:Предприятие. Выполняется полная загрузка.");
		КонецЕсли;
		ЗагрузитьИзКаталогаЧерезЭнтерпрайз(ПараметрыПодключения, КаталогИсходников, ИмяРасширения,
			ПараметрыРасширения, ПараметрыПлатформы);
		Возврат;
	КонецЕсли;

	Движок = ВыбратьДвижок(ИспользоватьIbcmd);
	КонтекстИнкремента = Неопределено;
	СписокФайлов = "";
	Если ИнкрементальнаяЗагрузка = Истина Тогда
		РезультатИнкремента = СервисРасчетаИнкремента.РассчитатьИнкрементДляЗагрузкиРасширения(
			КаталогИсходников,
			ПараметрыПодключения,
			ИмяРасширения,
			ИспользоватьIbcmd,
			ПараметрыПлатформы);
		КонтекстИнкремента = РезультатИнкремента.КонтекстИнкремента;
		Если РезультатИнкремента.ПропуститьЗагрузку Тогда
			Возврат;
		КонецЕсли;
		СписокФайлов = РезультатИнкремента.СписокФайловДляЗагрузки;
	КонецЕсли;

	Лог.Отладка("Загрузка расширения из файлов: каталог=%1, имя=%2, движок=%3", КаталогИсходников, ИмяРасширения, Движок);
	Движок.ЗагрузитьРасширениеИзФайлов(ПараметрыПодключения, КаталогИсходников, ИмяРасширения, ПараметрыПлатформы, СписокФайлов);
	Если КонтекстИнкремента <> Неопределено Тогда
		СервисРасчетаИнкремента.ЗафиксироватьИнкремент(КонтекстИнкремента);
	КонецЕсли;
	Лог.Информация("Расширение '%1' загружено из файлов %2", ИмяРасширения, КаталогИсходников);

КонецПроцедуры

// Выгрузить расширение из базы в файл (.cfe).
// Параметры:
//   ПараметрыПодключения - Структура - строка подключения, пользователь, пароль
//   ПутьКФайлуCfe        - Строка    - путь к выходному .cfe-файлу
//   ИмяРасширения        - Строка    - имя расширения в базе
//   ИспользоватьIbcmd    - Булево    - использовать ibcmd вместо конфигуратора
//   ПараметрыПлатформы   - Структура - необязательные параметры платформы
Процедура ВыгрузитьРасширениеВФайл(Знач ПараметрыПодключения, Знач ПутьКФайлуCfe, Знач ИмяРасширения,
	Знач ИспользоватьIbcmd = Ложь, Знач ПараметрыПлатформы = Неопределено) Экспорт

	Движок = ВыбратьДвижок(ИспользоватьIbcmd);
	Лог.Отладка("Выгрузка расширения в файл: файл=%1, имя=%2, движок=%3", ПутьКФайлуCfe, ИмяРасширения, Движок);
	Движок.ВыгрузитьРасширениеВФайл(ПараметрыПодключения, ПутьКФайлуCfe, ИмяРасширения, ПараметрыПлатформы);
	Лог.Информация("Расширение '%1' выгружено в файл %2", ИмяРасширения, ПутьКФайлуCfe);

КонецПроцедуры

// Собрать расширение в .cfe-файл из XML-исходников.
// Использует временную базу: загружает XML-исходники, затем выгружает .cfe.
// Параметры:
//   КаталогИсходников    - Строка    - каталог с XML-файлами расширения
//   ПутьКФайлуCfe        - Строка    - путь к выходному .cfe-файлу
//   ИмяРасширения        - Строка    - имя расширения
//   ИспользоватьIbcmd    - Булево    - использовать ibcmd вместо конфигуратора
//   ПараметрыПлатформы   - Структура - необязательные параметры платформы
//   ПараметрыПодключения - Структура - если задано - использовать реальную базу вместо временной
Процедура СобратьВФайлCfe(Знач КаталогИсходников, Знач ПутьКФайлуCfe, Знач ИмяРасширения,
	Знач ИспользоватьIbcmd = Ложь, Знач ПараметрыПлатформы = Неопределено, Знач ПараметрыПодключения = Неопределено) Экспорт

	Движок = ВыбратьДвижок(ИспользоватьIbcmd);
	Лог.Отладка("Сборка CFE: исходники=%1, выход=%2, имя=%3, движок=%4",
		КаталогИсходников, ПутьКФайлуCfe, ИмяРасширения, Движок);

	КонтекстБазы = ПодготовитьБазу(Движок, ПараметрыПодключения, ПараметрыПлатформы);

	Попытка
		Движок.ЗагрузитьРасширениеИзФайлов(КонтекстБазы.ПараметрыПодключения, КаталогИсходников, ИмяРасширения, ПараметрыПлатформы);
		Движок.ВыгрузитьРасширениеВФайл(КонтекстБазы.ПараметрыПодключения, ПутьКФайлуCfe, ИмяРасширения, ПараметрыПлатформы);
	Исключение
		ОчиститьВременнуюБазу(КонтекстБазы);
		ВызватьИсключение;
	КонецПопытки;

	ОчиститьВременнуюБазу(КонтекстБазы);
	Лог.Информация("Расширение '%1' успешно собрано в файл %2", ИмяРасширения, ПутьКФайлуCfe);

КонецПроцедуры

// Разобрать .cfe-файл в XML-исходники.
// Использует временную базу: загружает .cfe, затем выгружает XML-файлы.
// Параметры:
//   ПутьКФайлуCfe        - Строка    - путь к .cfe-файлу
//   КаталогВыгрузки      - Строка    - каталог для XML-исходников
//   ИмяРасширения        - Строка    - имя расширения
//   ИспользоватьIbcmd    - Булево    - использовать ibcmd вместо конфигуратора
//   ПараметрыПлатформы   - Структура - необязательные параметры платформы
//   ПараметрыПодключения - Структура - если задано - использовать реальную базу вместо временной
Процедура РазобратьИзФайлаCfe(Знач ПутьКФайлуCfe, Знач КаталогВыгрузки, Знач ИмяРасширения,
	Знач ИспользоватьIbcmd = Ложь, Знач ПараметрыПлатформы = Неопределено, Знач ПараметрыПодключения = Неопределено) Экспорт

	Движок = ВыбратьДвижок(ИспользоватьIbcmd);
	Лог.Отладка("Разборка CFE: файл=%1, выход=%2, имя=%3, движок=%4",
		ПутьКФайлуCfe, КаталогВыгрузки, ИмяРасширения, Движок);

	КонтекстБазы = ПодготовитьБазу(Движок, ПараметрыПодключения, ПараметрыПлатформы);

	Попытка
		Движок.ЗагрузитьРасширениеИзФайла(КонтекстБазы.ПараметрыПодключения, ПутьКФайлуCfe, ИмяРасширения, ПараметрыПлатформы);
		Движок.ВыгрузитьРасширениеВФайлы(КонтекстБазы.ПараметрыПодключения, КаталогВыгрузки, ИмяРасширения, ПараметрыПлатформы);
	Исключение
		ОчиститьВременнуюБазу(КонтекстБазы);
		ВызватьИсключение;
	КонецПопытки;

	ОчиститьВременнуюБазу(КонтекстБазы);
	Лог.Информация("Расширение '%1' успешно разобрано в каталог %2", ИмяРасширения, КаталогВыгрузки);

КонецПроцедуры

// Изменить свойства расширения в базе (только ibcmd).
// Параметры:
//   ПараметрыПодключения - Структура - строка подключения, пользователь, пароль
//   ИмяРасширения        - Строка    - имя расширения в базе
//   Свойства             - Структура - свойства: Активность, БезопасныйРежим,
//                                       ИмяПрофиляБезопасности, ЗащитаОтОпасныхДействий,
//                                       ИспользуетсяВ_РИБ, ОбластьДействия_ИБ
//   ПараметрыПлатформы   - Структура - необязательные параметры платформы
Процедура ИзменитьСвойстваРасширения(Знач ПараметрыПодключения, Знач ИмяРасширения, Знач Свойства,
	Знач ПараметрыПлатформы = Неопределено) Экспорт

	Движок = Движки["ДвижокIbcmd"];
	Лог.Отладка("Изменение свойств расширения '%1' через ibcmd", ИмяРасширения);
	Движок.ИзменитьСвойстваРасширения(ПараметрыПодключения, ИмяРасширения, Свойства, ПараметрыПлатформы);
	Лог.Информация("Свойства расширения '%1' обновлены", ИмяРасширения);

КонецПроцедуры

// Сравнить расширения (только конфигуратор).
// Параметры:
//   ПараметрыПодключения - Структура - строка подключения, пользователь, пароль
//   ИмяРасширения  - Строка    - имя расширения в базе (используется как ПервыйФайл, если ПервыйФайл не задан)
//   ВторойФайл     - Строка    - путь ко .cfe-файлу, с которым сравниваем
//   ПутьКФайлуОтчета - Строка    - путь к выходному файлу отчета
//   ТипОтчета         - Строка    - Full или Brief
//   ФорматОтчета      - Строка    - txt или mxl
//   ПервыйФайл       - Строка    - если задан, сравниваем два .cfe-файла; иначе - расширение из базы
//   ПараметрыПлатформы - Структура - необязательные параметры платформы
//
// Возвращаемое значение:
//   Строка - путь к файлу отчета о сравнении
//
Функция СравнитьРасширения(Знач ПараметрыПодключения, Знач ИмяРасширения, Знач Второйфайл,
	Знач ПутьКФайлуОтчета, Знач ТипОтчета, Знач ФорматОтчета,
	Знач ПервыйФайл = Неопределено,
	Знач ПараметрыПлатформы = Неопределено) Экспорт

	Движок = Движки["ДвижокКонфигуратор"];
	Лог.Отладка("Сравнение расширений: имя=%1, второй=%2", ИмяРасширения, ВторойФайл);

	КонтекстБазы = ПодготовитьБазу(Движок, ПараметрыПодключения, ПараметрыПлатформы);

	Попытка
		ПутьОтчета = Движок.СравнитьРасширения(
			КонтекстБазы.ПараметрыПодключения,
			ИмяРасширения,
			Второйфайл,
			ПутьКФайлуОтчета,
			ТипОтчета,
			ФорматОтчета,
			ПервыйФайл,
			ПараметрыПлатформы);
	Исключение
		ОчиститьВременнуюБазу(КонтекстБазы);
		ВызватьИсключение;
	КонецПопытки;

	ОчиститьВременнуюБазу(КонтекстБазы);
	Лог.Информация("Отчет о сравнении расширений сохранен: %1", ПутьОтчета);
	Возврат ПутьОтчета;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗагрузитьИзФайлаЧерезЭнтерпрайз(Знач ПараметрыПодключения, Знач ПутьКФайлуCfe,
	Знач ИмяРасширения, Знач ПараметрыРасширения, Знач ПараметрыПлатформы)

	РасшПараметры = НормализоватьПараметрыРасширения(ПараметрыРасширения);
	КомандаЗапуска = СформироватьКомандуЗагрузкиРасширения(ПутьКФайлуCfe, ИмяРасширения, РасшПараметры);
	ПутьКEpf = ПолучитьПутьКОбработкеЗагрузкиРасширения();
	ПараметрыЗапуска = Новый Структура(
		"КомандаЗапуска, ПутьОбработки, НавигационнаяСсылка, НеОжидать, РежимЗапуска, ДополнительныеПараметры, ПутьКФайлуСтатуса",
		КомандаЗапуска, ПутьКEpf, "", Ложь, "", "", "");
	Движок = Движки["ДвижокКонфигуратор"];
	Лог.Отладка("Загрузка расширения через 1С:Предприятие: файл=%1, имя=%2", ПутьКФайлуCfe, ИмяРасширения);
	Движок.ЗапуститьПредприятие(ПараметрыПодключения, ПараметрыЗапуска, ПараметрыПлатформы);
	Лог.Информация("Расширение '%1' загружено через режим 1С:Предприятие", ИмяРасширения);

КонецПроцедуры

Процедура ЗагрузитьИзКаталогаЧерезЭнтерпрайз(Знач ПараметрыПодключения, Знач КаталогИсходников,
	Знач ИмяРасширения, Знач ПараметрыРасширения, Знач ПараметрыПлатформы)

	Лог.Отладка("Сборка расширения из исходников для загрузки через 1С:Предприятие: %1", КаталогИсходников);
	ВременныйCfe = ПолучитьИмяВременногоФайла("cfe");
	Попытка
		СобратьВФайлCfe(КаталогИсходников, ВременныйCfe, ИмяРасширения, Ложь, ПараметрыПлатформы);
		ЗагрузитьИзФайлаЧерезЭнтерпрайз(ПараметрыПодключения, ВременныйCfe, ИмяРасширения,
			ПараметрыРасширения, ПараметрыПлатформы);
	Исключение
		УдалитьФайлы(ВременныйCfe);
		ВызватьИсключение;
	КонецПопытки;
	УдалитьФайлы(ВременныйCfe);

КонецПроцедуры

Функция НормализоватьПараметрыРасширения(Знач ПараметрыРасширения)

	Если ПараметрыРасширения = Неопределено Тогда
		Возврат Новый Структура("БезопасныйРежим, ЗащитаОтОпасныхДействий", Ложь, Ложь);
	КонецЕсли;
	Возврат ПараметрыРасширения;

КонецФункции

Функция ПолучитьПутьКОбработкеЗагрузкиРасширения()

	ПутьКEpf = ОбъединитьПути(СервисОкружения.КорневойКаталогПакета(), "epf", "ЗагрузитьРасширениеВРежимеПредприятия.epf");
	Файл = Новый Файл(ПутьКEpf);
	Если НЕ Файл.Существует() Тогда
		ВызватьИсключение СтрШаблон("EPF-обработка загрузки расширения не найдена: %1", ПутьКEpf);
	КонецЕсли;
	Возврат Файл.ПолноеИмя;

КонецФункции

Функция СформироватьКомандуЗагрузкиРасширения(Знач ПутьКФайлуCfe, Знач ИмяРасширения, Знач ПараметрыРасширения)

	Части = Новый Массив;
	Части.Добавить("Путь=" + ПутьКФайлуCfe);
	Части.Добавить("Имя=" + ИмяРасширения);
	Части.Добавить("Перезаписывать");

	Если ПараметрыРасширения.БезопасныйРежим = Истина Тогда
		Части.Добавить("БезопасныйРежим=Истина");
	Иначе
		Части.Добавить("БезопасныйРежим=Ложь");
	КонецЕсли;

	Если ПараметрыРасширения.ЗащитаОтОпасныхДействий = Истина Тогда
		Части.Добавить("ЗащитаОтОпасныхДействий=Истина");
	Иначе
		Части.Добавить("ЗащитаОтОпасныхДействий=Ложь");
	КонецЕсли;

	Возврат СтрСоединить(Части, ";");

КонецФункции

Функция ВыбратьДвижок(ИспользоватьIbcmd)

	Если ЗначениеЗаполнено(ИспользоватьIbcmd) И Булево(ИспользоватьIbcmd) Тогда
		Возврат Движки["ДвижокIbcmd"];
	КонецЕсли;

	Возврат Движки["ДвижокКонфигуратор"];

КонецФункции

Функция ПодготовитьБазу(Движок, ПараметрыПодключения, ПараметрыПлатформы)

	Результат = Новый Структура("ПараметрыПодключения, Временная", ПараметрыПодключения, Ложь);

	Если ПараметрыПодключения <> Неопределено
		И ЗначениеЗаполнено(ПараметрыПодключения.СтрокаПодключения) Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.ПараметрыПодключения = Движок.СоздатьВременнуюБазу(ПараметрыПлатформы);
	Результат.Временная = Истина;
	Лог.Отладка("Создана временная ИБ: %1", Результат.ПараметрыПодключения.КаталогБазы);

	Возврат Результат;

КонецФункции

Процедура ОчиститьВременнуюБазу(КонтекстБазы)

	Если НЕ КонтекстБазы.Временная Тогда
		Возврат;
	КонецЕсли;

	Лог.Отладка("Удаление временной ИБ: %1", КонтекстБазы.ПараметрыПодключения.КаталогБазы);
	Попытка
		УдалитьФайлы(КонтекстБазы.ПараметрыПодключения.КаталогБазы);
	Исключение
		Лог.Предупреждение("Не удалось удалить временную ИБ: %1", ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

#КонецОбласти
