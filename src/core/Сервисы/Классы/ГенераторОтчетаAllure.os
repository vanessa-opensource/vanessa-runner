// BSLLS:UnusedLocalMethod-off ПриСозданииОбъекта вызывается рантаймом при Новый.
// BSLLS:NumberOfValuesInStructureConstructor-off Описание тест-кейса - плоская структура.
// Формирование результатов проверки в формате Allure 2 (каталог allure-results).
//
// Allure не читает единый файл отчёта: он собирает каталог, в котором на каждый тест-кейс
// лежит свой файл <uuid>-result.json
// (https://allurereport.org/docs/how-it-works-test-result-file/).
// Отсюда и вид опции у команд - каталог, а не путь к файлу, как у --junitpath.
//
// Allure 1 (XML с пространством имён urn:model.allure.qatools.yandex.ru), который в vrunner 2.x
// писала опция --allure-results, здесь не поддерживается: формат заброшен, а результаты
// Allure 2 читают все актуальные версии генератора отчётов.
//
// Каталог результатов не очищается: allure штатно собирает отчёт из результатов нескольких
// прогонов, и очистка затирала бы соседей - тесты и проверки одной сборки обычно пишут
// в общий каталог.

Перем _ИмяНабора; // Строка - имя набора (метка suite), общее для всех кейсов прогона

Процедура ПриСозданииОбъекта(Знач ИмяНабора)

	_ИмяНабора = ИмяНабора;

КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Описание тест-кейса отчёта.
//
// Параметры:
//   Имя    - Строка - имя тест-кейса
//   Статус - Строка - статус Allure: passed, failed, broken или skipped
//
// Возвращаемое значение:
//   Структура:
//    * Имя       - Строка - имя тест-кейса
//    * Статус    - Строка - статус Allure
//    * Сообщение - Строка - текст замечания, показывается в карточке кейса
//    * Пакет     - Строка - объект метаданных либо категория замечания (метка package)
//    * Важность  - Строка - важность Allure: blocker, critical, normal, minor, trivial
//
Функция НовыйСлучай(Знач Имя, Знач Статус = "failed") Экспорт

	Возврат Новый Структура("Имя, Статус, Сообщение, Пакет, Важность",
		Имя, Статус, "", "", "normal");

КонецФункции

// Записать результаты в каталог allure-results: по файлу на тест-кейс.
//
// Время прогона делится между кейсами поровну и раскладывается последовательно: времени
// отдельного замечания у проверки нет, а одинаковые start/stop у всех кейсов превращают
// в отчёте длительность прогона в сумму длительностей всех кейсов.
//
// Параметры:
//   КаталогРезультатов - Строка - каталог allure-results; создаётся, если его нет
//   Случаи             - Массив - Элементы <Структура> (см. НовыйСлучай)
//   ДатаНачалаUTC      - Дата   - начало прогона, универсальное время
//   ДлительностьСек    - Число  - длительность прогона в секундах
//
// Возвращаемое значение:
//   Число - количество записанных файлов
//
Функция Записать(Знач КаталогРезультатов, Знач Случаи, Знач ДатаНачалаUTC, Знач ДлительностьСек) Экспорт

	ОбеспечитьКаталог(КаталогРезультатов);

	Количество = Случаи.Количество();
	НачалоМс = ДатаВМиллисекунды(ДатаНачалаUTC);
	ВсегоМс = Окр(ДлительностьСек * МиллисекундВСекунде());

	Для Индекс = 0 По Количество - 1 Цикл
		НачалоКейса = НачалоМс + Окр(ВсегоМс * Индекс / Количество);
		ОкончаниеКейса = НачалоМс + Окр(ВсегоМс * (Индекс + 1) / Количество);
		ЗаписатьСлучай(КаталогРезультатов, Случаи[Индекс], НачалоКейса, ОкончаниеКейса);
	КонецЦикла;

	Возврат Количество;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаписатьСлучай(Знач КаталогРезультатов, Знач Случай, Знач НачалоМс, Знач ОкончаниеМс)

	Идентификатор = Строка(Новый УникальныйИдентификатор());
	ПолноеИмя = СтрШаблон("%1.%2", _ИмяНабора, Случай.Имя);

	Результат = Новый Структура;
	Результат.Вставить("uuid", Идентификатор);
	// historyId связывает кейс с его историей между прогонами - это имя, а не uuid.
	Результат.Вставить("historyId", ПолноеИмя);
	Результат.Вставить("name", Случай.Имя);
	Результат.Вставить("fullName", ПолноеИмя);
	Результат.Вставить("status", Случай.Статус);
	Результат.Вставить("stage", "finished");
	Результат.Вставить("start", НачалоМс);
	Результат.Вставить("stop", ОкончаниеМс);
	Если ЗначениеЗаполнено(Случай.Сообщение) Тогда
		Результат.Вставить("statusDetails", Новый Структура("message", Случай.Сообщение));
	КонецЕсли;
	Результат.Вставить("labels", Метки(Случай));
	Результат.Вставить("steps", Новый Массив);
	Результат.Вставить("parameters", Новый Массив);
	Результат.Вставить("attachments", Новый Массив);

	ПутьФайла = ОбъединитьПути(КаталогРезультатов, Идентификатор + "-result.json");

	ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, Символы.Таб);
	Запись = Новый ЗаписьJSON;
	Запись.ОткрытьФайл(ПутьФайла, "UTF-8", Ложь, ПараметрыЗаписи);
	ЗаписатьJSON(Запись, Результат);
	Запись.Закрыть();

КонецПроцедуры

Функция Метки(Знач Случай)

	Список = Новый Массив;
	ДобавитьМетку(Список, "suite", _ИмяНабора);
	ДобавитьМетку(Список, "package", Случай.Пакет);
	ДобавитьМетку(Список, "severity", Случай.Важность);
	ДобавитьМетку(Список, "framework", "vanessa-runner");

	Возврат Список;

КонецФункции

Процедура ДобавитьМетку(Список, Знач Имя, Знач Значение)

	Если ЗначениеЗаполнено(Значение) Тогда
		Список.Добавить(Новый Структура("name, value", Имя, Значение));
	КонецЕсли;

КонецПроцедуры

// Unix-время в миллисекундах - в нём Allure ждёт поля start и stop.
//
// Параметры:
//   ДатаUTC - Дата - момент времени, универсальное время
//
// Возвращаемое значение:
//   Число - миллисекунд с 1970-01-01
//
Функция ДатаВМиллисекунды(Знач ДатаUTC)

	Возврат Окр((ДатаUTC - Дата(1970, 1, 1)) * МиллисекундВСекунде());

КонецФункции

Функция МиллисекундВСекунде()

	Возврат 1000;

КонецФункции

Процедура ОбеспечитьКаталог(Знач Путь)

	Если НЕ Новый Файл(Путь).Существует() Тогда
		СоздатьКаталог(Путь);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
