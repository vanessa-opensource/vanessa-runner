// BSLLS:UnusedLocalMethod-off ПриСозданииОбъекта вызывается рантаймом при Новый.
// BSLLS:NumberOfValuesInStructureConstructor-off Описание ресурса - плоская структура.
// Ресурсы, захваченные конвейером (временная база, XML-контекст, ibsrv): помнит, чем их освободить,
// и освобождает в порядке, обратном захвату, - штатно (Завершить) или после ошибки (Отменить).

Перем _Лог;       // Лог - лог вызывающего сервиса
Перем _Рефлектор; // Рефлектор - вызов методов освобождения по имени
Перем _Ресурсы;   // Массив из Структура - Владелец, Контекст, МетодЗавершения, МетодОтмены

Процедура ПриСозданииОбъекта(Знач Лог)

	_Лог = Лог;
	_Рефлектор = Новый Рефлектор;
	_Ресурсы = Новый Массив;

КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Запомнить захваченный ресурс.
//
// Параметры:
//   Владелец - Произвольный - объект, методы которого освобождают ресурс
//   Контекст - Произвольный - параметр методов освобождения; Неопределено - методы без параметров
//   МетодЗавершения - Строка - имя метода владельца для штатного освобождения
//   МетодОтмены - Строка - имя метода владельца для освобождения после ошибки; пусто - МетодЗавершения
//
Процедура Добавить(Знач Владелец, Знач Контекст, Знач МетодЗавершения, Знач МетодОтмены = "") Экспорт

	Если НЕ ЗначениеЗаполнено(МетодОтмены) Тогда
		МетодОтмены = МетодЗавершения;
	КонецЕсли;
	Ресурс = Новый Структура("Владелец, Контекст, МетодЗавершения, МетодОтмены",
		Владелец, Контекст, МетодЗавершения, МетодОтмены);
	_Ресурсы.Добавить(Ресурс);

КонецПроцедуры

// Освободить ресурсы штатно в порядке, обратном добавлению.
// Если освобождение ресурса упало, остальные отменяются, исключение пробрасывается.
//
Процедура Завершить() Экспорт

	Пока _Ресурсы.Количество() > 0 Цикл
		Ресурс = Извлечь();
		Попытка
			Освободить(Ресурс, Ресурс.МетодЗавершения);
		Исключение
			Отменить();
			ВызватьИсключение;
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

// Освободить ресурсы после ошибки в порядке, обратном добавлению.
// Ошибка освобождения ресурса пишется в лог предупреждением и не мешает остальным.
//
Процедура Отменить() Экспорт

	Пока _Ресурсы.Количество() > 0 Цикл
		Ресурс = Извлечь();
		Попытка
			Освободить(Ресурс, Ресурс.МетодОтмены);
		Исключение
			_Лог.Предупреждение("Не удалось освободить ресурс (%1.%2): %3",
				ТипЗнч(Ресурс.Владелец), Ресурс.МетодОтмены, ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Извлечь()

	Индекс = _Ресурсы.ВГраница();
	Ресурс = _Ресурсы[Индекс];
	_Ресурсы.Удалить(Индекс);
	Возврат Ресурс;

КонецФункции

Процедура Освободить(Знач Ресурс, Знач ИмяМетода)

	Параметры = Новый Массив;
	Если Ресурс.Контекст <> Неопределено Тогда
		Параметры.Добавить(Ресурс.Контекст);
	КонецЕсли;
	_Рефлектор.ВызватьМетод(Ресурс.Владелец, ИмяМетода, Параметры);

КонецПроцедуры

#КонецОбласти
