// BSLLS:MissingVariablesDescription-off Поля autumn (&Лог/&Пластилин).
// BSLLS:MissingParameterDescription-off Внутренние служебные методы сервиса.
// BSLLS:MissingReturnedValueDescription-off Внутренние служебные методы сервиса.
// BSLLS:NumberOfValuesInStructureConstructor-off Контекст исходников (5 полей).
// Сервис обеспечения исходников в нужном формате из источника любого вида.
// Каталоги (XML-выгрузка, EDT-проект) готовит СервисEDT; файлы *.cf/*.cfe разбираются
// во временной базе во временный каталог. Слой над сервисами разборки: они от него не зависят.

#Использовать tempfiles

&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисEDT;

&Пластилин
Перем СервисКонфигурации;

&Пластилин
Перем СервисРасширений;

&Пластилин
Перем СервисПоискаИсточников;

&Пластилин
Перем ФайловыеОперации;

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Обеспечить исходники в целевом формате из источника любого вида: каталог XML/EDT готовит СервисEDT,
// файл *.cf/*.cfe разбирается во временной базе во временный каталог (при цели edt - с импортом в EDT).
//
// Параметры:
//   ПутьИсточника       - Строка    - каталог исходников или файл *.cf/*.cfe
//   ЦелевойФормат       - Строка    - "xml" | "edt"
//   ПараметрыИсходников - Структура - {Формат, ПутьКCli, Версия, Workspace, Таймаут, VmАргументы} или Неопределено;
//                                     для файлов Формат не учитывается
//   ИспользоватьIbcmd   - Булево    - движок разборки файлов
//   ПараметрыПлатформы  - Структура - параметры платформы для разборки файлов
//
// Возвращаемое значение:
//   Структура - {Путь, Временный, ЭтоEDT, КаталогEDT, ВременныйКаталог, ПараметрыИсходников}:
//     ПараметрыИсходников - копия входных с Формат = ЦелевойФормат для дальнейшей работы с Путь
//
Функция Обеспечить(Знач ПутьИсточника, Знач ЦелевойФормат, Знач ПараметрыИсходников = Неопределено,
		Знач ИспользоватьIbcmd = Ложь, Знач ПараметрыПлатформы = Неопределено) Экспорт

	Источник = СервисПоискаИсточников.Описать(ПутьИсточника);
	Если Источник.Вид = "dt" Тогда
		ВызватьИсключение СтрШаблон(
			"Выгрузка информационной базы (*.dt) не поддерживается как источник исходников: %1."
			+ " Ожидается каталог исходников (XML-выгрузка Конфигуратора или проект 1С:EDT), файл *.cf или *.cfe.",
			ПутьИсточника);
	КонецЕсли;

	ПараметрыЦели = ПараметрыВФормате(ПараметрыИсходников, ЦелевойФормат);
	Если Источник.Вид = "cf" ИЛИ Источник.Вид = "cfe" Тогда
		Контекст = РазобратьФайл(Источник, ЦелевойФормат, ПараметрыЦели, ИспользоватьIbcmd, ПараметрыПлатформы);
	Иначе
		Контекст = СервисEDT.ПодготовитьИсходники(ПутьИсточника, ЦелевойФормат, ПараметрыИсходников);
	КонецЕсли;
	Контекст.Вставить("ПараметрыИсходников", ПараметрыЦели);

	Возврат Контекст;

КонецФункции

// Завершить работу с исходниками из Обеспечить: удалить временный каталог.
//
// Параметры:
//   Контекст - Структура - результат Обеспечить
//
Процедура Освободить(Знач Контекст) Экспорт
	СервисEDT.ЗавершитьИсходники(Контекст);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Разобрать *.cf/*.cfe в <временный каталог>/<имя файла>: имя каталога станет именем EDT-проекта.
Функция РазобратьФайл(Знач Источник, Знач ЦелевойФормат, Знач ПараметрыВыгрузки,
		Знач ИспользоватьIbcmd, Знач ПараметрыПлатформы)

	ФайловыеОперации.ПроверитьСуществованиеФайла(Источник.КорневойКаталог, "Файл источника не найден: %1");
	Если Источник.Вид = "cfe" Тогда
		ПроверитьИмяРасширенияИзФайла(Источник);
	КонецЕсли;

	Контекст = Новый Структура("Путь, Временный, ЭтоEDT, КаталогEDT, ВременныйКаталог",
		"", Истина, Ложь, "", ВременныеФайлы.СоздатьКаталог());
	Контекст.Путь = ОбъединитьПути(Контекст.ВременныйКаталог, Источник.Имя);

	Лог.Информация("Разборка %1 → %2 через временную базу (может занять несколько минут): %3 → %4",
		ВРег(Источник.Вид), ВРег(ЦелевойФормат), Источник.КорневойКаталог, Контекст.Путь);
	Попытка
		Если Источник.Вид = "cf" Тогда
			СервисКонфигурации.РазобратьКонфигурациюВИсходники(Источник.КорневойКаталог, Контекст.Путь,
				ИспользоватьIbcmd, ПараметрыПлатформы, Неопределено, ПараметрыВыгрузки);
		Иначе
			СервисРасширений.РазобратьРасширениеВИсходники(Источник.КорневойКаталог, Контекст.Путь, Источник.Имя,
				ИспользоватьIbcmd, ПараметрыПлатформы, Неопределено, ПараметрыВыгрузки);
		КонецЕсли;
	Исключение
		Освободить(Контекст);
		ВызватьИсключение;
	КонецПопытки;

	Возврат Контекст;

КонецФункции

// Имя расширения для загрузки *.cfe во временную базу - имя файла без расширения.
Процедура ПроверитьИмяРасширенияИзФайла(Знач Источник)

	Попытка
		СервисРасширений.ПроверитьИмяРасширения(Источник.Имя);
	Исключение
		ВызватьИсключение СтрШаблон("Имя расширения взято из имени файла %1: %2 Переименуйте файл по имени расширения.",
			Источник.КорневойКаталог, ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Копия параметров с форматом = целевому: сервисы разборки пишут сразу в нужный формат
// (auto определялся бы по несуществующему каталогу как XML), входная структура не меняется.
Функция ПараметрыВФормате(Знач ПараметрыИсходников, Знач Формат)

	Результат = Новый Структура;
	Если ПараметрыИсходников <> Неопределено Тогда
		Для Каждого Параметр Из ПараметрыИсходников Цикл
			Результат.Вставить(Параметр.Ключ, Параметр.Значение);
		КонецЦикла;
	КонецЕсли;
	Результат.Вставить("Формат", Формат);

	Возврат Результат;

КонецФункции

#КонецОбласти
