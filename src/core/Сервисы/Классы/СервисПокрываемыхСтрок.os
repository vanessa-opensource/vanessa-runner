// BSLLS:MissingVariablesDescription-off Поля autumn (&Лог/&Деталька) и внутреннее состояние сервиса.
// BSLLS:LatinAndCyrillicSymbolInWord-off Технические идентификаторы (lines-to-cover, Java, HTTP, URL, json).
// BSLLS:Typo-off Доменные термины (генерик, генериккавередж, покрываемые строки).
// BSLLS:MissingParameterDescription-off Внутренние вспомогательные функции.
// BSLLS:MissingReturnedValueDescription-off Внутренние вспомогательные функции.
// BSLLS:MagicNumber-off Порты по умолчанию (443/80) и таймаут загрузки.
// BSLLS:LineLength-off Длинные значения по умолчанию (URL релиза) в аннотациях.
// BSLLS:NumberOfValuesInStructureConstructor-off
// Сервис утилиты расчета покрываемых (исполняемых) строк модулей 1С.
//
// Оборачивает внешнюю CLI-утилиту lines-to-cover (репозиторий Segate-ekb/Lines_to_cover_1c):
// самодостаточный jlink-бандл (свой JRE, установка Java не нужна), который по .bsl-исходникам
// отдает список покрываемых строк - это знаменатель для расчета процента покрытия
// (coveragebsl дает только ИСПОЛНЕННЫЕ строки, а утилита - ВСЕ покрываемые).
//
// Жизненный цикл:
//   1. ОбеспечитьУстановку() - при первом обращении скачивает zip релиза под текущую ОС
//      из GitHub Releases в кеш, распаковывает и возвращает каталог образа (image);
//      при повторных запусках использует уже установленный бандл.
//   2. ЗапуститьФоновыйРасчет(...) / ДождатьсяРезультата(...) - запускает утилиту ФОНОВЫМ процессом
//      (не блокирует - работает параллельно с прогоном тестов), затем забирает JSON-результат
//      {путь_файла -> массив номеров строк}. ПокрываемыеСтроки(...) - синхронная обертка.
//
// Скачивание идет по https штатным HTTPСоединение (схема указывается в адресе хоста;
// редиректы GitHub на CDN следуются автоматически). Java-утилита вызывается напрямую
// (java[.exe] с classpath), минуя bat/sh-лаунчеры - так надежнее с кавычками и путями.

#Использовать tempfiles
#Использовать 1commands

&Лог("vrunner")
Перем Лог;

&Пластилин
Перем ФайловыеОперации;

&Пластилин
Перем СервисПроцессов;

Перем _Версия;
Перем _БазовыйURL;
Перем _ДомашнийКаталог;
Перем _БазаУтилит;
Перем _ТаймаутЗагрузкиСек;

// Опциональный загрузчик (для юнит-тестов). Если задан - должен реализовать
// Скачать(URL, ПутьНазначения) и записать файл по указанному пути.
Перем _Загрузчик;

&Желудь
Процедура ПриСозданииОбъекта(
	&Деталька(Значение = "coverage.lines-tool.version", ЗначениеПоУмолчанию = "0.1.0") Версия,
	&Деталька(Значение = "coverage.lines-tool.base-url", ЗначениеПоУмолчанию = "https://github.com/Segate-ekb/Lines_to_cover_1c/releases/download") БазовыйURL,
	&Деталька(Значение = "coverage.lines-tool.home", ЗначениеПоУмолчанию = "") ДомашнийКаталог,
	&Деталька(Значение = "coverage.lines-tool.tools-dir", ЗначениеПоУмолчанию = "") КаталогУтилит)

	_Версия = СокрЛП(Строка(Версия));
	_БазовыйURL = СокрЛП(Строка(БазовыйURL));
	_ДомашнийКаталог = СокрЛП(Строка(ДомашнийКаталог));
	_БазаУтилит = СокрЛП(Строка(КаталогУтилит));
	_ТаймаутЗагрузкиСек = 300;
	_Загрузчик = Неопределено;

КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Версия используемой утилиты lines-to-cover.
//
// Возвращаемое значение:
//   Строка
//
Функция Версия() Экспорт
	Возврат _Версия;
КонецФункции

// Установлена ли утилита (готова к запуску) в текущем каталоге образа.
//
// Возвращаемое значение:
//   Булево
//
Функция Установлена() Экспорт
	Возврат ОбразГотов(КаталогОбраза());
КонецФункции

// Обеспечить наличие установленной утилиты: при отсутствии - скачать релиз под текущую ОС
// из GitHub и распаковать в кеш. Идемпотентна: если бандл уже установлен, ничего не качает.
//
// Возвращаемое значение:
//   Строка - путь к каталогу образа (image) с bin/ и lib/
//
Функция ОбеспечитьУстановку() Экспорт

	Образ = КаталогОбраза();
	Если ОбразГотов(Образ) Тогда
		Лог.Отладка("Утилита покрываемых строк уже установлена: %1", Образ);
		Возврат Образ;
	КонецЕсли;

	Если ЗначениеЗаполнено(_ДомашнийКаталог) Тогда
		ВызватьИсключение СтрШаблон(
			"Задан coverage.lines-tool.home=%1, но в нем нет утилиты lines-to-cover (не найдены bin/java и lib/lines-to-cover*.jar).",
			_ДомашнийКаталог);
	КонецЕсли;

	УстановитьИзРелиза();

	Образ = КаталогОбраза();
	Если НЕ ОбразГотов(Образ) Тогда
		ВызватьИсключение СтрШаблон("После установки утилита lines-to-cover не найдена в %1.", Образ);
	КонецЕсли;

	Возврат Образ;

КонецФункции

// Запустить фоновый расчет покрываемых строк (НЕ блокирует - java-процесс работает параллельно).
// При необходимости утилита будет установлена (ОбеспечитьУстановку). Результат забирается
// вызовом ДождатьсяРезультата(Задание).
//
// Параметры:
//   КаталогиИсходников - Массив - каталоги с .bsl-исходниками (Строка)
//   БазовыйКаталог     - Строка - база для относительных путей (пусто - абсолютные)
//
// Возвращаемое значение:
//   Структура - Задание: Процесс (запущенный), ВыводФайл (путь к будущему JSON)
//
Функция ЗапуститьФоновыйРасчет(Знач КаталогиИсходников, Знач БазовыйКаталог = "") Экспорт

	Образ = ОбеспечитьУстановку();
	ВыводФайл = ВременныеФайлы.НовоеИмяФайла("json");

	СтрокаЗапуска = СформироватьКоманднуюСтроку(Образ, КаталогиИсходников, БазовыйКаталог, ВыводФайл);
	Лог.Отладка("Фоновый расчет покрываемых строк: %1", СтрокаЗапуска);

	// Вывод НЕ перенаправляем в поток: процесс работает долго и опрашивается только после прогона тестов,
	// а нечитаемый буфер stdout/stderr мог бы переполниться и заблокировать процесс (подвисание). Результат
	// утилита пишет в файл (--out), диагностика уходит в консоль.
	Процесс = СервисПроцессов.Запустить(СтрокаЗапуска);

	Возврат Новый Структура("Процесс, ВыводФайл", Процесс, ВыводФайл);

КонецФункции

// Дождаться завершения фонового расчета и вернуть результат.
//
// Параметры:
//   Задание - Структура, Неопределено - результат ЗапуститьФоновыйРасчет
//
// Возвращаемое значение:
//   Соответствие - Ключ: путь к файлу (Строка), Значение: Массив номеров покрываемых строк (Число)
//
Функция ДождатьсяРезультата(Знач Задание) Экспорт

	Если Задание = Неопределено Тогда
		Возврат Новый Соответствие;
	КонецЕсли;

	КодВозврата = СервисПроцессов.ОжидатьЗавершения(Задание.Процесс);
	Попытка
		Если КодВозврата <> 0 Тогда
			ВызватьИсключение СтрШаблон("Утилита lines-to-cover завершилась с кодом %1: %2",
				КодВозврата, СервисПроцессов.ПрочитатьВывод(Задание.Процесс));
		КонецЕсли;
		Результат = ПрочитатьJSONФайл(Задание.ВыводФайл);
	Исключение
		УдалитьВременный(Задание.ВыводФайл);
		ВызватьИсключение;
	КонецПопытки;

	УдалитьВременный(Задание.ВыводФайл);
	Лог.Отладка("Расчет покрываемых строк завершен: файлов=%1", Результат.Количество());
	Возврат Результат;

КонецФункции

// Аккуратно прекратить фоновый расчет (при ошибке прогона тестов) - дождаться процесса и убрать временный файл.
//
// Параметры:
//   Задание - Структура, Неопределено - результат ЗапуститьФоновыйРасчет
//
Процедура ПрекратитьРасчет(Знач Задание) Экспорт

	Если Задание = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		СервисПроцессов.ОжидатьЗавершения(Задание.Процесс);
	Исключение
		Лог.Отладка("Ожидание фонового расчета при прерывании: %1", ОписаниеОшибки());
	КонецПопытки;

	УдалитьВременный(Задание.ВыводФайл);

КонецПроцедуры

// Рассчитать покрываемые строки синхронно (запуск + ожидание). Обертка над фоновым API.
//
// Параметры:
//   КаталогиИсходников - Массив - каталоги с .bsl-исходниками (Строка)
//   БазовыйКаталог     - Строка - база для относительных путей (пусто - абсолютные)
//
// Возвращаемое значение:
//   Соответствие - Ключ: путь к файлу (Строка), Значение: Массив номеров покрываемых строк (Число)
//
Функция ПокрываемыеСтроки(Знач КаталогиИсходников, Знач БазовыйКаталог = "") Экспорт
	Задание = ЗапуститьФоновыйРасчет(КаталогиИсходников, БазовыйКаталог);
	Возврат ДождатьсяРезультата(Задание);
КонецФункции

// Имя ассета релиза для строки типа платформы (Экспорт для юнит-тестов).
//
// Параметры:
//   ТипПлатформыСтрока - Строка - представление СистемнаяИнформация.ТипПлатформы (напр. "Windows_x86_64")
//
// Возвращаемое значение:
//   Строка - имя zip-ассета релиза
//
Функция ИмяАссетаДляПлатформы(Знач ТипПлатформыСтрока) Экспорт

	Тип = НРег(СокрЛП(ТипПлатформыСтрока));
	Если СтрНачинаетсяС(Тип, "windows") Тогда
		Возврат "lines-to-cover-windows.zip";
	ИначеЕсли СтрНачинаетсяС(Тип, "linux") Тогда
		Возврат "lines-to-cover-linux.zip";
	ИначеЕсли СтрНачинаетсяС(Тип, "macos") Тогда
		Возврат "lines-to-cover-macos.zip";
	Иначе
		ВызватьИсключение СтрШаблон(
			"Неподдерживаемая платформа для утилиты покрываемых строк: %1", ТипПлатформыСтрока);
	КонецЕсли;

КонецФункции

// Полный URL загрузки ассета релиза для текущей ОС (Экспорт для юнит-тестов).
//
// Возвращаемое значение:
//   Строка - https://.../download/v<версия>/lines-to-cover-<ос>.zip
//
Функция URLЗагрузки() Экспорт
	База = _БазовыйURL;
	Пока ПравыйСимвол(База) = "/" Цикл
		База = Лев(База, СтрДлина(База) - 1);
	КонецЦикла;
	Возврат СтрШаблон("%1/v%2/%3", База, _Версия, ИмяАссета());
КонецФункции

// Разобрать URL на компоненты для HTTPСоединение (Экспорт для юнит-тестов).
// Схема сохраняется в поле СХостом (OneScript требует протокол в адресе хоста для https).
//
// Параметры:
//   URL - Строка - "https://host[:port]/resource"
//
// Возвращаемое значение:
//   Структура - СХостом ("https://host"), Хост, Порт (Число), Ресурс ("/...")
//
Функция РазобратьURL(Знач URL) Экспорт

	Схема = "http";
	Остаток = СокрЛП(URL);
	// BSLLS:IfElseIfEndsWithElse-off хвостовой Иначе не нужен: без префикса схема остается http (по умолчанию).
	Если СтрНачинаетсяС(НРег(Остаток), "https://") Тогда
		Схема = "https";
		Остаток = Сред(Остаток, СтрДлина("https://") + 1);
	ИначеЕсли СтрНачинаетсяС(НРег(Остаток), "http://") Тогда
		Остаток = Сред(Остаток, СтрДлина("http://") + 1);
	КонецЕсли;
	// BSLLS:IfElseIfEndsWithElse-on

	ПозицияСлеша = СтрНайти(Остаток, "/");
	Если ПозицияСлеша = 0 Тогда
		ХостПорт = Остаток;
		Ресурс = "/";
	Иначе
		ХостПорт = Лев(Остаток, ПозицияСлеша - 1);
		Ресурс = Сред(Остаток, ПозицияСлеша);
	КонецЕсли;

	Порт = ?(Схема = "https", 443, 80);
	ПозицияДвоеточия = СтрНайти(ХостПорт, ":");
	Если ПозицияДвоеточия > 0 Тогда
		ПортСтр = СокрЛП(Сред(ХостПорт, ПозицияДвоеточия + 1));
		Если ЗначениеЗаполнено(ПортСтр) Тогда
			Порт = Число(ПортСтр);
		КонецЕсли;
		ХостПорт = Лев(ХостПорт, ПозицияДвоеточия - 1);
	КонецЕсли;

	Возврат Новый Структура("СХостом, Хост, Порт, Ресурс",
		Схема + "://" + ХостПорт, ХостПорт, Порт, Ресурс);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УстановитьИзРелиза()

	Ассет = ИмяАссета();
	URL = URLЗагрузки();
	КаталогВерсии = КаталогВерсии();

	// Возможная частичная установка от прерванного запуска - удаляем.
	Если Новый Файл(КаталогВерсии).Существует() Тогда
		Попытка
			УдалитьФайлы(КаталогВерсии);
		Исключение
			Лог.Отладка("Не удалось очистить каталог %1: %2", КаталогВерсии, ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	ФайловыеОперации.ОбеспечитьКаталог(КаталогВерсии);

	ВрКаталог = ВременныеФайлы.СоздатьКаталог();
	ФайлАрхива = ОбъединитьПути(ВрКаталог, Ассет);

	Лог.Информация("Загрузка утилиты покрываемых строк %1 (%2)...", _Версия, Ассет);
	Попытка
		Скачать(URL, ФайлАрхива);
		Лог.Отладка("Распаковка %1 -> %2", ФайлАрхива, КаталогВерсии);
		Распаковать(ФайлАрхива, КаталогВерсии);
	Исключение
		Ошибка = ОписаниеОшибки();
		УдалитьВременный(ВрКаталог);
		ВызватьИсключение ИнструкцияПоУстановке(Ошибка, URL);
	КонецПопытки;

	УдалитьВременный(ВрКаталог);
	ПодготовитьПрава(КаталогОбраза());

	Лог.Информация("Утилита покрываемых строк установлена: %1", КаталогОбраза());

КонецПроцедуры

// Сообщение об ошибке автозагрузки с инструкцией по ручной установке (требование п.2).
Функция ИнструкцияПоУстановке(Знач Ошибка, Знач URL)
	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон("Не удалось установить утилиту расчета покрываемых строк lines-to-cover: %1.", Ошибка));
	Строки.Добавить(СтрШаблон("Ручная установка: скачайте %1 и распакуйте так, чтобы получился каталог", URL));
	Строки.Добавить("с подпапками bin/ и lib/, затем укажите его настройкой coverage.lines-tool.home");
	Строки.Добавить(СтрШаблон("(либо положите распакованное в %1).", КаталогОбраза()));
	Строки.Добавить("Либо отключите расчет процента покрытия флагом --coverage-skip-lines.");
	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

Процедура Скачать(Знач URL, Знач ПутьНазначения)

	Если _Загрузчик <> Неопределено Тогда
		_Загрузчик.Скачать(URL, ПутьНазначения);
		Возврат;
	КонецЕсли;

	Разбор = РазобратьURL(URL);
	Соединение = Новый HTTPСоединение(Разбор.СХостом, Разбор.Порт, , , , _ТаймаутЗагрузкиСек);
	Ответ = Соединение.Получить(Новый HTTPЗапрос(Разбор.Ресурс), ПутьНазначения);

	Если Ответ.КодСостояния < 200 ИЛИ Ответ.КодСостояния >= 300 Тогда
		УдалитьВременный(ПутьНазначения);
		ВызватьИсключение СтрШаблон("загрузка %1 вернула HTTP %2", URL, Ответ.КодСостояния);
	КонецЕсли;

	Файл = Новый Файл(ПутьНазначения);
	Если НЕ Файл.Существует() ИЛИ Файл.Размер() = 0 Тогда
		ВызватьИсключение СтрШаблон("загрузка %1 не создала файл (пустой ответ)", URL);
	КонецЕсли;

КонецПроцедуры

Процедура Распаковать(Знач ФайлАрхива, Знач КаталогНазначения)
	Чтение = Новый ЧтениеZipФайла(ФайлАрхива);
	Попытка
		Чтение.ИзвлечьВсе(КаталогНазначения, РежимВосстановленияПутейФайловZIP.Восстанавливать);
	Исключение
		Чтение.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	Чтение.Закрыть();
КонецПроцедуры

// На UNIX-подобных ОС восстановить право на исполнение (System.IO/Zip не сохраняет unix-права),
// на macOS - снять карантин. Ошибки не фатальны: реальный сбой всплывет при запуске java.
Процедура ПодготовитьПрава(Знач Образ)

	Если ЭтоWindows() Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Chmod("-R", "+x", ОбъединитьПути(Образ, "bin"));
		Jspawn = ОбъединитьПути(Образ, "lib", "jspawnhelper");
		Если Новый Файл(Jspawn).Существует() Тогда
			Chmod("+x", "", Jspawn);
		КонецЕсли;
	Исключение
		Лог.Предупреждение("Не удалось выставить права на исполнение утилиты: %1", ОписаниеОшибки());
	КонецПопытки;

	Если ЭтоMacOS() Тогда
		Попытка
			КмдКарантин = Новый Команда;
			КмдКарантин.УстановитьКоманду("xattr");
			КмдКарантин.ДобавитьПараметр("-dr");
			КмдКарантин.ДобавитьПараметр("com.apple.quarantine");
			КмдКарантин.ДобавитьПараметр(Образ);
			КмдКарантин.Исполнить();
		Исключение
			Лог.Отладка("Не удалось снять карантин macOS: %1", ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

Процедура Chmod(Знач Флаг1, Знач Флаг2, Знач Путь)
	Кмд = Новый Команда;
	Кмд.УстановитьКоманду("chmod");
	Кмд.ДобавитьПараметр(Флаг1);
	Если ЗначениеЗаполнено(Флаг2) Тогда
		Кмд.ДобавитьПараметр(Флаг2);
	КонецЕсли;
	Кмд.ДобавитьПараметр(Путь);
	Кмд.Исполнить();
КонецПроцедуры

// Собрать командную строку запуска java-утилиты напрямую (classpath-wildcard раскрывает сама JVM).
Функция СформироватьКоманднуюСтроку(Знач Образ, Знач КаталогиИсходников, Знач БазовыйКаталог, Знач ВыводФайл)

	Части = Новый Массив;
	Части.Добавить(ВКавычках(ПутьКJava(Образ)));
	Части.Добавить("-classpath");
	Части.Добавить(ВКавычках(ОбъединитьПути(Образ, "lib") + ПолучитьРазделительПути() + "*"));
	Части.Добавить("io.github.segateekb.linestocover.Main");

	ЕстьИсточники = Ложь;
	Если КаталогиИсходников <> Неопределено Тогда
		Для Каждого Каталог Из КаталогиИсходников Цикл
			Если НЕ ЗначениеЗаполнено(Каталог) Тогда
				Продолжить;
			КонецЕсли;
			Части.Добавить("--src");
			Части.Добавить(ВКавычках(Новый Файл(Каталог).ПолноеИмя));
			ЕстьИсточники = Истина;
		КонецЦикла;
	КонецЕсли;
	Если НЕ ЕстьИсточники Тогда
		ВызватьИсключение "Не заданы каталоги исходников для расчета покрываемых строк.";
	КонецЕсли;

	Если ЗначениеЗаполнено(БазовыйКаталог) Тогда
		Части.Добавить("--base");
		Части.Добавить(ВКавычках(Новый Файл(БазовыйКаталог).ПолноеИмя));
	КонецЕсли;
	Части.Добавить("--format");
	Части.Добавить("json");
	Части.Добавить("--out");
	Части.Добавить(ВКавычках(ВыводФайл));

	Возврат СтрСоединить(Части, " ");

КонецФункции

Функция ПрочитатьJSONФайл(Знач Путь)
	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(Путь);
	Попытка
		Значение = ПрочитатьJSON(Чтение, Истина);
	Исключение
		Чтение.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	Чтение.Закрыть();
	Возврат ?(Значение = Неопределено, Новый Соответствие, Значение);
КонецФункции

// Готов ли образ к запуску: есть исполняемый java и хотя бы один jar утилиты.
Функция ОбразГотов(Знач Образ)

	Если НЕ ЗначениеЗаполнено(Образ) ИЛИ НЕ Новый Файл(ПутьКJava(Образ)).Существует() Тогда
		Возврат Ложь;
	КонецЕсли;

	КаталогБиблиотек = ОбъединитьПути(Образ, "lib");
	Если НЕ Новый Файл(КаталогБиблиотек).Существует() Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат НайтиФайлы(КаталогБиблиотек, "lines-to-cover*.jar").Количество() > 0;

КонецФункции

Функция ПутьКJava(Знач Образ)
	Возврат ОбъединитьПути(Образ, "bin", "java" + ?(ЭтоWindows(), ".exe", ""));
КонецФункции

Функция КаталогОбраза()
	Если ЗначениеЗаполнено(_ДомашнийКаталог) Тогда
		Возврат Новый Файл(_ДомашнийКаталог).ПолноеИмя;
	КонецЕсли;
	Возврат ОбъединитьПути(КаталогВерсии(), "image");
КонецФункции

Функция КаталогВерсии()
	Возврат ОбъединитьПути(БазаУтилит(), "lines-to-cover", _Версия);
КонецФункции

Функция БазаУтилит()
	Если ЗначениеЗаполнено(_БазаУтилит) Тогда
		Возврат _БазаУтилит;
	КонецЕсли;
	Возврат ОбъединитьПути(КаталогВременныхФайлов(), "vanessa-runner", "tools");
КонецФункции

Функция ИмяАссета()
	Возврат ИмяАссетаДляПлатформы(Строка(Новый СистемнаяИнформация().ТипПлатформы));
КонецФункции

Функция ПравыйСимвол(Знач Строка)
	Возврат ?(ЗначениеЗаполнено(Строка), Прав(Строка, 1), "");
КонецФункции

Процедура УдалитьВременный(Знач Путь)
	ФайловыеОперации.УдалитьБезопасно(Путь);
КонецПроцедуры

Функция ЭтоWindows()
	Возврат СтрНачинаетсяС(НРег(Строка(Новый СистемнаяИнформация().ТипПлатформы)), "windows");
КонецФункции

Функция ЭтоMacOS()
	Возврат СтрНачинаетсяС(НРег(Строка(Новый СистемнаяИнформация().ТипПлатформы)), "macos");
КонецФункции

Функция ВКавычках(Знач Значение)
	Возврат """" + Значение + """";
КонецФункции

#КонецОбласти
