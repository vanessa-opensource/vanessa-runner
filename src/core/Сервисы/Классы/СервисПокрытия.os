// BSLLS:MissingVariablesDescription-off Поля autumn (&Лог/&Желудь/&Пластилин) и внутреннее состояние.
// BSLLS:LatinAndCyrillicSymbolInWord-off Технические идентификаторы (coveragebsl, DEBUGGERURL, EDT, XML).
// BSLLS:Typo-off Доменные термины (coveragebsl, genericCoverage, cobertura, clover, mdo, алиас).
// BSLLS:MissingParameterDescription-off Внутренние вспомогательные функции.
// BSLLS:MissingReturnedValueDescription-off Внутренние вспомогательные функции.
// BSLLS:UsingHardcodeNetworkAddress-off Хост сервера отладки по умолчанию - локальный (127.0.0.1).
// BSLLS:NumberOfValuesInStructureConstructor-off
// Сервис сбора покрытия тестов.
//
// Оркестрирует сбор покрытия конфигурации/расширений по итогам прогона тестов:
//   1. поднимает сервер отладки (СервисСервераОтладки) либо подключается к существующему;
//   2. открывает сессию сбора компонентой coveragebsl (МенеджерПокрытия);
//   3. отдаёт подкоманде аргументы отладки для запуска клиента 1С (/Debug ... /DEBUGGERURL);
//   4. по завершении прогона забирает данные, сопоставляет модули с исходниками (КонвертерПокрытия)
//      и формирует отчёт библиотекой coverage (genericCoverage/cobertura/clover).
//
// Компонента coveragebsl нативная и грузится ЛЕНИВО (через ЗагрузитьСценарийИзСтроки), только когда
// покрытие реально включено, - чтобы не связывать запуск vrunner с наличием компоненты.

#Использовать coverage
#Использовать tempfiles

&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисСервераОтладки;

&Пластилин
Перем СервисПоискаИсточников;

&Пластилин
Перем СервисПокрываемыхСтрок;

// Опциональная фабрика coveragebsl (для тестов). Если задана - должна реализовать
// СоздатьМенеджер(Адрес) -> МенеджерПокрытия.
Перем _ФабрикаCoveragebsl;

&Желудь
Процедура ПриСозданииОбъекта()
	_ФабрикаCoveragebsl = Неопределено;
КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Начать сеанс сбора покрытия: поднять сервер отладки и открыть сессию coveragebsl.
//
// Параметры:
//   ПараметрыПокрытия    - Структура - см. НаборОпцийПокрытия.СформироватьПараметры
//   ПараметрыПодключения - Структура - параметры подключения к ИБ (для определения алиаса)
//   ПараметрыПлатформы   - Структура, Неопределено - версия платформы (для поиска dbgs)
//
// Возвращаемое значение:
//   Структура - Контекст сеанса: АргументыОтладки (Строка), Сессия, ПараметрыПокрытия, Активен
//
Функция НачатьСеанс(Знач ПараметрыПокрытия, Знач ПараметрыПодключения, Знач ПараметрыПлатформы = Неопределено) Экспорт

	Лог.Информация("Включён сбор покрытия, отчёт: %1", ПараметрыПокрытия.ПутьОтчета);

	РассчитыватьПокрываемые = НужноРассчитыватьПокрываемые(ПараметрыПокрытия);
	// Проверка наличия софта расчёта покрываемых строк ДО поднятия сервера отладки (fail-fast).
	Если РассчитыватьПокрываемые Тогда
		СервисПокрываемыхСтрок.ОбеспечитьУстановку();
	КонецЕсли;

	КонтекстСервера = ЗапуститьСерверОтладки(ПараметрыПокрытия, ПараметрыПлатформы);
	Адрес = КонтекстСервера.Адрес;

	ЗаданиеПокрываемых = Неопределено;
	Попытка
		Менеджер = Фабрика().СоздатьМенеджер(Адрес);
		Менеджер.ПроверитьСоединение();

		Алиас = ОпределитьАлиас(ПараметрыПодключения, ПараметрыПокрытия.АлиасИБ);
		Лог.Отладка("Открытие сессии покрытия: адрес=%1, алиас=%2", Адрес, Алиас);

		Сессия = Менеджер.НоваяСессияПокрытия(Алиас);
		Сессия.Подключить(ПараметрыПокрытия.ПарольОтладки);
		Сессия.НачатьСборПокрытия();

		// Расчёт покрываемых строк идёт ПАРАЛЛЕЛЬНО с прогоном тестов (фоновый процесс).
		Если РассчитыватьПокрываемые Тогда
			ЗаданиеПокрываемых = ЗапуститьРасчетПокрываемых(ПараметрыПокрытия);
		КонецЕсли;
	Исключение
		Ошибка = ОписаниеОшибки();
		СервисПокрываемыхСтрок.ПрекратитьРасчет(ЗаданиеПокрываемых);
		СервисСервераОтладки.ОстановитьСервер();
		ВызватьИсключение СтрШаблон("Не удалось начать сбор покрытия (%1): %2", Адрес, Ошибка);
	КонецПопытки;

	Контекст = Новый Структура;
	Контекст.Вставить("Сессия", Сессия);
	Контекст.Вставить("ПараметрыПокрытия", ПараметрыПокрытия);
	Контекст.Вставить("АргументыОтладки", СтрШаблон("/Debug -http -attach /DEBUGGERURL %1", Адрес));
	Контекст.Вставить("АдресСервера", Адрес);
	Контекст.Вставить("ЗаданиеПокрываемых", ЗаданиеПокрываемых);
	Контекст.Вставить("Активен", Истина);

	Возврат Контекст;

КонецФункции

// Завершить сеанс: забрать данные покрытия, остановить сервер, сформировать отчёт.
//
// Параметры:
//   Контекст - Структура - контекст сеанса (см. НачатьСеанс)
//
Процедура ЗавершитьСеанс(Знач Контекст) Экспорт

	Если Контекст = Неопределено ИЛИ НЕ Контекст.Активен Тогда
		Возврат;
	КонецЕсли;
	Контекст.Активен = Ложь;

	СыройФайл = ВременныеФайлы.НовоеИмяФайла("json");
	Попытка
		Данные = Контекст.Сессия.ЗавершитьСборПокрытия();
		СериализоватьДанные(Данные, СыройФайл);
		Контекст.Сессия.Отключить();
	Исключение
		Ошибка = ОписаниеОшибки();
		СервисПокрываемыхСтрок.ПрекратитьРасчет(Контекст.ЗаданиеПокрываемых);
		СервисСервераОтладки.ОстановитьСервер();
		ВызватьИсключение СтрШаблон("Не удалось завершить сбор покрытия: %1", Ошибка);
	КонецПопытки;

	СервисСервераОтладки.ОстановитьСервер();

	Попытка
		СформироватьОтчет(Контекст.ПараметрыПокрытия, СыройФайл, Контекст.ЗаданиеПокрываемых);
	Исключение
		СервисПокрываемыхСтрок.ПрекратитьРасчет(Контекст.ЗаданиеПокрываемых);
		УдалитьВременный(СыройФайл);
		ВызватьИсключение;
	КонецПопытки;

	УдалитьВременный(СыройФайл);

	Лог.Информация("Отчёт покрытия сформирован: %1", Контекст.ПараметрыПокрытия.ПутьОтчета);

КонецПроцедуры

// Аккуратно прервать сеанс при ошибке прогона тестов (без формирования отчёта).
//
// Параметры:
//   Контекст - Структура, Неопределено - контекст сеанса
//
Процедура ПрерватьСеанс(Знач Контекст) Экспорт

	Если Контекст = Неопределено ИЛИ НЕ Контекст.Активен Тогда
		Возврат;
	КонецЕсли;
	Контекст.Активен = Ложь;

	Попытка
		Контекст.Сессия.Отключить();
	Исключение
		Лог.Отладка("Отключение сессии покрытия при прерывании: %1", ОписаниеОшибки());
	КонецПопытки;

	СервисПокрываемыхСтрок.ПрекратитьРасчет(Контекст.ЗаданиеПокрываемых);
	СервисСервераОтладки.ОстановитьСервер();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗапуститьСерверОтладки(Знач ПараметрыПокрытия, Знач ПараметрыПлатформы)

	Адрес = РазобратьАдресСервера(ПараметрыПокрытия.СерверОтладки);

	ПараметрыСервера = СервисСервераОтладки.НовыеПараметрыСервера();
	ПараметрыСервера.Хост = Адрес.Хост;
	ПараметрыСервера.Порт = Адрес.Порт;
	ПараметрыСервера.ПодключитьсяКСуществующему = Адрес.Подключиться;
	ПараметрыСервера.ПутьКDBGS = ПараметрыПокрытия.ПутьКСерверуОтладки;
	ПараметрыСервера.Пароль = ПараметрыПокрытия.ПарольОтладки;

	Если ПараметрыПлатформы <> Неопределено
		И ПараметрыПлатформы.Свойство("ВерсияПлатформы")
		И ЗначениеЗаполнено(ПараметрыПлатформы.ВерсияПлатформы) Тогда
		ПараметрыСервера.ВерсияПлатформы = ПараметрыПлатформы.ВерсияПлатформы;
	КонецЕсли;

	Возврат СервисСервераОтладки.ЗапуститьСервер(ПараметрыСервера);

КонецФункции

Процедура СериализоватьДанные(Знач Данные, Знач ФайлВывода)
	Запись = Новый ЗаписьJSON;
	Запись.ОткрытьФайл(ФайлВывода, "UTF-8");
	Данные.СериализоватьJSON(Запись);
	Запись.Закрыть();
КонецПроцедуры

Процедура СформироватьОтчет(Знач ПараметрыПокрытия, Знач СыройФайл, Знач ЗаданиеПокрываемых = Неопределено)

	Конвертер = Новый КонвертерПокрытия();
	ЗаполнитьИсточники(Конвертер, ПараметрыПокрытия);

	Если НЕ Конвертер.ЕстьИсточники() Тогда
		СервисПокрываемыхСтрок.ПрекратитьРасчет(ЗаданиеПокрываемых);
		Лог.Предупреждение(
			"Не найдено исходников конфигурации/расширений для сопоставления покрытия (--coverage-src %1)."
			+ " Отчёт не сформирован.", ПараметрыПокрытия.КаталогИсходников);
		Возврат;
	КонецЕсли;

	Покрытие = Конвертер.Конвертировать(СыройФайл);
	Покрытие = ОбъединитьСПокрываемыми(Покрытие, ЗаданиеПокрываемых);

	Если Покрытие.Количество() = 0 Тогда
		Лог.Предупреждение("Покрытие не сопоставлено ни с одним файлом исходников. Проверьте --coverage-src.");
	КонецЕсли;

	КореньПроекта = ВычислитьКореньПроекта(Покрытие, СобратьКаталогиИсходников(ПараметрыПокрытия));

	Лог.Отладка("Отчёт покрытия: корень проекта=<%1>, файлов в покрытии=%2, пример пути=<%3>",
		КореньПроекта, Покрытие.Количество(), ПримерПутиПокрытия(Покрытие));

	СтатФайл = ВременныеФайлы.НовоеИмяФайла("json");
	ЗаписьСтатистики = Новый ЗаписьStatJson();
	ЗаписьСтатистики.Записать(Покрытие, СтатФайл);

	Попытка
		СформироватьОтчетCoverage(ПараметрыПокрытия, СтатФайл, КореньПроекта);
	Исключение
		УдалитьВременный(СтатФайл);
		ВызватьИсключение;
	КонецПопытки;

	УдалитьВременный(СтатФайл);

КонецПроцедуры

// Слить исполненное покрытие с результатом фонового расчёта покрываемых строк и залогировать процент.
Функция ОбъединитьСПокрываемыми(Знач Покрытие, Знач ЗаданиеПокрываемых)

	Если ЗаданиеПокрываемых = Неопределено Тогда
		Возврат Покрытие;
	КонецЕсли;

	ПокрываемыеСтроки = СервисПокрываемыхСтрок.ДождатьсяРезультата(ЗаданиеПокрываемых);

	Слияние = Новый СлияниеПокрытия;
	Результат = Слияние.Слить(Покрытие, ПокрываемыеСтроки);
	Стат = Слияние.Статистика(Результат);

	Лог.Информация("Покрытие строк: %1%% (покрыто %2 из %3)", Стат.Процент, Стат.Покрыто, Стат.Всего);
	Возврат Результат;

КонецФункции

// Запустить фоновый расчёт покрываемых строк по исходникам конфигурации/расширений.
Функция ЗапуститьРасчетПокрываемых(Знач ПараметрыПокрытия)

	Каталоги = СобратьКаталогиИсходников(ПараметрыПокрытия);
	Если Каталоги.Количество() = 0 Тогда
		Лог.Предупреждение(
			"Не найдено каталогов исходников для расчёта покрываемых строк - процент покрытия не будет посчитан.");
		Возврат Неопределено;
	КонецЕсли;

	Возврат СервисПокрываемыхСтрок.ЗапуститьФоновыйРасчет(Каталоги);

КонецФункции

// Собрать каталоги исходников (конфигурация + расширения) для утилиты покрываемых строк.
Функция СобратьКаталогиИсходников(Знач ПараметрыПокрытия)

	Каталоги = Новый Массив;

	КаталогИсходников = ?(ЗначениеЗаполнено(ПараметрыПокрытия.КаталогИсходников),
		ПараметрыПокрытия.КаталогИсходников, "src");

	Если Новый Файл(КаталогИсходников).Существует() Тогда
		Результат = СервисПоискаИсточников.НайтиИсточники(КаталогИсходников);
		Для Каждого Путь Из Результат.Конфигурации Цикл
			Каталоги.Добавить(Путь);
		КонецЦикла;
		Для Каждого Путь Из Результат.Расширения Цикл
			Каталоги.Добавить(Путь);
		КонецЦикла;
	КонецЕсли;

	Для Каждого Путь Из ПараметрыПокрытия.КаталогиРасширений Цикл
		Каталоги.Добавить(Новый Файл(Путь).ПолноеИмя);
	КонецЦикла;

	Возврат Каталоги;

КонецФункции

// Нужно ли рассчитывать покрываемые строки (знаменатель) - по флагу параметров покрытия.
Функция НужноРассчитыватьПокрываемые(Знач ПараметрыПокрытия)
	Значение = Ложь;
	ПараметрыПокрытия.Свойство("РассчитыватьПокрываемыеСтроки", Значение);
	Возврат ?(Значение = Неопределено, Ложь, Значение);
КонецФункции

Процедура ЗаполнитьИсточники(Конвертер, Знач ПараметрыПокрытия)

	КаталогИсходников = ?(ЗначениеЗаполнено(ПараметрыПокрытия.КаталогИсходников),
		ПараметрыПокрытия.КаталогИсходников, "src");

	Если Новый Файл(КаталогИсходников).Существует() Тогда
		Результат = СервисПоискаИсточников.НайтиИсточники(КаталогИсходников);
		СервисПоискаИсточников.ПроверитьОдинИсточникКонфигурации(Результат.Конфигурации, КаталогИсходников);
		СервисПоискаИсточников.ПроверитьУникальностьИменРасширений(Результат.Расширения);

		Если Результат.Конфигурации.Количество() = 1 Тогда
			ПутьКонфигурации = Результат.Конфигурации[0];
			Конвертер.УстановитьКонфигурацию(ПутьКонфигурации, ОпределитьФормат(ПутьКонфигурации));
			Лог.Отладка("Покрытие: конфигурация %1", ПутьКонфигурации);
		КонецЕсли;

		Для Каждого ПутьРасширения Из Результат.Расширения Цикл
			ДобавитьРасширение(Конвертер, ПутьРасширения);
		КонецЦикла;
	КонецЕсли;

	Для Каждого ПутьРасширения Из ПараметрыПокрытия.КаталогиРасширений Цикл
		ДобавитьРасширение(Конвертер, Новый Файл(ПутьРасширения).ПолноеИмя);
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьРасширение(Конвертер, Знач ПутьРасширения)

	Если НЕ Новый Файл(ПутьРасширения).ЭтоКаталог() Тогда
		Лог.Отладка("Покрытие: источник расширения не является каталогом исходников, пропущен: %1", ПутьРасширения);
		Возврат;
	КонецЕсли;

	Формат = ОпределитьФормат(ПутьРасширения);
	ИмяРасширения = ОпределитьИмяРасширения(ПутьРасширения, Формат);
	Конвертер.ДобавитьРасширение(ИмяРасширения, ПутьРасширения, Формат);
	Лог.Отладка("Покрытие: расширение %1 (%2, %3)", ИмяРасширения, Формат, ПутьРасширения);

КонецПроцедуры

Процедура СформироватьОтчетCoverage(Знач ПараметрыПокрытия, Знач СтатФайл, Знач КореньПроекта)

	ФайлОтчета = Новый Файл(ПараметрыПокрытия.ПутьОтчета);
	КаталогОтчета = ФайлОтчета.Путь;
	Если ЗначениеЗаполнено(КаталогОтчета) И НЕ Новый Файл(КаталогОтчета).Существует() Тогда
		СоздатьКаталог(КаталогОтчета);
	КонецЕсли;

	Генератор = Новый ГенераторОтчетаПокрытия();
	Генератор.РабочийКаталог(?(ЗначениеЗаполнено(КаталогОтчета), КаталогОтчета, КореньПроекта))
		.КаталогПроекта(КореньПроекта)
		.КаталогИсходников(КореньПроекта)
		.ФайлСтатистики(СтатФайл)
		.ИмяФайлаСтатистики("__vrunner_no_stat__*.json")
		.ОтносительныеПути();

	Формат = НРег(ПараметрыПокрытия.ФорматОтчета);
	ИмяФайла = ФайлОтчета.Имя;
	Если Формат = "cobertura" Тогда
		Генератор.Cobertura(ИмяФайла);
	ИначеЕсли Формат = "clover" Тогда
		Генератор.Clover(ФайлОтчета.ИмяБезРасширения, ИмяФайла);
	Иначе
		Генератор.GenericCoverage(ИмяФайла);
	КонецЕсли;

	Генератор.Сформировать();

КонецПроцедуры

// Вычислить корень проекта как общий предок покрытых файлов и текущего каталога.
// Отчёт формируется относительно этого корня; так покрываемые исходники (в т.ч. вне
// рабочего каталога, заданные через --coverage-ext) попадают в отчёт.
// Корень проекта для отчёта - общий предок КАТАЛОГОВ ИСХОДНИКОВ и покрытых файлов.
// ВАЖНО: НЕ подмешиваем ТекущийКаталог() - на CI рабочий каталог временный и лежит далеко
// от исходников (в репозитории), их общий предок вырождается в "/" (Linux) или "" (разные
// диски Windows), и библиотека coverage тогда отфильтровывает ВСЕ файлы -> пустой отчёт.
// Пример путей покрытия (до 3) для диагностики соответствия исходникам.
Функция ПримерПутиПокрытия(Знач Покрытие)
	Примеры = Новый Массив;
	Для Каждого КлючЗначение Из Покрытие Цикл
		Примеры.Добавить(КлючЗначение.Ключ);
		Если Примеры.Количество() >= 3 Тогда // BSLLS:MagicNumber-off предел выборки примеров для лога
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Примеры, " | ");
КонецФункции

Функция ВычислитьКореньПроекта(Знач Покрытие, Знач КаталогиИсходников)

	// Корень берём по КАТАЛОГАМ ИСХОДНИКОВ (заданы пользователем/найдены под --coverage-src/-ext -
	// всегда согласованные пути ОС от Новый Файл().ПолноеИмя). Пути покрытых файлов сюда НЕ
	// подмешиваем: путь от утилиты lines-to-cover (Java) на Linux может отличаться по форме
	// (резолв симлинков рантайма), общий предок вырождается в "" -> откат на cwd -> отфильтровано
	// всё -> пустой отчёт. Исполненные файлы (из КонвертерИсходников) гарантированно лежат под
	// каталогами исходников, поэтому фильтр библиотеки coverage их пропустит.
	Пути = Новый Массив;
	Для Каждого Каталог Из КаталогиИсходников Цикл
		Если ЗначениеЗаполнено(Каталог) Тогда
			Пути.Добавить(Новый Файл(Каталог).ПолноеИмя);
		КонецЕсли;
	КонецЦикла;

	// Каталогов исходников нет (напр. только автоопределение не дало результата) - падаем на
	// предков покрытых файлов как раньше.
	Если Пути.Количество() = 0 Тогда
		Для Каждого КлючЗначение Из Покрытие Цикл
			Пути.Добавить(Новый Файл(КлючЗначение.Ключ).Путь);
		КонецЦикла;
	КонецЕсли;

	Если Пути.Количество() = 0 Тогда
		Возврат Новый Файл(ТекущийКаталог()).ПолноеИмя;
	КонецЕсли;

	Корень = ОбщийКореньПутей(Пути);
	Возврат ?(ЗначениеЗаполнено(Корень), Корень, Новый Файл(ТекущийКаталог()).ПолноеИмя);

КонецФункции

// Наибольший общий префикс путей (по сегментам, без учёта регистра).
Функция ОбщийКореньПутей(Знач Пути)

	Разделитель = ПолучитьРазделительПути();
	Общие = Неопределено;

	Для Каждого Путь Из Пути Цикл
		// Третий аргумент Истина (включать пустые) ОБЯЗАТЕЛЕН: на Linux ведущий разделитель даёт
		// пустой первый сегмент; без него итоговый корень теряет ведущий разделитель и перестаёт
		// быть префиксом путей файлов - библиотека coverage отфильтрует всё, отчёт выйдет пустым.
		Сегменты = СтрРазделить(Путь, Разделитель, Истина);
		Если Общие = Неопределено Тогда
			Общие = Сегменты;
		Иначе
			Общие = ОбщийПрефиксСегментов(Общие, Сегменты);
		КонецЕсли;
	КонецЦикла;

	Если Общие = Неопределено ИЛИ Общие.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат СтрСоединить(Общие, Разделитель);

КонецФункции

Функция ОбщийПрефиксСегментов(Знач Первый, Знач Второй)

	Результат = Новый Массив;
	Предел = Мин(Первый.Количество(), Второй.Количество());
	Индекс = 0;
	Пока Индекс < Предел Цикл
		Если НРег(Первый[Индекс]) <> НРег(Второй[Индекс]) Тогда
			Прервать;
		КонецЕсли;
		Результат.Добавить(Первый[Индекс]);
		Индекс = Индекс + 1;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Разобрать спецификацию сервера отладки [хост:]порт в режим старта/подключения.
// Правило: голый порт (или пусто) - поднять свой локально; наличие хоста - подключиться.
// Экспорт для юнит-тестов (чистая функция без зависимостей).
//
// Параметры:
//   Спец - Строка - "", "1550", "хост:9000", "хост", ":9000"
//
// Возвращаемое значение:
//   Структура - Хост (Строка), Порт (Число, 0 = по умолчанию), Подключиться (Булево)
//
Функция РазобратьАдресСервера(Знач Спец) Экспорт

	Результат = Новый Структура("Хост, Порт, Подключиться", "127.0.0.1", 0, Ложь);

	Спец = СокрЛП(?(Спец = Неопределено, "", Спец));
	Если НЕ ЗначениеЗаполнено(Спец) Тогда
		Возврат Результат;
	КонецЕсли;

	// Порт 0 означает "по умолчанию" - СервисСервераОтладки подставит свой дефолт (1550)
	// как для старта, так и для подключения.
	Позиция = СтрНайти(Спец, ":", НаправлениеПоиска.СКонца);
	Если Позиция > 0 Тогда
		Хост = СокрЛП(Лев(Спец, Позиция - 1));
		ПортСтр = СокрЛП(Сред(Спец, Позиция + 1));
		Результат.Порт = ?(ЭтоЧисло(ПортСтр), Число(ПортСтр), 0);
		Если ЗначениеЗаполнено(Хост) Тогда
			Результат.Хост = Хост;
			Результат.Подключиться = Истина;
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;

	Если ЭтоЧисло(Спец) Тогда
		Результат.Порт = Число(Спец);
	Иначе
		Результат.Хост = Спец;
		Результат.Подключиться = Истина;
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ЭтоЧисло(Знач Значение)
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Если СтрНайти("0123456789", Сред(Значение, Индекс, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

// Определить формат каталога исходников: XML-дамп при наличии Configuration.xml, иначе EDT.
Функция ОпределитьФормат(Знач Путь)
	Если Новый Файл(ОбъединитьПути(Путь, "Configuration.xml")).Существует() Тогда
		Возврат "XML";
	КонецЕсли;
	Возврат "EDT";
КонецФункции

// Определить имя расширения из дескриптора конфигурации, иначе - имя каталога.
Функция ОпределитьИмяРасширения(Знач Путь, Знач Формат)

	Если Формат = "XML" Тогда
		ФайлДескриптора = ОбъединитьПути(Путь, "Configuration.xml");
	Иначе
		ФайлДескриптора = ОбъединитьПути(Путь, "src", "Configuration", "Configuration.mdo");
	КонецЕсли;

	Имя = ПрочитатьИмяКонфигурации(ФайлДескриптора);
	Если ЗначениеЗаполнено(Имя) Тогда
		Возврат Имя;
	КонецЕсли;

	Возврат Новый Файл(Путь).Имя;

КонецФункции

// Прочитать имя конфигурации/расширения из первого элемента name/Name дескриптора.
Функция ПрочитатьИмяКонфигурации(Знач ФайлДескриптора)

	Если НЕ Новый Файл(ФайлДескриптора).Существует() Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Чтение = Новый ЧтениеТекста(ФайлДескриптора, КодировкаТекста.UTF8);
		Содержимое = Чтение.Прочитать();
		Чтение.Закрыть();
	Исключение
		Возврат "";
	КонецПопытки;

	Если Содержимое = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Позиция = СтрНайти(НРег(Содержимое), "<name>");
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Содержимое, Позиция + СтрДлина("<name>"));
	ПозицияКонца = СтрНайти(Хвост, "<");
	Если ПозицияКонца = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат СокрЛП(Лев(Хвост, ПозицияКонца - 1));

КонецФункции

// Определить алиас (имя) ИБ для сессии отладки.
Функция ОпределитьАлиас(Знач ПараметрыПодключения, Знач ЯвныйАлиас)

	Если ЗначениеЗаполнено(ЯвныйАлиас) Тогда
		Возврат ЯвныйАлиас;
	КонецЕсли;

	СтрокаПодключения = "";
	Если ПараметрыПодключения <> Неопределено
		И ПараметрыПодключения.Свойство("СтрокаПодключения")
		И ЗначениеЗаполнено(ПараметрыПодключения.СтрокаПодключения) Тогда
		СтрокаПодключения = СокрЛП(ПараметрыПодключения.СтрокаПодключения);
	КонецЕсли;

	// Серверная ИБ: /S"сервер\ИмяИБ" (или сервер/ИмяИБ) - алиасом выступает имя ИБ.
	Если СтрНачинаетсяС(ВРег(СтрокаПодключения), "/S") Тогда
		Тело = СокрЛП(Сред(СтрокаПодключения, СтрДлина("/S") + 1));
		Тело = СтрЗаменить(Тело, """", "");
		Тело = СтрЗаменить(Тело, "\", "/");
		Части = СтрРазделить(Тело, "/", Ложь);
		Если Части.Количество() > 0 И ЗначениеЗаполнено(Части[Части.ВГраница()]) Тогда
			Возврат СокрЛП(Части[Части.ВГраница()]);
		КонецЕсли;
	КонецЕсли;

	Возврат "DefAlias";

КонецФункции

Функция Фабрика()

	Если _ФабрикаCoveragebsl = Неопределено Тогда
		_ФабрикаCoveragebsl = ЗагрузитьСценарийИзСтроки(ТекстФабрикиCoveragebsl());
	КонецЕсли;

	Возврат _ФабрикаCoveragebsl;

КонецФункции

// Текст модуля-фабрики, лениво подключающего нативную компоненту coveragebsl.
// Вынесено сюда, чтобы #Использовать coveragebsl не выполнялся при старте vrunner
// (autumn компилирует все классы при сканировании, а компонента нативная).
Функция ТекстФабрикиCoveragebsl()
	Строки = Новый Массив;
	Строки.Добавить("#Использовать coveragebsl");
	Строки.Добавить("Функция СоздатьМенеджер(Знач Адрес) Экспорт");
	Строки.Добавить("	Возврат Новый МенеджерПокрытия(Адрес);");
	Строки.Добавить("КонецФункции");
	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

Процедура УдалитьВременный(Знач Путь)
	Попытка
		Если ЗначениеЗаполнено(Путь) И Новый Файл(Путь).Существует() Тогда
			УдалитьФайлы(Путь);
		КонецЕсли;
	Исключение
		Лог.Отладка("Не удалось удалить временный файл %1: %2", Путь, ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

#КонецОбласти
