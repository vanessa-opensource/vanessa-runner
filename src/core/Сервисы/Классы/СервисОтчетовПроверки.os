// BSLLS:MissingVariablesDescription-off Поля autumn (&Лог/&Пластилин/&Желудь).
// BSLLS:UnusedLocalMethod-off ПриСозданииОбъекта вызывается рантаймом при Новый.
// BSLLS:NumberOfValuesInStructureConstructor-off Описание случая отчёта - плоская структура.
// Отчёты проверок validate syntax-check и validate edt в форматах JUnit и Allure: случай описывается
// один раз и раскладывается по генераторам. Каталоги отчётов заранее готовит и test xunit.

&Лог("vrunner")
Перем Лог;

&Пластилин
Перем ФайловыеОперации;

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Имя формата отчёта JUnit XML.
//
// Возвращаемое значение:
//   Строка
//
Функция ФорматJUnit() Экспорт
	Возврат "junit";
КонецФункции

// Имя формата результатов Allure 2.
//
// Возвращаемое значение:
//   Строка
//
Функция ФорматAllure() Экспорт
	Возврат "allure";
КонецФункции

// Имя формата сырого файла результатов проверки 1С:EDT.
//
// Возвращаемое значение:
//   Строка
//
Функция ФорматEDT() Экспорт
	Возврат "edt";
КонецФункции

// Создать каталоги отчётов заранее: проверка идёт минутами, и падение на записи отчёта
// в самом конце обесценивает весь прогон (issue #746).
//
// Параметры:
//   Отчеты - Массив - Элементы <Структура> с полями Формат и Путь; путь allure - каталог, остальных - файл
//   Очищать - Булево - Истина: каталог отчёта очищается от прошлых прогонов
//       (у файлового отчёта - каталог файла, у allure - сам каталог)
//
Процедура ПодготовитьКаталоги(Знач Отчеты, Знач Очищать = Ложь) Экспорт

	Каталоги = Новый Массив;
	Для Каждого Отчет Из Отчеты Цикл
		Если Отчет.Формат = ФорматAllure() Тогда
			Каталоги.Добавить(Отчет.Путь);
		Иначе
			Каталоги.Добавить(ФайловыеОперации.КаталогФайла(Отчет.Путь));
		КонецЕсли;
	КонецЦикла;

	// Сначала очистка всех, потом создание: каталог allure может лежать внутри каталога junit-файла.
	Если Очищать Тогда
		Для Каждого Каталог Из Каталоги Цикл
			ФайловыеОперации.ОбеспечитьПустойКаталог(Каталог);
		КонецЦикла;
	КонецЕсли;

	Для Каждого Каталог Из Каталоги Цикл
		ФайловыеОперации.ОбеспечитьКаталог(Каталог);
	КонецЦикла;

КонецПроцедуры

// Описание тест-кейса отчёта, общее для JUnit и Allure.
//
// Параметры:
//   Имя - Строка - имя тест-кейса
//   Статус - Строка - passed, failed или broken; в JUnit проваленным считается только failed
//   Сообщение - Строка - текст замечания
//
// Возвращаемое значение:
//   Структура:
//    * Имя - Строка - имя тест-кейса
//    * Сообщение - Строка - текст замечания
//    * Статус - Строка - passed, failed или broken
//    * Пакет - Строка - объект метаданных либо категория замечания (метка package в Allure)
//    * ИмяКласса - Строка - атрибут classname в JUnit; пусто - имя набора
//    * Важность - Строка - важность Allure: blocker, critical, normal, minor, trivial
//
Функция НовыйСлучай(Знач Имя, Знач Статус = "failed", Знач Сообщение = "") Экспорт

	Возврат Новый Структура("Имя, Сообщение, Статус, Пакет, ИмяКласса, Важность",
		Имя, Сообщение, Статус, "", "", "normal");

КонецФункции

// Записать отчёты проверки в форматах junit и allure; прочие форматы (edt) пишет не vrunner.
// Успешную проверку тоже показываем кейсом: пустой набор в отчёте неотличим от прогона,
// который до отчёта не дошёл.
//
// Параметры:
//   Отчеты - Массив - Элементы <Структура> с полями Формат и Путь
//   Случаи - Массив - Элементы <Структура> (см. НовыйСлучай); пустой - один успешный кейс
//   ИмяНабора - Строка - имя тестового набора
//   ДатаНачала - Дата - начало проверки, универсальное время
//   ИмяУспешногоСлучая - Строка - имя кейса, когда замечаний нет
//
Процедура Записать(Знач Отчеты, Знач Случаи, Знач ИмяНабора, Знач ДатаНачала, Знач ИмяУспешногоСлучая) Экспорт

	Если Случаи.Количество() = 0 Тогда
		Случаи = Новый Массив;
		Случаи.Добавить(НовыйСлучай(ИмяУспешногоСлучая, "passed"));
	КонецЕсли;

	ДлительностьСек = ТекущаяУниверсальнаяДата() - ДатаНачала;

	Для Каждого Отчет Из Отчеты Цикл
		Если Отчет.Формат = ФорматJUnit() Тогда
			ЗаписатьОтчетJUnit(Отчет.Путь, Случаи, ИмяНабора, ДлительностьСек);
		КонецЕсли;
		Если Отчет.Формат = ФорматAllure() Тогда
			ЗаписатьРезультатыAllure(Отчет.Путь, Случаи, ИмяНабора, ДатаНачала, ДлительностьСек);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаписатьОтчетJUnit(Знач ПутьОтчета, Знач Случаи, Знач ИмяНабора, Знач ДлительностьСек)

	Лог.Информация("Генерация отчёта JUnit: %1", ПутьОтчета);

	Генератор = Новый ГенераторОтчетаJUnit(ИмяНабора);

	СлучаиJUnit = Новый Массив;
	Для Каждого Случай Из Случаи Цикл
		СлучайJUnit = Генератор.НовыйСлучай(Случай.Имя, Случай.ИмяКласса);
		СлучайJUnit.Провален = Случай.Статус = "failed";
		СлучайJUnit.Сообщение = Случай.Сообщение;
		СлучаиJUnit.Добавить(СлучайJUnit);
	КонецЦикла;

	Генератор.Записать(ПутьОтчета, СлучаиJUnit, ДлительностьСек);

	Лог.Информация("Отчёт JUnit сохранён: %1", ПутьОтчета);

КонецПроцедуры

Процедура ЗаписатьРезультатыAllure(Знач КаталогРезультатов, Знач Случаи, Знач ИмяНабора, Знач ДатаНачала,
		Знач ДлительностьСек)

	Лог.Информация("Генерация результатов Allure: %1", КаталогРезультатов);

	Генератор = Новый ГенераторОтчетаAllure(ИмяНабора);

	СлучаиAllure = Новый Массив;
	Для Каждого Случай Из Случаи Цикл
		СлучайAllure = Генератор.НовыйСлучай(Случай.Имя, Случай.Статус);
		ЗаполнитьЗначенияСвойств(СлучайAllure, Случай, "Сообщение, Пакет, Важность");
		СлучаиAllure.Добавить(СлучайAllure);
	КонецЦикла;

	Записано = Генератор.Записать(КаталогРезультатов, СлучаиAllure, ДатаНачала, ДлительностьСек);

	Лог.Информация("Результаты Allure сохранены: %1, файлов: %2", КаталогРезультатов, Записано);

КонецПроцедуры

#КонецОбласти
