// BSLLS:MissingVariablesDescription-off Поля autumn (&Лог/&Пластилин)
// BSLLS:MissingParameterDescription-off Внутренние служебные методы.
// Сценарий infobase init: создание файловой ИБ или использование серверной, загрузка конфигурации
// (dt, cf или исходники) и расширений.

&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисПлатформы;

&Пластилин
Перем СервисКонфигурации;

&Пластилин
Перем СервисРасчетаИнкремента;

&Пластилин
Перем СервисРасширений;

&Пластилин
Перем СервисПоискаИсточников;

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Шаблон параметров Инициализировать.
//
// Возвращаемое значение:
//   Структура - параметры сценария:
//     * ПараметрыПодключения - Структура, Неопределено - подключение к серверной ИБ, обязательно без КаталогБазы;
//                              с ТипСУБД - ИБ создаётся по параметрам СУБД
//     * КаталогБазы - Строка - каталог создаваемой файловой ИБ; пусто - серверная ИБ по ПараметрыПодключения
//     * Источник - Строка - каталог исходников, *.cf или *.dt; пусто - конфигурация не загружается
//     * Расширения - Массив из Строка - .cfe-файлы и каталоги исходников расширений
//     * ПараметрыПлатформы - Структура, Неопределено - параметры платформы
//     * ПараметрыИсходников - Структура, Неопределено - параметры подготовки исходников
//
Функция НовыеПараметры() Экспорт
	Возврат Новый Структура(
		"ПараметрыПодключения, КаталогБазы, Источник, Расширения, ПараметрыПлатформы, ПараметрыИсходников");
КонецФункции

// Источники, найденные рекурсивным поиском (--recursive). В Источник ищутся конфигурация и расширения,
// в каталогах Расширения - только расширения (конфигурации там игнорируются с предупреждением).
//
// Параметры:
//   Источник - Строка - корень поиска конфигурации и расширений; пусто - не задан
//   Расширения - Массив из Строка - корни поиска расширений
//
// Возвращаемое значение:
//   Структура - найденные источники:
//     * Источник - Строка - путь к конфигурации; пусто - не найдена
//     * Расширения - Массив из Строка - пути к расширениям
//
Функция РазрешитьИсточникиРекурсивно(Знач Источник, Знач Расширения) Экспорт

	Найденные = Новый Структура("Источник, Расширения", "", Новый Массив);

	Если ЗначениеЗаполнено(Источник) Тогда
		Найдено = СервисПоискаИсточников.НайтиИсточники(Источник);
		СервисПоискаИсточников.ПроверитьОдинИсточникКонфигурации(Найдено.Конфигурации, Источник);
		Если Найдено.Конфигурации.Количество() = 1 Тогда
			Найденные.Источник = Найдено.Конфигурации[0];
		Иначе
			Лог.Предупреждение("Рекурсивный поиск в ""%1"": источник конфигурации не найден", Источник);
		КонецЕсли;
		ДобавитьВсе(Найденные.Расширения, Найдено.Расширения);
	КонецЕсли;

	Если ЗначениеЗаполнено(Расширения) Тогда
		Для Каждого КаталогРасширений Из Расширения Цикл
			Найдено = СервисПоискаИсточников.НайтиИсточники(КаталогРасширений);
			ПредупредитьОИгнорируемыхКонфигурациях(КаталогРасширений, Найдено.Конфигурации);
			ДобавитьВсе(Найденные.Расширения, Найдено.Расширения);
		КонецЦикла;
	КонецЕсли;

	СервисПоискаИсточников.ПроверитьУникальностьИменРасширений(Найденные.Расширения);

	Возврат Найденные;

КонецФункции

// Инициализировать ИБ: создать файловую (существующий каталог удаляется) или использовать серверную,
// загрузить конфигурацию из источника и расширения.
//
// Параметры:
//   Параметры - Структура - см. НовыеПараметры
//
// Возвращаемое значение:
//   Структура - параметры подключения к созданной или использованной ИБ
//
Функция Инициализировать(Знач Параметры) Экспорт

	ПараметрыПодключения = Параметры.ПараметрыПодключения;

	Если ЗначениеЗаполнено(Параметры.КаталогБазы) Тогда
		УдалитьСуществующийКаталогБазы(Параметры.КаталогБазы);
		ПараметрыПодключения = СервисПлатформы.СоздатьФайловуюБазу(Параметры.КаталогБазы, Параметры.ПараметрыПлатформы);
	ИначеЕсли ПараметрыПодключения <> Неопределено И ПараметрыПодключения.Свойство("ТипСУБД") Тогда
		Лог.Информация("Создание серверной ИБ с использованием параметров СУБД");
	Иначе
		Лог.Информация("Используется существующая серверная ИБ: %1", ПараметрыПодключения.СтрокаПодключения);
	КонецЕсли;

	Если ЗначениеЗаполнено(Параметры.Источник) Тогда
		ЗагрузитьИзИсточника(ПараметрыПодключения, Параметры);
	КонецЕсли;

	Если ЗначениеЗаполнено(Параметры.Расширения) Тогда
		ЗагрузитьРасширения(ПараметрыПодключения, Параметры);
	КонецЕсли;

	Возврат ПараметрыПодключения;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьВсе(Приемник, Знач Элементы)
	Для Каждого Элемент Из Элементы Цикл
		Приемник.Добавить(Элемент);
	КонецЦикла;
КонецПроцедуры

Процедура ПредупредитьОИгнорируемыхКонфигурациях(Знач Каталог, Знач Конфигурации)
	КоличествоКонфигураций = Конфигурации.Количество();
	Если КоличествоКонфигураций > 0 Тогда
		Лог.Предупреждение(
			"В каталоге расширений ""%1"" обнаружены источники конфигурации (%2 шт.) - проигнорированы:"
			+ " --ext загружает только расширения.",
			Каталог, КоличествоКонфигураций);
	КонецЕсли;
КонецПроцедуры

Процедура УдалитьСуществующийКаталогБазы(Знач КаталогБазы)

	Если Новый Файл(КаталогБазы).Существует() Тогда
		Лог.Отладка("Удаление существующего каталога базы: %1", КаталогБазы);
		УдалитьФайлы(КаталогБазы);
	КонецЕсли;

КонецПроцедуры

Процедура ЗагрузитьИзИсточника(Знач ПараметрыПодключения, Знач Параметры)

	Источник = Параметры.Источник;
	ПараметрыПлатформы = Параметры.ПараметрыПлатформы;

	Если СервисПоискаИсточников.ВидИсточника(Источник, Истина) = "dt" Тогда
		Лог.Информация("Загрузка инфобазы из файла DT: %1", Источник); // BSLLS:Typo-off
		СервисПлатформы.ЗагрузитьИнфобазуИзФайла(ПараметрыПодключения, Источник, ПараметрыПлатформы);
		Возврат;
	КонецЕсли;

	ВидИсточника = СервисКонфигурации.ЗагрузитьИсточник(
		ПараметрыПодключения, Источник, ПараметрыПлатформы, Параметры.ПараметрыИсходников);
	СервисПлатформы.ОбновитьКонфигурациюБД(ПараметрыПодключения, ПараметрыПлатформы);

	Если ВидИсточника <> "cf" Тогда
		СервисРасчетаИнкремента.ПересоздатьИндекс(Источник, ПараметрыПодключения);
	КонецЕсли;

КонецПроцедуры

// Загружает расширения и применяет их к БД одним обновлением - до установки свойств
// (обработке в 1С:Предприятии нужно уже применённое к базе расширение).
Процедура ЗагрузитьРасширения(Знач ПараметрыПодключения, Знач Параметры)

	ПараметрыПлатформы = Параметры.ПараметрыПлатформы;

	ИменаРасширений = Новый Массив;
	Для Каждого ПутьРасширения Из Параметры.Расширения Цикл
		Лог.Информация("Загрузка расширения из источника: %1", ПутьРасширения);
		ИмяЗагруженного = СервисРасширений.ЗагрузитьРасширениеВБазу(
			ПараметрыПодключения,
			ПутьРасширения,
			"",
			ПараметрыПлатформы,
			Ложь,
			Параметры.ПараметрыИсходников);
		ИменаРасширений.Добавить(ИмяЗагруженного);
	КонецЦикла;

	Лог.Информация("Обновление конфигурации БД для загруженных расширений");
	СервисПлатформы.ОбновитьКонфигурациюБД(
		ПараметрыПодключения,
		ПараметрыПлатформы,
		Новый Структура("ОбновитьВсеРасширения", Истина));

	// Без флагов: в режиме конфигуратора - дефолты свойств, чтобы расширения работали сразу после init.
	Для Каждого ИмяРасширения Из ИменаРасширений Цикл
		СервисРасширений.ПрименитьСвойства(ПараметрыПодключения, ИмяРасширения, Новый Структура, ПараметрыПлатформы);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
