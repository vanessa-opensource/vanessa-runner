// BSLLS:MissingVariablesDescription-off Поля autumn (&Лог/&Пластилин/&Желудь).
// BSLLS:UnusedLocalMethod-off ПриСозданииОбъекта вызывается рантаймом при Новый.
// BSLLS:NumberOfValuesInStructureConstructor-off Описание случая отчёта - плоская структура.
// BSLLS:LatinAndCyrillicSymbolInWord-off Ключи конфигуратора (AllExtensions, Extension) в идентификаторах.
// Синтаксическая проверка конфигурации (/CheckConfig) - предметная логика команды
// validate syntax-check: режимы и цели проверки, прогон по целям, фильтрация вывода
// конфигуратора по исключениям и раскладка замечаний по тест-кейсам отчёта.
//
// Область проверки у /CheckConfig взаимоисключающая: за один запуск проверяется либо
// основная конфигурация, либо расширения, а ключ -Extension не мультизначный.
// Поэтому каждая цель - отдельный запуск конфигуратора.

&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисПлатформы;

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Ключи видов проверки для /CheckConfig: значения --mode с ведущим дефисом, а без явных
// режимов - набор по умолчанию. AllExtensions - не вид проверки, а область: он уходит
// в цели (см. ЦелиПроверки).
//
// Параметры:
//   ЗаданныеРежимы - Массив, Неопределено - значения опции --mode
//
// Возвращаемое значение:
//   Массив - Элементы <Строка>, ключи вида "-ThinClient"
//
Функция РежимыПроверки(Знач ЗаданныеРежимы) Экспорт

	Режимы = Новый Массив;

	Если ЗаданныеРежимы <> Неопределено Тогда
		Для Каждого Режим Из ЗаданныеРежимы Цикл
			Если ЭтоВсеРасширения(Режим) Тогда
				Продолжить;
			КонецЕсли;
			Режимы.Добавить(?(СтрНачинаетсяС(Режим, "-"), Режим, "-" + Режим));
		КонецЦикла;
	КонецЕсли;

	Если Режимы.Количество() > 0 Тогда
		Возврат Режимы;
	КонецЕсли;

	Режимы.Добавить("-ThinClient");
	Режимы.Добавить("-WebClient");
	Режимы.Добавить("-Server");
	Режимы.Добавить("-ExternalConnection");
	Режимы.Добавить("-ThickClientOrdinaryApplication");
	Возврат Режимы;

КонецФункции

// Цели проверки: значения --target, а без них - всё: основная конфигурация и все расширения
// (как --target у infobase update). Значение AllExtensions в устаревшей опции --mode (так
// область задавалась до появления --target) считается такой же целью и сужает проверку
// до расширений.
//
// Параметры:
//   ЗаданныеЦели - Массив, Неопределено - значения опции --target
//   ЗаданныеРежимы - Массив, Неопределено - значения опции --mode
//
// Возвращаемое значение:
//   Массив - Элементы <Строка>: main, AllExtensions либо имена расширений
//
Функция ЦелиПроверки(Знач ЗаданныеЦели, Знач ЗаданныеРежимы = Неопределено) Экспорт

	Цели = Новый Массив;

	Если ЗаданныеЦели <> Неопределено Тогда
		Для Каждого Цель Из ЗаданныеЦели Цикл
			Если ЗначениеЗаполнено(СокрЛП(Цель)) Тогда
				Цели.Добавить(СокрЛП(Цель));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Если Цели.Количество() = 0 И ЕстьВсеРасширения(ЗаданныеРежимы) Тогда
		Цели.Добавить(ИмяВсехРасширений());
	КонецЕсли;

	Если Цели.Количество() = 0 Тогда
		Цели.Добавить(ИмяКонфигурации());
		Цели.Добавить(ИмяВсехРасширений());
	КонецЕсли;

	Возврат Цели;

КонецФункции

// Прогнать проверку по целям и вернуть склеенный вывод конфигуратора.
// Расширения, перечисленные поимённо, после проверки всех расширений не гоняются.
//
// Параметры:
//   Режимы - Массив - ключи видов проверки (см. РежимыПроверки)
//   Цели - Массив - цели проверки (см. ЦелиПроверки)
//   ПараметрыПодключения - Структура, Неопределено - параметры подключения к ИБ
//   ПараметрыХранилища - Структура, Неопределено - параметры хранилища
//   ПараметрыПлатформы - Структура - версия платформы и прочее
//
// Возвращаемое значение:
//   Строка - вывод конфигуратора по всем целям
//
Функция Проверить(Знач Режимы, Знач Цели, Знач ПараметрыПодключения,
		Знач ПараметрыХранилища, Знач ПараметрыПлатформы) Экспорт

	ВыводЛога = "";

	Если ЕстьЦель(Цели, ИмяКонфигурации()) Тогда
		ВыводЦели = ПроверитьЦель("основная конфигурация", "",
			Режимы, ПараметрыПодключения, ПараметрыХранилища, ПараметрыПлатформы);
		ВыводЛога = ДополнитьВывод(ВыводЛога, ВыводЦели);
	КонецЕсли;

	Если ЕстьЦель(Цели, ИмяВсехРасширений()) Тогда
		ВыводЦели = ПроверитьЦель("все расширения", "-AllExtensions",
			Режимы, ПараметрыПодключения, ПараметрыХранилища, ПараметрыПлатформы);
		Возврат ДополнитьВывод(ВыводЛога, ВыводЦели);
	КонецЕсли;

	Для Каждого Цель Из Цели Цикл
		Если ЭтоЦель(Цель, ИмяКонфигурации()) Тогда
			Продолжить;
		КонецЕсли;
		ВыводЦели = ПроверитьЦель(СтрШаблон("расширение ""%1""", Цель), СтрШаблон("-Extension ""%1""", Цель),
			Режимы, ПараметрыПодключения, ПараметрыХранилища, ПараметрыПлатформы);
		ВыводЛога = ДополнитьВывод(ВыводЛога, ВыводЦели);
	КонецЦикла;

	Возврат ВыводЛога;

КонецФункции

// Замечания из вывода конфигуратора: без типовых исключений (обработчики Подключаемый_,
// «Ошибок не обнаружено») и без исключений из файла пользователя.
//
// Параметры:
//   ВыводЛога - Строка - вывод конфигуратора
//   ФайлИсключений - Строка - файл исключений (UTF-8, по строке на исключение); пусто - без файла
//
// Возвращаемое значение:
//   Массив - Элементы <Строка>, строки замечаний; многострочные замечания склеены в одну строку
//
Функция ОтфильтроватьЗамечания(Знач ВыводЛога, Знач ФайлИсключений = "") Экспорт

	Исключения = ТиповыеИсключения();
	Для Каждого Искл Из ПрочитатьФайлИсключений(ФайлИсключений) Цикл
		Исключения.Добавить(Искл);
	КонецЦикла;

	ОставшиесяОшибки = Новый Массив;
	Если НЕ ЗначениеЗаполнено(ВыводЛога) Тогда
		Возврат ОставшиесяОшибки;
	КонецЕсли;

	ОбработанныйЛог = СтрЗаменить(ВыводЛога, Символы.ВК + Символы.Таб, Символы.Таб);
	ОбработанныйЛог = СтрЗаменить(ОбработанныйЛог, Символы.ПС + Символы.Таб, Символы.Таб);

	// Склейка до фильтра: пользовательские исключения должны матчиться и по фрагменту кода,
	// который конфигуратор печатает второй строкой.
	МассивСтрок = НовыйРазборЗамечаний().СклеитьПродолжения(СтрРазделить(ОбработанныйЛог, Символы.ПС));
	Для Каждого ТекСтрока Из МассивСтрок Цикл
		Если НЕ СтрокаИсключена(ТекСтрока, Исключения) Тогда
			ОставшиесяОшибки.Добавить(ТекСтрока);
		КонецЕсли;
	КонецЦикла;

	Возврат ОставшиесяОшибки;

КонецФункции

// Разложить замечания по тест-кейсам отчёта: по умолчанию тест-кейс на строку замечания,
// с группировкой - тест-кейс на объект метаданных со всеми его замечаниями в сообщении.
//
// Параметры:
//   Замечания - Массив - Элементы <Строка>, строки замечаний после фильтрации
//   ГруппироватьПоМетаданным - Булево - группировать по объектам метаданных (--groupbymetadata)
//
// Возвращаемое значение:
//   Массив - Элементы <Структура>:
//    * Имя       - Строка - имя тест-кейса
//    * Сообщение - Строка - текст для элемента failure
//    * Пакет     - Строка - объект метаданных замечания, метка package в отчёте Allure
//
Функция СлучаиОтчета(Знач Замечания, Знач ГруппироватьПоМетаданным = Ложь) Экспорт

	Случаи = Новый Массив;
	Разбор = НовыйРазборЗамечаний();

	Если ГруппироватьПоМетаданным Тогда

		Для Каждого Группа Из Разбор.Сгруппировать(Замечания) Цикл
			ТекстЗамечаний = Разбор.ТекстЗамечанийГруппы(Группа);
			Случай = Новый Структура("Имя, Сообщение, Пакет", Группа.ИмяГруппы, ТекстЗамечаний, Группа.ИмяГруппы);
			Случаи.Добавить(Случай);
		КонецЦикла;

		Возврат Случаи;

	КонецЕсли;

	Для Каждого Замечание Из Замечания Цикл
		ИмяГруппы = Разбор.Разобрать(Замечание).ИмяГруппы;
		Случай = Новый Структура("Имя, Сообщение, Пакет", Замечание, Замечание, ИмяГруппы);
		Случаи.Добавить(Случай);
	КонецЦикла;

	Возврат Случаи;

КонецФункции

// Имя единственного тест-кейса отчёта, когда замечаний нет.
//
// Возвращаемое значение:
//   Строка
//
Функция ИмяПроверкиПоУмолчанию() Экспорт
	Возврат "Синтаксическая проверка конфигурации";
КонецФункции

// Зарезервированное значение цели «основная конфигурация».
//
// Возвращаемое значение:
//   Строка
//
Функция ИмяКонфигурации() Экспорт
	Возврат "main";
КонецФункции

// Зарезервированное значение цели «все расширения».
//
// Возвращаемое значение:
//   Строка
//
Функция ИмяВсехРасширений() Экспорт
	Возврат "AllExtensions";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Прогнать одну цель проверки.
//
// Параметры:
//   Представление        - Строка - как цель показывать в логе
//   КлючОбласти          - Строка - ключ /CheckConfig; пустой для основной конфигурации
//   Режимы               - Массив - ключи видов проверок
//   ПараметрыПодключения - Структура, Неопределено - параметры подключения к ИБ
//   ПараметрыХранилища   - Структура, Неопределено - параметры хранилища
//   ПараметрыПлатформы   - Структура - версия платформы и прочее
//
// Возвращаемое значение:
//   Строка - вывод конфигуратора по этой цели
//
Функция ПроверитьЦель(Знач Представление, Знач КлючОбласти, Знач Режимы,
		Знач ПараметрыПодключения, Знач ПараметрыХранилища, Знач ПараметрыПлатформы)

	Лог.Информация("Проверка: %1", Представление);

	Ключи = Новый Массив;
	Для Каждого Ключ Из Режимы Цикл
		Ключи.Добавить(Ключ);
	КонецЦикла;
	Если ЗначениеЗаполнено(КлючОбласти) Тогда
		Ключи.Добавить(КлючОбласти);
	КонецЕсли;

	Результат = СервисПлатформы.ПроверитьКонфигурацию(
		ПараметрыПодключения, Ключи, ПараметрыХранилища, ПараметрыПлатформы);

	Возврат Результат.ВыводКоманды;

КонецФункции

Функция ЕстьЦель(Знач Цели, Знач Имя)

	Для Каждого Цель Из Цели Цикл
		Если ЭтоЦель(Цель, Имя) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ЭтоЦель(Знач Цель, Знач Имя)
	Возврат НРег(СокрЛП(Цель)) = НРег(Имя);
КонецФункции

Функция ДополнитьВывод(Знач ВыводЛога, Знач ВыводЦели)
	Возврат ВыводЛога + ?(ПустаяСтрока(ВыводЛога), "", Символы.ПС) + ВыводЦели;
КонецФункции

Функция ЭтоВсеРасширения(Знач Режим)
	Возврат НРег(СтрЗаменить(СокрЛП(Режим), "-", "")) = НРег(ИмяВсехРасширений());
КонецФункции

Функция ЕстьВсеРасширения(Знач Режимы)

	Если Режимы = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Режим Из Режимы Цикл
		Если ЭтоВсеРасширения(Режим) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ТиповыеИсключения()

	Результат = Новый Массив;
	Результат.Добавить(НРег("Не обнаружено ссылок на процедуру: ""Подключаемый_"));
	Результат.Добавить(НРег("Не обнаружено ссылок на функцию: ""Подключаемый_"));
	Результат.Добавить(НРег("Пустой обработчик: ""Подключаемый_"));
	Результат.Добавить(НРег("No links to function found: ""Attachable_"));
	Результат.Добавить(НРег("No links to procedure found: ""Attachable_"));
	Результат.Добавить(НРег("Empty handler: ""Attachable_"));
	Результат.Добавить(НРег("Ошибок не обнаружено"));
	Результат.Добавить(НРег("No syntax errors found"));
	Результат.Добавить(НРег("No errors found"));
	Возврат Результат;

КонецФункции

Функция ПрочитатьФайлИсключений(Знач ФайлИсключений)

	Результат = Новый Массив;

	Если НЕ ЗначениеЗаполнено(ФайлИсключений) Тогда
		Возврат Результат;
	КонецЕсли;

	Если НЕ Новый Файл(ФайлИсключений).Существует() Тогда
		Лог.Предупреждение("Файл исключений не найден: %1", ФайлИсключений);
		Возврат Результат;
	КонецЕсли;

	Лог.Отладка("Чтение файла исключений: %1", ФайлИсключений);
	ЧтениеТекста = Новый ЧтениеТекста(ФайлИсключений, КодировкаТекста.UTF8);
	Строка = ЧтениеТекста.ПрочитатьСтроку();
	Пока Строка <> Неопределено Цикл
		Если НЕ ПустаяСтрока(Строка) Тогда
			Результат.Добавить(НРег(СокрЛП(Строка)));
		КонецЕсли;
		Строка = ЧтениеТекста.ПрочитатьСтроку();
	КонецЦикла;
	ЧтениеТекста.Закрыть();

	Лог.Отладка("Прочитано исключений: %1", Результат.Количество());
	Возврат Результат;

КонецФункции

Функция СтрокаИсключена(Знач ПроверяемаяСтрока, Знач Исключения)

	Если НЕ ЗначениеЗаполнено(ПроверяемаяСтрока) Тогда
		Возврат Истина;
	КонецЕсли;

	НормализованнаяСтрока = НРег(СокрЛП(ПроверяемаяСтрока));
	Для Каждого ТекИсключение Из Исключения Цикл
		Если СтрНайти(НормализованнаяСтрока, ТекИсключение) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция НовыйРазборЗамечаний()
	Возврат Новый РазборЗамечанийСинтаксиса(ИмяПроверкиПоУмолчанию());
КонецФункции

#КонецОбласти
