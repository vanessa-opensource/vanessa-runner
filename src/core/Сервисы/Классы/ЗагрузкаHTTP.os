// BSLLS:MagicNumber-off Порты по умолчанию (443/80).
// BSLLS:NumberOfValuesInStructureConstructor-off
// BSLLS:LatinAndCyrillicSymbolInWord-off Технические идентификаторы (HTTP, URL).
// Загрузка файла по HTTP и разбор адреса для HTTPСоединение.

#Область ПрограммныйИнтерфейс

// Адрес файла релиза: <база>/v<версия>/<имя файла>. Хвостовые слеши базы отбрасываются.
//
// Параметры:
//   БазовыйАдрес - Строка - URL каталога релизов без завершающего слеша
//   Версия - Строка - номер версии без префикса v
//   ИмяФайла - Строка - имя архива
//
// Возвращаемое значение:
//   Строка
//
Функция АдресРелиза(Знач БазовыйАдрес, Знач Версия, Знач ИмяФайла) Экспорт

	База = СокрЛП(БазовыйАдрес);
	Пока ПравыйСимвол(База) = "/" Цикл
		База = Лев(База, СтрДлина(База) - 1);
	КонецЦикла;

	Возврат СтрШаблон("%1/v%2/%3", База, Версия, ИмяФайла);

КонецФункции

// Разобрать URL на компоненты для HTTPСоединение.
// Схема сохраняется в поле СХостом: OneScript требует протокол в адресе хоста для https.
//
// Параметры:
//   Адрес - Строка - "https://host[:port]/resource"
//
// Возвращаемое значение:
//   Структура - СХостом ("https://host"), Хост, Порт (Число), Ресурс ("/...")
//
Функция РазобратьАдрес(Знач Адрес) Экспорт

	Схема = "http";
	Остаток = СокрЛП(Адрес);
	// BSLLS:IfElseIfEndsWithElse-off хвостовой Иначе не нужен: без префикса схема остается http.
	Если СтрНачинаетсяС(НРег(Остаток), "https://") Тогда
		Схема = "https";
		Остаток = Сред(Остаток, СтрДлина("https://") + 1);
	ИначеЕсли СтрНачинаетсяС(НРег(Остаток), "http://") Тогда
		Остаток = Сред(Остаток, СтрДлина("http://") + 1);
	КонецЕсли;
	// BSLLS:IfElseIfEndsWithElse-on

	ПозицияСлеша = СтрНайти(Остаток, "/");
	Если ПозицияСлеша = 0 Тогда
		ХостПорт = Остаток;
		Ресурс = "/";
	Иначе
		ХостПорт = Лев(Остаток, ПозицияСлеша - 1);
		Ресурс = Сред(Остаток, ПозицияСлеша);
	КонецЕсли;

	Порт = ?(Схема = "https", 443, 80);
	ПозицияДвоеточия = СтрНайти(ХостПорт, ":");
	Если ПозицияДвоеточия > 0 Тогда
		ПортСтр = СокрЛП(Сред(ХостПорт, ПозицияДвоеточия + 1));
		Если ЗначениеЗаполнено(ПортСтр) Тогда
			Порт = Число(ПортСтр);
		КонецЕсли;
		ХостПорт = Лев(ХостПорт, ПозицияДвоеточия - 1);
	КонецЕсли;

	Возврат Новый Структура("СХостом, Хост, Порт, Ресурс",
		Схема + "://" + ХостПорт, ХостПорт, Порт, Ресурс);

КонецФункции

// Скачать файл по HTTP. При ошибке пустой файл удаляется.
//
// Параметры:
//   Адрес - Строка - полный URL
//   ПутьНазначения - Строка - куда записать файл
//   ТаймаутСек - Число - таймаут соединения
//   ФайловыеОперации - ФайловыеОперации - удаление пустого ответа
//
Процедура Скачать(Знач Адрес, Знач ПутьНазначения, Знач ТаймаутСек, Знач ФайловыеОперации) Экспорт

	Разбор = РазобратьАдрес(Адрес);
	Соединение = Новый HTTPСоединение(Разбор.СХостом, Разбор.Порт, , , , ТаймаутСек);
	Ответ = Соединение.Получить(Новый HTTPЗапрос(Разбор.Ресурс), ПутьНазначения);

	Если Ответ.КодСостояния < 200 ИЛИ Ответ.КодСостояния >= 300 Тогда
		ФайловыеОперации.УдалитьБезопасно(ПутьНазначения);
		ВызватьИсключение СтрШаблон("загрузка %1 вернула HTTP %2", Адрес, Ответ.КодСостояния);
	КонецЕсли;

	Файл = Новый Файл(ПутьНазначения);
	Если НЕ Файл.Существует() ИЛИ Файл.Размер() = 0 Тогда
		ВызватьИсключение СтрШаблон("загрузка %1 не создала файл (пустой ответ)", Адрес);
	КонецЕсли;

КонецПроцедуры

// Распаковать zip с восстановлением путей.
//
// Параметры:
//   ФайлАрхива - Строка - путь к zip
//   КаталогНазначения - Строка - каталог распаковки
//
Процедура Распаковать(Знач ФайлАрхива, Знач КаталогНазначения) Экспорт

	Чтение = Новый ЧтениеZipФайла(ФайлАрхива);
	Попытка
		Чтение.ИзвлечьВсе(КаталогНазначения, РежимВосстановленияПутейФайловZIP.Восстанавливать);
	Исключение
		Чтение.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	Чтение.Закрыть();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПравыйСимвол(Знач Текст)
	Возврат ?(ЗначениеЗаполнено(Текст), Прав(Текст, 1), "");
КонецФункции

#КонецОбласти
