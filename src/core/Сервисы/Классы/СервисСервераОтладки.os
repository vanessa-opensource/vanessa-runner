// BSLLS:MissingVariablesDescription-off Поля autumn (&Лог/&Желудь) и внутреннее состояние сервиса.
// BSLLS:LatinAndCyrillicSymbolInWord-off Технические идентификаторы (dbgs, DBGS, HTTP).
// BSLLS:Typo-off (&Лог/&Желудь) и доменные термины.
// BSLLS:MissingParameterDescription-off Внутренние вспомогательные функции.
// BSLLS:MissingReturnedValueDescription-off Внутренние вспомогательные функции.
// BSLLS:UsingHardcodeNetworkAddress-off Хост по умолчанию - локальный (127.0.0.1), настраивается опцией.
// BSLLS:NumberOfValuesInStructureConstructor-off
// Сервис управления сервером отладки 1С (dbgs) для сбора покрытия.
//
// Поднимает автономный сервер отладки платформы (dbgs) на заданном хосте/порту либо
// подключается к уже запущенному. К этому серверу подключаются: клиент 1С через
// /DEBUGGERURL и компонента coveragebsl (МенеджерПокрытия) для сбора замеров.
//
// dbgs запускается с --notify=<файл>: платформа пишет в него оповещение о старте,
// что используется как признак готовности сервера.
//
// Шов для юнит-тестов: _ФабрикаПроцесса.Запустить(СтрокаЗапуска, ПутьОповещения) -> ХендлПроцесса.

#Использовать v8find
#Использовать tempfiles

&Лог("vrunner")
Перем Лог;

// Опциональная фабрика процесса (для юнит-тестов). Если задана - должна реализовать
// Запустить(СтрокаЗапуска, ПутьОповещения) и вернуть объект с методом Завершить().
Перем _ФабрикаПроцесса;

Перем _Процесс;
Перем _Хост;
Перем _Порт;
Перем _Запущен;
Перем _ПодключенКЧужомуСерверу;
Перем _КаталогДанных;
Перем _ТаймаутГотовностиМс;
Перем _ШагГотовностиМс;

&Желудь
Процедура ПриСозданииОбъекта()
	_ФабрикаПроцесса = Неопределено;
	_Процесс = Неопределено;
	_Хост = ХостПоУмолчанию();
	_Порт = ПортПоУмолчанию();
	_Запущен = Ложь;
	_ПодключенКЧужомуСерверу = Ложь;
	_КаталогДанных = "";
	_ТаймаутГотовностиМс = 15000;
	_ШагГотовностиМс = 200;
КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Шаблон параметров запуска сервера отладки.
//
// Возвращаемое значение:
//   Структура - Хост, Порт (0 = по умолчанию), ПутьКDBGS (пусто = автоопределение),
//               ВерсияПлатформы, ПодключитьсяКСуществующему (Булево), Пароль
//
Функция НовыеПараметрыСервера() Экспорт
	Возврат Новый Структура(
		"Хост, Порт, ПутьКDBGS, ВерсияПлатформы, ПодключитьсяКСуществующему, Пароль",
		ХостПоУмолчанию(), 0, "", "", Ложь, "");
КонецФункции

// Запустить сервер отладки dbgs либо подключиться к уже запущенному.
//
// Параметры:
//   ПараметрыСервера - Структура, Неопределено - см. НовыеПараметрыСервера
//
// Возвращаемое значение:
//   Структура - Адрес (http-URL), Хост, Порт
//
Функция ЗапуститьСервер(Знач ПараметрыСервера = Неопределено) Экспорт

	Если _Запущен Тогда
		ВызватьИсключение "Сервер отладки уже запущен. Сначала вызовите ОстановитьСервер().";
	КонецЕсли;

	Если ПараметрыСервера = Неопределено Тогда
		ПараметрыСервера = НовыеПараметрыСервера();
	КонецЕсли;

	_Хост = ?(ЗначениеЗаполнено(ПараметрыСервера.Хост), ПараметрыСервера.Хост, ХостПоУмолчанию());
	ЗаданныйПорт = ?(ЗначениеЗаполнено(ПараметрыСервера.Порт) И Число(ПараметрыСервера.Порт) > 0,
		Число(ПараметрыСервера.Порт), 0);
	_Порт = ?(ЗаданныйПорт > 0, ЗаданныйПорт, ПортПоУмолчанию());

	Если ПараметрыСервера.ПодключитьсяКСуществующему = Истина Тогда
		_ПодключенКЧужомуСерверу = Истина;
		_Запущен = Истина;
		Лог.Информация("Подключение к серверу отладки %1", Адрес());
		Возврат Контекст();
	КонецЕсли;

	ПутьКDBGS = РазрешитьПутьКDBGS(ПараметрыСервера);
	_КаталогДанных = ВременныеФайлы.СоздатьКаталог();

	// Порт задан явно - стартуем строго на нем (занят => ошибка, без перебора).
	// Порт не задан - подбираем свободный (базовый + случайные сдвиги), как у ibsrv.
	Попытка
		Если ЗаданныйПорт > 0 Тогда
			ЗапуститьНаЗаданномПорту(ПутьКDBGS, ЗаданныйПорт, ПараметрыСервера.Пароль);
		Иначе
			ПодобратьПортИЗапустить(ПутьКDBGS, ПараметрыСервера.Пароль);
		КонецЕсли;
	Исключение
		Ошибка = ОписаниеОшибки();
		ОстановитьСервер();
		ВызватьИсключение Ошибка;
	КонецПопытки;

	_Запущен = Истина;
	Лог.Информация("Запущен сервер отладки %1", Адрес());

	Возврат Контекст();

КонецФункции

// Остановить сервер отладки и удалить временный каталог.
// В режиме подключения к чужому серверу процесс не останавливается.
//
Процедура ОстановитьСервер() Экспорт

	Если _ПодключенКЧужомуСерверу Тогда
		Лог.Отладка("Сервис подключался к чужому серверу отладки - процесс не останавливается");
		Сбросить();
		Возврат;
	КонецЕсли;

	Если _Процесс <> Неопределено Тогда
		Попытка
			_Процесс.Завершить();
			Лог.Информация("Процесс сервера отладки остановлен");
		Исключение
			Лог.Предупреждение("Не удалось остановить сервер отладки: %1", ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;

	Если ЗначениеЗаполнено(_КаталогДанных) Тогда
		Попытка
			ВременныеФайлы.УдалитьФайл(_КаталогДанных);
		Исключение
			Лог.Отладка("Не удалось удалить временный каталог сервера отладки: %1", ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;

	Сбросить();

КонецПроцедуры

// http-адрес сервера отладки.
//
// Возвращаемое значение:
//   Строка - http://<хост>:<порт>
//
Функция Адрес() Экспорт
	Возврат СтрШаблон("http://%1:%2", _Хост, XMLСтрока(_Порт));
КонецФункции

// Проверить, отвечает ли сервер отладки по http.
//
// Параметры:
//   ТаймаутСек - Число - таймаут проверки в секундах
//
// Возвращаемое значение:
//   Булево
//
Функция СерверЖив(Знач ТаймаутСек = 5) Экспорт
	Попытка
		Соединение = Новый HTTPСоединение(_Хост, _Порт, , , , ТаймаутСек);
		Соединение.Получить(Новый HTTPЗапрос("/"));
		Возврат Истина;
	Исключение
		Лог.Отладка("Сервер отладки не отвечает на %1 - %2", Адрес(), ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Установить таймаут ожидания готовности сервера (мс). 0 - не ждать (для юнит-тестов).
//
// Параметры:
//   Мс - Число
//
Процедура УстановитьТаймаутГотовности(Знач Мс) Экспорт
	_ТаймаутГотовностиМс = Мс;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РазрешитьПутьКDBGS(Знач ПараметрыСервера)

	Если ЗначениеЗаполнено(ПараметрыСервера.ПутьКDBGS) Тогда
		Путь = Новый Файл(ПараметрыСервера.ПутьКDBGS);
		Если НЕ Путь.Существует() Тогда
			ВызватьИсключение СтрШаблон("Файл сервера отладки dbgs не найден: %1", ПараметрыСервера.ПутьКDBGS);
		КонецЕсли;
		Возврат Путь.ПолноеИмя;
	КонецЕсли;

	Версия = ?(ЗначениеЗаполнено(ПараметрыСервера.ВерсияПлатформы), ПараметрыСервера.ВерсияПлатформы, "");
	Путь = Платформа1С.ПутьКDBGS(Версия);
	Если НЕ ЗначениеЗаполнено(Путь) ИЛИ НЕ Новый Файл(Путь).Существует() Тогда
		ВызватьИсключение "Не удалось определить путь к серверу отладки dbgs."
			+ " Укажите его явно через --coverage-dbgs.";
	КонецЕсли;
	Возврат Путь;

КонецФункции

Функция СформироватьСтрокуЗапуска(Знач ПутьКDBGS, Знач ФайлОповещения, Знач Пароль)

	Части = Новый Массив;
	Части.Добавить(ВКавычках(ПутьКDBGS));
	Части.Добавить(СтрШаблон("--addr=%1", _Хост));
	Части.Добавить(СтрШаблон("--port=%1", XMLСтрока(_Порт)));
	Части.Добавить(СтрШаблон("--notify=%1", ВКавычках(ФайлОповещения)));
	Если ЗначениеЗаполнено(Пароль) Тогда
		Части.Добавить(СтрШаблон("--password=%1", Пароль));
	КонецЕсли;

	Возврат СтрСоединить(Части, " ");

КонецФункции

Функция ЗапуститьПроцессDBGS(Знач СтрокаЗапуска, Знач ФайлОповещения)

	Если _ФабрикаПроцесса <> Неопределено Тогда
		Возврат _ФабрикаПроцесса.Запустить(СтрокаЗапуска, ФайлОповещения);
	КонецЕсли;

	Процесс = СоздатьПроцесс(СтрокаЗапуска);
	Процесс.Запустить();
	Возврат Процесс;

КонецФункции

// Стартовать dbgs строго на заданном порту. Занят/не готов => исключение (без перебора).
Процедура ЗапуститьНаЗаданномПорту(Знач ПутьКDBGS, Знач Порт, Знач Пароль)

	Результат = ПопытатьсяЗапуститьНаПорту(ПутьКDBGS, Порт, Пароль, _ТаймаутГотовностиМс);
	Если Результат = "готов" Тогда
		Возврат;
	КонецЕсли;

	Если Результат = "умер" Тогда
		ВызватьИсключение СтрШаблон(
			"Не удалось запустить сервер отладки: порт %1 занят. Укажите другой через --coverage-server.",
			XMLСтрока(Порт));
	КонецЕсли;

	ВызватьИсключение СтрШаблон(
		"Сервер отладки не готов за %1 мс (%2). Возможно, порт занят - укажите другой через --coverage-server.",
		_ТаймаутГотовностиМс, Адрес());

КонецПроцедуры

// Подобрать свободный порт и стартовать на нем: базовый порт, затем случайные сдвиги.
// Атомарно (без неатомарной предпроверки, как у ibsrv): реальный старт dbgs; если dbgs
// упал (порт занят) - сразу пробуем следующий; если не сигналит готовность за пробное
// окно - тоже следующий. Стартовый порт рандомизируется, снижая коллизии параллельных прогонов.
Процедура ПодобратьПортИЗапустить(Знач ПутьКDBGS, Знач Пароль)

	КоличествоПопыток = 8;
	ДиапазонСдвига = 500;
	ПробныйТаймаут = Мин(_ТаймаутГотовностиМс, ПробныйТаймаутМс());

	Генератор = Новый ГенераторСлучайныхЧисел(ТекущаяУниверсальнаяДатаВМиллисекундах());
	Порт = ПортПоУмолчанию(); // первая попытка - базовый порт
	Перебранные = Новый Массив;
	НомерПопытки = 0;

	Пока НомерПопытки < КоличествоПопыток Цикл

		Результат = ПопытатьсяЗапуститьНаПорту(ПутьКDBGS, Порт, Пароль, ПробныйТаймаут);
		Если Результат = "готов" Тогда
			Возврат;
		КонецЕсли;

		Лог.Отладка("Порт %1 недоступен для сервера отладки (%2), пробуем другой", XMLСтрока(Порт), Результат);
		Перебранные.Добавить(XMLСтрока(Порт));
		Порт = ПортПоУмолчанию() + Генератор.СлучайноеЧисло(1, ДиапазонСдвига);
		НомерПопытки = НомерПопытки + 1;

	КонецЦикла;

	ПереченьПортов = СтрСоединить(Перебранные, ", ");
	ВызватьИсключение СтрШаблон(
		"Не удалось запустить сервер отладки: перепробованы порты %1, все недоступны."
		+ " Укажите свободный порт через --coverage-server.",
		ПереченьПортов);

КонецПроцедуры

// Одна попытка старта dbgs на порту. Возвращает "готов" | "умер" (dbgs упал, порт занят)
// | "таймаут" (готовность не пришла за отведенное окно). При неуспехе гасит процесс.
Функция ПопытатьсяЗапуститьНаПорту(Знач ПутьКDBGS, Знач Порт, Знач Пароль, Знач ТаймаутМс)

	_Порт = Порт;
	ФайлОповещения = ОбъединитьПути(_КаталогДанных, СтрШаблон("dbgs_%1.notify", XMLСтрока(Порт)));

	СтрокаЗапуска = СформироватьСтрокуЗапуска(ПутьКDBGS, ФайлОповещения, Пароль);
	Лог.Отладка("Запуск сервера отладки: %1", СтрокаЗапуска);

	_Процесс = ЗапуститьПроцессDBGS(СтрокаЗапуска, ФайлОповещения);

	Результат = ОжидатьГотовностиСервера(ФайлОповещения, ТаймаутМс);
	Если Результат = "готов" Тогда
		Возврат "готов";
	КонецЕсли;

	ОстановитьТекущийПроцесс();
	Возврат Результат;

КонецФункции

// Ждать готовности dbgs (появление файла оповещения) в пределах таймаута.
// Возвращает "готов" при появлении файла, "умер" если процесс dbgs завершился раньше
// (типично для занятого порта), "таймаут" если файл так и не появился, а процесс жив.
Функция ОжидатьГотовностиСервера(Знач ФайлОповещения, Знач ТаймаутМс)

	Прошло = 0;
	Пока Прошло < ТаймаутМс Цикл
		Если Новый Файл(ФайлОповещения).Существует() Тогда
			Возврат "готов";
		КонецЕсли;
		Если НЕ ПроцессЖив() Тогда
			Возврат "умер";
		КонецЕсли;
		Приостановить(_ШагГотовностиМс);
		Прошло = Прошло + _ШагГотовностиМс;
	КонецЦикла;

	Если Новый Файл(ФайлОповещения).Существует() Тогда
		Возврат "готов";
	КонецЕсли;
	Возврат ?(ПроцессЖив(), "таймаут", "умер");

КонецФункции

// Жив ли текущий процесс dbgs. Duck-typed .Завершен (реальный Процесс и стаб). Если объект
// не умеет отвечать (частичный мок) - считаем живым, чтобы не обрывать ожидание готовности.
Функция ПроцессЖив()
	Если _Процесс = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		Возврат НЕ _Процесс.Завершен;
	Исключение
		Возврат Истина;
	КонецПопытки;
КонецФункции

// Погасить текущий (не поднявшийся) процесс dbgs перед следующей попыткой.
Процедура ОстановитьТекущийПроцесс()
	Если _Процесс <> Неопределено Тогда
		Попытка
			_Процесс.Завершить();
		Исключение
			Лог.Отладка("Не удалось остановить неподнявшийся сервер отладки: %1", ОписаниеОшибки());
		КонецПопытки;
		_Процесс = Неопределено;
	КонецЕсли;
КонецПроцедуры

Функция ПробныйТаймаутМс()
	Возврат 5000; // BSLLS:MagicNumber-off (пробное окно готовности на кандидат-порт при переборе)
КонецФункции

Функция Контекст()
	Возврат Новый Структура("Адрес, Хост, Порт", Адрес(), _Хост, _Порт);
КонецФункции

Процедура Сбросить()
	_Процесс = Неопределено;
	_КаталогДанных = "";
	_Запущен = Ложь;
	_ПодключенКЧужомуСерверу = Ложь;
КонецПроцедуры

Функция ВКавычках(Знач Значение)
	Возврат """" + Значение + """";
КонецФункции

Функция ХостПоУмолчанию()
	Возврат "127.0.0.1";
КонецФункции

Функция ПортПоУмолчанию()
	Возврат 1550; // BSLLS:MagicNumber-off
КонецФункции

#КонецОбласти
