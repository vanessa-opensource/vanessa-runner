// BSLLS:MissingVariablesDescription-off Поля autumn
// BSLLS:UnusedLocalMethod-off ПриСозданииОбъекта вызывается рантаймом при Новый.
// Сервис временной информационной базы.
// Единая точка выбора движка платформы (конфигуратор или ibcmd) и жизненного цикла
// временной ИБ для операций, которым нужна база, но она не передана вызывающим кодом:
// Подготовить (переданная или новая временная) → работа движком → Очистить.

&Лог("vrunner")
Перем Лог;

&Пластилин(Значение = "ДвижокПлатформы", Тип = "Соответствие")
Перем Движки;

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Движок платформы по флагу использования ibcmd.
//
// Параметры:
//   ИспользоватьIbcmd - Булево, Неопределено - Истина: ibcmd, иначе конфигуратор
//
// Возвращаемое значение:
//   ДвижокКонфигуратор, ДвижокIbcmd - выбранный движок
//
Функция ВыбратьДвижок(Знач ИспользоватьIbcmd) Экспорт

	Если ЗначениеЗаполнено(ИспользоватьIbcmd) И Булево(ИспользоватьIbcmd) Тогда
		Возврат ДвижокIbcmd();
	КонецЕсли;

	Возврат ДвижокКонфигуратор();

КонецФункции

// Движок конфигуратора - для операций, которые ibcmd не поддерживает.
//
// Возвращаемое значение:
//   ДвижокКонфигуратор - движок конфигуратора
//
Функция ДвижокКонфигуратор() Экспорт

	Возврат Движки["ДвижокКонфигуратор"];

КонецФункции

// Движок ibcmd - для операций, доступных только через ibcmd.
//
// Возвращаемое значение:
//   ДвижокIbcmd - движок ibcmd
//
Функция ДвижокIbcmd() Экспорт

	Возврат Движки["ДвижокIbcmd"];

КонецФункции

// Подготовить базу для операции: вернуть переданную либо создать временную выбранным движком.
//
// Параметры:
//   Движок               - ДвижокКонфигуратор, ДвижокIbcmd - движок, создающий временную ИБ
//   ПараметрыПодключения - Структура, Неопределено - параметры подключения; пустая строка
//                          подключения означает, что базу нужно создать
//   ПараметрыПлатформы   - Структура, Неопределено - параметры версии платформы
//
// Возвращаемое значение:
//   Структура - контекст базы для Очистить:
//     * ПараметрыПодключения - Структура - параметры подключения к рабочей базе
//     * Временная - Булево - Истина, если база создана и подлежит удалению
//
Функция Подготовить(Знач Движок, Знач ПараметрыПодключения, Знач ПараметрыПлатформы) Экспорт

	Результат = Новый Структура("ПараметрыПодключения, Временная", ПараметрыПодключения, Ложь);

	Если ПараметрыПодключения <> Неопределено
		И ЗначениеЗаполнено(ПараметрыПодключения.СтрокаПодключения) Тогда
		Возврат Результат;
	КонецЕсли;

	Лог.Информация("Создаётся временная информационная база…");
	Результат.ПараметрыПодключения = Движок.СоздатьВременнуюБазу(ПараметрыПлатформы);
	Результат.Временная = Истина;
	Лог.Отладка("Создана временная ИБ: %1", Результат.ПараметрыПодключения.КаталогБазы);

	Возврат Результат;

КонецФункции

// Удалить временную базу, если она была создана в Подготовить. Ошибка удаления не прерывает работу.
//
// Параметры:
//   КонтекстБазы - Структура - результат Подготовить
//
Процедура Очистить(Знач КонтекстБазы) Экспорт

	Если НЕ КонтекстБазы.Временная Тогда
		Возврат;
	КонецЕсли;

	Лог.Отладка("Удаление временной ИБ: %1", КонтекстБазы.ПараметрыПодключения.КаталогБазы);
	Попытка
		УдалитьФайлы(КонтекстБазы.ПараметрыПодключения.КаталогБазы);
	Исключение
		Лог.Предупреждение("Не удалось удалить временную ИБ: %1", ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

#КонецОбласти
