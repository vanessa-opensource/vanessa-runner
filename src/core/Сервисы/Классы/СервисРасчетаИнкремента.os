// BSLLS:MissingVariablesDescription-off Поля autumn (&Лог/&Пластилин) и внутреннее состояние сервиса.
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off Внутренние служебные методы.
// BSLLS:MissingReturnedValueDescription-off Внутренние служебные методы.
// BSLLS:MagicNumber-off
// BSLLS:NumberOfValuesInStructureConstructor-off
// BSLLS:LatinAndCyrillicSymbolInWord-off Аббревиатуры EDT/XML/ConfigDumpInfo в именах - устоявшиеся термины.
// Сервис расчёта инкремента для выборочной загрузки конфигурации/расширения из исходников.
// Изменения детектируются по индексу файлов (change-indexer) в каталоге кеша и, при наличии,
// сверяются с изменениями по ConfigDumpInfo от платформы; результат - файл-список для
// выборочной загрузки либо признаки «полная загрузка»/«загрузка пропущена».

#Использовать change-indexer

&Лог("vrunner")
Перем Лог;

&Пластилин
Перем ФайловыеОперации;

&Пластилин("СервисПлатформы")
Перем СервисПлатформы;

Перем _КаталогКеша;

&Желудь
Процедура ПриСозданииОбъекта(&Деталька(Значение = "increment.cache-dir", ЗначениеПоУмолчанию = "") КаталогКеша)
	// Каталог создаётся по требованию в ПодготовитьИнкремент: желуди внедряются уже после конструктора.
	_КаталогКеша = ?(ЗначениеЗаполнено(КаталогКеша), КаталогКеша, КаталогКешаПоУмолчанию());
КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Подготовить контекст инкремента: обновить индекс файлов каталога исходников в кеше.
// Ключ кеша строится по каталогу, параметрам подключения и имени расширения, поэтому конфигурация
// и расширения одной базы ведут раздельные индексы.
//
// Параметры:
//   КаталогИсходников    - Строка    - индексируемый каталог исходников
//   ПараметрыПодключения - Структура - параметры подключения к базе (для ключа кеша)
//   МассивИсключений     - Массив    - маски файлов/каталогов, исключаемых из индекса
//   ИмяРасширения        - Строка    - имя расширения (пусто для конфигурации)
//
// Возвращаемое значение:
//   Структура - {ЕстьБазовыйИндекс, Результат, ПутьКешаConfigDumpInfo, ПутьТекущегоConfigDumpInfo}
//
Функция ПодготовитьИнкремент(Знач КаталогИсходников, Знач ПараметрыПодключения,
		Знач МассивИсключений = Неопределено, Знач ИмяРасширения = "") Экспорт

	ДатаНачалаПодготовки = ТекущаяУниверсальнаяДата();
	НормКаталог = Новый Файл(КаталогИсходников).ПолноеИмя;
	Ключ = ПостроитьКлюч(НормКаталог, ПараметрыПодключения, ИмяРасширения);

	КаталогКлюча = ОбъединитьПути(_КаталогКеша, Ключ);
	ФайловыеОперации.ОбеспечитьКаталог(КаталогКлюча);
	Лог.Отладка("Инкрементальная загрузка: каталог кеша: %1", КаталогКлюча);

	ПутьИндекса = ОбъединитьПути(КаталогКлюча, "index.cidx");
	ПутьКешаConfigDumpInfo = ОбъединитьПути(КаталогКлюча, "configdumpinfo.xml");
	ПутьТекущегоConfigDumpInfo = ОбъединитьПути(НормКаталог, "ConfigDumpInfo.xml");

	Менеджер = Новый МенеджерИндексов(НормКаталог, ПутьИндекса);
	Если МассивИсключений <> Неопределено Тогда
		Для Каждого Маска Из МассивИсключений Цикл
			Менеджер.ДобавитьИсключение(Маска);
		КонецЦикла;
	КонецЕсли;
	ЕстьБазовыйИндекс = Менеджер.СуществуетИндекс();

	ДатаНачалаОбновления = ТекущаяУниверсальнаяДата();
	Результат = Менеджер.ОбновитьИндекс();
	Лог.Отладка(
		"Инкрементальная загрузка: индекс обновлён за %1 мс, файлов=%2, добавлено=%3, изменено=%4, удалено=%5",
		ДлительностьМс(ДатаНачалаОбновления),
		Менеджер.КоличествоФайлов(),
		Результат.Добавленные().Количество(),
		Результат.Измененные().Количество(),
		Результат.Удаленные().Количество());

	Если НЕ ЕстьБазовыйИндекс Тогда
		Лог.Отладка("Инкрементальная загрузка: базовый индекс отсутствует, создан новый");
	КонецЕсли;

	Лог.Отладка("Инкрементальная загрузка: подготовка контекста завершена за %1 мс",
		ДлительностьМс(ДатаНачалаПодготовки));

	Возврат Новый Структура(
		"ЕстьБазовыйИндекс, Результат, ПутьКешаConfigDumpInfo, ПутьТекущегоConfigDumpInfo",
		ЕстьБазовыйИндекс,
		Результат,
		ПутьКешаConfigDumpInfo,
		ПутьТекущегоConfigDumpInfo);

КонецФункции

Процедура ЗафиксироватьИнкремент(КонтекстИнкремента) Экспорт

	ФайлConfigDumpInfo = Новый Файл(КонтекстИнкремента.ПутьТекущегоConfigDumpInfo);
	Если ФайлConfigDumpInfo.Существует() Тогда
		ДатаНачала = ТекущаяУниверсальнаяДата();
		КопироватьФайл(КонтекстИнкремента.ПутьТекущегоConfigDumpInfo, КонтекстИнкремента.ПутьКешаConfigDumpInfo);
		Лог.Отладка("Инкрементальная загрузка: ConfigDumpInfo скопирован в кеш за %1 мс", ДлительностьМс(ДатаНачала));
	КонецЕсли;

КонецПроцедуры

Процедура ПересоздатьИндекс(Знач КаталогИсходников, Знач ПараметрыПодключения) Экспорт
	КонтекстИнкремента = ПодготовитьИнкремент(КаталогИсходников, ПараметрыПодключения);
	ЗафиксироватьИнкремент(КонтекстИнкремента);
	Лог.Информация("Инкрементальная загрузка: индекс перестроен после полной загрузки");
КонецПроцедуры

Функция РассчитатьИнкрементДляЗагрузкиКонфигурации(Знач КаталогИсходников, Знач ПараметрыПодключения,
		Знач ИспользоватьIbcmd = Ложь, Знач ПараметрыПлатформы = Неопределено,
		Знач ИсходныйСписокФайлов = "") Экспорт

	КонтекстИнкремента = ПодготовитьИнкремент(КаталогИсходников, ПараметрыПодключения);
	ИзмененияИзКонфигуратора = ЗапроситьИзмененияИзКонфигуратора(
		КонтекстИнкремента, КаталогИсходников, ПараметрыПодключения, ИспользоватьIbcmd, ПараметрыПлатформы, "");

	РезультатИнкремента = РассчитатьИнкрементКонфигурации(
		КаталогИсходников,
		КонтекстИнкремента,
		ИзмененияИзКонфигуратора,
		ИсходныйСписокФайлов);

	Возврат РезультатСКонтекстом(КонтекстИнкремента, РезультатИнкремента);

КонецФункции

Функция РассчитатьИнкрементДляЗагрузкиРасширения(Знач КаталогИсходников, Знач ПараметрыПодключения,
		Знач ИмяРасширения, Знач ИспользоватьIbcmd = Ложь, Знач ПараметрыПлатформы = Неопределено) Экспорт

	КонтекстИнкремента = ПодготовитьИнкремент(КаталогИсходников, ПараметрыПодключения, Неопределено, ИмяРасширения);
	ИзмененияИзКонфигуратора = ЗапроситьИзмененияИзКонфигуратора(
		КонтекстИнкремента, КаталогИсходников, ПараметрыПодключения, ИспользоватьIbcmd, ПараметрыПлатформы,
		ИмяРасширения);

	РезультатИнкремента = РассчитатьИнкрементРасширения(
		КаталогИсходников,
		КонтекстИнкремента,
		ИзмененияИзКонфигуратора);

	Возврат РезультатСКонтекстом(КонтекстИнкремента, РезультатИнкремента);

КонецФункции

// Рассчитать инкремент для загрузки конфигурации из EDT-исходников.
// Платформа не читает EDT, поэтому изменения детектируются по СТАБИЛЬНОМУ каталогу EDT-исходников
// (а не по временному XML-дампу, который пересоздаётся при каждом экспорте с новым mtime), а список
// файлов для выборочной загрузки собирается из уже выгруженного полного XML-дампа по изменённым объектам.
//
// Политика v1: выборочная загрузка применяется только при модификациях существующих объектов.
// Добавление/удаление объектов и любые изменения корня Configuration требуют полной загрузки.
//
// Параметры:
//   КаталогEDTИсходников - Строка    - корневой каталог EDT-проекта (стабильный, индексируется)
//   КаталогXML           - Строка    - каталог полного XML-дампа (результат экспорта EDT → XML)
//   ПараметрыПодключения - Структура - параметры подключения к базе (для ключа кеша)
//
// Возвращаемое значение:
//   Структура - {КонтекстИнкремента, СписокФайловДляЗагрузки, ПропуститьЗагрузку}
//
Функция РассчитатьИнкрементEDTДляЗагрузкиКонфигурации(Знач КаталогEDTИсходников, Знач КаталогXML,
		Знач ПараметрыПодключения) Экспорт

	Возврат РассчитатьИнкрементEDT(КаталогEDTИсходников, КаталогXML, ПараметрыПодключения, "", "конфигурации");

КонецФункции

// Рассчитать инкремент для загрузки расширения из EDT-исходников.
// Механика и политика v1 те же, что для конфигурации (см. РассчитатьИнкрементEDTДляЗагрузкиКонфигурации):
// EDT-проект расширения имеет ту же раскладку src/<Вид>/<Имя>, а его XML-дамп - ту же структуру файлов.
// Имя расширения входит в ключ кеша, поэтому индекс расширения не пересекается с индексом конфигурации.
//
// Параметры:
//   КаталогEDTИсходников - Строка    - корневой каталог EDT-проекта расширения (стабильный, индексируется)
//   КаталогXML           - Строка    - каталог полного XML-дампа расширения (результат экспорта EDT → XML)
//   ПараметрыПодключения - Структура - параметры подключения к базе (для ключа кеша)
//   ИмяРасширения        - Строка    - имя расширения в базе (для ключа кеша и логов)
//
// Возвращаемое значение:
//   Структура - {КонтекстИнкремента, СписокФайловДляЗагрузки, ПропуститьЗагрузку}
//
Функция РассчитатьИнкрементEDTДляЗагрузкиРасширения(Знач КаталогEDTИсходников, Знач КаталогXML,
		Знач ПараметрыПодключения, Знач ИмяРасширения) Экспорт

	Возврат РассчитатьИнкрементEDT(
		КаталогEDTИсходников, КаталогXML, ПараметрыПодключения, ИмяРасширения, "расширения");

КонецФункции

Функция РассчитатьИнкрементКонфигурации(Знач КаталогИсходников, Знач КонтекстИнкремента,
		Знач ИзмененияИзКонфигуратора = Неопределено, Знач ИсходныйСписокФайлов = "") Экспорт

	Возврат РассчитатьИнкремент(
		КаталогИсходников, КонтекстИнкремента, ИзмененияИзКонфигуратора, ИсходныйСписокФайлов, "конфигурации");

КонецФункции

Функция РассчитатьИнкрементРасширения(Знач КаталогИсходников, Знач КонтекстИнкремента,
		Знач ИзмененияИзКонфигуратора = Неопределено) Экспорт

	Возврат РассчитатьИнкремент(КаталогИсходников, КонтекстИнкремента, ИзмененияИзКонфигуратора, "", "расширении");

КонецФункции

Функция ПредставитьФайлыДляЛога(Знач Файлы) Экспорт

	Если Файлы.Количество() = 0 Тогда
		Возврат "(пусто)";
	КонецЕсли;

	МаксимумФайлов = 20;
	Представление = Новый Массив;
	Индекс = 0;

	Для Каждого Файл Из Файлы Цикл
		Если Индекс < МаксимумФайлов Тогда
			Представление.Добавить(Файл);
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;

	Результат = СтрСоединить(Представление, ", ");
	Если Файлы.Количество() > МаксимумФайлов Тогда
		Результат = Результат + СтрШаблон(" ... (+%1)", Файлы.Количество() - МаксимумФайлов);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ТребуетсяПолнаяЗагрузкаИзЗаУдалений(Знач РезультатСравнения) Экспорт
	Возврат РезультатСравнения.Удаленные().Количество() > 0;
КонецФункции

Функция ЕстьЗначимыеИзмененияДляЗагрузки(Знач РезультатСравнения) Экспорт

	Для Каждого Путь Из РезультатСравнения.Добавленные() Цикл
		Если НЕ ЭтоConfigDumpInfo(Путь) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Для Каждого Путь Из РезультатСравнения.Измененные() Цикл
		Если НЕ ЭтоConfigDumpInfo(Путь) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция СписокФайловПуст(Знач ПутьКСпискуФайлов) Экспорт
	Возврат ПрочитатьФайлСписка(ПутьКСпискуФайлов).Количество() = 0;
КонецФункции

Процедура ДобавитьИзмененныеФайлы(Знач РезультатСравнения, Знач ИзмененныеФайлы) Экспорт

	Если ИзмененныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	УжеЕсть = Новый Соответствие;

	Для Каждого Путь Из РезультатСравнения.Добавленные() Цикл
		УжеЕсть.Вставить(НРег(Путь), Истина);
	КонецЦикла;

	Для Каждого Путь Из РезультатСравнения.Измененные() Цикл
		УжеЕсть.Вставить(НРег(Путь), Истина);
	КонецЦикла;

	Для Каждого Путь Из ИзмененныеФайлы Цикл
		Если НЕ ЗначениеЗаполнено(Путь) Тогда
			Продолжить;
		КонецЕсли;

		НормПуть = СтрЗаменить(Путь, "\\", "/");
		КлючПути = НРег(НормПуть);

		Если УжеЕсть[КлючПути] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		РезультатСравнения.ДобавитьИзмененный(НормПуть);
		УжеЕсть.Вставить(КлючПути, Истина);
	КонецЦикла;

КонецПроцедуры

Функция ИзменилсяConfigDumpInfo(КонтекстИнкремента) Экспорт

	ФайлКеша = Новый Файл(КонтекстИнкремента.ПутьКешаConfigDumpInfo);
	ФайлТекущий = Новый Файл(КонтекстИнкремента.ПутьТекущегоConfigDumpInfo);

	Если НЕ ФайлКеша.Существует() ИЛИ НЕ ФайлТекущий.Существует() Тогда
		Возврат Ложь;
	КонецЕсли;

	ТекстКеша = ПрочитатьФайл(КонтекстИнкремента.ПутьКешаConfigDumpInfo);
	ТекстТекущий = ПрочитатьФайл(КонтекстИнкремента.ПутьТекущегоConfigDumpInfo);

	Возврат ТекстКеша <> ТекстТекущий;

КонецФункции

// Относительный путь внутри каталога src EDT-проекта (или "" если файл вне src).
// Разделители нормализуются к "/".
//
// Параметры:
//   ОтносительныйПуть - Строка - путь относительно корня EDT-проекта
//
// Возвращаемое значение:
//   Строка - путь относительно src (или "", если файл вне src)
Функция ПутьВнутриSrcEDT(Знач ОтносительныйПуть) Экспорт

	Норм = СтрЗаменить(ОтносительныйПуть, "\", "/");
	Если СтрНачинаетсяС(Норм, "src/") Тогда
		Возврат Сред(Норм, СтрДлина("src/") + 1);
	КонецЕсли;
	Возврат "";

КонецФункции

// Ключ объекта конфигурации по относительному пути внутри src (<Вид>/<Имя>).
// Для корня конфигурации возвращает "Configuration".
//
// Параметры:
//   ПутьВнутриSrc - Строка - путь относительно каталога src
//
// Возвращаемое значение:
//   Строка - ключ объекта "<Вид>/<Имя>" ("Configuration" для корня, "" если путь пуст)
Функция КлючОбъектаEDT(Знач ПутьВнутриSrc) Экспорт

	Если НЕ ЗначениеЗаполнено(ПутьВнутриSrc) Тогда
		Возврат "";
	КонецЕсли;

	Части = СтрРазделить(ПутьВнутриSrc, "/", Ложь);
	Если Части.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Если Части[0] = "Configuration" Тогда
		Возврат "Configuration";
	КонецЕсли;

	Если Части.Количество() = 1 Тогда
		Возврат Части[0];
	КонецЕсли;

	Возврат Части[0] + "/" + Части[1];

КонецФункции

// Собрать относительные пути XML-файлов изменённых объектов в выгруженном дампе.
// Для объекта <Вид>/<Имя> берётся файл <Вид>/<Имя>.xml и весь подкаталог <Вид>/<Имя>/.
//
// Параметры:
//   КаталогXML   - Строка - каталог полного XML-дампа конфигурации
//   ОбъектыКлючи - Массив - ключи объектов "<Вид>/<Имя>" (Строка)
//
// Возвращаемое значение:
//   Массив - относительные пути XML-файлов (Строка)
Функция СобратьXMLФайлыОбъектов(Знач КаталогXML, Знач ОбъектыКлючи) Экспорт

	КореньXML = Новый Файл(КаталогXML).ПолноеИмя;
	Разделитель = ПолучитьРазделительПути();
	Файлы = Новый Массив;

	Для Каждого Ключ Из ОбъектыКлючи Цикл
		ЧастиКлюча = СтрРазделить(Ключ, "/", Ложь);
		ОтносительныйБаз = СтрСоединить(ЧастиКлюча, Разделитель);

		ОсновнойФайлОтносительный = ОтносительныйБаз + ".xml";
		Если Новый Файл(ОбъединитьПути(КаталогXML, ОсновнойФайлОтносительный)).Существует() Тогда
			Файлы.Добавить(ОсновнойФайлОтносительный);
		КонецЕсли;

		ПодКаталог = ОбъединитьПути(КаталогXML, ОтносительныйБаз);
		Если Новый Файл(ПодКаталог).Существует() Тогда
			Для Каждого Элемент Из НайтиФайлы(ПодКаталог, "*", Истина) Цикл
				Если Элемент.ЭтоФайл() Тогда
					Файлы.Добавить(Сред(Элемент.ПолноеИмя, СтрДлина(КореньXML) + 2));
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

	Возврат Файлы;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Изменения по ConfigDumpInfo от платформы (сверка с кешем); Неопределено, если базового индекса ещё нет.
Функция ЗапроситьИзмененияИзКонфигуратора(Знач КонтекстИнкремента, Знач КаталогИсходников, Знач ПараметрыПодключения,
		Знач ИспользоватьIbcmd, Знач ПараметрыПлатформы, Знач ИмяРасширения)

	Если НЕ КонтекстИнкремента.ЕстьБазовыйИндекс Тогда
		Возврат Неопределено;
	КонецЕсли;

	Лог.Отладка("Инкрементальная загрузка: кеш ConfigDumpInfo: %1", КонтекстИнкремента.ПутьКешаConfigDumpInfo);
	Возврат СервисПлатформы.ПолучитьИзмененияКонфигурации(
		ПараметрыПодключения,
		КаталогИсходников,
		ИспользоватьIbcmd,
		ПараметрыПлатформы,
		КонтекстИнкремента.ПутьКешаConfigDumpInfo,
		ИмяРасширения);

КонецФункции

// Общий EDT-расчёт инкремента для конфигурации и расширения.
// ОписаниеОбъекта ("конфигурации"/"расширения") подставляется в сообщение о полной загрузке из-за корня.
Функция РассчитатьИнкрементEDT(Знач КаталогEDTИсходников, Знач КаталогXML, Знач ПараметрыПодключения,
		Знач ИмяРасширения, Знач ОписаниеОбъекта)

	КонтекстИнкремента = ПодготовитьИнкремент(
		КаталогEDTИсходников, ПараметрыПодключения, ИсключенияEDT(), ИмяРасширения);
	Префикс = ПрефиксЛогаEDT(ИмяРасширения);

	Результат = Новый Структура(
		"КонтекстИнкремента, СписокФайловДляЗагрузки, ПропуститьЗагрузку",
		КонтекстИнкремента, "", Ложь);

	Если НЕ КонтекстИнкремента.ЕстьБазовыйИндекс Тогда
		Лог.Информация("%1: индекс не найден, будет выполнена полная загрузка", Префикс);
		Возврат Результат;
	КонецЕсли;

	РезультатСравнения = КонтекстИнкремента.Результат;

	Если ТребуетсяПолнаяЗагрузкаEDT(РезультатСравнения) Тогда
		Лог.Информация("%1: добавление/удаление объектов или изменение корня %2, будет выполнена полная загрузка",
			Префикс, ОписаниеОбъекта);
		Возврат Результат;
	КонецЕсли;

	ИзмененныеОбъекты = ИзмененныеОбъектыEDT(РезультатСравнения);
	Если ИзмененныеОбъекты.Количество() = 0 Тогда
		Лог.Информация("%1: изменений в исходниках не найдено, загрузка пропущена", Префикс);
		ЗафиксироватьИнкремент(КонтекстИнкремента);
		Результат.ПропуститьЗагрузку = Истина;
		Возврат Результат;
	КонецЕсли;

	Лог.Отладка("%1: изменённые объекты=%2: %3",
		Префикс, ИзмененныеОбъекты.Количество(), СтрСоединить(ИзмененныеОбъекты, ", "));

	XMLФайлы = СобратьXMLФайлыОбъектов(КаталогXML, ИзмененныеОбъекты);
	Если XMLФайлы.Количество() = 0 Тогда
		Лог.Информация("%1: не найдены XML-файлы изменённых объектов, будет выполнена полная загрузка", Префикс);
		Возврат Результат;
	КонецЕсли;

	Результат.СписокФайловДляЗагрузки = ЗаписатьФайлСписка(XMLФайлы);
	ЗаписатьВЛогСписокФайловЗагрузки(XMLФайлы);

	Возврат Результат;

КонецФункции

// Префикс сообщений EDT-инкремента; для расширения дополняется его именем.
Функция ПрефиксЛогаEDT(Знач ИмяРасширения)

	Если ЗначениеЗаполнено(ИмяРасширения) Тогда
		Возврат СтрШаблон("Инкрементальная загрузка (EDT) расширения '%1'", ИмяРасширения);
	КонецЕсли;

	Возврат "Инкрементальная загрузка (EDT)";

КонецФункции

Функция РезультатСКонтекстом(Знач КонтекстИнкремента, Знач РезультатИнкремента)

	Возврат Новый Структура(
		"КонтекстИнкремента, СписокФайловДляЗагрузки, ПропуститьЗагрузку",
		КонтекстИнкремента,
		РезультатИнкремента.СписокФайловДляЗагрузки,
		РезультатИнкремента.ПропуститьЗагрузку);

КонецФункции

// Общий расчёт инкремента по индексу и изменениям из конфигуратора для конфигурации и расширения.
// ОписаниеОбъекта ("конфигурации"/"расширении") подставляется в сообщение о полной загрузке.
Функция РассчитатьИнкремент(Знач КаталогИсходников, Знач КонтекстИнкремента, Знач ИзмененияИзКонфигуратора,
		Знач ИсходныйСписокФайлов, Знач ОписаниеОбъекта)

	Результат = Новый Структура("СписокФайловДляЗагрузки, ПропуститьЗагрузку", ИсходныйСписокФайлов, Ложь);

	Если КонтекстИнкремента = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	РезультатСравнения = КонтекстИнкремента.Результат;
	ТребуетсяПолнаяЗагрузкаИзКонфигуратора = Ложь;
	Если ИзмененияИзКонфигуратора <> Неопределено Тогда
		ТребуетсяПолнаяЗагрузкаИзКонфигуратора = ИзмененияИзКонфигуратора.ТребуетсяПолнаяЗагрузка;
		Лог.Отладка("Инкрементальная загрузка: по ConfigDumpInfo изменено файлов=%1, полная загрузка=%2: %3",
			ИзмененияИзКонфигуратора.ИзмененныеФайлы.Количество(),
			ТребуетсяПолнаяЗагрузкаИзКонфигуратора,
			ПредставитьФайлыДляЛога(ИзмененияИзКонфигуратора.ИзмененныеФайлы));
		ДобавитьИзмененныеФайлы(РезультатСравнения, ИзмененияИзКонфигуратора.ИзмененныеФайлы);
	КонецЕсли;

	Если НЕ КонтекстИнкремента.ЕстьБазовыйИндекс Тогда
		Лог.Информация("Инкрементальная загрузка: индекс не найден, будет выполнена полная загрузка");
		Возврат Результат;
	КонецЕсли;

	Если ТребуетсяПолнаяЗагрузкаИзКонфигуратора Тогда
		Лог.Информация("Инкрементальная загрузка: изменения в %1 требуют полной загрузки", ОписаниеОбъекта);
		Возврат Результат;
	КонецЕсли;

	Если ТребуетсяПолнаяЗагрузкаИзЗаУдалений(РезультатСравнения) Тогда
		Лог.Информация("Инкрементальная загрузка: обнаружены удаленные файлы, будет выполнена полная загрузка");
		Возврат Результат;
	КонецЕсли;

	ФайлыДляЗагрузки = Новый Массив;
	Если ЕстьЗначимыеИзмененияДляЗагрузки(РезультатСравнения) Тогда
		ДатаНачала = ТекущаяУниверсальнаяДата();
		ФайлыДляЗагрузки = ФайлыДляВыборочнойЗагрузки(КаталогИсходников, РезультатСравнения);
		Лог.Отладка("Инкрементальная загрузка: список файлов для загрузки построен за %1 мс, файлов=%2: %3",
			ДлительностьМс(ДатаНачала), ФайлыДляЗагрузки.Количество(), ПредставитьФайлыДляЛога(ФайлыДляЗагрузки));
	КонецЕсли;

	Если ФайлыДляЗагрузки.Количество() = 0 Тогда
		Лог.Информация("Инкрементальная загрузка: изменений не найдено, загрузка пропущена");
		ЗафиксироватьИнкремент(КонтекстИнкремента);
		Результат.ПропуститьЗагрузку = Истина;
		Возврат Результат;
	КонецЕсли;

	Результат.СписокФайловДляЗагрузки = ЗаписатьФайлСписка(ФайлыДляЗагрузки);
	ЗаписатьВЛогСписокФайловЗагрузки(ФайлыДляЗагрузки);

	Возврат Результат;

КонецФункции

// Уникальные относительные пути добавленных и изменённых файлов, существующих на диске
// (без ConfigDumpInfo.xml), - кандидаты на выборочную загрузку.
Функция ФайлыДляВыборочнойЗагрузки(Знач КаталогИсходников, Знач РезультатСравнения)

	УникальныеФайлы = Новый Соответствие;
	ДобавитьФайлыДляЗагрузки(УникальныеФайлы, КаталогИсходников, РезультатСравнения.Добавленные());
	ДобавитьФайлыДляЗагрузки(УникальныеФайлы, КаталогИсходников, РезультатСравнения.Измененные());

	ФайлыДляЗагрузки = Новый Массив;
	Для Каждого КлючИЗначение Из УникальныеФайлы Цикл
		ФайлыДляЗагрузки.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;

	Возврат ФайлыДляЗагрузки;

КонецФункции

Процедура ДобавитьФайлыДляЗагрузки(Знач УникальныеФайлы, Знач КаталогИсходников, Знач Кандидаты)

	Для Каждого ОтносительныйПуть Из Кандидаты Цикл
		Если ЭтоConfigDumpInfo(ОтносительныйПуть) Тогда
			Продолжить;
		КонецЕсли;
		Если Новый Файл(ОбъединитьПути(КаталогИсходников, ОтносительныйПуть)).Существует() Тогда
			УникальныеФайлы.Вставить(ОтносительныйПуть, Истина);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ЭтоConfigDumpInfo(Знач Путь)
	Возврат НРег(Новый Файл(Путь).Имя) = "configdumpinfo.xml";
КонецФункции

Процедура ЗаписатьВЛогСписокФайловЗагрузки(Знач Файлы)

	Если Файлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Лог.Информация("Инкрементальная загрузка: будет загружено %1 файл(ов):", Файлы.Количество());
	Для Каждого Файл Из Файлы Цикл
		Лог.Информация("  - %1", Файл);
	КонецЦикла;

КонецПроцедуры

// Записать относительные пути в текстовый файл-список (UTF-8) для выборочной загрузки; вернуть его путь.
Функция ЗаписатьФайлСписка(Знач Файлы)

	// BSLLS:MissingTemporaryFileDeletion-off контракт функции; очистка выше по пайплайну
	ПутьКСпискуФайлов = ПолучитьИмяВременногоФайла(".txt");
	// BSLLS:MissingTemporaryFileDeletion-on
	Запись = Новый ЗаписьТекста(ПутьКСпискуФайлов, "UTF-8");
	Для Каждого ОтносительныйПуть Из Файлы Цикл
		Запись.ЗаписатьСтроку(ОтносительныйПуть);
	КонецЦикла;
	Запись.Закрыть();

	Возврат ПутьКСпискуФайлов;

КонецФункции

// Непустые строки файла-списка; пустой массив, если файла нет.
Функция ПрочитатьФайлСписка(Знач ПутьКСпискуФайлов)

	Файлы = Новый Массив;
	Если НЕ Новый Файл(ПутьКСпискуФайлов).Существует() Тогда
		Возврат Файлы;
	КонецЕсли;

	Чтение = Новый ЧтениеТекста(ПутьКСпискуФайлов, "UTF-8");
	СтрокаФайла = Чтение.ПрочитатьСтроку();
	Пока СтрокаФайла <> Неопределено Цикл
		Если ЗначениеЗаполнено(СокрЛП(СтрокаФайла)) Тогда
			Файлы.Добавить(СокрЛП(СтрокаФайла));
		КонецЕсли;
		СтрокаФайла = Чтение.ПрочитатьСтроку();
	КонецЦикла;
	Чтение.Закрыть();

	Возврат Файлы;

КонецФункции

// Маски исключения для индексации EDT-исходников: волатильные служебные каталоги рабочей области.
Функция ИсключенияEDT()
	Исключения = Новый Массив;
	Исключения.Добавить("DT-INF");
	Исключения.Добавить(".settings");
	Исключения.Добавить(".git");
	Возврат Исключения;
КонецФункции

// Полная загрузка нужна при добавлении/удалении файлов под src (новые/удалённые объекты, формы,
// реквизиты) и при любом изменении корня конфигурации (src/Configuration).
Функция ТребуетсяПолнаяЗагрузкаEDT(Знач РезультатСравнения)

	Для Каждого Путь Из РезультатСравнения.Удаленные() Цикл
		Если ЗначениеЗаполнено(ПутьВнутриSrcEDT(Путь)) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Для Каждого Путь Из РезультатСравнения.Добавленные() Цикл
		Если ЗначениеЗаполнено(ПутьВнутриSrcEDT(Путь)) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Для Каждого Путь Из РезультатСравнения.Измененные() Цикл
		Если КлючОбъектаEDT(ПутьВнутриSrcEDT(Путь)) = "Configuration" Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Уникальные ключи изменённых объектов "<Вид>/<Имя>" по модификациям под src (без корня Configuration).
Функция ИзмененныеОбъектыEDT(Знач РезультатСравнения)

	Уникальные = Новый Соответствие;
	Объекты = Новый Массив;

	Для Каждого Путь Из РезультатСравнения.Измененные() Цикл
		Ключ = КлючОбъектаEDT(ПутьВнутриSrcEDT(Путь));
		Если НЕ ЗначениеЗаполнено(Ключ) ИЛИ Ключ = "Configuration" Тогда
			Продолжить;
		КонецЕсли;
		Если Уникальные[Ключ] = Неопределено Тогда
			Уникальные.Вставить(Ключ, Истина);
			Объекты.Добавить(Ключ);
		КонецЕсли;
	КонецЦикла;

	Возврат Объекты;

КонецФункции

Функция НормализоватьСтрокуПодключения(Знач СтрокаПодключения)

	Значение = СокрЛП(СтрокаПодключения);
	Если НРег(Лев(Значение, 2)) = "/f" Тогда
		Путь = СокрЛП(Сред(Значение, 3));
		Путь = СтрЗаменить(Путь, """", "");
		Путь = СокрЛП(Путь);
		Возврат "/F" + Новый Файл(Путь).ПолноеИмя;
	КонецЕсли;

	Возврат Значение;

КонецФункции

Функция ПостроитьКлюч(Знач НормКаталог, Знач ПараметрыПодключения, Знач ИмяРасширения)

	Компоненты = Новый Массив;
	Компоненты.Добавить(НормКаталог);
	Если ЗначениеЗаполнено(ИмяРасширения) Тогда
		Компоненты.Добавить(ИмяРасширения);
	КонецЕсли;

	Если ПараметрыПодключения.Свойство("СтрокаПодключения")
		И ЗначениеЗаполнено(ПараметрыПодключения.СтрокаПодключения) Тогда
		Компоненты.Добавить(НормализоватьСтрокуПодключения(ПараметрыПодключения.СтрокаПодключения));
	КонецЕсли;

	Для Каждого ИмяСвойства Из СтрРазделить("ТипСУБД,СерверСУБД,ИмяБазыДанных", ",") Цикл
		Если ПараметрыПодключения.Свойство(ИмяСвойства) И ЗначениеЗаполнено(ПараметрыПодключения[ИмяСвойства]) Тогда
			Компоненты.Добавить(ПараметрыПодключения[ИмяСвойства]);
		КонецЕсли;
	КонецЦикла;

	Возврат ХешDJB2(СтрСоединить(Компоненты, "|"));

КонецФункции

Функция ХешDJB2(Знач Текст)
	Хеш = 5381;
	Для Ч = 1 По СтрДлина(Текст) Цикл
		Хеш = (Хеш * 33 + КодСимвола(Текст, Ч)) % 4294967296;
	КонецЦикла;

	Результат = "";
	Для Ч = 1 По 8 Цикл
		Результат = Сред("0123456789abcdef", Хеш % 16 + 1, 1) + Результат;
		Хеш = Цел(Хеш / 16);
	КонецЦикла;

	Возврат Результат;
КонецФункции

Функция КаталогКешаПоУмолчанию()
	Возврат ОбъединитьПути(КаталогВременныхФайлов(), "vanessa-runner", "cache");
КонецФункции

Функция ПрочитатьФайл(Знач ПутьКФайлу)

	Чтение = Новый ЧтениеТекста(ПутьКФайлу, "UTF-8");
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат Текст;

КонецФункции

Функция ДлительностьМс(Знач ДатаНачала)
	Возврат Окр((ТекущаяУниверсальнаяДата() - ДатаНачала) * 1000, 0);
КонецФункции

#КонецОбласти
