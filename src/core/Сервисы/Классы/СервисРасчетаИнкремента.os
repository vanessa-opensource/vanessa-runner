// BSLLS:MissingVariablesDescription-off Поля autumn
// BSLLS:MagicNumber-off
// BSLLS:NumberOfValuesInStructureConstructor-off (&Лог/&Пластилин/&Напильник) и внутреннее состояние сервиса.
#Использовать change-indexer

&Лог("vrunner")
Перем Лог;

&Пластилин("СервисПлатформы")
Перем СервисПлатформы;

Перем мКаталогКеша;

&Желудь
Процедура ПриСозданииОбъекта(&Деталька(Значение = "increment.cache-dir", ЗначениеПоУмолчанию = "") КаталогКеша)
    Если ЗначениеЗаполнено(КаталогКеша) Тогда
        мКаталогКеша = КаталогКеша;
    Иначе
        мКаталогКеша = КаталогКешаПоУмолчанию();
    КонецЕсли;
    ОбеспечитьКаталог(мКаталогКеша);
КонецПроцедуры

Функция ПодготовитьИнкремент(Знач КаталогИсходников, Знач ПараметрыПодключения) Экспорт

    ДатаНачалаПодготовки = ТекущаяУниверсальнаяДата();
    НормКаталог = Новый Файл(КаталогИсходников).ПолноеИмя;
    Ключ = ПостроитьКлюч(НормКаталог, ПараметрыПодключения);

    КаталогКлюча = ОбъединитьПути(мКаталогКеша, Ключ);
    ОбеспечитьКаталог(КаталогКлюча);
    Лог.Отладка("Инкрементальная загрузка: каталог кеша: %1", КаталогКлюча);

    ПутьИндекса = ОбъединитьПути(КаталогКлюча, "index.cidx");
    ПутьКешаConfigDumpInfo = ОбъединитьПути(КаталогКлюча, "configdumpinfo.xml");
    ПутьТекущегоConfigDumpInfo = ОбъединитьПути(НормКаталог, "ConfigDumpInfo.xml");

    Менеджер = Новый МенеджерИндексов(НормКаталог, ПутьИндекса);
    ЕстьБазовыйИндекс = Менеджер.СуществуетИндекс();

    ДатаНачалаОбновления = ТекущаяУниверсальнаяДата();
    Результат = Менеджер.ОбновитьИндекс();
    Лог.Отладка(
        "Инкрементальная загрузка: индекс обновлён за %1 мс, файлов=%2, добавлено=%3, изменено=%4, удалено=%5",
        ДлительностьМс(ДатаНачалаОбновления),
        Менеджер.КоличествоФайлов(),
        Результат.Добавленные().Количество(),
        Результат.Измененные().Количество(),
        Результат.Удаленные().Количество());

    Если НЕ ЕстьБазовыйИндекс Тогда
        Лог.Отладка("Инкрементальная загрузка: базовый индекс отсутствует, создан новый");
    КонецЕсли;

    Лог.Отладка("Инкрементальная загрузка: подготовка контекста завершена за %1 мс", ДлительностьМс(ДатаНачалаПодготовки));

    Возврат Новый Структура(
        "ЕстьБазовыйИндекс, Результат, ПутьКешаConfigDumpInfo, ПутьТекущегоConfigDumpInfo",
        ЕстьБазовыйИндекс,
        Результат,
        ПутьКешаConfigDumpInfo,
        ПутьТекущегоConfigDumpInfo);

КонецФункции

Процедура ЗафиксироватьИнкремент(КонтекстИнкремента) Экспорт

    ФайлConfigDumpInfo = Новый Файл(КонтекстИнкремента.ПутьТекущегоConfigDumpInfo);
    Если ФайлConfigDumpInfo.Существует() Тогда
        ДатаНачала = ТекущаяУниверсальнаяДата();
        КопироватьФайл(КонтекстИнкремента.ПутьТекущегоConfigDumpInfo, КонтекстИнкремента.ПутьКешаConfigDumpInfo);
        Лог.Отладка("Инкрементальная загрузка: ConfigDumpInfo скопирован в кеш за %1 мс", ДлительностьМс(ДатаНачала));
    КонецЕсли;

КонецПроцедуры

Процедура ПересоздатьИндекс(Знач КаталогИсходников, Знач ПараметрыПодключения) Экспорт
    КонтекстИнкремента = ПодготовитьИнкремент(КаталогИсходников, ПараметрыПодключения);
    ЗафиксироватьИнкремент(КонтекстИнкремента);
    Лог.Информация("Инкрементальная загрузка: индекс перестроен после полной загрузки");
КонецПроцедуры

Функция РассчитатьИнкрементДляЗагрузкиКонфигурации(Знач КаталогИсходников, Знач ПараметрыПодключения, Знач ИспользоватьIbcmd = Ложь, Знач ПараметрыПлатформы = Неопределено, Знач ИсходныйСписокФайлов = "") Экспорт

    КонтекстИнкремента = ПодготовитьИнкремент(КаталогИсходников, ПараметрыПодключения);
    ИзмененияИзКонфигуратора = Неопределено;
    Если КонтекстИнкремента.ЕстьБазовыйИндекс Тогда
        Лог.Отладка("Инкрементальная загрузка: кеш ConfigDumpInfo: %1", КонтекстИнкремента.ПутьКешаConfigDumpInfo);
        ИзмененияИзКонфигуратора = СервисПлатформы.ПолучитьИзмененияКонфигурации(
            ПараметрыПодключения,
            КаталогИсходников,
            ИспользоватьIbcmd,
            ПараметрыПлатформы,
            КонтекстИнкремента.ПутьКешаConfigDumpInfo);
    КонецЕсли;

    РезультатИнкремента = РассчитатьИнкрементКонфигурации(
        КаталогИсходников,
        КонтекстИнкремента,
        ИзмененияИзКонфигуратора,
        ИсходныйСписокФайлов);

    Возврат Новый Структура(
        "КонтекстИнкремента, СписокФайловДляЗагрузки, ПропуститьЗагрузку",
        КонтекстИнкремента,
        РезультатИнкремента.СписокФайловДляЗагрузки,
        РезультатИнкремента.ПропуститьЗагрузку);

КонецФункции

Функция РассчитатьИнкрементДляЗагрузкиРасширения(Знач КаталогИсходников, Знач ПараметрыПодключения, Знач ИмяРасширения, Знач ИспользоватьIbcmd = Ложь, Знач ПараметрыПлатформы = Неопределено) Экспорт

    КонтекстИнкремента = ПодготовитьИнкремент(КаталогИсходников, ПараметрыПодключения);
    ИзмененияИзКонфигуратора = Неопределено;
    Если КонтекстИнкремента.ЕстьБазовыйИндекс Тогда
        Лог.Отладка("Инкрементальная загрузка: кеш ConfigDumpInfo: %1", КонтекстИнкремента.ПутьКешаConfigDumpInfo);
        ИзмененияИзКонфигуратора = СервисПлатформы.ПолучитьИзмененияКонфигурации(
            ПараметрыПодключения,
            КаталогИсходников,
            ИспользоватьIbcmd,
            ПараметрыПлатформы,
            КонтекстИнкремента.ПутьКешаConfigDumpInfo,
            ИмяРасширения);
    КонецЕсли;

    РезультатИнкремента = РассчитатьИнкрементРасширения(
        КаталогИсходников,
        КонтекстИнкремента,
        ИзмененияИзКонфигуратора);

    Возврат Новый Структура(
        "КонтекстИнкремента, СписокФайловДляЗагрузки, ПропуститьЗагрузку",
        КонтекстИнкремента,
        РезультатИнкремента.СписокФайловДляЗагрузки,
        РезультатИнкремента.ПропуститьЗагрузку);

КонецФункции

Функция РассчитатьИнкрементКонфигурации(Знач КаталогИсходников, Знач КонтекстИнкремента, Знач ИзмененияИзКонфигуратора = Неопределено, Знач ИсходныйСписокФайлов = "") Экспорт

    Результат = Новый Структура(
        "СписокФайловДляЗагрузки, ПропуститьЗагрузку",
        ИсходныйСписокФайлов,
        Ложь);

    Если КонтекстИнкремента = Неопределено Тогда
        Возврат Результат;
    КонецЕсли;

    ФайлыПоИндексу = ПолучитьФайлыДляВыборочнойЗагрузки(КаталогИсходников, КонтекстИнкремента.Результат);
    Лог.Отладка("Инкрементальная загрузка: анализ по индексу, файлов к загрузке=%1: %2", ФайлыПоИндексу.Количество(), ПредставитьФайлыДляЛога(ФайлыПоИндексу));

    ТребуетсяПолнаяЗагрузкаИзКонфигуратора = Ложь;
    Если ИзмененияИзКонфигуратора <> Неопределено Тогда
        ТребуетсяПолнаяЗагрузкаИзКонфигуратора = ИзмененияИзКонфигуратора.ТребуетсяПолнаяЗагрузка;

        РезультатСравненияКонфигуратора = Новый РезультатСравнения;
        Для Каждого ФайлКонфигуратора Из ИзмененияИзКонфигуратора.ИзмененныеФайлы Цикл
            РезультатСравненияКонфигуратора.ДобавитьИзмененный(ФайлКонфигуратора);
        КонецЦикла;

        ФайлыПоКонфигуратору = ПолучитьФайлыДляВыборочнойЗагрузки(КаталогИсходников, РезультатСравненияКонфигуратора);
        Лог.Отладка("Инкрементальная загрузка: анализ по ConfigDumpInfo, файлов к загрузке=%1: %2", ФайлыПоКонфигуратору.Количество(), ПредставитьФайлыДляЛога(ФайлыПоКонфигуратору));

        ДобавитьИзмененныеФайлы(КонтекстИнкремента.Результат, ИзмененияИзКонфигуратора.ИзмененныеФайлы);
    КонецЕсли;

    Если НЕ КонтекстИнкремента.ЕстьБазовыйИндекс Тогда
        Лог.Информация("Инкрементальная загрузка: индекс не найден, будет выполнена полная загрузка");
        Возврат Результат;
    КонецЕсли;

    Если ТребуетсяПолнаяЗагрузкаИзКонфигуратора Тогда
        Лог.Информация("Инкрементальная загрузка: изменения в конфигурации требуют полной загрузки");
        Возврат Результат;
    КонецЕсли;

    Если ТребуетсяПолнаяЗагрузкаИзЗаУдалений(КонтекстИнкремента.Результат) Тогда
        Лог.Информация("Инкрементальная загрузка: обнаружены удаленные файлы, будет выполнена полная загрузка");
        Возврат Результат;
    КонецЕсли;

    Если НЕ ЕстьЗначимыеИзмененияДляЗагрузки(КонтекстИнкремента.Результат) Тогда
        Лог.Информация("Инкрементальная загрузка: изменений не найдено, загрузка пропущена");
        ЗафиксироватьИнкремент(КонтекстИнкремента);
        Результат.ПропуститьЗагрузку = Истина;
        Возврат Результат;
    КонецЕсли;

    Результат.СписокФайловДляЗагрузки = ПостроитьСтрокуСпискаФайлов(КаталогИсходников, КонтекстИнкремента.Результат);
    Если СписокФайловПуст(Результат.СписокФайловДляЗагрузки) Тогда
        Лог.Информация("Инкрементальная загрузка: изменений не найдено, загрузка пропущена");
        ЗафиксироватьИнкремент(КонтекстИнкремента);
        Результат.ПропуститьЗагрузку = Истина;
        Возврат Результат;
    КонецЕсли;

    ЗаписатьВЛогСписокФайловЗагрузки(Результат.СписокФайловДляЗагрузки);

    Возврат Результат;

КонецФункции

Функция РассчитатьИнкрементРасширения(Знач КаталогИсходников, Знач КонтекстИнкремента, Знач ИзмененияИзКонфигуратора = Неопределено) Экспорт

    Результат = Новый Структура("ПропуститьЗагрузку, СписокФайловДляЗагрузки", Ложь, "");

    Если КонтекстИнкремента = Неопределено Тогда
        Возврат Результат;
    КонецЕсли;

    ФайлыПоИндексу = ПолучитьФайлыДляВыборочнойЗагрузки(КаталогИсходников, КонтекстИнкремента.Результат);
    Лог.Отладка("Инкрементальная загрузка: анализ по индексу, файлов к загрузке=%1: %2", ФайлыПоИндексу.Количество(), ПредставитьФайлыДляЛога(ФайлыПоИндексу));

    ТребуетсяПолнаяЗагрузкаИзКонфигуратора = Ложь;
    Если ИзмененияИзКонфигуратора <> Неопределено Тогда
        ТребуетсяПолнаяЗагрузкаИзКонфигуратора = ИзмененияИзКонфигуратора.ТребуетсяПолнаяЗагрузка;

        РезультатСравненияКонфигуратора = Новый РезультатСравнения;
        Для Каждого ФайлКонфигуратора Из ИзмененияИзКонфигуратора.ИзмененныеФайлы Цикл
            РезультатСравненияКонфигуратора.ДобавитьИзмененный(ФайлКонфигуратора);
        КонецЦикла;

        ФайлыПоКонфигуратору = ПолучитьФайлыДляВыборочнойЗагрузки(КаталогИсходников, РезультатСравненияКонфигуратора);
        Лог.Отладка("Инкрементальная загрузка: анализ по ConfigDumpInfo, файлов к загрузке=%1: %2", ФайлыПоКонфигуратору.Количество(), ПредставитьФайлыДляЛога(ФайлыПоКонфигуратору));

        ДобавитьИзмененныеФайлы(КонтекстИнкремента.Результат, ИзмененияИзКонфигуратора.ИзмененныеФайлы);
    КонецЕсли;

    Если НЕ КонтекстИнкремента.ЕстьБазовыйИндекс Тогда
        Лог.Информация("Инкрементальная загрузка: индекс не найден, будет выполнена полная загрузка");
        Возврат Результат;
    КонецЕсли;

    Если ТребуетсяПолнаяЗагрузкаИзКонфигуратора Тогда
        Лог.Информация("Инкрементальная загрузка: изменения в расширении требуют полной загрузки");
        Возврат Результат;
    КонецЕсли;

    Если ТребуетсяПолнаяЗагрузкаИзЗаУдалений(КонтекстИнкремента.Результат) Тогда
        Лог.Информация("Инкрементальная загрузка: обнаружены удаленные файлы, будет выполнена полная загрузка");
        Возврат Результат;
    КонецЕсли;

    Если НЕ ЕстьЗначимыеИзмененияДляЗагрузки(КонтекстИнкремента.Результат) Тогда
        Лог.Информация("Инкрементальная загрузка: изменений не найдено, загрузка пропущена");
        ЗафиксироватьИнкремент(КонтекстИнкремента);
        Результат.ПропуститьЗагрузку = Истина;
        Возврат Результат;
    КонецЕсли;

    Результат.СписокФайловДляЗагрузки = ПостроитьСтрокуСпискаФайлов(КаталогИсходников, КонтекстИнкремента.Результат);
    Если СписокФайловПуст(Результат.СписокФайловДляЗагрузки) Тогда
        Лог.Информация("Инкрементальная загрузка: изменений не найдено, загрузка пропущена");
        ЗафиксироватьИнкремент(КонтекстИнкремента);
        Результат.ПропуститьЗагрузку = Истина;
        Возврат Результат;
    КонецЕсли;

    ЗаписатьВЛогСписокФайловЗагрузки(Результат.СписокФайловДляЗагрузки);

    Возврат Результат;

КонецФункции

Функция ПостроитьСтрокуСпискаФайлов(Знач КаталогИсходников, Знач РезультатСравнения) Экспорт

    ДатаНачалаПостроенияСписка = ТекущаяУниверсальнаяДата();

    ФайлыДляЗагрузки = ПолучитьФайлыДляВыборочнойЗагрузки(КаталогИсходников, РезультатСравнения);

    // BSLLS:MissingTemporaryFileDeletion-off Имя файла - часть контракта функции; очистка - ПолучитьИмяВременногоФайла() при выходе процесса
    ПутьКСпискуФайлов = ПолучитьИмяВременногоФайла(".txt");
    // BSLLS:MissingTemporaryFileDeletion-on
    Запись = Новый ЗаписьТекста(ПутьКСпискуФайлов, "UTF-8");

    Для Каждого ОтносительныйПуть Из ФайлыДляЗагрузки Цикл
        Запись.ЗаписатьСтроку(ОтносительныйПуть);
    КонецЦикла;
    Запись.Закрыть();

    Лог.Отладка("Инкрементальная загрузка: список файлов для загрузки построен за %1 мс, файлов=%2", ДлительностьМс(ДатаНачалаПостроенияСписка), ФайлыДляЗагрузки.Количество());
    Лог.Отладка("Инкрементальная загрузка: файлы выборочной загрузки: %1", ПредставитьФайлыДляЛога(ФайлыДляЗагрузки));

    Возврат ПутьКСпискуФайлов;

КонецФункции

Функция ПолучитьФайлыДляВыборочнойЗагрузки(Знач КаталогИсходников, Знач РезультатСравнения) Экспорт

    УникальныеФайлы = Новый Соответствие;
    ДобавитьФайлыДляЗагрузки(УникальныеФайлы, КаталогИсходников, РезультатСравнения.Добавленные());
    ДобавитьФайлыДляЗагрузки(УникальныеФайлы, КаталогИсходников, РезультатСравнения.Измененные());

    ФайлыДляЗагрузки = Новый Массив;
    Для Каждого КлючИЗначение Из УникальныеФайлы Цикл
        ФайлыДляЗагрузки.Добавить(КлючИЗначение.Ключ);
    КонецЦикла;

    Возврат ФайлыДляЗагрузки;

КонецФункции

Функция ПредставитьФайлыДляЛога(Знач Файлы) Экспорт

    Если Файлы.Количество() = 0 Тогда
        Возврат "(пусто)";
    КонецЕсли;

    МаксимумФайлов = 20;
    Представление = Новый Массив;
    Индекс = 0;

    Для Каждого Файл Из Файлы Цикл
        Если Индекс < МаксимумФайлов Тогда
            Представление.Добавить(Файл);
        КонецЕсли;
        Индекс = Индекс + 1;
    КонецЦикла;

    Результат = СтрСоединить(Представление, ", ");
    Если Файлы.Количество() > МаксимумФайлов Тогда
        Результат = Результат + СтрШаблон(" ... (+%1)", Файлы.Количество() - МаксимумФайлов);
    КонецЕсли;

    Возврат Результат;

КонецФункции

Функция ТребуетсяПолнаяЗагрузкаИзЗаУдалений(Знач РезультатСравнения) Экспорт
    Возврат РезультатСравнения.Удаленные().Количество() > 0;
КонецФункции

Функция ЕстьЗначимыеИзмененияДляЗагрузки(Знач РезультатСравнения) Экспорт

    Для Каждого Путь Из РезультатСравнения.Добавленные() Цикл
        Если НРег(Новый Файл(Путь).Имя) <> "configdumpinfo.xml" Тогда
            Возврат Истина;
        КонецЕсли;
    КонецЦикла;

    Для Каждого Путь Из РезультатСравнения.Измененные() Цикл
        Если НРег(Новый Файл(Путь).Имя) <> "configdumpinfo.xml" Тогда
            Возврат Истина;
        КонецЕсли;
    КонецЦикла;

    Возврат Ложь;

КонецФункции

Функция СписокФайловПуст(Знач ПутьКСпискуФайлов) Экспорт
    ФайлСписка = Новый Файл(ПутьКСпискуФайлов);
    Если НЕ ФайлСписка.Существует() Тогда
        Возврат Истина;
    КонецЕсли;
    Чтение = Новый ЧтениеТекста(ПутьКСпискуФайлов, "UTF-8");
    ЕстьСтрока = Ложь;
    СтрокаФайла = Чтение.ПрочитатьСтроку();
    Пока СтрокаФайла <> Неопределено Цикл
        Если СокрЛП(СтрокаФайла) <> "" Тогда
            ЕстьСтрока = Истина;
            Прервать;
        КонецЕсли;
        СтрокаФайла = Чтение.ПрочитатьСтроку();
    КонецЦикла;
    Чтение.Закрыть();
    Возврат НЕ ЕстьСтрока;
КонецФункции

Процедура ЗаписатьВЛогСписокФайловЗагрузки(Знач ПутьКСпискуФайлов)

    ФайлСписка = Новый Файл(ПутьКСпискуФайлов);
    Если НЕ ФайлСписка.Существует() Тогда
        Возврат;
    КонецЕсли;

    Файлы = Новый Массив;
    Чтение = Новый ЧтениеТекста(ПутьКСпискуФайлов, "UTF-8");
    Строка = Чтение.ПрочитатьСтроку();
    Пока Строка <> Неопределено Цикл
        Строка = СокрЛП(Строка);
        Если ЗначениеЗаполнено(Строка) Тогда
            Файлы.Добавить(Строка);
        КонецЕсли;
        Строка = Чтение.ПрочитатьСтроку();
    КонецЦикла;
    Чтение.Закрыть();

    Если Файлы.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;

    Лог.Информация("Инкрементальная загрузка: будет загружено %1 файл(ов):", Файлы.Количество());
    Для Каждого Файл Из Файлы Цикл
        Лог.Информация("  - %1", Файл);
    КонецЦикла;

КонецПроцедуры

Процедура ДобавитьИзмененныеФайлы(Знач РезультатСравнения, Знач ИзмененныеФайлы) Экспорт

    Если ИзмененныеФайлы = Неопределено Тогда
        Возврат;
    КонецЕсли;

    УжеЕсть = Новый Соответствие;

    Для Каждого Путь Из РезультатСравнения.Добавленные() Цикл
        УжеЕсть.Вставить(НРег(Путь), Истина);
    КонецЦикла;

    Для Каждого Путь Из РезультатСравнения.Измененные() Цикл
        УжеЕсть.Вставить(НРег(Путь), Истина);
    КонецЦикла;

    Для Каждого Путь Из ИзмененныеФайлы Цикл
        Если НЕ ЗначениеЗаполнено(Путь) Тогда
            Продолжить;
        КонецЕсли;

        НормПуть = СтрЗаменить(Путь, "\\", "/");
        КлючПути = НРег(НормПуть);

        Если УжеЕсть[КлючПути] <> Неопределено Тогда
            Продолжить;
        КонецЕсли;

        РезультатСравнения.ДобавитьИзмененный(НормПуть);
        УжеЕсть.Вставить(КлючПути, Истина);
    КонецЦикла;

КонецПроцедуры

Функция ИзменилсяConfigDumpInfo(КонтекстИнкремента) Экспорт

    ФайлКеша = Новый Файл(КонтекстИнкремента.ПутьКешаConfigDumpInfo);
    ФайлТекущий = Новый Файл(КонтекстИнкремента.ПутьТекущегоConfigDumpInfo);

    Если НЕ ФайлКеша.Существует() ИЛИ НЕ ФайлТекущий.Существует() Тогда
        Возврат Ложь;
    КонецЕсли;

    ТекстКеша = ПрочитатьФайл(КонтекстИнкремента.ПутьКешаConfigDumpInfo);
    ТекстТекущий = ПрочитатьФайл(КонтекстИнкремента.ПутьТекущегоConfigDumpInfo);

    Возврат ТекстКеша <> ТекстТекущий;

КонецФункции

Функция НормализоватьСтрокуПодключения(Знач СтрокаПодключения)

    Строка = СокрЛП(СтрокаПодключения);
    Если НРег(Лев(Строка, 2)) = "/f" Тогда
        Путь = СокрЛП(Сред(Строка, 3));
        Путь = СтрЗаменить(Путь, """", "");
        Путь = СокрЛП(Путь);
        Возврат "/F" + Новый Файл(Путь).ПолноеИмя;
    КонецЕсли;

    Возврат Строка;

КонецФункции

Функция ПостроитьКлюч(Знач НормКаталог, Знач ПараметрыПодключения)

    Компоненты = Новый Массив;
    Компоненты.Добавить(НормКаталог);

    Если ПараметрыПодключения.Свойство("СтрокаПодключения") И ЗначениеЗаполнено(ПараметрыПодключения.СтрокаПодключения) Тогда
        Компоненты.Добавить(НормализоватьСтрокуПодключения(ПараметрыПодключения.СтрокаПодключения));
    КонецЕсли;

    Если ПараметрыПодключения.Свойство("ТипСУБД") И ЗначениеЗаполнено(ПараметрыПодключения.ТипСУБД) Тогда
        Компоненты.Добавить(ПараметрыПодключения.ТипСУБД);
    КонецЕсли;

    Если ПараметрыПодключения.Свойство("СерверСУБД") И ЗначениеЗаполнено(ПараметрыПодключения.СерверСУБД) Тогда
        Компоненты.Добавить(ПараметрыПодключения.СерверСУБД);
    КонецЕсли;

    Если ПараметрыПодключения.Свойство("ИмяБазыДанных") И ЗначениеЗаполнено(ПараметрыПодключения.ИмяБазыДанных) Тогда
        Компоненты.Добавить(ПараметрыПодключения.ИмяБазыДанных);
    КонецЕсли;

    Возврат ХешDJB2(СтрСоединить(Компоненты, "|"));

КонецФункции

Функция ХешDJB2(Знач Строка)
    Хеш = 5381;
    Для Ч = 1 По СтрДлина(Строка) Цикл
        Хеш = (Хеш * 33 + КодСимвола(Строка, Ч)) % 4294967296;
    КонецЦикла;

    Результат = "";
    Для Ч = 1 По 8 Цикл
        Результат = Сред("0123456789abcdef", Хеш % 16 + 1, 1) + Результат;
        Хеш = Цел(Хеш / 16);
    КонецЦикла;

    Возврат Результат;
КонецФункции

Функция КаталогКешаПоУмолчанию()
    Возврат ОбъединитьПути(КаталогВременныхФайлов(), "vanessa-runner", "cache");
КонецФункции

Процедура ОбеспечитьКаталог(Знач ПутьКаталога)
    Если НЕ Новый Файл(ПутьКаталога).Существует() Тогда
        СоздатьКаталог(ПутьКаталога);
    КонецЕсли;
КонецПроцедуры

Функция ПрочитатьФайл(Знач ПутьКФайлу)

    Чтение = Новый ЧтениеТекста(ПутьКФайлу, "UTF-8");
    Текст = Чтение.Прочитать();
    Чтение.Закрыть();
    Возврат Текст;

КонецФункции

Функция ДлительностьМс(Знач ДатаНачала)
    Возврат Окр((ТекущаяУниверсальнаяДата() - ДатаНачала) * 1000, 0);
КонецФункции

Процедура ДобавитьФайлыДляЗагрузки(Знач УникальныеФайлы, Знач КаталогИсходников, Знач Кандидаты)

    Для Каждого ОтносительныйПуть Из Кандидаты Цикл
        Если НЕ ЭтоПодходящийФайлДляЗагрузки(КаталогИсходников, ОтносительныйПуть) Тогда
            Продолжить;
        КонецЕсли;
        УникальныеФайлы.Вставить(ОтносительныйПуть, Истина);
    КонецЦикла;

КонецПроцедуры

Функция ЭтоПодходящийФайлДляЗагрузки(Знач КаталогИсходников, Знач ОтносительныйПуть)

    ИмяФайла = Новый Файл(ОтносительныйПуть).Имя;
    Если НРег(ИмяФайла) = НРег("ConfigDumpInfo.xml") Тогда
        Возврат Ложь;
    КонецЕсли;

    ПолныйПуть = ОбъединитьПути(КаталогИсходников, ОтносительныйПуть);
    Возврат Новый Файл(ПолныйПуть).Существует();

КонецФункции