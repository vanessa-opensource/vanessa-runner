// BSLLS:MissingVariablesDescription-off Поля autumn (&Лог/&Пластилин)
// BSLLS:MissingParameterDescription-off Внутренние служебные методы.
// BSLLS:MissingReturnedValueDescription-off Внутренние служебные методы.
// BSLLS:NumberOfOptionalParams-off
// BSLLS:LatinAndCyrillicSymbolInWord-off Идентификаторы с латинской аббревиатурой (ПортIbsrv и т.п.).
// BSLLS:Typo-off
// Инфраструктурный сервис платформы.
// Управление жизненным циклом ИБ, обновление конфигурации БД, запуск процессов,
// проверка конфигурации. Операции с CF-файлами - в СервисКонфигурации.

&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисВременнойБазы;

&Пластилин
Перем СервисАвтономногоСервера;

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Создать файловую ИБ в заданном каталоге.
//
// Параметры:
//   КаталогБазы - Строка - путь к каталогу для создания ИБ
//   ИспользоватьIbcmd - Булево - использовать ibcmd (Истина) или конфигуратор (Ложь)
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//
// Возвращаемое значение:
//   Структура - СтрокаПодключения, Пользователь, Пароль, КаталогБазы
//
Функция СоздатьФайловуюБазу(Знач КаталогБазы,
		Знач ИспользоватьIbcmd = Ложь, Знач ПараметрыПлатформы = Неопределено) Экспорт

	Движок = СервисВременнойБазы.ВыбратьДвижок(ИспользоватьIbcmd);
	Лог.Отладка("Создание файловой ИБ: каталог=%1, движок=%2", КаталогБазы, Движок);
	Результат = Движок.СоздатьФайловуюБазу(КаталогБазы, ПараметрыПлатформы);
	Лог.Информация("Файловая ИБ создана: %1", КаталогБазы);
	Возврат Результат;

КонецФункции

// Загрузить данные ИБ из DT-файла.
//
// Параметры:
//   ПараметрыПодключения - Структура, Неопределено - параметры подключения к ИБ
//   ПутьКФайлуDT - Строка - путь к DT-файлу инфобазы
//   ИспользоватьIbcmd - Булево - использовать ibcmd (Истина) или конфигуратор (Ложь)
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//
Процедура ЗагрузитьИнфобазуИзФайла(Знач ПараметрыПодключения, Знач ПутьКФайлуDT,
		Знач ИспользоватьIbcmd = Ложь, Знач ПараметрыПлатформы = Неопределено) Экспорт

	Движок = СервисВременнойБазы.ВыбратьДвижок(ИспользоватьIbcmd);
	Лог.Отладка("Загрузка инфобазы из DT: файл=%1, движок=%2", ПутьКФайлуDT, Движок);
	Движок.ЗагрузитьИнфобазуИзФайла(ПараметрыПодключения, ПутьКФайлуDT, ПараметрыПлатформы);
	Лог.Информация("Инфобаза загружена из файла %1", ПутьКФайлуDT);

КонецПроцедуры

// Выгрузить данные ИБ в DT-файл.
//
// Параметры:
//   ПараметрыПодключения - Структура, Неопределено - параметры подключения к ИБ
//   ПутьКФайлуDT - Строка - путь к DT-файлу для выгрузки
//   ИспользоватьIbcmd - Булево - использовать ibcmd (Истина) или конфигуратор (Ложь)
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//
Процедура ВыгрузитьИнфобазуВФайл(Знач ПараметрыПодключения, Знач ПутьКФайлуDT,
		Знач ИспользоватьIbcmd = Ложь, Знач ПараметрыПлатформы = Неопределено) Экспорт

	Движок = СервисВременнойБазы.ВыбратьДвижок(ИспользоватьIbcmd);
	Лог.Отладка("Выгрузка инфобазы в DT: файл=%1, движок=%2", ПутьКФайлуDT, Движок);
	Движок.ВыгрузитьИнфобазуВФайл(ПараметрыПодключения, ПутьКФайлуDT, ПараметрыПлатформы);
	Лог.Информация("Инфобаза выгружена в файл %1", ПутьКФайлуDT);

КонецПроцедуры

// Обновить конфигурацию базы данных.
//
// Параметры:
//   ПараметрыПодключения - Структура - параметры подключения к ИБ
//   ИспользоватьIbcmd - Булево - использовать ibcmd (Истина) или конфигуратор (Ложь)
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//   НастройкиОбновления - Структура, Неопределено - параметры обновления
//
Процедура ОбновитьКонфигурациюБД(
	Знач ПараметрыПодключения,
	Знач ИспользоватьIbcmd = Ложь,
	Знач ПараметрыПлатформы = Неопределено,
	Знач НастройкиОбновления = Неопределено) Экспорт

	Движок = СервисВременнойБазы.ВыбратьДвижок(ИспользоватьIbcmd);
	Лог.Отладка("Обновление конфигурации БД: движок=%1", Движок);
	Движок.ОбновитьКонфигурациюБД(ПараметрыПодключения, ПараметрыПлатформы, НастройкиОбновления);
	Лог.Информация("Конфигурация базы данных обновлена");

КонецПроцедуры

// Запустить 1С:Предприятие с заданными параметрами, при необходимости через ibsrv.
//
// Параметры:
//   ПараметрыПодключения - Структура - параметры подключения к ИБ
//   ПараметрыЗапуска - Структура - параметры запуска: КомандаЗапуска, НеОжидать, ТолстыйКлиент и др.
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//
Процедура ЗапуститьПредприятие(Знач ПараметрыПодключения, Знач ПараметрыЗапуска,
		Знач ПараметрыПлатформы = Неопределено) Экспорт

	Движок = СервисВременнойБазы.ДвижокКонфигуратор();

	Если ИспользоватьIbsrv(ПараметрыЗапуска, ПараметрыПодключения) Тогда
		ЗапуститьПредприятиеЧерезIbsrv(Движок, ПараметрыПодключения, ПараметрыЗапуска, ПараметрыПлатформы);
		Возврат;
	КонецЕсли;

	Лог.Отладка("Запуск 1С:Предприятие");
	Движок.ЗапуститьПредприятие(ПараметрыПодключения, ПараметрыЗапуска, ПараметрыПлатформы);

КонецПроцедуры

// Запустить конфигуратор с заданными параметрами.
//
// Параметры:
//   ПараметрыПодключения - Структура - параметры подключения к ИБ
//   ПараметрыЗапуска - Структура - параметры запуска конфигуратора
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//
Процедура ЗапуститьКонфигуратор(Знач ПараметрыПодключения, Знач ПараметрыЗапуска,
		Знач ПараметрыПлатформы = Неопределено) Экспорт

	Движок = СервисВременнойБазы.ДвижокКонфигуратор();
	Лог.Отладка("Запуск Конфигуратора");
	Движок.ЗапуститьКонфигуратор(ПараметрыПодключения, ПараметрыЗапуска, ПараметрыПлатформы);

КонецПроцедуры

// Выполнить проверку конфигурации (syntax-check).
// Создаёт временную базу при необходимости, делегирует проверку движку конфигуратора.
//
// Параметры:
//   ПараметрыПодключения - Структура, Неопределено - параметры подключения к ИБ
//   РежимыПроверки - Массив из Строка - режимы проверки (напр. "-ThinClient", "-Server")
//   ПараметрыХранилища - Структура, Неопределено - параметры хранилища
//   ПараметрыПлатформы - Структура, Неопределено - параметры платформы
//
// Возвращаемое значение:
//   Структура - Успешно (Булево), ВыводКоманды (Строка)
//
Функция ПроверитьКонфигурацию(Знач ПараметрыПодключения, Знач РежимыПроверки,
		Знач ПараметрыХранилища = Неопределено, Знач ПараметрыПлатформы = Неопределено) Экспорт

	Движок = СервисВременнойБазы.ДвижокКонфигуратор();
	Лог.Отладка("Проверка конфигурации, режимы: %1", СтрСоединить(РежимыПроверки, " "));

	КонтекстБазы = СервисВременнойБазы.Подготовить(Движок, ПараметрыПодключения, ПараметрыПлатформы);

	Попытка
		Результат = Движок.ВыполнитьПроверкуКонфигурации(
			КонтекстБазы.ПараметрыПодключения, РежимыПроверки, ПараметрыХранилища, ПараметрыПлатформы);
	Исключение
		СервисВременнойБазы.Очистить(КонтекстБазы);
		ВызватьИсключение;
	КонецПопытки;

	СервисВременнойБазы.Очистить(КонтекстБазы);

	Если Результат.Успешно Тогда
		Лог.Информация("Проверка конфигурации завершена: ошибок не обнаружено");
	Иначе
		Лог.Предупреждение("Проверка конфигурации завершена с ошибками");
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Получить список изменённых файлов конфигурации относительно кеша ConfigDumpInfo.
//
// Параметры:
//   ПараметрыПодключения - Структура, Неопределено - параметры подключения к ИБ
//   КаталогИсходников - Строка - путь к каталогу с файлами исходников конфигурации
//   ИспользоватьIbcmd - Булево - использовать ibcmd (Истина) или конфигуратор (Ложь)
//   ПараметрыПлатформы - Структура, Неопределено - параметры версии платформы
//   ПутьКФайлуВерсийДляСравнения - Строка - путь к файлу кеша ConfigDumpInfo
//   ИмяРасширения - Строка - имя расширения (пусто для основной конфигурации)
//
// Возвращаемое значение:
//   Структура - ТребуетсяПолнаяЗагрузка (Булево), ИзмененныеФайлы (Массив из Строка)
//
Функция ПолучитьИзмененияКонфигурации(Знач ПараметрыПодключения, Знач КаталогИсходников,
		Знач ИспользоватьIbcmd = Ложь, Знач ПараметрыПлатформы = Неопределено,
		Знач ПутьКФайлуВерсийДляСравнения = "", Знач ИмяРасширения = "") Экспорт

	Движок = СервисВременнойБазы.ВыбратьДвижок(ИспользоватьIbcmd);
	Лог.Отладка("Получение изменений конфигурации: исходники=%1, движок=%2", КаталогИсходников, Движок);
	Возврат Движок.ПолучитьИзмененияКонфигурации(
		ПараметрыПодключения,
		КаталогИсходников,
		ПутьКФайлуВерсийДляСравнения,
		ПараметрыПлатформы,
		ИмяРасширения);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Решает, нужно ли запускать команду через ibsrv: проверяет флаг,
// что ИБ файловая, и что не указан НеОжидать (ibsrv не имеет смысла без ожидания).
//
// Параметры:
//   ПараметрыЗапуска     - Структура, Неопределено - параметры запуска (НеОжидать, ИспользоватьIbsrv)
//   ПараметрыПодключения - Структура, Неопределено - строка подключения к ИБ
//
// Возвращаемое значение:
//   Булево - Истина если нужен ibsrv
//
Функция ИспользоватьIbsrv(Знач ПараметрыЗапуска, Знач ПараметрыПодключения)

	Если ПараметрыЗапуска = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Если НЕ ФлагЗапуска(ПараметрыЗапуска, "ИспользоватьIbsrv") Тогда
		Лог.Отладка("ibsrv не запрошен");
		Возврат Ложь;
	КонецЕсли;

	СтрокаПодключения = "";
	Если ПараметрыПодключения <> Неопределено
		И ПараметрыПодключения.Свойство("СтрокаПодключения") Тогда
		СтрокаПодключения = ПараметрыПодключения.СтрокаПодключения;
	КонецЕсли;

	Если НЕ СервисАвтономногоСервера.ЭтоФайловаяИБ(СтрокаПодключения) Тогда
		Лог.Предупреждение("Серверные ИБ не поддерживаются ibsrv - режим ibsrv проигнорирован");
		Возврат Ложь;
	КонецЕсли;

	Если ФлагЗапуска(ПараметрыЗапуска, "НеОжидать") Тогда
		Лог.Предупреждение("Запуск без ожидания не поддерживается при работе с ibsrv - режим ibsrv проигнорирован");
		Возврат Ложь;
	КонецЕсли;

	Лог.Отладка("Используем ibsrv");
	Возврат Истина;

КонецФункции

// Поднять ibsrv для файловой ИБ, запустить предприятие через него и остановить сервер.
Процедура ЗапуститьПредприятиеЧерезIbsrv(Знач Движок, Знач ПараметрыПодключения, Знач ПараметрыЗапуска,
		Знач ПараметрыПлатформы)

	ПараметрыАС = ПараметрыАСИзПараметровЗапуска(ПараметрыЗапуска);
	Контекст = СервисАвтономногоСервера.ЗапуститьСервер(ПараметрыПодключения, ПараметрыПлатформы, ПараметрыАС);

	ПараметрыПодключенияIbsrv = Новый Структура;
	Для Каждого КлючИЗначение Из ПараметрыПодключения Цикл
		ПараметрыПодключенияIbsrv.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	ПараметрыПодключенияIbsrv.Вставить("СтрокаПодключения", Контекст.СтрокаПодключения);

	// Healthcheck-watchdog: движок раз в минуту проверит СерверЖив() у этого сервиса
	// и прервёт зависший клиент, если ibsrv умер из-под него.
	ПараметрыЗапуска.Вставить("МониторСервера", СервисАвтономногоСервера);

	Лог.Отладка("Запуск 1С:Предприятие через ibsrv: %1", Контекст.СтрокаПодключения);
	Попытка
		Движок.ЗапуститьПредприятие(ПараметрыПодключенияIbsrv, ПараметрыЗапуска, ПараметрыПлатформы);
	Исключение
		СервисАвтономногоСервера.ОстановитьСервер();
		ВызватьИсключение;
	КонецПопытки;
	СервисАвтономногоСервера.ОстановитьСервер();

КонецПроцедуры

// Параметры автономного сервера из параметров запуска (ключи *Ibsrv и адрес сервера отладки).
Функция ПараметрыАСИзПараметровЗапуска(Знач ПараметрыЗапуска)

	ПараметрыАС = СервисАвтономногоСервера.НовыеПараметрыАС();
	ПараметрыАС.ИспользоватьПрямоеСоединение = ФлагЗапуска(ПараметрыЗапуска, "ИспользоватьПрямоеСоединениеIbsrv");
	ПараметрыАС.ИспользоватьОтладку = ФлагЗапуска(ПараметрыЗапуска, "ИспользоватьОтладкуIbsrv");
	ПодключитьсяКСуществующему = ФлагЗапуска(ПараметрыЗапуска, "ПодключитьсяКСуществующемуIbsrv");
	Порт = ПортIbsrv(ПараметрыЗапуска);

	Если ПодключитьсяКСуществующему И Порт <= 0 Тогда
		ВызватьИсключение "Опция --ibsrv-attach требует указания порта подключения через --ibsrv-port.";
	КонецЕсли;

	ПараметрыАС.Вставить("ПодключитьсяКСуществующему", ПодключитьсяКСуществующему);
	ПараметрыАС.Вставить("Порт", Порт);

	// Для сбора покрытия ibsrv должен подключиться к нашему серверу отладки (dbgs),
	// иначе серверный код, исполняемый в ibsrv, не попадёт в замеры покрытия.
	АдресСервераОтладки = "";
	Если ПараметрыЗапуска.Свойство("АдресСервераОтладки")
		И ЗначениеЗаполнено(ПараметрыЗапуска.АдресСервераОтладки) Тогда
		АдресСервераОтладки = ПараметрыЗапуска.АдресСервераОтладки;
	КонецЕсли;
	ПараметрыАС.Вставить("АдресВнешнегоСервераОтладки", АдресСервераОтладки);

	Возврат ПараметрыАС;

КонецФункции

// Булев флаг параметров запуска: Истина, только если ключ есть и равен Истина.
Функция ФлагЗапуска(Знач ПараметрыЗапуска, Знач Ключ)

	Возврат ПараметрыЗапуска.Свойство(Ключ) И ПараметрыЗапуска[Ключ] = Истина;

КонецФункции

// Порт ibsrv из параметров запуска (0 = не задан).
Функция ПортIbsrv(Знач ПараметрыЗапуска)

	Значение = Неопределено;
	ПараметрыЗапуска.Свойство("ПортIbsrv", Значение);
	Если Значение = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Число(Значение);

КонецФункции

#КонецОбласти
