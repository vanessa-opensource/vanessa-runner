// BSLLS:MissingVariablesDescription-off Поля autumn
// BSLLS:PublicMethodsDescription-off
// BSLLS:NumberOfOptionalParams-off (&Лог/&Пластилин/&Напильник) и внутреннее состояние сервиса.
// Сервис операций с хранилищем конфигурации.
// Фасад: единый интерфейс к операциям с хранилищем.
// Использует v8storage МенеджерХранилищаКонфигурации для операций с хранилищем.

#Использовать v8storage

&Лог("vrunner")
Перем Лог;

&Пластилин(Значение = "ДвижокПлатформы", Тип = "Соответствие")
Перем Движки;

// Опциональная фабрика МенеджерХранилищаКонфигурации (для юнит-тестов).
// Если задана, должна реализовать метод Создать().
Перем _ФабрикаМенеджераХранилища;

&Желудь
Процедура ПриСозданииОбъекта()
	_ФабрикаМенеджераХранилища = Неопределено;
КонецПроцедуры

#Область ПрограммныйИнтерфейс

Процедура ОбновитьИзХранилища(Знач ПараметрыПодключения, Знач ПараметрыХранилища, Знач ПараметрыПлатформы = Неопределено) Экспорт

	Лог.Информация("Выполняю обновление конфигурации из хранилища");
	Менеджер = СоздатьМенеджерХранилища(ПараметрыПодключения, ПараметрыХранилища, ПараметрыПлатформы);

	Попытка
		Менеджер.ОбновитьКонфигурациюНаВерсию(ПараметрыХранилища.Версия);
		Лог.Информация("Обновление конфигурации из хранилища завершено");
	Исключение
		Лог.Ошибка(Менеджер.ПолучитьВыводКоманды());
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Процедура СоздатьХранилище(Знач ПараметрыХранилища, Знач ПараметрыПлатформы = Неопределено, Знач ПараметрыПодключения = Неопределено) Экспорт

	Лог.Информация("Выполняю создание хранилища конфигурации");

	КонтекстБазы = ПодготовитьБазу(ПараметрыПодключения, ПараметрыПлатформы);
	Менеджер = СоздатьМенеджерХранилища(КонтекстБазы.ПараметрыПодключения, ПараметрыХранилища, ПараметрыПлатформы);

	Попытка
		Менеджер.СоздатьХранилищеКонфигурации();
		Лог.Информация("Создание хранилища конфигурации завершено");
	Исключение
		ОчиститьВременнуюБазу(КонтекстБазы);
		ВызватьИсключение;
	КонецПопытки;

	ОчиститьВременнуюБазу(КонтекстБазы);

КонецПроцедуры

Процедура ПодключитьсяКХранилищу(Знач ПараметрыПодключения, Знач ПараметрыХранилища,
	Знач ИгнорироватьНаличиеПодключеннойБД = Ложь,
	Знач ЗаменитьКонфигурациюБД = Истина,
	Знач ПараметрыПлатформы = Неопределено) Экспорт

	Лог.Информация("Выполняю подключение к хранилищу конфигурации");
	Менеджер = СоздатьМенеджерХранилища(ПараметрыПодключения, ПараметрыХранилища, ПараметрыПлатформы);

	Попытка
		Менеджер.ПодключитьсяКХранилищу(ИгнорироватьНаличиеПодключеннойБД, ЗаменитьКонфигурациюБД);
		Лог.Информация("Подключение к хранилищу конфигурации завершено");
	Исключение
		Лог.Ошибка(Менеджер.ПолучитьВыводКоманды());
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Процедура ОтключитьсяОтХранилища(Знач ПараметрыПодключения, Знач ПараметрыПлатформы = Неопределено) Экспорт

	Лог.Информация("Выполняю отключение от хранилища конфигурации");
	Менеджер = СоздатьМенеджерХранилища(ПараметрыПодключения, Неопределено, ПараметрыПлатформы);

	Попытка
		Менеджер.ОтключитьсяОтХранилища();
		Лог.Информация("Отключение конфигурации от хранилища завершено");
	Исключение
		Лог.Ошибка(Менеджер.ПолучитьВыводКоманды());
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Процедура СоздатьПользователяХранилища(Знач ПараметрыХранилища,
	Знач ЛогинПользователя, Знач ПарольПользователя, Знач РольПользователя,
	Знач ПараметрыПлатформы = Неопределено, Знач ПараметрыПодключения = Неопределено) Экспорт

	Лог.Информация("Выполняю создание пользователя хранилища конфигурации");

	КонтекстБазы = ПодготовитьБазу(ПараметрыПодключения, ПараметрыПлатформы);
	Менеджер = СоздатьМенеджерХранилища(КонтекстБазы.ПараметрыПодключения, ПараметрыХранилища, ПараметрыПлатформы);

	Попытка
		Менеджер.ДобавитьПользователяВХранилище(ЛогинПользователя, ПарольПользователя, РольПользователя);
		Лог.Информация("Создание пользователя хранилища конфигурации завершено");
	Исключение
		ОчиститьВременнуюБазу(КонтекстБазы);
		ВызватьИсключение;
	КонецПопытки;

	ОчиститьВременнуюБазу(КонтекстБазы);

КонецПроцедуры

Процедура КопироватьПользователейИзХранилища(Знач ПараметрыХранилища,
	Знач АдресХранилищаИсточника, Знач ПользовательИсточника, Знач ПарольИсточника,
	Знач ВосстановитьУдаленного = Ложь,
	Знач ПараметрыПлатформы = Неопределено, Знач ПараметрыПодключения = Неопределено) Экспорт

	Лог.Информация("Выполняю копирование пользователей из хранилища конфигурации");

	КонтекстБазы = ПодготовитьБазу(ПараметрыПодключения, ПараметрыПлатформы);
	Менеджер = СоздатьМенеджерХранилища(КонтекстБазы.ПараметрыПодключения, ПараметрыХранилища, ПараметрыПлатформы);

	Попытка
		Менеджер.КопироватьПользователейИзХранилища(
			АдресХранилищаИсточника,
			ПользовательИсточника,
			ПарольИсточника,
			ВосстановитьУдаленного);
		Лог.Информация("Копирование пользователей из хранилища конфигурации завершено");
	Исключение
		ОчиститьВременнуюБазу(КонтекстБазы);
		ВызватьИсключение;
	КонецПопытки;

	ОчиститьВременнуюБазу(КонтекстБазы);

КонецПроцедуры

Процедура СохранитьВерсиюХранилищаВФайл(Знач ПараметрыХранилища, Знач ПутьКФайлу,
	Знач ПараметрыПлатформы = Неопределено, Знач ПараметрыПодключения = Неопределено) Экспорт

	Лог.Информация("Выполняю выгрузку версии конфигурации из хранилища");

	КонтекстБазы = ПодготовитьБазу(ПараметрыПодключения, ПараметрыПлатформы);
	Менеджер = СоздатьМенеджерХранилища(КонтекстБазы.ПараметрыПодключения, ПараметрыХранилища, ПараметрыПлатформы);

	Попытка
		Менеджер.СохранитьВерсиюКонфигурацииВФайл(ПараметрыХранилища.Версия, ПутьКФайлу);
		Лог.Информация("Выгрузка конфигурации из хранилища завершена: %1", ПутьКФайлу);
	Исключение
		ОчиститьВременнуюБазу(КонтекстБазы);
		ВызватьИсключение;
	КонецПопытки;

	ОчиститьВременнуюБазу(КонтекстБазы);

КонецПроцедуры

Процедура ЗахватитьОбъектыВХранилище(Знач ПараметрыПодключения, Знач ПараметрыХранилища,
	Знач ПутьКФайлуСоСпискомОбъектов = "",
	Знач ПолучатьЗахваченныеОбъекты = Ложь,
	Знач ПараметрыПлатформы = Неопределено) Экспорт

	Лог.Информация("Выполняю захват объектов в хранилище");
	Менеджер = СоздатьМенеджерХранилища(ПараметрыПодключения, ПараметрыХранилища, ПараметрыПлатформы);

	Попытка
		Менеджер.ЗахватитьОбъектыВХранилище(ПутьКФайлуСоСпискомОбъектов, ПолучатьЗахваченныеОбъекты);
		Лог.Информация("Захват объектов завершен");
	Исключение
		Лог.Ошибка(Менеджер.ПолучитьВыводКоманды());
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Процедура ОтпуститьОбъектыВХранилище(Знач ПараметрыПодключения, Знач ПараметрыХранилища,
	Знач ПутьКФайлуСоСпискомОбъектов = "",
	Знач ИгнорироватьИзменения = Ложь,
	Знач ПараметрыПлатформы = Неопределено) Экспорт

	Лог.Информация("Отпускаю захваченные объекты в хранилище");
	Менеджер = СоздатьМенеджерХранилища(ПараметрыПодключения, ПараметрыХранилища, ПараметрыПлатформы);

	Попытка
		Менеджер.ОтменитьЗахватОбъектовВХранилище(ПутьКФайлуСоСпискомОбъектов, ИгнорироватьИзменения);
		Лог.Информация("Отмена захвата объектов завершена");
	Исключение
		Лог.Ошибка(Менеджер.ПолучитьВыводКоманды());
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Процедура ПоместитьИзмененияВХранилище(Знач ПараметрыПодключения, Знач ПараметрыХранилища,
	Знач ПутьКФайлуСоСпискомОбъектов = "",
	Знач Комментарий = "",
	Знач ОставитьОбъектыЗахваченными = Ложь,
	Знач ИгнорироватьУдаленные = Ложь,
	Знач ПараметрыПлатформы = Неопределено) Экспорт

	Лог.Информация("Выполняю помещение объектов в хранилище");
	Менеджер = СоздатьМенеджерХранилища(ПараметрыПодключения, ПараметрыХранилища, ПараметрыПлатформы);

	Попытка
		Менеджер.ПоместитьИзмененияОбъектовВХранилище(
			ПутьКФайлуСоСпискомОбъектов,
			Комментарий,
			ОставитьОбъектыЗахваченными,
			ИгнорироватьУдаленные);
		Лог.Информация("Помещение объектов завершено");
	Исключение
		Лог.Ошибка(Менеджер.ПолучитьВыводКоманды());
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьДвижок()

	Возврат Движки["ДвижокКонфигуратор"];

КонецФункции

Функция СоздатьМенеджерХранилища(Знач ПараметрыПодключения, Знач ПараметрыХранилища, Знач ПараметрыПлатформы)

	Движок = ПолучитьДвижок();
	Конфигуратор = Движок.НовыйКонфигуратор(ПараметрыПлатформы, ПараметрыПодключения);

	Менеджер = СоздатьЭкземплярМенеджера();
	Менеджер.УстановитьУправлениеКонфигуратором(Конфигуратор);

	Если ПараметрыХранилища <> Неопределено Тогда
		Менеджер.УстановитьПутьКХранилищу(ПараметрыХранилища.АдресХранилища);
		Менеджер.УстановитьПараметрыАвторизации(ПараметрыХранилища.Пользователь, ПараметрыХранилища.Пароль);
	КонецЕсли;

	Возврат Менеджер;

КонецФункции

Функция ПодготовитьБазу(ПараметрыПодключения, ПараметрыПлатформы)

	Результат = Новый Структура("ПараметрыПодключения, Временная", ПараметрыПодключения, Ложь);

	Если ПараметрыПодключения <> Неопределено
		И ЗначениеЗаполнено(ПараметрыПодключения.СтрокаПодключения) Тогда
		Возврат Результат;
	КонецЕсли;

	Движок = ПолучитьДвижок();
	Лог.Предупреждение("Не определена БД, создаем временную файловую ИБ");
	Результат.ПараметрыПодключения = Движок.СоздатьВременнуюБазу(ПараметрыПлатформы);
	Результат.Временная = Истина;
	Лог.Отладка("Создана временная ИБ: %1", Результат.ПараметрыПодключения.КаталогБазы);

	Возврат Результат;

КонецФункции

Функция СоздатьЭкземплярМенеджера()
	Если _ФабрикаМенеджераХранилища <> Неопределено Тогда
		Возврат _ФабрикаМенеджераХранилища.Создать();
	КонецЕсли;
	Возврат Новый МенеджерХранилищаКонфигурации();
КонецФункции

Процедура ОчиститьВременнуюБазу(КонтекстБазы)

	Если НЕ КонтекстБазы.Временная Тогда
		Возврат;
	КонецЕсли;

	Лог.Отладка("Удаление временной ИБ: %1", КонтекстБазы.ПараметрыПодключения.КаталогБазы);
	Попытка
		УдалитьФайлы(КонтекстБазы.ПараметрыПодключения.КаталогБазы);
	Исключение
		Лог.Предупреждение("Не удалось удалить временную ИБ: %1", ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

#КонецОбласти
