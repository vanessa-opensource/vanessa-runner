// BSLLS:MissingVariablesDescription-off Поля autumn (&Лог/&Пластилин)
// BSLLS:MissingParameterDescription-off Внутренние служебные методы.
// BSLLS:MissingReturnedValueDescription-off Внутренние служебные методы.
// BSLLS:NumberOfOptionalParams-off
// BSLLS:MissingParameterDescription-off Внутренний проброс ПараметрыИсходников.
// BSLLS:MissingTemporaryFileDeletion-off Временный XML удаляется через ФайловыеОперации.УдалитьБезопасно.
// Сервис операций с внешними обработками (EPF) и внешними отчётами (ERF).
// Фасад: поиск XML-исходников, валидация, компиляция и разборка EPF/ERF.
// Тип объекта определяется по корневому тегу XML (ExternalDataProcessor/ExternalReport)
// и задаёт расширение результата сборки: .epf для обработок, .erf для отчётов.
// Оркестрирует создание/очистку временных баз и вызовы ДвижокКонфигуратор.
// EPF/ERF-операции всегда выполняются через конфигуратор.
// Флаг ibcmd влияет только на способ создания временной базы.

&Лог("vrunner")
Перем Лог;

&Пластилин
Перем ФайловыеОперации;

&Пластилин
Перем СервисВременнойБазы;

&Пластилин
Перем СервисEDT;

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Собрать внешнюю обработку или отчёт из XML-исходников.
//
// Параметры:
//   КаталогИсходников    - Строка - каталог с XML-исходниками обработки или отчёта
//   КаталогВыгрузки      - Строка - каталог для EPF/ERF-файла (по умолчанию рядом с XML)
//   ИспользоватьIbcmd    - Булево - использовать ibcmd для создания временной базы
//   ПараметрыПлатформы   - Структура, Неопределено - версия платформы и путь к ней
//   ПараметрыПодключения - Структура, Неопределено - параметры ИБ (для готовой базы)
//
Процедура СобратьОбработку(Знач КаталогИсходников, Знач КаталогВыгрузки = "",
	Знач ИспользоватьIbcmd = Ложь, Знач ПараметрыПлатформы = Неопределено,
	Знач ПараметрыПодключения = Неопределено, Знач ПараметрыИсходников = Неопределено) Экспорт

	Если СервисEDT.ЭтоПроектВнешнихОбъектовEDT(КаталогИсходников, ПараметрыИсходников) Тогда
		СобратьОбработкиИзEDT(КаталогИсходников, КаталогВыгрузки, ИспользоватьIbcmd,
			ПараметрыПлатформы, ПараметрыПодключения, ПараметрыИсходников);
		Возврат;
	КонецЕсли;

	ИскатьРекурсивно = Ложь;
	ВнешниеОбъекты = НайтиВнешниеОбъекты(КаталогИсходников, ИскатьРекурсивно);
	Если ВнешниеОбъекты.Количество() = 0 Тогда
		ВызватьИсключение СтрШаблон(
			"В каталоге %1 не найден XML-файл внешней обработки или отчёта (ExternalDataProcessor/ExternalReport)",
			КаталогИсходников);
	КонецЕсли;

	ВнешнийОбъект = ВнешниеОбъекты[0];
	ФайлXml = ВнешнийОбъект.ФайлXml;
	ИмяОбработки = ФайлXml.ИмяБезРасширения;
	ПутьКФайлуEpf = ОпределитьПутьВыгрузкиEpf(
		КаталогИсходников, КаталогВыгрузки, ИмяОбработки, ВнешнийОбъект.Расширение);

	Лог.Информация("Сборка обработки: %1 → %2", ФайлXml.ПолноеИмя, ПутьКФайлуEpf);

	КонтекстБазы = ПодготовитьБазу(ИспользоватьIbcmd, ПараметрыПодключения, ПараметрыПлатформы);

	Попытка
		Движок = СервисВременнойБазы.ДвижокКонфигуратор();
		Движок.СобратьВнешнююОбработкуИзФайлов(
			КонтекстБазы.ПараметрыПодключения, ФайлXml.ПолноеИмя, ПутьКФайлуEpf, ПараметрыПлатформы);
	Исключение
		СервисВременнойБазы.Очистить(КонтекстБазы);
		ВызватьИсключение;
	КонецПопытки;

	СервисВременнойБазы.Очистить(КонтекстБазы);
	Лог.Информация("Обработка собрана: %1", ПутьКФайлуEpf);

КонецПроцедуры

// Собрать все обработки и отчёты из каталога (рекурсивный поиск).
//
// Параметры:
//   КаталогПоиска        - Строка - каталог для рекурсивного поиска XML-исходников
//   КаталогВыгрузки      - Строка - каталог для EPF/ERF-файлов (по умолчанию рядом с XML)
//   ИспользоватьIbcmd    - Булево - использовать ibcmd для создания временной базы
//   ПараметрыПлатформы   - Структура, Неопределено - версия платформы и путь к ней
//   ПараметрыПодключения - Структура, Неопределено - параметры ИБ (для готовой базы)
//
Процедура СобратьОбработкиРекурсивно(Знач КаталогПоиска, Знач КаталогВыгрузки = "",
	Знач ИспользоватьIbcmd = Ложь, Знач ПараметрыПлатформы = Неопределено,
	Знач ПараметрыПодключения = Неопределено, Знач ПараметрыИсходников = Неопределено) Экспорт

	Если СервисEDT.ЭтоПроектВнешнихОбъектовEDT(КаталогПоиска, ПараметрыИсходников) Тогда
		СобратьОбработкиИзEDT(КаталогПоиска, КаталогВыгрузки, ИспользоватьIbcmd,
			ПараметрыПлатформы, ПараметрыПодключения, ПараметрыИсходников);
		Возврат;
	КонецЕсли;

	ИскатьРекурсивно = Истина;
	ВнешниеОбъекты = НайтиВнешниеОбъекты(КаталогПоиска, ИскатьРекурсивно);

	Если ВнешниеОбъекты.Количество() = 0 Тогда
		ВызватьИсключение СтрШаблон(
			"В каталоге %1 не найдено XML-файлов внешних обработок и отчётов"
			+ " (ExternalDataProcessor/ExternalReport)",
			КаталогПоиска);
	КонецЕсли;

	Лог.Информация("Найдено обработок для сборки: %1", ВнешниеОбъекты.Количество());

	КонтекстБазы = ПодготовитьБазу(ИспользоватьIbcmd, ПараметрыПодключения, ПараметрыПлатформы);

	Попытка
		Движок = СервисВременнойБазы.ДвижокКонфигуратор();
		Для Каждого ВнешнийОбъект Из ВнешниеОбъекты Цикл
			ФайлXml = ВнешнийОбъект.ФайлXml;
			ИмяОбработки = ФайлXml.ИмяБезРасширения;
			ПутьКФайлуEpf = ОпределитьПутьВыгрузкиEpf(
				ФайлXml.Путь, КаталогВыгрузки, ИмяОбработки, ВнешнийОбъект.Расширение);
			Лог.Информация("Сборка обработки: %1 → %2", ФайлXml.ПолноеИмя, ПутьКФайлуEpf);
			Движок.СобратьВнешнююОбработкуИзФайлов(
				КонтекстБазы.ПараметрыПодключения, ФайлXml.ПолноеИмя, ПутьКФайлуEpf, ПараметрыПлатформы);
		КонецЦикла;
	Исключение
		СервисВременнойБазы.Очистить(КонтекстБазы);
		ВызватьИсключение;
	КонецПопытки;

	СервисВременнойБазы.Очистить(КонтекстБазы);
	Лог.Информация("Сборка завершена");

КонецПроцедуры

// Разобрать EPF/ERF-файл в XML-исходники.
//
// Параметры:
//   ПутьКФайлуEpf        - Строка - путь к EPF/ERF-файлу
//   КаталогВыгрузки      - Строка - каталог для XML-исходников (по умолчанию рядом с EPF)
//   ИспользоватьIbcmd    - Булево - использовать ibcmd для создания временной базы
//   ПараметрыПлатформы   - Структура, Неопределено - версия платформы и путь к ней
//   ПараметрыПодключения - Структура, Неопределено - параметры ИБ (для готовой базы)
//
Процедура РазобратьОбработку(Знач ПутьКФайлуEpf, Знач КаталогВыгрузки = "",
	Знач ИспользоватьIbcmd = Ложь, Знач ПараметрыПлатформы = Неопределено,
	Знач ПараметрыПодключения = Неопределено, Знач ПараметрыИсходников = Неопределено) Экспорт

	Файл = Новый Файл(ПутьКФайлуEpf);
	Если НЕ Файл.Существует() Тогда
		ВызватьИсключение СтрШаблон("Файл обработки не найден: %1", ПутьКФайлуEpf);
	КонецЕсли;

	КонтекстВыгрузки = СервисEDT.НачатьВыгрузкуВнешнихОбъектов(КаталогВыгрузки, ПараметрыИсходников);
	Попытка
		КаталогНазначения = ОпределитьКаталогРазборки(Файл, КонтекстВыгрузки.Путь);
		Лог.Информация("Разборка обработки: %1 → %2", ПутьКФайлуEpf, КаталогНазначения);

		КонтекстБазы = ПодготовитьБазу(ИспользоватьIbcmd, ПараметрыПодключения, ПараметрыПлатформы);
		Попытка
			Движок = СервисВременнойБазы.ДвижокКонфигуратор();
			Движок.РазобратьВнешнююОбработкуВФайлы(
				КонтекстБазы.ПараметрыПодключения, ПутьКФайлуEpf, КаталогНазначения, ПараметрыПлатформы);
		Исключение
			СервисВременнойБазы.Очистить(КонтекстБазы);
			ВызватьИсключение;
		КонецПопытки;
		СервисВременнойБазы.Очистить(КонтекстБазы);

		СервисEDT.ЗавершитьВыгрузкуВнешнихОбъектов(КонтекстВыгрузки);
	Исключение
		СервисEDT.ПрерватьВыгрузку(КонтекстВыгрузки);
		ВызватьИсключение;
	КонецПопытки;

	Лог.Информация("Обработка разобрана: %1", КонтекстВыгрузки.ЦелевойКаталог);

КонецПроцедуры

// Разобрать все EPF/ERF-файлы из каталога.
//
// Параметры:
//   КаталогПоиска        - Строка - каталог поиска EPF/ERF-файлов
//   Рекурсивно           - Булево - выполнять поиск рекурсивно
//   КаталогВыгрузки      - Строка - каталог для XML-исходников (по умолчанию рядом с EPF)
//   ИспользоватьIbcmd    - Булево - использовать ibcmd для создания временной базы
//   ПараметрыПлатформы   - Структура, Неопределено - версия платформы и путь к ней
//   ПараметрыПодключения - Структура, Неопределено - параметры ИБ (для готовой базы)
//
Процедура РазобратьОбработкиИзКаталога(Знач КаталогПоиска, Знач Рекурсивно = Ложь, Знач КаталогВыгрузки = "",
	Знач ИспользоватьIbcmd = Ложь, Знач ПараметрыПлатформы = Неопределено,
	Знач ПараметрыПодключения = Неопределено, Знач ПараметрыИсходников = Неопределено) Экспорт

	ФайлыEpf = НайтиФайлыВнешнихОбъектов(КаталогПоиска, Рекурсивно);

	Если ФайлыEpf.Количество() = 0 Тогда
		ВызватьИсключение СтрШаблон("В каталоге %1 не найдено файлов обработок и отчётов (*.epf, *.erf)",
			КаталогПоиска);
	КонецЕсли;

	Лог.Информация("Найдено обработок для разборки: %1", ФайлыEpf.Количество());

	КонтекстВыгрузки = СервисEDT.НачатьВыгрузкуВнешнихОбъектов(КаталогВыгрузки, ПараметрыИсходников);
	Попытка
		КонтекстБазы = ПодготовитьБазу(ИспользоватьIbcmd, ПараметрыПодключения, ПараметрыПлатформы);
		Попытка
			Движок = СервисВременнойБазы.ДвижокКонфигуратор();
			Для Каждого ФайлEpf Из ФайлыEpf Цикл
				КаталогНазначения = ОпределитьКаталогРазборки(ФайлEpf, КонтекстВыгрузки.Путь);
				Лог.Информация("Разборка обработки: %1 → %2", ФайлEpf.ПолноеИмя, КаталогНазначения);
				Движок.РазобратьВнешнююОбработкуВФайлы(
					КонтекстБазы.ПараметрыПодключения, ФайлEpf.ПолноеИмя, КаталогНазначения, ПараметрыПлатформы);
			КонецЦикла;
		Исключение
			СервисВременнойБазы.Очистить(КонтекстБазы);
			ВызватьИсключение;
		КонецПопытки;
		СервисВременнойБазы.Очистить(КонтекстБазы);

		СервисEDT.ЗавершитьВыгрузкуВнешнихОбъектов(КонтекстВыгрузки);
	Исключение
		СервисEDT.ПрерватьВыгрузку(КонтекстВыгрузки);
		ВызватьИсключение;
	КонецПопытки;

	Лог.Информация("Разборка завершена");

КонецПроцедуры

// Конвертировать внешние отчёты и обработки между форматами 1С:EDT и XML Конфигуратора.
// Направление определяется автоматически по каталогу источника (штатными export/import
// 1cedtcli, без сборки .epf/.erf и без временной информационной базы):
//   EDT-проект внешних объектов → XML-дампы (ExternalDataProcessors/ и ExternalReports/);
//   XML-дампы                   → EDT-проект внешних объектов.
//
// Параметры:
//   КаталогИсточника  - Строка - каталог источника (EDT-проект или XML-дампы)
//   КаталогНазначения - Строка - каталог результата в противоположном формате
//   ПараметрыEDT      - Структура, Неопределено - версия EDT, workspace, таймаут и JVM-аргументы
//
// Возвращаемое значение:
//   Структура - {ИсходныйФормат, ЦелевойФормат, Количество}
//
Функция КонвертироватьПроектEDT(Знач КаталогИсточника, Знач КаталогНазначения, Знач ПараметрыEDT = Неопределено) Экспорт

	Если НЕ ЗначениеЗаполнено(КаталогНазначения) Тогда
		ВызватьИсключение "Не указан каталог назначения";
	КонецЕсли;

	Результат = СервисEDT.КонвертироватьВнешниеОбъекты(КаталогИсточника, КаталогНазначения, ПараметрыEDT);

	Лог.Информация("Конвертация внешних объектов завершена (%1 → %2), объектов: %3",
		Результат.ИсходныйФормат, Результат.ЦелевойФормат, Результат.Количество);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Собрать внешние обработки и отчёты из EDT-проекта: выгрузить проект в XML через 1cedtcli
// (export), затем собрать каждый объект в .epf/.erf через одну временную базу.
Процедура СобратьОбработкиИзEDT(Знач КаталогEDT, Знач КаталогВыгрузки, Знач ИспользоватьIbcmd,
	Знач ПараметрыПлатформы, Знач ПараметрыПодключения, Знач ПараметрыИсходников)

	КаталогРезультата = ?(ЗначениеЗаполнено(КаталогВыгрузки), КаталогВыгрузки, КаталогEDT);
	ВременныйXML = ПолучитьИмяВременногоФайла();
	СоздатьКаталог(ВременныйXML);

	Попытка
		Файлы = СервисEDT.ЭкспортироватьВнешниеОбъекты(КаталогEDT, ВременныйXML, ПараметрыИсходников);
		Лог.Информация("Найдено обработок для сборки: %1", Файлы.Количество());
		КонтекстБазы = ПодготовитьБазу(ИспользоватьIbcmd, ПараметрыПодключения, ПараметрыПлатформы);
		Попытка
			Движок = СервисВременнойБазы.ДвижокКонфигуратор();
			Для Каждого ФайлXml Из Файлы Цикл
				ИмяОбработки = ФайлXml.ИмяБезРасширения;
				Расширение = СервисEDT.ТипВыгруженногоВнешнегоОбъекта(ФайлXml.ПолноеИмя);
				ПутьКФайлуEpf = ОпределитьПутьВыгрузкиEpf(ФайлXml.Путь, КаталогРезультата, ИмяОбработки, Расширение);
				Лог.Информация("Сборка обработки: %1 → %2", ФайлXml.ПолноеИмя, ПутьКФайлуEpf);
				Движок.СобратьВнешнююОбработкуИзФайлов(
					КонтекстБазы.ПараметрыПодключения, ФайлXml.ПолноеИмя, ПутьКФайлуEpf, ПараметрыПлатформы);
			КонецЦикла;
		Исключение
			СервисВременнойБазы.Очистить(КонтекстБазы);
			ВызватьИсключение;
		КонецПопытки;
		СервисВременнойБазы.Очистить(КонтекстБазы);
	Исключение
		ФайловыеОперации.УдалитьБезопасно(ВременныйXML);
		ВызватьИсключение;
	КонецПопытки;
	ФайловыеОперации.УдалитьБезопасно(ВременныйXML);
	Лог.Информация("Сборка завершена");

КонецПроцедуры

// Временная база создаётся движком по флагу ibcmd; сама сборка/разборка всегда идёт конфигуратором.
Функция ПодготовитьБазу(Знач ИспользоватьIbcmd, Знач ПараметрыПодключения, Знач ПараметрыПлатформы)

	Движок = СервисВременнойБазы.ВыбратьДвижок(ИспользоватьIbcmd);
	Возврат СервисВременнойБазы.Подготовить(Движок, ПараметрыПодключения, ПараметрыПлатформы);

КонецФункции

// XML-исходники внешних объектов в каталоге: массив структур {ФайлXml (Файл), Расширение ("epf"/"erf")}.
Функция НайтиВнешниеОбъекты(Знач КаталогПоиска, Знач Рекурсивно)

	Результат = Новый Массив;

	Для Каждого ФайлXml Из НайтиФайлы(КаталогПоиска, "*.xml", Рекурсивно) Цикл
		Расширение = СервисEDT.ТипВнешнегоОбъекта(ФайлXml.ПолноеИмя);
		Если НЕ ЗначениеЗаполнено(Расширение) Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(Новый Структура("ФайлXml, Расширение", ФайлXml, Расширение));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Собранные EPF/ERF-файлы в каталоге: массив Файл.
Функция НайтиФайлыВнешнихОбъектов(Знач КаталогПоиска, Знач Рекурсивно)

	Результат = Новый Массив;

	Для Каждого Маска Из СтрРазделить("*.epf,*.erf", ",") Цикл
		Для Каждого Файл Из НайтиФайлы(КаталогПоиска, Маска, Рекурсивно) Цикл
			Результат.Добавить(Файл);
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Путь к выходному EPF/ERF-файлу: в каталоге выгрузки, если он задан, иначе рядом с каталогом исходников.
Функция ОпределитьПутьВыгрузкиEpf(Знач КаталогИсходников, Знач КаталогВыгрузки, Знач ИмяОбработки, Знач Расширение)

	ИмяФайла = ИмяОбработки + "." + Расширение;

	Если ЗначениеЗаполнено(КаталогВыгрузки) Тогда
		ФайловыеОперации.ОбеспечитьКаталог(КаталогВыгрузки);
		Возврат ОбъединитьПути(КаталогВыгрузки, ИмяФайла);
	КонецЕсли;

	ФайлКаталога = Новый Файл(КаталогИсходников);
	Возврат ОбъединитьПути(ФайлКаталога.Путь, ИмяФайла);

КонецФункции

// Каталог разборки EPF/ERF: в каталоге выгрузки, если он задан, иначе рядом с файлом.
Функция ОпределитьКаталогРазборки(Знач ФайлEpf, Знач КаталогВыгрузки)

	ИмяКаталога = ФайлEpf.ИмяБезРасширения;

	Если ЗначениеЗаполнено(КаталогВыгрузки) Тогда
		ФайловыеОперации.ОбеспечитьКаталог(КаталогВыгрузки);
		Возврат ОбъединитьПути(КаталогВыгрузки, ИмяКаталога);
	КонецЕсли;

	Возврат ОбъединитьПути(ФайлEpf.Путь, ИмяКаталога);

КонецФункции

#КонецОбласти
