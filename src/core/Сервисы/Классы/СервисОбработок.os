// BSLLS:MissingVariablesDescription-off Поля autumn
// BSLLS:NumberOfOptionalParams-off (&Лог/&Пластилин/&Напильник) и внутреннее состояние сервиса.
// BSLLS:MissingParameterDescription-off Внутренний проброс ПараметрыИсходников.
// Сервис операций с внешними обработками (EPF).
// Фасад: поиск XML-исходников, валидация, компиляция и разборка EPF.
// Оркестрирует создание/очистку временных баз и вызовы ДвижокКонфигуратор.
// EPF-операции всегда выполняются через конфигуратор.
// Флаг ibcmd влияет только на способ создания временной базы.

&Лог("vrunner")
Перем Лог;

&Пластилин(Значение = "ДвижокПлатформы", Тип = "Соответствие")
Перем Движки;

&Пластилин
Перем СервисEDT;

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Собрать внешнюю обработку из XML-исходников.
//
// Параметры:
//   КаталогИсходников    - Строка - каталог с XML-исходниками обработки
//   КаталогВыгрузки      - Строка - каталог для EPF-файла (по умолчанию рядом с XML)
//   ИспользоватьIbcmd    - Булево - использовать ibcmd для создания временной базы
//   ПараметрыПлатформы   - Структура, Неопределено - версия платформы и путь к ней
//   ПараметрыПодключения - Структура, Неопределено - параметры ИБ (для готовой базы)
//
Процедура СобратьОбработку(Знач КаталогИсходников, Знач КаталогВыгрузки = "",
	Знач ИспользоватьIbcmd = Ложь, Знач ПараметрыПлатформы = Неопределено,
	Знач ПараметрыПодключения = Неопределено, Знач ПараметрыИсходников = Неопределено) Экспорт

	ОтклонитьФорматEDT(КаталогИсходников, ПараметрыИсходников);

	ФайлXml = НайтиФайлОбработки(КаталогИсходников);
	Если ФайлXml = Неопределено Тогда
		ВызватьИсключение СтрШаблон("В каталоге %1 не найден XML-файл внешней обработки (ExternalDataProcessor)",
			КаталогИсходников);
	КонецЕсли;

	ИмяОбработки = ФайлXml.ИмяБезРасширения;
	ПутьКФайлуEpf = ОпределитьПутьВыгрузкиEpf(КаталогИсходников, КаталогВыгрузки, ИмяОбработки);

	Лог.Информация("Сборка обработки: %1 → %2", ФайлXml.ПолноеИмя, ПутьКФайлуEpf);

	КонтекстБазы = ПодготовитьБазу(ИспользоватьIbcmd, ПараметрыПодключения, ПараметрыПлатформы);

	Попытка
		Движок = Движки["ДвижокКонфигуратор"];
		Движок.СобратьВнешнююОбработкуИзФайлов(
			КонтекстБазы.ПараметрыПодключения, ФайлXml.ПолноеИмя, ПутьКФайлуEpf, ПараметрыПлатформы);
	Исключение
		ОчиститьВременнуюБазу(КонтекстБазы);
		ВызватьИсключение;
	КонецПопытки;

	ОчиститьВременнуюБазу(КонтекстБазы);
	Лог.Информация("Обработка собрана: %1", ПутьКФайлуEpf);

КонецПроцедуры

// Собрать все обработки из каталога (рекурсивный поиск).
//
// Параметры:
//   КаталогПоиска        - Строка - каталог для рекурсивного поиска XML-исходников
//   КаталогВыгрузки      - Строка - каталог для EPF-файлов (по умолчанию рядом с XML)
//   ИспользоватьIbcmd    - Булево - использовать ibcmd для создания временной базы
//   ПараметрыПлатформы   - Структура, Неопределено - версия платформы и путь к ней
//   ПараметрыПодключения - Структура, Неопределено - параметры ИБ (для готовой базы)
//
Процедура СобратьОбработкиРекурсивно(Знач КаталогПоиска, Знач КаталогВыгрузки = "",
	Знач ИспользоватьIbcmd = Ложь, Знач ПараметрыПлатформы = Неопределено,
	Знач ПараметрыПодключения = Неопределено, Знач ПараметрыИсходников = Неопределено) Экспорт

	ОтклонитьФорматEDT(КаталогПоиска, ПараметрыИсходников);

	КаталогиОбработок = НайтиКаталогиОбработокРекурсивно(КаталогПоиска);

	Если КаталогиОбработок.Количество() = 0 Тогда
		ВызватьИсключение СтрШаблон("В каталоге %1 не найдено XML-файлов внешних обработок (ExternalDataProcessor)",
			КаталогПоиска);
	КонецЕсли;

	Лог.Информация("Найдено обработок для сборки: %1", КаталогиОбработок.Количество());

	КонтекстБазы = ПодготовитьБазу(ИспользоватьIbcmd, ПараметрыПодключения, ПараметрыПлатформы);

	Попытка
		Движок = Движки["ДвижокКонфигуратор"];
		Для Каждого КаталогОбработки Из КаталогиОбработок Цикл
			ФайлXml = НайтиФайлОбработки(КаталогОбработки);
			ИмяОбработки = ФайлXml.ИмяБезРасширения;
			ПутьКФайлуEpf = ОпределитьПутьВыгрузкиEpf(КаталогОбработки, КаталогВыгрузки, ИмяОбработки);
			Лог.Информация("Сборка обработки: %1 → %2", ФайлXml.ПолноеИмя, ПутьКФайлуEpf);
			Движок.СобратьВнешнююОбработкуИзФайлов(
				КонтекстБазы.ПараметрыПодключения, ФайлXml.ПолноеИмя, ПутьКФайлуEpf, ПараметрыПлатформы);
		КонецЦикла;
	Исключение
		ОчиститьВременнуюБазу(КонтекстБазы);
		ВызватьИсключение;
	КонецПопытки;

	ОчиститьВременнуюБазу(КонтекстБазы);
	Лог.Информация("Сборка завершена");

КонецПроцедуры

// Разобрать EPF-файл в XML-исходники.
//
// Параметры:
//   ПутьКФайлуEpf        - Строка - путь к EPF-файлу
//   КаталогВыгрузки      - Строка - каталог для XML-исходников (по умолчанию рядом с EPF)
//   ИспользоватьIbcmd    - Булево - использовать ibcmd для создания временной базы
//   ПараметрыПлатформы   - Структура, Неопределено - версия платформы и путь к ней
//   ПараметрыПодключения - Структура, Неопределено - параметры ИБ (для готовой базы)
//
Процедура РазобратьОбработку(Знач ПутьКФайлуEpf, Знач КаталогВыгрузки = "",
	Знач ИспользоватьIbcmd = Ложь, Знач ПараметрыПлатформы = Неопределено,
	Знач ПараметрыПодключения = Неопределено, Знач ПараметрыИсходников = Неопределено) Экспорт

	ОтклонитьФорматEDT(КаталогВыгрузки, ПараметрыИсходников);

	Файл = Новый Файл(ПутьКФайлуEpf);
	Если НЕ Файл.Существует() Тогда
		ВызватьИсключение СтрШаблон("Файл обработки не найден: %1", ПутьКФайлуEpf);
	КонецЕсли;

	КаталогНазначения = ОпределитьКаталогРазборки(Файл, КаталогВыгрузки);

	Лог.Информация("Разборка обработки: %1 → %2", ПутьКФайлуEpf, КаталогНазначения);

	КонтекстБазы = ПодготовитьБазу(ИспользоватьIbcmd, ПараметрыПодключения, ПараметрыПлатформы);

	Попытка
		Движок = Движки["ДвижокКонфигуратор"];
		Движок.РазобратьВнешнююОбработкуВФайлы(
			КонтекстБазы.ПараметрыПодключения, ПутьКФайлуEpf, КаталогНазначения, ПараметрыПлатформы);
	Исключение
		ОчиститьВременнуюБазу(КонтекстБазы);
		ВызватьИсключение;
	КонецПопытки;

	ОчиститьВременнуюБазу(КонтекстБазы);
	Лог.Информация("Обработка разобрана: %1", КаталогНазначения);

КонецПроцедуры

// Разобрать все EPF-файлы из каталога.
//
// Параметры:
//   КаталогПоиска        - Строка - каталог поиска EPF-файлов
//   Рекурсивно           - Булево - выполнять поиск рекурсивно
//   КаталогВыгрузки      - Строка - каталог для XML-исходников (по умолчанию рядом с EPF)
//   ИспользоватьIbcmd    - Булево - использовать ibcmd для создания временной базы
//   ПараметрыПлатформы   - Структура, Неопределено - версия платформы и путь к ней
//   ПараметрыПодключения - Структура, Неопределено - параметры ИБ (для готовой базы)
//
Процедура РазобратьОбработкиИзКаталога(Знач КаталогПоиска, Знач Рекурсивно = Ложь, Знач КаталогВыгрузки = "",
	Знач ИспользоватьIbcmd = Ложь, Знач ПараметрыПлатформы = Неопределено,
	Знач ПараметрыПодключения = Неопределено, Знач ПараметрыИсходников = Неопределено) Экспорт

	ОтклонитьФорматEDT(КаталогВыгрузки, ПараметрыИсходников);

	ФайлыEpf = НайтиФайлы(КаталогПоиска, "*.epf", Рекурсивно);

	Если ФайлыEpf.Количество() = 0 Тогда
		ВызватьИсключение СтрШаблон("В каталоге %1 не найдено файлов обработок (*.epf)", КаталогПоиска);
	КонецЕсли;

	Лог.Информация("Найдено обработок для разборки: %1", ФайлыEpf.Количество());

	КонтекстБазы = ПодготовитьБазу(ИспользоватьIbcmd, ПараметрыПодключения, ПараметрыПлатформы);

	Попытка
		Движок = Движки["ДвижокКонфигуратор"];
		Для Каждого ФайлEpf Из ФайлыEpf Цикл
			КаталогНазначения = ОпределитьКаталогРазборки(ФайлEpf, КаталогВыгрузки);
			Лог.Информация("Разборка обработки: %1 → %2", ФайлEpf.ПолноеИмя, КаталогНазначения);
			Движок.РазобратьВнешнююОбработкуВФайлы(
				КонтекстБазы.ПараметрыПодключения, ФайлEpf.ПолноеИмя, КаталогНазначения, ПараметрыПлатформы);
		КонецЦикла;
	Исключение
		ОчиститьВременнуюБазу(КонтекстБазы);
		ВызватьИсключение;
	КонецПопытки;

	ОчиститьВременнуюБазу(КонтекстБазы);
	Лог.Информация("Разборка завершена");

КонецПроцедуры

// Конвертировать EDT-проект внешних отчётов и обработок в XML-исходники Конфигуратора.
// СервисEDT собирает проект в .epf/.erf, после чего все бинарные файлы разбираются
// через один экземпляр временной информационной базы.
//
// Параметры:
//   КаталогEDT           - Строка - каталог EDT-проекта
//   КаталогВыгрузки      - Строка - каталог для XML-исходников
//   ИспользоватьIbcmd    - Булево - использовать ibcmd для создания временной базы
//   ПараметрыПлатформы   - Структура, Неопределено - версия платформы и путь к ней
//   ПараметрыПодключения - Структура, Неопределено - параметры готовой ИБ
//   ПараметрыEDT         - Структура, Неопределено - версия EDT, workspace, таймаут и JVM-аргументы
//
// Возвращаемое значение:
//   Число - количество сконвертированных .epf/.erf
//
Функция КонвертироватьПроектEDT(Знач КаталогEDT, Знач КаталогВыгрузки,
	Знач ИспользоватьIbcmd = Ложь, Знач ПараметрыПлатформы = Неопределено,
	Знач ПараметрыПодключения = Неопределено, Знач ПараметрыEDT = Неопределено) Экспорт

	Если НЕ ЗначениеЗаполнено(КаталогВыгрузки) Тогда
		ВызватьИсключение "Не указан каталог выгрузки XML-исходников";
	КонецЕсли;

	Файлы = СервисEDT.СобратьВнешниеОбъекты(КаталогEDT, ПараметрыEDT);
	ПроверитьУникальностьИменВнешнихОбъектов(Файлы);
	ОбеспечитьКаталогВыгрузки(КаталогВыгрузки);

	Лог.Информация("Конвертация EDT-проекта внешних объектов: %1 → %2", КаталогEDT, КаталогВыгрузки);
	КонтекстБазы = ПодготовитьБазу(ИспользоватьIbcmd, ПараметрыПодключения, ПараметрыПлатформы);

	Попытка
		Движок = Движки["ДвижокКонфигуратор"];
		Для Каждого ФайлВнешнегоОбъекта Из Файлы Цикл
			КаталогНазначения = ОпределитьКаталогРазборки(ФайлВнешнегоОбъекта, КаталогВыгрузки);
			Лог.Информация("Разборка внешнего объекта: %1 → %2",
				ФайлВнешнегоОбъекта.ПолноеИмя, КаталогНазначения);
			Движок.РазобратьВнешнююОбработкуВФайлы(
				КонтекстБазы.ПараметрыПодключения, ФайлВнешнегоОбъекта.ПолноеИмя,
				КаталогНазначения, ПараметрыПлатформы);
		КонецЦикла;
	Исключение
		ОчиститьВременнуюБазу(КонтекстБазы);
		ВызватьИсключение;
	КонецПопытки;

	ОчиститьВременнуюБазу(КонтекстБазы);
	Лог.Информация("Конвертация EDT-проекта завершена, объектов: %1", Файлы.Количество());
	Возврат Файлы.Количество();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Отклонить операцию для исходников в формате EDT: внешние обработки (epf) не являются
// EDT-проектом, поэтому формат EDT для них не поддерживается.
//
// Параметры:
//   Путь                - Строка    - каталог исходников/выгрузки для автоопределения формата
//   ПараметрыИсходников - Структура - {Формат, ...}; форсированный формат имеет приоритет
//
Процедура ОтклонитьФорматEDT(Знач Путь, Знач ПараметрыИсходников)

	Формат = "";
	Если ПараметрыИсходников <> Неопределено Тогда
		ПараметрыИсходников.Свойство("Формат", Формат);
	КонецЕсли;
	Формат = НРег(СокрЛП(Строка(?(Формат = Неопределено, "", Формат))));

	Если Формат = "xml" Тогда
		Возврат;
	КонецЕсли;

	Если Формат = "edt"
		ИЛИ (ЗначениеЗаполнено(Путь) И СервисEDT.ОпределитьФорматИсточника(Путь) = "edt") Тогда
		ВызватьИсключение
			"Формат исходников EDT не поддерживается для внешних обработок (epf)."
			+ " Для конвертации EDT-проекта используйте команду epf convert.";
	КонецЕсли;

КонецПроцедуры

// Проверить, что каждому бинарному объекту соответствует отдельный каталог выгрузки.
// Два файла с одинаковым именем без расширения привели бы к смешиванию XML-исходников.
Процедура ПроверитьУникальностьИменВнешнихОбъектов(Знач Файлы)

	Имена = Новый Соответствие;
	Для Каждого ФайлВнешнегоОбъекта Из Файлы Цикл
		Ключ = НРег(ФайлВнешнегоОбъекта.ИмяБезРасширения);
		ПредыдущийПуть = Имена.Получить(Ключ);
		Если ПредыдущийПуть <> Неопределено Тогда
			ВызватьИсключение СтрШаблон(
				"EDT создала несколько внешних объектов с именем %1: %2 и %3."
				+ " Невозможно однозначно выбрать каталог XML-выгрузки.",
				ФайлВнешнегоОбъекта.ИмяБезРасширения, ПредыдущийПуть, ФайлВнешнегоОбъекта.ПолноеИмя);
		КонецЕсли;
		Имена.Вставить(Ключ, ФайлВнешнегоОбъекта.ПолноеИмя);
	КонецЦикла;

КонецПроцедуры

Процедура ОбеспечитьКаталогВыгрузки(Знач КаталогВыгрузки)

	ФайлКаталога = Новый Файл(КаталогВыгрузки);
	Если ФайлКаталога.Существует() Тогда
		Если НЕ ФайлКаталога.ЭтоКаталог() Тогда
			ВызватьИсключение СтрШаблон("Путь выгрузки не является каталогом: %1", КаталогВыгрузки);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	СоздатьКаталог(КаталогВыгрузки);

КонецПроцедуры

Функция ПодготовитьБазу(ИспользоватьIbcmd, ПараметрыПодключения, ПараметрыПлатформы)

	Результат = Новый Структура("ПараметрыПодключения, Временная", ПараметрыПодключения, Ложь);

	Если ПараметрыПодключения <> Неопределено
		И ЗначениеЗаполнено(ПараметрыПодключения.СтрокаПодключения) Тогда
		Возврат Результат;
	КонецЕсли;

	Движок = ВыбратьДвижокДляБазы(ИспользоватьIbcmd);
	Результат.ПараметрыПодключения = Движок.СоздатьВременнуюБазу(ПараметрыПлатформы);
	Результат.Временная = Истина;
	Лог.Отладка("Создана временная ИБ: %1", Результат.ПараметрыПодключения.КаталогБазы);

	Возврат Результат;

КонецФункции

Процедура ОчиститьВременнуюБазу(КонтекстБазы)

	Если НЕ КонтекстБазы.Временная Тогда
		Возврат;
	КонецЕсли;

	Лог.Отладка("Удаление временной ИБ: %1", КонтекстБазы.ПараметрыПодключения.КаталогБазы);
	Попытка
		УдалитьФайлы(КонтекстБазы.ПараметрыПодключения.КаталогБазы);
	Исключение
		Лог.Предупреждение("Не удалось удалить временную ИБ: %1", ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

Функция ВыбратьДвижокДляБазы(ИспользоватьIbcmd)

	Если ЗначениеЗаполнено(ИспользоватьIbcmd) И Булево(ИспользоватьIbcmd) Тогда
		Возврат Движки["ДвижокIbcmd"];
	КонецЕсли;

	Возврат Движки["ДвижокКонфигуратор"];

КонецФункции

// Найти XML-файл внешней обработки в каталоге.
// Ищет файл, содержащий тег ExternalDataProcessor.
//
// Параметры:
//   КаталогИсходников - Строка - каталог для поиска
//
// Возвращаемое значение:
//   Файл, Неопределено - найденный файл или Неопределено
//
Функция НайтиФайлОбработки(Знач КаталогИсходников)

	ФайлыXml = НайтиФайлы(КаталогИсходников, "*.xml", Ложь);

	Для Каждого ФайлXml Из ФайлыXml Цикл
		Если СодержитТегОбработки(ФайлXml.ПолноеИмя) Тогда
			Возврат ФайлXml;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Рекурсивный поиск каталогов с XML-исходниками обработок.
//
// Параметры:
//   КорневойКаталог - Строка - каталог для поиска
//
// Возвращаемое значение:
//   Массив из Строка - пути к каталогам с обработками
//
Функция НайтиКаталогиОбработокРекурсивно(Знач КорневойКаталог)

	Результат = Новый Массив;

	ФайлыXml = НайтиФайлы(КорневойКаталог, "*.xml", Истина);

	Для Каждого ФайлXml Из ФайлыXml Цикл
		Если СодержитТегОбработки(ФайлXml.ПолноеИмя) Тогда
			Результат.Добавить(ФайлXml.Путь);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Проверить, содержит ли XML-файл тег ExternalDataProcessor.
//
// Параметры:
//   ПутьКФайлу - Строка - путь к XML-файлу
//
// Возвращаемое значение:
//   Булево
//
Функция СодержитТегОбработки(Знач ПутьКФайлу)

	ЧтениеТекста = Новый ЧтениеТекста(ПутьКФайлу);
	Содержимое = ЧтениеТекста.Прочитать();
	ЧтениеТекста.Закрыть();

	СодержимоеВРег = ВРег(Содержимое); // BSLLS:Typo-off
	Возврат СтрНайти(СодержимоеВРег, "<EXTERNALDATAPROCESSOR UUID=") > 0;

КонецФункции

// Определить путь к выходному EPF-файлу.
//
// Параметры:
//   КаталогИсходников - Строка - каталог с исходниками
//   КаталогВыгрузки   - Строка - каталог для выгрузки (может быть пустым)
//   ИмяОбработки      - Строка - имя обработки (без расширения)
//
// Возвращаемое значение:
//   Строка - полный путь к EPF-файлу
//
Функция ОпределитьПутьВыгрузкиEpf(Знач КаталогИсходников, Знач КаталогВыгрузки, Знач ИмяОбработки)

	ИмяФайла = ИмяОбработки + ".epf";

	Если ЗначениеЗаполнено(КаталогВыгрузки) Тогда
		ФайлКаталога = Новый Файл(КаталогВыгрузки);
		Если НЕ ФайлКаталога.Существует() Тогда
			СоздатьКаталог(КаталогВыгрузки);
		КонецЕсли;
		Возврат ОбъединитьПути(КаталогВыгрузки, ИмяФайла);
	КонецЕсли;

	// Рядом с каталогом исходников
	ФайлКаталога = Новый Файл(КаталогИсходников);
	Возврат ОбъединитьПути(ФайлКаталога.Путь, ИмяФайла);

КонецФункции

// Определить каталог для разборки EPF.
//
// Параметры:
//   ФайлEpf         - Файл   - файл обработки
//   КаталогВыгрузки - Строка - каталог для выгрузки (может быть пустым)
//
// Возвращаемое значение:
//   Строка - путь к каталогу для разборки
//
Функция ОпределитьКаталогРазборки(Знач ФайлEpf, Знач КаталогВыгрузки)

	ИмяКаталога = ФайлEpf.ИмяБезРасширения;

	Если ЗначениеЗаполнено(КаталогВыгрузки) Тогда
		ФайлКаталога = Новый Файл(КаталогВыгрузки);
		Если НЕ ФайлКаталога.Существует() Тогда
			СоздатьКаталог(КаталогВыгрузки);
		КонецЕсли;
		Возврат ОбъединитьПути(КаталогВыгрузки, ИмяКаталога);
	КонецЕсли;

	// Рядом с EPF-файлом
	Возврат ОбъединитьПути(ФайлEpf.Путь, ИмяКаталога);

КонецФункции

#КонецОбласти
