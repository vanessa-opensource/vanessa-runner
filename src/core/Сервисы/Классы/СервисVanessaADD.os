// BSLLS:MissingVariablesDescription-off Поля autumn (&Пластилин/&Желудь).
// BSLLS:UnusedLocalMethod-off ПриСозданииОбъекта вызывается рантаймом при Новый.
// BSLLS:LatinAndCyrillicSymbolInWord-off Технические имена (vanessa-add, addRoot, epf).
// Обработки пакета vanessa-add (bddRunner.epf, xddTestRunner.epf) и макрос $addRoot
// в путях к тестам - общее для команд test xunit и test vanessa.

&Пластилин
Перем СервисОкружения;

&Пластилин
Перем ФайловыеОперации;

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Путь к обработке vanessa-add: явно заданный либо из каталога установки пакета.
//
// Параметры:
//   ИмяФайла - Строка - имя файла обработки, например xddTestRunner.epf
//   ЯвныйПуть - Строка - путь из опции команды; пусто - искать в vanessa-add
//   ИмяОпции - Строка - имя опции для сообщений об ошибках, например --pathxunit
//
// Возвращаемое значение:
//   Строка - полный путь к существующему файлу обработки
//
Функция ПутьКОбработке(Знач ИмяФайла, Знач ЯвныйПуть, Знач ИмяОпции) Экспорт

	Если ЗначениеЗаполнено(ЯвныйПуть) Тогда
		Путь = ФайловыеОперации.ПолныйПуть(ЯвныйПуть);
		ПроверитьФайлОбработки(Путь, ИмяФайла, ИмяОпции);
		Возврат Путь;
	КонецЕсли;

	КаталогADD = СервисОкружения.КаталогVanessaADD();
	Если НЕ ЗначениеЗаполнено(КаталогADD) Тогда
		ВызватьИсключение СтрШаблон(
			"Не найден каталог установки vanessa-add (lib/add рядом с OneScript) для поиска %1."
			+ " Укажите путь явно через %2.", ИмяФайла, ИмяОпции);
	КонецЕсли;

	Путь = ФайловыеОперации.ПолныйПуть(ОбъединитьПути(КаталогADD, ИмяФайла));
	ПроверитьФайлОбработки(Путь, ИмяФайла, ИмяОпции);
	Возврат Путь;

КонецФункции

// Подставить макрос $addRoot (каталог установки vanessa-add) в путь.
// Позволяет запускать встроенные тесты vanessa-add, например $addRoot/tests/smoke.
//
// Параметры:
//   Путь - Строка - исходный путь, возможно содержащий макрос $addRoot
//   Назначение - Строка - что предложить указать явно в сообщении об ошибке: "тестам", "фичам"
//
// Возвращаемое значение:
//   Строка - путь с раскрытым макросом $addRoot
//
Функция ПодставитьМакросAddRoot(Знач Путь, Знач Назначение = "файлам") Экспорт

	Если НЕ ЗначениеЗаполнено(Путь) ИЛИ СтрНайти(Путь, МакросAddRoot()) = 0 Тогда
		Возврат Путь;
	КонецЕсли;

	Макрос = МакросAddRoot();
	КаталогADD = СервисОкружения.КаталогVanessaADD();
	Если НЕ ЗначениеЗаполнено(КаталогADD) Тогда
		ВызватьИсключение СтрШаблон(
			"Не удалось разрешить макрос %1: не найден каталог установки vanessa-add."
			+ " Укажите путь к %2 явно.", Макрос, Назначение);
	КонецЕсли;

	Возврат СтрЗаменить(Путь, Макрос, КаталогADD);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьФайлОбработки(Знач Путь, Знач ИмяФайла, Знач ИмяОпции)

	Файл = Новый Файл(Путь);
	Если НЕ Файл.Существует() Тогда
		ВызватьИсключение СтрШаблон(
			"Файл обработки %1 не найден: %2."
			+ " Убедитесь, что установлен пакет vanessa-add, либо укажите корректный путь через опцию %3.",
			ИмяФайла, Путь, ИмяОпции);
	КонецЕсли;

	Если НЕ Файл.ЭтоФайл() Тогда
		ВызватьИсключение СтрШаблон(
			"Указанный путь не является файлом: %1 (опция %2)", Путь, ИмяОпции);
	КонецЕсли;

КонецПроцедуры

Функция МакросAddRoot()
	Возврат "$addRoot";
КонецФункции

#КонецОбласти
