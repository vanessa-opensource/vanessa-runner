// BSLLS:UnusedLocalMethod-off ПриСозданииОбъекта вызывается рантаймом при Новый.
// Разбор пары опций --report-format / --report-path в список формируемых отчётов.
//
// Пара одинакова у всех команд, которые что-то выгружают по итогам прогона
// (validate syntax-check, validate edt, test xunit/yaxunit/vanessa), а вот словарь
// форматов у каждой команды свой - он передаётся в конструктор.
//
// Правила разрешения пути:
//   один формат      - --report-path берётся как есть (файл или каталог, как требует формат);
//   несколько форматов - --report-path это каталог, имена внутри него по соглашению словаря.
// Такой компромисс покрывает и «дай мне junit вот сюда», и «дай всё в build/reports»,
// не возвращая скобочный синтаксис вида "junit{путь};allure{путь}".

Перем _Форматы;           // Соответствие - формат в нижнем регистре -> имя по умолчанию внутри каталога
Перем _ФорматПоУмолчанию; // Строка - формат, когда задан только путь; пусто - требовать формат явно
Перем _ОткрытыйСловарь;   // Булево - принимать форматы вне словаря (имена генераторов Vanessa-ADD)

// Параметры:
//   ДопустимыеФорматы - Соответствие - формат (нижний регистр) -> имя файла/каталога внутри --report-path
//   ФорматПоУмолчанию - Строка       - формат, подставляемый когда задан только --report-path
//   ОткрытыйСловарь   - Булево       - принимать форматы вне словаря как есть
//
Процедура ПриСозданииОбъекта(Знач ДопустимыеФорматы, Знач ФорматПоУмолчанию = "", Знач ОткрытыйСловарь = Ложь)

	_Форматы = ДопустимыеФорматы;
	_ФорматПоУмолчанию = ФорматПоУмолчанию;
	_ОткрытыйСловарь = ОткрытыйСловарь;

КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Разобрать значения опций в список отчётов.
//
// Параметры:
//   Форматы - Массив, Неопределено - значения --report-format (опция повторяемая)
//   Путь    - Строка, Неопределено - значение --report-path
//
// Возвращаемое значение:
//   Массив - Элементы <Структура>:
//    * Формат - Строка - канонический формат (для словарных - в нижнем регистре)
//    * Путь   - Строка - полный путь вывода; пустой, если путь не задан и формат один
//
Функция Разобрать(Знач Форматы, Знач Путь) Экспорт

	ПутьОтчетов = ?(Путь = Неопределено, "", СокрЛП(Путь));
	Запрошенные = НормализоватьФорматы(Форматы);

	Если Запрошенные.Количество() = 0 Тогда

		Если НЕ ЗначениеЗаполнено(ПутьОтчетов) Тогда
			Возврат Новый Массив;
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(_ФорматПоУмолчанию) Тогда
			ВызватьИсключение СтрШаблон(
				"Задан --report-path, но не задан --report-format. Доступные форматы: %1", СписокФорматов());
		КонецЕсли;

		Запрошенные.Добавить(_ФорматПоУмолчанию);

	КонецЕсли;

	Множественный = Запрошенные.Количество() > 1;

	Если Множественный И НЕ ЗначениеЗаполнено(ПутьОтчетов) Тогда
		ВызватьИсключение
			"Для нескольких форматов отчёта нужен каталог назначения: укажите --report-path";
	КонецЕсли;

	Отчеты = Новый Массив;
	Для Каждого Формат Из Запрошенные Цикл
		ПутьФормата = РазрешитьПуть(Формат, ПутьОтчетов, Множественный);
		Отчеты.Добавить(Новый Структура("Формат, Путь", Формат, ПутьФормата));
	КонецЦикла;

	Возврат Отчеты;

КонецФункции

// Найти отчёт заданного формата в результате Разобрать().
//
// Параметры:
//   Отчеты - Массив - результат Разобрать()
//   Формат - Строка - искомый формат
//
// Возвращаемое значение:
//   Структура, Неопределено - элемент списка отчётов либо Неопределено
//
Функция НайтиОтчет(Знач Отчеты, Знач Формат) Экспорт

	Искомый = НРег(СокрЛП(Формат));
	Для Каждого Отчет Из Отчеты Цикл
		Если НРег(Отчет.Формат) = Искомый Тогда
			Возврат Отчет;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Сложить отчёты из устаревших опций команды с отчётами общей пары --report-format/--report-path:
// при совпадении формата побеждает общая пара. Отчёт без пути - ошибка настройки,
// а не повод молча пропустить выгрузку.
//
// Параметры:
//   УстаревшиеОтчеты - Массив - Элементы <Структура> с полями Формат и Путь
//   НовыеОтчеты - Массив - результат Разобрать()
//
// Возвращаемое значение:
//   Массив - Элементы <Структура> с полями Формат и Путь; сначала устаревшие, затем новые форматы
//
Функция Объединить(Знач УстаревшиеОтчеты, Знач НовыеОтчеты) Экспорт

	Отчеты = Новый Массив;
	Для Каждого Отчет Из УстаревшиеОтчеты Цикл
		ДобавитьОтчет(Отчеты, Отчет.Формат, Отчет.Путь);
	КонецЦикла;
	Для Каждого Отчет Из НовыеОтчеты Цикл
		ДобавитьОтчет(Отчеты, Отчет.Формат, Отчет.Путь);
	КонецЦикла;

	Для Каждого Отчет Из Отчеты Цикл
		Если НЕ ЗначениеЗаполнено(Отчет.Путь) Тогда
			ВызватьИсключение СтрШаблон(
				"Не задан путь отчёта формата ""%1"": укажите --report-path", Отчет.Формат);
		КонецЕсли;
	КонецЦикла;

	Возврат Отчеты;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Добавить отчёт в список; повторное указание формата перекрывает предыдущее.
//
// Параметры:
//   Отчеты - Массив - список отчётов, изменяется
//   Формат - Строка - формат отчёта
//   Путь   - Строка - путь вывода отчёта
//
Процедура ДобавитьОтчет(Отчеты, Знач Формат, Знач Путь)

	Для Каждого Отчет Из Отчеты Цикл
		Если НРег(Отчет.Формат) = НРег(Формат) Тогда
			Отчет.Путь = Путь;
			Возврат;
		КонецЕсли;
	КонецЦикла;

	Отчеты.Добавить(Новый Структура("Формат, Путь", Формат, Путь));

КонецПроцедуры

Функция НормализоватьФорматы(Знач Форматы)

	Результат = Новый Массив;
	Если Форматы = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Учтенные = Новый Соответствие;

	Для Каждого Значение Из Форматы Цикл

		Формат = СокрЛП(Значение);
		Если НЕ ЗначениеЗаполнено(Формат) Тогда
			Продолжить;
		КонецЕсли;

		Ключ = НРег(Формат);
		Если Учтенные[Ключ] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Учтенные.Вставить(Ключ, Истина);

		Результат.Добавить(КаноническийФормат(Формат, Ключ));

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Словарные форматы приводим к нижнему регистру, чужие (генераторы Vanessa-ADD)
// оставляем как написал пользователь - их регистр значим для самой Vanessa-ADD.
//
// Параметры:
//   Формат - Строка - значение опции как его написал пользователь
//   Ключ   - Строка - тот же формат в нижнем регистре
//
// Возвращаемое значение:
//   Строка - канонический формат
//
Функция КаноническийФормат(Знач Формат, Знач Ключ)

	Если _Форматы[Ключ] <> Неопределено Тогда
		Возврат Ключ;
	КонецЕсли;

	Если НЕ _ОткрытыйСловарь Тогда
		ВызватьИсключение СтрШаблон(
			"Неизвестный формат отчёта: ""%1"". Доступные форматы: %2", Формат, СписокФорматов());
	КонецЕсли;

	Возврат Формат;

КонецФункции

Функция РазрешитьПуть(Знач Формат, Знач Путь, Знач Множественный)

	Если НЕ ЗначениеЗаполнено(Путь) Тогда
		Возврат "";
	КонецЕсли;

	Если Множественный Тогда
		Возврат ПолныйПуть(ОбъединитьПути(Путь, ИмяПоУмолчанию(Формат)));
	КонецЕсли;

	Возврат ПолныйПуть(Путь);

КонецФункции

Функция ИмяПоУмолчанию(Знач Формат)

	Имя = _Форматы[НРег(Формат)];
	Возврат ?(Имя = Неопределено, Формат, Имя);

КонецФункции

Функция ПолныйПуть(Знач Путь)

	Возврат Новый Файл(Путь).ПолноеИмя;

КонецФункции

Функция СписокФорматов()

	Имена = Новый Массив;
	Для Каждого Элемент Из _Форматы Цикл
		Имена.Добавить(Элемент.Ключ);
	КонецЦикла;

	Список = СтрСоединить(Имена, ", ");
	Если _ОткрытыйСловарь Тогда
		Список = Список + " либо имя генератора отчёта";
	КонецЕсли;

	Возврат Список;

КонецФункции

#КонецОбласти
