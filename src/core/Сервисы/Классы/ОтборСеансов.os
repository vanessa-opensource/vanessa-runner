// BSLLS:UnusedLocalMethod-off ПриСозданииОбъекта вызывается рантаймом при Новый.
// Отбор сеансов кластера по свойствам (приложение, пользователь).
// Используется командами cluster session kill / closed для выборочной работы с сеансами.
//
// Условия отбора складываются в массив; сеанс подходит, если совпало хотя бы одно условие
// (регистронезависимое точное сравнение). Флаг инверсии переворачивает результат -
// подходят все сеансы, КРОМЕ совпавших (аналог --mode EXCEPT из 2.x).

Перем _Условия;      // Массив - элементы Структура (Поле - Строка, Значения - Массив)
Перем _Инвертирован; // Булево - Истина = режим исключения (все, кроме подходящих)
Перем _Приложения;   // Массив - допустимые идентификаторы приложений (канонические имена rac)

Процедура ПриСозданииОбъекта()

	_Условия = Новый Массив;
	_Инвертирован = Ложь;

	// Канонический список идентификаторов приложений (см. irac, Перечисления.Приложения).
	_Приложения = СтрРазделить(
		"Designer,1CV8,1CV8C,WebClient,WSConnection,HTTPServiceConnection,COMConnection,"
		+ "WebServerExtension,BackgroundJob,JobScheduler,SrvrConsole,RAS,AgentStandardCall", ",");

КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Добавить условие отбора по идентификатору приложения сеанса (app-id).
// Значения проверяются по списку допустимых идентификаторов (регистронезависимо).
//
// Параметры:
//   Значения - Массив, Строка - идентификаторы приложений; строка разделяется по ";"
//
// Возвращаемое значение:
//   ОтборСеансов - этот же объект (для чейнинга)
//
Функция ДобавитьУсловиеПоПриложению(Знач Значения) Экспорт

	МассивЗначений = ВМассивЗначений(Значения, "--filter-app");

	Для Каждого Значение Из МассивЗначений Цикл
		ПроверитьИдентификаторПриложения(Значение);
	КонецЦикла;

	_Условия.Добавить(Новый Структура("Поле, Значения", "app-id", МассивЗначений));

	Возврат ЭтотОбъект;

КонецФункции

// Добавить условие отбора по имени пользователя ИБ (user-name).
//
// Параметры:
//   Значения - Массив, Строка - имена пользователей; строка разделяется по ";"
//
// Возвращаемое значение:
//   ОтборСеансов - этот же объект (для чейнинга)
//
Функция ДобавитьУсловиеПоПользователю(Знач Значения) Экспорт

	_Условия.Добавить(Новый Структура("Поле, Значения", "user-name", ВМассивЗначений(Значения, "--filter-name")));

	Возврат ЭтотОбъект;

КонецФункции

// Включить режим исключения: подходят все сеансы, КРОМЕ совпавших с условиями.
//
// Параметры:
//   Признак - Булево - Истина (по умолчанию) - инвертировать отбор
//
// Возвращаемое значение:
//   ОтборСеансов - этот же объект (для чейнинга)
//
Функция Инвертировать(Знач Признак = Истина) Экспорт
	_Инвертирован = Признак;
	Возврат ЭтотОбъект;
КонецФункции

// Признак пустого отбора (условия не заданы) - такой отбор пропускает все сеансы.
//
// Возвращаемое значение:
//   Булево - Истина, если условий нет
//
Функция Пустой() Экспорт
	Возврат _Условия.Количество() = 0;
КонецФункции

// Проверить, подходит ли сеанс под отбор.
//
// Параметры:
//   Сеанс - Произвольный - сеанс irac (объект с методом Получить(ИмяПоля))
//
// Возвращаемое значение:
//   Булево - Истина, если сеанс подходит под отбор
//
Функция СеансПодходит(Знач Сеанс) Экспорт

	Если Пустой() Тогда
		Возврат Истина;
	КонецЕсли;

	Совпал = Ложь;
	Для Каждого Условие Из _Условия Цикл
		Если ЗначениеВСписке(Сеанс.Получить(Условие.Поле), Условие.Значения) Тогда
			Совпал = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат Совпал <> _Инвертирован;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВМассивЗначений(Знач Значения, Знач ИмяОпции)

	Если ТипЗнч(Значения) = Тип("Строка") Тогда
		МассивЗначений = СтрРазделить(Значения, ";", Ложь);
	Иначе
		МассивЗначений = Значения;
	КонецЕсли;

	Результат = Новый Массив;
	Для Каждого Значение Из МассивЗначений Цикл
		Если ЗначениеЗаполнено(СокрЛП(Значение)) Тогда
			Результат.Добавить(СокрЛП(Значение));
		КонецЕсли;
	КонецЦикла;

	Если Результат.Количество() = 0 Тогда
		ВызватьИсключение СтрШаблон("Не заданы значения условия отбора сеансов %1", ИмяОпции);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Процедура ПроверитьИдентификаторПриложения(Знач Значение)

	Для Каждого Приложение Из _Приложения Цикл
		Если ВРег(Приложение) = ВРег(Значение) Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;

	ВызватьИсключение СтрШаблон(
		"Недопустимое значение --filter-app: ""%1"". Доступны: %2",
		Значение, СтрСоединить(_Приложения, ", "));

КонецПроцедуры

Функция ЗначениеВСписке(Знач Значение, Знач Список)

	Для Каждого Элемент Из Список Цикл
		Если ВРег(СокрЛП(Элемент)) = ВРег(СокрЛП(Строка(Значение))) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

#КонецОбласти
