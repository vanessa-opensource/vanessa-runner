// BSLLS:NumberOfValuesInStructureConstructor-off
// BSLLS:MissingVariablesDescription-off Поля autumn (&Лог/&Пластилин) и внутреннее состояние сервиса.
// BSLLS:NumberOfOptionalParams-off
// Сервис запуска встроенных обработок (EPF) в режиме 1С:Предприятие.
// Универсальный механизм: принимает имя обработки и параметры, запускает предприятие
// с передачей параметров через /C-строку и разбирает стандартизированный JSON-результат.
//
// Параметры передаются обработке строкой вида "Ключ1=Значение1;Флаг2;ФайлРезультата=<путь>".
// Обработка по завершении пишет JSON-файл результата:
//   { "КодВозврата": 0, "Сообщения": ["..."], "Ошибка": "" }

&Лог("vrunner")
Перем Лог;

&Пластилин
Перем ФайловыеОперации;

&Пластилин(Значение = "ДвижокПлатформы", Тип = "Соответствие")
Перем Движки;

&Пластилин
Перем СервисОкружения;

// Таймаут (сек) ожидания записи файла результата дочерним процессом платформы.
Перем _ТаймаутОжиданияРезультатаСек;

&Желудь
Процедура ПриСозданииОбъекта()
	_ТаймаутОжиданияРезультатаСек = 30;
КонецПроцедуры

// Устанавливает таймаут ожидания записи файла результата (в секундах).
// Применяется преимущественно в тестах, чтобы не ждать реального таймаута.
//
// Параметры:
//   Секунды - Число - максимальное время ожидания файла результата
Процедура УстановитьТаймаутОжиданияРезультата(Знач Секунды) Экспорт
	_ТаймаутОжиданияРезультатаСек = Секунды;
КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Выполнить встроенную обработку в режиме 1С:Предприятие.
// Параметры:
//   ИмяОбработки         - Строка    - имя EPF-файла без расширения (например "СоздатьПользователей")
//   ПараметрыПодключения - Структура - строка подключения, пользователь, пароль
//   Параметры            - Структура, Соответствие, Неопределено - параметры обработки.
//                            Булево Истина -> голый флаг, Булево Ложь -> пропускается,
//                            прочее -> "Ключ=Значение".
//   ПараметрыПлатформы   - Структура, Неопределено - необязательные параметры платформы
//
// Возвращаемое значение:
//   Структура - КодВозврата (Число), Сообщения (Массив строк), Ошибка (Строка)
//
Функция ВыполнитьОбработку(Знач ИмяОбработки, Знач ПараметрыПодключения,
	Знач Параметры = Неопределено, Знач ПараметрыПлатформы = Неопределено) Экспорт

	ПутьКEpf = ПолучитьПутьКОбработке(ИмяОбработки);
	// Удаляется через УдалитьВременныйФайл ниже (в т.ч. при исключении).
	ПутьРезультата = ПолучитьИмяВременногоФайла("json"); // BSLLS:MissingTemporaryFileDeletion-off

	Попытка
		// Файл результата создаём заранее, ДО запуска платформы: обработка только
		// дописывает в уже существующий файл. Это надёжнее, чем рассчитывать на
		// создание файла из обработки (в режиме предприятия создание файла в %TEMP%
		// может быть недоступно, тогда как запись в существующий файл - выполняется).
		СоздатьПустойФайлРезультата(ПутьРезультата);

		КомандаЗапуска = СформироватьСтрокуПараметров(Параметры, ПутьРезультата);
		Лог.Отладка("Запуск обработки '%1': параметры=%2", ИмяОбработки, КомандаЗапуска);

		ПараметрыЗапуска = Новый Структура(
			"КомандаЗапуска, ПутьОбработки, НавигационнаяСсылка, НеОжидать,"
				+ " РежимЗапуска, ДополнительныеПараметры, ПутьКФайлуСтатуса",
			КомандаЗапуска, ПутьКEpf, "", Ложь, "", "", "");

		Лог.Отладка("Запуск платформы для обработки '%1', файл результата: %2", ИмяОбработки, ПутьРезультата);
		Движки["ДвижокКонфигуратор"].ЗапуститьПредприятие(
			ПараметрыПодключения, ПараметрыЗапуска, ПараметрыПлатформы);

		// Тонкий клиент (1cv8c.exe) выступает лаунчером: он может завершиться
		// (в т.ч. с кодом возврата 1) РАНЬШЕ, чем дочерний процесс клиента
		// закончит работу обработки и допишет файл результата. Дожидаемся
		// появления непустого файла результата - он является достоверным
		// источником успеха/ошибки. Для успешных запусков файл появляется почти
		// сразу, поэтому ожидание фактически не вносит задержки.
		Лог.Отладка("Ожидание дописывания файла результата обработки '%1' (таймаут %2 сек)",
			ИмяОбработки, _ТаймаутОжиданияРезультатаСек);
		ДописанВовремя = ДождатьсяФайлаРезультата(ПутьРезультата, _ТаймаутОжиданияРезультатаСек);
		Лог.Отладка("Файл результата обработки '%1' дописан вовремя: %2", ИмяОбработки, ДописанВовремя);

		Результат = ПрочитатьРезультат(ПутьРезультата);
		Лог.Отладка("Результат обработки '%1': файлНайден=%2, кодВозврата=%3, сообщений=%4, ошибка=%5",
			ИмяОбработки, Результат.ФайлНайден, Результат.КодВозврата,
			Результат.Сообщения.Количество(), Результат.Ошибка);
		УчестьКодВозвратаПлатформы(Результат);
	Исключение
		УдалитьВременныйФайл(ПутьРезультата);
		ВызватьИсключение;
	КонецПопытки;

	УдалитьВременныйФайл(ПутьРезультата);

	ПроверитьРезультат(Результат, ИмяОбработки);

	Возврат Результат;

КонецФункции

// Сформировать строку параметров запуска обработки.
// Доступна отдельно для тестирования и переиспользования.
// Параметры:
//   Параметры     - Структура, Соответствие, Неопределено - параметры обработки
//   ПутьРезультата - Строка - путь к файлу результата (добавляется ключом ФайлРезультата)
//
// Возвращаемое значение:
//   Строка - параметры, склеенные через ";"
//
Функция СформироватьСтрокуПараметров(Знач Параметры, Знач ПутьРезультата) Экспорт

	Части = Новый Массив;

	Если Параметры <> Неопределено Тогда
		Для Каждого КлючЗначение Из Параметры Цикл
			Значение = КлючЗначение.Значение;
			Если ТипЗнч(Значение) = Тип("Булево") Тогда
				Если Значение = Истина Тогда
					Части.Добавить(КлючЗначение.Ключ);
				КонецЕсли;
			Иначе
				Части.Добавить(КлючЗначение.Ключ + "=" + Строка(Значение));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Если ЗначениеЗаполнено(ПутьРезультата) Тогда
		Части.Добавить("ФайлРезультата=" + ПутьРезультата);
	КонецЕсли;

	Возврат СтрСоединить(Части, ";");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьПутьКОбработке(Знач ИмяОбработки)

	ПутьКEpf = ОбъединитьПути(СервисОкружения.КорневойКаталогПакета(), "epf", ИмяОбработки + ".epf");
	Файл = Новый Файл(ПутьКEpf);
	Если НЕ Файл.Существует() Тогда
		ВызватьИсключение СтрШаблон("EPF-обработка не найдена: %1", ПутьКEpf);
	КонецЕсли;
	Возврат Файл.ПолноеИмя;

КонецФункции

// Дожидается, пока обработка допишет непустой файл результата.
//
// Тонкий клиент 1cv8c.exe может вести себя как лаунчер: родительский процесс
// завершается раньше, чем дочерний процесс клиента закончит выполнение обработки
// и запишет файл результата. Поэтому после "завершения" процесса платформы файл
// может быть ещё пустым (сервис заранее создаёт его пустым, к тому же кодировка
// UTF-8 добавляет BOM, поэтому ориентироваться на размер файла нельзя).
// Опрашиваем содержимое файла в пределах таймаута: для успешных запусков готовый
// JSON появляется почти мгновенно (задержка отсутствует), а для зависших или
// аварийных запусков мы корректно дойдём до анализа кода возврата платформы по
// таймауту.
//
// Параметры:
//   ПутьРезультата - Строка - путь к файлу результата
//   ТаймаутСекунд  - Число  - максимальное время ожидания записи файла
//
// Возвращаемое значение:
//   Булево - Истина, если файл был дописан в пределах таймаута
//
Функция ДождатьсяФайлаРезультата(Знач ПутьРезультата, Знач ТаймаутСекунд = 30)

	КрайнийСрок = ТекущаяУниверсальнаяДатаВМиллисекундах() + ТаймаутСекунд * 1000; // BSLLS:MagicNumber-off

	Пока Истина Цикл
		Если ФайлРезультатаДописан(ПутьРезультата) Тогда
			Возврат Истина;
		КонецЕсли;

		Если ТекущаяУниверсальнаяДатаВМиллисекундах() >= КрайнийСрок Тогда
			Возврат Ложь;
		КонецЕсли;

		Приостановить(300); // BSLLS:MagicNumber-off Интервал опроса файла результата, мс.
	КонецЦикла;

КонецФункции

// Проверяет, что обработка полностью записала JSON-файл результата.
// Файл создаётся сервисом заранее пустым, а дочерний процесс платформы может
// дописывать его асинхронно, поэтому промежуточно файл может быть пустым или
// содержать неполный JSON. Считаем файл готовым только когда его содержимое
// непустое и завершается закрывающей фигурной скобкой.
//
// Параметры:
//   ПутьРезультата - Строка - путь к файлу результата
//
// Возвращаемое значение:
//   Булево - Истина, если файл содержит завершённый JSON
//
Функция ФайлРезультатаДописан(Знач ПутьРезультата)

	Файл = Новый Файл(ПутьРезультата);
	Если НЕ Файл.Существует() Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		Чтение = Новый ЧтениеТекста(ПутьРезультата, "UTF-8");
		Содержимое = Чтение.Прочитать();
		Чтение.Закрыть();
	Исключение
		Возврат Ложь;
	КонецПопытки;

	Содержимое = СокрЛП(Содержимое);
	Возврат ЗначениеЗаполнено(Содержимое) И Прав(Содержимое, 1) = "}";

КонецФункции

Функция ПрочитатьРезультат(Знач ПутьРезультата)

	Результат = Новый Структура("КодВозврата, Сообщения, Ошибка, ФайлНайден", 0, Новый Массив, "", Ложь);

	Файл = Новый Файл(ПутьРезультата);
	Если НЕ Файл.Существует() Тогда
		Лог.Предупреждение("Обработка не записала файл результата: %1", ПутьРезультата);
		Возврат Результат;
	КонецЕсли;

	Чтение = Новый ЧтениеТекста(ПутьРезультата, "UTF-8");
	Содержимое = Чтение.Прочитать();
	Чтение.Закрыть();

	Если НЕ ЗначениеЗаполнено(Содержимое) Тогда
		// Файл создан заранее самим сервисом, но обработка ничего в него не записала.
		Лог.Предупреждение("Обработка не записала файл результата: %1", ПутьРезультата);
		Возврат Результат;
	КонецЕсли;

	Результат.ФайлНайден = Истина;

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Содержимое);
		Данные = ПрочитатьJSON(ЧтениеJSON, Истина);
		ЧтениеJSON.Закрыть();
	Исключение
		ВызватьИсключение СтрШаблон("Не удалось разобрать JSON-результат обработки (%1): %2",
			ПутьРезультата, ОписаниеОшибки());
	КонецПопытки;

	Если Данные["КодВозврата"] <> Неопределено Тогда
		Результат.КодВозврата = Число(Данные["КодВозврата"]);
	КонецЕсли;
	Если Данные["Ошибка"] <> Неопределено Тогда
		Результат.Ошибка = Строка(Данные["Ошибка"]);
	КонецЕсли;
	Если ТипЗнч(Данные["Сообщения"]) = Тип("Массив") Тогда
		Для Каждого Сообщение Из Данные["Сообщения"] Цикл
			Результат.Сообщения.Добавить(Строка(Сообщение));
		КонецЦикла;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Учитывает код возврата процесса платформы.
// Если платформа завершилась аварийно (код возврата <> 0), а обработка не
// сообщила об ошибке самостоятельно (не записала файл результата) - формируем
// ошибку на основании кода возврата платформы. Это защищает от ложного "успеха",
// когда платформа не смогла стартовать или подключиться к ИБ.
//
// Если же обработка записала файл результата, он считается достоверным источником
// успеха/ошибки: платформа 1С:Предприятие может завершиться с кодом возврата <> 0
// по причинам, не связанным с самой обработкой (например, неудача в стандартных
// процедурах закрытия приложения), и это не должно превращаться в ложную ошибку.
//
// Параметры:
//   Результат - Структура - КодВозврата, Сообщения, Ошибка, ФайлНайден (модифицируется)
//
Процедура УчестьКодВозвратаПлатформы(Результат)

	Если Результат.ФайлНайден Тогда
		Возврат;
	КонецЕсли;

	КодВозвратаПлатформы = Движки["ДвижокКонфигуратор"].КодВозвратаПоследнегоЗапуска();

	Если КодВозвратаПлатформы = 0 Тогда
		Возврат;
	КонецЕсли;

	Если Результат.КодВозврата = 0 Тогда
		Результат.КодВозврата = КодВозвратаПлатформы;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Результат.Ошибка) Тогда
		Результат.Ошибка = СтрШаблон(
			"Платформа 1С:Предприятие завершилась с кодом возврата %1."
			+ " Обработка не выполнена - проверьте параметры подключения к ИБ и вывод платформы выше.",
			КодВозвратаПлатформы);
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьРезультат(Знач Результат, Знач ИмяОбработки)

	Для Каждого Сообщение Из Результат.Сообщения Цикл
		Лог.Информация(Сообщение);
	КонецЦикла;

	Если ЗначениеЗаполнено(Результат.Ошибка) Тогда
		ВызватьИсключение СтрШаблон("Обработка '%1' завершилась с ошибкой: %2",
			ИмяОбработки, Результат.Ошибка);
	КонецЕсли;

	Если Результат.КодВозврата <> 0 Тогда
		ВызватьИсключение СтрШаблон("Обработка '%1' завершилась с кодом возврата %2",
			ИмяОбработки, Результат.КодВозврата);
	КонецЕсли;

КонецПроцедуры

Процедура УдалитьВременныйФайл(Знач Путь)

	ФайловыеОперации.УдалитьБезопасно(Путь);

КонецПроцедуры

// Создаёт пустой файл результата заранее, до запуска обработки.
// Пустой файл воспринимается как «результат не записан» (ФайлНайден остаётся Ложь),
// поэтому пустышка не маскирует отсутствие реального результата.
// Параметры:
//   Путь - Строка - путь к создаваемому файлу результата
Процедура СоздатьПустойФайлРезультата(Знач Путь)

	Запись = Новый ЗаписьТекста(Путь, "UTF-8");
	Запись.Закрыть();

КонецПроцедуры

#КонецОбласти
