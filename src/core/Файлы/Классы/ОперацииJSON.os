// Чтение и запись JSON-файлов штатными средствами OneScript (ЧтениеJSON/ЗаписьJSON).
// Без зависимостей и DI: создаётся через Новый ОперацииJSON, поэтому годится и для классов
// вне контейнера autumn (конвертеры, настройка приложения до сборки Поделки).

#Область ПрограммныйИнтерфейс

// Прочитать JSON-файл в кодировке UTF-8.
//
// Параметры:
//   ПутьКФайлу - Строка - путь к файлу
//   ВСоответствие - Булево - Истина - объекты JSON читаются в Соответствие, Ложь - в Структуру
//
// Возвращаемое значение:
//   Соответствие, Структура, Массив, Строка, Число, Булево, Неопределено - данные файла
//
Функция Прочитать(Знач ПутьКФайлу, Знач ВСоответствие = Истина) Экспорт

	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(ПутьКФайлу, "UTF-8");
	Попытка
		Данные = ПрочитатьJSON(Чтение, ВСоответствие);
	Исключение
		Чтение.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	Чтение.Закрыть();

	Возврат Данные;

КонецФункции

// Записать данные в JSON-файл с отступами (UTF-8, без BOM); существующий файл перезаписывается.
//
// Параметры:
//   ПутьКФайлу - Строка - путь к файлу
//   Данные - Соответствие, Структура, Массив, Строка, Число, Булево - сериализуемое значение
//
Процедура Записать(Знач ПутьКФайлу, Знач Данные) Экспорт

	ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, Символы.Таб);
	Запись = Новый ЗаписьJSON;
	Запись.ОткрытьФайл(ПутьКФайлу, "UTF-8", Ложь, ПараметрыЗаписи);
	Попытка
		ЗаписатьJSON(Запись, Данные);
	Исключение
		Запись.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	Запись.Закрыть();

КонецПроцедуры

#КонецОбласти
