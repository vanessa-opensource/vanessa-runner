// BSLLS:MissingVariablesDescription-off Поля autumn (&Лог/&Желудь).
// BSLLS:UnusedLocalMethod-off ПриСозданииОбъекта вызывается рантаймом при Новый.
// BSLLS:UnusedLocalVariable-off Поле &Лог инициализируется autumn-фреймворком через рефлексию.
// Файловые операции vrunner - единственное место, где проект работает с каталогами и путями.
//
// Собственно «создать каталог, если его нет» живёт в библиотеке fs: ФС.ОбеспечитьКаталог
// создаёт недостающие промежуточные каталоги, безопасна при повторном вызове и явно падает,
// если по пути уже лежит файл. Здесь - обвязка, которой в библиотеке нет: каталог под
// создаваемый ФАЙЛ, разыменование пути и удаление, не роняющее команду.
//
// Подключается как обычный жёлудь: &Пластилин Перем ФайловыеОперации;

#Использовать fs

&Лог("vrunner")
Перем Лог;

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Обеспечить существование каталога.
// Недостающие промежуточные каталоги создаются; повторный вызов безопасен.
//
// Параметры:
//   Путь - Строка - путь к каталогу; пустое значение игнорируется
//
Процедура ОбеспечитьКаталог(Знач Путь) Экспорт

	Если НЕ ЗначениеЗаполнено(Путь) Тогда
		Возврат;
	КонецЕсли;

	ФС.ОбеспечитьКаталог(Путь);

КонецПроцедуры

// Обеспечить существование каталога, в котором будет создан файл.
//
// Нужна перед записью любого выходного файла (отчёт, .cf/.cfe/.dt/.epf): ни платформа,
// ни ibcmd, ни 1cedtcli не создают недостающие каталоги сами и падают на записи.
// Путь разыменовывается: у голого имени файла Файл.Путь пуст, а каталог всё-таки есть -
// текущий.
//
// Параметры:
//   ПутьКФайлу - Строка - путь к создаваемому файлу; пустое значение игнорируется
//
Процедура ОбеспечитьКаталогДляФайла(Знач ПутьКФайлу) Экспорт

	Если НЕ ЗначениеЗаполнено(ПутьКФайлу) Тогда
		Возврат;
	КонецЕсли;

	ОбеспечитьКаталог(КаталогФайла(ПутьКФайлу));

КонецПроцедуры

// Каталог, в котором лежит (или будет создан) файл.
//
// Путь разыменовывается: у голого имени файла Файл.Путь пуст, хотя каталог есть - текущий.
//
// Параметры:
//   ПутьКФайлу - Строка - путь к файлу
//
// Возвращаемое значение:
//   Строка - путь к каталогу файла; для пустого значения - пустая строка
//
Функция КаталогФайла(Знач ПутьКФайлу) Экспорт

	Если НЕ ЗначениеЗаполнено(ПутьКФайлу) Тогда
		Возврат "";
	КонецЕсли;

	Возврат Новый Файл(ПолныйПуть(ПутьКФайлу)).Путь;

КонецФункции

// Обеспечить существование ПУСТОГО каталога: существующий удаляется целиком вместе
// с вложенными каталогами и создаётся заново.
//
// Параметры:
//   Путь - Строка - путь к каталогу; пустое значение игнорируется
//
Процедура ОбеспечитьПустойКаталог(Знач Путь) Экспорт

	Если НЕ ЗначениеЗаполнено(Путь) Тогда
		Возврат;
	КонецЕсли;

	Если Новый Файл(Путь).Существует() Тогда
		Лог.Отладка("Удаление существующего каталога: %1", Путь);
		УдалитьФайлы(Путь);
	КонецЕсли;

	ФС.ОбеспечитьКаталог(Путь);

КонецПроцедуры

// Разыменовать путь: относительный - от текущего каталога, по правилам ОС.
//
// Параметры:
//   Путь - Строка - относительный или полный путь
//
// Возвращаемое значение:
//   Строка - полный путь; для пустого значения - пустая строка
//
Функция ПолныйПуть(Знач Путь) Экспорт

	Если НЕ ЗначениеЗаполнено(Путь) Тогда
		Возврат "";
	КонецЕсли;

	Возврат ФС.ПолныйПуть(Путь);

КонецФункции

// Найти файл по пути с шаблонной переменной $version в имени файла.
//
// Шаблон в имени файла заменяется на номер версии из 3 или 4 числовых сегментов
// (например, 1cv8_$version.cfu найдёт 1cv8_8.3.25.100.cfu). Имя файла должно
// соответствовать шаблону целиком. Если подходят несколько файлов, выбирается
// файл со старшей версией (посегментное числовое сравнение).
//
// Параметры:
//   ПутьКФайлу - Строка - путь к файлу; без $version возвращается как есть.
//		$version допустим только в имени файла, не в каталогах пути
//
// Возвращаемое значение:
//   Строка - полный путь найденного файла
//
Функция НайтиФайлПоШаблонуВерсии(Знач ПутьКФайлу) Экспорт

	Если СтрНайти(ПутьКФайлу, ШаблонВерсии()) = 0 Тогда
		Возврат ПутьКФайлу;
	КонецЕсли;

	Файл = Новый Файл(ПолныйПуть(ПутьКФайлу));
	Если СтрНайти(Файл.Путь, ШаблонВерсии()) > 0 Тогда
		ВызватьИсключение СтрШаблон("Шаблон %1 поддерживается только в имени файла: %2",
			ШаблонВерсии(), ПутьКФайлу);
	КонецЕсли;

	ИменаФайлов = Новый Массив;
	Для Каждого НайденныйФайл Из НайтиФайлы(Файл.Путь, ПолучитьМаскуВсеФайлы()) Цикл
		Если НЕ НайденныйФайл.ЭтоКаталог() Тогда
			ИменаФайлов.Добавить(НайденныйФайл.Имя);
		КонецЕсли;
	КонецЦикла;

	Кандидаты = ВыбратьИменаПоШаблонуВерсии(Файл.Имя, ИменаФайлов);
	Если Кандидаты.Количество() = 0 Тогда
		ВызватьИсключение СтрШаблон("Не найден файл по шаблону версии %1 в каталоге %2",
			Файл.Имя, Файл.Путь);
	КонецЕсли;

	Если Кандидаты.Количество() > 1 Тогда
		Лог.Информация("Под шаблон %1 подходят файлы: %2", Файл.Имя, СтрСоединить(Кандидаты, ", "));
	КонецЕсли;

	Результат = ОбъединитьПути(Файл.Путь, Кандидаты[0]);
	Лог.Информация("По шаблону версии %1 выбран файл %2", ПутьКФайлу, Результат);
	Возврат Результат;

КонецФункции

// Выбрать из списка имена, соответствующие шаблону имени с переменной $version.
//
// Имя должно соответствовать шаблону целиком; вместо $version ожидается версия
// из 3 или 4 числовых сегментов. Повторные вхождения $version должны содержать
// ту же версию, что и первое.
//
// Параметры:
//   ШаблонИмени - Строка - имя файла с $version, например 1cv8_$version.cfu
//   ИменаФайлов - Массив из Строка - имена файлов для отбора
//
// Возвращаемое значение:
//   Массив из Строка - подошедшие имена по убыванию версии (старшая - первая)
//
Функция ВыбратьИменаПоШаблонуВерсии(Знач ШаблонИмени, Знач ИменаФайлов) Экспорт

	РегулярноеВыражение = РегулярноеВыражениеИзШаблонаВерсии(ШаблонИмени);

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Имя");
	Для Ном = 1 По 4 Цикл
		Таблица.Колонки.Добавить("Сегмент" + Ном);
	КонецЦикла;

	Для Каждого Имя Из ИменаФайлов Цикл
		Совпадения = РегулярноеВыражение.НайтиСовпадения(Имя);
		Если Совпадения.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Сегменты = СтрРазделить(Совпадения[0].Группы[1].Значение, ".");
		Строка = Таблица.Добавить();
		Строка.Имя = Имя;
		Для Ном = 1 По 4 Цикл
			Строка["Сегмент" + Ном] = ?(Сегменты.Количество() >= Ном, Число(Сегменты[Ном - 1]), 0);
		КонецЦикла;
	КонецЦикла;

	Таблица.Сортировать("Сегмент1 Убыв, Сегмент2 Убыв, Сегмент3 Убыв, Сегмент4 Убыв");

	Результат = Новый Массив;
	Для Каждого Строка Из Таблица Цикл
		Результат.Добавить(Строка.Имя);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Удалить файл или каталог, не роняя команду, если удалить не удалось
// (файл занят другим процессом, нет прав и т.п.).
//
// Параметры:
//   Путь - Строка - путь к файлу или каталогу; пустое значение и отсутствие пути - не ошибка
//
// Возвращаемое значение:
//   Булево - Ложь, только если путь есть, но удалить его не удалось
//
Функция УдалитьБезопасно(Знач Путь) Экспорт

	Если НЕ ЗначениеЗаполнено(Путь) Тогда
		Возврат Истина;
	КонецЕсли;

	Попытка
		Если Новый Файл(Путь).Существует() Тогда
			УдалитьФайлы(Путь);
		КонецЕсли;
	Исключение
		Лог.Отладка("Не удалось удалить %1: %2", Путь, ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;

	Возврат Истина;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ШаблонВерсии()
	Возврат "$version";
КонецФункции

// Собрать якорное регулярное выражение из шаблона имени файла: фиксированные части
// экранируются, первое вхождение $version - захватывающая группа версии,
// повторные вхождения - обратная ссылка на неё.
//
// Параметры:
//   ШаблонИмени - Строка - имя файла с переменной $version
//
// Возвращаемое значение:
//   РегулярноеВыражение - выражение для сопоставления имени файла целиком
//
Функция РегулярноеВыражениеИзШаблонаВерсии(Знач ШаблонИмени)

	// $version -> перевод строки (в имени файла его быть не может),
	// чтобы СтрРазделить резал по подстроке, а не по набору символов
	Заготовка = СтрЗаменить(ШаблонИмени, ШаблонВерсии(), Символы.ПС);
	Части = СтрРазделить(Заготовка, Символы.ПС);

	ГруппаВерсии = "(\d+\.\d+\.\d+\.\d+|\d+\.\d+\.\d+)";

	ТекстВыражения = "^" + ЭкранироватьДляРегулярногоВыражения(Части[0]);
	Для Ном = 1 По Части.ВГраница() Цикл
		ТекстВыражения = ТекстВыражения + ?(Ном = 1, ГруппаВерсии, "\1")
			+ ЭкранироватьДляРегулярногоВыражения(Части[Ном]);
	КонецЦикла;
	ТекстВыражения = ТекстВыражения + "$";

	Возврат Новый РегулярноеВыражение(ТекстВыражения);

КонецФункции

Функция ЭкранироватьДляРегулярногоВыражения(Знач Текст)

	СпецСимволы = "\^$.|?*+()[]{}";
	Результат = "";
	Для Ном = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Ном, 1);
		Результат = Результат + ?(СтрНайти(СпецСимволы, Символ) > 0, "\" + Символ, Символ);
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти
