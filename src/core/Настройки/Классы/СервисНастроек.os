// Сервис каскадного разрешения настроек из файла конфигурации.
//
// Для пути команды ["cf", "load"] и опции "ibcmd" проверяет ключи
// от наиболее специфичного к корневому:
//   vrunner.cf.load.ibcmd → vrunner.cf.ibcmd → vrunner.ibcmd
//
// Значения читаются из МенеджерПараметров (configor),
// который загружает JSON-файл, переданный через глобальную опцию --settings.

#Использовать configor

&Лог("vrunner")
Перем Лог;

Перем МенеджерПараметров;

&Желудь
Процедура ПриСозданииОбъекта()
	МенеджерПараметров = Новый МенеджерПараметров;
	НастроитьМенеджерПараметров();
КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Разрешить значение настройки с каскадным поиском по пути команды.
//
// Параметры:
//   ИмяОпции - Строка - имя опции (напр. "ibcmd", "src")
//   ПутьКоманды - Массив из Строка - сегменты пути команды (напр. ["cf", "load"])
//   ЗначениеПоУмолчанию - Произвольный - значение, если ничего не найдено
//
// Возвращаемое значение:
//   Произвольный - найденное значение или значение по умолчанию
//
Функция Разрешить(Знач ИмяОпции, Знач ПутьКоманды, Знач ЗначениеПоУмолчанию = Неопределено) Экспорт

	Длина = ПутьКоманды.Количество();

	Пока Длина >= 0 Цикл

		Ключ = СформироватьКлюч(ИмяОпции, ПутьКоманды, Длина);
		Лог.Отладка("Каскадный поиск: %1", Ключ);

		Значение = МенеджерПараметров.Параметр(Ключ);
		Если Значение <> Неопределено Тогда
			Лог.Отладка("Найдено значение: %1 = %2", Ключ, Значение);
			Возврат Значение;
		КонецЕсли;

		Длина = Длина - 1;

	КонецЦикла;

	Возврат ЗначениеПоУмолчанию;

КонецФункции

// Разрешить все указанные опции для команды с заданным путём.
//
// Параметры:
//   ОпцииИЗначения - Соответствие - ключ: имя опции, значение: текущее значение
//   ПутьКоманды - Массив из Строка - сегменты пути команды
//
// Возвращаемое значение:
//   Соответствие - ключ: имя опции, значение: разрешённое значение
//
Функция РазрешитьВсе(Знач ОпцииИЗначения, Знач ПутьКоманды) Экспорт

	Результат = Новый Соответствие;

	Для Каждого КлючЗначение Из ОпцииИЗначения Цикл

		ТекущееЗначение = КлючЗначение.Значение;

		Если НЕ ЗначениеЗаполнено(ТекущееЗначение) Тогда
			ТекущееЗначение = Разрешить(КлючЗначение.Ключ, ПутьКоманды, КлючЗначение.Значение);
		КонецЕсли;

		Результат.Вставить(КлючЗначение.Ключ, ТекущееЗначение);

	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СформироватьКлюч(Знач ИмяОпции, Знач ПутьКоманды, Знач ДлинаПути)

	Части = Новый Массив;
	Части.Добавить("vrunner");

	Для Индекс = 0 По ДлинаПути - 1 Цикл
		Части.Добавить(ПутьКоманды[Индекс]);
	КонецЦикла;

	Части.Добавить(ИмяОпции);

	Возврат СтрСоединить(Части, ".");

КонецФункции

Процедура НастроитьМенеджерПараметров()

	ФайлНастроек = ИзвлечьФайлНастроек(АргументыКоманднойСтроки);
	Если НЕ ЗначениеЗаполнено(ФайлНастроек) Тогда
		Возврат;
	КонецЕсли;

	ФайлОбъект = Новый Файл(ФайлНастроек);
	Если НЕ ФайлОбъект.Существует() Тогда
		Лог.Предупреждение("Файл настроек не найден, каскадное разрешение отключено: %1", ФайлНастроек);
		Возврат;
	КонецЕсли;

	МенеджерПараметров.УстановитьФайлПараметров(ФайлНастроек);
	МенеджерПараметров.ИспользоватьПровайдерJSON();
	МенеджерПараметров.Прочитать();

КонецПроцедуры

Функция ИзвлечьФайлНастроек(Знач Аргументы)

	Для Индекс = 0 По Аргументы.ВГраница() Цикл
		Если Аргументы[Индекс] = "--settings" И Индекс < Аргументы.ВГраница() Тогда
			Возврат Аргументы[Индекс + 1];
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

#КонецОбласти
