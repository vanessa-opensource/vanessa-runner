// BSLLS:LineLength-off
// BSLLS:MissingVariablesDescription-off Поля autumn (&Лог/&Пластилин/&Напильник) и внутреннее состояние сервиса.
// Сервис заполнения пустых параметров команды из файла настроек.
// Маппинг свойство -> ключ опции берется из аннотаций
// &Опция / &Аргумент / &НаборОпций, без ручных карт в командах.
//
// Декларативные проверки полей выполняются здесь же, сразу после слияния значений:
// &ОбязательныйПослеЗаполнения, &РасширениеФайла, &СуществующийФайл.
// Обязательность проверяется по всем полям раньше значений: незаданный параметр важнее
// для пользователя, чем неверное значение соседнего. Пустое значение проверки значения пропускают.

&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисНастроек;

&Пластилин
Перем Поделка;

&Пластилин
Перем ФайловыеОперации;

Перем Рефлектор;

&Желудь
Процедура ПриСозданииОбъекта()
	Рефлектор = Новый Рефлектор;
КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Заполнить пустые параметры объекта команды значениями из файла настроек.
//
// Параметры:
//   ОбъектКоманды - Произвольный - объект команды с полями, помеченными аннотациями &Опция/&Аргумент
//
Процедура Заполнить(Знач ОбъектКоманды) Экспорт

	Если ОбъектКоманды = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ОпределениеКоманды = ПолучитьОпределениеЖелудяПоОбъекту(ОбъектКоманды, "КомандаПриложения");
	Если ОпределениеКоманды = Неопределено Тогда
		Лог.Отладка("Определение команды не найдено, заполнение из настроек пропущено");
		Возврат;
	КонецЕсли;

	ПутьКоманды = ПолучитьПутьКоманды(ОпределениеКоманды);
	Лог.Отладка("Путь команды: %1", СтрСоединить(ПутьКоманды, "."));

	ЗаполнитьПоОпределению(ОбъектКоманды, ОпределениеКоманды, ПутьКоманды);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТекстОшибкиНезаполненногоПараметра(Свойство, Знач ЭтоОпция, Знач ИмяПараметра, Знач ПутьКоманды)

	Способы = Новый Массив;
	Способы.Добавить("в командной строке");

	ПеременнаяОкружения = ПеременнаяОкруженияСвойства(Свойство);
	Если ЗначениеЗаполнено(ПеременнаяОкружения) Тогда
		Способы.Добавить(СтрШаблон("переменной окружения %1", ПеременнаяОкружения));
	КонецЕсли;

	КлючНастройки = СервисНастроек.ПолныйКлюч(НРег(ИмяПараметра), ПутьКоманды);
	Способы.Добавить(СтрШаблон("ключом %1 в файле настроек autumn-properties.json", КлючНастройки));

	Последний = Способы[Способы.ВГраница()];
	Способы.Удалить(Способы.ВГраница());

	Шаблон = ?(ЭтоОпция,
		"Не задана обязательная опция --%1. Укажите её %2 или %3.",
		"Не задан обязательный аргумент %1. Укажите его %2 или %3.");

	Возврат СтрШаблон(Шаблон, ИмяПараметра, СтрСоединить(Способы, ", "), Последний);

КонецФункции

Функция ПеременнаяОкруженияСвойства(Свойство)

	Аннотация = РаботаСАннотациями.ПолучитьАннотацию(Свойство, "ВОкружении");
	Если Аннотация = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(Аннотация);

КонецФункции

Процедура ЗаполнитьПоОпределению(ОбъектОпций, ОпределениеЖелудя, ПутьКоманды)

	Свойства = ОпределениеЖелудя.Свойства();

	Для Каждого Свойство Из Свойства Цикл

		ЗаполнитьСвойствоПоАннотации(ОбъектОпций, Свойство, "Опция", ПутьКоманды);
		ЗаполнитьСвойствоПоАннотации(ОбъектОпций, Свойство, "Аргумент", ПутьКоманды);
		ПроверитьОбязательность(ОбъектОпций, Свойство, ПутьКоманды);

	КонецЦикла;

	Для Каждого Свойство Из Свойства Цикл

		ПроверитьЗначение(ОбъектОпций, Свойство);
		ЗаполнитьВложенныйНаборОпций(ОбъектОпций, Свойство, ПутьКоманды);

	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьОбязательность(ОбъектОпций, Свойство, ПутьКоманды)

	Если РаботаСАннотациями.ПолучитьАннотацию(Свойство, "ОбязательныйПослеЗаполнения") = Неопределено
		ИЛИ ЗначениеЗаполнено(Рефлектор.ПолучитьСвойство(ОбъектОпций, Свойство.Имя)) Тогда
		Возврат;
	КонецЕсли;

	Аннотация = РаботаСАннотациями.ПолучитьАннотацию(Свойство, "Аргумент");
	ЭтоОпция = Аннотация = Неопределено;
	Если ЭтоОпция Тогда
		Аннотация = РаботаСАннотациями.ПолучитьАннотацию(Свойство, "Опция");
	КонецЕсли;

	ИмяПараметра = ИзвлечьКлючОпции(РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(Аннотация, "Имя"));
	ВызватьИсключение ТекстОшибкиНезаполненногоПараметра(Свойство, ЭтоОпция, ИмяПараметра, ПутьКоманды);

КонецПроцедуры

Процедура ПроверитьЗначение(ОбъектОпций, Свойство)

	АннотацияРасширения = РаботаСАннотациями.ПолучитьАннотацию(Свойство, "РасширениеФайла");
	АннотацияФайла = РаботаСАннотациями.ПолучитьАннотацию(Свойство, "СуществующийФайл");

	Если АннотацияРасширения = Неопределено И АннотацияФайла = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значение = Рефлектор.ПолучитьСвойство(ОбъектОпций, Свойство.Имя);
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат;
	КонецЕсли;

	Если АннотацияРасширения <> Неопределено Тогда
		ФайловыеОперации.ПроверитьРасширениеФайла(Значение,
			РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(АннотацияРасширения));
	КонецЕсли;

	Если АннотацияФайла <> Неопределено Тогда
		ФайловыеОперации.ПроверитьСуществованиеФайла(Значение,
			РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(АннотацияФайла, "Значение", "Файл не найден: %1"));
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьСвойствоПоАннотации(ОбъектОпций, Свойство, ИмяАннотации, ПутьКоманды)

	Аннотация = РаботаСАннотациями.ПолучитьАннотацию(Свойство, ИмяАннотации);
	Если Аннотация = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТекущееЗначение = Рефлектор.ПолучитьСвойство(ОбъектОпций, Свойство.Имя);

	Если ЗначениеЗаполнено(ТекущееЗначение) Тогда
		Возврат;
	КонецЕсли;

	ИмяПараметра = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(Аннотация, "Имя");
	ИмяОпции = ИзвлечьКлючОпции(ИмяПараметра);

	Если НЕ ЗначениеЗаполнено(ИмяОпции) Тогда
		Возврат;
	КонецЕсли;

	// &Флаговый без значения из CLI получает "" или Неопределено - передаём Ложь для корректного определения типа
	ЗначениеДляТипа = ТекущееЗначение;
	Если ТипЗнч(ЗначениеДляТипа) <> Тип("Булево") И РаботаСАннотациями.ПолучитьАннотацию(Свойство, "Флаговый") <> Неопределено Тогда
		ЗначениеДляТипа = Ложь;
	КонецЕсли;

	НовоеЗначение = РазрешитьПоТипу(ИмяОпции, ПутьКоманды, ЗначениеДляТипа);
	Если ЗначениеЗаполнено(НовоеЗначение) Тогда
		Лог.Отладка("Опция --%1: значение = %2", ИмяОпции, НовоеЗначение);
	Иначе
		Лог.Отладка("Опция --%1: значение не определено", ИмяОпции);
	КонецЕсли;

	Рефлектор.УстановитьСвойство(ОбъектОпций, Свойство.Имя, НовоеЗначение);

КонецПроцедуры

Процедура ЗаполнитьВложенныйНаборОпций(РодительскийОбъект, Свойство, ПутьКоманды)

	АннотацияНабора = РаботаСАннотациями.ПолучитьАннотацию(Свойство, "НаборОпций");
	Если АннотацияНабора = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ОбъектНабора = Рефлектор.ПолучитьСвойство(РодительскийОбъект, Свойство.Имя);

	Если ОбъектНабора = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ИмяНабора = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(АннотацияНабора);
	ОпределениеНабора = ПолучитьОпределениеЖелудяПоОбъекту(ОбъектНабора, ИмяНабора);

	Если ОпределениеНабора = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЗаполнитьПоОпределению(ОбъектНабора, ОпределениеНабора, ПутьКоманды);

КонецПроцедуры

Функция ПолучитьПутьКоманды(ОпределениеКоманды)

	Путь = Новый Массив;
	ТекущееОпределение = ОпределениеКоманды;

	Пока ТекущееОпределение <> Неопределено Цикл

		Конструктор = ТекущееОпределение.Завязь().ДанныеМетода();
		Если Конструктор = Неопределено Тогда
			Прервать;
		КонецЕсли;

		АннотацияКоманды = РаботаСАннотациями.НайтиАннотацию(Конструктор.Аннотации, "КомандаПриложения");
		Если АннотацияКоманды = Неопределено Тогда
			АннотацияКоманды = РаботаСАннотациями.НайтиАннотацию(Конструктор.Аннотации, "ПодкомандаПриложения");
		КонецЕсли;

		Если АннотацияКоманды = Неопределено Тогда
			Прервать;
		КонецЕсли;

		ИмяСегмента = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(АннотацияКоманды, "Имя");
		Если ЗначениеЗаполнено(ИмяСегмента) Тогда
			Путь.Вставить(0, ИмяСегмента);
		КонецЕсли;

		ИмяРодителя = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(АннотацияКоманды, "Родитель", "");
		Если НЕ ЗначениеЗаполнено(ИмяРодителя) Тогда
			Прервать;
		КонецЕсли;

		ТаблицаРодителей = Поделка.НайтиЖелуди(ИмяРодителя, Неопределено, "ТаблицаЗначений");
		Если ТаблицаРодителей.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;

		ТекущееОпределение = ТаблицаРодителей[0].ОпределениеЖелудя;

	КонецЦикла;

	Возврат Путь;

КонецФункции

Функция ПолучитьОпределениеЖелудяПоОбъекту(ОбъектЖелудя, ИмяИлиПрозвище)

	ТаблицаЖелудей = Поделка.НайтиЖелуди(ИмяИлиПрозвище, Неопределено, "ТаблицаЗначений");

	Для Каждого СтрокаЖелудя Из ТаблицаЖелудей Цикл
		Если СтрокаЖелудя.Желудь = ОбъектЖелудя Тогда
			Возврат СтрокаЖелудя.ОпределениеЖелудя;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция ИзвлечьКлючОпции(Знач ИмяПараметра)

	Если НЕ ЗначениеЗаполнено(ИмяПараметра) Тогда
		Возврат "";
	КонецЕсли;

	Возврат СтрРазделить(ИмяПараметра, " ")[0];

КонецФункции

Функция РазрешитьПоТипу(Знач ИмяОпции, Знач ПутьКоманды, Знач ТекущееЗначение)

	Если ТипЗнч(ТекущееЗначение) = Тип("Булево") Тогда
		НайденноеЗначение = СервисНастроек.Разрешить(ИмяОпции, ПутьКоманды, Ложь);
		Если ТипЗнч(НайденноеЗначение) = Тип("Булево") Тогда
			Возврат НайденноеЗначение;
		КонецЕсли;
		СтрЗначение = НРег(СокрЛП(НайденноеЗначение));
		Возврат СтрЗначение = "да" ИЛИ СтрЗначение = "true" ИЛИ СтрЗначение = "1";
	КонецЕсли;

	Возврат СервисНастроек.Разрешить(ИмяОпции, ПутьКоманды, ТекущееЗначение);

КонецФункции

#КонецОбласти
