// Напильник для регистрации глобальной опции --settings
// в корневой команде КонсольноеПриложение.
//
// --settings обрабатывается в main.os ДО создания Поделки,
// но должна быть зарегистрирована как опция, чтобы CLI-парсер
// не отклонял её как неизвестную.

Функция ОбработатьЖелудь(Желудь, ОпределениеЖелудя) Экспорт

	КорневаяКоманда = Желудь.ПолучитьКоманду();
	КорневаяКоманда.Опция("settings", "", "Путь к файлу настроек (JSON)");

	Возврат Желудь;

КонецФункции

&Напильник(ПрименяетсяТолькоНа = "КонсольноеПриложение")
Процедура ПриСозданииОбъекта()
КонецПроцедуры
