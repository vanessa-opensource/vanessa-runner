// BSLLS:LineLength-off Длинные описания &Опция нужны для понятной справки.
// BSLLS:NumberOfValuesInStructureConstructor-off
// BSLLS:MissingVariablesDescription-off Поля &Опция/&Аргумент/&НаборОпций - описания заданы в самой аннотации.
// BSLLS:UnusedLocalVariable-off Поля &Опция/&Лог инициализируются autumn-фреймворком через рефлексию.
// BSLLS:LatinAndCyrillicSymbolInWord-off Технические идентификаторы EDT (ОпцииEDT).
// Команда `edt export` - экспорт EDT-проекта по имени из workspace в XML-дамп Конфигуратора через 1cedtcli.
// Имя проекта передаётся в 1cedtcli как --project, workspace как -data.
&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисEDT;

&Пластилин
Перем СервисЗаполненияПараметров;

&Опция(Имя = "project-name", Описание = "Имя проекта в workspace 1С:EDT для экспорта")
&ТСтрока
&Обязательный
Перем ИмяПроекта;

&Аргумент(Имя = "OUT", Описание = "Каталог для результата экспорта в XML")
&ТСтрока
&Обязательный
Перем КаталогНазначения;

&НаборОпций("НаборОпцийEDT")
Перем ОпцииEDT;

&НаборОпций("НаборОпцийНастроек")
Перем ОпцииНастроек; // BSLLS:UnusedLocalVariable-off

&ПодкомандаПриложения(Имя = "export", Родитель = "КомандаEdt", Описание = "Экспорт EDT-проекта в XML Конфигуратора")
&ДоступноВMCP
&MCPДлительная
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);

	Лог.Отладка("Начало выполнения команды edt export");
	Лог.Отладка("Имя проекта: %1", ИмяПроекта);
	Лог.Отладка("Каталог назначения: %1", КаталогНазначения);

	ПараметрыEDT = ОпцииEDT.СформироватьПараметры();

	ДатаНачала = ТекущаяУниверсальнаяДата();
	СервисEDT.ЭкспортироватьПроектПоИмени(ИмяПроекта, КаталогНазначения, ПараметрыEDT);
	ДлительностьСек = ТекущаяУниверсальнаяДата() - ДатаНачала;

	Лог.Информация("Экспорт EDT-проекта '%1' завершён за %2с. Результат: %3",
		ИмяПроекта, Окр(ДлительностьСек), КаталогНазначения);

КонецПроцедуры
