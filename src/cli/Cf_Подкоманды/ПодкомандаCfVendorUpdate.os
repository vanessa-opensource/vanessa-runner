// BSLLS:NumberOfValuesInStructureConstructor-off
// BSLLS-off
&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисКонфигурации;

&Пластилин
Перем СервисПлатформы;

&Пластилин
Перем СервисЗаполненияПараметров;

&Пластилин
Перем ФайловыеОперации;

&НаборОпций("НаборОпцийПодключения")
Перем ОпцииПодключения;

&НаборОпций("НаборОпцийПлатформы")
Перем ОпцииПлатформы;

&НаборОпций("НаборОпцийСУБД")
Перем ОпцииСУБД;

&Опция(Имя = "s src", Описание = "Путь к файлу обновления (cfu) или полному дистрибутиву поставщика (cf); в имени файла допустим шаблон $version, из подходящих файлов берётся старшая версия")
&ТСтрока
&Обязательный
Перем ПутьКФайлу;

&Опция(Имя = "update-settings", Описание = "Путь к файлу настроек объединения")
&ТСтрока
Перем ФайлНастроек;

&Опция(Имя = "IncludeObjectsByUnresolvedRefs", Описание = "Включить объекты с неразрешёнными ссылками в объединение")
&Флаговый
Перем IncludeObjectsByUnresolvedRefs;

&Опция(Имя = "ClearUnresolvedRefs", Описание = "Очищать ссылки на объекты с неразрешёнными ссылками")
&Флаговый
Перем ClearUnresolvedRefs;

&Опция(Имя = "DumpListOfTwiceChangedProperties", Описание = "Вывести список дважды изменённых свойств в файл служебных сообщений")
&Флаговый
Перем ВывестиДваждыИзмененныеСвойства;

&Опция(Имя = "force", Описание = "Принудительное обновление при наличии предупреждений")
&Флаговый
Перем Принудительно;

&Опция(Имя = "no-update-db",
		Описание = "Не обновлять конфигурацию БД после обновления (по умолчанию БД обновляется: UpdateDBCfg)")
&Флаговый
Перем НеОбновлятьБД;

&НаборОпций("НаборОпцийОбновленияБД")
Перем ОпцииОбновленияБД;

&НаборОпций("НаборОпцийНастроек")
Перем ОпцииНастроек; // BSLLS:UnusedLocalVariable-off

&ПодкомандаПриложения(Имя = "vendor-update", Родитель = "КомандаCf", Описание = "Обновить конфигурацию на поддержке из cf/cfu-файла поставщика")
&ДоступноВMCP
&MCPДлительная
&MCPРазрушающая
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);

	Лог.Отладка("Начало выполнения команды cf vendor-update");

	ПроверитьЗаполненность(ОпцииПодключения.СтрокаПодключения,
		"Не задана строка подключения к базе (--ibconnection). Для команды vendor-update строка подключения обязательна.");
	ПутьКФайлу = ФайловыеОперации.НайтиФайлПоШаблонуВерсии(ПутьКФайлу);
	ПроверитьСуществованиеФайла(ПутьКФайлу);

	ПараметрыПлатформы = Новый Структура(
		"ВерсияПлатформы, КодРазрешения, Язык, Локаль",
		ОпцииПлатформы.ВерсияПлатформы,
		ОпцииПлатформы.КодРазрешения,
		ОпцииПлатформы.Язык,
		ОпцииПлатформы.Локаль
	);

	ПараметрыПодключения = Новый Структура(
		"СтрокаПодключения, Пользователь, Пароль",
		ОпцииПодключения.СтрокаПодключения,
		ОпцииПодключения.Пользователь,
		ОпцииПодключения.Пароль
	);
	ОпцииСУБД.ДополнитьПараметрыПодключения(ПараметрыПодключения);

	ВключитьВОбъединениеПоНеразрешеннымСсылкам = ВычислитьВключитьПоНеразрешеннымСсылкам();

	СервисКонфигурации.ОбновитьКонфигурациюИзФайла(
		ПараметрыПодключения,
		ПутьКФайлу,
		ФайлНастроек,
		ВключитьВОбъединениеПоНеразрешеннымСсылкам,
		Принудительно = Истина,
		ВывестиДваждыИзмененныеСвойства = Истина,
		ПараметрыПлатформы
	);

	Если НеОбновлятьБД Тогда
		Лог.Информация("Обновление конфигурации БД пропущено (--no-update-db)");
		Возврат;
	КонецЕсли;

	НастройкиОбновления = ОпцииОбновленияБД.СформироватьНастройкиОбновления();
	Лог.Информация("Обновление основной конфигурации БД (restr=%1)", НастройкиОбновления.РежимРеструктуризации);
	СервисПлатформы.ОбновитьКонфигурациюБД(
		ПараметрыПодключения,
		Ложь,
		ПараметрыПлатформы,
		НастройкиОбновления);

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьЗаполненность(Значение, Сообщение)
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		ВызватьИсключение Сообщение;
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьСуществованиеФайла(Знач Путь)

	Файл = Новый Файл(Путь);
	Если НЕ Файл.Существует() Тогда
		ВызватьИсключение СтрШаблон("Файл обновления конфигурации не найден: %1", Путь);
	КонецЕсли;

КонецПроцедуры

Функция ВычислитьВключитьПоНеразрешеннымСсылкам()
	Если IncludeObjectsByUnresolvedRefs = Истина Тогда
		Возврат Истина;
	ИначеЕсли ClearUnresolvedRefs = Истина Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

#КонецОбласти
