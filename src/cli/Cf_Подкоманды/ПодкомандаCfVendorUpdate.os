// BSLLS:LineLength-off Длинные описания &Опция нужны для понятной справки.
// BSLLS:MissingVariablesDescription-off Поля &Опция/&НаборОпций - описания заданы в самой аннотации.
&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисКонфигурации;

&Пластилин
Перем СервисПлатформы;

&Пластилин
Перем СервисЗаполненияПараметров;

&Пластилин
Перем ФайловыеОперации;

&Опция(Имя = "src s", Описание = "Путь к файлу обновления (cfu) или полному дистрибутиву поставщика (cf); в имени файла допустим шаблон $version, из подходящих файлов берётся старшая версия")
&ТСтрока
&Обязательный
Перем ПутьКФайлу;

&Опция(Имя = "update-settings", Описание = "Путь к файлу настроек объединения")
&ТСтрока
Перем ФайлНастроек;

&Опция(Имя = "DumpListOfTwiceChangedProperties", Описание = "Вывести список дважды изменённых свойств в файл служебных сообщений")
&Флаговый
Перем ВывестиДваждыИзмененныеСвойства;

&Опция(Имя = "force", Описание = "Принудительное обновление при наличии предупреждений")
&Флаговый
Перем Принудительно;

&Опция(Имя = "no-update-db",
		Описание = "Не обновлять конфигурацию БД после обновления (по умолчанию БД обновляется: UpdateDBCfg)")
&Флаговый
Перем НеОбновлятьБД;

&НаборОпций("НаборОпцийНеразрешенныхСсылок")
Перем ОпцииНеразрешенныхСсылок;

&НаборОпций("НаборОпцийПодключения")
Перем ОпцииПодключения;

&НаборОпций("НаборОпцийПлатформы")
Перем ОпцииПлатформы;

&НаборОпций("НаборОпцийСУБД")
Перем ОпцииСУБД;

&НаборОпций("НаборОпцийОбновленияБД")
Перем ОпцииОбновленияБД;

&НаборОпций("НаборОпцийНастроек")
Перем ОпцииНастроек; // BSLLS:UnusedLocalVariable-off

&ПодкомандаПриложения(Имя = "vendor-update", Родитель = "КомандаCf", Описание = "Обновить конфигурацию на поддержке из cf/cfu-файла поставщика")
&ДоступноВMCP
&MCPДлительная
&MCPРазрушающая
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);

	Лог.Отладка("Начало выполнения команды cf vendor-update");

	Если НЕ ЗначениеЗаполнено(ОпцииПодключения.СтрокаПодключения) Тогда
		ВызватьИсключение "Не задана строка подключения к базе (--ibconnection)."
			+ " Для команды vendor-update строка подключения обязательна.";
	КонецЕсли;
	ПутьКФайлу = ФайловыеОперации.НайтиФайлПоШаблонуВерсии(ПутьКФайлу);
	ФайловыеОперации.ПроверитьСуществованиеФайла(ПутьКФайлу, "Файл обновления конфигурации не найден: %1");

	ПараметрыПлатформы = ОпцииПлатформы.СформироватьПараметрыПлатформы();
	ПараметрыПодключения = ОпцииПодключения.ПараметрыПодключения(ОпцииСУБД);

	ВключитьВОбъединениеПоНеразрешеннымСсылкам = ОпцииНеразрешенныхСсылок.ВключитьПоНеразрешеннымСсылкам();
	// BSLLS:CompareWithBoolean-off флаги могут быть Неопределено
	ОбновлятьПринудительно = (Принудительно = Истина);
	ВыводитьДваждыИзмененныеСвойства = (ВывестиДваждыИзмененныеСвойства = Истина);
	// BSLLS:CompareWithBoolean-on

	СервисКонфигурации.ОбновитьКонфигурациюИзФайла(
		ПараметрыПодключения,
		ПутьКФайлу,
		ФайлНастроек,
		ВключитьВОбъединениеПоНеразрешеннымСсылкам,
		ОбновлятьПринудительно,
		ВыводитьДваждыИзмененныеСвойства,
		ПараметрыПлатформы);

	Если НеОбновлятьБД Тогда
		Лог.Информация("Обновление конфигурации БД пропущено (--no-update-db)");
		Возврат;
	КонецЕсли;

	НастройкиОбновления = ОпцииОбновленияБД.СформироватьНастройкиОбновления();
	Лог.Информация("Обновление основной конфигурации БД (restr=%1)", НастройкиОбновления.РежимРеструктуризации);
	СервисПлатформы.ОбновитьКонфигурациюБД(
		ПараметрыПодключения,
		Ложь,
		ПараметрыПлатформы,
		НастройкиОбновления);

КонецПроцедуры
