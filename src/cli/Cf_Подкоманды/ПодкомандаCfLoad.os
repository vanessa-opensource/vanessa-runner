&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисКонфигурации;

&Пластилин
Перем СервисПлатформы;

&Пластилин
Перем СервисЗаполненияПараметров;

&Пластилин
Перем СервисОкружения;

&НаборОпций("НаборОпцийПодключения")
Перем ОпцииПодключения;

&НаборОпций("НаборОпцийПлатформы")
Перем ОпцииПлатформы;

&НаборОпций("НаборОпцийСУБД")
Перем ОпцииСУБД;

&Аргумент(Имя = "SRC", Описание = "Каталог исходников конфигурации или файл cf")
&ТСтрока
Перем Источник;

&Опция(Имя = "list", Описание = "Список файлов для выборочной загрузки")
&ТСтрока
Перем СписокФайлов;

&Опция(Имя = "increment", Описание = "Инкрементальная загрузка по индексу изменений")
&Флаговый
Перем Инкремент;

&Опция(Имя = "update-db", Описание = "После загрузки обновить конфигурацию БД (UpdateDBCfg / config apply)")
&Флаговый
Перем ОбновитьБД;

&НаборОпций("НаборОпцийОбновленияБД")
Перем ОпцииОбновленияБД;

&ПодкомандаПриложения(Имя = "load", Родитель = "КомандаCf", Описание = "Загрузить конфигурацию в базу из файлов исходников или cf-файла")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);

	ПутьИсточника = ИсточникИлиТекущийКаталог();

	Лог.Отладка("Начало выполнения команды cf load");
	Лог.Отладка("Источник: %1", ПутьИсточника);

	ПараметрыПлатформы = Новый Структура(
		"ВерсияПлатформы, КодРазрешения, Язык, Локаль",
		ОпцииПлатформы.ВерсияПлатформы,
		ОпцииПлатформы.КодРазрешения,
		ОпцииПлатформы.Язык,
		ОпцииПлатформы.Локаль
	);

	ПараметрыПодключения = Новый Структура(
		"СтрокаПодключения, Пользователь, Пароль",
		ОпцииПодключения.СтрокаПодключения,
		ОпцииПодключения.Пользователь,
		ОпцииПодключения.Пароль
	);
	ОпцииСУБД.ДополнитьПараметрыПодключения(ПараметрыПодключения);

	Если ЭтоФайлCf(ПутьИсточника) Тогда
		ПроверитьСуществованиеФайла(ПутьИсточника);
		СервисКонфигурации.ЗагрузитьКонфигурациюИзФайла(
			ПараметрыПодключения,
			ПутьИсточника,
			ОпцииПодключения.ИспользоватьIbcmd,
			ПараметрыПлатформы
		);
	Иначе
		ПроверитьСуществованиеКаталога(ПутьИсточника);
		СервисКонфигурации.ЗагрузитьКонфигурациюИзФайлов(
			ПараметрыПодключения,
			ПутьИсточника,
			ОпцииПодключения.ИспользоватьIbcmd,
			ПараметрыПлатформы,
			СписокФайлов,
			Инкремент
		);
	КонецЕсли;

	Если ОбновитьБД = Истина Тогда
		НастройкиОбновления = ОпцииОбновленияБД.СформироватьНастройкиОбновления();
		Лог.Информация("Обновление основной конфигурации БД (restr=%1)", НастройкиОбновления.РежимРеструктуризации);
		СервисПлатформы.ОбновитьКонфигурациюБД(
			ПараметрыПодключения,
			ОпцииПодключения.ИспользоватьIbcmd,
			ПараметрыПлатформы,
			НастройкиОбновления
		);
	КонецЕсли;

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Функция ИсточникИлиТекущийКаталог()

	Если ЗначениеЗаполнено(Источник) Тогда
		Возврат Источник;
	КонецЕсли;

	Возврат СервисОкружения.РабочийКаталог();

КонецФункции

Функция ЭтоФайлCf(Знач Путь)
	Возврат СтрЗаканчиваетсяНа(НРег(Путь), ".cf");
КонецФункции

Процедура ПроверитьСуществованиеФайла(Знач Путь)

	Файл = Новый Файл(Путь);
	Если НЕ Файл.Существует() Тогда
		ВызватьИсключение СтрШаблон("Файл конфигурации не найден: %1", Путь);
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьСуществованиеКаталога(Знач Путь)

	Каталог = Новый Файл(Путь);
	Если НЕ Каталог.Существует() ИЛИ НЕ Каталог.ЭтоКаталог() Тогда
		ВызватьИсключение СтрШаблон("Каталог исходников не найден: %1", Путь);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
