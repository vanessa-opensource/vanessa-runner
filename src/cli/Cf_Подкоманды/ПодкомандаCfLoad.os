// BSLLS:LineLength-off
// BSLLS:MissingVariablesDescription-off Поля &Опция/&Аргумент/&НаборОпций - описания заданы в самой аннотации.
&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисКонфигурации;

&Пластилин
Перем СервисПлатформы;

&Пластилин
Перем СервисЗаполненияПараметров;

&Пластилин
Перем СервисОкружения;

&НаборОпций("НаборОпцийПодключения")
Перем ОпцииПодключения;

&НаборОпций("НаборОпцийIbcmd")
Перем ОпцииIbcmd;

&НаборОпций("НаборОпцийПлатформы")
Перем ОпцииПлатформы;

&НаборОпций("НаборОпцийСУБД")
Перем ОпцииСУБД;

&Аргумент(Имя = "SRC", Описание = "Каталог исходников конфигурации или файл cf (по умолчанию - текущий каталог)")
&ТСтрока
&Обязательный(Ложь)
Перем Источник;

&Опция(Имя = "list", Описание = "Список файлов для выборочной загрузки")
&ТСтрока
Перем СписокФайлов;

&Опция(Имя = "increment", Описание = "Инкрементальная загрузка по индексу изменений")
&Флаговый
Перем Инкремент;

&Опция(Имя = "no-update-db",
		Описание = "Не обновлять конфигурацию БД после загрузки (по умолчанию БД обновляется: UpdateDBCfg / config apply)")
&Флаговый
Перем НеОбновлятьБД;

&НаборОпций("НаборОпцийОбновленияБД")
Перем ОпцииОбновленияБД;

&НаборОпций("НаборОпцийИсходников")
Перем ОпцииИсходников;

&НаборОпций("НаборОпцийНастроек")
Перем ОпцииНастроек; // BSLLS:UnusedLocalVariable-off

&ПодкомандаПриложения(Имя = "load", Родитель = "КомандаCf", Описание = "Загрузить конфигурацию в базу из файлов исходников или cf-файла")
&ДоступноВMCP
&MCPДлительная
&MCPРазрушающая
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);

	ПутьИсточника = СервисОкружения.ПутьИлиРабочийКаталог(Источник);

	Лог.Отладка("Начало выполнения команды cf load");
	Лог.Отладка("Источник: %1", ПутьИсточника);

	ПараметрыПлатформы = ОпцииПлатформы.СформироватьПараметрыПлатформы(ОпцииIbcmd);

	ПараметрыПодключения = ОпцииПодключения.ПараметрыПодключения(ОпцииСУБД);

	СервисКонфигурации.ЗагрузитьИсточник(
		ПараметрыПодключения,
		ПутьИсточника,
		ПараметрыПлатформы,
		ОпцииИсходников.СформироватьПараметрыИсходников(),
		Инкремент,
		СписокФайлов);

	Если НеОбновлятьБД Тогда
		Лог.Информация("Обновление конфигурации БД пропущено (--no-update-db)");
		Возврат;
	КонецЕсли;

	НастройкиОбновления = ОпцииОбновленияБД.СформироватьНастройкиОбновления();
	Лог.Информация("Обновление основной конфигурации БД (restr=%1)", НастройкиОбновления.РежимРеструктуризации);
	СервисПлатформы.ОбновитьКонфигурациюБД(
		ПараметрыПодключения,
		ПараметрыПлатформы,
		НастройкиОбновления);

КонецПроцедуры
