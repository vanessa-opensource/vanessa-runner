// BSLLS:MissingVariablesDescription-off Поля &Опция/&НаборОпций - описания заданы в самой аннотации.
&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисКонфигурации;

&Пластилин
Перем СервисЗаполненияПараметров;

&Опция(Имя = "src s",
		Описание = "Путь к файлу конфигурации (cf). Обязательна: задаётся в командной строке или в файле настроек")
&ТСтрока
&Обязательный(Ложь)
Перем ПутьКCf;

&Опция(Имя = "merge-settings",
		Описание = "Путь к файлу настроек объединения. Обязательна: задаётся в командной строке или в файле настроек")
&ТСтрока
&Обязательный(Ложь)
Перем ФайлНастроек;

&Опция(Имя = "enable-support", Описание = "Поставить конфигурацию на поддержку")
&Флаговый
Перем ВключитьПоддержку;

&Опция(Имя = "disable-support", Описание = "Снять конфигурацию с поддержки")
&Флаговый
Перем ОтключитьПоддержку;

&Опция(Имя = "force", Описание = "Принудительное объединение при наличии предупреждений")
&Флаговый
Перем Принудительно;

&НаборОпций("НаборОпцийНеразрешенныхСсылок")
Перем ОпцииНеразрешенныхСсылок;

&НаборОпций("НаборОпцийПодключения")
Перем ОпцииПодключения;

&НаборОпций("НаборОпцийПлатформы")
Перем ОпцииПлатформы;

&НаборОпций("НаборОпцийСУБД")
Перем ОпцииСУБД;

&НаборОпций("НаборОпцийНастроек")
Перем ОпцииНастроек; // BSLLS:UnusedLocalVariable-off

&ПодкомандаПриложения(Имя = "merge", Родитель = "КомандаCf", Описание = "Объединить конфигурацию базы с cf-файлом")
&ДоступноВMCP
&MCPДлительная
&MCPРазрушающая
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);
	СервисЗаполненияПараметров.ПроверитьЗаполнениеОпции(ЭтотОбъект, "src");
	СервисЗаполненияПараметров.ПроверитьЗаполнениеОпции(ЭтотОбъект, "merge-settings");

	Лог.Отладка("Начало выполнения команды cf merge");

	Если НЕ ЗначениеЗаполнено(ОпцииПодключения.СтрокаПодключения) Тогда
		ВызватьИсключение "Не задана строка подключения к базе (--ibconnection)."
			+ " Для команды merge строка подключения обязательна.";
	КонецЕсли;

	ПараметрыПлатформы = ОпцииПлатформы.СформироватьПараметрыПлатформы();
	ПараметрыПодключения = ОпцииПодключения.ПараметрыПодключения(ОпцииСУБД);

	ПоставитьНаПоддержку = ВычислитьПоставитьНаПоддержку();
	ВключитьВОбъединениеПоНеразрешеннымСсылкам = ОпцииНеразрешенныхСсылок.ВключитьПоНеразрешеннымСсылкам();
	ОбъединятьПринудительно = (Принудительно = Истина); // BSLLS:CompareWithBoolean-off флаг может быть Неопределено

	СервисКонфигурации.ОбъединитьКонфигурациюСФайлом(
		ПараметрыПодключения,
		ПутьКCf,
		ФайлНастроек,
		ПоставитьНаПоддержку,
		ВключитьВОбъединениеПоНеразрешеннымСсылкам,
		ОбъединятьПринудительно,
		ПараметрыПлатформы);

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Функция ВычислитьПоставитьНаПоддержку()

	// BSLLS:CompareWithBoolean-off флаги могут быть Неопределено
	Если ВключитьПоддержку = Истина Тогда
		Возврат Истина;
	ИначеЕсли ОтключитьПоддержку = Истина Тогда
		Возврат Ложь;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	// BSLLS:CompareWithBoolean-on

КонецФункции

#КонецОбласти
