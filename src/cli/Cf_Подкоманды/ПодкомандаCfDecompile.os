// BSLLS:NumberOfValuesInStructureConstructor-off
// BSLLS:MissingVariablesDescription-off Поля &Опция/&Аргумент/&НаборОпций - описания заданы в самой аннотации.
&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисКонфигурации;

&Пластилин
Перем СервисЗаполненияПараметров;

&НаборОпций("НаборОпцийПодключения")
Перем ОпцииПодключения;

&НаборОпций("НаборОпцийПлатформы")
Перем ОпцииПлатформы;

&НаборОпций("НаборОпцийСУБД")
Перем ОпцииСУБД;

&Опция(Имя = "cf-file", Описание = "Путь к файлу конфигурации (*.cf)")
&ТСтрока
&ВОкружении("VRUNNER_CF_FILE")
&Обязательный
Перем ПутьКФайлуCf;

&Аргумент(Имя = "OUT", Описание = "Каталог выгрузки исходников конфигурации")
&ТСтрока
&Обязательный
Перем КаталогВыгрузки;

&НаборОпций("НаборОпцийИсходников")
Перем ОпцииИсходников;

&НаборОпций("НаборОпцийНастроек")
Перем ОпцииНастроек; // BSLLS:UnusedLocalVariable-off

&ПодкомандаПриложения(Имя = "decompile", Родитель = "КомандаCf", Описание = "Разобрать конфигурацию в исходники")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);

	Лог.Отладка("Начало выполнения команды cf decompile");
	Лог.Отладка("Файл cf: %1", ПутьКФайлуCf);
	Лог.Отладка("Каталог выгрузки: %1", КаталогВыгрузки);

	ПроверитьПараметры();

	ПараметрыПлатформы = Новый Структура(
		"ВерсияПлатформы, КодРазрешения, Язык, Локаль",
		ОпцииПлатформы.ВерсияПлатформы,
		ОпцииПлатформы.КодРазрешения,
		ОпцииПлатформы.Язык,
		ОпцииПлатформы.Локаль);

	ПараметрыПодключения = Неопределено;
	Если ЗначениеЗаполнено(ОпцииПодключения.СтрокаПодключения)
		ИЛИ ЗначениеЗаполнено(ОпцииСУБД.ТипСУБД) Тогда
		ПараметрыПодключения = Новый Структура(
			"СтрокаПодключения, Пользователь, Пароль",
			ОпцииПодключения.СтрокаПодключения,
			ОпцииПодключения.Пользователь,
			ОпцииПодключения.Пароль);
		ОпцииСУБД.ДополнитьПараметрыПодключения(ПараметрыПодключения);
	КонецЕсли;

	СервисКонфигурации.РазобратьИзФайлаCf(
		ПутьКФайлуCf,
		КаталогВыгрузки,
		ОпцииПодключения.ИспользоватьIbcmd,
		ПараметрыПлатформы,
		ПараметрыПодключения,
		ОпцииИсходников.СформироватьПараметрыИсходников());

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьПараметры()

	Файл = Новый Файл(ПутьКФайлуCf);
	Если НЕ Файл.Существует() Тогда
		ВызватьИсключение СтрШаблон("Файл конфигурации не найден: %1", ПутьКФайлуCf);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
