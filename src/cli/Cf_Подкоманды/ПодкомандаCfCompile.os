// BSLLS:MissingVariablesDescription-off Поля &Опция/&Аргумент/&НаборОпций - описания заданы в самой аннотации.
&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисКонфигурации;

&Пластилин
Перем СервисЗаполненияПараметров;

&Пластилин
Перем СервисОкружения;

&НаборОпций("НаборОпцийПодключения")
Перем ОпцииПодключения;

&НаборОпций("НаборОпцийIbcmd")
Перем ОпцииIbcmd;

&НаборОпций("НаборОпцийПлатформы")
Перем ОпцииПлатформы;

&НаборОпций("НаборОпцийСУБД")
Перем ОпцииСУБД;

&Аргумент(Имя = "OUT",
	Описание = "Путь к файлу cf (*.cf). Обязателен: задаётся в командной строке или в файле настроек")
&ТСтрока
&ВОкружении("VRUNNER_CF_OUT")
&Обязательный(Ложь)
Перем ПутьКФайлуCf;

&Опция(Имя = "src s", Описание = "Каталог исходников конфигурации (по умолчанию - текущий каталог)")
&ТСтрока
&ВОкружении("VRUNNER_SRC")
Перем КаталогИсходников;

&Опция(Имя = "list", Описание = "Список файлов для выборочной загрузки")
&ТСтрока
Перем СписокФайлов;

&НаборОпций("НаборОпцийИсходников")
Перем ОпцииИсходников;

&НаборОпций("НаборОпцийНастроек")
Перем ОпцииНастроек; // BSLLS:UnusedLocalVariable-off

&ПодкомандаПриложения(Имя = "compile", Родитель = "КомандаCf", Описание = "Собрать конфигурацию из исходников")
&ДоступноВMCP
&MCPДлительная
&MCPЗаголовок("Сборка конфигурации (.cf) из исходников")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);
	СервисЗаполненияПараметров.ПроверитьЗаполнениеАргумента(ЭтотОбъект, "OUT");

	КаталогSrc = СервисОкружения.ПутьИлиРабочийКаталог(КаталогИсходников);

	Лог.Отладка("Начало выполнения команды cf compile");
	Лог.Отладка("Каталог исходников: %1", КаталогSrc);
	Лог.Отладка("Путь к файлу cf: %1", ПутьКФайлуCf);
	Лог.Отладка("Использовать ibcmd: %1", Формат(ОпцииIbcmd.ИспользоватьIbcmd, "БЛ=Ложь; БИ=Истина"));

	ПараметрыПлатформы = ОпцииПлатформы.СформироватьПараметрыПлатформы();

	ПараметрыПодключения = ОпцииПодключения.ПараметрыПодключенияЕслиЗаданы(ОпцииСУБД);

	СервисКонфигурации.СобратьВФайлCf(
		КаталогSrc,
		ПутьКФайлуCf,
		ОпцииIbcmd.ИспользоватьIbcmd,
		ПараметрыПлатформы,
		СписокФайлов,
		ПараметрыПодключения,
		ОпцииИсходников.СформироватьПараметрыИсходников());

КонецПроцедуры
