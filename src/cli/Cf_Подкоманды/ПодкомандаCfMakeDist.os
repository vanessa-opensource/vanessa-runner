// BSLLS:MissingVariablesDescription-off Поля &Опция/&Аргумент/&НаборОпций - описания заданы в самой аннотации.

&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисКонфигурации;

&Пластилин
Перем СервисЗаполненияПараметров;

&Пластилин
Перем ФайловыеОперации;

&НаборОпций("НаборОпцийПодключения")
Перем ОпцииПодключения;

&НаборОпций("НаборОпцийПлатформы")
Перем ОпцииПлатформы;

&НаборОпций("НаборОпцийСУБД")
Перем ОпцииСУБД;

&Аргумент(Имя = "OUT",
	Описание = "Путь к файлу поставки конфигурации (*.cf). Обязателен: задаётся в командной строке или в файле настроек")
&ТСтрока
&Обязательный(Ложь)
Перем ПутьКФайлуПоставки;

&НаборОпций("НаборОпцийНастроек")
Перем ОпцииНастроек; // BSLLS:UnusedLocalVariable-off

&ПодкомандаПриложения(Имя = "make-dist", Родитель = "КомандаCf", Описание = "Создать файл поставки конфигурации")
&ДоступноВMCP
&MCPДлительная
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);
	СервисЗаполненияПараметров.ПроверитьЗаполнениеАргумента(ЭтотОбъект, "OUT");

	ФайловыеОперации.ПроверитьРасширениеФайла(ПутьКФайлуПоставки, ".cf");

	Лог.Отладка("Начало выполнения команды cf make-dist");
	Лог.Отладка("Путь к файлу поставки: %1", ПутьКФайлуПоставки);

	ПараметрыПлатформы = ОпцииПлатформы.СформироватьПараметрыПлатформы();

	Если НЕ ЗначениеЗаполнено(ОпцииПодключения.СтрокаПодключения) Тогда
		ВызватьИсключение "Для создания файла поставки укажите информационную базу через --ibconnection.";
	КонецЕсли;

	ПараметрыПодключения = ОпцииПодключения.ПараметрыПодключения(ОпцииСУБД);

	СервисКонфигурации.СоздатьФайлПоставки(
		ПараметрыПодключения,
		ПутьКФайлуПоставки,
		ПараметрыПлатформы);

КонецПроцедуры
