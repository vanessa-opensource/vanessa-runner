// Опции: --ibconnection, --db-user, --db-pwd, --v8version,
//        --cf-file (выход, $version), --src, --build-number

&Пластилин
Перем СервисЗаполненияПараметров;

&НаборОпций("НаборОпцийНастроек")
Перем ОпцииНастроек; // BSLLS:UnusedLocalVariable-off

&ПодкомандаПриложения(Имя = "make-dist", Родитель = "КомандаCf", Описание = "Создать файл поставки конфигурации")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);

	ВызватьИсключение "Команда cf make-dist ещё не реализована";
КонецПроцедуры
