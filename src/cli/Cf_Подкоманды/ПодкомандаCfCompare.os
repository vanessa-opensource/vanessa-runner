// BSLLS:NumberOfValuesInStructureConstructor-off
// BSLLS-off
&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисКонфигурации;

&Пластилин
Перем СервисЗаполненияПараметров;

&Пластилин
Перем СервисОкружения;

&НаборОпций("НаборОпцийПодключения")
Перем ОпцииПодключения;

&НаборОпций("НаборОпцийПлатформы")
Перем ОпцииПлатформы;

&НаборОпций("НаборОпцийСУБД")
Перем ОпцииСУБД;

&Опция(Имя = "second-cf", Описание = "Путь ко второму cf-файлу (с чем сравниваем)")
&ТСтрока
&Обязательный
Перем ПутьКВторомуCf;

&Опция(Имя = "first-cf", Описание = "Путь к первому cf-файлу; если не задан - сравнивается конфигурация базы")
&ТСтрока
Перем ПутьКПервомуCf;

&Опция(Имя = "report-dir", Описание = "Каталог для сохранения отчёта (по умолчанию - текущий каталог)")
&ТСтрока
Перем КаталогОтчёта;

&Опция(Имя = "report-type", Описание = "Тип отчёта")
&ТПеречисление
&Перечисление(Имя = "Full", Описание = "Полный отчёт")
&Перечисление(Имя = "Brief", Описание = "Краткий отчёт")
&ПоУмолчанию("Full")
Перем ТипОтчёта;

&Опция(Имя = "report-format", Описание = "Формат файла отчёта")
&ТПеречисление
&Перечисление(Имя = "txt", Описание = "Текстовый файл")
&Перечисление(Имя = "mxl", Описание = "Табличный документ")
&ПоУмолчанию("txt")
Перем ФорматОтчёта;

&НаборОпций("НаборОпцийНастроек")
Перем ОпцииНастроек; // BSLLS:UnusedLocalVariable-off

&ПодкомандаПриложения(Имя = "compare", Родитель = "КомандаCf", Описание = "Сравнить конфигурации и сформировать отчёт")
&ДоступноВMCP
&MCPДлительная
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);

	Лог.Отладка("Начало выполнения команды cf compare");

	ПроверитьЗаполненность(ПутьКВторомуCf,
		"Не задан второй cf-файл (--second-cf).");

	РежимСравненияСБазой = НЕ ЗначениеЗаполнено(ПутьКПервомуCf);
	Если РежимСравненияСБазой Тогда
		ПроверитьЗаполненность(ОпцииПодключения.СтрокаПодключения,
			"При сравнении с базой (без --first-cf) строка подключения обязательна (--ibconnection).");
	КонецЕсли;

	ПараметрыПлатформы = Новый Структура(
		"ВерсияПлатформы, КодРазрешения, Язык, Локаль",
		ОпцииПлатформы.ВерсияПлатформы,
		ОпцииПлатформы.КодРазрешения,
		ОпцииПлатформы.Язык,
		ОпцииПлатформы.Локаль
	);

	ПараметрыПодключения = Новый Структура(
		"СтрокаПодключения, Пользователь, Пароль",
		ОпцииПодключения.СтрокаПодключения,
		ОпцииПодключения.Пользователь,
		ОпцииПодключения.Пароль
	);
	ОпцииСУБД.ДополнитьПараметрыПодключения(ПараметрыПодключения);

	ЭффКаталогОтчёта = ?(ЗначениеЗаполнено(КаталогОтчёта), КаталогОтчёта, СервисОкружения.РабочийКаталог());
	ЭффТипОтчёта    = ?(ЗначениеЗаполнено(ТипОтчёта),    ТипОтчёта,    "Full");
	ЭффФорматОтчёта = ?(ЗначениеЗаполнено(ФорматОтчёта), ФорматОтчёта, "txt");

	ПутьОтчёта = СервисКонфигурации.СравнитьКонфигурации(
		ПараметрыПодключения,
		ПутьКВторомуCf,
		ЭффКаталогОтчёта,
		ЭффТипОтчёта,
		ЭффФорматОтчёта,
		ПутьКПервомуCf,
		ПараметрыПлатформы
	);

	Лог.Информация("Отчёт о сравнении сохранён: %1", ПутьОтчёта);

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьЗаполненность(Значение, Сообщение)
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		ВызватьИсключение Сообщение;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
