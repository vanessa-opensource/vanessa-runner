// BSLLS:MissingVariablesDescription-off Поля &Опция/&НаборОпций - описания заданы в самой аннотации.
&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисКонфигурации;

&Пластилин
Перем СервисЗаполненияПараметров;

&Опция(Имя = "second-cf", Описание = "Путь ко второму cf-файлу (с чем сравниваем)")
&ТСтрока
&Обязательный
Перем ПутьКВторомуCf;

&Опция(Имя = "first-cf", Описание = "Путь к первому cf-файлу; если не задан - сравнивается конфигурация базы")
&ТСтрока
Перем ПутьКПервомуCf;

&НаборОпций("НаборОпцийОтчетаСравнения")
Перем ОпцииОтчета;

&НаборОпций("НаборОпцийПодключения")
Перем ОпцииПодключения;

&НаборОпций("НаборОпцийПлатформы")
Перем ОпцииПлатформы;

&НаборОпций("НаборОпцийСУБД")
Перем ОпцииСУБД;

&НаборОпций("НаборОпцийНастроек")
Перем ОпцииНастроек; // BSLLS:UnusedLocalVariable-off

&ПодкомандаПриложения(Имя = "compare", Родитель = "КомандаCf", Описание = "Сравнить конфигурации и сформировать отчёт")
&ДоступноВMCP
&MCPДлительная
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);

	Лог.Отладка("Начало выполнения команды cf compare");

	РежимСравненияСБазой = НЕ ЗначениеЗаполнено(ПутьКПервомуCf);
	Если РежимСравненияСБазой И НЕ ЗначениеЗаполнено(ОпцииПодключения.СтрокаПодключения) Тогда
		ВызватьИсключение "При сравнении с базой (без --first-cf) строка подключения обязательна (--ibconnection).";
	КонецЕсли;

	ПараметрыПлатформы = ОпцииПлатформы.СформироватьПараметрыПлатформы();
	ПараметрыПодключения = ОпцииПодключения.ПараметрыПодключения(ОпцииСУБД);
	ПараметрыОтчета = ОпцииОтчета.СформироватьПараметрыОтчета();

	ПутьОтчета = СервисКонфигурации.СравнитьКонфигурации(
		ПараметрыПодключения,
		ПутьКВторомуCf,
		ПараметрыОтчета.КаталогОтчета,
		ПараметрыОтчета.ТипОтчета,
		ПараметрыОтчета.ФорматОтчета,
		ПутьКПервомуCf,
		ПараметрыПлатформы);

	Лог.Информация("Отчёт о сравнении сохранён: %1", ПутьОтчета);

КонецПроцедуры
