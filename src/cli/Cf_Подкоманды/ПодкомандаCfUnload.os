// BSLLS:NumberOfValuesInStructureConstructor-off
// BSLLS:MissingVariablesDescription-off Поля &Опция/&Аргумент/&НаборОпций - описания заданы в самой аннотации.
&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисКонфигурации;

&Пластилин
Перем СервисЗаполненияПараметров;

&НаборОпций("НаборОпцийПодключения")
Перем ОпцииПодключения;

&НаборОпций("НаборОпцийIbcmd")
Перем ОпцииIbcmd;

&НаборОпций("НаборОпцийПлатформы")
Перем ОпцииПлатформы;

&НаборОпций("НаборОпцийСУБД")
Перем ОпцииСУБД;

&Аргумент(Имя = "OUT", Описание = "Путь к файлу cf (*.cf)")
&ТСтрока
&Обязательный
Перем ПутьКФайлуCf;

&НаборОпций("НаборОпцийНастроек")
Перем ОпцииНастроек; // BSLLS:UnusedLocalVariable-off

&ПодкомандаПриложения(Имя = "unload", Родитель = "КомандаCf", Описание = "Выгрузить конфигурацию в файл")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);

	Лог.Отладка("Начало выполнения команды cf unload");
	Лог.Отладка("Путь к файлу cf: %1", ПутьКФайлуCf);

	ПроверитьПутьКФайлуCf(ПутьКФайлуCf);

	ПараметрыПлатформы = Новый Структура(
		"ВерсияПлатформы, КодРазрешения, Язык, Локаль",
		ОпцииПлатформы.ВерсияПлатформы,
		ОпцииПлатформы.КодРазрешения,
		ОпцииПлатформы.Язык,
		ОпцииПлатформы.Локаль);

	ПараметрыПодключения = Новый Структура(
		"СтрокаПодключения, Пользователь, Пароль",
		ОпцииПодключения.СтрокаПодключения,
		ОпцииПодключения.Пользователь,
		ОпцииПодключения.Пароль);
	ОпцииСУБД.ДополнитьПараметрыПодключения(ПараметрыПодключения);

	СервисКонфигурации.ВыгрузитьКонфигурациюВФайл(
		ПараметрыПодключения,
		ПутьКФайлуCf,
		ОпцииIbcmd.ИспользоватьIbcmd,
		ПараметрыПлатформы);

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьПутьКФайлуCf(Знач Путь)

	Если НЕ СтрЗаканчиваетсяНа(НРег(Путь), ".cf") Тогда
		ВызватьИсключение СтрШаблон("Файл должен иметь расширение .cf: %1", Путь);
	КонецЕсли;

	КаталогФайла = Новый Файл(Путь).Путь;
	Если ЗначениеЗаполнено(КаталогФайла) Тогда
		КаталогВыхода = Новый Файл(КаталогФайла);
		Если НЕ КаталогВыхода.Существует() Тогда
			ВызватьИсключение СтрШаблон("Каталог для выходного файла не существует: %1", КаталогФайла);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
