// BSLLS:MissingVariablesDescription-off Поля &Опция/&Аргумент/&НаборОпций - описания заданы в самой аннотации.
&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисОбработок;

&Пластилин
Перем СервисЗаполненияПараметров;

&Пластилин
Перем СервисОкружения;

&Пластилин
Перем ФайловыеОперации;

&НаборОпций("НаборОпцийПодключения")
Перем ОпцииПодключения;

&НаборОпций("НаборОпцийIbcmd")
Перем ОпцииIbcmd;

&НаборОпций("НаборОпцийПлатформы")
Перем ОпцииПлатформы;

&НаборОпций("НаборОпцийСУБД")
Перем ОпцииСУБД;

&Аргумент(Имя = "SRC", Описание = "Каталог с исходниками обработки или отчёта (по умолчанию - текущий)")
&ТСтрока
&Обязательный(Ложь)
Перем КаталогИсходников;

&Опция(Имя = "recursive R", Описание = "Рекурсивный поиск обработок и отчётов")
&Флаговый
Перем Рекурсивно;

&Опция(Имя = "out", Описание = "Каталог для сохранения собранных обработок и отчётов")
&ТСтрока
Перем КаталогВыгрузки;

&НаборОпций("НаборОпцийИсходников")
Перем ОпцииИсходников;

&НаборОпций("НаборОпцийНастроек")
Перем ОпцииНастроек; // BSLLS:UnusedLocalVariable-off

&ПодкомандаПриложения(Имя = "compile", Родитель = "КомандаEpf",
	Описание = "Собрать внешние обработки и отчёты из исходников")
&ДоступноВMCP
&MCPДлительная
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);

	КаталогSrc = СервисОкружения.ПутьИлиРабочийКаталог(КаталогИсходников);

	Лог.Отладка("Начало выполнения команды epf compile");
	Лог.Отладка("Каталог исходников: %1", КаталогSrc);
	Лог.Отладка("Рекурсивно: %1", Рекурсивно);
	Лог.Отладка("Каталог выгрузки: %1", КаталогВыгрузки);
	Лог.Отладка("Использовать ibcmd: %1", Формат(ОпцииIbcmd.ИспользоватьIbcmd, "БЛ=Ложь; БИ=Истина"));

	ФайловыеОперации.ПроверитьСуществованиеКаталога(КаталогSrc);

	ПараметрыПлатформы = ОпцииПлатформы.СформироватьПараметрыПлатформы();

	ПараметрыПодключения = ОпцииПодключения.ПараметрыПодключенияЕслиЗаданы(ОпцииСУБД);

	ПараметрыИсходников = ОпцииИсходников.СформироватьПараметрыИсходников();

	Если Рекурсивно = Истина Тогда
		СервисОбработок.СобратьОбработкиРекурсивно(КаталогSrc, КаталогВыгрузки,
			ОпцииIbcmd.ИспользоватьIbcmd, ПараметрыПлатформы, ПараметрыПодключения, ПараметрыИсходников);
	Иначе
		СервисОбработок.СобратьОбработку(КаталогSrc, КаталогВыгрузки,
			ОпцииIbcmd.ИспользоватьIbcmd, ПараметрыПлатформы, ПараметрыПодключения, ПараметрыИсходников);
	КонецЕсли;

КонецПроцедуры
