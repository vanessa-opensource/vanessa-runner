&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисОбработок;

&Пластилин
Перем СервисЗаполненияПараметров;

&Пластилин
Перем СервисОкружения;

&НаборОпций("НаборОпцийПодключения")
Перем ОпцииПодключения;

&НаборОпций("НаборОпцийПлатформы")
Перем ОпцииПлатформы;

&НаборОпций("НаборОпцийСУБД")
Перем ОпцииСУБД;

&Аргумент(Имя = "SRC", Описание = "Каталог с исходниками обработки (по умолчанию — текущий)")
&ТСтрока
Перем КаталогИсходников;

&Опция(Имя = "R recursive", Описание = "Рекурсивный поиск обработок")
&Флаговый
Перем Рекурсивно;

&Опция(Имя = "out", Описание = "Каталог для сохранения собранных обработок")
&ТСтрока
Перем КаталогВыгрузки;

&НаборОпций("НаборОпцийНастроек")
Перем ОпцииНастроек;

&ПодкомандаПриложения(Имя = "compile", Родитель = "КомандаEpf", Описание = "Собрать внешние обработки из исходников")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);

	КаталогSrc = КаталогИсходниковИлиТекущий();

	Лог.Отладка("Начало выполнения команды epf compile");
	Лог.Отладка("Каталог исходников: %1", КаталогSrc);
	Лог.Отладка("Рекурсивно: %1", Рекурсивно);
	Лог.Отладка("Каталог выгрузки: %1", КаталогВыгрузки);
	Лог.Отладка("Использовать ibcmd: %1", Формат(ОпцииПодключения.ИспользоватьIbcmd, "БЛ=Ложь; БИ=Истина"));

	ПроверитьКаталог(КаталогSrc);

	ПараметрыПлатформы = Новый Структура(
		"ВерсияПлатформы, КодРазрешения, Язык, Локаль",
		ОпцииПлатформы.ВерсияПлатформы,
		ОпцииПлатформы.КодРазрешения,
		ОпцииПлатформы.Язык,
		ОпцииПлатформы.Локаль
	);

	ПараметрыПодключения = Неопределено;
	Если ЗначениеЗаполнено(ОпцииПодключения.СтрокаПодключения)
		ИЛИ ЗначениеЗаполнено(ОпцииСУБД.ТипСУБД) Тогда
		ПараметрыПодключения = Новый Структура(
			"СтрокаПодключения, Пользователь, Пароль",
			ОпцииПодключения.СтрокаПодключения,
			ОпцииПодключения.Пользователь,
			ОпцииПодключения.Пароль
		);
		ОпцииСУБД.ДополнитьПараметрыПодключения(ПараметрыПодключения);
	КонецЕсли;

	Если Рекурсивно = Истина Тогда
		СервисОбработок.СобратьОбработкиРекурсивно(КаталогSrc, КаталогВыгрузки,
			ОпцииПодключения.ИспользоватьIbcmd, ПараметрыПлатформы, ПараметрыПодключения);
	Иначе
		СервисОбработок.СобратьОбработку(КаталогSrc, КаталогВыгрузки,
			ОпцииПодключения.ИспользоватьIbcmd, ПараметрыПлатформы, ПараметрыПодключения);
	КонецЕсли;

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Функция КаталогИсходниковИлиТекущий()

	Если ЗначениеЗаполнено(КаталогИсходников) Тогда
		Возврат КаталогИсходников;
	КонецЕсли;

	Возврат СервисОкружения.РабочийКаталог();

КонецФункции

Процедура ПроверитьКаталог(Знач Каталог)

	Файл = Новый Файл(Каталог);
	Если НЕ Файл.Существует() Тогда
		ВызватьИсключение СтрШаблон("Каталог не найден: %1", Каталог);
	КонецЕсли;

	Если НЕ Файл.ЭтоКаталог() Тогда
		ВызватьИсключение СтрШаблон("Указанный путь не является каталогом: %1", Каталог);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
