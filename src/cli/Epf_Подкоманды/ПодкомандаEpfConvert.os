// BSLLS:NumberOfValuesInStructureConstructor-off
// BSLLS:MissingVariablesDescription-off Поля &Опция/&Аргумент/&НаборОпций описаны в аннотациях.
// BSLLS:UnusedLocalVariable-off Поля опций и лог инициализируются autumn-фреймворком через рефлексию.
// Двунаправленная конвертация внешних отчётов и обработок между форматами
// 1С:EDT и XML Конфигуратора (направление определяется автоматически).

&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисОбработок;

&Пластилин
Перем СервисЗаполненияПараметров;

&Опция(Имя = "s src", Описание = "Каталог источника: EDT-проект или XML-дампы (по умолчанию - текущий каталог)")
&ТСтрока
&ВОкружении("VRUNNER_SRC")
Перем КаталогИсходников;

&Аргумент(Имя = "OUT", Описание = "Каталог результата (в противоположном формате)")
&ТСтрока
&Обязательный
Перем КаталогНазначения;

&НаборОпций("НаборОпцийEDT")
Перем ОпцииEDT;

&НаборОпций("НаборОпцийНастроек")
Перем ОпцииНастроек;

&ПодкомандаПриложения(Имя = "convert", Родитель = "КомандаEpf",
	Описание = "Конвертировать внешние объекты между 1С:EDT и XML (направление авто)")
&ДоступноВMCP
&MCPДлительная
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);

	КаталогSrc = ?(ЗначениеЗаполнено(КаталогИсходников), КаталогИсходников, ТекущийКаталог());
	Лог.Отладка("Начало выполнения команды epf convert");
	Лог.Отладка("Каталог источника: %1", КаталогSrc);
	Лог.Отладка("Каталог назначения: %1", КаталогНазначения);

	ПараметрыEDT = ОпцииEDT.СформироватьПараметры();
	ДатаНачала = ТекущаяУниверсальнаяДата();
	Результат = СервисОбработок.КонвертироватьПроектEDT(КаталогSrc, КаталогНазначения, ПараметрыEDT);

	Направление = ?(Результат.ИсходныйФормат = "edt", "EDT → XML", "XML → EDT");
	Лог.Информация("Конвертация %1 завершена: объектов %2, длительность %3с",
		Направление, Результат.Количество, Окр(ТекущаяУниверсальнаяДата() - ДатаНачала));

КонецПроцедуры
