// BSLLS:NumberOfValuesInStructureConstructor-off
// BSLLS:MissingVariablesDescription-off Поля &Опция/&Аргумент/&НаборОпций описаны в аннотациях.
// BSLLS:UnusedLocalVariable-off Поля опций и лог инициализируются autumn-фреймворком через рефлексию.
// Односторонняя конвертация проекта внешних отчётов и обработок 1С:EDT
// в XML-исходники Конфигуратора.

&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисОбработок;

&Пластилин
Перем СервисЗаполненияПараметров;

&Опция(Имя = "s src", Описание = "Каталог EDT-проекта (по умолчанию - текущий каталог)")
&ТСтрока
&ВОкружении("VRUNNER_SRC")
Перем КаталогИсходников;

&Аргумент(Имя = "OUT", Описание = "Каталог для XML-исходников Конфигуратора")
&ТСтрока
&Обязательный
Перем КаталогНазначения;

&НаборОпций("НаборОпцийEDT")
Перем ОпцииEDT;

&НаборОпций("НаборОпцийПодключения")
Перем ОпцииПодключения;

&НаборОпций("НаборОпцийIbcmd")
Перем ОпцииIbcmd;

&НаборОпций("НаборОпцийПлатформы")
Перем ОпцииПлатформы;

&НаборОпций("НаборОпцийСУБД")
Перем ОпцииСУБД;

&НаборОпций("НаборОпцийНастроек")
Перем ОпцииНастроек;

&ПодкомандаПриложения(Имя = "convert", Родитель = "КомандаEpf", Описание = "Конвертировать EDT-проект внешних объектов в XML")
&ДоступноВMCP
&MCPДлительная
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);

	КаталогSrc = ?(ЗначениеЗаполнено(КаталогИсходников), КаталогИсходников, ТекущийКаталог());
	Лог.Отладка("Начало выполнения команды epf convert");
	Лог.Отладка("EDT-проект: %1", КаталогSrc);
	Лог.Отладка("Каталог XML-исходников: %1", КаталогНазначения);

	ПараметрыПлатформы = Новый Структура(
		"ВерсияПлатформы, КодРазрешения, Язык, Локаль",
		ОпцииПлатформы.ВерсияПлатформы,
		ОпцииПлатформы.КодРазрешения,
		ОпцииПлатформы.Язык,
		ОпцииПлатформы.Локаль);

	ПараметрыПодключения = Неопределено;
	Если ЗначениеЗаполнено(ОпцииПодключения.СтрокаПодключения)
		ИЛИ ЗначениеЗаполнено(ОпцииСУБД.ТипСУБД) Тогда
		ПараметрыПодключения = Новый Структура(
			"СтрокаПодключения, Пользователь, Пароль",
			ОпцииПодключения.СтрокаПодключения,
			ОпцииПодключения.Пользователь,
			ОпцииПодключения.Пароль);
		ОпцииСУБД.ДополнитьПараметрыПодключения(ПараметрыПодключения);
	КонецЕсли;

	ПараметрыEDT = ОпцииEDT.СформироватьПараметры();
	ДатаНачала = ТекущаяУниверсальнаяДата();
	Количество = СервисОбработок.КонвертироватьПроектEDT(
		КаталогSrc, КаталогНазначения, ОпцииIbcmd.ИспользоватьIbcmd,
		ПараметрыПлатформы, ПараметрыПодключения, ПараметрыEDT);

	Лог.Информация("Конвертация EDT → XML завершена: объектов %1, длительность %2с",
		Количество, Окр(ТекущаяУниверсальнаяДата() - ДатаНачала));

КонецПроцедуры
