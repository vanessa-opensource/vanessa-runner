// BSLLS:NumberOfValuesInStructureConstructor-off
// BSLLS:MissingVariablesDescription-off Поля &Опция/&Аргумент/&НаборОпций - описания заданы в самой аннотации.
&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисОбработок;

&Пластилин
Перем СервисЗаполненияПараметров;

&НаборОпций("НаборОпцийПодключения")
Перем ОпцииПодключения;

&НаборОпций("НаборОпцийIbcmd")
Перем ОпцииIbcmd;

&НаборОпций("НаборОпцийПлатформы")
Перем ОпцииПлатформы;

&НаборОпций("НаборОпцийСУБД")
Перем ОпцииСУБД;

&Аргумент(Имя = "SRC", Описание = "Путь к файлу обработки (.epf) или каталогу с обработками")
&ТСтрока
&Обязательный
Перем Источник;

&Опция(Имя = "R recursive", Описание = "Рекурсивный поиск EPF-файлов (для каталога)")
&Флаговый
Перем Рекурсивно;

&Опция(Имя = "out", Описание = "Каталог для сохранения разобранных исходников")
&ТСтрока
Перем КаталогВыгрузки;

&НаборОпций("НаборОпцийИсходников")
Перем ОпцииИсходников;

&НаборОпций("НаборОпцийНастроек")
Перем ОпцииНастроек; // BSLLS:UnusedLocalVariable-off

&ПодкомандаПриложения(Имя = "decompile", Родитель = "КомандаEpf", Описание = "Разобрать внешние обработки в исходники")
&ДоступноВMCP
&MCPДлительная
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);

	Лог.Отладка("Начало выполнения команды epf decompile");
	Лог.Отладка("Источник: %1", Источник);
	Лог.Отладка("Рекурсивно: %1", Рекурсивно);
	Лог.Отладка("Каталог выгрузки: %1", КаталогВыгрузки);
	Лог.Отладка("Использовать ibcmd: %1", Формат(ОпцииIbcmd.ИспользоватьIbcmd, "БЛ=Ложь; БИ=Истина"));

	ПроверитьПараметры();

	ПараметрыПлатформы = Новый Структура(
		"ВерсияПлатформы, КодРазрешения, Язык, Локаль",
		ОпцииПлатформы.ВерсияПлатформы,
		ОпцииПлатформы.КодРазрешения,
		ОпцииПлатформы.Язык,
		ОпцииПлатформы.Локаль);

	ПараметрыПодключения = Неопределено;
	Если ЗначениеЗаполнено(ОпцииПодключения.СтрокаПодключения)
		ИЛИ ЗначениеЗаполнено(ОпцииСУБД.ТипСУБД) Тогда
		ПараметрыПодключения = Новый Структура(
			"СтрокаПодключения, Пользователь, Пароль",
			ОпцииПодключения.СтрокаПодключения,
			ОпцииПодключения.Пользователь,
			ОпцииПодключения.Пароль);
		ОпцииСУБД.ДополнитьПараметрыПодключения(ПараметрыПодключения);
	КонецЕсли;

	ФайлИсточника = Новый Файл(Источник);
	ПараметрыИсходников = ОпцииИсходников.СформироватьПараметрыИсходников();

	Если ФайлИсточника.ЭтоКаталог() Тогда
		СервисОбработок.РазобратьОбработкиИзКаталога(Источник, Рекурсивно = Истина, КаталогВыгрузки,
			ОпцииIbcmd.ИспользоватьIbcmd, ПараметрыПлатформы, ПараметрыПодключения, ПараметрыИсходников);
	Иначе
		СервисОбработок.РазобратьОбработку(Источник, КаталогВыгрузки,
			ОпцииIbcmd.ИспользоватьIbcmd, ПараметрыПлатформы, ПараметрыПодключения, ПараметрыИсходников);
	КонецЕсли;

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьПараметры()

	ФайлИсточника = Новый Файл(Источник);
	Если НЕ ФайлИсточника.Существует() Тогда
		ВызватьИсключение СтрШаблон("Файл или каталог не найден: %1", Источник);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
