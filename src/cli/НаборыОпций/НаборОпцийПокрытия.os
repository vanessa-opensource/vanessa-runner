// BSLLS:ExportVariables-off Поля &Опция требуют Экспорт для доступа из подкоманд autumn-cli.
// BSLLS:MissingVariablesDescription-off Поля &Опция/&НаборОпций - описания заданы в самой аннотации.
// BSLLS:UnusedLocalVariable-off Поля &Опция/&Лог инициализируются autumn-фреймворком через рефлексию.
// BSLLS:LatinAndCyrillicSymbolInWord-off Технические имена (dbgs, EDT).
// BSLLS:Typo-off Доменный термин (алиас ИБ).
// BSLLS:LineLength-off Развёрнутые описания опций в аннотациях.
// Опции сбора покрытия тестов для команд test (yaxunit/xunit/vanessa).
// Подключается к команде через &НаборОпций("НаборОпцийПокрытия").
//
// Единственный включатель - --coverage-report: если задан путь, покрытие собирается.
// Остальное - по умолчанию (сервер отладки поднимается сам, исходники ищутся в ./src).

&Пластилин
Перем СервисПокрытия;

&Пластилин
Перем СервисПлатформы;

&Опция(Имя = "coverage-report",
	Описание = "Путь к файлу отчёта покрытия. Если задан - включается сбор покрытия (coveragebsl -> coverage)")
&ТСтрока
&ВОкружении("VRUNNER_COVERAGE_REPORT")
Перем ПутьОтчета Экспорт;

&Опция(Имя = "coverage-format", Описание = "Формат отчёта покрытия")
&ТПеречисление
&Перечисление(Имя = "generic", Значение = "generic", Описание = "genericCoverage XML для SonarQube (по умолчанию).")
&Перечисление(Имя = "cobertura", Значение = "cobertura", Описание = "Cobertura XML.")
&Перечисление(Имя = "clover", Значение = "clover", Описание = "Clover XML.")
&ВОкружении("VRUNNER_COVERAGE_FORMAT")
Перем ФорматОтчета Экспорт;

&Опция(Имя = "coverage-src",
	Описание = "Каталог исходников конфигурации для сопоставления модулей (по умолчанию ./src, рекурсивный поиск)")
&ТСтрока
&ВОкружении("VRUNNER_COVERAGE_SRC")
Перем КаталогИсходников Экспорт;

&Опция(Имя = "coverage-ext",
	Описание = "Каталог исходников расширения для покрытия (можно указать несколько раз)")
&ТМассивСтрок
Перем КаталогиРасширений Экспорт;

&Опция(Имя = "coverage-server",
	Описание = "Сервер отладки [хост:]порт. Пусто/порт - поднять свой локально (по умолчанию 1550); хост:порт - подключиться к уже запущенному (в т.ч. на другом сервере)")
&ТСтрока
&ВОкружении("VRUNNER_COVERAGE_SERVER")
Перем СерверОтладки Экспорт;

&Опция(Имя = "coverage-dbgs",
	Описание = "Путь к исполняемому файлу сервера отладки dbgs (по умолчанию определяется автоматически)")
&ТСтрока
&ВОкружении("VRUNNER_COVERAGE_DBGS")
Перем ПутьКСерверуОтладки Экспорт;

&Опция(Имя = "coverage-alias",
	Описание = "Имя (алиас) информационной базы для сессии отладки (по умолчанию определяется из строки подключения)")
&ТСтрока
&ВОкружении("VRUNNER_COVERAGE_ALIAS")
Перем АлиасИБ Экспорт;

&Опция(Имя = "coverage-debug-pwd",
	Описание = "Пароль сервера отладки (если задан)")
&ТСтрока
&ВОкружении("VRUNNER_COVERAGE_DEBUG_PWD")
Перем ПарольОтладки Экспорт;

&Опция(Имя = "coverage-skip-lines",
	Описание = "Не рассчитывать покрываемые строки и процент покрытия (собрать только исполненные строки)")
&Флаговый
&ВОкружении("VRUNNER_COVERAGE_SKIP_LINES")
Перем ПропуститьПокрываемыеСтроки Экспорт;

&НаборОпций
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Включён ли сбор покрытия (задан путь к отчёту).
//
// Возвращаемое значение:
//   Булево
//
Функция Включено() Экспорт
	Возврат ЗначениеЗаполнено(ПутьОтчета);
КонецФункции

// Сформировать структуру параметров покрытия для СервисПокрытия.
//
// Возвращаемое значение:
//   Структура - ПутьОтчета, ФорматОтчета, КаталогИсходников, КаталогиРасширений,
//               СерверОтладки, ПутьКСерверуОтладки, АлиасИБ, ПарольОтладки
//
Функция СформироватьПараметры() Экспорт

	Параметры = Новый Структура;
	Параметры.Вставить("ПутьОтчета", ПутьОтчета);
	Параметры.Вставить("ФорматОтчета", ?(ЗначениеЗаполнено(ФорматОтчета), ФорматОтчета, "generic"));
	Параметры.Вставить("КаталогИсходников", ?(ЗначениеЗаполнено(КаталогИсходников), КаталогИсходников, "src"));
	Параметры.Вставить("КаталогиРасширений", ?(КаталогиРасширений = Неопределено, Новый Массив, КаталогиРасширений));
	Параметры.Вставить("СерверОтладки", ?(ЗначениеЗаполнено(СерверОтладки), СокрЛП(СерверОтладки), ""));
	Параметры.Вставить("ПутьКСерверуОтладки", ПутьКСерверуОтладки);
	Параметры.Вставить("АлиасИБ", АлиасИБ);
	Параметры.Вставить("ПарольОтладки", ?(ЗначениеЗаполнено(ПарольОтладки), ПарольОтладки, ""));

	Пропустить = (ПропуститьПокрываемыеСтроки = Истина); // BSLLS:CompareWithBoolean-off флаг может быть Неопределено
	Параметры.Вставить("РассчитыватьПокрываемыеСтроки", НЕ Пропустить);

	Возврат Параметры;

КонецФункции

// Начать сбор покрытия, если задан --coverage-report, и дописать аргументы отладки в параметры запуска.
//
// Параметры:
//   ПараметрыЗапуска     - Структура - параметры запуска платформы (модифицируется: ДополнительныеПараметры,
//                                      АдресСервераОтладки)
//   ПараметрыПодключения - Структура - параметры подключения к ИБ
//   ПараметрыПлатформы   - Структура - параметры платформы
//   НеОжидать            - Булево    - значение --no-wait команды: со сбором покрытия несовместимо
//
// Возвращаемое значение:
//   Структура, Неопределено - контекст сеанса покрытия (Неопределено, если покрытие выключено)
//
Функция НачатьСеансПриНеобходимости(ПараметрыЗапуска, Знач ПараметрыПодключения, Знач ПараметрыПлатформы,
		Знач НеОжидать) Экспорт

	Если НЕ Включено() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если НеОжидать = Истина Тогда // BSLLS:CompareWithBoolean-off флаг может быть Неопределено
		ВызватьИсключение
			"Сбор покрытия (--coverage-report) несовместим с --no-wait: клиент 1С должен завершиться до сбора данных.";
	КонецЕсли;

	Контекст = СервисПокрытия.НачатьСеанс(СформироватьПараметры(), ПараметрыПодключения, ПараметрыПлатформы);
	ПараметрыЗапуска.ДополнительныеПараметры =
		СокрЛП(ПараметрыЗапуска.ДополнительныеПараметры + " " + Контекст.АргументыОтладки);
	// Для режима ibsrv: ibsrv подключится к этому же серверу отладки (серверный код в замерах).
	ПараметрыЗапуска.Вставить("АдресСервераОтладки", Контекст.АдресСервера);
	Возврат Контекст;

КонецФункции

// Запустить 1С:Предприятие, собирая покрытие, если оно включено: при исключении запуска
// сеанс покрытия прерывается без отчёта, иначе завершается с записью отчёта.
//
// Параметры:
//   ПараметрыПодключения - Структура - параметры подключения к ИБ
//   ПараметрыЗапуска     - Структура - параметры запуска платформы (см. НачатьСеансПриНеобходимости)
//   ПараметрыПлатформы   - Структура - параметры платформы
//   НеОжидать            - Булево    - значение --no-wait команды
//
Процедура ЗапуститьПредприятиеСПокрытием(Знач ПараметрыПодключения, ПараметрыЗапуска, Знач ПараметрыПлатформы,
		Знач НеОжидать) Экспорт

	Контекст = НачатьСеансПриНеобходимости(ПараметрыЗапуска, ПараметрыПодключения, ПараметрыПлатформы, НеОжидать);

	Попытка
		СервисПлатформы.ЗапуститьПредприятие(ПараметрыПодключения, ПараметрыЗапуска, ПараметрыПлатформы);
	Исключение
		СервисПокрытия.ПрерватьСеанс(Контекст);
		ВызватьИсключение;
	КонецПопытки;

	СервисПокрытия.ЗавершитьСеанс(Контекст);

КонецПроцедуры

#КонецОбласти
