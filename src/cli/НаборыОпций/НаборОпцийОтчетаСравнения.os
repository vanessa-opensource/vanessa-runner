// BSLLS:ExportVariables-off Поля &Опция требуют Экспорт для доступа из подкоманд autumn-cli.
// BSLLS:MissingVariablesDescription-off Поля &Опция/&НаборОпций - описания заданы в самой аннотации.
// BSLLS:UnusedLocalVariable-off Поля &Опция/&Пластилин инициализируются autumn-фреймворком через рефлексию.
// Опции отчёта о сравнении конфигураций и расширений (cf compare, cfe compare).
// Подключается к команде через &НаборОпций("НаборОпцийОтчетаСравнения").

&Пластилин
Перем СервисОкружения;

&Опция(Имя = "report-dir", Описание = "Каталог для сохранения отчёта (по умолчанию - текущий каталог)")
&ТСтрока
Перем КаталогОтчета Экспорт;

&Опция(Имя = "report-type", Описание = "Тип отчёта")
&ТПеречисление
&Перечисление(Имя = "Full", Описание = "Полный отчёт")
&Перечисление(Имя = "Brief", Описание = "Краткий отчёт")
&ПоУмолчанию("Full")
Перем ТипОтчета Экспорт;

&Опция(Имя = "report-format", Описание = "Формат файла отчёта")
&ТПеречисление
&Перечисление(Имя = "txt", Описание = "Текстовый файл")
&Перечисление(Имя = "mxl", Описание = "Табличный документ")
&ПоУмолчанию("txt")
Перем ФорматОтчета Экспорт;

&НаборОпций
Процедура ПриСозданииОбъекта()
КонецПроцедуры

// Параметры отчёта о сравнении; без --report-dir отчёт сохраняется в рабочий каталог.
//
// Возвращаемое значение:
//   Структура - КаталогОтчета, ТипОтчета, ФорматОтчета
//
Функция СформироватьПараметрыОтчета() Экспорт

	Возврат Новый Структура(
		"КаталогОтчета, ТипОтчета, ФорматОтчета",
		СервисОкружения.ПутьИлиРабочийКаталог(КаталогОтчета), ТипОтчета, ФорматОтчета);

КонецФункции
