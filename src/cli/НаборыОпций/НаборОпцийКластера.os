// BSLLS:ExportVariables-off Поля &Опция требуют Экспорт для доступа из подкоманд autumn-cli.
// BSLLS:MissingVariablesDescription-off Поля &Опция/&Аргумент/&НаборОпций - описания заданы в самой аннотации.
// BSLLS:UnusedLocalVariable-off Поля &Опция инициализируются autumn-фреймворком через рефлексию.
// Общие опции кластера серверов 1С (ras/rac).
// Подключается к команде через &НаборОпций("НаборОпцийКластера").

&Опция(Имя = "ras", Описание = "Сетевой адрес RAS (по умолчанию localhost:1545)")
&ТСтрока
&ВОкружении("VRUNNER_RAS")
Перем АдресRAS Экспорт;

&Опция(Имя = "rac", Описание = "Путь к утилите rac")
&ТСтрока
&ВОкружении("VRUNNER_RAC")
Перем ПутьRac Экспорт;

&Опция(Имя = "db-name", Описание = "Имя информационной базы в кластере")
&ТСтрока
&ВОкружении("VRUNNER_IBNAME")
Перем ИмяИБ Экспорт;

&Опция(Имя = "cluster", Описание = "Идентификатор кластера")
&ТСтрока
Перем ИдентификаторКластера Экспорт;

&Опция(Имя = "cluster-name", Описание = "Имя кластера")
&ТСтрока
Перем ИмяКластера Экспорт;

&НаборОпций
Процедура ПриСозданииОбъекта()
КонецПроцедуры

// Параметры подключения к кластеру через RAS.
//
// Параметры:
//   ОпцииАдминистрирования - НаборОпцийАдминистрирования - администратор кластера
//   ОпцииПлатформы - НаборОпцийПлатформы - версия платформы
//   ОпцииАутентификации - НаборОпцийАутентификацииИБ, Неопределено - пользователь ИБ (необязательно)
//
// Возвращаемое значение:
//   Структура - ВерсияПлатформы, ПутьRac, АдресRAS, АдминистраторКластера, ПарольКластера,
//               ИдентификаторКластера, ИмяКластера и (если задан набор) Пользователь, Пароль
//
Функция СформироватьПараметрыКластера(Знач ОпцииАдминистрирования, Знач ОпцииПлатформы,
	Знач ОпцииАутентификации = Неопределено) Экспорт

	// BSLLS:NumberOfValuesInStructureConstructor-off Параметры передаются сервису одной структурой.
	ПараметрыКластера = Новый Структура(
		"ВерсияПлатформы, ПутьRac, АдресRAS, АдминистраторКластера, ПарольКластера, ИдентификаторКластера, ИмяКластера",
		ОпцииПлатформы.ВерсияПлатформы,
		ПутьRac,
		АдресRAS,
		ОпцииАдминистрирования.АдминистраторКластера,
		ОпцииАдминистрирования.ПарольКластера,
		ИдентификаторКластера,
		ИмяКластера);

	Если ОпцииАутентификации <> Неопределено Тогда
		ПараметрыКластера.Вставить("Пользователь", ОпцииАутентификации.Пользователь);
		ПараметрыКластера.Вставить("Пароль", ОпцииАутентификации.Пароль);
	КонецЕсли;

	Возврат ПараметрыКластера;

КонецФункции
