// Общие опции кластера серверов 1С (ras/rac).
// Подключается к команде через &НаборОпций("НаборОпцийКластера").

&Опция(Имя = "ras", Описание = "Сетевой адрес RAS (по умолчанию localhost:1545)")
&ТСтрока
&ВОкружении("VRUNNER_RAS")
Перем АдресRAS Экспорт;

&Опция(Имя = "rac", Описание = "Путь к утилите rac")
&ТСтрока
&ВОкружении("VRUNNER_RAC")
Перем ПутьRac Экспорт;

&Опция(Имя = "db-name", Описание = "Имя информационной базы в кластере")
&ТСтрока
&ВОкружении("VRUNNER_IBNAME")
Перем ИмяИБ Экспорт;

&Опция(Имя = "cluster", Описание = "Идентификатор кластера")
&ТСтрока
Перем ИдентификаторКластера Экспорт;

&Опция(Имя = "cluster-name", Описание = "Имя кластера")
&ТСтрока
Перем ИмяКластера Экспорт;

&НаборОпций
Процедура ПриСозданииОбъекта()
КонецПроцедуры
