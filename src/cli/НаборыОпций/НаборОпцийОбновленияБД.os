// Опции обновления конфигурации БД (UpdateDBCfg / config apply).
// Используются командами загрузки конфигурации (cf load, cfe load) и обновления (infobase update).
// Подключается к команде через &НаборОпций("НаборОпцийОбновленияБД").

&Опция(Имя = "rtype", Описание = "Режим реструктуризации БД при обновлении (только конфигуратор). См. https://its.1c.ru/db/v8326doc#bookmark:dev:TI000002111")
&ТПеречисление
&Перечисление(Имя = "v1", Значение = "v1", Описание = "Обычный механизм реструктуризации.")
&Перечисление(Имя = "v2", Значение = "v2", Описание = "Оптимизированный механизм реструктуризации.")
Перем РежимРеструктуризации Экспорт;

&Опция(Имя = "dynamic", Описание = "Разрешить динамическое обновление конфигурации БД")
&Флаговый
Перем ДинамическоеОбновление Экспорт;

&НаборОпций
Процедура ПриСозданииОбъекта()
КонецПроцедуры

// Сформировать структуру настроек обновления для СервисПлатформы.ОбновитьКонфигурациюБД.
//
// Параметры:
//   ИмяРасширения - Строка - имя расширения для обновления (необязательно).
//
// Возвращаемое значение:
//   Структура - "РежимРеструктуризации, ДинамическоеОбновление, ИмяРасширения".
Функция СформироватьНастройкиОбновления(Знач ИмяРасширения = Неопределено) Экспорт

	Возврат Новый Структура(
		"РежимРеструктуризации, ДинамическоеОбновление, ИмяРасширения",
		КлючРежимаРеструктуризации(),
		Булево(ДинамическоеОбновление),
		ИмяРасширения
	);

КонецФункции

Функция КлючРежимаРеструктуризации()

	Если РежимРеструктуризации = "v1" Тогда
		Возврат "-v1";
	ИначеЕсли РежимРеструктуризации = "v2" Тогда
		Возврат "-v2";
	Иначе
		Возврат "";
	КонецЕсли;

КонецФункции
