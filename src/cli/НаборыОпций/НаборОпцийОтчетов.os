// BSLLS:LineLength-off Развёрнутые описания опций в аннотациях.
// BSLLS:UnusedLocalMethod-off ПриСозданииОбъекта вызывается рантаймом при Новый.
// BSLLS:ExportVariables-off Поля &Опция требуют Экспорт для доступа из подкоманд autumn-cli.
// BSLLS:MissingVariablesDescription-off Поля &Опция - описания заданы в самой аннотации.
// BSLLS:UnusedLocalVariable-off Поля &Опция/&Лог инициализируются autumn-фреймворком через рефлексию.
// Опции вывода отчёта о результатах работы команды.
// Подключается к команде через &НаборОпций("НаборОпцийОтчетов").
//
// Пара --report-format / --report-path одинакова у всех команд, которые выгружают
// результат прогона: validate syntax-check, validate edt, test xunit/yaxunit/vanessa.
// Список допустимых форматов у каждой команды свой (его определяет тот, кто пишет отчёт:
// сам vrunner, YAxUnit или Vanessa-ADD) и передаётся в СформироватьОтчеты.
//
// Опция --report-format повторяемая - как --mode и --target. Команда, которая умеет
// только один отчёт за прогон, обязана сказать об этом явной ошибкой.
//
// Устаревшие опции отчётов (--junitpath, --allure-results, --report) у команд разные,
// поэтому команда описывает их через УстаревшийОтчет, а складывает всё СобратьОтчеты.

&Лог("vrunner")
Перем Лог;

&Пластилин
Перем ФайловыеОперации;

&Опция(Имя = "report-format",
	Описание = "Формат отчёта; можно указать несколько раз. Список форматов зависит от команды")
&ТМассивСтрок
Перем Форматы Экспорт;

&Опция(Имя = "report-path",
	Описание = "Куда выгрузить отчёт: файл - если формат один, каталог - если форматов несколько")
&ТСтрока
&ВОкружении("VRUNNER_REPORT_PATH")
Перем ПутьОтчета Экспорт;

&НаборОпций
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Задан ли вывод отчёта через новую пару опций.
//
// Возвращаемое значение:
//   Булево
//
Функция Задан() Экспорт

	Возврат (Форматы <> Неопределено И Форматы.Количество() > 0) ИЛИ ЗначениеЗаполнено(ПутьОтчета);

КонецФункции

// Разобрать опции в список формируемых отчётов.
//
// Параметры:
//   ДопустимыеФорматы - Соответствие - формат (нижний регистр) -> имя файла/каталога внутри --report-path
//   ФорматПоУмолчанию - Строка       - формат, подставляемый когда задан только --report-path
//   ОткрытыйСловарь   - Булево       - принимать форматы вне словаря (имена генераторов Vanessa-ADD)
//
// Возвращаемое значение:
//   Массив - Элементы <Структура> с полями Формат и Путь (см. РазборПараметровОтчетов)
//
Функция СформироватьОтчеты(Знач ДопустимыеФорматы, Знач ФорматПоУмолчанию = "",
		Знач ОткрытыйСловарь = Ложь) Экспорт

	Разбор = Новый РазборПараметровОтчетов(ДопустимыеФорматы, ФорматПоУмолчанию, ОткрытыйСловарь);
	Возврат Разбор.Разобрать(Форматы, ПутьОтчета);

КонецФункции

// Описание отчёта, заданного устаревшей опцией команды, для СобратьОтчеты.
//
// Параметры:
//   ИмяОпции - Строка - имя устаревшей опции, например --junitpath
//   Формат - Строка - формат отчёта, которому опция соответствует
//   Путь - Строка - значение опции; пустое - опция не задана
//
// Возвращаемое значение:
//   Структура - ИмяОпции, Формат, Путь
//
Функция УстаревшийОтчет(Знач ИмяОпции, Знач Формат, Знач Путь) Экспорт

	Возврат Новый Структура("ИмяОпции, Формат, Путь", ИмяОпции, Формат, Путь);

КонецФункции

// Список формируемых отчётов: устаревшие опции команды и общая пара --report-format/--report-path
// складываются, при совпадении формата побеждает общая пара. Молча терять отчёт, заданный
// устаревшей опцией, нельзя - в переходный период их держат вперемешку (одно в настройках,
// другое в командной строке). Отчёт без пути - ошибка настройки, а не повод молча пропустить выгрузку.
//
// Параметры:
//   ДопустимыеФорматы - Соответствие - формат (нижний регистр) -> имя файла/каталога внутри --report-path
//   ФорматПоУмолчанию - Строка - формат, подставляемый когда задан только --report-path
//   УстаревшиеОтчеты - Массив, Неопределено - Элементы <Структура> (см. УстаревшийОтчет); с пустым путём пропускаются
//
// Возвращаемое значение:
//   Массив - Элементы <Структура> с полями Формат и Путь
//
Функция СобратьОтчеты(Знач ДопустимыеФорматы, Знач ФорматПоУмолчанию = "",
		Знач УстаревшиеОтчеты = Неопределено) Экспорт

	Устаревшие = Новый Массив;
	Если УстаревшиеОтчеты <> Неопределено Тогда
		Для Каждого Устаревший Из УстаревшиеОтчеты Цикл
			Если НЕ ЗначениеЗаполнено(Устаревший.Путь) Тогда
				Продолжить;
			КонецЕсли;
			Лог.Предупреждение("Опция %1 устарела, используйте: --report-format %2 --report-path %3",
				Устаревший.ИмяОпции, Устаревший.Формат, Устаревший.Путь);
			Устаревшие.Добавить(Новый Структура("Формат, Путь", Устаревший.Формат, Устаревший.Путь));
		КонецЦикла;
	КонецЕсли;

	Новые = ?(Задан(), СформироватьОтчеты(ДопустимыеФорматы, ФорматПоУмолчанию), Новый Массив);

	Разбор = Новый РазборПараметровОтчетов(ДопустимыеФорматы, ФорматПоУмолчанию);
	Возврат Разбор.Объединить(Устаревшие, Новые);

КонецФункции

// Путь отчёта заданного формата.
//
// Параметры:
//   Отчеты - Массив - Элементы <Структура> с полями Формат и Путь
//   Формат - Строка - искомый формат
//
// Возвращаемое значение:
//   Строка - путь; пустая строка, если такой отчёт не запрошен
//
Функция ПутьОтчета(Знач Отчеты, Знач Формат) Экспорт

	Для Каждого Отчет Из Отчеты Цикл
		Если Отчет.Формат = Формат Тогда
			Возврат Отчет.Путь;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Создать каталоги отчётов заранее: проверка идёт минутами, и падение на записи отчёта
// в самом конце обесценивает весь прогон (issue #746).
//
// Параметры:
//   Отчеты - Массив - Элементы <Структура> с полями Формат и Путь
//   ФорматыКаталогов - Массив - форматы, у которых путь отчёта - каталог (например, allure);
//       у остальных путь - файл, и создаётся каталог для него
//
Процедура ПодготовитьКаталоги(Знач Отчеты, Знач ФорматыКаталогов) Экспорт

	Для Каждого Отчет Из Отчеты Цикл
		Если ФорматыКаталогов.Найти(Отчет.Формат) <> Неопределено Тогда
			ФайловыеОперации.ОбеспечитьКаталог(Отчет.Путь);
		Иначе
			ФайловыеОперации.ОбеспечитьКаталогДляФайла(Отчет.Путь);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
