// BSLLS:UnusedLocalMethod-off ПриСозданииОбъекта вызывается рантаймом при Новый.
// BSLLS:ExportVariables-off Поля &Опция требуют Экспорт для доступа из подкоманд autumn-cli.
// BSLLS:MissingVariablesDescription-off Поля &Опция - описания заданы в самой аннотации.
// BSLLS:UnusedLocalVariable-off Поля &Опция/&Лог инициализируются autumn-фреймворком через рефлексию.
// Опции вывода отчёта о результатах работы команды.
// Подключается к команде через &НаборОпций("НаборОпцийОтчетов").
//
// Пара --report-format / --report-path одинакова у всех команд, которые выгружают
// результат прогона: validate syntax-check, validate edt, test xunit/yaxunit/vanessa.
// Список допустимых форматов у каждой команды свой (его определяет тот, кто пишет отчёт:
// сам vrunner, YAxUnit или Vanessa-ADD). Команда, которая умеет только один отчёт
// за прогон, обязана сказать об этом явной ошибкой.

&Лог("vrunner")
Перем Лог;

&Опция(Имя = "report-format",
	Описание = "Формат отчёта; можно указать несколько раз. Список форматов зависит от команды")
&ТМассивСтрок
Перем Форматы Экспорт;

&Опция(Имя = "report-path",
	Описание = "Куда выгрузить отчёт: файл - если формат один, каталог - если форматов несколько")
&ТСтрока
&ВОкружении("VRUNNER_REPORT_PATH")
Перем ПутьОтчета Экспорт;

&НаборОпций
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Задан ли вывод отчёта через пару --report-format / --report-path.
//
// Возвращаемое значение:
//   Булево
//
Функция Задан() Экспорт

	Возврат (Форматы <> Неопределено И Форматы.Количество() > 0) ИЛИ ЗначениеЗаполнено(ПутьОтчета);

КонецФункции

// Описание отчёта, заданного устаревшей опцией команды, для Отчеты.
//
// Параметры:
//   ИмяОпции - Строка - имя устаревшей опции, например --junitpath
//   Формат - Строка - формат отчёта, которому опция соответствует; пустой - опция задаёт только путь
//   Путь - Строка - значение опции; пустое - опция не задана
//
// Возвращаемое значение:
//   Структура - ИмяОпции, Формат, Путь
//
Функция УстаревшийОтчет(Знач ИмяОпции, Знач Формат, Знач Путь) Экспорт

	Возврат Новый Структура("ИмяОпции, Формат, Путь", ИмяОпции, Формат, Путь);

КонецФункции

// Список формируемых отчётов: устаревшие опции команды и общая пара --report-format/--report-path
// складываются (см. РазборПараметровОтчетов.Объединить). Молча терять отчёт, заданный устаревшей
// опцией, нельзя - в переходный период их держат вперемешку (одно в настройках, другое в командной строке).
//
// Параметры:
//   ДопустимыеФорматы - Соответствие - формат (нижний регистр) -> имя файла/каталога внутри --report-path
//   ФорматПоУмолчанию - Строка - формат, подставляемый когда задан только --report-path
//   УстаревшиеОтчеты - Массив, Неопределено - Элементы <Структура> (см. УстаревшийОтчет); с пустым путём пропускаются
//   РазборЧужихФорматов - Произвольный, Неопределено - разбор форматов вне словаря
//       (см. РазборПараметровОтчетов); Неопределено - словарь закрыт
//   ОдинОтчет - Булево - команда формирует один отчёт за прогон, путь которому необязателен
//       (см. РазборПараметровОтчетов.Объединить)
//
// Возвращаемое значение:
//   Массив - Элементы <Структура> с полями Формат и Путь
//
Функция Отчеты(Знач ДопустимыеФорматы, Знач ФорматПоУмолчанию, Знач УстаревшиеОтчеты = Неопределено,
		Знач РазборЧужихФорматов = Неопределено, Знач ОдинОтчет = Ложь) Экспорт

	Устаревшие = Новый Массив;
	Если УстаревшиеОтчеты <> Неопределено Тогда
		Для Каждого Устаревший Из УстаревшиеОтчеты Цикл
			Если НЕ ЗначениеЗаполнено(Устаревший.Путь) Тогда
				Продолжить;
			КонецЕсли;
			ЗаменаФормата = ?(ЗначениеЗаполнено(Устаревший.Формат),
				СтрШаблон("--report-format %1 ", Устаревший.Формат), "");
			Лог.Предупреждение("Опция %1 устарела, используйте: %2--report-path %3",
				Устаревший.ИмяОпции, ЗаменаФормата, Устаревший.Путь);
			Устаревшие.Добавить(Новый Структура("Формат, Путь", Устаревший.Формат, Устаревший.Путь));
		КонецЦикла;
	КонецЕсли;

	Разбор = Новый РазборПараметровОтчетов(ДопустимыеФорматы, ФорматПоУмолчанию, РазборЧужихФорматов);
	Новые = ?(Задан(), Разбор.Разобрать(Форматы, ПутьОтчета), Новый Массив);

	Возврат Разбор.Объединить(Устаревшие, Новые, ОдинОтчет);

КонецФункции

// Путь отчёта заданного формата.
//
// Параметры:
//   Отчеты - Массив - Элементы <Структура> с полями Формат и Путь
//   Формат - Строка - искомый формат
//
// Возвращаемое значение:
//   Строка - путь; пустая строка, если такой отчёт не запрошен
//
Функция ПутьОтчета(Знач Отчеты, Знач Формат) Экспорт

	Для Каждого Отчет Из Отчеты Цикл
		Если Отчет.Формат = Формат Тогда
			Возврат Отчет.Путь;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

#КонецОбласти
