// BSLLS:UnusedLocalMethod-off ПриСозданииОбъекта вызывается рантаймом при Новый.
// BSLLS:ExportVariables-off Поля &Опция требуют Экспорт для доступа из подкоманд autumn-cli.
// BSLLS:MissingVariablesDescription-off Поля &Опция - описания заданы в самой аннотации.
// BSLLS:UnusedLocalVariable-off Поля &Опция/&Лог инициализируются autumn-фреймворком через рефлексию.
// Опции вывода отчёта о результатах работы команды.
// Подключается к команде через &НаборОпций("НаборОпцийОтчетов").
//
// Пара --report-format / --report-path одинакова у всех команд, которые выгружают
// результат прогона: validate syntax-check, validate edt, test xunit/yaxunit/vanessa.
// Список допустимых форматов у каждой команды свой (его определяет тот, кто пишет отчёт:
// сам vrunner, YAxUnit или Vanessa-ADD). Команда, которая умеет только один отчёт
// за прогон, обязана сказать об этом явной ошибкой.

&Лог("vrunner")
Перем Лог;

&Пластилин
Перем ФайловыеОперации;

&Опция(Имя = "report-format",
	Описание = "Формат отчёта; можно указать несколько раз. Список форматов зависит от команды")
&ТМассивСтрок
Перем Форматы Экспорт;

&Опция(Имя = "report-path",
	Описание = "Куда выгрузить отчёт: файл - если формат один, каталог - если форматов несколько")
&ТСтрока
&ВОкружении("VRUNNER_REPORT_PATH")
Перем ПутьОтчета Экспорт;

&НаборОпций
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Задан ли вывод отчёта через пару --report-format / --report-path.
//
// Возвращаемое значение:
//   Булево
//
Функция Задан() Экспорт

	Возврат (Форматы <> Неопределено И Форматы.Количество() > 0) ИЛИ ЗначениеЗаполнено(ПутьОтчета);

КонецФункции

// Разобрать опции в список формируемых отчётов.
//
// Параметры:
//   ДопустимыеФорматы - Соответствие - формат (нижний регистр) -> имя файла/каталога внутри --report-path
//   ФорматПоУмолчанию - Строка       - формат, подставляемый когда задан только --report-path
//   РазборЧужихФорматов - Произвольный, Неопределено - разбор форматов вне словаря
//       (см. РазборПараметровОтчетов); Неопределено - словарь закрыт
//
// Возвращаемое значение:
//   Массив - Элементы <Структура> с полями Формат и Путь (см. РазборПараметровОтчетов)
//
Функция СформироватьОтчеты(Знач ДопустимыеФорматы, Знач ФорматПоУмолчанию = "",
		Знач РазборЧужихФорматов = Неопределено) Экспорт

	Разбор = Новый РазборПараметровОтчетов(ДопустимыеФорматы, ФорматПоУмолчанию, РазборЧужихФорматов);
	Возврат Разбор.Разобрать(Форматы, ПутьОтчета);

КонецФункции

// Описание отчёта, заданного устаревшей опцией команды, для СобратьОтчеты.
//
// Параметры:
//   ИмяОпции - Строка - имя устаревшей опции, например --junitpath
//   Формат - Строка - формат отчёта, которому опция соответствует
//   Путь - Строка - значение опции; пустое - опция не задана
//
// Возвращаемое значение:
//   Структура - ИмяОпции, Формат, Путь
//
Функция УстаревшийОтчет(Знач ИмяОпции, Знач Формат, Знач Путь) Экспорт

	Возврат Новый Структура("ИмяОпции, Формат, Путь", ИмяОпции, Формат, Путь);

КонецФункции

// Список формируемых отчётов: устаревшие опции команды и общая пара --report-format/--report-path
// складываются, при совпадении формата побеждает общая пара. Молча терять отчёт, заданный
// устаревшей опцией, нельзя - в переходный период их держат вперемешку (одно в настройках,
// другое в командной строке). Отчёт без пути - ошибка настройки, а не повод молча пропустить выгрузку.
//
// Параметры:
//   ДопустимыеФорматы - Соответствие - формат (нижний регистр) -> имя файла/каталога внутри --report-path
//   ФорматПоУмолчанию - Строка - формат, подставляемый когда задан только --report-path
//   УстаревшиеОтчеты - Массив, Неопределено - Элементы <Структура> (см. УстаревшийОтчет); с пустым путём пропускаются
//   РазборЧужихФорматов - Произвольный, Неопределено - разбор форматов вне словаря
//       (см. РазборПараметровОтчетов); Неопределено - словарь закрыт
//
// Возвращаемое значение:
//   Массив - Элементы <Структура> с полями Формат и Путь
//
Функция СобратьОтчеты(Знач ДопустимыеФорматы, Знач ФорматПоУмолчанию = "",
		Знач УстаревшиеОтчеты = Неопределено, Знач РазборЧужихФорматов = Неопределено) Экспорт

	Устаревшие = Новый Массив;
	Если УстаревшиеОтчеты <> Неопределено Тогда
		Для Каждого Устаревший Из УстаревшиеОтчеты Цикл
			Если НЕ ЗначениеЗаполнено(Устаревший.Путь) Тогда
				Продолжить;
			КонецЕсли;
			Лог.Предупреждение("Опция %1 устарела, используйте: --report-format %2 --report-path %3",
				Устаревший.ИмяОпции, Устаревший.Формат, Устаревший.Путь);
			Устаревшие.Добавить(Новый Структура("Формат, Путь", Устаревший.Формат, Устаревший.Путь));
		КонецЦикла;
	КонецЕсли;

	Новые = ?(Задан(), СформироватьОтчеты(ДопустимыеФорматы, ФорматПоУмолчанию, РазборЧужихФорматов),
		Новый Массив);

	Разбор = Новый РазборПараметровОтчетов(ДопустимыеФорматы, ФорматПоУмолчанию, РазборЧужихФорматов);
	Возврат Разбор.Объединить(Устаревшие, Новые);

КонецФункции

// Путь отчёта заданного формата.
//
// Параметры:
//   Отчеты - Массив - Элементы <Структура> с полями Формат и Путь
//   Формат - Строка - искомый формат
//
// Возвращаемое значение:
//   Строка - путь; пустая строка, если такой отчёт не запрошен
//
Функция ПутьОтчета(Знач Отчеты, Знач Формат) Экспорт

	Для Каждого Отчет Из Отчеты Цикл
		Если Отчет.Формат = Формат Тогда
			Возврат Отчет.Путь;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Создать каталоги отчётов заранее: проверка идёт минутами, и падение на записи отчёта
// в самом конце обесценивает весь прогон (issue #746).
//
// Параметры:
//   Отчеты - Массив - Элементы <Структура> с полями Формат и Путь
//   ФорматыКаталогов - Массив - форматы, у которых путь отчёта - каталог (например, allure);
//       у остальных путь - файл, и создаётся каталог для него
//   Очищать - Булево - Истина: каталог отчёта очищается от прошлых прогонов
//       (у файлового отчёта - каталог файла, у каталожного - сам каталог)
//
Процедура ПодготовитьКаталоги(Знач Отчеты, Знач ФорматыКаталогов, Знач Очищать = Ложь) Экспорт

	Каталоги = Новый Массив;
	Для Каждого Отчет Из Отчеты Цикл
		Если ФорматыКаталогов.Найти(Отчет.Формат) <> Неопределено Тогда
			Каталоги.Добавить(Отчет.Путь);
		Иначе
			Каталоги.Добавить(ФайловыеОперации.КаталогФайла(Отчет.Путь));
		КонецЕсли;
	КонецЦикла;

	// Сначала очистка всех, потом создание: каталог allure может лежать внутри каталога junit-файла.
	Если Очищать Тогда
		Для Каждого Каталог Из Каталоги Цикл
			ФайловыеОперации.ОбеспечитьПустойКаталог(Каталог);
		КонецЦикла;
	КонецЕсли;

	Для Каждого Каталог Из Каталоги Цикл
		ФайловыеОперации.ОбеспечитьКаталог(Каталог);
	КонецЦикла;

КонецПроцедуры

// Имя формата отчёта JUnit XML.
//
// Возвращаемое значение:
//   Строка
//
Функция ФорматJUnit() Экспорт
	Возврат "junit";
КонецФункции

// Имя формата результатов Allure 2.
//
// Возвращаемое значение:
//   Строка
//
Функция ФорматAllure() Экспорт
	Возврат "allure";
КонецФункции

// Имя формата сырого файла результатов проверки 1С:EDT.
//
// Возвращаемое значение:
//   Строка
//
Функция ФорматEDT() Экспорт
	Возврат "edt";
КонецФункции

// Форматы отчётов vrunner, у которых путь - каталог, а не файл (см. ПодготовитьКаталоги).
//
// Возвращаемое значение:
//   Массив - Элементы <Строка>
//
Функция ФорматыКаталогов() Экспорт

	Форматы = Новый Массив;
	Форматы.Добавить(ФорматAllure());
	Возврат Форматы;

КонецФункции

// Записать отчёт JUnit. Успешную проверку тоже показываем кейсом: пустой набор в отчёте
// неотличим от прогона, который до отчёта не дошёл.
//
// Параметры:
//   Генератор - ГенераторОтчетаJUnit - генератор отчёта с именем тестового набора
//   ПутьОтчета - Строка - путь к файлу отчёта
//   Случаи - Массив - Элементы <Структура>, см. ГенераторОтчетаJUnit.НовыйСлучай; пустой - один успешный кейс
//   ДлительностьСек - Число - длительность проверки в секундах
//   ИмяУспешногоСлучая - Строка - имя кейса, когда замечаний нет
//
Процедура ЗаписатьОтчетJUnit(Знач Генератор, Знач ПутьОтчета, Знач Случаи, Знач ДлительностьСек,
		Знач ИмяУспешногоСлучая) Экспорт

	Если Случаи.Количество() = 0 Тогда
		Случаи.Добавить(Генератор.НовыйСлучай(ИмяУспешногоСлучая));
	КонецЕсли;

	Генератор.Записать(ПутьОтчета, Случаи, ДлительностьСек);

	Лог.Информация("Отчёт JUnit сохранён: %1", ПутьОтчета);

КонецПроцедуры

// Записать результаты Allure - каталог с файлом на каждый тест-кейс, а не один файл отчёта.
// Про пустой набор - см. ЗаписатьОтчетJUnit.
//
// Параметры:
//   Генератор - ГенераторОтчетаAllure - генератор результатов с именем тестового набора
//   КаталогРезультатов - Строка - каталог allure-results
//   Случаи - Массив - Элементы <Структура>, см. ГенераторОтчетаAllure.НовыйСлучай; пустой - один успешный кейс
//   ДатаНачала - Дата - начало проверки, универсальное время
//   ДлительностьСек - Число - длительность проверки в секундах
//   ИмяУспешногоСлучая - Строка - имя кейса, когда замечаний нет
//
Процедура ЗаписатьРезультатыAllure(Знач Генератор, Знач КаталогРезультатов, Знач Случаи, Знач ДатаНачала,
		Знач ДлительностьСек, Знач ИмяУспешногоСлучая) Экспорт

	Если Случаи.Количество() = 0 Тогда
		Случаи.Добавить(Генератор.НовыйСлучай(ИмяУспешногоСлучая, "passed"));
	КонецЕсли;

	Записано = Генератор.Записать(КаталогРезультатов, Случаи, ДатаНачала, ДлительностьСек);

	Лог.Информация("Результаты Allure сохранены: %1, файлов: %2", КаталогРезультатов, Записано);

КонецПроцедуры

#КонецОбласти
