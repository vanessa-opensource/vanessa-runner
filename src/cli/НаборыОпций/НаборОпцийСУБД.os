// Общие опции СУБД (сервер баз данных).
// Подключается к команде через &НаборОпций("НаборОпцийСУБД").

&Опция(Имя = "dbms-type", Описание = "Тип СУБД")
&ТПеречисление
&Перечисление(Имя = "MSSQLServer", Значение = "MSSQLServer", Описание = "Microsoft SQL Server")
&Перечисление(Имя = "PostgreSQL", Значение = "PostgreSQL", Описание = "PostgreSQL")
&Перечисление(Имя = "IBMDB2", Значение = "IBMDB2", Описание = "IBM DB2")
&Перечисление(Имя = "OracleDatabase", Значение = "OracleDatabase", Описание = "Oracle Database")
&ВОкружении("VRUNNER_DBMS_TYPE")
Перем ТипСУБД Экспорт;

&Опция(Имя = "dbms-server", Описание = "Адрес сервера СУБД")
&ТСтрока
&ВОкружении("VRUNNER_DBMS_SERVER")
Перем СерверСУБД Экспорт;

&Опция(Имя = "dbms-base", Описание = "Имя базы данных СУБД")
&ТСтрока
&ВОкружении("VRUNNER_DBMS_BASE")
Перем ИмяБазыДанных Экспорт;

&Опция(Имя = "dbms-user", Описание = "Пользователь СУБД")
&ТСтрока
&ВОкружении("VRUNNER_DBMS_USER")
Перем ПользовательСУБД Экспорт;

&Опция(Имя = "dbms-pwd", Описание = "Пароль СУБД")
&ТСтрока
&ВОкружении("VRUNNER_DBMS_PWD")
Перем ПарольСУБД Экспорт;

&НаборОпций
Процедура ПриСозданииОбъекта()
КонецПроцедуры

// Дополняет структуру параметров подключения полями СУБД (если указан тип).
//
// Параметры:
//   ПараметрыПодключения - Структура - дополняется ключами ТипСУБД, СерверСУБД и т.д.
//
Процедура ДополнитьПараметрыПодключения(ПараметрыПодключения) Экспорт
	Если ЗначениеЗаполнено(ТипСУБД) Тогда
		ПараметрыПодключения.Вставить("ТипСУБД", ТипСУБД);
		ПараметрыПодключения.Вставить("СерверСУБД", СерверСУБД);
		ПараметрыПодключения.Вставить("ИмяБазыДанных", ИмяБазыДанных);
		ПараметрыПодключения.Вставить("ПользовательСУБД", ПользовательСУБД);
		ПараметрыПодключения.Вставить("ПарольСУБД", ПарольСУБД);
	КонецЕсли;
КонецПроцедуры
