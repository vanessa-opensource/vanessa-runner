// BSLLS:ExportVariables-off Поля &Опция требуют Экспорт для доступа из подкоманд autumn-cli.
// BSLLS:MissingVariablesDescription-off Поля &Опция/&Аргумент/&НаборОпций - описания заданы в самой аннотации.
// BSLLS:UnusedLocalVariable-off Поля &Опция/&Лог инициализируются autumn-фреймворком через рефлексию.
// Общие опции подключения к информационной базе.
// Подключается к команде через &НаборОпций("НаборОпцийПодключения").

&Опция(Имя = "ibconnection", Описание = "Строка подключения к информационной базе (/F или /S)")
&ТСтрока
&ВОкружении("VRUNNER_IBCONNECTION")
Перем СтрокаПодключения Экспорт;

&Опция(Имя = "db-user", Описание = "Имя пользователя информационной базы")
&ТСтрока
&ВОкружении("VRUNNER_DBUSER")
Перем Пользователь Экспорт;

&Опция(Имя = "db-pwd", Описание = "Пароль пользователя информационной базы")
&ТСтрока
&ВОкружении("VRUNNER_DBPWD")
Перем Пароль Экспорт;

&НаборОпций
Процедура ПриСозданииОбъекта()
КонецПроцедуры

// Параметры подключения из опций, как они заданы (пустая строка подключения не подменяется).
//
// Параметры:
//   ОпцииСУБД - НаборОпцийСУБД, Неопределено - набор опций СУБД для серверной ИБ (необязательно)
//
// Возвращаемое значение:
//   Структура - СтрокаПодключения, Пользователь, Пароль и поля СУБД, если задан --dbms-type
//
Функция ПараметрыПодключения(Знач ОпцииСУБД = Неопределено) Экспорт

	Результат = Новый Структура(
		"СтрокаПодключения, Пользователь, Пароль",
		СтрокаПодключения, Пользователь, Пароль);
	Если ОпцииСУБД <> Неопределено Тогда
		ОпцииСУБД.ДополнитьПараметрыПодключения(Результат);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Параметры подключения, если заданы --ibconnection или --dbms-type; иначе Неопределено
// (сервис создаст временную базу).
//
// Параметры:
//   ОпцииСУБД - НаборОпцийСУБД, Неопределено - набор опций СУБД для серверной ИБ (необязательно)
//
// Возвращаемое значение:
//   Структура, Неопределено - см. ПараметрыПодключения
//
Функция ПараметрыПодключенияЕслиЗаданы(Знач ОпцииСУБД = Неопределено) Экспорт

	ЗаданаСУБД = ОпцииСУБД <> Неопределено И ЗначениеЗаполнено(ОпцииСУБД.ТипСУБД);
	Если НЕ ЗначениеЗаполнено(СтрокаПодключения) И НЕ ЗаданаСУБД Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ПараметрыПодключения(ОпцииСУБД);

КонецФункции

// Параметры подключения; без строки подключения - файловая база по умолчанию
// (КаталогФайловойБазыПоУмолчанию, там же её создаёт infobase init).
//
// Параметры:
//   ОпцииСУБД - НаборОпцийСУБД, Неопределено - набор опций СУБД для серверной ИБ (необязательно)
//
// Возвращаемое значение:
//   Структура - СтрокаПодключения, Пользователь, Пароль и (для файловой ИБ по умолчанию) КаталогБазы
//
Функция СформироватьПараметрыПодключения(Знач ОпцииСУБД = Неопределено) Экспорт

	Если ЗначениеЗаполнено(СтрокаПодключения) Тогда
		Возврат ПараметрыПодключения(ОпцииСУБД);
	КонецЕсли;

	КаталогБазы = КаталогФайловойБазыПоУмолчанию();
	// BSLLS:NumberOfValuesInStructureConstructor-off Параметры подключения к файловой базе по умолчанию.
	Возврат Новый Структура(
		"СтрокаПодключения, Пользователь, Пароль, КаталогБазы",
		"/F""" + КаталогБазы + """", "", "", КаталогБазы);

КонецФункции

// Возвращаемое значение:
//   Строка - полный путь к файловой базе по умолчанию (build/ib от текущего каталога)
//
Функция КаталогФайловойБазыПоУмолчанию() Экспорт
	Возврат Новый Файл("build/ib").ПолноеИмя;
КонецФункции
