// BSLLS:ExportVariables-off Поля &Опция требуют Экспорт для доступа из подкоманд autumn-cli.
// BSLLS:MissingVariablesDescription-off Поля &Опция/&Аргумент/&НаборОпций - описания заданы в самой аннотации.
// BSLLS:UnusedLocalVariable-off Поля &Опция/&Лог инициализируются autumn-фреймворком через рефлексию.
// Общие опции подключения к информационной базе.
// Подключается к команде через &НаборОпций("НаборОпцийПодключения").

&Опция(Имя = "ibconnection", Описание = "Строка подключения к информационной базе (/F или /S)")
&ТСтрока
&ВОкружении("VRUNNER_IBCONNECTION")
Перем СтрокаПодключения Экспорт;

&Опция(Имя = "db-user", Описание = "Имя пользователя информационной базы")
&ТСтрока
&ВОкружении("VRUNNER_DBUSER")
Перем Пользователь Экспорт;

&Опция(Имя = "db-pwd", Описание = "Пароль пользователя информационной базы")
&ТСтрока
&ВОкружении("VRUNNER_DBPWD")
Перем Пароль Экспорт;

&НаборОпций
Процедура ПриСозданииОбъекта()
КонецПроцедуры

// Сформировать структуру параметров подключения к информационной базе.
// Если строка подключения не задана - по умолчанию используется файловая база build/ib
// (тот же путь, в котором её создаёт команда infobase init).
//
// Параметры:
//   ОпцииСУБД - НаборОпцийСУБД, Неопределено - набор опций СУБД для серверной ИБ (необязательно)
//
// Возвращаемое значение:
//   Структура - СтрокаПодключения, Пользователь, Пароль и (для файловой ИБ по умолчанию) КаталогБазы
//
Функция СформироватьПараметрыПодключения(Знач ОпцииСУБД = Неопределено) Экспорт

	Если ЗначениеЗаполнено(СтрокаПодключения) Тогда
		ПараметрыПодключения = Новый Структура(
			"СтрокаПодключения, Пользователь, Пароль",
			СтрокаПодключения, Пользователь, Пароль);
		Если ОпцииСУБД <> Неопределено Тогда
			ОпцииСУБД.ДополнитьПараметрыПодключения(ПараметрыПодключения);
		КонецЕсли;
		Возврат ПараметрыПодключения;
	КонецЕсли;

	Файл = Новый Файл("build/ib");
	КаталогБазы = Файл.ПолноеИмя;
	// BSLLS:NumberOfValuesInStructureConstructor-off Параметры подключения к временной файловой базе.
	Возврат Новый Структура(
		"СтрокаПодключения, Пользователь, Пароль, КаталогБазы",
		"/F""" + КаталогБазы + """", "", "", КаталогБазы);

КонецФункции
