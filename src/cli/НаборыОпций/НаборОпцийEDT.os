// BSLLS:LineLength-off
// BSLLS:NumberOfValuesInStructureConstructor-off
// BSLLS:ExportVariables-off Поля &Опция требуют Экспорт для доступа из подкоманд autumn-cli.
// BSLLS:MissingVariablesDescription-off Поля &Опция/&НаборОпций - описания заданы в самой аннотации.
// BSLLS:LatinAndCyrillicSymbolInWord-off Технические идентификаторы EDT (ВерсияEDT/WorkspaceEDT/ОпцииEDT).
// Опции интеграции с 1С:EDT (1cedtcli): явный путь к 1cedtcli, версия установленной EDT,
// рабочая область, таймаут и JVM-аргументы запуска. Используется самостоятельно (cf/cfe convert) либо
// как вложенный набор внутри НаборОпцийИсходников (cf/cfe/epf/infobase/validate).
// Подключается к команде/набору через &НаборОпций("НаборОпцийEDT").

&Опция(Имя = "edt-path", Описание = "Путь к 1cedtcli (исполняемый файл или каталог установки EDT). Если задан - используется как есть, поиск установленной EDT и PATH не выполняется")
&ТСтрока
&ВОкружении("VRUNNER_EDT_PATH")
Перем ПутьEDT Экспорт;

&Опция(Имя = "edt-version", Описание = "Версия установленной EDT для выбора среди нескольких (например 2024.1). Не связана с --v8version")
&ТСтрока
&ВОкружении("VRUNNER_EDT_VERSION")
Перем ВерсияEDT Экспорт;

&Опция(Имя = "edt-workspace", Описание = "Базовый каталог рабочей области EDT (по умолчанию - временный)")
&ТСтрока
&ВОкружении("VRUNNER_EDT_WORKSPACE")
Перем WorkspaceEDT Экспорт;

&Опция(Имя = "edt-timeout", Описание = "Таймаут операций 1cedtcli в секундах (export/import/build/validate). По умолчанию 1cedtcli использует свой (60 минут) - на больших проектах может потребоваться больше или меньше")
&ТЧисло
&ВОкружении("VRUNNER_EDT_TIMEOUT")
Перем ТаймаутEDT Экспорт;

&Опция(Имя = "edt-vmargs", Описание = "Дополнительный JVM-аргумент для 1cedtcli, например -Xmx8g для лимита ОЗУ (можно указать несколько раз). Значения с ведущим дефисом указывайте через '=': --edt-vmargs=-Xmx8g")
&ТМассивСтрок
&ВОкружении("VRUNNER_EDT_VMARGS")
Перем VmАргументыEDT Экспорт;

&Опция(Имя = "edt-project", Описание = "Имя проекта в workspace 1С:EDT (для экспорта/импорта по имени)")
&ТСтрока
&ВОкружении("VRUNNER_EDT_PROJECT")
Перем ПроектEDT Экспорт;

&НаборОпций
Процедура ПриСозданииОбъекта()
КонецПроцедуры

// Сформировать структуру EDT-параметров для СервисEDT (без формата исходников).
//
// Возвращаемое значение:
//   Структура - "ПутьКCli, Версия, Workspace, Таймаут, VmАргументы".
Функция СформироватьПараметры() Экспорт

	Параметры = Новый Структура;
	Дополнить(Параметры);
	Возврат Параметры;

КонецФункции

// Дополнить переданную структуру параметров исходников EDT-специфичными полями.
//
// Параметры:
//   Параметры - Структура - структура параметров исходников (дополняется на месте)
Процедура Дополнить(Параметры) Экспорт

	Параметры.Вставить("ПутьКCli", ПутьEDT);
	Параметры.Вставить("Версия", ВерсияEDT);
	Параметры.Вставить("Workspace", WorkspaceEDT);
	Параметры.Вставить("Таймаут", ТаймаутEDT);
	Параметры.Вставить("VmАргументы", VmАргументыEDT);
	Параметры.Вставить("ПроектEDT", ПроектEDT);

КонецПроцедуры
