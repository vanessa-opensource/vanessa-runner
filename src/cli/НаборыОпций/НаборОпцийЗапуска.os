// BSLLS:ExportVariables-off Поля &Опция требуют Экспорт для доступа из подкоманд autumn-cli.
// BSLLS:MissingVariablesDescription-off Поля &Опция/&Аргумент/&НаборОпций - описания заданы в самой аннотации.
// BSLLS:UnusedLocalVariable-off Поля &Опция/&Лог инициализируются autumn-фреймворком через рефлексию.
// Общие опции запуска 1С.
// Подключается к команде через &НаборОпций("НаборОпцийЗапуска").

&Опция(Имя = "ordinaryapp", Описание = "Запускать толстый клиент (/RunModeOrdinaryApplication); по умолчанию - тонкий")
&Флаговый
&ВОкружении("VRUNNER_ORDINARYAPP")
Перем ТолстыйКлиент Экспорт;

&Опция(Имя = "additional", Описание = "Дополнительные параметры запуска платформы")
&ТСтрока
&ВОкружении("VRUNNER_ADDITIONAL")
Перем ДополнительныеПараметры Экспорт;

&Опция(Имя = "ibsrv", Описание = "Запускать команду через автономный сервер ibsrv (только для файловых ИБ)")
&Флаговый
&ВОкружении("VRUNNER_IBSRV")
Перем ИспользоватьIbsrv Экспорт;

&Опция(Имя = "ibsrv-direct", Описание = "Использовать прямое соединение с ibsrv (по умолчанию - через WS)")
&Флаговый
&ВОкружении("VRUNNER_IBSRV_DIRECT")
Перем ИспользоватьПрямоеСоединениеIbsrv Экспорт;

&Опция(Имя = "ibsrv-debug", Описание = "Включить порт отладки на запущенном ibsrv")
&Флаговый
&ВОкружении("VRUNNER_IBSRV_DEBUG")
Перем ИспользоватьОтладкуIbsrv Экспорт;

&Опция(Имя = "ibsrv-attach",
	Описание = "Подключиться к уже запущенному автономному серверу вместо старта своего (требует --ibsrv-port)")
&Флаговый
&ВОкружении("VRUNNER_IBSRV_ATTACH")
Перем ПодключитьсяКСуществующемуIbsrv Экспорт;

&Опция(Имя = "ibsrv-port",
	Описание = "Порт ibsrv: при --ibsrv-attach - порт подключения; иначе - порт старта (занят -> ошибка, без перебора)")
&ТЧисло
&ВОкружении("VRUNNER_IBSRV_PORT")
Перем ПортIbsrv Экспорт;

&НаборОпций
Процедура ПриСозданииОбъекта()
КонецПроцедуры

// Дополнить параметры запуска платформы полями набора: режим клиента, дополнительные
// параметры командной строки и настройки автономного сервера ibsrv.
//
// Параметры:
//   ПараметрыЗапуска - Структура - параметры запуска (дополняется на месте)
//   ОбязательныеКлючи - Строка - ключи запуска, которые команда передаёт всегда (например, /TESTMANAGER);
//                                ставятся перед значением --additional
//
Процедура ДополнитьПараметрыЗапуска(ПараметрыЗапуска, Знач ОбязательныеКлючи = "") Экспорт

	Ключи = Новый Массив;
	Если ЗначениеЗаполнено(ОбязательныеКлючи) Тогда
		Ключи.Добавить(ОбязательныеКлючи);
	КонецЕсли;
	Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда
		Ключи.Добавить(ДополнительныеПараметры);
	КонецЕсли;

	ПараметрыЗапуска.Вставить("ТолстыйКлиент", ТолстыйКлиент = Истина);
	ПараметрыЗапуска.Вставить("ДополнительныеПараметры", СтрСоединить(Ключи, " "));
	ПараметрыЗапуска.Вставить("ИспользоватьIbsrv", ИспользоватьIbsrv);
	ПараметрыЗапуска.Вставить("ИспользоватьПрямоеСоединениеIbsrv", ИспользоватьПрямоеСоединениеIbsrv);
	ПараметрыЗапуска.Вставить("ИспользоватьОтладкуIbsrv", ИспользоватьОтладкуIbsrv);
	ПараметрыЗапуска.Вставить("ПодключитьсяКСуществующемуIbsrv", ПодключитьсяКСуществующемуIbsrv);
	ПараметрыЗапуска.Вставить("ПортIbsrv", ПортIbsrv);

КонецПроцедуры
