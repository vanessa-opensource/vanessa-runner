// BSLLS:LineLength-off
// BSLLS:NumberOfValuesInStructureConstructor-off
// BSLLS:ExportVariables-off Поля &Опция требуют Экспорт для доступа из подкоманд autumn-cli.
// BSLLS:MissingVariablesDescription-off Поля &Опция/&Аргумент/&НаборОпций - описания заданы в самой аннотации.
// Опции формата исходников (XML-дамп Конфигуратора или 1С:EDT).
// Используются командами, принимающими/выгружающими каталог исходников
// (cf compile/load/decompile, cfe compile/load/decompile, infobase init, epf compile/decompile).
// Подключается к команде через &НаборОпций("НаборОпцийИсходников").

&Опция(Имя = "src-format", Описание = "Формат каталога исходников")
&ТПеречисление
&Перечисление(Имя = "auto", Значение = "auto", Описание = "Определить формат автоматически по маркерам каталога (по умолчанию).")
&Перечисление(Имя = "edt", Значение = "edt", Описание = "Формат 1С:EDT (конвертация через 1cedtcli).")
&Перечисление(Имя = "xml", Значение = "xml", Описание = "XML-дамп Конфигуратора.")
Перем ФорматИсходников Экспорт;

&Опция(Имя = "edt-version", Описание = "Версия установленной EDT для выбора среди нескольких (например 2024.1). Не связана с --v8version")
&ТСтрока
&ВОкружении("VRUNNER_EDT_VERSION")
Перем ВерсияEDT Экспорт;

&Опция(Имя = "edt-workspace", Описание = "Базовый каталог рабочей области EDT (по умолчанию - временный)")
&ТСтрока
&ВОкружении("VRUNNER_EDT_WORKSPACE")
Перем WorkspaceEDT Экспорт;

&НаборОпций
Процедура ПриСозданииОбъекта()
КонецПроцедуры

// Сформировать структуру параметров исходников для сервисов (СервисEDT).
//
// Возвращаемое значение:
//   Структура - "Формат, Версия, Workspace".
Функция СформироватьПараметрыИсходников() Экспорт

	Возврат Новый Структура(
		"Формат, Версия, Workspace",
		ФорматИсходников,
		ВерсияEDT,
		WorkspaceEDT);

КонецФункции
