// BSLLS:LineLength-off
// BSLLS:NumberOfValuesInStructureConstructor-off
// BSLLS:Typo-off
// BSLLS:MissingVariablesDescription-off Поля &Опция/&Аргумент/&НаборОпций - описания заданы в самой аннотации.
&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисРасширений;

&Пластилин
Перем СервисПлатформы;

&Пластилин
Перем СервисЗаполненияПараметров;

&Пластилин
Перем СервисОкружения;

&НаборОпций("НаборОпцийПодключения")
Перем ОпцииПодключения;

&НаборОпций("НаборОпцийIbcmd")
Перем ОпцииIbcmd;

&НаборОпций("НаборОпцийПлатформы")
Перем ОпцииПлатформы;

&НаборОпций("НаборОпцийСУБД")
Перем ОпцииСУБД;

&Аргумент(Имя = "SRC", Описание = "Каталог XML-исходников расширения или путь к .cfe-файлу")
&ТСтрока
Перем Источник;

&Опция(Имя = "extension-name",
		Описание = "Имя расширения в базе. Если не задано - берётся из имени каталога или файла источника")
&ТСтрока
&ВОкружении("VRUNNER_EXTENSION_NAME")
Перем ИмяРасширения;

// --- Свойства расширения ---

&Опция(Имя = "safe-mode", Описание = "Включить безопасный режим расширения (после загрузки)")
&Флаговый
Перем БезопасныйРежим;

&Опция(Имя = "active", Описание = "Сделать расширение активным (после загрузки)")
&Флаговый
Перем Активность;

&Опция(Имя = "unsafe-action-protection", Описание = "Включить защиту от опасных действий (после загрузки)")
&Флаговый
Перем ЗащитаОтОпасныхДействий;

&Опция(Имя = "used-in-rib", Описание = "Используется в РИБ (только ibcmd)")
&Флаговый
Перем ИспользуетсяВРИБ;

&Опция(Имя = "scope-infobase", Описание = "Область действия - ИБ, не разделитель данных (только ibcmd)")
&Флаговый
Перем ОбластьДействия_ИБ;

&Опция(Имя = "increment", Описание = "Инкрементальная загрузка по индексу изменений")
&Флаговый
Перем Инкремент;

&Опция(Имя = "update-db", Описание = "После загрузки обновить конфигурацию БД для расширения (UpdateDBCfg / config apply)")
&Флаговый
Перем ОбновитьБД;

&НаборОпций("НаборОпцийОбновленияБД")
Перем ОпцииОбновленияБД;

&НаборОпций("НаборОпцийИсходников")
Перем ОпцииИсходников;

&НаборОпций("НаборОпцийНастроек")
Перем ОпцииНастроек; // BSLLS:UnusedLocalVariable-off

&ПодкомандаПриложения(Имя = "load", Родитель = "КомандаCfe", Описание = "Загрузить расширение в базу из .cfe-файла или XML-исходников")
&ДоступноВMCP
&MCPДлительная
&MCPРазрушающая
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);

	ПутьИсточника = ИсточникИлиТекущийКаталог();

	ЕслиНеЗаполненоОпределитьИмяРасширения(ПутьИсточника);
	ПроверитьИмяРасширения(ИмяРасширения);

	Лог.Отладка("Начало выполнения команды cfe load");
	Лог.Отладка("Источник: %1", ПутьИсточника);
	Лог.Отладка("Имя расширения: %1", ИмяРасширения);

	ПараметрыПлатформы = Новый Структура(
		"ВерсияПлатформы, КодРазрешения, Язык, Локаль",
		ОпцииПлатформы.ВерсияПлатформы,
		ОпцииПлатформы.КодРазрешения,
		ОпцииПлатформы.Язык,
		ОпцииПлатформы.Локаль);

	ПараметрыПодключения = ОпцииПодключения.СформироватьПараметрыПодключения(ОпцииСУБД);

	// 1) Загрузка расширения напрямую движком (конфигуратор или ibcmd) в целевую базу.
	Если ЭтоФайлCfe(ПутьИсточника) Тогда
		ПроверитьСуществованиеФайла(ПутьИсточника);
		СервисРасширений.ЗагрузитьРасширениеВБазуИзФайла(
			ПараметрыПодключения,
			ПутьИсточника,
			ИмяРасширения,
			ОпцииIbcmd.ИспользоватьIbcmd,
			ПараметрыПлатформы);
	Иначе
		ПроверитьСуществованиеКаталога(ПутьИсточника);
		СервисРасширений.ЗагрузитьРасширениеВБазуИзФайлов(
			ПараметрыПодключения,
			ПутьИсточника,
			ИмяРасширения,
			ОпцииIbcmd.ИспользоватьIbcmd,
			ПараметрыПлатформы,
			Инкремент,
			ОпцииИсходников.СформироватьПараметрыИсходников());
	КонецЕсли;

	// 2) Установка свойств расширения отдельным шагом.
	ПрименитьСвойстваРасширения(ПараметрыПодключения, ПараметрыПлатформы);

	// 3) Обновление конфигурации БД (если запрошено).
	Если ОбновитьБД = Истина Тогда
		НастройкиОбновления = ОпцииОбновленияБД.СформироватьНастройкиОбновления(ИмяРасширения);
		Лог.Информация("Обновление расширения '%1' БД (restr=%2)", ИмяРасширения, НастройкиОбновления.РежимРеструктуризации);
		СервисПлатформы.ОбновитьКонфигурациюБД(
			ПараметрыПодключения,
			ОпцииIbcmd.ИспользоватьIbcmd,
			ПараметрыПлатформы,
			НастройкиОбновления);
	КонецЕсли;

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Функция ИсточникИлиТекущийКаталог()

	Если ЗначениеЗаполнено(Источник) Тогда
		Возврат Источник;
	КонецЕсли;

	Возврат СервисОкружения.РабочийКаталог();

КонецФункции

Процедура ЕслиНеЗаполненоОпределитьИмяРасширения(Знач ПутьИсточника)

	Если ЗначениеЗаполнено(ИмяРасширения) Тогда
		Возврат;
	КонецЕсли;

	ФайлИсточника = Новый Файл(ПутьИсточника);
	Если ЭтоФайлCfe(ПутьИсточника) Тогда
		ИмяРасширения = ФайлИсточника.ИмяБезРасширения;
	Иначе
		ИмяРасширения = ФайлИсточника.Имя;
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьИмяРасширения(Знач Имя)

	Если НЕ ЗначениеЗаполнено(Имя) Тогда
		ВызватьИсключение "Имя расширения не задано и не удалось определить его из пути источника.";
	КонецЕсли;

	Шаблон = Новый РегулярноеВыражение("^[a-zA-Zа-яА-ЯёЁ_][a-zA-Zа-яА-ЯёЁ0-9_]*$");
	Если НЕ Шаблон.Совпадает(Имя) Тогда
		ВызватьИсключение "Неверное имя! Имя должно состоять из одного слова, начинаться с буквы или подчёркивания и не иметь спецсимволов кроме _";
	КонецЕсли;

КонецПроцедуры

Функция ЭтоФайлCfe(Знач Путь)

	Возврат СтрЗаканчиваетсяНа(НРег(Путь), ".cfe");

КонецФункции

Процедура ПроверитьСуществованиеФайла(Знач Путь)

	Файл = Новый Файл(Путь);
	Если НЕ Файл.Существует() Тогда
		ВызватьИсключение СтрШаблон("Файл расширения не найден: %1", Путь);
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьСуществованиеКаталога(Знач Путь)

	Файл = Новый Файл(Путь);
	Если НЕ Файл.Существует() Тогда
		ВызватьИсключение СтрШаблон("Каталог исходников расширения не найден: %1", Путь);
	КонецЕсли;

КонецПроцедуры

Процедура ПрименитьСвойстваРасширения(ПараметрыПодключения, ПараметрыПлатформы)

	// ibcmd ставит свойства нативно и только если что-то задано флагами (его дефолты применяет ibcmd).
	Если ОпцииIbcmd.ИспользоватьIbcmd = Истина Тогда
		Если ЕстьСвойстваРасширения() Тогда
			УстановитьСвойстваРасширенияIbcmd(ПараметрыПодключения, ПараметрыПлатформы);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	// Конфигуратор не задаёт эти свойства сам, поэтому всегда прогоняем обработку - в т.ч. чтобы
	// гарантировать дефолты: безопасный режим и защита от опасных действий по умолчанию выключены.
	УстановитьСвойстваРасширенияКонфигуратор(ПараметрыПодключения, ПараметрыПлатформы);

	Если ЕстьСвойстваТолькоIbcmd() Тогда
		Лог.Предупреждение("Свойства --used-in-rib, --scope-infobase поддерживаются только в режиме ibcmd (--ibcmd). Эти свойства не применены.");
	КонецЕсли;

КонецПроцедуры

Функция ЕстьСвойстваРасширения()
	// &Флаговый по умолчанию даёт Ложь, поэтому факт явной установки определяем по значению = Истина:
	// чтобы изменить свойство расширения нужно явно передать соответствующий флаг.
	Возврат БезопасныйРежим = Истина
		ИЛИ Активность = Истина
		ИЛИ ЗащитаОтОпасныхДействий = Истина
		ИЛИ ЕстьСвойстваТолькоIbcmd();
КонецФункции

Функция ЕстьСвойстваТолькоIbcmd()
	// Свойства, поддерживаемые только в режиме ibcmd.
	Возврат ИспользуетсяВРИБ = Истина ИЛИ ОбластьДействия_ИБ = Истина;
КонецФункции

Процедура УстановитьСвойстваРасширенияIbcmd(ПараметрыПодключения, ПараметрыПлатформы)

	Свойства = Новый Структура;
	Свойства.Вставить("Активность",              ПреобразоватьБулевоеСвойство(Активность, Истина));
	Свойства.Вставить("БезопасныйРежим",        ПреобразоватьБулевоеСвойство(БезопасныйРежим, Ложь));
	Свойства.Вставить("ИмяПрофиляБезопасности", "");
	Свойства.Вставить("ЗащитаОтОпасныхДействий", ПреобразоватьБулевоеСвойство(ЗащитаОтОпасныхДействий, Ложь));
	Свойства.Вставить("ИспользуетсяВ_РИБ",      ПреобразоватьБулевоеСвойство(ИспользуетсяВРИБ, Ложь));
	Свойства.Вставить("ОбластьДействия_ИБ",     ПреобразоватьБулевоеСвойство(ОбластьДействия_ИБ, Истина));

	СервисРасширений.ИзменитьСвойстваРасширения(
		ПараметрыПодключения,
		ИмяРасширения,
		Свойства,
		ПараметрыПлатформы);

КонецПроцедуры

Процедура УстановитьСвойстваРасширенияКонфигуратор(ПараметрыПодключения, ПараметрыПлатформы)

	// Конфигуратор не задаёт свойства расширения из командной строки, поэтому ставим их
	// обработкой РаботаСРасширениями поверх уже загруженного расширения.
	// Безопасный режим и защита от опасных действий имеют дефолт "выключено" (false) и
	// передаются всегда; активность меняем только при явном флаге --active (по умолчанию
	// загруженное расширение активно).
	Свойства = Новый Структура;
	Свойства.Вставить("БезопасныйРежим", ФлагВСтроку(БезопасныйРежим));
	Свойства.Вставить("ЗащитаОтОпасныхДействий", ФлагВСтроку(ЗащитаОтОпасныхДействий));
	Если Активность = Истина Тогда // BSLLS:CompareWithBoolean-off
		Свойства.Вставить("Активность", ФлагВСтроку(Активность));
	КонецЕсли;

	СервисРасширений.УстановитьПараметрыРасширенияЧерезОбработку(
		ПараметрыПодключения,
		ИмяРасширения,
		Свойства,
		ПараметрыПлатформы);

КонецПроцедуры

Функция ФлагВСтроку(Знач Флаг)
	// Значение &Флаговый-опции в строку для обработки set-options:
	// голый флаг (Истина) -> "true"; не переданный флаг (Ложь) -> "false".
	Возврат ?(Флаг = Истина, "true", "false"); // BSLLS:CompareWithBoolean-off
КонецФункции

Функция ПреобразоватьБулевоеСвойство(Знач Значение, Знач ПоУмолчанию)

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		// &Флаговый: Ложь означает "флаг не передан" - применяем безопасный дефолт
		Если Значение = Ложь Тогда
			Возврат ПоУмолчанию;
		КонецЕсли;
		Возврат Значение;
	КонецЕсли;

	ЗначениеНРег = НРег(СокрЛП(Значение));
	Если ЗначениеНРег = "yes" ИЛИ ЗначениеНРег = "true" ИЛИ ЗначениеНРег = "1" Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

#КонецОбласти
