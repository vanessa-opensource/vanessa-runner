// BSLLS:LineLength-off
// BSLLS:Typo-off
// BSLLS:MissingVariablesDescription-off Поля &Опция/&Аргумент/&НаборОпций - описания заданы в самой аннотации.
// BSLLS:MissingParameterDescription-off Внутренние служебные методы команды.
// BSLLS:MissingReturnedValueDescription-off Внутренние служебные методы команды.
&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисРасширений;

&Пластилин
Перем СервисПлатформы;

&Пластилин
Перем СервисЗаполненияПараметров;

&Пластилин
Перем СервисОкружения;

&Пластилин
Перем ФайловыеОперации;

&НаборОпций("НаборОпцийПодключения")
Перем ОпцииПодключения;

&НаборОпций("НаборОпцийIbcmd")
Перем ОпцииIbcmd;

&НаборОпций("НаборОпцийПлатформы")
Перем ОпцииПлатформы;

&НаборОпций("НаборОпцийСУБД")
Перем ОпцииСУБД;

&Аргумент(Имя = "SRC",
	Описание = "Каталог XML-исходников расширения или путь к .cfe-файлу (по умолчанию - текущий каталог)")
&ТСтрока
&Обязательный(Ложь)
Перем Источник;

&Опция(Имя = "extension-name",
		Описание = "Имя расширения в базе. Если не задано - берётся из имени каталога или файла источника")
&ТСтрока
&ВОкружении("VRUNNER_EXTENSION_NAME")
Перем ИмяРасширения;

&Опция(Имя = "safe-mode", Описание = "Включить безопасный режим расширения (после загрузки)")
&Флаговый
Перем БезопасныйРежим;

&Опция(Имя = "active", Описание = "Сделать расширение активным (после загрузки)")
&Флаговый
Перем Активность;

&Опция(Имя = "unsafe-action-protection", Описание = "Включить защиту от опасных действий (после загрузки)")
&Флаговый
Перем ЗащитаОтОпасныхДействий;

&Опция(Имя = "used-in-rib", Описание = "Используется в РИБ (только ibcmd)")
&Флаговый
Перем ИспользуетсяВРИБ;

&Опция(Имя = "scope-infobase", Описание = "Область действия - ИБ, не разделитель данных (только ibcmd)")
&Флаговый
Перем ОбластьДействия_ИБ;

&Опция(Имя = "increment", Описание = "Инкрементальная загрузка по индексу изменений")
&Флаговый
Перем Инкремент;

&Опция(Имя = "no-update-db",
		Описание = "Не обновлять конфигурацию БД после загрузки (по умолчанию БД обновляется; при пропуске обновления свойства расширения не изменяются)")
&Флаговый
Перем НеОбновлятьБД;

&НаборОпций("НаборОпцийОбновленияБД")
Перем ОпцииОбновленияБД;

&НаборОпций("НаборОпцийИсходников")
Перем ОпцииИсходников;

&НаборОпций("НаборОпцийНастроек")
Перем ОпцииНастроек; // BSLLS:UnusedLocalVariable-off

&ПодкомандаПриложения(Имя = "load", Родитель = "КомандаCfe", Описание = "Загрузить расширение в базу из .cfe-файла или XML-исходников")
&ДоступноВMCP
&MCPДлительная
&MCPРазрушающая
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);

	ПутьИсточника = СервисОкружения.ПутьИлиРабочийКаталог(Источник);

	Если НЕ ЗначениеЗаполнено(ИмяРасширения) Тогда
		ИмяРасширения = СервисРасширений.ИмяРасширенияИзПути(ПутьИсточника);
	КонецЕсли;
	СервисРасширений.ПроверитьИмяРасширения(ИмяРасширения);

	Лог.Отладка("Начало выполнения команды cfe load");
	Лог.Отладка("Источник: %1", ПутьИсточника);
	Лог.Отладка("Имя расширения: %1", ИмяРасширения);

	ПараметрыПлатформы = ОпцииПлатформы.СформироватьПараметрыПлатформы();

	ПараметрыПодключения = ОпцииПодключения.СформироватьПараметрыПодключения(ОпцииСУБД);

	Если СтрЗаканчиваетсяНа(НРег(ПутьИсточника), ".cfe") Тогда
		ФайловыеОперации.ПроверитьСуществованиеФайла(ПутьИсточника, "Файл расширения не найден: %1");
		СервисРасширений.ЗагрузитьРасширениеВБазуИзФайла(
			ПараметрыПодключения,
			ПутьИсточника,
			ИмяРасширения,
			ОпцииIbcmd.ИспользоватьIbcmd,
			ПараметрыПлатформы);
	Иначе
		ФайловыеОперации.ПроверитьСуществованиеКаталога(ПутьИсточника, "Каталог исходников расширения не найден: %1");
		СервисРасширений.ЗагрузитьРасширениеВБазуИзФайлов(
			ПараметрыПодключения,
			ПутьИсточника,
			ИмяРасширения,
			ОпцииIbcmd.ИспользоватьIbcmd,
			ПараметрыПлатформы,
			Инкремент,
			ОпцииИсходников.СформироватьПараметрыИсходников());
	КонецЕсли;

	// Свойства расширения в конфигураторе ставит обработка в 1С:Предприятии, которому нужно
	// уже применённое к БД расширение, поэтому без обновления БД они не меняются.
	Если НеОбновлятьБД Тогда
		Лог.Информация("Обновление конфигурации БД пропущено (--no-update-db); свойства расширения не изменяются");
		Возврат;
	КонецЕсли;

	ОбновитьБДРасширения(ПараметрыПодключения, ПараметрыПлатформы);
	ПрименитьСвойстваРасширения(ПараметрыПодключения, ПараметрыПлатформы);

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Процедура ОбновитьБДРасширения(ПараметрыПодключения, ПараметрыПлатформы)

	НастройкиОбновления = ОпцииОбновленияБД.СформироватьНастройкиОбновления(ИмяРасширения);
	Лог.Информация("Обновление расширения '%1' БД (restr=%2)", ИмяРасширения, НастройкиОбновления.РежимРеструктуризации);
	СервисПлатформы.ОбновитьКонфигурациюБД(
		ПараметрыПодключения,
		ОпцииIbcmd.ИспользоватьIbcmd,
		ПараметрыПлатформы,
		НастройкиОбновления);

КонецПроцедуры

Процедура ПрименитьСвойстваРасширения(ПараметрыПодключения, ПараметрыПлатформы)

	// ibcmd ставит свойства нативно и только если что-то задано флагами (его дефолты применяет ibcmd).
	Если ОпцииIbcmd.ИспользоватьIbcmd = Истина Тогда
		Если ЕстьСвойстваРасширения() Тогда
			УстановитьСвойстваРасширенияIbcmd(ПараметрыПодключения, ПараметрыПлатформы);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	// Конфигуратор не задаёт эти свойства сам, поэтому всегда прогоняем обработку - в т.ч. чтобы
	// гарантировать документированные дефолты: безопасный режим и защита от опасных действий
	// выключены, даже если флаги не переданы.
	УстановитьСвойстваРасширенияКонфигуратор(ПараметрыПодключения, ПараметрыПлатформы);

	Если ЕстьСвойстваТолькоIbcmd() Тогда
		Лог.Предупреждение("Свойства --used-in-rib, --scope-infobase поддерживаются только в режиме ibcmd (--ibcmd). Эти свойства не применены.");
	КонецЕсли;

КонецПроцедуры

// &Флаговый без значения даёт Ложь, поэтому «флаг передан» - это строго значение Истина.
// BSLLS:CompareWithBoolean-off

Функция ЕстьСвойстваРасширения()
	Возврат БезопасныйРежим = Истина
		ИЛИ Активность = Истина
		ИЛИ ЗащитаОтОпасныхДействий = Истина
		ИЛИ ЕстьСвойстваТолькоIbcmd();
КонецФункции

Функция ЕстьСвойстваТолькоIbcmd()
	Возврат ИспользуетсяВРИБ = Истина ИЛИ ОбластьДействия_ИБ = Истина;
КонецФункции

Процедура УстановитьСвойстваРасширенияIbcmd(ПараметрыПодключения, ПараметрыПлатформы)

	// Не переданный флаг - дефолт ibcmd: расширение активно, область действия - ИБ, остальное выключено.
	Свойства = Новый Структура;
	Свойства.Вставить("Активность",              Истина);
	Свойства.Вставить("БезопасныйРежим",        БезопасныйРежим = Истина);
	Свойства.Вставить("ИмяПрофиляБезопасности", "");
	Свойства.Вставить("ЗащитаОтОпасныхДействий", ЗащитаОтОпасныхДействий = Истина);
	Свойства.Вставить("ИспользуетсяВ_РИБ",      ИспользуетсяВРИБ = Истина);
	Свойства.Вставить("ОбластьДействия_ИБ",     Истина);

	СервисРасширений.ИзменитьСвойстваРасширения(
		ПараметрыПодключения,
		ИмяРасширения,
		Свойства,
		ПараметрыПлатформы);

КонецПроцедуры

Процедура УстановитьСвойстваРасширенияКонфигуратор(ПараметрыПодключения, ПараметрыПлатформы)

	// Безопасный режим и защита от опасных действий передаются всегда (дефолт "выключено");
	// активность меняем только при явном флаге --active (загруженное расширение и так активно).
	Свойства = Новый Структура;
	Свойства.Вставить("БезопасныйРежим", ФлагВСтроку(БезопасныйРежим));
	Свойства.Вставить("ЗащитаОтОпасныхДействий", ФлагВСтроку(ЗащитаОтОпасныхДействий));
	Если Активность = Истина Тогда
		Свойства.Вставить("Активность", ФлагВСтроку(Активность));
	КонецЕсли;

	СервисРасширений.УстановитьПараметрыРасширенияЧерезОбработку(
		ПараметрыПодключения,
		ИмяРасширения,
		Свойства,
		ПараметрыПлатформы);

КонецПроцедуры

// Значение флага в строку для обработки set-options: "true" / "false".
Функция ФлагВСтроку(Знач Флаг)
	Возврат ?(Флаг = Истина, "true", "false");
КонецФункции

// BSLLS:CompareWithBoolean-on

#КонецОбласти
