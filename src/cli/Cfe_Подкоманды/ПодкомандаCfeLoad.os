// BSLLS:LineLength-off
// BSLLS:NumberOfValuesInStructureConstructor-off
// BSLLS:Typo-off
// BSLLS:MissingVariablesDescription-off Поля &Опция/&Аргумент/&НаборОпций - описания заданы в самой аннотации.
&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисРасширений;

&Пластилин
Перем СервисПлатформы;

&Пластилин
Перем СервисЗаполненияПараметров;

&Пластилин
Перем СервисОкружения;

&НаборОпций("НаборОпцийПодключения")
Перем ОпцииПодключения;

&НаборОпций("НаборОпцийIbcmd")
Перем ОпцииIbcmd;

&НаборОпций("НаборОпцийПлатформы")
Перем ОпцииПлатформы;

&НаборОпций("НаборОпцийСУБД")
Перем ОпцииСУБД;

&Аргумент(Имя = "SRC", Описание = "Каталог XML-исходников расширения или путь к .cfe-файлу")
&ТСтрока
Перем Источник;

&Опция(Имя = "extension-name",
		Описание = "Имя расширения в базе. Если не задано - берётся из имени каталога или файла источника")
&ТСтрока
&ВОкружении("VRUNNER_EXTENSION_NAME")
Перем ИмяРасширения;

// --- Свойства расширения ---

&Опция(Имя = "safe-mode", Описание = "Включить безопасный режим. Через конфигуратор устанавливается при загрузке; через ibcmd - отдельной командой после загрузки")
&Флаговый
Перем БезопасныйРежим;

&Опция(Имя = "active", Описание = "Активность расширения (только ibcmd)")
&Флаговый
Перем Активность;

&Опция(Имя = "unsafe-action-protection", Описание = "Включить защиту от опасных действий. Через конфигуратор устанавливается при загрузке; через ibcmd - отдельной командой после загрузки")
&Флаговый
Перем ЗащитаОтОпасныхДействий;

&Опция(Имя = "used-in-rib", Описание = "Используется в РИБ (только ibcmd)")
&Флаговый
Перем ИспользуетсяВРИБ;

&Опция(Имя = "scope-infobase", Описание = "Область действия - ИБ, не разделитель данных (только ibcmd)")
&Флаговый
Перем ОбластьДействия_ИБ;

&Опция(Имя = "increment", Описание = "Инкрементальная загрузка по индексу изменений")
&Флаговый
Перем Инкремент;

&Опция(Имя = "no-epf", Описание = "Загружать через конфигуратор без EPF (отключает установку свойств расширения)")
&Флаговый
Перем НеИспользоватьЭнтерпрайзРежим;

&Опция(Имя = "overwrite", Описание = "Перезаписать расширение, если оно уже установлено. По умолчанию загрузка уже установленного расширения завершается ошибкой (режим 1С:Предприятие)")
&Флаговый
Перем Перезаписывать;

&Опция(Имя = "update-db", Описание = "После загрузки обновить конфигурацию БД для расширения (UpdateDBCfg / config apply)")
&Флаговый
Перем ОбновитьБД;

&НаборОпций("НаборОпцийОбновленияБД")
Перем ОпцииОбновленияБД;

&НаборОпций("НаборОпцийИсходников")
Перем ОпцииИсходников;

&НаборОпций("НаборОпцийНастроек")
Перем ОпцииНастроек; // BSLLS:UnusedLocalVariable-off

&ПодкомандаПриложения(Имя = "load", Родитель = "КомандаCfe", Описание = "Загрузить расширение в базу из .cfe-файла или XML-исходников")
&ДоступноВMCP
&MCPРазрушающая
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);

	ПутьИсточника = ИсточникИлиТекущийКаталог();

	ЕслиНеЗаполненоОпределитьИмяРасширения(ПутьИсточника);
	ПроверитьИмяРасширения(ИмяРасширения);

	Лог.Отладка("Начало выполнения команды cfe load");
	Лог.Отладка("Источник: %1", ПутьИсточника);
	Лог.Отладка("Имя расширения: %1", ИмяРасширения);

	ПараметрыПлатформы = Новый Структура(
		"ВерсияПлатформы, КодРазрешения, Язык, Локаль",
		ОпцииПлатформы.ВерсияПлатформы,
		ОпцииПлатформы.КодРазрешения,
		ОпцииПлатформы.Язык,
		ОпцииПлатформы.Локаль);

	ПараметрыПодключения = ОпцииПодключения.СформироватьПараметрыПодключения(ОпцииСУБД);

	ПараметрыРасширения = Новый Структура(
		"БезопасныйРежим, ЗащитаОтОпасныхДействий, Перезаписывать",
		БезопасныйРежим,
		ЗащитаОтОпасныхДействий,
		Перезаписывать);

	Если ЭтоФайлCfe(ПутьИсточника) Тогда
		ПроверитьСуществованиеФайла(ПутьИсточника);
		СервисРасширений.ЗагрузитьРасширениеВБазуИзФайла(
			ПараметрыПодключения,
			ПутьИсточника,
			ИмяРасширения,
			ОпцииIbcmd.ИспользоватьIbcmd,
			ПараметрыПлатформы,
			ПараметрыРасширения,
			НеИспользоватьЭнтерпрайзРежим);
	Иначе
		ПроверитьСуществованиеКаталога(ПутьИсточника);
		СервисРасширений.ЗагрузитьРасширениеВБазуИзФайлов(
			ПараметрыПодключения,
			ПутьИсточника,
			ИмяРасширения,
			ОпцииIbcmd.ИспользоватьIbcmd,
			ПараметрыПлатформы,
			Инкремент,
			ПараметрыРасширения,
			НеИспользоватьЭнтерпрайзРежим,
			ОпцииИсходников.СформироватьПараметрыИсходников());
	КонецЕсли;

	Если ОпцииIbcmd.ИспользоватьIbcmd = Истина Тогда
		Если ЕстьСвойстваРасширения() Тогда
			УстановитьСвойстваРасширения(ПараметрыПодключения, ПараметрыПлатформы);
		КонецЕсли;
	// BSLLS:IfElseIfEndsWithElse-off
	ИначеЕсли ЕстьСвойстваТолькоIbcmd() Тогда
		Лог.Предупреждение("Свойства --active, --used-in-rib, --scope-infobase поддерживаются только в режиме ibcmd (--ibcmd). Свойства не применены.");
	КонецЕсли;
	// BSLLS:IfElseIfEndsWithElse-on

	Если ОбновитьБД = Истина Тогда
		НастройкиОбновления = ОпцииОбновленияБД.СформироватьНастройкиОбновления(ИмяРасширения);
		Лог.Информация("Обновление расширения '%1' БД (restr=%2)", ИмяРасширения, НастройкиОбновления.РежимРеструктуризации);
		СервисПлатформы.ОбновитьКонфигурациюБД(
			ПараметрыПодключения,
			ОпцииIbcmd.ИспользоватьIbcmd,
			ПараметрыПлатформы,
			НастройкиОбновления);
	КонецЕсли;

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Функция ИсточникИлиТекущийКаталог()

	Если ЗначениеЗаполнено(Источник) Тогда
		Возврат Источник;
	КонецЕсли;

	Возврат СервисОкружения.РабочийКаталог();

КонецФункции

Процедура ЕслиНеЗаполненоОпределитьИмяРасширения(Знач ПутьИсточника)

	Если ЗначениеЗаполнено(ИмяРасширения) Тогда
		Возврат;
	КонецЕсли;

	ФайлИсточника = Новый Файл(ПутьИсточника);
	Если ЭтоФайлCfe(ПутьИсточника) Тогда
		ИмяРасширения = ФайлИсточника.ИмяБезРасширения;
	Иначе
		ИмяРасширения = ФайлИсточника.Имя;
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьИмяРасширения(Знач Имя)

	Если НЕ ЗначениеЗаполнено(Имя) Тогда
		ВызватьИсключение "Имя расширения не задано и не удалось определить его из пути источника.";
	КонецЕсли;

	Шаблон = Новый РегулярноеВыражение("^[a-zA-Zа-яА-ЯёЁ][a-zA-Zа-яА-ЯёЁ0-9_]*$");
	Если НЕ Шаблон.Совпадает(Имя) Тогда
		ВызватьИсключение "Неверное имя! Имя должно состоять из одного слова, начинаться с буквы и не иметь спецсимволов кроме _";
	КонецЕсли;

КонецПроцедуры

Функция ЭтоФайлCfe(Знач Путь)

	Возврат СтрЗаканчиваетсяНа(НРег(Путь), ".cfe");

КонецФункции

Процедура ПроверитьСуществованиеФайла(Знач Путь)

	Файл = Новый Файл(Путь);
	Если НЕ Файл.Существует() Тогда
		ВызватьИсключение СтрШаблон("Файл расширения не найден: %1", Путь);
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьСуществованиеКаталога(Знач Путь)

	Файл = Новый Файл(Путь);
	Если НЕ Файл.Существует() Тогда
		ВызватьИсключение СтрШаблон("Каталог исходников расширения не найден: %1", Путь);
	КонецЕсли;

КонецПроцедуры

Функция ЕстьСвойстваРасширения()

	// &Флаговый по умолчанию даёт Ложь, поэтому для определения факта явной установки
	// проверяем только значения = Истина. Это означает: чтобы изменить свойство расширения
	// нужно явно передать соответствующий флаг.
	Возврат БезопасныйРежим = Истина
		ИЛИ Активность = Истина
		ИЛИ ЗащитаОтОпасныхДействий = Истина
		ИЛИ ИспользуетсяВРИБ = Истина
		ИЛИ ОбластьДействия_ИБ = Истина;

КонецФункции

Функция ЕстьСвойстваТолькоIbcmd()
	Возврат Активность = Истина ИЛИ ИспользуетсяВРИБ = Истина ИЛИ ОбластьДействия_ИБ = Истина;
КонецФункции

Процедура УстановитьСвойстваРасширения(ПараметрыПодключения, ПараметрыПлатформы)

	Свойства = Новый Структура;
	Свойства.Вставить("Активность",              ПреобразоватьБулевоеСвойство(Активность, Истина));
	Свойства.Вставить("БезопасныйРежим",        ПреобразоватьБулевоеСвойство(БезопасныйРежим, Ложь));
	Свойства.Вставить("ИмяПрофиляБезопасности", "");
	Свойства.Вставить("ЗащитаОтОпасныхДействий", ПреобразоватьБулевоеСвойство(ЗащитаОтОпасныхДействий, Ложь));
	Свойства.Вставить("ИспользуетсяВ_РИБ",      ПреобразоватьБулевоеСвойство(ИспользуетсяВРИБ, Ложь));
	Свойства.Вставить("ОбластьДействия_ИБ",     ПреобразоватьБулевоеСвойство(ОбластьДействия_ИБ, Истина));

	СервисРасширений.ИзменитьСвойстваРасширения(
		ПараметрыПодключения,
		ИмяРасширения,
		Свойства,
		ПараметрыПлатформы);

КонецПроцедуры

Функция ПреобразоватьБулевоеСвойство(Знач Значение, Знач ПоУмолчанию)

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		// &Флаговый: Ложь означает "флаг не передан" - применяем безопасный дефолт
		Если Значение = Ложь Тогда
			Возврат ПоУмолчанию;
		КонецЕсли;
		Возврат Значение;
	КонецЕсли;

	ЗначениеНРег = НРег(СокрЛП(Значение));
	Если ЗначениеНРег = "yes" ИЛИ ЗначениеНРег = "true" ИЛИ ЗначениеНРег = "1" Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

#КонецОбласти
