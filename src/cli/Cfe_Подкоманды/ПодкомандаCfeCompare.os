// BSLLS:MissingVariablesDescription-off Поля &Опция/&НаборОпций - описания заданы в самой аннотации.
&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисРасширений;

&Пластилин
Перем СервисЗаполненияПараметров;

&Опция(Имя = "extension-name", Описание = "Имя расширения для сравнения")
&ТСтрока
&Обязательный
Перем ИмяРасширения;

&Опция(Имя = "first-cfe", Описание = "Путь к первому файлу cfe. Если не указан - расширение из базы")
&ТСтрока
Перем ПервыйФайл;

&Опция(Имя = "second-cfe", Описание = "Путь ко второму файлу cfe для сравнения")
&ТСтрока
&Обязательный
Перем ВторойФайл;

&НаборОпций("НаборОпцийОтчетаСравнения")
Перем ОпцииОтчета;

&НаборОпций("НаборОпцийПодключения")
Перем ОпцииПодключения;

&НаборОпций("НаборОпцийПлатформы")
Перем ОпцииПлатформы;

&НаборОпций("НаборОпцийСУБД")
Перем ОпцииСУБД;

&НаборОпций("НаборОпцийНастроек")
Перем ОпцииНастроек; // BSLLS:UnusedLocalVariable-off

&ПодкомандаПриложения(Имя = "compare", Родитель = "КомандаCfe", Описание = "Сравнить расширения")
&ДоступноВMCP
&MCPДлительная
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);

	Лог.Отладка("Начало выполнения команды cfe compare");

	РежимСБазой = НЕ ЗначениеЗаполнено(ПервыйФайл);
	Если РежимСБазой И НЕ ЗначениеЗаполнено(ОпцииПодключения.СтрокаПодключения) Тогда
		ВызватьИсключение "При сравнении расширения из базы (без --first-cfe) необходима строка подключения"
			+ " (--ibconnection).";
	КонецЕсли;

	ПараметрыПлатформы = ОпцииПлатформы.СформироватьПараметрыПлатформы();
	ПараметрыПодключения = ОпцииПодключения.ПараметрыПодключения(ОпцииСУБД);
	ПараметрыОтчета = ОпцииОтчета.СформироватьПараметрыОтчета();

	ПутьОтчета = СервисРасширений.СравнитьРасширения(
		ПараметрыПодключения,
		ИмяРасширения,
		ВторойФайл,
		ПараметрыОтчета.КаталогОтчета,
		ПараметрыОтчета.ТипОтчета,
		ПараметрыОтчета.ФорматОтчета,
		ПервыйФайл,
		ПараметрыПлатформы);

	Лог.Информация("Отчёт о сравнении расширений сохранён: %1", ПутьОтчета);

КонецПроцедуры
