&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисРасширений;

&Пластилин
Перем СервисЗаполненияПараметров;

&НаборОпций("НаборОпцийПодключения")
Перем ОпцииПодключения;

&НаборОпций("НаборОпцийПлатформы")
Перем ОпцииПлатформы;

&Опция(Имя = "extension-name", Описание = "Имя расширения для сравнения")
&ТСтрока
&Обязательный
Перем ИмяРасширения;

&Опция(Имя = "first-cfe", Описание = "Путь к первому файлу cfe. Если не указан — расширение из базы")
&ТСтрока
Перем ПервыйФайл;

&Опция(Имя = "second-cfe", Описание = "Путь ко второму файлу cfe для сравнения")
&ТСтрока
&Обязательный
Перем ВторойФайл;

&Опция(Имя = "report-file", Описание = "Путь к файлу отчёта о сравнении")
&ТСтрока
&Обязательный
Перем ФайлОтчёта;

&Опция(Имя = "report-type", Описание = "Тип отчёта")
&ТПеречисление
&Перечисление(Имя = "Full", Описание = "Полный отчёт")
&Перечисление(Имя = "Brief", Описание = "Краткий отчёт")
&ПоУмолчанию("Full")
Перем ТипОтчёта;

&Опция(Имя = "report-format", Описание = "Формат файла отчёта")
&ТПеречисление
&Перечисление(Имя = "txt", Описание = "Текстовый файл")
&Перечисление(Имя = "mxl", Описание = "Табличный документ")
&ПоУмолчанию("txt")
Перем ФорматОтчёта;

&НаборОпций("НаборОпцийНастроек")
Перем ОпцииНастроек;

&ПодкомандаПриложения(Имя = "compare", Родитель = "КомандаCfe", Описание = "Сравнить расширения")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);

	Лог.Отладка("Начало выполнения команды cfe compare");

	ПараметрыПлатформы = Новый Структура(
		"ВерсияПлатформы, КодРазрешения, Язык, Локаль",
		ОпцииПлатформы.ВерсияПлатформы,
		ОпцииПлатформы.КодРазрешения,
		ОпцииПлатформы.Язык,
		ОпцииПлатформы.Локаль
	);

	РежимСБазой = НЕ ЗначениеЗаполнено(ПервыйФайл);

	Если РежимСБазой Тогда
		Если НЕ ЗначениеЗаполнено(ОпцииПодключения.СтрокаПодключения) Тогда
			ВызватьИсключение "При сравнении расширения из базы (без --first-cfe) необходима строка подключения (--ibconnection).";
		КонецЕсли;
	КонецЕсли;

	ПараметрыПодключения = Новый Структура(
		"СтрокаПодключения, Пользователь, Пароль",
		ОпцииПодключения.СтрокаПодключения,
		ОпцииПодключения.Пользователь,
		ОпцииПодключения.Пароль
	);

	ПутьОтчёта = СервисРасширений.СравнитьРасширения(
		ПараметрыПодключения,
		ИмяРасширения,
		ВторойФайл,
		ФайлОтчёта,
		ТипОтчёта,
		ФорматОтчёта,
		ПервыйФайл,
		ПараметрыПлатформы
	);

	Лог.Информация("Отчёт о сравнении расширений сохранён: %1", ПутьОтчёта);

КонецПроцедуры
