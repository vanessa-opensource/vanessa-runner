// BSLLS:LineLength-off
// BSLLS:NumberOfValuesInStructureConstructor-off
// BSLLS:MissingVariablesDescription-off Поля &Опция/&Аргумент/&НаборОпций - описания заданы в самой аннотации.
&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисРасширений;

&Пластилин
Перем СервисЗаполненияПараметров;

&Пластилин
Перем СервисОкружения;

&НаборОпций("НаборОпцийПодключения")
Перем ОпцииПодключения;

&НаборОпций("НаборОпцийIbcmd")
Перем ОпцииIbcmd;

&НаборОпций("НаборОпцийПлатформы")
Перем ОпцииПлатформы;

&НаборОпций("НаборОпцийСУБД")
Перем ОпцииСУБД;

&Аргумент(Имя = "OUT", Описание = "Путь к выходному файлу расширения (*.cfe)")
&ТСтрока
&ВОкружении("VRUNNER_CFE_OUT")
&Обязательный
Перем ПутьКФайлуCfe;

&Опция(Имя = "s src", Описание = "Каталог XML-исходников расширения (по умолчанию - текущий каталог)")
&ТСтрока
&ВОкружении("VRUNNER_SRC")
Перем КаталогИсходников;

&Опция(Имя = "extension-name",
		Описание = "Имя расширения. Если не задано - берётся из имени каталога исходников")
&ТСтрока
&ВОкружении("VRUNNER_EXTENSION_NAME")
Перем ИмяРасширения;

&НаборОпций("НаборОпцийИсходников")
Перем ОпцииИсходников;

&НаборОпций("НаборОпцийНастроек")
Перем ОпцииНастроек; // BSLLS:UnusedLocalVariable-off

&ПодкомандаПриложения(Имя = "compile", Родитель = "КомандаCfe", Описание = "Собрать расширение из XML-исходников в .cfe-файл")
&ДоступноВMCP
&MCPДлительная
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);

	КаталогSrc = КаталогИсходниковИлиТекущий();

	ЕслиНеЗаполненоОпределитьИмяРасширения(КаталогSrc);
	ПроверитьИмяРасширения(ИмяРасширения);

	Лог.Отладка("Начало выполнения команды cfe compile");
	Лог.Отладка("Каталог исходников: %1", КаталогSrc);
	Лог.Отладка("Путь к файлу cfe: %1", ПутьКФайлуCfe);
	Лог.Отладка("Имя расширения: %1", ИмяРасширения);
	Лог.Отладка("Использовать ibcmd: %1", Формат(ОпцииIbcmd.ИспользоватьIbcmd, "БЛ=Ложь; БИ=Истина"));

	ПроверитьСуществованиеКаталога(КаталогSrc);
	ПроверитьПутьКФайлуCfe(ПутьКФайлуCfe);

	ПараметрыПлатформы = Новый Структура(
		"ВерсияПлатформы, КодРазрешения, Язык, Локаль",
		ОпцииПлатформы.ВерсияПлатформы,
		ОпцииПлатформы.КодРазрешения,
		ОпцииПлатформы.Язык,
		ОпцииПлатформы.Локаль);

	ПараметрыПодключения = Неопределено;
	Если ЗначениеЗаполнено(ОпцииПодключения.СтрокаПодключения)
		ИЛИ ЗначениеЗаполнено(ОпцииСУБД.ТипСУБД) Тогда
		ПараметрыПодключения = Новый Структура(
			"СтрокаПодключения, Пользователь, Пароль",
			ОпцииПодключения.СтрокаПодключения,
			ОпцииПодключения.Пользователь,
			ОпцииПодключения.Пароль);
		ОпцииСУБД.ДополнитьПараметрыПодключения(ПараметрыПодключения);
	КонецЕсли;

	СервисРасширений.СобратьВФайлCfe(
		КаталогSrc,
		ПутьКФайлуCfe,
		ИмяРасширения,
		ОпцииIbcmd.ИспользоватьIbcmd,
		ПараметрыПлатформы,
		ПараметрыПодключения,
		ОпцииИсходников.СформироватьПараметрыИсходников());

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Функция КаталогИсходниковИлиТекущий()

	Если ЗначениеЗаполнено(КаталогИсходников) Тогда
		Возврат КаталогИсходников;
	КонецЕсли;

	Возврат СервисОкружения.РабочийКаталог();

КонецФункции

Процедура ЕслиНеЗаполненоОпределитьИмяРасширения(Знач ПутьКаталогаИсходников)

	Если ЗначениеЗаполнено(ИмяРасширения) Тогда
		Возврат;
	КонецЕсли;

	ИмяРасширения = Новый Файл(ПутьКаталогаИсходников).Имя;

КонецПроцедуры

Процедура ПроверитьИмяРасширения(Знач Имя)

	Если НЕ ЗначениеЗаполнено(Имя) Тогда
		ВызватьИсключение "Имя расширения не задано и не удалось определить его из каталога исходников.";
	КонецЕсли;

	Шаблон = Новый РегулярноеВыражение("^[a-zA-Zа-яА-ЯёЁ_][a-zA-Zа-яА-ЯёЁ0-9_]*$");
	Если НЕ Шаблон.Совпадает(Имя) Тогда
		ВызватьИсключение "Неверное имя! Имя должно состоять из одного слова, начинаться с буквы или подчёркивания и не иметь спецсимволов кроме _";
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьСуществованиеКаталога(Знач Путь)

	Файл = Новый Файл(Путь);
	Если НЕ Файл.Существует() Тогда
		ВызватьИсключение СтрШаблон("Каталог исходников не найден: %1", Путь);
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьПутьКФайлуCfe(Знач Путь)

	Если НЕ СтрЗаканчиваетсяНа(НРег(Путь), ".cfe") Тогда
		ВызватьИсключение СтрШаблон("Файл должен иметь расширение .cfe: %1", Путь);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
