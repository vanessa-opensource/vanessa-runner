// BSLLS:MissingVariablesDescription-off Поля &Опция/&Аргумент/&НаборОпций - описания заданы в самой аннотации.
&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисРасширений;

&Пластилин
Перем СервисЗаполненияПараметров;

&Пластилин
Перем ФайловыеОперации;

&НаборОпций("НаборОпцийПодключения")
Перем ОпцииПодключения;

&НаборОпций("НаборОпцийIbcmd")
Перем ОпцииIbcmd;

&НаборОпций("НаборОпцийПлатформы")
Перем ОпцииПлатформы;

&НаборОпций("НаборОпцийСУБД")
Перем ОпцииСУБД;

&Аргумент(Имя = "OUT",
	Описание = "Путь к выходному файлу расширения (*.cfe). Обязателен: задаётся в командной строке или в файле настроек")
&ТСтрока
&Обязательный(Ложь)
Перем ПутьКФайлуCfe;

&Опция(Имя = "extension-name", Описание = "Имя расширения в базе")
&ТСтрока
&ВОкружении("VRUNNER_EXTENSION_NAME")
&Обязательный
Перем ИмяРасширения;

&НаборОпций("НаборОпцийНастроек")
Перем ОпцииНастроек; // BSLLS:UnusedLocalVariable-off

&ПодкомандаПриложения(Имя = "unload", Родитель = "КомандаCfe", Описание = "Выгрузить расширение из базы в .cfe-файл")
&ДоступноВMCP
&MCPДлительная
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);
	СервисЗаполненияПараметров.ПроверитьЗаполнениеАргумента(ЭтотОбъект, "OUT");

	Лог.Отладка("Начало выполнения команды cfe unload");
	Лог.Отладка("Путь к файлу cfe: %1", ПутьКФайлуCfe);
	Лог.Отладка("Имя расширения: %1", ИмяРасширения);

	ФайловыеОперации.ПроверитьРасширениеФайла(ПутьКФайлуCfe, ".cfe");

	ПараметрыПлатформы = ОпцииПлатформы.СформироватьПараметрыПлатформы();

	ПараметрыПодключения = ОпцииПодключения.СформироватьПараметрыПодключения(ОпцииСУБД);

	СервисРасширений.ВыгрузитьРасширениеВФайл(
		ПараметрыПодключения,
		ПутьКФайлуCfe,
		ИмяРасширения,
		ОпцииIbcmd.ИспользоватьIbcmd,
		ПараметрыПлатформы);

КонецПроцедуры
