// BSLLS:LineLength-off Длинные описания &Опция нужны для понятной справки.
// BSLLS:NumberOfValuesInStructureConstructor-off
// BSLLS:MissingVariablesDescription-off Поля &Опция/&Аргумент/&НаборОпций - описания заданы в самой аннотации.
// BSLLS:UnusedLocalVariable-off Поля &Опция/&Лог инициализируются autumn-фреймворком через рефлексию.
// BSLLS:LatinAndCyrillicSymbolInWord-off Технические идентификаторы EDT/XML (ОпцииEDT).
// Команда `cfe convert` - конвертация каталога исходников расширения между форматами 1С:EDT и XML-дампа Конфигуратора.
// Тип исходников определяется автоматически (по маркерам каталога), результат пишется в противоположном
// формате. Если тип определить не удалось - команда завершается с ошибкой.
&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисEDT;

&Пластилин
Перем СервисЗаполненияПараметров;

&Опция(Имя = "s src", Описание = "Каталог исходников для конвертации (по умолчанию - текущий каталог)")
&ТСтрока
&ВОкружении("VRUNNER_SRC")
Перем КаталогИсходников;

&Аргумент(Имя = "OUT", Описание = "Каталог для результата конвертации")
&ТСтрока
&Обязательный
Перем КаталогНазначения;

&НаборОпций("НаборОпцийEDT")
Перем ОпцииEDT;

&НаборОпций("НаборОпцийНастроек")
Перем ОпцииНастроек; // BSLLS:UnusedLocalVariable-off

&ПодкомандаПриложения(Имя = "convert", Родитель = "КомандаCfe", Описание = "Конвертировать исходники расширения между форматами EDT и XML")
&ДоступноВMCP
&MCPДлительная
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);

	КаталогSrc = КаталогИсходниковИлиТекущий();
	Лог.Отладка("Начало выполнения команды cfe convert");
	Лог.Отладка("Каталог исходников: %1", КаталогSrc);
	Лог.Отладка("Каталог назначения: %1", КаталогНазначения);

	ПараметрыИсходников = ОпцииEDT.СформироватьПараметры();

	ДатаНачала = ТекущаяУниверсальнаяДата();
	Результат = СервисEDT.Конвертировать(КаталогSrc, КаталогНазначения, ПараметрыИсходников);
	ДлительностьСек = ТекущаяУниверсальнаяДата() - ДатаНачала;

	Лог.Информация("Конвертация %1 (%2) → %3 (%4) завершена за %5с",
		КаталогSrc, Результат.ИсходныйФормат,
		КаталогНазначения, Результат.ЦелевойФормат,
		Окр(ДлительностьСек));

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Функция КаталогИсходниковИлиТекущий()
	Если ЗначениеЗаполнено(КаталогИсходников) Тогда
		Возврат КаталогИсходников;
	КонецЕсли;
	Возврат ТекущийКаталог();
КонецФункции

#КонецОбласти
