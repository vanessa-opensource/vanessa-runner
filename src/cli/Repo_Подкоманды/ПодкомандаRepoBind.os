// BSLLS:MissingVariablesDescription-off Поля &Опция/&Аргумент/&НаборОпций - описания заданы в самой аннотации.
&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисХранилища;

&Пластилин
Перем СервисЗаполненияПараметров;

&НаборОпций("НаборОпцийПодключения")
Перем ОпцииПодключения;

&НаборОпций("НаборОпцийПлатформы")
Перем ОпцииПлатформы;

&НаборОпций("НаборОпцийСУБД")
Перем ОпцииСУБД;

&НаборОпций("НаборОпцийХранилища")
Перем ОпцииХранилища;

&Опция(Имя = "ignore-already-bound", Описание = "Игнорировать наличие подключенного пользователя")
&Флаговый
Перем ИгнорироватьНаличиеПодключеннойБД;

&Опция(Имя = "do-not-replace-cfg", Описание = "Не заменять конфигурацию БД конфигурацией хранилища")
&Флаговый
Перем НеЗаменятьКонфигурациюБД;

&НаборОпций("НаборОпцийНастроек")
Перем ОпцииНастроек; // BSLLS:UnusedLocalVariable-off

&ПодкомандаПриложения(Имя = "bind", Родитель = "КомандаRepo", Описание = "Подключиться к хранилищу конфигурации")
&ДоступноВMCP
&MCPРазрушающая
&MCPВнешнийМир
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);

	Лог.Отладка("Начало выполнения команды repo bind");

	ПараметрыПлатформы = ОпцииПлатформы.СформироватьПараметрыПлатформы();

	ПараметрыПодключения = ОпцииПодключения.ПараметрыПодключения(ОпцииСУБД);

	ПараметрыХранилища = ОпцииХранилища.СформироватьПараметрыХранилища();

	ИгнорироватьПодключенного = (ИгнорироватьНаличиеПодключеннойБД = Истина);
	ЗаменитьКонфигурациюБД = НЕ (НеЗаменятьКонфигурациюБД = Истина);

	СервисХранилища.ПодключитьсяКХранилищу(
		ПараметрыПодключения,
		ПараметрыХранилища,
		ИгнорироватьПодключенного,
		ЗаменитьКонфигурациюБД,
		ПараметрыПлатформы);

КонецПроцедуры
