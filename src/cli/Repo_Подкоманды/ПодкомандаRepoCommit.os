// BSLLS:MissingVariablesDescription-off Поля &Опция/&Аргумент/&НаборОпций - описания заданы в самой аннотации.
&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисХранилища;

&Пластилин
Перем СервисЗаполненияПараметров;

&НаборОпций("НаборОпцийПодключения")
Перем ОпцииПодключения;

&НаборОпций("НаборОпцийПлатформы")
Перем ОпцииПлатформы;

&НаборОпций("НаборОпцийСУБД")
Перем ОпцииСУБД;

&НаборОпций("НаборОпцийХранилища")
Перем ОпцииХранилища;

&Опция(Имя = "objects", Описание = "Путь к файлу XML со списком объектов")
&ТСтрока
Перем ПутьКФайлуОбъектов;

&Опция(Имя = "comment", Описание = "Комментарий к помещаемым объектам")
&ТСтрока
Перем Комментарий;

&Опция(Имя = "keep-locked", Описание = "Оставить объекты захваченными после помещения")
&Флаговый
Перем ОставитьЗахваченными;

&Опция(Имя = "force", Описание = "Игнорировать удаленные объекты")
&Флаговый
Перем ИгнорироватьУдаленные;

&НаборОпций("НаборОпцийНастроек")
Перем ОпцииНастроек; // BSLLS:UnusedLocalVariable-off

&ПодкомандаПриложения(Имя = "commit", Родитель = "КомандаRepo", Описание = "Поместить изменения в хранилище")
&ДоступноВMCP
&MCPДлительная
&MCPРазрушающая
&MCPВнешнийМир
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);

	Лог.Отладка("Начало выполнения команды repo commit");

	ПараметрыПлатформы = ОпцииПлатформы.СформироватьПараметрыПлатформы();

	ПараметрыПодключения = ОпцииПодключения.ПараметрыПодключения(ОпцииСУБД);

	ПараметрыХранилища = ОпцииХранилища.СформироватьПараметрыХранилища();

	ОставлятьЗахваченными = (ОставитьЗахваченными = Истина);
	ИгнорироватьУдаленныеОбъекты = (ИгнорироватьУдаленные = Истина);

	СервисХранилища.ПоместитьИзмененияВХранилище(
		ПараметрыПодключения,
		ПараметрыХранилища,
		ПутьКФайлуОбъектов,
		Комментарий,
		ОставлятьЗахваченными,
		ИгнорироватьУдаленныеОбъекты,
		ПараметрыПлатформы);

КонецПроцедуры
