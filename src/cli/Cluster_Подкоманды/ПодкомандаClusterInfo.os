// BSLLS:MissingVariablesDescription-off Поля &Опция/&Аргумент/&НаборОпций - описания заданы в самой аннотации.
&Пластилин
Перем СервисКластера;

&Пластилин
Перем СервисЗаполненияПараметров;

&НаборОпций("НаборОпцийКластера")
Перем ОпцииКластера;

&НаборОпций("НаборОпцийАдминистрирования")
Перем ОпцииАдминистрирования;

&НаборОпций("НаборОпцийПлатформы")
Перем ОпцииПлатформы;

&НаборОпций("НаборОпцийАутентификацииИБ")
Перем ОпцииАутентификации;

&НаборОпций("НаборОпцийНастроек")
Перем ОпцииНастроек; // BSLLS:UnusedLocalVariable-off

&ПодкомандаПриложения(Имя = "info", Родитель = "КомандаCluster", Описание = "Получить информацию о базе данных в кластере")
&ДоступноВMCP
&MCPТолькоЧтение
&MCPВнешнийМир
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);

	ПараметрыКластера = ОпцииКластера.СформироватьПараметрыКластера(
		ОпцииАдминистрирования, ОпцииПлатформы, ОпцииАутентификации);

	ИБ = СервисКластера.ИнформацияОбИБ(ПараметрыКластера, ОпцииКластера.ИмяИБ);

	Ключи = СтрРазделить("name,infobase,dbms,db-server,db-name,sessions-deny,scheduled-jobs-deny,license-distribution", ",");
	ШиринаКолонки = 0;
	Для Каждого Ключ Из Ключи Цикл
		ШиринаКолонки = Макс(ШиринаКолонки, СтрДлина(Ключ) + 1);
	КонецЦикла;
	Для Каждого Ключ Из Ключи Цикл
		Сообщить(ДополнитьПробелами(Ключ, ШиринаКолонки) + ": " + ИБ.Получить(Ключ));
	КонецЦикла;

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Функция ДополнитьПробелами(Знач Текст, Знач Длина)

	Пока СтрДлина(Текст) < Длина Цикл
		Текст = Текст + " ";
	КонецЦикла;

	Возврат Текст;

КонецФункции

#КонецОбласти
