// BSLLS:MissingVariablesDescription-off Поля &Опция/&Аргумент/&НаборОпций - описания заданы в самой аннотации.
&Пластилин
Перем СервисКластера;

&Пластилин
Перем СервисЗаполненияПараметров;

&НаборОпций("НаборОпцийКластера")
Перем ОпцииКластера;

&НаборОпций("НаборОпцийАдминистрирования")
Перем ОпцииАдминистрирования;

&НаборОпций("НаборОпцийПлатформы")
Перем ОпцииПлатформы;

&НаборОпций("НаборОпцийАутентификацииИБ")
Перем ОпцииАутентификации;

&Опция(Имя = "denied-message", Описание = "Сообщение при попытке начать сеанс")
&ТСтрока
Перем СообщениеБлокировки;

&НаборОпций("НаборОпцийНастроек")
Перем ОпцииНастроек; // BSLLS:UnusedLocalVariable-off

&ПодкомандаПриложения(Имя = "lock", Родитель = "ПодкомандаClusterSession", Описание = "Заблокировать новые сеансы")
&ДоступноВMCP
&MCPРазрушающая
&MCPВнешнийМир
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);

	ПараметрыКластера = ОпцииКластера.СформироватьПараметрыКластера(
		ОпцииАдминистрирования, ОпцииПлатформы, ОпцииАутентификации);

	ПараметрыБлокировки = Новый Структура;
	Если ЗначениеЗаполнено(ОпцииПлатформы.КодРазрешения) Тогда
		ПараметрыБлокировки.Вставить("КодРазрешения", ОпцииПлатформы.КодРазрешения);
	КонецЕсли;
	Если ЗначениеЗаполнено(СообщениеБлокировки) Тогда
		ПараметрыБлокировки.Вставить("СообщениеБлокировки", СообщениеБлокировки);
	КонецЕсли;

	СервисКластера.ЗаблокироватьСеансы(ПараметрыКластера, ОпцииКластера.ИмяИБ, ПараметрыБлокировки);

КонецПроцедуры
