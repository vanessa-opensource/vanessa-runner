// BSLLS:LineLength-off
// BSLLS:MissingVariablesDescription-off Поля &Опция/&Аргумент/&НаборОпций - описания заданы в самой аннотации.
// BSLLS:UnusedLocalMethod-off ПриСозданииОбъекта инициализируется autumn-фреймворком.
// BSLLS:NestedFunctionInParameters-off Идиоматичное форматирование вывода (Сообщить(СтрШаблон(...))).
// BSLLS:MissingParameterDescription-off Внутренние служебные методы команды.
&Пластилин
Перем СервисКластера;

&Пластилин
Перем СервисЗаполненияПараметров;

&НаборОпций("НаборОпцийКластера")
Перем ОпцииКластера;

&НаборОпций("НаборОпцийАдминистрирования")
Перем ОпцииАдминистрирования;

&НаборОпций("НаборОпцийПлатформы")
Перем ОпцииПлатформы;

&НаборОпций("НаборОпцийАутентификацииИБ")
Перем ОпцииАутентификации;

&Опция(Имя = "connections", Описание = "Дополнительно вывести соединения ИБ в привязке к сеансам")
&Флаговый
Перем ВыводитьСоединения;

&НаборОпций("НаборОпцийОтбораСеансов")
Перем ОпцииОтбора;

&НаборОпций("НаборОпцийНастроек")
Перем ОпцииНастроек; // BSLLS:UnusedLocalVariable-off

&ПодкомандаПриложения(Имя = "list", Родитель = "ПодкомандаClusterSession", Описание = "Вывести список сеансов информационной базы")
&ДоступноВMCP
&MCPТолькоЧтение
&MCPВнешнийМир
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);

	ПараметрыКластера = ОпцииКластера.СформироватьПараметрыКластера(
		ОпцииАдминистрирования, ОпцииПлатформы, ОпцииАутентификации);

	Сеансы = СервисКластера.СписокСеансов(ПараметрыКластера, ОпцииКластера.ИмяИБ, ОпцииОтбора.Отбор());

	ВывестиСеансы(Сеансы);

	Если ВыводитьСоединения = Истина Тогда
		ВывестиСоединения(СервисКластера.СписокСоединений(ПараметрыКластера, ОпцииКластера.ИмяИБ));
	КонецЕсли;

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Процедура ВывестиСеансы(Знач Сеансы)

	Если Сеансы.Количество() = 0 Тогда
		Сообщить(СтрШаблон("Сеансы ИБ %1: нет активных сеансов", ОпцииКластера.ИмяИБ));
		Возврат;
	КонецЕсли;

	Сообщить(СтрШаблон("Сеансы ИБ %1: %2", ОпцииКластера.ИмяИБ, Сеансы.Количество()));
	ВывестиТаблицу(Сеансы, "session-id,app-id,user-name,host,started-at,last-active-at");

КонецПроцедуры

Процедура ВывестиСоединения(Знач Соединения)

	Сообщить("");

	Если Соединения.Количество() = 0 Тогда
		Сообщить(СтрШаблон("Соединения ИБ %1: нет активных соединений", ОпцииКластера.ИмяИБ));
		Возврат;
	КонецЕсли;

	Сообщить(СтрШаблон("Соединения ИБ %1: %2", ОпцииКластера.ИмяИБ, Соединения.Количество()));
	ВывестиТаблицу(Соединения, "conn-id,application,host,session-number,connected-at");

КонецПроцедуры

// Заголовок из имён колонок и по строке на элемент: значения колонок через " | ".
Процедура ВывестиТаблицу(Знач Строки, Знач ИменаКолонок)

	Колонки = СтрРазделить(ИменаКолонок, ",");
	Сообщить(СтрСоединить(Колонки, " | "));

	Для Каждого Элемент Из Строки Цикл
		Значения = Новый Массив;
		Для Каждого Колонка Из Колонки Цикл
			Значения.Добавить(Строка(Элемент.Получить(Колонка)));
		КонецЦикла;
		Сообщить(СтрСоединить(Значения, " | "));
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
