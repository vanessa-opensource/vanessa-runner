// BSLLS:LineLength-off
// BSLLS:NumberOfValuesInStructureConstructor-off
// BSLLS:MissingVariablesDescription-off Поля &Опция/&Аргумент/&НаборОпций - описания заданы в самой аннотации.
// BSLLS:UnusedLocalVariable-off Поля &Опция/&Лог инициализируются autumn-фреймворком через рефлексию.
// BSLLS:UnusedLocalMethod-off ПриСозданииОбъекта инициализируется autumn-фреймворком.
&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисКластера;

&Пластилин
Перем СервисЗаполненияПараметров;

&НаборОпций("НаборОпцийКластера")
Перем ОпцииКластера;

&НаборОпций("НаборОпцийАдминистрирования")
Перем ОпцииАдминистрирования;

&НаборОпций("НаборОпцийПлатформы")
Перем ОпцииПлатформы;

&НаборОпций("НаборОпцийАутентификацииИБ")
Перем ОпцииАутентификации;

&Опция(Имя = "timeout", Описание = "Время ожидания завершения сеансов, сек: проверка повторяется каждые 3 секунды до отсутствия сеансов или таймаута. По умолчанию 0 - одна проверка без ожидания")
&ТЧисло
Перем ТаймаутСек;

&НаборОпций("НаборОпцийОтбораСеансов")
Перем ОпцииОтбора;

&НаборОпций("НаборОпцийНастроек")
Перем ОпцииНастроек; // BSLLS:UnusedLocalVariable-off

&ПодкомандаПриложения(Имя = "closed", Родитель = "ПодкомандаClusterSession", Описание = "Проверить отсутствие сеансов или дождаться их завершения (код возврата 1, если сеансы остались)")
&ДоступноВMCP
&MCPТолькоЧтение
&MCPВнешнийМир
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);

	ПараметрыКластера = Новый Структура(
		"ВерсияПлатформы, АдресRAS, АдминистраторКластера, ПарольКластера, ИдентификаторКластера, ИмяКластера, Пользователь, Пароль",
		ОпцииПлатформы.ВерсияПлатформы,
		ОпцииКластера.АдресRAS,
		ОпцииАдминистрирования.АдминистраторКластера,
		ОпцииАдминистрирования.ПарольКластера,
		ОпцииКластера.ИдентификаторКластера,
		ОпцииКластера.ИмяКластера,
		ОпцииАутентификации.Пользователь,
		ОпцииАутентификации.Пароль);

	Таймаут = ?(ЗначениеЗаполнено(ТаймаутСек), ТаймаутСек, 0);

	Сеансы = СервисКластера.ДождатьсяОтсутствияСеансов(
		ПараметрыКластера, ОпцииКластера.ИмяИБ, ОпцииОтбора.Отбор(), Таймаут);

	Если Сеансы.Количество() = 0 Тогда
		Лог.Информация("Сеансы отсутствуют: %1", ОпцииКластера.ИмяИБ);
		Возврат;
	КонецЕсли;

	Для Каждого Сеанс Из Сеансы Цикл
		Лог.Информация("Найден сеанс: %1 [%2] %3",
			Сеанс.Получить("session-id"), Сеанс.Получить("app-id"), Сеанс.Получить("user-name"));
	КонецЦикла;

	ВызватьИсключение СтрШаблон("Найдены активные сеансы ИБ %1: %2", ОпцииКластера.ИмяИБ, Сеансы.Количество());

КонецПроцедуры
