// BSLLS:LineLength-off
// BSLLS:MissingVariablesDescription-off Поля &Опция/&Аргумент/&НаборОпций - описания заданы в самой аннотации.
// BSLLS:UnusedLocalVariable-off Поля &Опция/&Лог инициализируются autumn-фреймворком через рефлексию.
// BSLLS:UnusedLocalMethod-off ПриСозданииОбъекта инициализируется autumn-фреймворком.
&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисКластера;

&Пластилин
Перем СервисЗаполненияПараметров;

&НаборОпций("НаборОпцийКластера")
Перем ОпцииКластера;

&НаборОпций("НаборОпцийАдминистрирования")
Перем ОпцииАдминистрирования;

&НаборОпций("НаборОпцийПлатформы")
Перем ОпцииПлатформы;

&НаборОпций("НаборОпцийАутентификацииИБ")
Перем ОпцииАутентификации;

&Опция(Имя = "no-lock", Описание = "Не блокировать новые сеансы перед завершением")
&Флаговый
Перем НеБлокировать;

&Опция(Имя = "retry", Описание = "Количество попыток завершения зависших сеансов (по умолчанию 3; не используется при заданном --timeout)")
&ТЧисло
Перем КоличествоПопыток;

&Опция(Имя = "timeout", Описание = "Максимальное время завершения сеансов, сек: попытки повторяются до успеха или таймаута (--retry игнорируется)")
&ТЧисло
Перем ТаймаутСек;

&НаборОпций("НаборОпцийОтбораСеансов")
Перем ОпцииОтбора;

&НаборОпций("НаборОпцийНастроек")
Перем ОпцииНастроек; // BSLLS:UnusedLocalVariable-off

&ПодкомандаПриложения(Имя = "kill", Родитель = "ПодкомандаClusterSession", Описание = "Завершить текущие сеансы")
&ДоступноВMCP
&MCPРазрушающая
&MCPВнешнийМир
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);

	ПараметрыКластера = ОпцииКластера.СформироватьПараметрыКластера(
		ОпцииАдминистрирования, ОпцииПлатформы, ОпцииАутентификации);

	БлокироватьНовые = НЕ (НеБлокировать = Истина);

	СервисКластера.ЗавершитьСеансы(ПараметрыКластера, ОпцииКластера.ИмяИБ, БлокироватьНовые,
		ОпцииОтбора.Отбор(), ПараметрыПовтора());

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Функция ПараметрыПовтора()

	Повтор = Новый Структура;

	Если ЗначениеЗаполнено(ТаймаутСек) И ЗначениеЗаполнено(КоличествоПопыток) Тогда
		Лог.Предупреждение("Задан --timeout: значение --retry игнорируется");
	КонецЕсли;

	// BSLLS:IfElseIfEndsWithElse-off
	Если ЗначениеЗаполнено(ТаймаутСек) Тогда
		Повтор.Вставить("ТаймаутСек", ТаймаутСек);
	ИначеЕсли ЗначениеЗаполнено(КоличествоПопыток) Тогда
		Повтор.Вставить("Попыток", КоличествоПопыток);
	КонецЕсли;
	// BSLLS:IfElseIfEndsWithElse-on

	Возврат Повтор;

КонецФункции

#КонецОбласти
