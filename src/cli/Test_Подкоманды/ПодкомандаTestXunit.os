// BSLLS:NumberOfValuesInStructureConstructor-off
// BSLLS:MissingVariablesDescription-off Поля &Опция/&Аргумент/&НаборОпций - описания заданы в самой аннотации.
&Лог("vrunner")
Перем Лог;

&Пластилин
Перем ФайловыеОперации;

&Пластилин
Перем СервисПлатформы;

&Пластилин
Перем СервисЗаполненияПараметров;

&Пластилин
Перем СервисОкружения;

&Пластилин
Перем СервисПокрытия;

&Пластилин
Перем СервисVanessaADD;

&НаборОпций("НаборОпцийПодключения")
Перем ОпцииПодключения;

&НаборОпций("НаборОпцийПлатформы")
Перем ОпцииПлатформы;

&НаборОпций("НаборОпцийЗапуска")
Перем ОпцииЗапуска;

&НаборОпций("НаборОпцийПокрытия")
Перем ОпцииПокрытия;

&Аргумент(Имя = "TESTSPATH",
    Описание = "Путь к тестам: каталог/файл, встроенные (--config-tests) или макрос $addRoot")
&ТСтрока
&ВОкружении("VRUNNER_TESTSPATH")
Перем ПутьКТестам;

&Опция(Имя = "workspace", Описание = "Путь к папке проекта (для макросов $workspace, по умолчанию - текущий)")
&ТСтрока
&ВОкружении("VRUNNER_WORKSPACE")
Перем РабочийКаталогПроекта;

&Опция(Имя = "pathxunit", Описание = "Путь к внешней обработке xddTestRunner.epf (по умолчанию из vanessa-add)")
&ТСтрока
&ВОкружении("VRUNNER_PATHXUNIT")
Перем ПутьКИнструментам;

&НаборОпций("НаборОпцийОтчетов")
Перем ОпцииОтчетов;

&Опция(Имя = "reportsxunit",
	Описание = "Формат{Путь};Формат{Путь} (устарела: --report-format <формат> --report-path <путь>)")
&ТСтрока
&ВОкружении("VRUNNER_REPORTSXUNIT")
Перем ПараметрыОтчетов;

&Опция(Имя = "reportxunit", Описание = "Путь к каталогу с отчетом jUnit (устарел, используйте --report-path)")
&ТСтрока
Перем ВыходнойКаталогОтчета;

&Опция(Имя = "xddExitCodePath", Описание = "Путь к файлу статуса тестирования (0=пройдены, 1=не пройдены)")
&ТСтрока
Перем ПутьФайлаСтатуса;

&Опция(Имя = "xddConfig", Описание = "Путь к конфигурационному файлу xUnitFor1c")
&ТСтрока
Перем ПутьККонфигу; // BSLLS:Typo-off

&Опция(Имя = "testclient", Описание = "Параметры тест-клиента: Пользователь:Пароль:Порт")
&ТСтрока
Перем ОпцияТестКлиент;

&Опция(Имя = "testclient-additional", Описание = "Дополнительные параметры запуска тест-клиента")
&ТСтрока
Перем ДопПараметрыТестКлиента;

&Опция(Имя = "config-tests", Описание = "Загружать тесты, встроенные в конфигурацию")
&Флаговый
&ВОкружении("VRUNNER_CONFIG_TESTS")
Перем ЗагружатьВстроенныеТесты;

&Опция(Имя = "no-wait", Описание = "Не ожидать завершения запущенной команды/действия")
&Флаговый
Перем НеОжидать;

&Опция(Имя = "xdddebug", Описание = "Выводить отладочные сообщения при прогоне тестов")
&Флаговый
Перем ВключенаОтладка;

&Опция(Имя = "no-shutdown", Описание = "Не завершать 1С:Предприятие после выполнения тестов")
&Флаговый
Перем НеЗавершать;

&Опция(Имя = "clear-reports", Описание = "Очищать каталоги отчетов перед запуском тестов")
&Флаговый
Перем ОчищатьОтчеты;

&НаборОпций("НаборОпцийНастроек")
Перем ОпцииНастроек; // BSLLS:UnusedLocalVariable-off

&ПодкомандаПриложения(Имя = "xunit", Родитель = "КомандаTest", Описание = "Запустить тестирование xUnit")
&ДоступноВMCP
&MCPДлительная
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);

	ПутьКТестам = СервисVanessaADD.ПодставитьМакросAddRoot(ПутьКТестам, "тестам");

	Лог.Информация("Выполняю тесты с помощью фреймворка Vanessa-ADD (xUnit) - %1", ПутьКТестам);

	ПараметрыПлатформы = Новый Структура(
		"ВерсияПлатформы, КодРазрешения, Язык, Локаль",
		ОпцииПлатформы.ВерсияПлатформы,
		ОпцииПлатформы.КодРазрешения,
		ОпцииПлатформы.Язык,
		ОпцииПлатформы.Локаль);

	ПараметрыПодключения = Новый Структура(
		"СтрокаПодключения, Пользователь, Пароль",
		ОпцииПодключения.СтрокаПодключения,
		ОпцииПодключения.Пользователь,
		ОпцииПодключения.Пароль);

	ОтчетыXUnit = ПолучитьПараметрыОтчетов();
	ПутьКОбработке = СервисVanessaADD.ПутьКОбработке("xddTestRunner.epf", ПутьКИнструментам, "--pathxunit");
	ОбеспечитьКаталогиОтчетов(ОтчетыXUnit);

	КлючЗапуска = СформироватьКлючЗапуска(ОтчетыXUnit);

	ПараметрыЗапуска = Новый Структура;
	ПараметрыЗапуска.Вставить("КомандаЗапуска", КлючЗапуска);
	ПараметрыЗапуска.Вставить("ПутьОбработки", ПутьКОбработке);
	ПараметрыЗапуска.Вставить("НавигационнаяСсылка", "");
	ПараметрыЗапуска.Вставить("НеОжидать", НеОжидать);
	ПараметрыЗапуска.Вставить("РежимЗапуска", ОпцииЗапуска.РежимЗапуска);
	ПараметрыЗапуска.Вставить("ДополнительныеПараметры", ДополнительныеПараметрыЗапуска());
	ПараметрыЗапуска.Вставить("ПутьКФайлуСтатуса", ПолныйПуть(ПутьФайлаСтатуса));
	ПараметрыЗапуска.Вставить("ИспользоватьIbsrv", ОпцииЗапуска.ИспользоватьIbsrv);
	ПараметрыЗапуска.Вставить("ИспользоватьПрямоеСоединениеIbsrv", ОпцииЗапуска.ИспользоватьПрямоеСоединениеIbsrv);
	ПараметрыЗапуска.Вставить("ИспользоватьОтладкуIbsrv", ОпцииЗапуска.ИспользоватьОтладкуIbsrv);
	ПараметрыЗапуска.Вставить("ПодключитьсяКСуществующемуIbsrv", ОпцииЗапуска.ПодключитьсяКСуществующемуIbsrv);
	ПараметрыЗапуска.Вставить("ПортIbsrv", ОпцииЗапуска.ПортIbsrv);

	КонтекстПокрытия = НачатьПокрытиеПриНеобходимости(ПараметрыЗапуска, ПараметрыПодключения, ПараметрыПлатформы);

	Попытка
		СервисПлатформы.ЗапуститьПредприятие(ПараметрыПодключения, ПараметрыЗапуска, ПараметрыПлатформы);
	Исключение
		СервисПокрытия.ПрерватьСеанс(КонтекстПокрытия);
		ВызватьИсключение;
	КонецПопытки;

	СервисПокрытия.ЗавершитьСеанс(КонтекстПокрытия);

	Лог.Информация("Выполнение тестов завершено");

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Функция СформироватьКлючЗапуска(Знач ОтчетыXUnit)

	ПутьТестов = ПутьКТестам;
	Каталог = РабочийКаталог();

	Если ЗагружатьВстроенныеТесты <> Истина Тогда
		ПутьТестов = ПолныйПуть(ПутьТестов);
	КонецЕсли;

	Если ЗагружатьВстроенныеТесты = Истина Тогда
		ПутьТестов = СтрЗаменить(ПутьТестов, Каталог, "");
	КонецЕсли;

	Части = Новый Массив;
	Части.Добавить(КлючЗапускаЗагрузчика(ПутьТестов));

	// Тест-клиент
	Если ЗначениеЗаполнено(ОпцияТестКлиент) Тогда
		Подключение = ОпцияТестКлиент;
		// BSLLS:IfElseIfEndsWithElse-off
		Если Подключение = "::" Тогда
			Подключение = СтрШаблон("%1:%2", ОпцииПодключения.Пользователь, ОпцииПодключения.Пароль);
		ИначеЕсли СтрНачинаетсяС(Подключение, "::") Тогда
			Подключение = СтрШаблон("%1:%2:%3", ОпцииПодключения.Пользователь, ОпцииПодключения.Пароль,
				Сред(Подключение, СтрДлина("::") + 1));
		КонецЕсли;
		// BSLLS:IfElseIfEndsWithElse-on
		Части.Добавить(СтрШаблон("xddTestClient """"%1"""";", Подключение));
	КонецЕсли;

	Если ЗначениеЗаполнено(ДопПараметрыТестКлиента) Тогда
		Части.Добавить(СтрШаблон("xddTestClientAdditional """"%1"""";", ДопПараметрыТестКлиента));
	КонецЕсли;

	// Отчеты
	Для Каждого ПараметрыОтчета Из ОтчетыXUnit Цикл
		Части.Добавить(СтрШаблон("xddReport %1 """"%2"""";", ПараметрыОтчета.Генератор, ПараметрыОтчета.Путь));
	КонецЦикла;

	// Конфиг xUnit
	Если ЗначениеЗаполнено(ПутьККонфигу) Тогда
		Части.Добавить(СтрШаблон("xddConfig """"%1"""";", ПолныйПуть(ПутьККонфигу)));
	КонецЕсли;

	// Файл статуса
	Если ЗначениеЗаполнено(ПутьФайлаСтатуса) Тогда
		Части.Добавить(СтрШаблон("xddExitCodePath ГенерацияКодаВозврата """"%1"""";", ПолныйПуть(ПутьФайлаСтатуса)));
	КонецЕсли;

	// Отладка
	Если ВключенаОтладка = Истина Тогда
		Части.Добавить("debug;");
	КонецЕсли;

	// Рабочий каталог проекта
	Части.Добавить(СтрШаблон("workspaceRoot """"%1"""";", Каталог));

	// Завершение 1С
	Если НЕ НеЗавершать = Истина Тогда
		Части.Добавить("xddShutdown");
	КонецЕсли;

	Возврат СтрСоединить(Части, " ");

КонецФункции

Функция КлючЗапускаЗагрузчика(Знач ПутьВходящихДанных)

	Если НЕ ЗагружатьВстроенныеТесты = Истина Тогда

		ФайлТеста = Новый Файл(ПутьВходящихДанных);
		Если ФайлТеста.Существует() И ФайлТеста.ЭтоКаталог() Тогда
			ИмяЗагрузчика = "ЗагрузчикКаталога";
		Иначе
			ИмяЗагрузчика = "ЗагрузчикФайла";
		КонецЕсли;

	Иначе

		Если СтрНайти(ПутьВходящихДанных, ".") = 0 Тогда
			ИмяЗагрузчика = "ЗагрузчикРасширения";
		Иначе
			ИмяЗагрузчика = "ЗагрузчикИзПодсистемКонфигурации";
		КонецЕсли;

	КонецЕсли;

	Возврат СтрШаблон("xddRun %1 """"%2"""";", ИмяЗагрузчика, ПутьВходящихДанных);

КонецФункции

// Форматы отчёта xUnitFor1C. Отчёты пишет Vanessa-ADD, набор её генераторов расширяем
// плагинами - поэтому словарь открытый: кроме перечисленных алиасов принимается имя
// генератора (ГенераторОтчетаJUnitXML, GenerateReportJUnitXML и т.п.).
// Значение - имя файла или каталога внутри --report-path, когда форматов несколько.
//
// Возвращаемое значение:
//   Соответствие - формат -> имя по умолчанию
//
Функция ДопустимыеФорматыОтчетов()

	Форматы = Новый Соответствие;
	Форматы.Вставить("junit", "junit.xml");
	Форматы.Вставить("allure", "allure");
	Форматы.Вставить("json", "report.json");
	Форматы.Вставить("mxl", "report.mxl");
	Форматы.Вставить("genericexecution", "generic.xml");

	Возврат Форматы;

КонецФункции

// Отчёты, которые попросили сформировать: устаревшие --reportsxunit/--reportxunit и общая
// пара --report-format/--report-path складываются, при совпадении генератора побеждает
// общая пара. Молча терять отчёт, заданный устаревшей опцией, нельзя - в переходный период
// их держат вперемешку (одно в настройках, другое в командной строке).
//
// Возвращаемое значение:
//   Массив - Элементы <Структура>:
//    * Генератор - Строка - полное имя генератора отчёта Vanessa-ADD
//    * Путь      - Строка - путь вывода отчёта
//
Функция ПолучитьПараметрыОтчетов()

	Разбор = Новый РазборОтчетовXunit();

	Если ЗначениеЗаполнено(ПараметрыОтчетов) Тогда
		Лог.Предупреждение(
			"Опция --reportsxunit устарела, используйте: --report-format <формат> --report-path <путь>");
	КонецЕсли;

	Отчеты = Разбор.Разобрать(ПараметрыОтчетов, ВыходнойКаталогОтчета);

	Если НЕ ОпцииОтчетов.Задан() Тогда
		Возврат Отчеты;
	КонецЕсли;

	Для Каждого Отчет Из ОпцииОтчетов.СформироватьОтчеты(ДопустимыеФорматыОтчетов(), "junit", Истина) Цикл

		Если НЕ ЗначениеЗаполнено(Отчет.Путь) Тогда
			ВызватьИсключение СтрШаблон(
				"Не задан путь отчёта формата ""%1"": укажите --report-path", Отчет.Формат);
		КонецЕсли;

		ДобавитьОтчет(Отчеты, Разбор.ГенераторПоФормату(Отчет.Формат), Отчет.Путь);

	КонецЦикла;

	Возврат Отчеты;

КонецФункции

// Добавить отчёт в список; повторное указание генератора перекрывает предыдущее
// (то же правило, что и внутри --reportsxunit).
//
// Параметры:
//   Отчеты    - Массив - список отчётов, изменяется
//   Генератор - Строка - полное имя генератора отчёта Vanessa-ADD
//   Путь      - Строка - путь вывода отчёта
//
Процедура ДобавитьОтчет(Отчеты, Знач Генератор, Знач Путь)

	Для Каждого Отчет Из Отчеты Цикл
		Если Отчет.Генератор = Генератор Тогда
			Отчет.Путь = Путь;
			Возврат;
		КонецЕсли;
	КонецЦикла;

	Отчеты.Добавить(Новый Структура("Генератор, Путь", Генератор, Путь));

КонецПроцедуры

Процедура ОбеспечитьКаталогиОтчетов(Знач НаборПараметров)

	Для Каждого ПараметрыОтчета Из НаборПараметров Цикл
		ФайловыеОперации.ОбеспечитьКаталогДляФайла(ПараметрыОтчета.Путь);
		КаталогОтчета = Новый Файл(ФайловыеОперации.КаталогФайла(ПараметрыОтчета.Путь));

		Если ОчищатьОтчеты = Истина И КаталогОтчета.Существует() Тогда
			МассивФайлов = НайтиФайлы(КаталогОтчета.ПолноеИмя, "*.*");
			Для Каждого Файл Из МассивФайлов Цикл
				УдалитьФайлы(Файл.ПолноеИмя);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция РабочийКаталог()

	Если ЗначениеЗаполнено(РабочийКаталогПроекта) Тогда
		Возврат ПолныйПуть(РабочийКаталогПроекта);
	КонецЕсли;

	Возврат СервисОкружения.РабочийКаталог();

КонецФункции

Функция ПолныйПуть(Знач Путь)

	Возврат ФайловыеОперации.ПолныйПуть(Путь);

КонецФункции

Функция ДополнительныеПараметрыЗапуска()

	Части = Новый Массив;
	Части.Добавить("/TESTMANAGER");

	Если ЗначениеЗаполнено(ОпцииЗапуска.ДополнительныеПараметры) Тогда
		Части.Добавить(ОпцииЗапуска.ДополнительныеПараметры);
	КонецЕсли;

	Возврат СтрСоединить(Части, " ");

КонецФункции

// Начать сбор покрытия, если задан --coverage-report, и дописать аргументы отладки в параметры запуска.
//
// Параметры:
//   ПараметрыЗапуска     - Структура - параметры запуска платформы (модифицируется: ДополнительныеПараметры)
//   ПараметрыПодключения - Структура - параметры подключения к ИБ
//   ПараметрыПлатформы   - Структура - параметры платформы
//
// Возвращаемое значение:
//   Структура, Неопределено - контекст сеанса покрытия (Неопределено, если покрытие выключено)
//
Функция НачатьПокрытиеПриНеобходимости(ПараметрыЗапуска, Знач ПараметрыПодключения, Знач ПараметрыПлатформы)

	Если НЕ ОпцииПокрытия.Включено() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если НеОжидать = Истина Тогда
		ВызватьИсключение
			"Сбор покрытия (--coverage-report) несовместим с --no-wait: клиент 1С должен завершиться до сбора данных.";
	КонецЕсли;

	Контекст = СервисПокрытия.НачатьСеанс(
		ОпцииПокрытия.СформироватьПараметры(), ПараметрыПодключения, ПараметрыПлатформы);
	ПараметрыЗапуска.ДополнительныеПараметры =
		СокрЛП(ПараметрыЗапуска.ДополнительныеПараметры + " " + Контекст.АргументыОтладки);
	// Для режима ibsrv: ibsrv подключится к этому же серверу отладки (серверный код в замерах).
	ПараметрыЗапуска.Вставить("АдресСервераОтладки", Контекст.АдресСервера);
	Возврат Контекст;

КонецФункции

#КонецОбласти
