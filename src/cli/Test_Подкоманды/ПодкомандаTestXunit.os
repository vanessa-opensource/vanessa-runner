// BSLLS:MissingVariablesDescription-off Поля &Опция/&Аргумент/&НаборОпций - описания заданы в самой аннотации.
// BSLLS:MissingParameterDescription-off Внутренние служебные методы команды.
// BSLLS:MissingReturnedValueDescription-off Внутренние служебные методы команды.
&Лог("vrunner")
Перем Лог;

&Пластилин
Перем ФайловыеОперации;

&Пластилин
Перем СервисЗаполненияПараметров;

&Пластилин
Перем СервисОкружения;

&Пластилин
Перем СервисVanessaADD;

&НаборОпций("НаборОпцийПодключения")
Перем ОпцииПодключения;

&НаборОпций("НаборОпцийПлатформы")
Перем ОпцииПлатформы;

&НаборОпций("НаборОпцийЗапуска")
Перем ОпцииЗапуска;

&НаборОпций("НаборОпцийПокрытия")
Перем ОпцииПокрытия;

&Аргумент(Имя = "TESTSPATH",
    Описание = "Путь к тестам: каталог/файл, встроенные (--config-tests) или макрос $addRoot.
    |Обязателен: задаётся в командной строке или в файле настроек")
&ТСтрока
&ВОкружении("VRUNNER_TESTSPATH")
&Обязательный(Ложь)
Перем ПутьКТестам;

&Опция(Имя = "workspace", Описание = "Путь к папке проекта (для макросов $workspace, по умолчанию - текущий)")
&ТСтрока
&ВОкружении("VRUNNER_WORKSPACE")
Перем РабочийКаталогПроекта;

&Опция(Имя = "pathxunit", Описание = "Путь к внешней обработке xddTestRunner.epf (по умолчанию из vanessa-add)")
&ТСтрока
&ВОкружении("VRUNNER_PATHXUNIT")
Перем ПутьКИнструментам;

&НаборОпций("НаборОпцийОтчетов")
Перем ОпцииОтчетов;

&Опция(Имя = "reportsxunit",
	Описание = "Формат{Путь};Формат{Путь} (устарела: --report-format <формат> --report-path <путь>)")
&ТСтрока
&ВОкружении("VRUNNER_REPORTSXUNIT")
Перем ПараметрыОтчетов;

&Опция(Имя = "reportxunit", Описание = "Путь к каталогу с отчетом jUnit (устарел, используйте --report-path)")
&ТСтрока
Перем ВыходнойКаталогОтчета;

&Опция(Имя = "xddExitCodePath", Описание = "Путь к файлу статуса тестирования (0=пройдены, 1=не пройдены)")
&ТСтрока
Перем ПутьФайлаСтатуса;

&Опция(Имя = "xddConfig", Описание = "Путь к конфигурационному файлу xUnitFor1c")
&ТСтрока
Перем ПутьККонфигу; // BSLLS:Typo-off

&Опция(Имя = "testclient", Описание = "Параметры тест-клиента: Пользователь:Пароль:Порт")
&ТСтрока
Перем ОпцияТестКлиент;

&Опция(Имя = "testclient-additional", Описание = "Дополнительные параметры запуска тест-клиента")
&ТСтрока
Перем ДопПараметрыТестКлиента;

&Опция(Имя = "config-tests", Описание = "Загружать тесты, встроенные в конфигурацию")
&Флаговый
&ВОкружении("VRUNNER_CONFIG_TESTS")
Перем ЗагружатьВстроенныеТесты;

&Опция(Имя = "no-wait", Описание = "Не ожидать завершения запущенной команды/действия")
&Флаговый
Перем НеОжидать;

&Опция(Имя = "xdddebug", Описание = "Выводить отладочные сообщения при прогоне тестов")
&Флаговый
Перем ВключенаОтладка;

&Опция(Имя = "no-shutdown", Описание = "Не завершать 1С:Предприятие после выполнения тестов")
&Флаговый
Перем НеЗавершать;

&Опция(Имя = "clear-reports", Описание = "Очищать каталоги отчетов перед запуском тестов")
&Флаговый
Перем ОчищатьОтчеты;

&НаборОпций("НаборОпцийНастроек")
Перем ОпцииНастроек; // BSLLS:UnusedLocalVariable-off

&ПодкомандаПриложения(Имя = "xunit", Родитель = "КомандаTest", Описание = "Запустить тестирование xUnit")
&ДоступноВMCP
&MCPДлительная
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);
	СервисЗаполненияПараметров.ПроверитьЗаполнениеАргумента(ЭтотОбъект, "TESTSPATH");

	ПутьКТестам = СервисVanessaADD.ПодставитьМакросAddRoot(ПутьКТестам, "тестам");

	Лог.Информация("Выполняю тесты с помощью фреймворка Vanessa-ADD (xUnit) - %1", ПутьКТестам);

	ПараметрыПлатформы = ОпцииПлатформы.СформироватьПараметрыПлатформы();
	ПараметрыПодключения = ОпцииПодключения.ПараметрыПодключения();

	ОтчетыXUnit = ПолучитьПараметрыОтчетов();
	ПутьКОбработке = СервисVanessaADD.ПутьКОбработке("xddTestRunner.epf", ПутьКИнструментам, "--pathxunit");
	ОпцииОтчетов.ПодготовитьКаталоги(ОтчетыXUnit, ОпцииОтчетов.ФорматыКаталогов(), ОчищатьОтчеты = Истина);

	КлючЗапуска = СформироватьКлючЗапуска(ОтчетыXUnit);

	ПараметрыЗапуска = Новый Структура;
	ПараметрыЗапуска.Вставить("КомандаЗапуска", КлючЗапуска);
	ПараметрыЗапуска.Вставить("ПутьОбработки", ПутьКОбработке);
	ПараметрыЗапуска.Вставить("НавигационнаяСсылка", "");
	ПараметрыЗапуска.Вставить("НеОжидать", НеОжидать);
	ПараметрыЗапуска.Вставить("ПутьКФайлуСтатуса", ФайловыеОперации.ПолныйПуть(ПутьФайлаСтатуса));
	ОпцииЗапуска.ДополнитьПараметрыЗапуска(ПараметрыЗапуска, "/TESTMANAGER");

	ОпцииПокрытия.ЗапуститьПредприятиеСПокрытием(ПараметрыПодключения, ПараметрыЗапуска, ПараметрыПлатформы, НеОжидать);

	Лог.Информация("Выполнение тестов завершено");

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Функция СформироватьКлючЗапуска(Знач ОтчетыXUnit)

	КаталогПроекта = ФайловыеОперации.ПолныйПуть(СервисОкружения.ПутьИлиРабочийКаталог(РабочийКаталогПроекта));

	ПутьТестов = ПутьТестовДляЗагрузчика(КаталогПроекта);

	Части = Новый Массив;
	Части.Добавить(КлючЗапускаЗагрузчика(ПутьТестов));
	ДобавитьКлючиТестКлиента(Части);
	ДобавитьКлючиОтчетов(Части, ОтчетыXUnit);

	Если ЗначениеЗаполнено(ПутьККонфигу) Тогда
		Части.Добавить(СтрШаблон("xddConfig """"%1"""";", ФайловыеОперации.ПолныйПуть(ПутьККонфигу)));
	КонецЕсли;

	Если ВключенаОтладка = Истина Тогда
		Части.Добавить("debug;");
	КонецЕсли;

	Части.Добавить(СтрШаблон("workspaceRoot """"%1"""";", КаталогПроекта));

	Если НЕ НеЗавершать = Истина Тогда
		Части.Добавить("xddShutdown");
	КонецЕсли;

	Возврат СтрСоединить(Части, " ");

КонецФункции

// Путь к тестам для загрузчика: встроенные тесты адресуются относительно проекта, внешние - полным путём.
Функция ПутьТестовДляЗагрузчика(Знач КаталогПроекта)

	Если ЗагружатьВстроенныеТесты = Истина Тогда
		Возврат СтрЗаменить(ПутьКТестам, КаталогПроекта, "");
	Иначе
		Возврат ФайловыеОперации.ПолныйПуть(ПутьКТестам);
	КонецЕсли;

КонецФункции

Функция КлючЗапускаЗагрузчика(Знач ПутьВходящихДанных)

	Если НЕ ЗагружатьВстроенныеТесты = Истина Тогда

		ФайлТеста = Новый Файл(ПутьВходящихДанных);
		Если ФайлТеста.Существует() И ФайлТеста.ЭтоКаталог() Тогда
			ИмяЗагрузчика = "ЗагрузчикКаталога";
		Иначе
			ИмяЗагрузчика = "ЗагрузчикФайла";
		КонецЕсли;

	Иначе

		Если СтрНайти(ПутьВходящихДанных, ".") = 0 Тогда
			ИмяЗагрузчика = "ЗагрузчикРасширения";
		Иначе
			ИмяЗагрузчика = "ЗагрузчикИзПодсистемКонфигурации";
		КонецЕсли;

	КонецЕсли;

	Возврат СтрШаблон("xddRun %1 """"%2"""";", ИмяЗагрузчика, ПутьВходящихДанных);

КонецФункции

// Ключи тест-клиента: "::" и "::порт" в --testclient дополняются пользователем и паролем ИБ.
Процедура ДобавитьКлючиТестКлиента(Части)

	Если ЗначениеЗаполнено(ОпцияТестКлиент) Тогда
		Подключение = ОпцияТестКлиент;
		// BSLLS:IfElseIfEndsWithElse-off
		Если Подключение = "::" Тогда
			Подключение = СтрШаблон("%1:%2", ОпцииПодключения.Пользователь, ОпцииПодключения.Пароль);
		ИначеЕсли СтрНачинаетсяС(Подключение, "::") Тогда
			Подключение = СтрШаблон("%1:%2:%3", ОпцииПодключения.Пользователь, ОпцииПодключения.Пароль,
				Сред(Подключение, СтрДлина("::") + 1));
		КонецЕсли;
		// BSLLS:IfElseIfEndsWithElse-on
		Части.Добавить(СтрШаблон("xddTestClient """"%1"""";", Подключение));
	КонецЕсли;

	Если ЗначениеЗаполнено(ДопПараметрыТестКлиента) Тогда
		Части.Добавить(СтрШаблон("xddTestClientAdditional """"%1"""";", ДопПараметрыТестКлиента));
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьКлючиОтчетов(Части, Знач ОтчетыXUnit)

	Для Каждого ПараметрыОтчета Из ОтчетыXUnit Цикл
		Части.Добавить(СтрШаблон("xddReport %1 """"%2"""";", ПараметрыОтчета.Генератор, ПараметрыОтчета.Путь));
	КонецЦикла;

	Если ЗначениеЗаполнено(ПутьФайлаСтатуса) Тогда
		ПутьСтатуса = ФайловыеОперации.ПолныйПуть(ПутьФайлаСтатуса);
		Части.Добавить(СтрШаблон("xddExitCodePath ГенерацияКодаВозврата """"%1"""";", ПутьСтатуса));
	КонецЕсли;

КонецПроцедуры

// Форматы отчёта xUnitFor1C: словарь открытый, кроме алиасов принимается имя генератора Vanessa-ADD
// (ГенераторОтчетаJUnitXML, GenerateReportJUnitXML и т.п.). Значение - имя файла внутри --report-path.
Функция ДопустимыеФорматыОтчетов()

	Форматы = Новый Соответствие;
	Форматы.Вставить("junit", "junit.xml");
	Форматы.Вставить("allure", "allure");
	Форматы.Вставить("json", "report.json");
	Форматы.Вставить("mxl", "report.mxl");
	Форматы.Вставить("genericexecution", "generic.xml");

	Возврат Форматы;

КонецФункции

// Отчёты из устаревших --reportsxunit/--reportxunit и общей пары --report-format/--report-path;
// при совпадении отчёта побеждает общая пара (см. НаборОпцийОтчетов.СобратьОтчеты). Формат сравнивается
// в каноническом виде: "junit", "ГенераторОтчетаJUnitXML" и "GenerateReportJUnitXML" - один отчёт.
// Элементы результата: Формат, Путь и Генератор - имя генератора Vanessa-ADD для ключа запуска.
Функция ПолучитьПараметрыОтчетов()

	Разбор = Новый РазборОтчетовXunit();
	Устаревшие = Разбор.Разобрать(ПараметрыОтчетов, ВыходнойКаталогОтчета);

	Отчеты = ОпцииОтчетов.СобратьОтчеты(ДопустимыеФорматыОтчетов(), "junit", Устаревшие, Разбор);
	Для Каждого Отчет Из Отчеты Цикл
		Отчет.Вставить("Генератор", Разбор.ГенераторПоФормату(Отчет.Формат));
	КонецЦикла;

	Возврат Отчеты;

КонецФункции

#КонецОбласти
