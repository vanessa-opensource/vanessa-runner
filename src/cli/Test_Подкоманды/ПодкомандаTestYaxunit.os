// BSLLS:NumberOfValuesInStructureConstructor-off
// BSLLS:LatinAndCyrillicSymbolInWord-off Идентификаторы с латинской аббревиатурой (YAxUnit).
// BSLLS:Typo-off Доменные термины (Конфигу/YAxUnit).
// BSLLS:MissingVariablesDescription-off Поля &Опция/&Аргумент/&НаборОпций - описания заданы в самой аннотации.
&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисYAxUnit;

&Пластилин
Перем СервисЗаполненияПараметров;

&Пластилин
Перем СервисОкружения;

&Пластилин
Перем СервисПокрытия;

&НаборОпций("НаборОпцийПодключения")
Перем ОпцииПодключения;

&НаборОпций("НаборОпцийПлатформы")
Перем ОпцииПлатформы;

&НаборОпций("НаборОпцийЗапуска")
Перем ОпцииЗапуска;

&НаборОпций("НаборОпцийПокрытия")
Перем ОпцииПокрытия;

&Опция(Имя = "yaxunit-config", Описание = "Путь к готовому yaxunit.json (используется как есть)")
&ТСтрока
&ВОкружении("VRUNNER_YAXUNIT_CONFIG")
Перем ПутьКонфига;

&Опция(Имя = "ext", Описание = "Имена расширений с тестами через запятую (filter.extensions)")
&ТСтрока
&ВОкружении("VRUNNER_YAXUNIT_EXT")
Перем Расширения;

&Опция(Имя = "modules", Описание = "Имена модулей с тестами через запятую (filter.modules)")
&ТСтрока
Перем Модули;

&Опция(Имя = "tests", Описание = "Полные пути тестов через запятую: Модуль.Тест (filter.tests)")
&ТСтрока
Перем Тесты;

&Опция(Имя = "tags", Описание = "Теги тестов через запятую (filter.tags)")
&ТСтрока
Перем Теги;

&Опция(Имя = "suites", Описание = "Имена наборов тестов через запятую (filter.suites)")
&ТСтрока
Перем Наборы;

&Опция(Имя = "report", Описание = "Путь к файлу/каталогу отчёта (reportPath)")
&ТСтрока
&ВОкружении("VRUNNER_YAXUNIT_REPORT")
Перем ПутьОтчета;

&Опция(Имя = "report-format", Описание = "Формат отчёта: jUnit (по умолчанию), JSON, allure")
&ТСтрока
Перем ФорматОтчета;

&Опция(Имя = "exitcode", Описание = "Путь к файлу кода возврата тестирования (0=пройдены, 1=есть ошибки)")
&ТСтрока
&ВОкружении("VRUNNER_YAXUNIT_EXITCODE")
Перем ПутьСтатуса;

&Опция(Имя = "project-path", Описание = "Каталог проекта для разрешения зависимостей ФайлыПроекта (projectPath)")
&ТСтрока
&ВОкружении("VRUNNER_PROJECT_PATH")
Перем КаталогПроекта;

&Опция(Имя = "workspace", Описание = "Каталог рабочего пространства YAxUnit (workspacePath)")
&ТСтрока
&ВОкружении("VRUNNER_WORKSPACE")
Перем КаталогWorkspace;

&Опция(Имя = "show-report", Описание = "Открывать форму отчёта после тестов (по умолчанию выключено)")
&Флаговый
Перем ПоказыватьОтчет;

&Опция(Имя = "no-close", Описание = "Не закрывать 1С:Предприятие после выполнения тестов")
&Флаговый
Перем НеЗакрывать;

&Опция(Имя = "no-wait", Описание = "Не ожидать завершения запущенной команды/действия")
&Флаговый
Перем НеОжидать;

&НаборОпций("НаборОпцийНастроек")
Перем ОпцииНастроек; // BSLLS:UnusedLocalVariable-off

&ПодкомандаПриложения(Имя = "yaxunit", Родитель = "КомандаTest", Описание = "Запустить модульное тестирование YAxUnit")
&ДоступноВMCP
&MCPДлительная
&MCPЗаголовок("Запуск модульных тестов YAxUnit")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);

	Лог.Информация("Выполняю модульные тесты с помощью фреймворка YAxUnit");

	ПараметрыПлатформы = Новый Структура(
		"ВерсияПлатформы, КодРазрешения, Язык, Локаль",
		ОпцииПлатформы.ВерсияПлатформы,
		ОпцииПлатформы.КодРазрешения,
		ОпцииПлатформы.Язык,
		ОпцииПлатформы.Локаль);

	ПараметрыПодключения = Новый Структура(
		"СтрокаПодключения, Пользователь, Пароль",
		ОпцииПодключения.СтрокаПодключения,
		ОпцииПодключения.Пользователь,
		ОпцииПодключения.Пароль);

	ПараметрыТестов = СформироватьПараметрыТестов();
	ПараметрыЗапуска = СформироватьПараметрыЗапуска();

	КонтекстПокрытия = НачатьПокрытиеПриНеобходимости(ПараметрыЗапуска, ПараметрыПодключения, ПараметрыПлатформы);

	Попытка
		Результат = СервисYAxUnit.ЗапуститьТесты(ПараметрыПодключения, ПараметрыТестов, ПараметрыЗапуска, ПараметрыПлатформы);
	Исключение
		СервисПокрытия.ПрерватьСеанс(КонтекстПокрытия);
		ВызватьИсключение;
	КонецПопытки;

	СервисПокрытия.ЗавершитьСеанс(КонтекстПокрытия);

	ВывестиИтог(Результат);

	Лог.Информация("Выполнение модульных тестов YAxUnit завершено");

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

// Напечатать саммари прогона и выставить ненулевой код возврата при провалах.
//
// Параметры:
//   Результат - Структура - сводка результатов (см. СервисYAxUnit.НовыйРезультатТестов)
//
Процедура ВывестиИтог(Знач Результат)

	// Готовый конфиг без reportPath - саммари недоступно, поведение как прежде.
	Если НЕ ЗначениеЗаполнено(Результат.ПутьОтчета) Тогда
		Возврат;
	КонецЕсли;

	// Для не-jUnit форматов авто-разбор не выполняется - просто сообщаем путь отчёта.
	Если НЕ Результат.ФорматJUnit Тогда
		Лог.Информация("Отчёт YAxUnit сформирован: %1 (авто-саммари доступно только для формата jUnit)",
			Результат.ПутьОтчета);
		Возврат;
	КонецЕсли;

	Если НЕ Результат.ЕстьОтчет Тогда
		ВызватьИсключение СтрШаблон(
			"Отчёт YAxUnit не сформирован (%1).
			|Убедитесь, что движок YAxUnit и расширения с тестами загружены в ИБ (vrunner cfe load).",
			Результат.ПутьОтчета);
	КонецЕсли;

	Лог.Информация(СервисYAxUnit.СформироватьСаммари(Результат));

	Если НЕ Результат.Успех Тогда
		ВызватьИсключение СтрШаблон(
			"Тесты YAxUnit завершились с ошибками: провалено %1, ошибок %2.",
			Результат.Провалено, Результат.Ошибок);
	КонецЕсли;

КонецПроцедуры

Функция СформироватьПараметрыТестов()

	Параметры = Новый Структура;
	Параметры.Вставить("ПутьКонфигу", ПутьКонфига);
	Параметры.Вставить("Расширения", Расширения);
	Параметры.Вставить("Модули", Модули);
	Параметры.Вставить("Тесты", Тесты);
	Параметры.Вставить("Теги", Теги);
	Параметры.Вставить("Наборы", Наборы);
	Параметры.Вставить("ПутьОтчета", ПутьОтчета);
	Параметры.Вставить("ФорматОтчета", ?(ЗначениеЗаполнено(ФорматОтчета), ФорматОтчета, "jUnit"));
	Параметры.Вставить("ПутьСтатуса", ПутьСтатуса);
	Параметры.Вставить("КаталогПроекта", КаталогПроектаЭффективный());
	Параметры.Вставить("КаталогWorkspace", КаталогWorkspace);
	Параметры.Вставить("ЗакрыватьПослеТестов", НЕ НеЗакрывать = Истина);
	Параметры.Вставить("ПоказыватьОтчет", ПоказыватьОтчет = Истина);
	Возврат Параметры;

КонецФункции

Функция СформироватьПараметрыЗапуска()

	Параметры = Новый Структура;
	Параметры.Вставить("НавигационнаяСсылка", "");
	Параметры.Вставить("ПутьОбработки", "");
	Параметры.Вставить("НеОжидать", НеОжидать);
	Параметры.Вставить("РежимЗапуска", ОпцииЗапуска.РежимЗапуска);
	Параметры.Вставить("ДополнительныеПараметры", ДополнительныеПараметрыЗапуска());
	Параметры.Вставить("ИспользоватьIbsrv", ОпцииЗапуска.ИспользоватьIbsrv);
	Параметры.Вставить("ИспользоватьПрямоеСоединениеIbsrv", ОпцииЗапуска.ИспользоватьПрямоеСоединениеIbsrv);
	Параметры.Вставить("ИспользоватьОтладкуIbsrv", ОпцииЗапуска.ИспользоватьОтладкуIbsrv);
	Параметры.Вставить("ПодключитьсяКСуществующемуIbsrv", ОпцииЗапуска.ПодключитьсяКСуществующемуIbsrv);
	Параметры.Вставить("ПортIbsrv", ОпцииЗапуска.ПортIbsrv);
	Возврат Параметры;

КонецФункции

Функция ДополнительныеПараметрыЗапуска()

	Если ЗначениеЗаполнено(ОпцииЗапуска.ДополнительныеПараметры) Тогда
		Возврат ОпцииЗапуска.ДополнительныеПараметры;
	КонецЕсли;
	Возврат "";

КонецФункции

Функция КаталогПроектаЭффективный()

	Если ЗначениеЗаполнено(КаталогПроекта) Тогда
		Возврат Новый Файл(КаталогПроекта).ПолноеИмя;
	КонецЕсли;
	Возврат СервисОкружения.РабочийКаталог();

КонецФункции

// Начать сбор покрытия, если задан --coverage-report, и дописать аргументы отладки в параметры запуска.
//
// Параметры:
//   ПараметрыЗапуска     - Структура - параметры запуска платформы (модифицируется: ДополнительныеПараметры)
//   ПараметрыПодключения - Структура - параметры подключения к ИБ
//   ПараметрыПлатформы   - Структура - параметры платформы
//
// Возвращаемое значение:
//   Структура, Неопределено - контекст сеанса покрытия (Неопределено, если покрытие выключено)
//
Функция НачатьПокрытиеПриНеобходимости(ПараметрыЗапуска, Знач ПараметрыПодключения, Знач ПараметрыПлатформы)

	Если НЕ ОпцииПокрытия.Включено() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если НеОжидать = Истина Тогда
		ВызватьИсключение
			"Сбор покрытия (--coverage-report) несовместим с --no-wait: клиент 1С должен завершиться до сбора данных.";
	КонецЕсли;

	Контекст = СервисПокрытия.НачатьСеанс(
		ОпцииПокрытия.СформироватьПараметры(), ПараметрыПодключения, ПараметрыПлатформы);
	ПараметрыЗапуска.ДополнительныеПараметры =
		СокрЛП(ПараметрыЗапуска.ДополнительныеПараметры + " " + Контекст.АргументыОтладки);
	// Для режима ibsrv: ibsrv подключится к этому же серверу отладки (серверный код в замерах).
	ПараметрыЗапуска.Вставить("АдресСервераОтладки", Контекст.АдресСервера);
	Возврат Контекст;

КонецФункции

#КонецОбласти
