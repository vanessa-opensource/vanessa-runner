// BSLLS:LineLength-off
// BSLLS:NumberOfValuesInStructureConstructor-off
// BSLLS:Typo-off
// BSLLS:MissingVariablesDescription-off Поля &Опция/&Аргумент/&НаборОпций - описания заданы в самой аннотации.
&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисПлатформы;

&Пластилин
Перем СервисЗаполненияПараметров;

&Пластилин
Перем СервисОкружения;

&Пластилин
Перем СервисПокрытия;

&Пластилин
Перем ФайловыеОперации;

&НаборОпций("НаборОпцийПодключения")
Перем ОпцииПодключения;

&НаборОпций("НаборОпцийПлатформы")
Перем ОпцииПлатформы;

&НаборОпций("НаборОпцийЗапуска")
Перем ОпцииЗапуска;

&НаборОпций("НаборОпцийПокрытия")
Перем ОпцииПокрытия;

&Опция(Имя = "feature-path",
    Описание = "Путь к каталогу с фичами или к фиче. Поддерживается макрос $addRoot - каталог установки vanessa-add")
&ТСтрока
&ВОкружении("VRUNNER_FEATUREPATH")
Перем ПутьКФичам;

&Опция(Имя = "bddrunner-path", Описание = "Путь к внешней обработке bddRunner.epf (по умолчанию из vanessa-add)")
&ТСтрока
&ВОкружении("VRUNNER_PATHVANESSA")
Перем ПутьКИнструментам;

&Опция(Имя = "vanessasettings",
	Описание = "Путь к настройкам Vanessa; относительный путь и макросы $workspaceRoot/$workspace разрешаются от --workspace")
&ТСтрока
&ВОкружении("VRUNNER_VANESSASETTINGS")
Перем ПутьКНастройкам;

&Опция(Имя = "workspace", Описание = "Путь к папке проекта (для макросов $workspace, по умолчанию - текущий)")
&ТСтрока
&ВОкружении("VRUNNER_WORKSPACE")
Перем РабочийКаталогПроекта;

&Опция(Имя = "tags-ignore", Описание = "Теги игнорирования фича-файлов")
&ТСтрока
Перем ТегиИгнорирования;

&Опция(Имя = "tags-filter", Описание = "Теги фильтрации фича-файлов")
&ТСтрока
Перем ТегиФильтр;

&Опция(Имя = "additional-keys", Описание = "Дополнительные параметры, передаваемые в /C")
&ТСтрока
Перем ДопКлючи;

&Опция(Имя = "no-wait", Описание = "Не ожидать завершения запущенной команды/действия")
&Флаговый
Перем НеОжидать;

&НаборОпций("НаборОпцийОтчетов")
Перем ОпцииОтчетов;

&НаборОпций("НаборОпцийНастроек")
Перем ОпцииНастроек; // BSLLS:UnusedLocalVariable-off

&ПодкомандаПриложения(Имя = "vanessa", Родитель = "КомандаTest", Описание = "Запустить тестирование Vanessa")
&ДоступноВMCP
&MCPДлительная
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);

	ПутьКФичам = ПодставитьМакросAddRoot(ПутьКФичам);
	ПутьКНастройкам = РазрешитьПутьОтРабочегоКаталога(ПутьКНастройкам);
	ПутьКНастройкам = ДополнитьНастройкиОтчетами(ПутьКНастройкам);
	УстановитьПутьКФичамДляVanessa();

	Лог.Информация("Тестирую поведение с помощью фреймворка Vanessa-ADD (BDD)");

	ПараметрыПлатформы = Новый Структура(
		"ВерсияПлатформы, КодРазрешения, Язык, Локаль",
		ОпцииПлатформы.ВерсияПлатформы,
		ОпцииПлатформы.КодРазрешения,
		ОпцииПлатформы.Язык,
		ОпцииПлатформы.Локаль);

	ПараметрыПодключения = Новый Структура(
		"СтрокаПодключения, Пользователь, Пароль",
		ОпцииПодключения.СтрокаПодключения,
		ОпцииПодключения.Пользователь,
		ОпцииПодключения.Пароль);

	ПутьКОбработке = ПолучитьПутьКОбработке();
	КлючЗапуска = СформироватьКлючЗапуска();

	ПараметрыЗапуска = Новый Структура;
	ПараметрыЗапуска.Вставить("КомандаЗапуска", КлючЗапуска);
	ПараметрыЗапуска.Вставить("ПутьОбработки", ПутьКОбработке);
	ПараметрыЗапуска.Вставить("НавигационнаяСсылка", "");
	ПараметрыЗапуска.Вставить("НеОжидать", НеОжидать);
	ПараметрыЗапуска.Вставить("РежимЗапуска", ОпцииЗапуска.РежимЗапуска);
	ПараметрыЗапуска.Вставить("ДополнительныеПараметры", ДополнительныеПараметрыЗапуска());
	ПараметрыЗапуска.Вставить("ПутьКФайлуСтатуса", "");
	ПараметрыЗапуска.Вставить("ИспользоватьIbsrv", ОпцииЗапуска.ИспользоватьIbsrv);
	ПараметрыЗапуска.Вставить("ИспользоватьПрямоеСоединениеIbsrv", ОпцииЗапуска.ИспользоватьПрямоеСоединениеIbsrv);
	ПараметрыЗапуска.Вставить("ИспользоватьОтладкуIbsrv", ОпцииЗапуска.ИспользоватьОтладкуIbsrv);
	ПараметрыЗапуска.Вставить("ПодключитьсяКСуществующемуIbsrv", ОпцииЗапуска.ПодключитьсяКСуществующемуIbsrv);
	ПараметрыЗапуска.Вставить("ПортIbsrv", ОпцииЗапуска.ПортIbsrv);

	КонтекстПокрытия = НачатьПокрытиеПриНеобходимости(ПараметрыЗапуска, ПараметрыПодключения, ПараметрыПлатформы);

	Попытка
		СервисПлатформы.ЗапуститьПредприятие(ПараметрыПодключения, ПараметрыЗапуска, ПараметрыПлатформы);
	Исключение
		СервисПокрытия.ПрерватьСеанс(КонтекстПокрытия);
		ВызватьИсключение;
	КонецПопытки;

	СервисПокрытия.ЗавершитьСеанс(КонтекстПокрытия);

	Лог.Информация("Тестирование поведения завершено");

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

// Передать путь к фичам в Vanessa-ADD через переменную окружения VANESSA_FEATUREPATH.
// Ключа запуска для пути к фичам у bddRunner нет - переменная окружения наследуется
// клиентом 1С и переопределяет КаталогФич из настроек (поведение 2.x).
Процедура УстановитьПутьКФичамДляVanessa()

	Если НЕ ЗначениеЗаполнено(ПутьКФичам) Тогда
		Возврат;
	КонецЕсли;

	Если ОпцииЗапуска.РежимЗапуска = "1" Тогда
		ВызватьИсключение "Нельзя одновременно указывать --ordinaryapp 1 и --feature-path:"
			+ " Vanessa-ADD в толстом клиенте (обычные формы) не поддерживает указание фич при запуске.";
	КонецЕсли;

	ПутьКФичам = Новый Файл(ПутьКФичам).ПолноеИмя;
	УстановитьПеременнуюСреды("VANESSA_FEATUREPATH", ПутьКФичам);
	Лог.Отладка("VANESSA_FEATUREPATH = %1", ПутьКФичам);

КонецПроцедуры

Функция ПолучитьПутьКОбработке()

	Если ЗначениеЗаполнено(ПутьКИнструментам) Тогда
		Путь = Новый Файл(ПутьКИнструментам).ПолноеИмя;
		ПроверитьФайлОбработки(Путь, "--bddrunner-path");
		Возврат Путь;
	КонецЕсли;

	КаталогADD = СервисОкружения.КаталогVanessaADD();
	Если НЕ ЗначениеЗаполнено(КаталогADD) Тогда
		ВызватьИсключение "Не удалось определить путь к oscript для поиска bddRunner.epf. Укажите путь явно через --bddrunner-path.";
	КонецЕсли;

	Путь = Новый Файл(ОбъединитьПути(КаталогADD, "bddRunner.epf")).ПолноеИмя;
	ПроверитьФайлОбработки(Путь, "--bddrunner-path");
	Возврат Путь;

КонецФункции

// Подставить макрос $addRoot (каталог установки vanessa-add) в путь к фичам.
//
// Параметры:
//   Путь - Строка - исходный путь к фичам, возможно содержащий макрос $addRoot
//
// Возвращаемое значение:
//   Строка - путь с раскрытым макросом $addRoot
//
Функция ПодставитьМакросAddRoot(Знач Путь)

	Если СтрНайти(Путь, "$addRoot") = 0 Тогда
		Возврат Путь;
	КонецЕсли;

	КаталогADD = СервисОкружения.КаталогVanessaADD();
	Если НЕ ЗначениеЗаполнено(КаталогADD) Тогда
		ВызватьИсключение "Не удалось разрешить макрос $addRoot: не найден каталог установки vanessa-add."
			+ " Укажите путь к фичам явно.";
	КонецЕсли;

	Возврат СтрЗаменить(Путь, "$addRoot", КаталогADD);

КонецФункции

Процедура ПроверитьФайлОбработки(Знач Путь, Знач ИмяОпции)

	Файл = Новый Файл(Путь);
	Если НЕ Файл.Существует() Тогда
		ВызватьИсключение СтрШаблон(
			"Файл обработки bddRunner.epf не найден: %1."
			+ " Убедитесь, что установлен пакет vanessa-add, либо укажите корректный путь через опцию %2.",
			Путь, ИмяОпции);
	КонецЕсли;

	Если НЕ Файл.ЭтоФайл() Тогда
		ВызватьИсключение СтрШаблон(
			"Указанный путь не является файлом: %1 (опция %2)", Путь, ИмяОпции);
	КонецЕсли;

КонецПроцедуры

// Форматы отчёта Vanessa-ADD. Отчёты пишет сама Vanessa-ADD, набор форматов задан
// её настройками (см. behavior-schema.json), поэтому словарь закрыт.
// Значение - имя каталога внутри --report-path, когда форматов несколько.
Функция ДопустимыеФорматыОтчетов()

	Форматы = Новый Соответствие;
	Форматы.Вставить("junit", "junit");
	Форматы.Вставить("allure", "allure");
	Форматы.Вставить("cucumberjson", "cucumber");

	Возврат Форматы;

КонецФункции

// Наложить --report-format/--report-path на настройки Vanessa-ADD.
//
// Ключей запуска для отчётов у bddRunner нет, поэтому опции превращаются в настройки:
// читаем пользовательский файл, дописываем каталоги отчётов и передаём временный файл.
// В отличие от --yaxunit-config, пользовательские настройки здесь не «как есть»:
// опции командной строки перекрывают одноимённые настройки - иначе опция была бы
// бесполезна, ведь --vanessasettings есть почти в каждом проекте.
//
// Параметры:
//   ПутьНастроек - Строка - путь к пользовательскому файлу настроек
//
// Возвращаемое значение:
//   Строка - путь к файлу настроек для ключа VBParams
//
Функция ДополнитьНастройкиОтчетами(Знач ПутьНастроек)

	Отчеты = ПолучитьОтчеты();
	Если Отчеты.Количество() = 0 Тогда
		Возврат ПутьНастроек;
	КонецЕсли;

	Для Каждого Отчет Из Отчеты Цикл
		Лог.Информация("Отчёт Vanessa в формате %1: %2", Отчет.Формат, Отчет.Путь);
		ФайловыеОперации.ОбеспечитьКаталог(Отчет.Путь);
	КонецЦикла;

	Возврат Новый НастройкиVanessa().ДополнитьОтчетами(ПутьНастроек, Отчеты);

КонецФункции

Функция ПолучитьОтчеты()

	Если НЕ ОпцииОтчетов.Задан() Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Отчеты = ОпцииОтчетов.СформироватьОтчеты(ДопустимыеФорматыОтчетов(), "junit");

	// У Vanessa-ADD все три формата выгружаются в каталог, поэтому путь обязателен.
	Для Каждого Отчет Из Отчеты Цикл
		Если НЕ ЗначениеЗаполнено(Отчет.Путь) Тогда
			ВызватьИсключение СтрШаблон(
				"Не задан каталог отчёта формата ""%1"": укажите --report-path", Отчет.Формат);
		КонецЕсли;
	КонецЦикла;

	Возврат Отчеты;

КонецФункции

Функция СформироватьКлючЗапуска()

	Каталог = РабочийКаталог();

	КлючиЗапуска = Новый Массив;
	КлючиЗапуска.Добавить("StartFeaturePlayer");
	КлючиЗапуска.Добавить("workspaceRoot=" + Каталог);

	Если ЗначениеЗаполнено(ПутьКНастройкам) Тогда
		КлючиЗапуска.Добавить("VBParams=" + ПутьКНастройкам);
	КонецЕсли;

	Если ЗначениеЗаполнено(ТегиИгнорирования) Тогда
		КлючиЗапуска.Добавить("TagsIgnore=" + ТегиИгнорирования);
	КонецЕсли;

	Если ЗначениеЗаполнено(ТегиФильтр) Тогда
		КлючиЗапуска.Добавить("TagsFilter=" + ТегиФильтр);
	КонецЕсли;

	Если ЗначениеЗаполнено(ДопКлючи) Тогда
		КлючиЗапуска.Добавить(ДопКлючи);
	КонецЕсли;

	Возврат СтрСоединить(КлючиЗапуска, ";");

КонецФункции

Функция РабочийКаталог()

	Если ЗначениеЗаполнено(РабочийКаталогПроекта) Тогда
		Возврат Новый Файл(РабочийКаталогПроекта).ПолноеИмя;
	КонецЕсли;

	Возврат Новый Файл(СервисОкружения.РабочийКаталог()).ПолноеИмя;

КонецФункции

// Разрешить относительный путь к настройкам Vanessa от каталога проекта, а не от
// каталога установки vanessa-add, в котором bddRunner обрабатывает VBParams.
// Поддерживаются также макросы $workspaceRoot и $workspace.
Функция РазрешитьПутьОтРабочегоКаталога(Знач Путь)

	Если НЕ ЗначениеЗаполнено(Путь) Тогда
		Возврат "";
	КонецЕсли;

	КаталогПроекта = РабочийКаталог();
	Путь = СтрЗаменить(Путь, "$workspaceRoot", КаталогПроекта);
	Путь = СтрЗаменить(Путь, "$workspace", КаталогПроекта);

	Возврат Новый Файл(ОбъединитьПути(КаталогПроекта, Путь)).ПолноеИмя;

КонецФункции

Функция ДополнительныеПараметрыЗапуска()

	Части = Новый Массив;
	Части.Добавить("/TESTMANAGER");

	Если ЗначениеЗаполнено(ОпцииЗапуска.ДополнительныеПараметры) Тогда
		Части.Добавить(ОпцииЗапуска.ДополнительныеПараметры);
	КонецЕсли;

	Возврат СтрСоединить(Части, " ");

КонецФункции

// Начать сбор покрытия, если задан --coverage-report, и дописать аргументы отладки в параметры запуска.
//
// Параметры:
//   ПараметрыЗапуска     - Структура - параметры запуска платформы (модифицируется: ДополнительныеПараметры)
//   ПараметрыПодключения - Структура - параметры подключения к ИБ
//   ПараметрыПлатформы   - Структура - параметры платформы
//
// Возвращаемое значение:
//   Структура, Неопределено - контекст сеанса покрытия (Неопределено, если покрытие выключено)
//
Функция НачатьПокрытиеПриНеобходимости(ПараметрыЗапуска, Знач ПараметрыПодключения, Знач ПараметрыПлатформы)

	Если НЕ ОпцииПокрытия.Включено() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если НеОжидать = Истина Тогда
		ВызватьИсключение
			"Сбор покрытия (--coverage-report) несовместим с --no-wait: клиент 1С должен завершиться до сбора данных.";
	КонецЕсли;

	Контекст = СервисПокрытия.НачатьСеанс(
		ОпцииПокрытия.СформироватьПараметры(), ПараметрыПодключения, ПараметрыПлатформы);
	ПараметрыЗапуска.ДополнительныеПараметры =
		СокрЛП(ПараметрыЗапуска.ДополнительныеПараметры + " " + Контекст.АргументыОтладки);
	// Для режима ibsrv: ibsrv подключится к этому же серверу отладки (серверный код в замерах).
	ПараметрыЗапуска.Вставить("АдресСервераОтладки", Контекст.АдресСервера);
	Возврат Контекст;

КонецФункции

#КонецОбласти
