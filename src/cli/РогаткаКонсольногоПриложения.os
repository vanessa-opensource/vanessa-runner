// BSLLS:MissingVariablesDescription-off 

#Использовать tempfiles

&Лог("vrunner")
Перем Лог;

&Пластилин
Перем КонсольноеПриложение;

&Пластилин
Перем СервисОкружения;

&Рогатка("ИКС_Рогатка", ЗапускатьВФоне = Ложь)
&Верховный
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Точка входа рогатки: выполняет команду из аргументов командной строки
// и завершает процесс с её кодом возврата.
Процедура ПриЗапускеПриложения() Экспорт
	ЗавершитьРаботу(ВыполнитьКоманду(АргументыКоманднойСтроки));
КонецПроцедуры

// Выполнить команду консольного приложения и удалить накопленные временные файлы.
// Сами аргументы в лог не пишутся: среди них бывают пароли.
//
// Параметры:
//   Аргументы - Массив из Строка - аргументы командной строки
//
// Возвращаемое значение:
//   Число - код возврата процесса: 0 - успех, 1 - команда завершилась исключением
//
Функция ВыполнитьКоманду(Знач Аргументы) Экспорт

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ВывестиОкружениеВЛог();

	КодВозврата = 0;
	Попытка
		КонсольноеПриложение.Запустить(Аргументы);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Лог.Ошибка(ОписаниеОшибки());
		Лог.Отладка(ПредставлениеОшибкиДляОтладки(Ошибка));
		КодВозврата = 1;
	КонецПопытки;

	УдалитьВременныеФайлы();

	Лог.Отладка("Команда завершена: код возврата %1, длительность %2 мс",
		КодВозврата, ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало);

	Возврат КодВозврата;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Одна строка с тем, что чаще всего нужно при разборе логов CI: движок, платформа,
// откуда запущен vrunner и в каком каталоге.
Процедура ВывестиОкружениеВЛог()

	Система = Новый СистемнаяИнформация;
	Лог.Отладка("OneScript %1 (%2); пакет vanessa-runner: %3; рабочий каталог: %4",
		Система.Версия, Система.ТипПлатформы,
		СервисОкружения.КорневойКаталогПакета(), СервисОкружения.РабочийКаталог());

КонецПроцедуры

// Место возникновения ошибки и стек вызовов: в сообщении команды виден только текст,
// а в стеке - какой сервис и движок его породили.
//
// Параметры:
//   Ошибка - ИнформацияОбОшибке - перехваченная ошибка команды
//
// Возвращаемое значение:
//   Строка - подробное представление ошибки со стеком вызовов
//
Функция ПредставлениеОшибкиДляОтладки(Знач Ошибка)

	Представление = ПодробноеПредставлениеОшибки(Ошибка);

	Кадры = Новый Массив;
	Попытка
		Для Каждого Кадр Из Ошибка.ПолучитьСтекВызовов() Цикл
			Кадры.Добавить(СтрШаблон("    %1 (%2:%3)", Кадр.Метод, Кадр.ИмяМодуля, Кадр.НомерСтроки));
		КонецЦикла;
	Исключение
		// Стек вызовов есть не во всех версиях OneScript - обходимся без него
		Кадры = Новый Массив;
	КонецПопытки;

	Если Кадры.Количество() > 0 Тогда
		Представление = Представление + Символы.ПС + "Стек вызовов:" + Символы.ПС
			+ СтрСоединить(Кадры, Символы.ПС);
	КонецЕсли;

	Возврат Представление;

КонецФункции

// Удаляет всё, что команда зарегистрировала через ВременныеФайлы. О каждом файле, который не
// удалось удалить, tempfiles предупреждает сам - здесь только сводка для отладки.
Процедура УдалитьВременныеФайлы()

	ВременныеФайлыКоманды = ВременныеФайлы.Файлы();
	Если ВременныеФайлыКоманды.Количество() = 0 Тогда
		Лог.Отладка("Временных файлов после команды нет");
		Возврат;
	КонецЕсли;

	Лог.Отладка("Удаление временных файлов команды (%1): %2",
		ВременныеФайлыКоманды.Количество(), СтрСоединить(ВременныеФайлыКоманды, ", "));
	ВременныеФайлы.Удалить();

	Оставшиеся = ВременныеФайлы.Файлы();
	Если Оставшиеся.Количество() = 0 Тогда
		Лог.Отладка("Временные файлы команды удалены");
	Иначе
		Лог.Отладка("Не удалось удалить временные файлы (%1): %2",
			Оставшиеся.Количество(), СтрСоединить(Оставшиеся, ", "));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
