// BSLLS:MissingVariablesDescription-off 

#Использовать tempfiles

&Лог("vrunner")
Перем Лог;

&Пластилин
Перем КонсольноеПриложение;

&Рогатка("ИКС_Рогатка", ЗапускатьВФоне = Ложь)
&Верховный
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Точка входа рогатки: выполняет команду из аргументов командной строки
// и завершает процесс с её кодом возврата.
Процедура ПриЗапускеПриложения() Экспорт
	ЗавершитьРаботу(ВыполнитьКоманду(АргументыКоманднойСтроки));
КонецПроцедуры

// Выполнить команду консольного приложения и удалить накопленные временные файлы.
//
// Параметры:
//   Аргументы - Массив из Строка - аргументы командной строки
//
// Возвращаемое значение:
//   Число - код возврата процесса: 0 - успех, 1 - команда завершилась исключением
//
Функция ВыполнитьКоманду(Знач Аргументы) Экспорт

	КодВозврата = 0;
	Попытка
		КонсольноеПриложение.Запустить(Аргументы);
	Исключение
		Лог.Ошибка(ОписаниеОшибки());
		КодВозврата = 1;
	КонецПопытки;

	УдалитьВременныеФайлы();

	Возврат КодВозврата;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Удаляет всё, что команда зарегистрировала через ВременныеФайлы. О каждом файле, который не
// удалось удалить, tempfiles предупреждает сам - здесь только сводка для отладки.
Процедура УдалитьВременныеФайлы()

	ВременныеФайлыКоманды = ВременныеФайлы.Файлы();
	Если ВременныеФайлыКоманды.Количество() = 0 Тогда
		Лог.Отладка("Временных файлов после команды нет");
		Возврат;
	КонецЕсли;

	Лог.Отладка("Удаление временных файлов команды (%1): %2",
		ВременныеФайлыКоманды.Количество(), СтрСоединить(ВременныеФайлыКоманды, ", "));
	ВременныеФайлы.Удалить();

	Оставшиеся = ВременныеФайлы.Файлы();
	Если Оставшиеся.Количество() = 0 Тогда
		Лог.Отладка("Временные файлы команды удалены");
	Иначе
		Лог.Отладка("Не удалось удалить временные файлы (%1): %2",
			Оставшиеся.Количество(), СтрСоединить(Оставшиеся, ", "));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
