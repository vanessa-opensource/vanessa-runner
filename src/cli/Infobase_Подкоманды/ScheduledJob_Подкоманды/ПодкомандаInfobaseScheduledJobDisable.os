// BSLLS:LineLength-off
// BSLLS:NumberOfValuesInStructureConstructor-off
// BSLLS:MissingVariablesDescription-off Поля &Опция/&Аргумент/&НаборОпций - описания заданы в самой аннотации.
//
// Возможное развитие: добавить управление расписанием регламентного
// задания через передачу расписания в cron-формате (например, ключ
// --schedule "0 3 * * *"), а не только включение/отключение использования.
&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисЗапускаОбработок;

&Пластилин
Перем СервисЗаполненияПараметров;

&НаборОпций("НаборОпцийПодключения")
Перем ОпцииПодключения;

&НаборОпций("НаборОпцийПлатформы")
Перем ОпцииПлатформы;

&НаборОпций("НаборОпцийСУБД")
Перем ОпцииСУБД;

&Аргумент(Имя = "JOB", Описание = "Имя метаданных регламентного задания, которое нужно отключить")
&ТСтрока
Перем ИмяЗадания;

&ПодкомандаПриложения(Имя = "disable", Родитель = "ПодкомандаInfobaseScheduledJob",
		Описание = "Отключить регламентное задание по имени метаданных (БСП)")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);

	Если НЕ ЗначениеЗаполнено(ИмяЗадания) Тогда
		ВызватьИсключение "Не задано имя регламентного задания (аргумент JOB)";
	КонецЕсли;

	Лог.Отладка("Начало выполнения команды infobase scheduled-job disable: %1", ИмяЗадания);

	// Обработка БлокировкаРаботыСВнешнимиРесурсами ожидает имя задания вторым
	// позиционным токеном строки параметров, поэтому порядок ключей важен.
	Параметры = Новый Структура;
	Параметры.Вставить("ОтключитьРегламентноеЗадание", Истина);
	Параметры.Вставить(ИмяЗадания, Истина);

	СервисЗапускаОбработок.ВыполнитьОбработку(
		"БлокировкаРаботыСВнешнимиРесурсами",
		СформироватьПараметрыПодключения(),
		Параметры,
		СформироватьПараметрыПлатформы());

	Лог.Информация("Регламентное задание '%1' отключено", ИмяЗадания);

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Функция СформироватьПараметрыПлатформы()

	Возврат Новый Структура(
		"ВерсияПлатформы, КодРазрешения, Язык, Локаль",
		ОпцииПлатформы.ВерсияПлатформы,
		ОпцииПлатформы.КодРазрешения,
		ОпцииПлатформы.Язык,
		ОпцииПлатформы.Локаль);

КонецФункции

Функция СформироватьПараметрыПодключения()

	Возврат ОпцииПодключения.СформироватьПараметрыПодключения(ОпцииСУБД);

КонецФункции

#КонецОбласти
