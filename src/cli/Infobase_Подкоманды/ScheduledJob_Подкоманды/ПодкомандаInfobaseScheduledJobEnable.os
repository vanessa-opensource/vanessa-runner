// BSLLS:MissingVariablesDescription-off Поля &Опция/&Аргумент/&НаборОпций - описания заданы в самой аннотации.
&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисЗапускаОбработок;

&Пластилин
Перем СервисЗаполненияПараметров;

&НаборОпций("НаборОпцийПодключения")
Перем ОпцииПодключения;

&НаборОпций("НаборОпцийПлатформы")
Перем ОпцииПлатформы;

&НаборОпций("НаборОпцийСУБД")
Перем ОпцииСУБД;

&Аргумент(Имя = "JOB", Описание = "Имя метаданных регламентного задания, которое нужно включить")
&ТСтрока
Перем ИмяЗадания;

&ПодкомандаПриложения(Имя = "enable", Родитель = "ПодкомандаInfobaseScheduledJob",
		Описание = "Включить регламентное задание по имени метаданных (БСП)")
&ДоступноВMCP
&MCPРазрушающая
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);

	Если НЕ ЗначениеЗаполнено(ИмяЗадания) Тогда
		ВызватьИсключение "Не задано имя регламентного задания (аргумент JOB)";
	КонецЕсли;

	Лог.Отладка("Начало выполнения команды infobase scheduled-job enable: %1", ИмяЗадания);

	// Обработка БлокировкаРаботыСВнешнимиРесурсами ожидает имя задания вторым
	// позиционным токеном строки параметров, поэтому порядок ключей важен.
	Параметры = Новый Структура;
	Параметры.Вставить("ВключитьРегламентноеЗадание", Истина);
	Параметры.Вставить(ИмяЗадания, Истина);

	СервисЗапускаОбработок.ВыполнитьОбработку(
		"БлокировкаРаботыСВнешнимиРесурсами",
		ОпцииПодключения.СформироватьПараметрыПодключения(ОпцииСУБД),
		Параметры,
		ОпцииПлатформы.СформироватьПараметрыПлатформы());

	Лог.Информация("Регламентное задание '%1' включено", ИмяЗадания);

КонецПроцедуры
