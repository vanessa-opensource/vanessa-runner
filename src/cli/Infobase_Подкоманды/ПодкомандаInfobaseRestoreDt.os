// BSLLS:LineLength-off
// BSLLS:MissingVariablesDescription-off Поля &Опция/&Аргумент/&НаборОпций - описания заданы в самой аннотации.
&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисПлатформы;

&Пластилин
Перем СервисЗаполненияПараметров;

&НаборОпций("НаборОпцийПодключения")
Перем ОпцииПодключения;

&НаборОпций("НаборОпцийIbcmd")
Перем ОпцииIbcmd;

&НаборОпций("НаборОпцийПлатформы")
Перем ОпцииПлатформы;

&НаборОпций("НаборОпцийСУБД")
Перем ОпцииСУБД;

&Аргумент(Имя = "IN",
	Описание = "Путь к входному файлу DT (*.dt). Обязателен: задаётся в командной строке или в файле настроек")
&ТСтрока
&ОбязательныйПослеЗаполнения
&СуществующийФайл("Файл DT не найден: %1")
Перем ПутьКФайлуDT;

&НаборОпций("НаборОпцийНастроек")
Перем ОпцииНастроек; // BSLLS:UnusedLocalVariable-off

&ПодкомандаПриложения(Имя = "restore-dt", Родитель = "КомандаInfobase", Описание = "Загрузить информационную базу из файла dt")
&ДоступноВMCP
&MCPДлительная
&MCPРазрушающая
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);

	Лог.Отладка("Начало выполнения команды infobase restore-dt");

	Если НЕ ЗначениеЗаполнено(ОпцииПодключения.СтрокаПодключения) Тогда
		ВызватьИсключение "Не указана строка подключения к информационной базе (--ibconnection)";
	КонецЕсли;

	ПараметрыПлатформы = ОпцииПлатформы.СформироватьПараметрыПлатформы();
	ПараметрыПодключения = ОпцииПодключения.ПараметрыПодключения(ОпцииСУБД);

	СервисПлатформы.ЗагрузитьИнфобазуИзФайла(
		ПараметрыПодключения,
		ПутьКФайлуDT,
		ОпцииIbcmd.ИспользоватьIbcmd,
		ПараметрыПлатформы);

КонецПроцедуры
