// BSLLS:LineLength-off
// BSLLS:MissingVariablesDescription-off Поля &Опция/&Аргумент/&НаборОпций - описания заданы в самой аннотации.
&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисПлатформы;

&Пластилин
Перем СервисЗаполненияПараметров;

&НаборОпций("НаборОпцийПодключения")
Перем ОпцииПодключения;

&НаборОпций("НаборОпцийIbcmd")
Перем ОпцииIbcmd;

&НаборОпций("НаборОпцийПлатформы")
Перем ОпцииПлатформы;

&НаборОпций("НаборОпцийСУБД")
Перем ОпцииСУБД;

&Аргумент(Имя = "OUT",
	Описание = "Путь к выходному файлу DT (*.dt). Обязателен: задаётся в командной строке или в файле настроек")
&ТСтрока
&Обязательный(Ложь)
Перем ПутьКФайлуDT;

&НаборОпций("НаборОпцийНастроек")
Перем ОпцииНастроек; // BSLLS:UnusedLocalVariable-off

&ПодкомандаПриложения(Имя = "dump-dt", Родитель = "КомандаInfobase", Описание = "Выгрузить информационную базу в файл dt")
&ДоступноВMCP
&MCPДлительная
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);
	СервисЗаполненияПараметров.ПроверитьЗаполнениеАргумента(ЭтотОбъект, "OUT");

	Лог.Отладка("Начало выполнения команды infobase dump-dt");

	Если НЕ ЗначениеЗаполнено(ОпцииПодключения.СтрокаПодключения) Тогда
		ВызватьИсключение "Не указана строка подключения к информационной базе (--ibconnection)";
	КонецЕсли;

	ПараметрыПлатформы = ОпцииПлатформы.СформироватьПараметрыПлатформы();
	ПараметрыПодключения = ОпцииПодключения.ПараметрыПодключения(ОпцииСУБД);

	СервисПлатформы.ВыгрузитьИнфобазуВФайл(
		ПараметрыПодключения,
		ПутьКФайлуDT,
		ОпцииIbcmd.ИспользоватьIbcmd,
		ПараметрыПлатформы);

КонецПроцедуры
