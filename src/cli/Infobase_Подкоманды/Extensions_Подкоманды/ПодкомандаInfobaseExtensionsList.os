// BSLLS:LineLength-off
// BSLLS:NumberOfValuesInStructureConstructor-off
// BSLLS:MissingVariablesDescription-off Поля &Опция/&Аргумент/&НаборОпций - описания заданы в самой аннотации.
&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисЗапускаОбработок;

&Пластилин
Перем СервисЗаполненияПараметров;

&НаборОпций("НаборОпцийПодключения")
Перем ОпцииПодключения;

&НаборОпций("НаборОпцийПлатформы")
Перем ОпцииПлатформы;

&НаборОпций("НаборОпцийСУБД")
Перем ОпцииСУБД;

&Опция(Имя = "verbose v", Описание = "Подробный вывод: таблица с именем, синонимом, версией и параметрами расширений (по умолчанию - только имена)")
&Флаговый
Перем Подробно;

&Опция(Имя = "json", Описание = "Вывод списка расширений в формате JSON (имя, синоним, версия, хэш, параметры). Имеет приоритет над --verbose")
&Флаговый
Перем ВыводJSON;

&ПодкомандаПриложения(Имя = "list", Родитель = "ПодкомандаInfobaseExtensions",
		Описание = "Вывести список установленных расширений конфигурации")
&ДоступноВMCP
&MCPТолькоЧтение
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);

	Лог.Отладка("Начало выполнения команды infobase extensions list (подробно=%1, json=%2)",
		Подробно = Истина, ВыводJSON = Истина);

	Параметры = Новый Структура;
	Параметры.Вставить("СписокРасширений", Истина);
	// Режимы вывода взаимоисключающие: json имеет приоритет над подробным (verbose),
	// при отсутствии флагов используется простой режим (только имена).
	Если ВыводJSON = Истина Тогда
		Параметры.Вставить("ВыводJSON", Истина);
	Иначе
		Если Подробно = Истина Тогда
			Параметры.Вставить("Подробно", Истина);
		КонецЕсли;
	КонецЕсли;

	СервисЗапускаОбработок.ВыполнитьОбработку(
		"РаботаСРасширениями",
		СформироватьПараметрыПодключения(),
		Параметры,
		СформироватьПараметрыПлатформы());

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Функция СформироватьПараметрыПлатформы()

	Возврат Новый Структура(
		"ВерсияПлатформы, КодРазрешения, Язык, Локаль",
		ОпцииПлатформы.ВерсияПлатформы,
		ОпцииПлатформы.КодРазрешения,
		ОпцииПлатформы.Язык,
		ОпцииПлатформы.Локаль);

КонецФункции

Функция СформироватьПараметрыПодключения()

	Возврат ОпцииПодключения.СформироватьПараметрыПодключения(ОпцииСУБД);

КонецФункции

#КонецОбласти
