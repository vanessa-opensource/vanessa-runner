// BSLLS:LineLength-off
// BSLLS:MissingVariablesDescription-off Поля &Опция/&Аргумент/&НаборОпций - описания заданы в самой аннотации.
&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисЗапускаОбработок;

&Пластилин
Перем СервисЗаполненияПараметров;

&НаборОпций("НаборОпцийПодключения")
Перем ОпцииПодключения;

&НаборОпций("НаборОпцийПлатформы")
Перем ОпцииПлатформы;

&НаборОпций("НаборОпцийСУБД")
Перем ОпцииСУБД;

&Опция(Имя = "verbose v", Описание = "Подробный вывод: таблица с именем, синонимом, версией и параметрами расширений (по умолчанию - только имена)")
&Флаговый
Перем Подробно;

&Опция(Имя = "json", Описание = "Вывод списка расширений в формате JSON (имя, синоним, версия, хэш, параметры). Имеет приоритет над --verbose")
&Флаговый
Перем ВыводJSON;

&ПодкомандаПриложения(Имя = "list", Родитель = "ПодкомандаInfobaseExtensions",
		Описание = "Вывести список установленных расширений конфигурации")
&ДоступноВMCP
&MCPТолькоЧтение
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);

	Лог.Отладка("Начало выполнения команды infobase extensions list (подробно=%1, json=%2)",
		Подробно = Истина, ВыводJSON = Истина);

	Параметры = Новый Структура;
	Параметры.Вставить("СписокРасширений", Истина);
	// BSLLS:CompareWithBoolean-off флаги могут быть Неопределено
	// BSLLS:IfElseIfEndsWithElse-off
	Если ВыводJSON = Истина Тогда
		Параметры.Вставить("ВыводJSON", Истина);
	ИначеЕсли Подробно = Истина Тогда
		Параметры.Вставить("Подробно", Истина);
	КонецЕсли;
	// BSLLS:IfElseIfEndsWithElse-on
	// BSLLS:CompareWithBoolean-on

	Результат = СервисЗапускаОбработок.ВыполнитьОбработку(
		"РаботаСРасширениями",
		ОпцииПодключения.СформироватьПараметрыПодключения(ОпцииСУБД),
		Параметры,
		ОпцииПлатформы.СформироватьПараметрыПлатформы(),
		Ложь);

	Для Каждого Сообщение Из Результат.Сообщения Цикл
		Сообщить(Сообщение);
	КонецЦикла;

КонецПроцедуры
