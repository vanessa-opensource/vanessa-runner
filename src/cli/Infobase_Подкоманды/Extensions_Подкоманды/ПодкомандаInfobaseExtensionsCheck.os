// BSLLS:MissingVariablesDescription-off Поля &Опция/&НаборОпций - описания заданы в самой аннотации.
&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисЗапускаОбработок;

&Пластилин
Перем СервисЗаполненияПараметров;

&НаборОпций("НаборОпцийПодключения")
Перем ОпцииПодключения;

&НаборОпций("НаборОпцийПлатформы")
Перем ОпцииПлатформы;

&НаборОпций("НаборОпцийСУБД")
Перем ОпцииСУБД;

&Аргумент(Имя = "NAME", Описание = "Имя конкретного расширения для проверки (по умолчанию проверяются все)")
&ТСтрока
&Обязательный(Ложь)
Перем ИмяРасширения;

&ПодкомандаПриложения(Имя = "check", Родитель = "ПодкомандаInfobaseExtensions",
		Описание = "Проверить применимость установленных расширений без их загрузки")
&ДоступноВMCP
&MCPТолькоЧтение
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);

	Лог.Отладка("Начало выполнения команды infobase extensions check");

	Параметры = Новый Структура;
	Параметры.Вставить("ЗапуститьТолькоПроверкуПрименимостиРасширений", Истина);
	Если ЗначениеЗаполнено(ИмяРасширения) Тогда
		Параметры.Вставить("Имя", ИмяРасширения);
	КонецЕсли;

	СервисЗапускаОбработок.ВыполнитьОбработку(
		"РаботаСРасширениями",
		ОпцииПодключения.СформироватьПараметрыПодключения(ОпцииСУБД),
		Параметры,
		ОпцииПлатформы.СформироватьПараметрыПлатформы());

	Лог.Информация("Проверка применимости расширений завершена");

КонецПроцедуры
