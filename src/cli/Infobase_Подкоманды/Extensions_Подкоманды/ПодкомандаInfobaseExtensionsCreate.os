// BSLLS:MissingVariablesDescription-off Поля &Опция/&Аргумент/&НаборОпций - описания заданы в самой аннотации.
&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисРасширений;

&Пластилин
Перем СервисЗаполненияПараметров;

&НаборОпций("НаборОпцийПодключения")
Перем ОпцииПодключения;

&НаборОпций("НаборОпцийПлатформы")
Перем ОпцииПлатформы;

&НаборОпций("НаборОпцийСУБД")
Перем ОпцииСУБД;

&Аргумент(Имя = "NAME",
	Описание = "Имя создаваемого расширения. Обязателен: задаётся в командной строке или в файле настроек")
&ТСтрока
&ОбязательныйПослеЗаполнения
Перем ИмяРасширения;

&Опция(Имя = "overwrite", Описание = "Пересоздать расширение, если оно уже существует (иначе - ошибка)")
&Флаговый
Перем Перезаписывать;

&ПодкомандаПриложения(Имя = "create", Родитель = "ПодкомандаInfobaseExtensions",
		Описание = "Создать пустое расширение конфигурации с заданным именем")
&ДоступноВMCP
&MCPРазрушающая
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);

	Лог.Отладка("Начало выполнения команды infobase extensions create: %1", ИмяРасширения);

	ПересоздаватьСуществующее = (Перезаписывать = Истина);

	СервисРасширений.СоздатьПустоеРасширение(
		ОпцииПодключения.СформироватьПараметрыПодключения(ОпцииСУБД),
		ИмяРасширения,
		ПересоздаватьСуществующее,
		ОпцииПлатформы.СформироватьПараметрыПлатформы());

КонецПроцедуры
