// BSLLS:LineLength-off
// BSLLS:NumberOfValuesInStructureConstructor-off
// BSLLS:MissingVariablesDescription-off Поля &Опция/&Аргумент/&НаборОпций - описания заданы в самой аннотации.
&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисЗапускаОбработок;

&Пластилин
Перем СервисЗаполненияПараметров;

&НаборОпций("НаборОпцийПодключения")
Перем ОпцииПодключения;

&НаборОпций("НаборОпцийПлатформы")
Перем ОпцииПлатформы;

&НаборОпций("НаборОпцийСУБД")
Перем ОпцииСУБД;

&Аргумент(Имя = "NAME", Описание = "Имя удаляемого расширения")
&ТСтрока
Перем ИмяРасширения;

&ПодкомандаПриложения(Имя = "delete", Родитель = "ПодкомандаInfobaseExtensions",
		Описание = "Удалить установленное расширение конфигурации по имени")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);

	Если НЕ ЗначениеЗаполнено(ИмяРасширения) Тогда
		ВызватьИсключение "Не задано имя расширения (аргумент NAME)";
	КонецЕсли;

	Лог.Отладка("Начало выполнения команды infobase extensions delete: %1", ИмяРасширения);

	Параметры = Новый Структура;
	Параметры.Вставить("УдалитьРасширение", Истина);
	Параметры.Вставить("Имя", ИмяРасширения);

	СервисЗапускаОбработок.ВыполнитьОбработку(
		"РаботаСРасширениями",
		СформироватьПараметрыПодключения(),
		Параметры,
		СформироватьПараметрыПлатформы());

	Лог.Информация("Расширение '%1' удалено", ИмяРасширения);

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Функция СформироватьПараметрыПлатформы()

	Возврат Новый Структура(
		"ВерсияПлатформы, КодРазрешения, Язык, Локаль",
		ОпцииПлатформы.ВерсияПлатформы,
		ОпцииПлатформы.КодРазрешения,
		ОпцииПлатформы.Язык,
		ОпцииПлатформы.Локаль);

КонецФункции

Функция СформироватьПараметрыПодключения()

	Возврат ОпцииПодключения.СформироватьПараметрыПодключения(ОпцииСУБД);

КонецФункции

#КонецОбласти
