// BSLLS:LineLength-off
// BSLLS:MissingVariablesDescription-off Поля &Опция/&НаборОпций - описания заданы в самой аннотации.
&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисЗапускаОбработок;

&Пластилин
Перем СервисЗаполненияПараметров;

&НаборОпций("НаборОпцийПодключения")
Перем ОпцииПодключения;

&НаборОпций("НаборОпцийПлатформы")
Перем ОпцииПлатформы;

&НаборОпций("НаборОпцийСУБД")
Перем ОпцииСУБД;

&Аргумент(Имя = "NAME", Описание = "Имя расширения, параметры которого нужно изменить (обязательно)")
&ТСтрока
Перем ИмяРасширения;

&Опция(Имя = "active", Описание = "Активность расширения (если не указано - не меняется)")
&ТПеречисление
&Перечисление(Имя = "true", Значение = "true", Описание = "Сделать расширение активным")
&Перечисление(Имя = "false", Значение = "false", Описание = "Сделать расширение неактивным")
Перем Активность;

&Опция(Имя = "safe-mode", Описание = "Безопасный режим (если не указано - не меняется)")
&ТПеречисление
&Перечисление(Имя = "true", Значение = "true", Описание = "Включить безопасный режим")
&Перечисление(Имя = "false", Значение = "false", Описание = "Выключить безопасный режим")
Перем БезопасныйРежим;

&Опция(Имя = "unsafe-action-protection", Описание = "Защита от опасных действий (если не указано - не меняется)")
&ТПеречисление
&Перечисление(Имя = "true", Значение = "true", Описание = "Включить защиту от опасных действий")
&Перечисление(Имя = "false", Значение = "false", Описание = "Выключить защиту от опасных действий")
Перем ЗащитаОтОпасныхДействий;

&Опция(Имя = "main-roles-for-all", Описание = "Использовать основные роли для всех пользователей, 8.3.15+ (если не указано - не меняется)")
&ТПеречисление
&Перечисление(Имя = "true", Значение = "true", Описание = "Включить использование основных ролей для всех пользователей")
&Перечисление(Имя = "false", Значение = "false", Описание = "Выключить использование основных ролей для всех пользователей")
Перем ОсновныеРолиДляВсех;

&ПодкомандаПриложения(Имя = "set-options", Родитель = "ПодкомандаInfobaseExtensions",
		Описание = "Изменить параметры установленного расширения по имени без его перезагрузки")
&ДоступноВMCP
&MCPРазрушающая
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);

	Если НЕ ЗначениеЗаполнено(ИмяРасширения) Тогда
		ВызватьИсключение "Не задано имя расширения (--extension-name)";
	КонецЕсли;

	Лог.Отладка("Начало выполнения команды infobase extensions set-options: %1", ИмяРасширения);

	ИзменяемыеПараметры = Новый Структура;
	ДобавитьЕслиЗадан(ИзменяемыеПараметры, "Активность", Активность);
	ДобавитьЕслиЗадан(ИзменяемыеПараметры, "БезопасныйРежим", БезопасныйРежим);
	ДобавитьЕслиЗадан(ИзменяемыеПараметры, "ЗащитаОтОпасныхДействий", ЗащитаОтОпасныхДействий);
	ДобавитьЕслиЗадан(ИзменяемыеПараметры, "ИспользоватьОсновныеРолиДляВсехПользователей", ОсновныеРолиДляВсех);

	Если ИзменяемыеПараметры.Количество() = 0 Тогда
		ВызватьИсключение "Не указан ни один изменяемый параметр (--active / --safe-mode / --unsafe-action-protection / --main-roles-for-all)";
	КонецЕсли;

	Параметры = Новый Структура;
	Параметры.Вставить("ТолькоУстановитьПараметрыРасширения", Истина);
	Параметры.Вставить("Имя", ИмяРасширения);
	Для Каждого Параметр Из ИзменяемыеПараметры Цикл
		Параметры.Вставить(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;

	СервисЗапускаОбработок.ВыполнитьОбработку(
		"РаботаСРасширениями",
		ОпцииПодключения.СформироватьПараметрыПодключения(ОпцииСУБД),
		Параметры,
		ОпцииПлатформы.СформироватьПараметрыПлатформы());

	Лог.Информация("Параметры расширения '%1' изменены", ИмяРасширения);

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьЕслиЗадан(Параметры, Знач Ключ, Знач Значение)

	Если ЗначениеЗаполнено(Значение) Тогда
		Параметры.Вставить(Ключ, Значение);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
