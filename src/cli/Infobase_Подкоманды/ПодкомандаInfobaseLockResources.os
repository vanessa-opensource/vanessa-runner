// BSLLS:LineLength-off
// BSLLS:NumberOfValuesInStructureConstructor-off
// BSLLS:MissingVariablesDescription-off Поля &Опция/&НаборОпций - описания заданы в самой аннотации.
&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисЗапускаОбработок;

&Пластилин
Перем СервисЗаполненияПараметров;

&НаборОпций("НаборОпцийПодключения")
Перем ОпцииПодключения;

&НаборОпций("НаборОпцийПлатформы")
Перем ОпцииПлатформы;

&НаборОпций("НаборОпцийСУБД")
Перем ОпцииСУБД;

&Опция(Имя = "allow", Описание = "Разрешить работу с внешними ресурсами")
&Флаговый
Перем Разрешить;

&Опция(Имя = "deny", Описание = "Запретить работу с внешними ресурсами")
&Флаговый
Перем Запретить;

&ПодкомандаПриложения(Имя = "lock-resources", Родитель = "КомандаInfobase",
		Описание = "Разрешить или запретить работу с внешними ресурсами (БСП)")
&ДоступноВMCP
&MCPРазрушающая
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);

	Если Разрешить = Запретить Тогда
		ВызватьИсключение "Необходимо указать ровно один из ключей --allow или --deny";
	КонецЕсли;

	Лог.Отладка("Начало выполнения команды infobase lock-resources (allow=%1, deny=%2)", Разрешить, Запретить);

	Параметры = Новый Структура;
	Если Разрешить Тогда
		Параметры.Вставить("РазрешитьРаботуСВнешнимиРесурсами", Истина);
	Иначе
		Параметры.Вставить("ЗапретитьРаботуСВнешнимиРесурсами", Истина);
	КонецЕсли;

	СервисЗапускаОбработок.ВыполнитьОбработку(
		"БлокировкаРаботыСВнешнимиРесурсами",
		СформироватьПараметрыПодключения(),
		Параметры,
		СформироватьПараметрыПлатформы());

	Лог.Информация("Режим работы с внешними ресурсами изменён");

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Функция СформироватьПараметрыПлатформы()

	Возврат Новый Структура(
		"ВерсияПлатформы, КодРазрешения, Язык, Локаль",
		ОпцииПлатформы.ВерсияПлатформы,
		ОпцииПлатформы.КодРазрешения,
		ОпцииПлатформы.Язык,
		ОпцииПлатформы.Локаль);

КонецФункции

Функция СформироватьПараметрыПодключения()

	Возврат ОпцииПодключения.СформироватьПараметрыПодключения(ОпцииСУБД);

КонецФункции

#КонецОбласти
