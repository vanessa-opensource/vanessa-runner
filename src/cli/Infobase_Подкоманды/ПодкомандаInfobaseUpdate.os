// BSLLS:LineLength-off
// BSLLS:NumberOfValuesInStructureConstructor-off
// BSLLS:UsingServiceTag-off
// BSLLS:MissingVariablesDescription-off Поля &Опция/&Аргумент/&НаборОпций - описания заданы в самой аннотации.
&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисПлатформы;

&Пластилин
Перем СервисКонфигурации;

&Пластилин
Перем СервисЗаполненияПараметров;

&НаборОпций("НаборОпцийПодключения")
Перем ОпцииПодключения;

&НаборОпций("НаборОпцийIbcmd")
Перем ОпцииIbcmd;

&НаборОпций("НаборОпцийПлатформы")
Перем ОпцииПлатформы;

&НаборОпций("НаборОпцийСУБД")
Перем ОпцииСУБД;

&Опция(Имя = "source", Описание = "Источник конфигурации (каталог исходников или *.cf файл)")
&ТСтрока
&ВОкружении("VRUNNER_SOURCE")
Перем Источник;

&Опция(Имя = "target", Описание = "Цель обновления: main - основная конфигурация, <имя> - расширение, пусто - всё")
&ТСтрока
Перем ЦельОбновления;

&Опция(Имя = "increment", Описание = "Инкрементальная загрузка по индексу изменений")
&Флаговый
Перем Инкремент;

&НаборОпций("НаборОпцийОбновленияБД")
Перем ОпцииОбновленияБД;

&НаборОпций("НаборОпцийНастроек")
Перем ОпцииНастроек; // BSLLS:UnusedLocalVariable-off

&ПодкомандаПриложения(Имя = "update", Родитель = "КомандаInfobase", Описание = "Обновление информационной базы")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);

	Лог.Отладка("Начало выполнения команды infobase update");

	ПараметрыПлатформыСтр = СформироватьПараметрыПлатформы();
	ПараметрыПодключения = СформироватьПараметрыПодключения();

	// 1. Проверка существования базы (для файловой ИБ)
	ПроверитьСуществованиеБазы(ПараметрыПодключения);

	// 2. Загрузка конфигурации из источника (необязательно)
	Если ЗначениеЗаполнено(Источник) Тогда
		ЗагрузитьИзИсточника(ПараметрыПодключения, ПараметрыПлатформыСтр);
	КонецЕсли;

	// TODO: Загрузка расширений (запланировано)

	// 3. Обновление конфигурации БД
	НастройкиОсновной = ОпцииОбновленияБД.СформироватьНастройкиОбновления();

	// Обновление основной конфигурации (при target=main или target=пусто)
	Если НЕ ЗначениеЗаполнено(ЦельОбновления) ИЛИ ЦельОбновления = "main" Тогда
		Лог.Информация("Обновление основной конфигурации БД (restr=%1)", НастройкиОсновной.РежимРеструктуризации);
		СервисПлатформы.ОбновитьКонфигурациюБД(
			ПараметрыПодключения,
			ОпцииIbcmd.ИспользоватьIbcmd,
			ПараметрыПлатформыСтр,
			НастройкиОсновной);
	КонецЕсли;

	// Обновление расширений (при target=пусто - все расширения; при target=<имя> - конкретное расширение)
	// BSLLS:IfElseIfEndsWithElse-off
	Если НЕ ЗначениеЗаполнено(ЦельОбновления) Тогда
		Лог.Информация("Обновление всех расширений БД");
		СервисПлатформы.ОбновитьКонфигурациюБД(
			ПараметрыПодключения,
			ОпцииIbcmd.ИспользоватьIbcmd,
			ПараметрыПлатформыСтр,
			Новый Структура("ОбновитьВсеРасширения", Истина));
	ИначеЕсли ЦельОбновления <> "main" Тогда
		Лог.Информация("Обновление расширения '%1' БД", ЦельОбновления);
		СервисПлатформы.ОбновитьКонфигурациюБД(
			ПараметрыПодключения,
			ОпцииIbcmd.ИспользоватьIbcmd,
			ПараметрыПлатформыСтр,
			Новый Структура("ИмяРасширения", ЦельОбновления));
	КонецЕсли;
	// BSLLS:IfElseIfEndsWithElse-on

	Лог.Информация("Обновление информационной базы завершено");

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Функция СформироватьПараметрыПлатформы()

	Возврат Новый Структура(
		"ВерсияПлатформы, КодРазрешения, Язык, Локаль",
		ОпцииПлатформы.ВерсияПлатформы,
		ОпцииПлатформы.КодРазрешения,
		ОпцииПлатформы.Язык,
		ОпцииПлатформы.Локаль);

КонецФункции

Функция СформироватьПараметрыПодключения()

	Возврат ОпцииПодключения.СформироватьПараметрыПодключения(ОпцииСУБД);

КонецФункции

Процедура ПроверитьСуществованиеБазы(ПараметрыПодключения)

	Если ПараметрыПодключения.Свойство("КаталогБазы")
		И ЗначениеЗаполнено(ПараметрыПодключения.КаталогБазы) Тогда
		Файл = Новый Файл(ПараметрыПодключения.КаталогБазы);
		Если НЕ Файл.Существует() Тогда
			ВызватьИсключение СтрШаблон(
				"Каталог информационной базы не найден: %1. Используйте 'infobase init' для создания базы.",
				ПараметрыПодключения.КаталогБазы);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ЗагрузитьИзИсточника(ПараметрыПодключения, ПараметрыПлатформыСтр)

	ТипИсточника = ОпределитьТипИсточника(Источник);

	Если ТипИсточника = "cf" Тогда
		Лог.Информация("Загрузка конфигурации из файла: %1", Источник);
		СервисКонфигурации.ЗагрузитьКонфигурациюИзФайла(
			ПараметрыПодключения,
			Источник,
			ОпцииIbcmd.ИспользоватьIbcmd,
			ПараметрыПлатформыСтр);

	ИначеЕсли ТипИсточника = "src" Тогда
		Лог.Информация("Загрузка конфигурации из исходников: %1", Источник);
		СервисКонфигурации.ЗагрузитьКонфигурациюИзФайлов(
			ПараметрыПодключения,
			Источник,
			ОпцииIbcmd.ИспользоватьIbcmd,
			ПараметрыПлатформыСтр,
			"",
			Инкремент);

	Иначе
		ВызватьИсключение СтрШаблон("Неподдерживаемый тип источника: %1", ТипИсточника);
	КонецЕсли;

КонецПроцедуры

Функция ОпределитьТипИсточника(Знач Путь)

	Файл = Новый Файл(Путь);
	Если Файл.Существует() И Файл.ЭтоКаталог() Тогда
		Возврат "src";
	КонецЕсли;

	Расширение = НРег(Файл.Расширение);
	Если Расширение = ".cf" Тогда
		Возврат "cf";
	КонецЕсли;

	ВызватьИсключение СтрШаблон("Не удалось определить тип источника: %1. Поддерживаются каталог исходников или *.cf файл.", Путь);

КонецФункции

#КонецОбласти
