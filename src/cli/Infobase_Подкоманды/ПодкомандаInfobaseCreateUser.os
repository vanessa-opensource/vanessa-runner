// BSLLS:LineLength-off
// BSLLS:NumberOfValuesInStructureConstructor-off
// BSLLS:UsingServiceTag-off
// BSLLS:MissingVariablesDescription-off Поля &Опция/&Аргумент/&НаборОпций - описания заданы в самой аннотации.
&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисЗапускаОбработок;

&Пластилин
Перем СервисЗаполненияПараметров;

&НаборОпций("НаборОпцийПодключения")
Перем ОпцииПодключения;

&НаборОпций("НаборОпцийПлатформы")
Перем ОпцииПлатформы;

&НаборОпций("НаборОпцийСУБД")
Перем ОпцииСУБД;

&Аргумент(Имя = "NAME", Описание = "Имя создаваемого пользователя")
&ТСтрока
Перем ИмяПользователя;

&Опция(Имя = "role", Описание = "Имя роли для назначения пользователю (можно указать несколько раз). По умолчанию: ПолныеПрава, АдминистраторСистемы")
&ТМассивСтрок
Перем РолиПользователя;

&ПодкомандаПриложения(Имя = "create-user", Родитель = "КомандаInfobase",
		Описание = "Создать пользователя в информационной базе с заданным набором ролей")
&ДоступноВMCP
&MCPРазрушающая
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);

	Если НЕ ЗначениеЗаполнено(ИмяПользователя) Тогда
		ВызватьИсключение "Не задано имя пользователя (аргумент NAME)";
	КонецЕсли;

	Роли = ПолучитьРоли();

	Лог.Отладка("Начало выполнения команды infobase create-user: %1 (роли: %2)",
		ИмяПользователя, СтрСоединить(Роли, ", "));

	ПараметрыПодключения = СформироватьПараметрыПодключения();
	ПараметрыПлатформы = СформироватьПараметрыПлатформы();

	Параметры = Новый Структура;
	Параметры.Вставить("Имя", ИмяПользователя);
	Параметры.Вставить("СоздатьАдминистратора", Истина);
	Параметры.Вставить("Роли", СтрСоединить(Роли, ","));

	СервисЗапускаОбработок.ВыполнитьОбработку(
		"СоздатьПользователей", ПараметрыПодключения, Параметры, ПараметрыПлатформы);

	Лог.Информация("Пользователь '%1' создан", ИмяПользователя);

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

// Возвращает набор имён ролей для назначения пользователю.
// Если роли не заданы ключами --role, используется набор по умолчанию
// (ПолныеПрава, АдминистраторСистемы) - как при создании администратора.
//
// Возвращаемое значение:
//   Массив из Строка - имена ролей для назначения пользователю.
Функция ПолучитьРоли()

	Если РолиПользователя = Неопределено ИЛИ РолиПользователя.Количество() = 0 Тогда
		Роли = Новый Массив;
		Роли.Добавить("ПолныеПрава");
		Роли.Добавить("АдминистраторСистемы");
		Возврат Роли;
	КонецЕсли;

	Возврат РолиПользователя;

КонецФункции

Функция СформироватьПараметрыПлатформы()

	Возврат Новый Структура(
		"ВерсияПлатформы, КодРазрешения, Язык, Локаль",
		ОпцииПлатформы.ВерсияПлатформы,
		ОпцииПлатформы.КодРазрешения,
		ОпцииПлатформы.Язык,
		ОпцииПлатформы.Локаль);

КонецФункции

Функция СформироватьПараметрыПодключения()

	Возврат ОпцииПодключения.СформироватьПараметрыПодключения(ОпцииСУБД);

КонецФункции

#КонецОбласти
