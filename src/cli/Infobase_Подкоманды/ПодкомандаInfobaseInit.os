// BSLLS:UsingServiceTag-off
// BSLLS:MissingVariablesDescription-off Поля &Опция/&Аргумент/&НаборОпций - описания заданы в самой аннотации.
// BSLLS:MissingParameterDescription-off Внутренние служебные методы команды.
// BSLLS:MissingReturnedValueDescription-off Внутренние служебные методы команды.
&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисПлатформы;

&Пластилин
Перем СервисКонфигурации;

&Пластилин
Перем СервисЗаполненияПараметров;

&Пластилин
Перем СервисРасчетаИнкремента;

&Пластилин
Перем СервисРасширений;

&Пластилин
Перем СервисПоискаИсточников;

&НаборОпций("НаборОпцийПодключения")
Перем ОпцииПодключения;

&НаборОпций("НаборОпцийIbcmd")
Перем ОпцииIbcmd;

&НаборОпций("НаборОпцийПлатформы")
Перем ОпцииПлатформы;

&НаборОпций("НаборОпцийСУБД")
Перем ОпцииСУБД;

&Опция(Имя = "src", Описание = "Источник конфигурации (каталог исходников, *.cf или *.dt файл)")
&ТСтрока
&ВОкружении("VRUNNER_SOURCE")
&Псевдоним("source")
Перем Источник;

&Опция(Имя = "ext",
		Описание = "Расширение для загрузки: .cfe-файл или каталог XML/EDT-исходников. Можно указать несколько раз")
&ТМассивСтрок
Перем Расширения;

&НаборОпций("НаборОпцийИсходников")
Перем ОпцииИсходников;

&НаборОпций("НаборОпцийНастроек")
Перем ОпцииНастроек; // BSLLS:UnusedLocalVariable-off

&Опция(Имя = "recursive",
		Описание = "Рекурсивно искать конфигурацию и расширения в каталогах --src и --ext (каждый путь - корень поиска).")
&Флаговый
Перем Рекурсивно;

&ПодкомандаПриложения(Имя = "init", Родитель = "КомандаInfobase", Описание = "Инициализация информационной базы")
&ДоступноВMCP
&MCPДлительная
&MCPРазрушающая
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);

	Лог.Отладка("Начало выполнения команды infobase init");

	Если Рекурсивно Тогда
		РазрешитьИсточникиРекурсивно();
	КонецЕсли;

	ЕстьСУБД = ЗначениеЗаполнено(ОпцииСУБД.ТипСУБД);
	СервернаяБаза = ЕстьСУБД ИЛИ ЭтоСервернаяСтрокаПодключения(ОпцииПодключения.СтрокаПодключения);
	КаталогБазы = ?(СервернаяБаза, "", КаталогФайловойБазы());

	ВывестиПланИнициализации(ЕстьСУБД, КаталогБазы);

	ПараметрыПлатформы = ОпцииПлатформы.СформироватьПараметрыПлатформы();
	ПараметрыПодключения = ОпцииПодключения.ПараметрыПодключенияЕслиЗаданы(ОпцииСУБД);

	Если ЕстьСУБД Тогда
		Лог.Информация("Создание серверной ИБ с использованием параметров СУБД");
	ИначеЕсли СервернаяБаза Тогда
		Лог.Информация("Используется существующая серверная ИБ: %1", ОпцииПодключения.СтрокаПодключения);
	Иначе
		УдалитьСуществующийКаталогБазы(КаталогБазы);
		ПараметрыПодключения = СервисПлатформы.СоздатьФайловуюБазу(
			КаталогБазы,
			ОпцииIbcmd.ИспользоватьIbcmd,
			ПараметрыПлатформы);
	КонецЕсли;

	Если ЗначениеЗаполнено(Источник) Тогда
		ЗагрузитьИзИсточника(ПараметрыПодключения, ПараметрыПлатформы);
	КонецЕсли;

	Если ЗначениеЗаполнено(Расширения) Тогда
		ЗагрузитьРасширения(ПараметрыПодключения, ПараметрыПлатформы);
	КонецЕсли;

	Лог.Информация("Инициализация информационной базы завершена");

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

// Заменяет значения опций --src и --ext найденными рекурсивным поиском источниками.
// Вызывается только при флаге --recursive.
//
// Семантика поиска:
//   --src - ищется И конфигурация, И расширения (найденные расширения добавляются к загрузке);
//   --ext - ищутся ТОЛЬКО расширения (источники конфигурации в этих каталогах игнорируются).
//
// После выполнения: Источник - конкретный путь к конфигурации (или ""),
//                   Расширения - список конкретных путей расширений.
Процедура РазрешитьИсточникиРекурсивно()

	СобранныеРасширения = Новый Массив;

	Если ЗначениеЗаполнено(Источник) Тогда
		Найдено = СервисПоискаИсточников.НайтиИсточники(Источник);
		СервисПоискаИсточников.ПроверитьОдинИсточникКонфигурации(Найдено.Конфигурации, Источник);
		Если Найдено.Конфигурации.Количество() = 1 Тогда
			Источник = Найдено.Конфигурации[0];
		Иначе
			Лог.Предупреждение("Рекурсивный поиск в ""%1"": источник конфигурации не найден", Источник);
			Источник = "";
		КонецЕсли;
		ДобавитьВсе(СобранныеРасширения, Найдено.Расширения);
	КонецЕсли;

	Если ЗначениеЗаполнено(Расширения) Тогда
		Для Каждого КаталогРасширений Из Расширения Цикл
			Найдено = СервисПоискаИсточников.НайтиИсточники(КаталогРасширений);
			ПредупредитьОИгнорируемыхКонфигурациях(КаталогРасширений, Найдено.Конфигурации);
			ДобавитьВсе(СобранныеРасширения, Найдено.Расширения);
		КонецЦикла;
	КонецЕсли;

	СервисПоискаИсточников.ПроверитьУникальностьИменРасширений(СобранныеРасширения);
	Расширения = СобранныеРасширения;

КонецПроцедуры

Процедура ДобавитьВсе(Приемник, Знач Элементы)
	Для Каждого Элемент Из Элементы Цикл
		Приемник.Добавить(Элемент);
	КонецЦикла;
КонецПроцедуры

Процедура ПредупредитьОИгнорируемыхКонфигурациях(Знач Каталог, Знач Конфигурации)
	КоличествоКонфигураций = Конфигурации.Количество();
	Если КоличествоКонфигураций > 0 Тогда
		Лог.Предупреждение(
			"В каталоге расширений ""%1"" обнаружены источники конфигурации (%2 шт.) - проигнорированы:"
			+ " --ext загружает только расширения.",
			Каталог, КоличествоКонфигураций);
	КонецЕсли;
КонецПроцедуры

// Вывести план инициализации: что и куда будет загружено.
//
// Параметры:
//   ЕстьСУБД    - Булево - серверная ИБ создаётся по параметрам СУБД
//   КаталогБазы - Строка - каталог файловой ИБ; пусто - серверная ИБ
//
Процедура ВывестиПланИнициализации(Знач ЕстьСУБД, Знач КаталогБазы)

	Лог.Информация("");
	Лог.Информация(РазделительПлана());
	Лог.Информация("  ПЛАН ИНИЦИАЛИЗАЦИИ ИНФОРМАЦИОННОЙ БАЗЫ");
	Лог.Информация(РазделительПлана());

	Если ЕстьСУБД Тогда
		Лог.Информация("  База данных :  серверная (СУБД %1)", ОпцииСУБД.ТипСУБД);
	ИначеЕсли ЗначениеЗаполнено(КаталогБазы) Тогда
		Лог.Информация("  База данных :  файловая (%1)", КаталогБазы);
	Иначе
		Лог.Информация("  База данных :  серверная, существующая (%1)", ОпцииПодключения.СтрокаПодключения);
	КонецЕсли;

	Если ЗначениеЗаполнено(Источник) Тогда
		Лог.Информация("  Конфигурация:  %1", Источник);
	Иначе
		Лог.Информация("  Конфигурация:  не задана (загрузка пропущена)");
	КонецЕсли;

	Если ЗначениеЗаполнено(Расширения) Тогда
		Лог.Информация("  Расширения  :  %1 шт.", Расширения.Количество());
		Для Каждого ПутьРасширения Из Расширения Цикл
			Лог.Информация("       • %1", ПутьРасширения);
		КонецЦикла;
	Иначе
		Лог.Информация("  Расширения  :  нет");
	КонецЕсли;

	Лог.Информация(РазделительПлана());
	Лог.Информация("");

КонецПроцедуры

Функция РазделительПлана()
	Возврат "──────────────────────────────────────────────────";
КонецФункции

// Строка подключения клиент-серверного варианта: /S"сервер\база".
Функция ЭтоСервернаяСтрокаПодключения(Знач СтрокаПодключения)

	Возврат ЗначениеЗаполнено(СтрокаПодключения) И СтрНачинаетсяС(НРег(СокрЛП(СтрокаПодключения)), "/s");

КонецФункции

// Каталог файловой ИБ: из строки подключения /F либо каталог по умолчанию.
Функция КаталогФайловойБазы()

	Если ЗначениеЗаполнено(ОпцииПодключения.СтрокаПодключения) Тогда
		Возврат КаталогИзФайловойСтрокиПодключения(ОпцииПодключения.СтрокаПодключения);
	КонецЕсли;

	Возврат ОпцииПодключения.КаталогФайловойБазыПоУмолчанию();

КонецФункции

// Каталог из строки подключения файлового варианта: /F"каталог".
Функция КаталогИзФайловойСтрокиПодключения(Знач СтрокаПодключения)

	Путь = СтрЗаменить(СтрокаПодключения, "/F", "");
	Путь = СтрЗаменить(Путь, """", "");
	Возврат Новый Файл(СокрЛП(Путь)).ПолноеИмя;

КонецФункции

Процедура УдалитьСуществующийКаталогБазы(Знач КаталогБазы)

	Если Новый Файл(КаталогБазы).Существует() Тогда
		Лог.Отладка("Удаление существующего каталога базы: %1", КаталогБазы);
		УдалитьФайлы(КаталогБазы);
	КонецЕсли;

КонецПроцедуры

Процедура ЗагрузитьИзИсточника(ПараметрыПодключения, ПараметрыПлатформы)

	ТипИсточника = СервисКонфигурации.ТипИсточника(Источник, Истина);

	Если ТипИсточника = "dt" Тогда
		Лог.Информация("Загрузка инфобазы из файла DT: %1", Источник); // BSLLS:Typo-off
		СервисПлатформы.ЗагрузитьИнфобазуИзФайла(
			ПараметрыПодключения,
			Источник,
			ОпцииIbcmd.ИспользоватьIbcmd,
			ПараметрыПлатформы);
		Возврат;
	КонецЕсли;

	Если ТипИсточника = "cf" Тогда
		Лог.Информация("Загрузка конфигурации из файла: %1", Источник);
		СервисКонфигурации.ЗагрузитьКонфигурациюИзФайла(
			ПараметрыПодключения,
			Источник,
			ОпцииIbcmd.ИспользоватьIbcmd,
			ПараметрыПлатформы);
	Иначе
		Лог.Информация("Загрузка конфигурации из исходников: %1", Источник);
		СервисКонфигурации.ЗагрузитьКонфигурациюИзФайлов(
			ПараметрыПодключения,
			Источник,
			ОпцииIbcmd.ИспользоватьIbcmd,
			ПараметрыПлатформы,
			"",
			Ложь,
			ОпцииИсходников.СформироватьПараметрыИсходников());
	КонецЕсли;

	СервисПлатформы.ОбновитьКонфигурациюБД(
		ПараметрыПодключения,
		ОпцииIbcmd.ИспользоватьIbcmd,
		ПараметрыПлатформы);

	Если ТипИсточника = "src" Тогда
		СервисРасчетаИнкремента.ПересоздатьИндекс(Источник, ПараметрыПодключения);
	КонецЕсли;

КонецПроцедуры

// Загружает все расширения, заданные опцией --ext, и применяет их к БД одним обновлением.
// Тип каждого источника (.cfe-файл или каталог XML/EDT-исходников) и имя расширения
// определяются автоматически по пути (см. СервисРасширений.ЗагрузитьРасширениеВБазу).
Процедура ЗагрузитьРасширения(ПараметрыПодключения, ПараметрыПлатформы)

	ПараметрыИсходников = ОпцииИсходников.СформироватьПараметрыИсходников();

	ИменаРасширений = Новый Массив;
	Для Каждого ПутьРасширения Из Расширения Цикл
		Лог.Информация("Загрузка расширения из источника: %1", ПутьРасширения);
		ИмяЗагруженного = СервисРасширений.ЗагрузитьРасширениеВБазу(
			ПараметрыПодключения,
			ПутьРасширения,
			"",
			ОпцииIbcmd.ИспользоватьIbcmd,
			ПараметрыПлатформы,
			Ложь,
			ПараметрыИсходников);
		ИменаРасширений.Добавить(ИмяЗагруженного);
	КонецЦикла;

	// Применяем загруженные расширения к конфигурации БД одним обновлением - до настройки свойств
	// (обработке в 1С:Предприятии нужно уже применённое к базе расширение).
	Лог.Информация("Обновление конфигурации БД для загруженных расширений");
	СервисПлатформы.ОбновитьКонфигурациюБД(
		ПараметрыПодключения,
		ОпцииIbcmd.ИспользоватьIbcmd,
		ПараметрыПлатформы,
		Новый Структура("ОбновитьВсеРасширения", Истина));

	// Конфигуратор не задаёт свойства расширения из командной строки - ставим документированные
	// дефолты обработкой РаботаСРасширениями (безопасный режим и защита от опасных действий выключены),
	// чтобы расширения были работоспособны сразу после init. В режиме ibcmd дефолты применяет сам ibcmd.
	Если НЕ ОпцииIbcmd.ИспользоватьIbcmd Тогда
		Для Каждого ИмяРасширения Из ИменаРасширений Цикл
			УстановитьДефолтныеСвойстваРасширения(ПараметрыПодключения, ИмяРасширения, ПараметрыПлатформы);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Процедура УстановитьДефолтныеСвойстваРасширения(ПараметрыПодключения, ИмяРасширения, ПараметрыПлатформы)

	Свойства = Новый Структура;
	Свойства.Вставить("БезопасныйРежим", "false");
	Свойства.Вставить("ЗащитаОтОпасныхДействий", "false");
	СервисРасширений.УстановитьПараметрыРасширенияЧерезОбработку(
		ПараметрыПодключения,
		ИмяРасширения,
		Свойства,
		ПараметрыПлатформы);

КонецПроцедуры

#КонецОбласти
