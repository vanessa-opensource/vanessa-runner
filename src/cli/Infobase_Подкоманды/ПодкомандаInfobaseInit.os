// BSLLS:NumberOfValuesInStructureConstructor-off
// BSLLS:UsingServiceTag-off
// BSLLS:MissingVariablesDescription-off Поля &Опция/&Аргумент/&НаборОпций - описания заданы в самой аннотации.
&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисПлатформы;

&Пластилин
Перем СервисКонфигурации;

&Пластилин
Перем СервисЗаполненияПараметров;

&Пластилин
Перем СервисРасчетаИнкремента;

&Пластилин
Перем СервисРасширений;

&НаборОпций("НаборОпцийПодключения")
Перем ОпцииПодключения;

&НаборОпций("НаборОпцийIbcmd")
Перем ОпцииIbcmd;

&НаборОпций("НаборОпцийПлатформы")
Перем ОпцииПлатформы;

&НаборОпций("НаборОпцийСУБД")
Перем ОпцииСУБД;

&Опция(Имя = "src", Описание = "Источник конфигурации (каталог исходников, *.cf или *.dt файл)")
&ТСтрока
&ВОкружении("VRUNNER_SOURCE")
&Псевдоним("source")
Перем Источник;

&Опция(Имя = "ext",
		Описание = "Расширение для загрузки: .cfe-файл или каталог XML/EDT-исходников. Можно указать несколько раз")
&ТМассивСтрок
Перем Расширения;

&НаборОпций("НаборОпцийИсходников")
Перем ОпцииИсходников;

&НаборОпций("НаборОпцийНастроек")
Перем ОпцииНастроек; // BSLLS:UnusedLocalVariable-off

&ПодкомандаПриложения(Имя = "init", Родитель = "КомандаInfobase", Описание = "Инициализация информационной базы")
&ДоступноВMCP
&MCPДлительная
&MCPРазрушающая
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);

	Лог.Отладка("Начало выполнения команды infobase init");

	ПараметрыПлатформыСтр = СформироватьПараметрыПлатформы();
	ПараметрыПодключения = СформироватьПараметрыПодключения();

	// 1. Создание базы
	Если ЕстьСУБД() Тогда
		Лог.Информация("Создание серверной ИБ с использованием параметров СУБД");
	Иначе
		КаталогБазы = КаталогФайловойБазы();
		ОбеспечитьКаталогБазы(КаталогБазы);
		ПараметрыПодключения = СервисПлатформы.СоздатьФайловуюБазу(
			КаталогБазы,
			ОпцииIbcmd.ИспользоватьIbcmd,
			ПараметрыПлатформыСтр);
	КонецЕсли;

	// 2. Загрузка конфигурации из источника
	Если ЗначениеЗаполнено(Источник) Тогда
		ЗагрузитьИзИсточника(ПараметрыПодключения, ПараметрыПлатформыСтр);
	КонецЕсли;

	// 3. Загрузка расширений
	Если ЗначениеЗаполнено(Расширения) Тогда
		ЗагрузитьРасширения(ПараметрыПодключения, ПараметрыПлатформыСтр);
	КонецЕсли;

	Лог.Информация("Инициализация информационной базы завершена");

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Функция СформироватьПараметрыПлатформы()

	Возврат Новый Структура(
		"ВерсияПлатформы, КодРазрешения, Язык, Локаль",
		ОпцииПлатформы.ВерсияПлатформы,
		ОпцииПлатформы.КодРазрешения,
		ОпцииПлатформы.Язык,
		ОпцииПлатформы.Локаль);

КонецФункции

Функция СформироватьПараметрыПодключения()

	Если ЗначениеЗаполнено(ОпцииПодключения.СтрокаПодключения) Тогда
		ПараметрыПодключения = Новый Структура(
			"СтрокаПодключения, Пользователь, Пароль",
			ОпцииПодключения.СтрокаПодключения,
			ОпцииПодключения.Пользователь,
			ОпцииПодключения.Пароль);
		ОпцииСУБД.ДополнитьПараметрыПодключения(ПараметрыПодключения);
		Возврат ПараметрыПодключения;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ЕстьСУБД()
	Возврат ЗначениеЗаполнено(ОпцииСУБД.ТипСУБД);
КонецФункции

Функция КаталогФайловойБазы()

	Если ЗначениеЗаполнено(ОпцииПодключения.СтрокаПодключения) Тогда
		Возврат ИзвлечьКаталогИзСтрокиПодключения(ОпцииПодключения.СтрокаПодключения);
	КонецЕсли;

	Файл = Новый Файл("build/ib");
	Возврат Файл.ПолноеИмя;

КонецФункции

Функция ИзвлечьКаталогИзСтрокиПодключения(Знач СтрокаПодключения)

	Путь = СтрокаПодключения;
	Путь = СтрЗаменить(Путь, "/F", "");
	Путь = СтрЗаменить(Путь, """", "");
	Путь = СокрЛП(Путь);
	Файл = Новый Файл(Путь);
	Возврат Файл.ПолноеИмя;

КонецФункции

Процедура ОбеспечитьКаталогБазы(КаталогБазы)

	Файл = Новый Файл(КаталогБазы);
	Если Файл.Существует() Тогда
		Лог.Отладка("Удаление существующего каталога базы: %1", КаталогБазы);
		УдалитьФайлы(КаталогБазы);
	КонецЕсли;

КонецПроцедуры

Процедура ЗагрузитьИзИсточника(ПараметрыПодключения, ПараметрыПлатформыСтр)

	ТипИсточника = ОпределитьТипИсточника(Источник);

	Если ТипИсточника = "dt" Тогда
		Лог.Информация("Загрузка инфобазы из файла DT: %1", Источник); // BSLLS:Typo-off
		СервисПлатформы.ЗагрузитьИнфобазуИзФайла(
			ПараметрыПодключения,
			Источник,
			ОпцииIbcmd.ИспользоватьIbcmd,
			ПараметрыПлатформыСтр);

	ИначеЕсли ТипИсточника = "cf" Тогда
		Лог.Информация("Загрузка конфигурации из файла: %1", Источник);
		СервисКонфигурации.ЗагрузитьКонфигурациюИзФайла(
			ПараметрыПодключения,
			Источник,
			ОпцииIbcmd.ИспользоватьIbcmd,
			ПараметрыПлатформыСтр);
		СервисПлатформы.ОбновитьКонфигурациюБД(
			ПараметрыПодключения,
			ОпцииIbcmd.ИспользоватьIbcmd,
			ПараметрыПлатформыСтр);

	ИначеЕсли ТипИсточника = "src" Тогда
		Лог.Информация("Загрузка конфигурации из исходников: %1", Источник);
		СервисКонфигурации.ЗагрузитьКонфигурациюИзФайлов(
			ПараметрыПодключения,
			Источник,
			ОпцииIbcmd.ИспользоватьIbcmd,
			ПараметрыПлатформыСтр,
			"",
			Ложь,
			ОпцииИсходников.СформироватьПараметрыИсходников());
		СервисПлатформы.ОбновитьКонфигурациюБД(
			ПараметрыПодключения,
			ОпцииIbcmd.ИспользоватьIbcmd,
			ПараметрыПлатформыСтр);
		СервисРасчетаИнкремента.ПересоздатьИндекс(Источник, ПараметрыПодключения);

	Иначе
		ВызватьИсключение СтрШаблон("Неподдерживаемый тип источника: %1", ТипИсточника);
	КонецЕсли;

КонецПроцедуры

// Загружает все расширения, заданные опцией --ext, и применяет их к БД одним обновлением.
// Тип каждого источника (.cfe-файл или каталог XML/EDT-исходников) и имя расширения
// определяются автоматически по пути (см. СервисРасширений.ЗагрузитьРасширениеВБазу).
Процедура ЗагрузитьРасширения(ПараметрыПодключения, ПараметрыПлатформыСтр)

	ПараметрыИсходников = ОпцииИсходников.СформироватьПараметрыИсходников();

	Для Каждого ПутьРасширения Из Расширения Цикл
		Лог.Информация("Загрузка расширения из источника: %1", ПутьРасширения);
		СервисРасширений.ЗагрузитьРасширениеВБазу(
			ПараметрыПодключения,
			ПутьРасширения,
			"",
			ОпцииIbcmd.ИспользоватьIbcmd,
			ПараметрыПлатформыСтр,
			Ложь,
			ПараметрыИсходников);
	КонецЦикла;

	// Применяем загруженные расширения к конфигурации БД одним обновлением.
	Лог.Информация("Обновление конфигурации БД для загруженных расширений");
	СервисПлатформы.ОбновитьКонфигурациюБД(
		ПараметрыПодключения,
		ОпцииIbcmd.ИспользоватьIbcmd,
		ПараметрыПлатформыСтр,
		Новый Структура("ОбновитьВсеРасширения", Истина));

КонецПроцедуры

Функция ОпределитьТипИсточника(Знач Путь)

	Файл = Новый Файл(Путь);
	Если Файл.Существует() И Файл.ЭтоКаталог() Тогда
		Возврат "src";
	КонецЕсли;

	Расширение = НРег(Файл.Расширение);
	Если Расширение = ".cf" Тогда
		Возврат "cf";
	ИначеЕсли Расширение = ".dt" Тогда
		Возврат "dt";
	Иначе
		ВызватьИсключение СтрШаблон("Не удалось определить тип источника: %1", Путь);
	КонецЕсли;

КонецФункции

#КонецОбласти
