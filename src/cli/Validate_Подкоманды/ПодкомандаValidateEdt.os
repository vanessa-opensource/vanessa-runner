// BSLLS:MissingVariablesDescription-off Поля &Опция/&Аргумент/&НаборОпций - описания заданы в самой аннотации.
// BSLLS:UnusedLocalVariable-off Поля &Опция/&Лог инициализируются autumn-фреймворком через рефлексию.
// BSLLS:MissingParameterDescription-off Внутренние служебные методы команды.
// BSLLS:MissingReturnedValueDescription-off Внутренние служебные методы команды.
// BSLLS:MagicNumber-off Ранги уровней важности (см. функции Ранг*).
// BSLLS:Typo-off Подстроки уровней важности EDT ("критич"/"значительн").
&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисEDT;

&Пластилин
Перем СервисЗаполненияПараметров;

&Пластилин
Перем СервисОкружения;

&Опция(Имя = "src s", Описание = "Каталог EDT-проекта (по умолчанию - текущий каталог)")
&ТСтрока
&ВОкружении("VRUNNER_SRC")
Перем КаталогИсходников;

&Опция(Имя = "min-severity", Описание = "Минимальный уровень замечаний, при котором команда завершается с ошибкой")
&ТПеречисление
&Перечисление(Имя = "critical", Значение = "critical", Описание = "только критические")
&Перечисление(Имя = "major", Значение = "major", Описание = "значительные и критические (по умолчанию)")
&Перечисление(Имя = "minor", Значение = "minor", Описание = "все замечания, включая незначительные")
&Перечисление(Имя = "none", Значение = "none", Описание = "не завершать с ошибкой, только отчёт")
&ПоУмолчанию("major")
Перем МинимальныйУровень;

&Опция(Имя = "report",
		Описание = "Файл результатов в исходном формате 1С:EDT (устарела: --report-format edt --report-path <файл>)")
&ТСтрока
&ВОкружении("VRUNNER_EDT_REPORT")
Перем ПутьОтчетаEDT;

&НаборОпций("НаборОпцийОтчетов")
Перем ОпцииОтчетов;

&Опция(Имя = "junitpath",
	Описание = "Путь к файлу отчёта JUnit XML (устарела: --report-format junit --report-path <путь>)")
&ТСтрока
&ВОкружении("VRUNNER_JUNITPATH")
Перем ПутьОтчетаJUnit;

&Опция(Имя = "allure-results",
	Описание = "Каталог результатов Allure 2 (устарела: --report-format allure --report-path <каталог>)")
&ТСтрока
&ВОкружении("VRUNNER_ALLURE_RESULTS")
Перем КаталогРезультатовAllure;

&Опция(Имя = "testsuitename", Описание = "Имя тестового набора в отчёте JUnit")
&ТСтрока
&ПоУмолчанию("edt")
Перем ИмяТестовогоНабора;

&НаборОпций("НаборОпцийИсходников")
Перем ОпцииИсходников;

&НаборОпций("НаборОпцийНастроек")
Перем ОпцииНастроек; // BSLLS:UnusedLocalVariable-off

&ПодкомандаПриложения(Имя = "edt", Родитель = "КомандаValidate", Описание = "Проверка проекта в EDT")
&ДоступноВMCP
&MCPДлительная
&MCPТолькоЧтение
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);

	КаталогSrc = СервисОкружения.ПутьИлиРабочийКаталог(КаталогИсходников);
	Лог.Отладка("Начало выполнения команды validate edt");
	Лог.Отладка("Каталог EDT-проекта: %1", КаталогSrc);

	ПараметрыИсходников = ОпцииИсходников.СформироватьПараметрыИсходников();

	Отчеты = ПолучитьОтчеты();
	ОпцииОтчетов.ПодготовитьКаталоги(Отчеты, ОпцииОтчетов.ФорматыКаталогов());

	ДатаНачала = ТекущаяУниверсальнаяДата();
	Замечания = СервисEDT.Проверить(КаталогSrc, ПараметрыИсходников,
		ОпцииОтчетов.ПутьОтчета(Отчеты, ОпцииОтчетов.ФорматEDT()));
	ДлительностьСек = ТекущаяУниверсальнаяДата() - ДатаНачала;
	Лог.Информация("Проверка EDT завершена за %1с", Окр(ДлительностьСек));

	ПорогОшибки = ПорогУровня(МинимальныйУровень);
	БлокирующиеЗамечания = ОтобратьПоПорогу(Замечания, ПорогОшибки);

	ВывестиОтчет(Замечания, БлокирующиеЗамечания);

	Для Каждого Отчет Из Отчеты Цикл
		Если Отчет.Формат = ОпцииОтчетов.ФорматEDT() Тогда
			Продолжить; // сырой файл уже написал сам 1cedtcli
		ИначеЕсли Отчет.Формат = ОпцииОтчетов.ФорматAllure() Тогда
			СформироватьОтчетAllure(Отчет.Путь, Замечания, ПорогОшибки, ДатаНачала, ДлительностьСек);
		Иначе
			СформироватьОтчетJUnit(Отчет.Путь, Замечания, ПорогОшибки, ДлительностьСек);
		КонецЕсли;
	КонецЦикла;

	Если БлокирующиеЗамечания.Количество() > 0 Тогда
		ВызватьИсключение СтрШаблон(
			"Проверка EDT: обнаружены блокирующие замечания (уровень >= %1): %2.",
			МинимальныйУровень, БлокирующиеЗамечания.Количество());
	КонецЕсли;

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

// Ранги важности замечаний EDT: выше - серьёзнее.

Функция РангКритический()
	Возврат 3;
КонецФункции

Функция РангЗначительный()
	Возврат 2;
КонецФункции

Функция РангНезначительный()
	Возврат 1;
КонецФункции

// Порог, которого не достигает ни одно замечание: --min-severity none.
Функция РангНедостижимый()
	Возврат 999;
КонецФункции

// Порог-ранг по значению опции --min-severity (выше - строже).
Функция ПорогУровня(Знач Уровень)
	Если Уровень = "critical" Тогда
		Возврат РангКритический();
	ИначеЕсли Уровень = "minor" Тогда
		Возврат РангНезначительный();
	ИначеЕсли Уровень = "none" Тогда
		Возврат РангНедостижимый();
	Иначе
		Возврат РангЗначительный(); // major (по умолчанию)
	КонецЕсли;
КонецФункции

// Ранг важности замечания EDT; неизвестный уровень трактуется как значительный.
Функция РангВажности(Знач Важность)
	Норм = НРег(СокрЛП(Строка(Важность)));
	Если СтрНайти(Норм, "критич") > 0 Тогда
		Возврат РангКритический();
	ИначеЕсли СтрНайти(Норм, "незначительн") > 0 Тогда
		Возврат РангНезначительный();
	Иначе
		Возврат РангЗначительный();
	КонецЕсли;
КонецФункции

Функция ОтобратьПоПорогу(Знач Замечания, Знач Порог)
	Результат = Новый Массив;
	Для Каждого Замечание Из Замечания Цикл
		Если РангВажности(Замечание.Важность) >= Порог Тогда
			Результат.Добавить(Замечание);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура ВывестиОтчет(Знач Замечания, Знач БлокирующиеЗамечания)

	Если Замечания.Количество() = 0 Тогда
		Лог.Информация("Проверка EDT: замечаний не обнаружено");
		Возврат;
	КонецЕсли;

	Лог.Информация("Проверка EDT: всего замечаний %1, из них блокирующих %2",
		Замечания.Количество(), БлокирующиеЗамечания.Количество());

	Для Каждого Замечание Из Замечания Цикл
		Лог.Предупреждение("  [%1] %2: %3 - %4 (%5)",
			Замечание.Важность, Замечание.Категория, Замечание.Объект,
			Замечание.Описание, Замечание.Место);
	КонецЦикла;

КонецПроцедуры

Процедура СформироватьОтчетJUnit(Знач ПутьОтчета, Знач Замечания, Знач Порог, Знач ДлительностьСек)

	Лог.Информация("Генерация отчёта JUnit: %1", ПутьОтчета);

	Генератор = Новый ГенераторОтчетаJUnit(ИмяТестовогоНабора);

	Случаи = Новый Массив;
	Для Каждого Замечание Из Замечания Цикл
		Случай = Генератор.НовыйСлучай(СтрШаблон("%1: %2", Замечание.Объект, Замечание.Описание),
			СтрШаблон("%1.%2", ИмяТестовогоНабора, Замечание.Категория));
		Случай.Провален = РангВажности(Замечание.Важность) >= Порог;
		Случай.Сообщение = СтрШаблон("[%1] %2 (%3)",
			Замечание.Важность, Замечание.Описание, Замечание.Место);
		Случаи.Добавить(Случай);
	КонецЦикла;

	ОпцииОтчетов.ЗаписатьОтчетJUnit(Генератор, ПутьОтчета, Случаи, ДлительностьСек, ИмяУспешнойПроверки());

КонецПроцедуры

Процедура СформироватьОтчетAllure(Знач КаталогРезультатов, Знач Замечания, Знач Порог,
		Знач ДатаНачала, Знач ДлительностьСек)

	Лог.Информация("Генерация результатов Allure: %1", КаталогРезультатов);

	Генератор = Новый ГенераторОтчетаAllure(ИмяТестовогоНабора);

	Случаи = Новый Массив;
	Для Каждого Замечание Из Замечания Цикл
		// Блокирующее замечание валит сборку - это failed; остальные показываем как broken:
		// они найдены и должны быть видны в отчёте, но по --min-severity сборку не роняют.
		Ранг = РангВажности(Замечание.Важность);
		Статус = ?(Ранг >= Порог, "failed", "broken");
		Случай = Генератор.НовыйСлучай(СтрШаблон("%1: %2", Замечание.Объект, Замечание.Описание), Статус);
		Случай.Сообщение = СтрШаблон("[%1] %2 (%3)",
			Замечание.Важность, Замечание.Описание, Замечание.Место);
		Случай.Пакет = Замечание.Категория;
		Случай.Важность = ВажностьAllure(Ранг);
		Случаи.Добавить(Случай);
	КонецЦикла;

	ОпцииОтчетов.ЗаписатьРезультатыAllure(Генератор, КаталогРезультатов, Случаи, ДатаНачала, ДлительностьСек,
		ИмяУспешнойПроверки());

КонецПроцедуры

Функция ИмяУспешнойПроверки()
	Возврат "Проверка EDT-проекта";
КонецФункции

// Форматы отчёта проверки EDT, словарь закрыт: junit и allure формирует сам vrunner из разобранных
// замечаний, а edt - сырой файл результатов 1cedtcli (он создаётся всегда, без опции - во временном
// файле; формат edt лишь оставляет его по указанному пути).
// Значение - имя файла или каталога внутри --report-path, когда форматов несколько.
Функция ДопустимыеФорматыОтчетов()

	Форматы = Новый Соответствие;
	Форматы.Вставить(ОпцииОтчетов.ФорматJUnit(), "junit.xml");
	Форматы.Вставить(ОпцииОтчетов.ФорматAllure(), ОпцииОтчетов.ФорматAllure());
	Форматы.Вставить(ОпцииОтчетов.ФорматEDT(), "edt-validate.tsv");

	Возврат Форматы;

КонецФункции

// Список формируемых отчётов: устаревшие опции команды плюс общая пара --report-format/--report-path.
Функция ПолучитьОтчеты()

	ФорматJUnit = ОпцииОтчетов.ФорматJUnit();
	ФорматAllure = ОпцииОтчетов.ФорматAllure();
	ФорматEDT = ОпцииОтчетов.ФорматEDT();

	Устаревшие = Новый Массив;
	Устаревшие.Добавить(ОпцииОтчетов.УстаревшийОтчет("--junitpath", ФорматJUnit, ПутьОтчетаJUnit));
	Устаревшие.Добавить(ОпцииОтчетов.УстаревшийОтчет("--allure-results", ФорматAllure, КаталогРезультатовAllure));
	Устаревшие.Добавить(ОпцииОтчетов.УстаревшийОтчет("--report", ФорматEDT, ПутьОтчетаEDT));

	Возврат ОпцииОтчетов.СобратьОтчеты(ДопустимыеФорматыОтчетов(), ФорматJUnit, Устаревшие);

КонецФункции

// Важность Allure (severity) по рангу замечания EDT.
Функция ВажностьAllure(Знач Ранг)

	Если Ранг = РангКритический() Тогда
		Возврат "critical";
	ИначеЕсли Ранг = РангНезначительный() Тогда
		Возврат "minor";
	Иначе
		Возврат "normal";
	КонецЕсли;

КонецФункции

#КонецОбласти
