// BSLLS:NumberOfValuesInStructureConstructor-off
// BSLLS:MissingVariablesDescription-off Поля &Опция/&Аргумент/&НаборОпций - описания заданы в самой аннотации.
// BSLLS:UnusedLocalVariable-off Поля &Опция/&Лог инициализируются autumn-фреймворком через рефлексию.
// BSLLS:MissingParameterDescription-off Внутренние служебные методы команды.
// BSLLS:MissingReturnedValueDescription-off Внутренние служебные методы команды.
// BSLLS:MagicNumber-off Ранги уровней важности (см. опцию --min-severity).
// BSLLS:Typo-off Подстроки уровней важности EDT ("критич"/"значительн").
// BSLLS:DuplicateStringLiteral-off Имена атрибутов JUnit ("name" и т.п.).
// Команда `validate edt` - проверка EDT-проекта штатной проверкой 1С:EDT (1cedtcli validate).
// Запускает проверку через СервисEDT, разбирает .tsv-замечания, печатает отчёт,
// при необходимости сохраняет исходный отчёт EDT (--report) и/или формирует JUnit (--junitpath)
// и завершается с ошибкой при замечаниях нужного уровня.
&Лог("vrunner")
Перем Лог;

&Пластилин
Перем ФайловыеОперации;

&Пластилин
Перем СервисEDT;

&Пластилин
Перем СервисЗаполненияПараметров;

&Опция(Имя = "s src", Описание = "Каталог EDT-проекта (по умолчанию - текущий каталог)")
&ТСтрока
&ВОкружении("VRUNNER_SRC")
Перем КаталогИсходников;

&Опция(Имя = "min-severity", Описание = "Минимальный уровень замечаний, при котором команда завершается с ошибкой")
&ТПеречисление
&Перечисление(Имя = "critical", Значение = "critical", Описание = "только критические")
&Перечисление(Имя = "major", Значение = "major", Описание = "значительные и критические (по умолчанию)")
&Перечисление(Имя = "minor", Значение = "minor", Описание = "все замечания, включая незначительные")
&Перечисление(Имя = "none", Значение = "none", Описание = "не завершать с ошибкой, только отчёт")
&ПоУмолчанию("major")
Перем МинимальныйУровень;

&Опция(Имя = "report",
		Описание = "Файл результатов в исходном формате 1С:EDT (устарела: --report-format edt --report-path <файл>)")
&ТСтрока
&ВОкружении("VRUNNER_EDT_REPORT")
Перем ПутьОтчетаEDT;

&НаборОпций("НаборОпцийОтчетов")
Перем ОпцииОтчетов;

&Опция(Имя = "junitpath",
	Описание = "Путь к файлу отчёта JUnit XML (устарела: --report-format junit --report-path <путь>)")
&ТСтрока
&ВОкружении("VRUNNER_JUNITPATH")
Перем ПутьОтчетаJUnit;

&Опция(Имя = "allure-results",
	Описание = "Каталог результатов Allure 2 (устарела: --report-format allure --report-path <каталог>)")
&ТСтрока
&ВОкружении("VRUNNER_ALLURE_RESULTS")
Перем КаталогРезультатовAllure;

&Опция(Имя = "testsuitename", Описание = "Имя тестового набора в отчёте JUnit")
&ТСтрока
&ПоУмолчанию("edt")
Перем ИмяТестовогоНабора;

&НаборОпций("НаборОпцийИсходников")
Перем ОпцииИсходников;

&НаборОпций("НаборОпцийНастроек")
Перем ОпцииНастроек; // BSLLS:UnusedLocalVariable-off

&ПодкомандаПриложения(Имя = "edt", Родитель = "КомандаValidate", Описание = "Проверка проекта в EDT")
&ДоступноВMCP
&MCPДлительная
&MCPТолькоЧтение
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);

	КаталогSrc = КаталогИсходниковИлиТекущий();
	Лог.Отладка("Начало выполнения команды validate edt");
	Лог.Отладка("Каталог EDT-проекта: %1", КаталогSrc);

	ПараметрыИсходников = ОпцииИсходников.СформироватьПараметрыИсходников();

	Отчеты = ПолучитьОтчеты();

	// Каталоги отчётов создаём до проверки: она может идти минутами, и падение
	// на записи отчёта в конце обесценивает весь прогон (issue #746).
	ПодготовитьКаталогиОтчетов(Отчеты);

	ДатаНачала = ТекущаяУниверсальнаяДата();
	Замечания = СервисEDT.Проверить(КаталогSrc, ПараметрыИсходников,
		ПутьОтчетаФормата(Отчеты, ФорматEDT()));
	ДлительностьСек = ТекущаяУниверсальнаяДата() - ДатаНачала;
	Лог.Информация("Проверка EDT завершена за %1с", Окр(ДлительностьСек));

	ПорогОшибки = ПорогУровня(МинимальныйУровень);
	БлокирующиеЗамечания = ОтобратьПоПорогу(Замечания, ПорогОшибки);

	ВывестиОтчет(Замечания, БлокирующиеЗамечания);

	Для Каждого Отчет Из Отчеты Цикл
		Если Отчет.Формат = ФорматEDT() Тогда
			Продолжить; // сырой файл уже написал сам 1cedtcli
		ИначеЕсли Отчет.Формат = ФорматAllure() Тогда
			СформироватьОтчетAllure(Отчет.Путь, Замечания, ПорогОшибки, ДатаНачала, ДлительностьСек);
		Иначе
			СформироватьОтчетJUnit(Отчет.Путь, Замечания, ПорогОшибки, ДлительностьСек);
		КонецЕсли;
	КонецЦикла;

	Если БлокирующиеЗамечания.Количество() > 0 Тогда
		ВызватьИсключение СтрШаблон(
			"Проверка EDT: обнаружены блокирующие замечания (уровень >= %1): %2.",
			МинимальныйУровень, БлокирующиеЗамечания.Количество());
	КонецЕсли;

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Функция КаталогИсходниковИлиТекущий()
	Если ЗначениеЗаполнено(КаталогИсходников) Тогда
		Возврат КаталогИсходников;
	КонецЕсли;
	Возврат ТекущийКаталог();
КонецФункции

// Порог-ранг по значению опции --min-severity (выше - строже).
Функция ПорогУровня(Знач Уровень)
	Если Уровень = "critical" Тогда
		Возврат 3;
	ИначеЕсли Уровень = "minor" Тогда
		Возврат 1;
	ИначеЕсли Уровень = "none" Тогда
		Возврат 999; // никогда не блокировать
	Иначе
		Возврат 2; // major (по умолчанию)
	КонецЕсли;
КонецФункции

// Ранг важности замечания EDT: критическая=3, значительная=2, незначительная=1, иначе=2.
Функция РангВажности(Знач Важность)
	Норм = НРег(СокрЛП(Строка(Важность)));
	Если СтрНайти(Норм, "критич") > 0 Тогда
		Возврат 3;
	ИначеЕсли СтрНайти(Норм, "незначительн") > 0 Тогда
		Возврат 1;
	Иначе
		// значительная либо неизвестный уровень - трактуем как значительный
		Возврат 2;
	КонецЕсли;
КонецФункции

Функция ОтобратьПоПорогу(Знач Замечания, Знач Порог)
	Результат = Новый Массив;
	Для Каждого Замечание Из Замечания Цикл
		Если РангВажности(Замечание.Важность) >= Порог Тогда
			Результат.Добавить(Замечание);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура ВывестиОтчет(Знач Замечания, Знач БлокирующиеЗамечания)

	Если Замечания.Количество() = 0 Тогда
		Лог.Информация("Проверка EDT: замечаний не обнаружено");
		Возврат;
	КонецЕсли;

	Лог.Информация("Проверка EDT: всего замечаний %1, из них блокирующих %2",
		Замечания.Количество(), БлокирующиеЗамечания.Количество());

	Для Каждого Замечание Из Замечания Цикл
		Лог.Предупреждение("  [%1] %2: %3 - %4 (%5)",
			Замечание.Важность, Замечание.Категория, Замечание.Объект,
			Замечание.Описание, Замечание.Место);
	КонецЦикла;

КонецПроцедуры

Процедура СформироватьОтчетJUnit(Знач ПутьОтчета, Знач Замечания, Знач Порог, Знач ДлительностьСек)

	Лог.Информация("Генерация отчёта JUnit: %1", ПутьОтчета);

	БлокирующихКоличество = ОтобратьПоПорогу(Замечания, Порог).Количество();
	КоличествоТестов = ?(Замечания.Количество() > 0, Замечания.Количество(), 1);

	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ПутьОтчета);
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	ЗаписьXML.ЗаписатьНачалоЭлемента("testsuites");

	ЗаписьXML.ЗаписатьНачалоЭлемента("testsuite");
	ЗаписьXML.ЗаписатьАтрибут("name", ИмяТестовогоНабора);
	ЗаписьXML.ЗаписатьАтрибут("tests", XMLСтрока(КоличествоТестов));
	ЗаписьXML.ЗаписатьАтрибут("failures", XMLСтрока(БлокирующихКоличество));
	ЗаписьXML.ЗаписатьАтрибут("time", XMLСтрока(ДлительностьСек));

	Если Замечания.Количество() = 0 Тогда
		ЗаписьXML.ЗаписатьНачалоЭлемента("testcase");
		ЗаписьXML.ЗаписатьАтрибут("name", "Проверка EDT-проекта");
		ЗаписьXML.ЗаписатьАтрибут("classname", ИмяТестовогоНабора);
		ЗаписьXML.ЗаписатьКонецЭлемента();
	Иначе
		Для Каждого Замечание Из Замечания Цикл
			ИмяСлучая = СтрШаблон("%1: %2", Замечание.Объект, Замечание.Описание);
			ЗаписьXML.ЗаписатьНачалоЭлемента("testcase");
			ЗаписьXML.ЗаписатьАтрибут("name", ИмяСлучая);
			ЗаписьXML.ЗаписатьАтрибут("classname", СтрШаблон("%1.%2", ИмяТестовогоНабора, Замечание.Категория));
			Если РангВажности(Замечание.Важность) >= Порог Тогда
				СообщениеОшибки = СтрШаблон("[%1] %2 (%3)",
					Замечание.Важность, Замечание.Описание, Замечание.Место);
				ЗаписьXML.ЗаписатьНачалоЭлемента("failure");
				ЗаписьXML.ЗаписатьАтрибут("message", СообщениеОшибки);
				ЗаписьXML.ЗаписатьКонецЭлемента();
			КонецЕсли;
			ЗаписьXML.ЗаписатьКонецЭлемента();
		КонецЦикла;
	КонецЕсли;

	ЗаписьXML.ЗаписатьКонецЭлемента(); // testsuite
	ЗаписьXML.ЗаписатьКонецЭлемента(); // testsuites
	ЗаписьXML.Закрыть();

	Лог.Информация("Отчёт JUnit сохранён: %1", ПутьОтчета);

КонецПроцедуры

// Результаты Allure - это каталог с файлом на каждый тест-кейс, а не один файл отчёта,
// поэтому здесь путь всегда каталог.
Процедура СформироватьОтчетAllure(Знач КаталогРезультатов, Знач Замечания, Знач Порог,
		Знач ДатаНачала, Знач ДлительностьСек)

	Лог.Информация("Генерация результатов Allure: %1", КаталогРезультатов);

	Генератор = Новый ГенераторОтчетаAllure(ИмяТестовогоНабора);

	Случаи = Новый Массив;
	Для Каждого Замечание Из Замечания Цикл
		// Блокирующее замечание валит сборку - это failed; остальные показываем как broken:
		// они найдены и должны быть видны в отчёте, но по --min-severity сборку не роняют.
		Статус = ?(РангВажности(Замечание.Важность) >= Порог, "failed", "broken");
		Случай = Генератор.НовыйСлучай(СтрШаблон("%1: %2", Замечание.Объект, Замечание.Описание), Статус);
		Случай.Сообщение = СтрШаблон("[%1] %2 (%3)",
			Замечание.Важность, Замечание.Описание, Замечание.Место);
		Случай.Пакет = Замечание.Категория;
		Случай.Важность = ВажностьAllure(Замечание.Важность);
		Случаи.Добавить(Случай);
	КонецЦикла;

	// Успешную проверку тоже показываем кейсом: пустой каталог результатов Allure
	// неотличим от прогона, который до отчёта не дошёл.
	Если Случаи.Количество() = 0 Тогда
		Случаи.Добавить(Генератор.НовыйСлучай("Проверка EDT-проекта", "passed"));
	КонецЕсли;

	Записано = Генератор.Записать(КаталогРезультатов, Случаи, ДатаНачала, ДлительностьСек);

	Лог.Информация("Результаты Allure сохранены: %1, файлов: %2", КаталогРезультатов, Записано);

КонецПроцедуры

// Форматы отчёта проверки EDT, словарь закрыт.
//
// junit и allure формирует сам vrunner из разобранных замечаний, а edt - это сырой файл
// результатов, который пишет 1cedtcli: он создаётся в любом случае (без опции - во временном
// файле), и запрошенный формат edt просто оставляет его по указанному пути.
//
// Значение - имя файла или каталога внутри --report-path, когда форматов несколько.
//
// Возвращаемое значение:
//   Соответствие - формат -> имя по умолчанию
//
Функция ДопустимыеФорматыОтчетов()

	Форматы = Новый Соответствие;
	Форматы.Вставить(ФорматJUnit(), "junit.xml");
	Форматы.Вставить(ФорматAllure(), ФорматAllure());
	Форматы.Вставить(ФорматEDT(), "edt-validate.tsv");

	Возврат Форматы;

КонецФункции

// Список формируемых отчётов: устаревшие опции и общая пара --report-format/--report-path
// складываются, при совпадении формата побеждает общая пара. Молча терять отчёт, заданный
// устаревшей опцией, нельзя - в переходный период их держат вперемешку (одно в настройках,
// другое в командной строке).
Функция ПолучитьОтчеты()

	Отчеты = ОтчетыИзУстаревшихОпций();

	Если ОпцииОтчетов.Задан() Тогда
		Для Каждого Отчет Из ОпцииОтчетов.СформироватьОтчеты(ДопустимыеФорматыОтчетов(), ФорматJUnit()) Цикл
			ДобавитьОтчет(Отчеты, Отчет.Формат, Отчет.Путь);
		КонецЦикла;
	КонецЕсли;

	// Писать отчёт некуда - это ошибка настройки, а не повод молча пропустить выгрузку.
	Для Каждого Отчет Из Отчеты Цикл
		Если НЕ ЗначениеЗаполнено(Отчет.Путь) Тогда
			ВызватьИсключение СтрШаблон(
				"Не задан путь отчёта формата ""%1"": укажите --report-path", Отчет.Формат);
		КонецЕсли;
	КонецЦикла;

	Возврат Отчеты;

КонецФункции

// Добавить отчёт в список; повторное указание формата перекрывает предыдущее.
Процедура ДобавитьОтчет(Отчеты, Знач Формат, Знач Путь)

	Для Каждого Отчет Из Отчеты Цикл
		Если Отчет.Формат = Формат Тогда
			Отчет.Путь = Путь;
			Возврат;
		КонецЕсли;
	КонецЦикла;

	Отчеты.Добавить(Новый Структура("Формат, Путь", Формат, Путь));

КонецПроцедуры

// Путь отчёта заданного формата; пустая строка, если такой отчёт не запрошен.
Функция ПутьОтчетаФормата(Знач Отчеты, Знач Формат)

	Для Каждого Отчет Из Отчеты Цикл
		Если Отчет.Формат = Формат Тогда
			Возврат Отчет.Путь;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция ОтчетыИзУстаревшихОпций()

	Отчеты = Новый Массив;

	Если ЗначениеЗаполнено(ПутьОтчетаJUnit) Тогда
		ПредупредитьОбУстаревшейОпции("--junitpath", ФорматJUnit(), ПутьОтчетаJUnit);
		Отчеты.Добавить(Новый Структура("Формат, Путь", ФорматJUnit(), ПутьОтчетаJUnit));
	КонецЕсли;

	Если ЗначениеЗаполнено(КаталогРезультатовAllure) Тогда
		ПредупредитьОбУстаревшейОпции("--allure-results", ФорматAllure(), КаталогРезультатовAllure);
		Отчеты.Добавить(Новый Структура("Формат, Путь", ФорматAllure(), КаталогРезультатовAllure));
	КонецЕсли;

	Если ЗначениеЗаполнено(ПутьОтчетаEDT) Тогда
		ПредупредитьОбУстаревшейОпции("--report", ФорматEDT(), ПутьОтчетаEDT);
		Отчеты.Добавить(Новый Структура("Формат, Путь", ФорматEDT(), ПутьОтчетаEDT));
	КонецЕсли;

	Возврат Отчеты;

КонецФункции

Процедура ПредупредитьОбУстаревшейОпции(Знач ИмяОпции, Знач Формат, Знач Путь)

	Лог.Предупреждение("Опция %1 устарела, используйте: --report-format %2 --report-path %3",
		ИмяОпции, Формат, Путь);

КонецПроцедуры

// Каталоги отчётов создаём до проверки: она идёт минутами, и падение на записи
// отчёта в самом конце обесценивает весь прогон (issue #746).
Процедура ПодготовитьКаталогиОтчетов(Знач Отчеты)

	Для Каждого Отчет Из Отчеты Цикл
		Если Отчет.Формат = ФорматAllure() Тогда
			ФайловыеОперации.ОбеспечитьКаталог(Отчет.Путь);
		Иначе
			ФайловыеОперации.ОбеспечитьКаталогДляФайла(Отчет.Путь);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ФорматJUnit()
	Возврат "junit";
КонецФункции

Функция ФорматAllure()
	Возврат "allure";
КонецФункции

Функция ФорматEDT()
	Возврат "edt";
КонецФункции

// Важность Allure (severity) по уровню замечания EDT.
Функция ВажностьAllure(Знач Важность)

	Ранг = РангВажности(Важность);
	Если Ранг = 3 Тогда
		Возврат "critical";
	ИначеЕсли Ранг = 1 Тогда
		Возврат "minor";
	Иначе
		Возврат "normal";
	КонецЕсли;

КонецФункции

#КонецОбласти
