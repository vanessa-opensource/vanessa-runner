// BSLLS:NumberOfValuesInStructureConstructor-off
// BSLLS:MissingVariablesDescription-off Поля &Опция/&Аргумент/&НаборОпций - описания заданы в самой аннотации.
// BSLLS:UnusedLocalVariable-off Поля &Опция инициализируются autumn-фреймворком через рефлексию.
&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисСинтаксическойПроверки;

&Пластилин
Перем СервисЗаполненияПараметров;

&НаборОпций("НаборОпцийПодключения")
Перем ОпцииПодключения;

&НаборОпций("НаборОпцийПлатформы")
Перем ОпцииПлатформы;

&НаборОпций("НаборОпцийСУБД")
Перем ОпцииСУБД;

&НаборОпций("НаборОпцийХранилища")
Перем ОпцииХранилища;

&Опция(Имя = "mode", Описание = "Режимы проверки. Например: ThinClient Server WebClient.
|Доступные режимы:
|  ConfigLogIntegrity            - проверка логической целостности конфигурации
|  IncorrectReferences           - поиск некорректных ссылок
|  ThinClient                    - тонкий клиент
|  WebClient                     - веб-клиент
|  Server                        - сервер
|  ExternalConnection            - внешнее соединение
|  ExternalConnectionServer      - внешнее соединение (клиент-серверный)
|  MobileClient                  - мобильный клиент
|  MobileClientStandalone        - мобильный клиент (автономный)
|  MobileAppClient               - мобильное приложение (клиент)
|  MobileAppServer               - мобильное приложение (сервер)
|  ThickClientManagedApplication - толстый клиент (управляемое приложение)
|  ThickClientServerManagedApplication - толстый клиент (управляемое, клиент-серверный)
|  ThickClientOrdinaryApplication     - толстый клиент (обычное приложение)
|  ThickClientServerOrdinaryApplication - толстый клиент (обычное, клиент-серверный)
|  DistributiveModules           - поставка модулей без исходных текстов
|  UnreferenceProcedures         - поиск неиспользуемых процедур и функций
|  HandlersExistence             - проверка существования назначенных обработчиков
|  EmptyHandlers                 - поиск пустых обработчиков
|  ExtendedModulesCheck          - расширенная проверка модулей
|  CheckUseModality              - поиск использования модальности
|  CheckUseSynchronousCalls      - поиск использования синхронных вызовов
|  UnsupportedFunctional         - поиск неподдерживаемой функциональности
|  AllExtensions                 - проверка всех расширений")
&ТМассивСтрок
Перем РежимыПроверки;

&Опция(Имя = "target", Описание = "Что проверять: main - основная конфигурация,
|AllExtensions - все расширения, <имя> - конкретное расширение в базе, пусто - всё.
|Можно указать несколько раз; каждая цель - отдельный запуск конфигуратора,
|потому что область проверки у платформы взаимоисключающая.
|AllExtensions поглощает перечисленные поимённо расширения.")
&ТМассивСтрок
Перем ЦелиПроверки;

&НаборОпций("НаборОпцийОтчетов")
Перем ОпцииОтчетов;

&Опция(Имя = "junitpath",
	Описание = "Путь к файлу отчёта JUnit XML (устарела: --report-format junit --report-path <путь>)")
&ТСтрока
&ВОкружении("VRUNNER_JUNITPATH")
Перем ПутьОтчетаJUnit;

&Опция(Имя = "allure-results",
	Описание = "Каталог результатов Allure 2 (устарела: --report-format allure --report-path <каталог>)")
&ТСтрока
&ВОкружении("VRUNNER_ALLURE_RESULTS")
Перем КаталогРезультатовAllure;

&Опция(Имя = "exception-file", Описание = "Путь к файлу с пропускаемыми исключениями (UTF-8, по строке на исключение)")
&ТСтрока
Перем ФайлИсключений;

&Опция(Имя = "groupbymetadata", Описание = "Группировать ошибки по метаданным конфигурации")
&Флаговый
Перем ГруппироватьПоМетаданным;

&Опция(Имя = "testsuitename", Описание = "Имя тестового набора в отчёте JUnit")
&ТСтрока
&ПоУмолчанию("syntax-check")
Перем ИмяТестовогоНабора;

&НаборОпций("НаборОпцийНастроек")
Перем ОпцииНастроек; // BSLLS:UnusedLocalVariable-off

&ПодкомандаПриложения(Имя = "syntax-check", Родитель = "КомандаValidate", Описание = "Проверка синтаксиса конфигурации")
&ДоступноВMCP
&MCPДлительная
&MCPТолькоЧтение
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);

	Лог.Отладка("Начало выполнения команды validate syntax-check");

	ПараметрыПлатформы = Новый Структура(
		"ВерсияПлатформы, КодРазрешения, Язык, Локаль",
		ОпцииПлатформы.ВерсияПлатформы,
		ОпцииПлатформы.КодРазрешения,
		ОпцииПлатформы.Язык,
		ОпцииПлатформы.Локаль);

	ПараметрыПодключения = Неопределено;
	Если ЗначениеЗаполнено(ОпцииПодключения.СтрокаПодключения)
		ИЛИ ЗначениеЗаполнено(ОпцииСУБД.ТипСУБД) Тогда
		ПараметрыПодключения = Новый Структура(
			"СтрокаПодключения, Пользователь, Пароль",
			ОпцииПодключения.СтрокаПодключения,
			ОпцииПодключения.Пользователь,
			ОпцииПодключения.Пароль);
		ОпцииСУБД.ДополнитьПараметрыПодключения(ПараметрыПодключения);
	КонецЕсли;

	ПараметрыХранилища = Неопределено;
	Если ЗначениеЗаполнено(ОпцииХранилища.АдресХранилища) Тогда
		ПараметрыХранилища = Новый Структура(
			"АдресХранилища, Пользователь, Пароль",
			ОпцииХранилища.АдресХранилища,
			ОпцииХранилища.ПользовательХранилища,
			ОпцииХранилища.ПарольХранилища);
	КонецЕсли;

	Режимы = СервисСинтаксическойПроверки.РежимыПроверки(РежимыПроверки);
	Цели = СервисСинтаксическойПроверки.ЦелиПроверки(ЦелиПроверки, РежимыПроверки);

	Отчеты = ПолучитьОтчеты();
	ОпцииОтчетов.ПодготовитьКаталоги(Отчеты, ФорматыКаталогов());

	Лог.Информация("Начало проверки конфигурации");
	ДатаНачала = ТекущаяУниверсальнаяДата();

	ВыводЛога = СервисСинтаксическойПроверки.Проверить(Режимы, Цели,
		ПараметрыПодключения, ПараметрыХранилища, ПараметрыПлатформы);

	ДлительностьСек = ТекущаяУниверсальнаяДата() - ДатаНачала;
	Лог.Информация("Проверка конфигурации завершена за %1с", Окр(ДлительностьСек));

	Замечания = СервисСинтаксическойПроверки.ОтфильтроватьЗамечания(ВыводЛога, ФайлИсключений);
	ВывестиЗамечания(Замечания);

	Для Каждого Отчет Из Отчеты Цикл
		Если Отчет.Формат = ФорматAllure() Тогда
			СформироватьОтчетAllure(Отчет.Путь, Замечания, ДатаНачала);
		Иначе
			СформироватьОтчетJUnit(Отчет.Путь, Замечания, ДатаНачала);
		КонецЕсли;
	КонецЦикла;

	Если Замечания.Количество() > 0 Тогда
		ВызватьИсключение "Обнаружены ошибки синтаксической проверки";
	КонецЕсли;

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Процедура ВывестиЗамечания(Знач Замечания)

	Если Замечания.Количество() = 0 Тогда
		Лог.Информация("Результат синтакс-контроля: Ошибок не обнаружено"); // BSLLS:Typo-off
		Возврат;
	КонецЕсли;

	Лог.Предупреждение("Замечания синтаксической проверки:");
	Для Каждого Замечание Из Замечания Цикл
		Лог.Предупреждение("  %1", Замечание);
	КонецЦикла;

КонецПроцедуры

// Параметры:
//   ПутьОтчета - Строка - путь к создаваемому файлу отчёта
//   Замечания  - Массив - Элементы <Строка>, строки замечаний после фильтрации
//   ДатаНачала - Дата   - начало проверки, универсальное время
//
Процедура СформироватьОтчетJUnit(Знач ПутьОтчета, Знач Замечания, Знач ДатаНачала)

	Лог.Информация("Генерация отчёта JUnit: %1", ПутьОтчета);

	Генератор = Новый ГенераторОтчетаJUnit(ИмяТестовогоНабора);

	Случаи = Новый Массив;
	Для Каждого СлучайОтчета Из СлучаиОтчета(Замечания) Цикл
		Случай = Генератор.НовыйСлучай(СлучайОтчета.Имя);
		Случай.Провален = Истина;
		Случай.Сообщение = СлучайОтчета.Сообщение;
		Случаи.Добавить(Случай);
	КонецЦикла;

	// Успешную проверку тоже показываем кейсом: пустой набор в отчёте
	// неотличим от прогона, который до отчёта не дошёл.
	Если Случаи.Количество() = 0 Тогда
		Случаи.Добавить(Генератор.НовыйСлучай(СервисСинтаксическойПроверки.ИмяПроверкиПоУмолчанию()));
	КонецЕсли;

	Генератор.Записать(ПутьОтчета, Случаи, ТекущаяУниверсальнаяДата() - ДатаНачала);

	Лог.Информация("Отчёт JUnit сохранён: %1", ПутьОтчета);

КонецПроцедуры

// Сформировать результаты Allure.
//
// Allure собирает отчёт из каталога с файлом на каждый тест-кейс, а не из одного файла
// отчёта - поэтому здесь путь всегда каталог.
//
// Параметры:
//   КаталогРезультатов - Строка - каталог allure-results
//   Замечания          - Массив - Элементы <Строка>, строки замечаний после фильтрации
//   ДатаНачала         - Дата   - начало проверки, универсальное время
//
Процедура СформироватьОтчетAllure(Знач КаталогРезультатов, Знач Замечания, Знач ДатаНачала)

	Лог.Информация("Генерация результатов Allure: %1", КаталогРезультатов);

	ДлительностьСек = ТекущаяУниверсальнаяДата() - ДатаНачала;
	Генератор = Новый ГенераторОтчетаAllure(ИмяТестовогоНабора);

	Случаи = Новый Массив;
	Для Каждого СлучайОтчета Из СлучаиОтчета(Замечания) Цикл
		Случай = Генератор.НовыйСлучай(СлучайОтчета.Имя);
		Случай.Сообщение = СлучайОтчета.Сообщение;
		Случай.Пакет = СлучайОтчета.Пакет;
		Случай.Важность = "critical";
		Случаи.Добавить(Случай);
	КонецЦикла;

	// Успешную проверку тоже показываем кейсом: пустой каталог результатов Allure
	// неотличим от прогона, который до отчёта не дошёл.
	Если Случаи.Количество() = 0 Тогда
		Случаи.Добавить(Генератор.НовыйСлучай(СервисСинтаксическойПроверки.ИмяПроверкиПоУмолчанию(), "passed"));
	КонецЕсли;

	Записано = Генератор.Записать(КаталогРезультатов, Случаи, ДатаНачала, ДлительностьСек);

	Лог.Информация("Результаты Allure сохранены: %1, файлов: %2", КаталогРезультатов, Записано);

КонецПроцедуры

Функция СлучаиОтчета(Знач Замечания)

	Возврат СервисСинтаксическойПроверки.СлучаиОтчета(Замечания, ГруппироватьПоМетаданным = Истина);

КонецФункции

// Форматы отчёта синтаксической проверки: их пишет сам vrunner, поэтому словарь закрыт.
// Значение - имя файла или каталога внутри --report-path, когда форматов несколько.
//
// Возвращаемое значение:
//   Соответствие - формат -> имя по умолчанию
//
Функция ДопустимыеФорматыОтчетов()

	Форматы = Новый Соответствие;
	Форматы.Вставить(ФорматJUnit(), "junit.xml");
	Форматы.Вставить(ФорматAllure(), ФорматAllure());

	Возврат Форматы;

КонецФункции

// Список формируемых отчётов: устаревшие опции команды плюс общая пара --report-format/--report-path.
//
// Возвращаемое значение:
//   Массив - Элементы <Структура> с полями Формат и Путь
//
Функция ПолучитьОтчеты()

	Устаревшие = Новый Массив;
	Устаревшие.Добавить(ОпцииОтчетов.УстаревшийОтчет("--junitpath", ФорматJUnit(), ПутьОтчетаJUnit));
	Устаревшие.Добавить(ОпцииОтчетов.УстаревшийОтчет("--allure-results", ФорматAllure(), КаталогРезультатовAllure));

	Возврат ОпцииОтчетов.СобратьОтчеты(ДопустимыеФорматыОтчетов(), ФорматJUnit(), Устаревшие);

КонецФункции

// Форматы, у которых путь отчёта - каталог, а не файл.
//
// Возвращаемое значение:
//   Массив - Элементы <Строка>
//
Функция ФорматыКаталогов()

	Форматы = Новый Массив;
	Форматы.Добавить(ФорматAllure());
	Возврат Форматы;

КонецФункции

Функция ФорматJUnit()
	Возврат "junit";
КонецФункции

Функция ФорматAllure()
	Возврат "allure";
КонецФункции

#КонецОбласти
