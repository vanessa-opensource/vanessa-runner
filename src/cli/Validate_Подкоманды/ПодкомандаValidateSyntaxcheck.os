// BSLLS:NumberOfValuesInStructureConstructor-off
// BSLLS:MissingVariablesDescription-off Поля &Опция/&Аргумент/&НаборОпций - описания заданы в самой аннотации.
// BSLLS:UnusedLocalVariable-off Поля &Опция инициализируются autumn-фреймворком через рефлексию.
&Лог("vrunner")
Перем Лог;

&Пластилин
Перем ФайловыеОперации;

&Пластилин
Перем СервисПлатформы;

&Пластилин
Перем СервисЗаполненияПараметров;

&НаборОпций("НаборОпцийПодключения")
Перем ОпцииПодключения;

&НаборОпций("НаборОпцийПлатформы")
Перем ОпцииПлатформы;

&НаборОпций("НаборОпцийСУБД")
Перем ОпцииСУБД;

&НаборОпций("НаборОпцийХранилища")
Перем ОпцииХранилища;

&Опция(Имя = "mode", Описание = "Режимы проверки. Например: ThinClient Server WebClient.
|Доступные режимы:
|  ConfigLogIntegrity            - проверка логической целостности конфигурации
|  IncorrectReferences           - поиск некорректных ссылок
|  ThinClient                    - тонкий клиент
|  WebClient                     - веб-клиент
|  Server                        - сервер
|  ExternalConnection            - внешнее соединение
|  ExternalConnectionServer      - внешнее соединение (клиент-серверный)
|  MobileClient                  - мобильный клиент
|  MobileClientStandalone        - мобильный клиент (автономный)
|  MobileAppClient               - мобильное приложение (клиент)
|  MobileAppServer               - мобильное приложение (сервер)
|  ThickClientManagedApplication - толстый клиент (управляемое приложение)
|  ThickClientServerManagedApplication - толстый клиент (управляемое, клиент-серверный)
|  ThickClientOrdinaryApplication     - толстый клиент (обычное приложение)
|  ThickClientServerOrdinaryApplication - толстый клиент (обычное, клиент-серверный)
|  DistributiveModules           - поставка модулей без исходных текстов
|  UnreferenceProcedures         - поиск неиспользуемых процедур и функций
|  HandlersExistence             - проверка существования назначенных обработчиков
|  EmptyHandlers                 - поиск пустых обработчиков
|  ExtendedModulesCheck          - расширенная проверка модулей
|  CheckUseModality              - поиск использования модальности
|  CheckUseSynchronousCalls      - поиск использования синхронных вызовов
|  UnsupportedFunctional         - поиск неподдерживаемой функциональности
|  AllExtensions                 - проверка всех расширений")
&ТМассивСтрок
Перем РежимыПроверки;

&Опция(Имя = "target", Описание = "Что проверять: main - основная конфигурация,
|AllExtensions - все расширения, <имя> - конкретное расширение в базе, пусто - всё.
|Можно указать несколько раз; каждая цель - отдельный запуск конфигуратора,
|потому что область проверки у платформы взаимоисключающая.
|AllExtensions поглощает перечисленные поимённо расширения.")
&ТМассивСтрок
Перем ЦелиПроверки;

&Опция(Имя = "junitpath", Описание = "Путь к файлу отчёта в формате JUnit XML")
&ТСтрока
&ВОкружении("VRUNNER_JUNITPATH")
Перем ПутьОтчетаJUnit;

&Опция(Имя = "exception-file", Описание = "Путь к файлу с пропускаемыми исключениями (UTF-8, по строке на исключение)")
&ТСтрока
Перем ФайлИсключений;

&Опция(Имя = "groupbymetadata", Описание = "Группировать ошибки по метаданным конфигурации")
&Флаговый
Перем ГруппироватьПоМетаданным;

&Опция(Имя = "testsuitename", Описание = "Имя тестового набора в отчёте JUnit")
&ТСтрока
&ПоУмолчанию("syntax-check")
Перем ИмяТестовогоНабора;

&НаборОпций("НаборОпцийНастроек")
Перем ОпцииНастроек; // BSLLS:UnusedLocalVariable-off

&ПодкомандаПриложения(Имя = "syntax-check", Родитель = "КомандаValidate", Описание = "Проверка синтаксиса конфигурации")
&ДоступноВMCP
&MCPДлительная
&MCPТолькоЧтение
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);

	Лог.Отладка("Начало выполнения команды validate syntax-check");

	ПараметрыПлатформы = Новый Структура(
		"ВерсияПлатформы, КодРазрешения, Язык, Локаль",
		ОпцииПлатформы.ВерсияПлатформы,
		ОпцииПлатформы.КодРазрешения,
		ОпцииПлатформы.Язык,
		ОпцииПлатформы.Локаль);

	ПараметрыПодключения = Неопределено;
	Если ЗначениеЗаполнено(ОпцииПодключения.СтрокаПодключения)
		ИЛИ ЗначениеЗаполнено(ОпцииСУБД.ТипСУБД) Тогда
		ПараметрыПодключения = Новый Структура(
			"СтрокаПодключения, Пользователь, Пароль",
			ОпцииПодключения.СтрокаПодключения,
			ОпцииПодключения.Пользователь,
			ОпцииПодключения.Пароль);
		ОпцииСУБД.ДополнитьПараметрыПодключения(ПараметрыПодключения);
	КонецЕсли;

	ПараметрыХранилища = Неопределено;
	Если ЗначениеЗаполнено(ОпцииХранилища.АдресХранилища) Тогда
		ПараметрыХранилища = Новый Структура(
			"АдресХранилища, Пользователь, Пароль",
			ОпцииХранилища.АдресХранилища,
			ОпцииХранилища.ПользовательХранилища,
			ОпцииХранилища.ПарольХранилища);
	КонецЕсли;

	КоллекцияПроверок = ПолучитьРежимыПроверки();

	// Каталог отчёта создаём до проверки: она может идти минутами, и падение
	// на записи отчёта в конце обесценивает весь прогон (issue #746).
	ФайловыеОперации.ОбеспечитьКаталогДляФайла(ПутьОтчетаJUnit);

	Лог.Информация("Начало проверки конфигурации");
	ДатаНачала = ТекущаяУниверсальнаяДата();

	ВыводЛога = ВыполнитьПроверкуПоЦелям(КоллекцияПроверок,
		ПараметрыПодключения, ПараметрыХранилища, ПараметрыПлатформы);

	ДлительностьСек = ТекущаяУниверсальнаяДата() - ДатаНачала;
	Лог.Информация("Проверка конфигурации завершена за %1с", Окр(ДлительностьСек));

	ОбработатьРезультат(ВыводЛога, ДатаНачала);

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

// Прогнать проверку по всем заданным целям и вернуть склеенный вывод конфигуратора.
//
// Область проверки у /CheckConfig взаимоисключающая: за один запуск проверяется либо
// основная конфигурация, либо расширения, а ключ -Extension не мультизначный.
// Поэтому каждая цель - отдельный запуск конфигуратора.
//
// Параметры:
//   КоллекцияПроверок    - Массив - ключи видов проверок
//   ПараметрыПодключения - Структура, Неопределено - параметры подключения к ИБ
//   ПараметрыХранилища   - Структура, Неопределено - параметры хранилища
//   ПараметрыПлатформы   - Структура - версия платформы и прочее
//
// Возвращаемое значение:
//   Строка - вывод конфигуратора по всем целям
//
Функция ВыполнитьПроверкуПоЦелям(Знач КоллекцияПроверок,
		Знач ПараметрыПодключения, Знач ПараметрыХранилища, Знач ПараметрыПлатформы)

	Цели = ПолучитьЦелиПроверки();
	ВыводЛога = "";

	Если ЕстьЦель(Цели, ИмяКонфигурации()) Тогда
		ВыводЦели = ПроверитьЦель("основная конфигурация", "",
			КоллекцияПроверок, ПараметрыПодключения, ПараметрыХранилища, ПараметрыПлатформы);
		ВыводЛога = ДополнитьВывод(ВыводЛога, ВыводЦели);
	КонецЕсли;

	// Расширения, перечисленные поимённо, после проверки всех расширений гонять незачем.
	Если ЕстьЦель(Цели, ИмяВсехРасширений()) Тогда
		ВыводЦели = ПроверитьЦель("все расширения", "-AllExtensions",
			КоллекцияПроверок, ПараметрыПодключения, ПараметрыХранилища, ПараметрыПлатформы);
		Возврат ДополнитьВывод(ВыводЛога, ВыводЦели);
	КонецЕсли;

	Для Каждого Цель Из Цели Цикл
		Если ЭтоЦель(Цель, ИмяКонфигурации()) Тогда
			Продолжить;
		КонецЕсли;
		ВыводЦели = ПроверитьЦель(СтрШаблон("расширение ""%1""", Цель), СтрШаблон("-Extension ""%1""", Цель),
			КоллекцияПроверок, ПараметрыПодключения, ПараметрыХранилища, ПараметрыПлатформы);
		ВыводЛога = ДополнитьВывод(ВыводЛога, ВыводЦели);
	КонецЦикла;

	Возврат ВыводЛога;

КонецФункции

// Прогнать одну цель проверки.
//
// Параметры:
//   Представление        - Строка - как цель показывать в логе
//   КлючОбласти          - Строка - ключ /CheckConfig; пустой для основной конфигурации
//   КоллекцияПроверок    - Массив - ключи видов проверок
//   ПараметрыПодключения - Структура, Неопределено - параметры подключения к ИБ
//   ПараметрыХранилища   - Структура, Неопределено - параметры хранилища
//   ПараметрыПлатформы   - Структура - версия платформы и прочее
//
// Возвращаемое значение:
//   Строка - вывод конфигуратора по этой цели
//
Функция ПроверитьЦель(Знач Представление, Знач КлючОбласти, Знач КоллекцияПроверок,
		Знач ПараметрыПодключения, Знач ПараметрыХранилища, Знач ПараметрыПлатформы)

	Лог.Информация("Проверка: %1", Представление);

	Ключи = Новый Массив;
	Для Каждого Ключ Из КоллекцияПроверок Цикл
		Ключи.Добавить(Ключ);
	КонецЦикла;
	Если ЗначениеЗаполнено(КлючОбласти) Тогда
		Ключи.Добавить(КлючОбласти);
	КонецЕсли;

	Результат = СервисПлатформы.ПроверитьКонфигурацию(
		ПараметрыПодключения, Ключи, ПараметрыХранилища, ПараметрыПлатформы);

	Возврат Результат.ВыводКоманды;

КонецФункции

// Цели проверки: значения --target, а если их нет - всё: основная конфигурация
// и все расширения (как --target у infobase update).
// Значение AllExtensions в устаревшей опции --mode (так область проверки задавалась
// до появления --target) считается такой же целью и сужает проверку до расширений.
//
// Возвращаемое значение:
//   Массив - Элементы <Строка>
//
Функция ПолучитьЦелиПроверки()

	Цели = Новый Массив;

	Если ЦелиПроверки <> Неопределено Тогда
		Для Каждого Цель Из ЦелиПроверки Цикл
			Если ЗначениеЗаполнено(СокрЛП(Цель)) Тогда
				Цели.Добавить(СокрЛП(Цель));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Если Цели.Количество() = 0 И ЕстьУстаревшийРежимВсехРасширений() Тогда
		Цели.Добавить(ИмяВсехРасширений());
	КонецЕсли;

	Если Цели.Количество() = 0 Тогда
		Цели.Добавить(ИмяКонфигурации());
		Цели.Добавить(ИмяВсехРасширений());
	КонецЕсли;

	Возврат Цели;

КонецФункции

// Устаревший способ задать область проверки - значение AllExtensions в опции --mode.
//
// Возвращаемое значение:
//   Булево - Истина, если среди режимов есть AllExtensions
//
Функция ЕстьУстаревшийРежимВсехРасширений()

	Если РежимыПроверки = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Режим Из РежимыПроверки Цикл
		Если НРег(СтрЗаменить(СокрЛП(Режим), "-", "")) = НРег(ИмяВсехРасширений()) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Параметры:
//   Цели - Массив - Элементы <Строка>
//   Имя  - Строка - искомое зарезервированное значение
//
// Возвращаемое значение:
//   Булево
//
Функция ЕстьЦель(Знач Цели, Знач Имя)

	Для Каждого Цель Из Цели Цикл
		Если ЭтоЦель(Цель, Имя) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Параметры:
//   Цель - Строка - значение --target
//   Имя  - Строка - зарезервированное значение
//
// Возвращаемое значение:
//   Булево
//
Функция ЭтоЦель(Знач Цель, Знач Имя)
	Возврат НРег(СокрЛП(Цель)) = НРег(Имя);
КонецФункции

Функция ИмяКонфигурации()
	Возврат "main";
КонецФункции

Функция ИмяВсехРасширений()
	Возврат "AllExtensions";
КонецФункции

Функция ДополнитьВывод(Знач ВыводЛога, Знач ВыводЦели)
	Возврат ВыводЛога + ?(ПустаяСтрока(ВыводЛога), "", Символы.ПС) + ВыводЦели;
КонецФункции

Функция ПолучитьРежимыПроверки()

	Режимы = Новый Массив;

	Если РежимыПроверки <> Неопределено Тогда
		Для Каждого Режим Из РежимыПроверки Цикл
			// AllExtensions - не вид проверки, а область: он уходит в цели (см. ПолучитьЦелиПроверки).
			Если НРег(СтрЗаменить(СокрЛП(Режим), "-", "")) = "allextensions" Тогда
				Продолжить;
			КонецЕсли;
			Режимы.Добавить(?(СтрНачинаетсяС(Режим, "-"), Режим, "-" + Режим));
		КонецЦикла;
	КонецЕсли;

	Если Режимы.Количество() > 0 Тогда
		Возврат Режимы;
	КонецЕсли;

	Режимы.Добавить("-ThinClient");
	Режимы.Добавить("-WebClient");
	Режимы.Добавить("-Server");
	Режимы.Добавить("-ExternalConnection");
	Режимы.Добавить("-ThickClientOrdinaryApplication");
	Возврат Режимы;

КонецФункции

Процедура ОбработатьРезультат(Знач ВыводЛога, ДатаНачала)

	ИсключенияТиповые = ТиповыеИсключения();
	ПользовательскиеИсключения = ПрочитатьФайлИсключений();

	ВсеИсключения = Новый Массив;
	Для Каждого Искл Из ИсключенияТиповые Цикл
		ВсеИсключения.Добавить(Искл);
	КонецЦикла;
	Для Каждого Искл Из ПользовательскиеИсключения Цикл
		ВсеИсключения.Добавить(Искл);
	КонецЦикла;

	ОставшиесяОшибки = ОтфильтроватьОшибки(ВыводЛога, ВсеИсключения);

	Если ОставшиесяОшибки.Количество() = 0 Тогда
		Лог.Информация("Результат синтакс-контроля: Ошибок не обнаружено"); // BSLLS:Typo-off
	Иначе
		Лог.Предупреждение("Замечания синтаксической проверки:");
		Для Каждого Ошибка Из ОставшиесяОшибки Цикл
			Лог.Предупреждение("  %1", Ошибка);
		КонецЦикла;
	КонецЕсли;

	Если ЗначениеЗаполнено(ПутьОтчетаJUnit) Тогда
		СформироватьОтчетJUnit(ОставшиесяОшибки, ДатаНачала);
	КонецЕсли;

	Если ОставшиесяОшибки.Количество() > 0 Тогда
		ВызватьИсключение "Обнаружены ошибки синтаксической проверки";
	КонецЕсли;

КонецПроцедуры

Функция ТиповыеИсключения()

	Результат = Новый Массив;
	Результат.Добавить(НРег("Не обнаружено ссылок на процедуру: ""Подключаемый_"));
	Результат.Добавить(НРег("Не обнаружено ссылок на функцию: ""Подключаемый_"));
	Результат.Добавить(НРег("Пустой обработчик: ""Подключаемый_"));
	Результат.Добавить(НРег("No links to function found: ""Attachable_"));
	Результат.Добавить(НРег("No links to procedure found: ""Attachable_"));
	Результат.Добавить(НРег("Empty handler: ""Attachable_"));
	Результат.Добавить(НРег("Ошибок не обнаружено"));
	Результат.Добавить(НРег("No syntax errors found"));
	Результат.Добавить(НРег("No errors found"));
	Возврат Результат;

КонецФункции

Функция ПрочитатьФайлИсключений()

	Результат = Новый Массив;

	Если НЕ ЗначениеЗаполнено(ФайлИсключений) Тогда
		Возврат Результат;
	КонецЕсли;

	Файл = Новый Файл(ФайлИсключений);
	Если НЕ Файл.Существует() Тогда
		Лог.Предупреждение("Файл исключений не найден: %1", ФайлИсключений);
		Возврат Результат;
	КонецЕсли;

	Лог.Отладка("Чтение файла исключений: %1", ФайлИсключений);
	ЧтениеТекста = Новый ЧтениеТекста(ФайлИсключений, КодировкаТекста.UTF8);
	Строка = ЧтениеТекста.ПрочитатьСтроку();
	Пока Строка <> Неопределено Цикл
		Если НЕ ПустаяСтрока(Строка) Тогда
			Результат.Добавить(НРег(СокрЛП(Строка)));
		КонецЕсли;
		Строка = ЧтениеТекста.ПрочитатьСтроку();
	КонецЦикла;

	Лог.Отладка("Прочитано исключений: %1", Результат.Количество());
	Возврат Результат;

КонецФункции

Функция ОтфильтроватьОшибки(Знач ВыводЛога, Знач Исключения)

	ОставшиесяОшибки = Новый Массив;
	Если НЕ ЗначениеЗаполнено(ВыводЛога) Тогда
		Возврат ОставшиесяОшибки;
	КонецЕсли;

	ОбработанныйЛог = СтрЗаменить(ВыводЛога, Символы.ВК + Символы.Таб, Символы.Таб);
	ОбработанныйЛог = СтрЗаменить(ОбработанныйЛог, Символы.ПС + Символы.Таб, Символы.Таб);

	// Склейка до фильтра: пользовательские исключения из --exception-file должны
	// матчиться и по фрагменту кода, который конфигуратор печатает второй строкой.
	МассивСтрок = НовыйРазборЗамечаний().СклеитьПродолжения(СтрРазделить(ОбработанныйЛог, Символы.ПС));
	Для Каждого ТекСтрока Из МассивСтрок Цикл
		Если СтрокаИсключена(ТекСтрока, Исключения) Тогда
			Продолжить;
		КонецЕсли;
		ОставшиесяОшибки.Добавить(ТекСтрока);
	КонецЦикла;

	Возврат ОставшиесяОшибки;

КонецФункции

Функция СтрокаИсключена(Знач ПроверяемаяСтрока, Знач Исключения)

	Если НЕ ЗначениеЗаполнено(ПроверяемаяСтрока) Тогда
		Возврат Истина;
	КонецЕсли;

	НормализованнаяСтрока = НРег(СокрЛП(ПроверяемаяСтрока));
	Для Каждого ТекИсключение Из Исключения Цикл
		Если СтрНайти(НормализованнаяСтрока, ТекИсключение) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Разложить замечания по тест-кейсам отчёта.
// По умолчанию - один тест-кейс на строку замечания; с --groupbymetadata -
// один тест-кейс на объект метаданных со всеми его замечаниями в сообщении.
//
// Параметры:
//   ОставшиесяОшибки - Массив - Элементы <Строка>, строки замечаний после фильтрации
//
// Возвращаемое значение:
//   Массив - Элементы <Структура>:
//    * Имя       - Строка - имя тест-кейса
//    * Сообщение - Строка - текст для элемента failure
//
Функция СформироватьСлучаиОтчета(Знач ОставшиесяОшибки)

	Случаи = Новый Массив;

	Если ГруппироватьПоМетаданным = Истина Тогда

		Разбор = НовыйРазборЗамечаний();
		Группы = Разбор.Сгруппировать(ОставшиесяОшибки);
		Для Каждого Группа Из Группы Цикл
			ТекстЗамечаний = Разбор.ТекстЗамечанийГруппы(Группа);
			Случаи.Добавить(Новый Структура("Имя, Сообщение", Группа.ИмяГруппы, ТекстЗамечаний));
		КонецЦикла;

		Возврат Случаи;

	КонецЕсли;

	Для Каждого Ошибка Из ОставшиесяОшибки Цикл
		Случаи.Добавить(Новый Структура("Имя, Сообщение", Ошибка, Ошибка));
	КонецЦикла;

	Возврат Случаи;

КонецФункции

Функция ИмяПроверкиПоУмолчанию()

	Возврат "Синтаксическая проверка конфигурации";

КонецФункции

Функция НовыйРазборЗамечаний()

	Возврат Новый РазборЗамечанийСинтаксиса(ИмяПроверкиПоУмолчанию());

КонецФункции

Процедура СформироватьОтчетJUnit(ОставшиесяОшибки, ДатаНачала)

	Лог.Информация("Генерация отчёта JUnit: %1", ПутьОтчетаJUnit);

	ИмяНабора = ИмяТестовогоНабора;

	ДлительностьСек = ТекущаяУниверсальнаяДата() - ДатаНачала;

	СлучаиОтчета = СформироватьСлучаиОтчета(ОставшиесяОшибки);

	КоличествоОшибок = СлучаиОтчета.Количество();
	КоличествоТестов = ?(КоличествоОшибок > 0, КоличествоОшибок, 1);

	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ПутьОтчетаJUnit);
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	ЗаписьXML.ЗаписатьНачалоЭлемента("testsuites");

	ЗаписьXML.ЗаписатьНачалоЭлемента("testsuite");
	// BSLLS:DuplicateStringLiteral-off
	ЗаписьXML.ЗаписатьАтрибут("name", ИмяНабора);
	// BSLLS:DuplicateStringLiteral-on
	ЗаписьXML.ЗаписатьАтрибут("tests", XMLСтрока(КоличествоТестов));
	ЗаписьXML.ЗаписатьАтрибут("failures", XMLСтрока(КоличествоОшибок));
	ЗаписьXML.ЗаписатьАтрибут("time", XMLСтрока(ДлительностьСек));

	Если КоличествоОшибок = 0 Тогда
		ЗаписьXML.ЗаписатьНачалоЭлемента("testcase");
		ЗаписьXML.ЗаписатьАтрибут("name", ИмяПроверкиПоУмолчанию());
		ЗаписьXML.ЗаписатьАтрибут("classname", ИмяНабора);
		ЗаписьXML.ЗаписатьКонецЭлемента();
	Иначе
		Для Каждого СлучайОтчета Из СлучаиОтчета Цикл
			ЗаписьXML.ЗаписатьНачалоЭлемента("testcase");
			ЗаписьXML.ЗаписатьАтрибут("name", СлучайОтчета.Имя);
			ЗаписьXML.ЗаписатьАтрибут("classname", ИмяНабора);
			ЗаписьXML.ЗаписатьНачалоЭлемента("failure");
			ЗаписьXML.ЗаписатьАтрибут("message", СлучайОтчета.Сообщение);
			ЗаписьXML.ЗаписатьКонецЭлемента();
			ЗаписьXML.ЗаписатьКонецЭлемента();
		КонецЦикла;
	КонецЕсли;

	ЗаписьXML.ЗаписатьКонецЭлемента(); // testsuite
	ЗаписьXML.ЗаписатьКонецЭлемента(); // testsuites
	ЗаписьXML.Закрыть();

	Лог.Информация("Отчёт JUnit сохранён: %1", ПутьОтчетаJUnit);

КонецПроцедуры

#КонецОбласти
