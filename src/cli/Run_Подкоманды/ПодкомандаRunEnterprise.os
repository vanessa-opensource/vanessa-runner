// BSLLS:LineLength-off
// BSLLS:NumberOfValuesInStructureConstructor-off
// BSLLS:MissingVariablesDescription-off Поля &Опция/&Аргумент/&НаборОпций - описания заданы в самой аннотации.
&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисПлатформы;

&Пластилин
Перем СервисЗаполненияПараметров;

&Пластилин
Перем СервисОкружения;

&НаборОпций("НаборОпцийПодключения")
Перем ОпцииПодключения;

&НаборОпций("НаборОпцийПлатформы")
Перем ОпцииПлатформы;

&НаборОпций("НаборОпцийЗапуска")
Перем ОпцииЗапуска;

&Опция(Имя = "command", Описание = "Строка, передаваемая в параметр запуска /C")
&ТСтрока
&ВОкружении("VRUNNER_COMMAND")
Перем КомандаЗапуска;

&Опция(Имя = "execute", Описание = "Путь к внешней обработке 1С для запуска в предприятии (поддерживается переменная $runnerRoot)")
&ТСтрока
&ВОкружении("VRUNNER_EXECUTE")
Перем ПутьОбработки;

&Опция(Имя = "url", Описание = "Навигационная ссылка для перехода после старта 1С:Предприятия")
&ТСтрока
Перем НавигационнаяСсылка;

&Опция(Имя = "no-wait", Описание = "Не ожидать завершения запущенной команды/действия")
&Флаговый
Перем НеОжидать;

&Опция(Имя = "exitCodePath", Описание = "Путь к файлу статуса выполнения (0=успех, 1=ошибка, 2=предупреждение)")
&ТСтрока
Перем ПутьКФайлуСтатуса;

&НаборОпций("НаборОпцийНастроек")
Перем ОпцииНастроек; // BSLLS:UnusedLocalVariable-off

&ПодкомандаПриложения(Имя = "enterprise", Родитель = "КомандаRun", Описание = "Запустить в режиме предприятия")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);

	ПутьОбработкиРазрешенный = РазрешитьПутьОбработки(ПутьОбработки);

	Лог.Отладка("Начало выполнения команды run enterprise");

	ПараметрыПлатформы = Новый Структура(
		"ВерсияПлатформы, КодРазрешения, Язык, Локаль",
		ОпцииПлатформы.ВерсияПлатформы,
		ОпцииПлатформы.КодРазрешения,
		ОпцииПлатформы.Язык,
		ОпцииПлатформы.Локаль);

	ПараметрыПодключения = Новый Структура(
		"СтрокаПодключения, Пользователь, Пароль",
		ОпцииПодключения.СтрокаПодключения,
		ОпцииПодключения.Пользователь,
		ОпцииПодключения.Пароль);

	ПараметрыЗапуска = Новый Структура;
	ПараметрыЗапуска.Вставить("КомандаЗапуска", КомандаЗапуска);
	ПараметрыЗапуска.Вставить("ПутьОбработки", ПутьОбработкиРазрешенный);
	ПараметрыЗапуска.Вставить("НавигационнаяСсылка", НавигационнаяСсылка);
	ПараметрыЗапуска.Вставить("НеОжидать", НеОжидать);
	ПараметрыЗапуска.Вставить("РежимЗапуска", ОпцииЗапуска.РежимЗапуска);
	ПараметрыЗапуска.Вставить("ДополнительныеПараметры", ОпцииЗапуска.ДополнительныеПараметры);
	ПараметрыЗапуска.Вставить("ПутьКФайлуСтатуса", ПутьКФайлуСтатуса);
	ПараметрыЗапуска.Вставить("ИспользоватьIbsrv", ОпцииЗапуска.ИспользоватьIbsrv);
	ПараметрыЗапуска.Вставить("ИспользоватьПрямоеСоединениеIbsrv", ОпцииЗапуска.ИспользоватьПрямоеСоединениеIbsrv);
	ПараметрыЗапуска.Вставить("ИспользоватьОтладкуIbsrv", ОпцииЗапуска.ИспользоватьОтладкуIbsrv);

	СервисПлатформы.ЗапуститьПредприятие(ПараметрыПодключения, ПараметрыЗапуска, ПараметрыПлатформы);

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Функция РазрешитьПутьОбработки(Знач Путь)

	Если НЕ ЗначениеЗаполнено(Путь) Тогда
		Возврат "";
	КонецЕсли;

	Путь = СтрЗаменить(Путь, "$runnerRoot", СервисОкружения.КорневойКаталогПакета());

	ФайлОбработки = Новый Файл(Путь);
	Если НЕ ФайлОбработки.Существует() Тогда
		ВызватьИсключение СтрШаблон("Файл внешней обработки ""%1"" не существует!", Путь);
	КонецЕсли;

	Возврат ФайлОбработки.ПолноеИмя;

КонецФункции

#КонецОбласти
