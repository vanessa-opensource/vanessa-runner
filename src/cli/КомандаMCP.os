// ПРОТОТИП. Команда `vrunner mcp` — запуск MCP-сервера поверх stdio.
//
// Едет на штатной CLI-рогатке autumn-cli (отдельной рогатки нет, конфликта нет).
// Внутри доступен контекст Поделка для рефлексии остальных команд.
// Команда блокирующая: цикл чтения stdin держит процесс живым до отсоединения клиента.
//
// Реализация моста — в src/mcp (подключается в main.os через #Использовать "./mcp";
// классы регистрируются глобально загрузчиком src/mcp/package-loader.os).
//
// ВНИМАНИЕ: в этом процессе stdout занят JSON-RPC (MCP). Любой вывод в stdout
// (в т.ч. логирование через стандартный аппендер) сломает протокол.
// Поэтому здесь НЕ логируем в консоль. В проде логи mcp-процесса нужно
// направить в stderr/файл (настройка аппендера autumn-logos).

&Пластилин
Перем Поделка;

&КомандаПриложения(Имя = "mcp", Описание = "Запустить MCP-сервер (stdio) с инструментами vrunner")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	Реестр = Новый MCP_РеестрИнструментов();
	Реестр.Заполнить(Поделка);

	Сервер = Новый MCP_СтдиоСервер();
	Сервер.ЗарегистрироватьИнструменты(Реестр.ПолучитьИнструменты());
	Сервер.Запустить();

КонецПроцедуры
