// BSLLS:MissingParameterDescription-off
// Загрузчик CLI-пакета с рекурсивным обнаружением классов.
// Сканирует все *.os файлы в директории cli/ и её подкаталогах,
// регистрируя каждый как класс.

// BSLLS:UnusedLocalMethod-off  Стандартный хук OneScript - вызывается рантаймом при загрузке пакета.
// BSLLS:UnusedParameters-off   СтандартнаяОбработка/Отказ - часть контракта хука.
Процедура ПриЗагрузкеБиблиотеки(Путь, СтандартнаяОбработка, Отказ)
// BSLLS:UnusedLocalMethod-on
// BSLLS:UnusedParameters-on

	ИмяЗагрузчика = "package-loader.os";

	Файлы = НайтиФайлы(Путь, "*.os", Истина);
	Для Каждого Файл Из Файлы Цикл

		Если Файл.Имя = ИмяЗагрузчика Тогда
			Продолжить;
		КонецЕсли;

		ДобавитьКласс(Файл.ПолноеИмя, Файл.ИмяБезРасширения);

	КонецЦикла;

КонецПроцедуры
