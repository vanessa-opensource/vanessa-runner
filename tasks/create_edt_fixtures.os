// BSLLS-off
// Генерация EDT-фикстур для EDT-блока e2e-тестов (tests/e2e/edt-tests).
//
// Импортирует XML-дампы Конфигуратора из fixtures/cf и fixtures/cfe в готовые
// EDT-проекты через 1cedtcli и кладёт их в fixtures/edt/. Эти проекты коммитятся
// и используются тестами compile/load (которым нужны EDT-исходники на входе).
//
// ТРЕБУЕТ установленной 1С:EDT (1cedtcli ищется через edtfind).
//
// Запуск:
//   oscript tasks/create_edt_fixtures.os

#Использовать 1commands
#Использовать edtfind

Перем ВерсияПроекта;

ВерсияПроекта = "8.3.14";

КаталогПроекта = ТекущийКаталог();
КаталогФикстур = ОбъединитьПути(КаталогПроекта, "tests", "e2e", "fixtures");
КаталогEDT = ОбъединитьПути(КаталогФикстур, "edt");

ПутьКCli = НайтиCli();

СоздатьФикстуру(ПутьКCli, ОбъединитьПути(КаталогФикстур, "cf"),  ОбъединитьПути(КаталогEDT, "Конфигурация"));
СоздатьФикстуру(ПутьКCli, ОбъединитьПути(КаталогФикстур, "cfe"), ОбъединитьПути(КаталогEDT, "Расширение"));

Сообщить("Готово. EDT-фикстуры пересозданы в " + КаталогEDT);

#Область СлужебныеПроцедурыИФункции

Функция НайтиCli()

	Поиск = Новый ПоискEDT;
	Информация = Поиск.НайтиИнформациюОEDT();
	ПутьКCli = "";
	Информация.Свойство("ПутьКcli", ПутьКCli);
	Если НЕ ЗначениеЗаполнено(ПутьКCli) ИЛИ НЕ Новый Файл(ПутьКCli).Существует() Тогда
		ВызватьИсключение "Не удалось найти 1cedtcli. Установите 1С:EDT.";
	КонецЕсли;
	Сообщить("1cedtcli: " + ПутьКCli);
	Возврат ПутьКCli;

КонецФункции

Процедура СоздатьФикстуру(Знач ПутьКCli, Знач КаталогXML, Знач КаталогПроектаEDT)

	Если Новый Файл(КаталогПроектаEDT).Существует() Тогда
		УдалитьФайлы(КаталогПроектаEDT);
	КонецЕсли;

	Workspace = ПолучитьИмяВременногоФайла();
	СоздатьКаталог(Workspace);

	Команда = Новый Команда;
	Команда.УстановитьКоманду(ПутьКCli);
	Команда.ДобавитьПараметр("-data");
	Команда.ДобавитьПараметр(Workspace);
	Команда.ДобавитьПараметр("-command");
	Команда.ДобавитьПараметр("import");
	Команда.ДобавитьПараметр("--version");
	Команда.ДобавитьПараметр(ВерсияПроекта);
	Команда.ДобавитьПараметр("--configuration-files");
	Команда.ДобавитьПараметр(КаталогXML);
	Команда.ДобавитьПараметр("--project");
	Команда.ДобавитьПараметр(КаталогПроектаEDT);
	Команда.ПоказыватьВыводНемедленно(Истина);
	Команда.Исполнить();

	Попытка
		УдалитьФайлы(Workspace);
	Исключение
		// временный workspace - не критично
	КонецПопытки;

	Если НЕ Новый Файл(ОбъединитьПути(КаталогПроектаEDT, ".project")).Существует() Тогда
		ВызватьИсключение "Импорт не создал EDT-проект: " + КаталогПроектаEDT;
	КонецЕсли;

	Сообщить("Создан EDT-проект: " + КаталогПроектаEDT);

КонецПроцедуры

#КонецОбласти
