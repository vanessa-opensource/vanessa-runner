// BSLLS-off
// Пересоздание фикстуры tests/e2e/fixtures/configured-ib/1Cv8.1CD:
// пустая ИБ (фикстура empty-ib) + загрузка tests/e2e/fixtures/1cv8.cf через ibcmd
// с обновлением конфигурации БД. Фикстуру создавайте САМОЙ СТАРОЙ версией платформы
// из матрицы CI (файл, созданный старшей версией, младшая не откроет).
//
// Запуск:  oscript tasks/create_ib_fixtures.os <версия платформы>
//   пример: oscript tasks/create_ib_fixtures.os 8.3.24.1548
#Использовать 1commands

Если АргументыКоманднойСтроки.Количество() < 1 Тогда
	ВызватьИсключение "Укажите версию платформы: oscript tasks/create_ib_fixtures.os 8.3.24.1548";
КонецЕсли;
ВерсияПлатформы = АргументыКоманднойСтроки[0];

КаталогФикстур = ОбъединитьПути(ТекущийКаталог(), "tests", "e2e", "fixtures");
ПустаяИБ = ОбъединитьПути(КаталогФикстур, "empty-ib", "1Cv8.1CD");
ФайлКонфигурации = ОбъединитьПути(КаталогФикстур, "1cv8.cf");
КаталогФикстуры = ОбъединитьПути(КаталогФикстур, "configured-ib");

Если Новый Файл(КаталогФикстуры).Существует() Тогда
	УдалитьФайлы(КаталогФикстуры);
КонецЕсли;
СоздатьКаталог(КаталогФикстуры);
КопироватьФайл(ПустаяИБ, ОбъединитьПути(КаталогФикстуры, "1Cv8.1CD"));

Команда = Новый Команда;
Команда.УстановитьКоманду("oscript");
Команда.ДобавитьПараметр(ОбъединитьПути("src", "main.os"));
Команда.ДобавитьПараметр("cf");
Команда.ДобавитьПараметр("load");
Команда.ДобавитьПараметр("--ibconnection");
Команда.ДобавитьПараметр("/F""" + КаталогФикстуры + """");
Команда.ДобавитьПараметр("--ibcmd");
Команда.ДобавитьПараметр("--v8version");
Команда.ДобавитьПараметр(ВерсияПлатформы);
Команда.ДобавитьПараметр("""" + ФайлКонфигурации + """");
Команда.ПоказыватьВыводНемедленно(Истина);
Если Команда.Исполнить() <> 0 Тогда
	ВызватьИсключение "cf load --ibcmd завершился с ошибкой, фикстура не создана";
КонецЕсли;

// В каталоге должен остаться только файл базы: служебные файлы платформы (*.cfl и т.п.) убираем.
Для Каждого Файл Из НайтиФайлы(КаталогФикстуры, "*", Ложь) Цикл
	Если Файл.Имя <> "1Cv8.1CD" Тогда
		УдалитьФайлы(Файл.ПолноеИмя);
	КонецЕсли;
КонецЦикла;

Сообщить("Фикстура создана: " + ОбъединитьПути(КаталогФикстуры, "1Cv8.1CD")
	+ " (" + Новый Файл(ОбъединитьПути(КаталогФикстуры, "1Cv8.1CD")).Размер() + " байт, платформа " + ВерсияПлатформы + ")");
