// BSLLS-off
// Запуск юнит-тестов (mock-based, без реального 1С).
// Тесты расположены в tests/unit/<категория>/, вспомогательные классы - в tests/unit/utils/.
// Каталог utils/ умышленно НЕ передаётся в oneunit, чтобы хелперы не регистрировались
// как тестовые наборы (приводит к ошибке "уже определена" при двойной регистрации).
#Использовать 1commands

ПутьКОтчетуJUnit = ОбъединитьПути(".", "build", "reports", "junit-unit.xml");
КаталогОтчетов = ОбъединитьПути(".", "build", "reports");
Файл = Новый Файл(КаталогОтчетов);
Если Не Файл.Существует() Тогда
	СоздатьКаталог(КаталогОтчетов);
КонецЕсли;

КаталогиТестов = Новый Массив;
КаталогиТестов.Добавить("tests/unit/Сервисы");
КаталогиТестов.Добавить("tests/unit/Движки");
КаталогиТестов.Добавить("tests/unit/Покрытие");
КаталогиТестов.Добавить("tests/unit/Приложение");

Команда = Новый Команда;
Команда.УстановитьКоманду("oneunit");
Команда.ДобавитьПараметр("execute");
Для Каждого Каталог Из КаталогиТестов Цикл
	Команда.ДобавитьПараметр("-d " + Каталог);
КонецЦикла;
Команда.ДобавитьПараметр("-r");
Команда.ДобавитьПараметр("--junit " + ПутьКОтчетуJUnit);
Команда.ПоказыватьВыводНемедленно(Истина);

КодВозврата = Команда.Исполнить();

Если КодВозврата <> 0 Тогда
	ВызватьИсключение "Юнит-тесты завершились неудачно!";
КонецЕсли;
