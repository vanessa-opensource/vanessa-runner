// BSLLS-off
// Параллельный раннер клиентских e2e-тестов.
//
// Клиент 1С ставится ОДИН РАЗ (в CI-джобе), а тест-ФАЙЛЫ гоняются пулом отдельных
// процессов oneunit: каждый файл — свой процесс + свой временный каталог. Это даёт
// изоляцию, которая лечит рекуррентный Windows-флап «Ошибка при работе с файлом»
// (ibcmd): при последовательном прогоне сосед по набору держал файловую блокировку
// платформы; в пуле у каждого файла отдельный процесс и своя ИБ, соседей нет.
//
// Запуск:  oscript tasks/test_e2e_parallel.os [N] [каталог]
//   N        — число параллельных воркеров (по умолчанию 8)
//   каталог  — корень с тестами (по умолчанию tests/e2e/client-tests)
//
// Отчёты: build/reports/junit-NNN.xml (по файлу) — CI публикует их по маске junit-*.xml.
#Использовать 1commands

Функция ЭтоWindows()
	Возврат СтрНачинаетсяС(Строка(Новый СистемнаяИнформация().ТипПлатформы), "Windows");
КонецФункции

// Команда запуска одного воркера через обёртку tasks/worker.(cmd|sh). Обёртка ставит
// изолированные TEMP/LOCALAPPDATA/APPDATA (кэш платформы 1С не должен пересекаться между
// параллельными процессами) и редиректит вывод в лог. Пути передаются АРГУМЕНТАМИ, а не
// в тело скрипта — так кириллические имена файлов не ломаются кодировкой batch-файла.
Функция КомандаВоркера(Знач КаталогОкр, Знач Файл, Знач Отчет, Знач Лог)
	Кав = Символ(34);
	Аргументы = " " + Кав + КаталогОкр + Кав
		+ " " + Кав + Файл + Кав
		+ " " + Кав + Отчет + Кав
		+ " " + Кав + Лог + Кав;
	Если ЭтоWindows() Тогда
		Возврат "cmd /c " + ОбъединитьПути("tasks", "worker.cmd") + Аргументы;
	Иначе
		Возврат "sh " + ОбъединитьПути("tasks", "worker.sh") + Аргументы;
	КонецЕсли;
КонецФункции

Функция ПрочитатьФайлЦеликом(Знач Путь)
	Если НЕ Новый Файл(Путь).Существует() Тогда
		Возврат "";
	КонецЕсли;
	Чтение = Новый ЧтениеТекста(Путь, "UTF-8");
	Содержимое = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат ?(Содержимое = Неопределено, "", Содержимое);
КонецФункции

// --- Параметры ---
Параллелизм = 8;
Если АргументыКоманднойСтроки.Количество() >= 1 Тогда
	Попытка
		Параллелизм = Число(АргументыКоманднойСтроки[0]);
	Исключение
		Параллелизм = 8;
	КонецПопытки;
КонецЕсли;
Если Параллелизм < 1 Тогда
	Параллелизм = 1;
КонецЕсли;

КаталогТестов = ОбъединитьПути("tests", "e2e", "client-tests");
Если АргументыКоманднойСтроки.Количество() >= 2 Тогда
	КаталогТестов = АргументыКоманднойСтроки[1];
КонецЕсли;

КаталогОтчетов = ОбъединитьПути("build", "reports");
Если НЕ Новый Файл(КаталогОтчетов).Существует() Тогда
	СоздатьКаталог(КаталогОтчетов);
КонецЕсли;

// Чистим прошлые отчёты/логи, чтобы CI не подхватил устаревшие.
Для Каждого Стар Из НайтиФайлы(КаталогОтчетов, "junit-*.xml", Ложь) Цикл
	УдалитьФайлы(Стар.ПолноеИмя);
КонецЦикла;
Для Каждого Стар Из НайтиФайлы(КаталогОтчетов, "log-*.txt", Ложь) Цикл
	УдалитьФайлы(Стар.ПолноеИмя);
КонецЦикла;

// База изолированных окружений воркеров (свой кэш/temp платформы 1С на каждого).
// ВАЖНО: путь абсолютный. TEMP/TMPDIR воркера указывает сюда, а во временном каталоге лежат
// копии фикстур; относительный путь на Linux не резолвится подпроцессами 1С с другим CWD
// (fixture-файл «не найден»), хотя на Windows проходит.
БазаОкружений = ОбъединитьПути(ТекущийКаталог(), "build", "worker-env");
Если Новый Файл(БазаОкружений).Существует() Тогда
	УдалитьФайлы(БазаОкружений);
КонецЕсли;
СоздатьКаталог(БазаОкружений);

// Сборка EPF один раз (на CI .epf отсутствуют — *.epf в .gitignore). Гард по наличию.
ЭталонEPF = ОбъединитьПути("epf", "РаботаСРасширениями.epf");
Если НЕ Новый Файл(ЭталонEPF).Существует() Тогда
	СборкаEpf = Новый Команда;
	СборкаEpf.УстановитьКоманду("oscript");
	СборкаEpf.ДобавитьПараметр("src/main.os");
	СборкаEpf.ДобавитьПараметр("epf");
	СборкаEpf.ДобавитьПараметр("compile");
	СборкаEpf.ДобавитьПараметр("-R");
	СборкаEpf.ДобавитьПараметр("epf");
	СборкаEpf.ПоказыватьВыводНемедленно(Истина);
	Если СборкаEpf.Исполнить() <> 0 Тогда
		ВызватьИсключение "Не удалось собрать EPF-обработки для e2e-тестов";
	КонецЕсли;
КонецЕсли;

// --- Сбор файлов ---
Файлы = НайтиФайлы(КаталогТестов, "Тест*.os", Истина);
ВсегоФайлов = Файлы.Количество();
Сообщить(СтрШаблон("Параллельный прогон: файлов=%1, воркеров=%2, каталог=%3",
	ВсегоФайлов, Параллелизм, КаталогТестов));

// --- Пул ---
СледующийИндекс = 0;
Активные = Новый Массив;   // {Процесс, Файл, Лог}
Результаты = Новый Массив; // {Файл, Код, Лог}

Пока СледующийИндекс < ВсегоФайлов ИЛИ Активные.Количество() > 0 Цикл

	// Дозапуск воркеров до лимита параллелизма.
	Пока Активные.Количество() < Параллелизм И СледующийИндекс < ВсегоФайлов Цикл
		Файл = Файлы[СледующийИндекс];
		Номер = Формат(СледующийИндекс + 1, "ЧЦ=3; ЧВН=; ЧГ=0");
		Отчет = ОбъединитьПути(КаталогОтчетов, "junit-" + Номер + ".xml");
		Лог = ОбъединитьПути(КаталогОтчетов, "log-" + Номер + ".txt");
		КаталогОкр = ОбъединитьПути(БазаОкружений, Номер);
		СоздатьКаталог(ОбъединитьПути(КаталогОкр, "LocalAppData"));
		СоздатьКаталог(ОбъединитьПути(КаталогОкр, "AppData"));
		Проц = СоздатьПроцесс(КомандаВоркера(КаталогОкр, Файл.ПолноеИмя, Отчет, Лог), ТекущийКаталог());
		Проц.Запустить();
		Активные.Добавить(Новый Структура("Процесс,Файл,Лог", Проц, Файл.ПолноеИмя, Лог));
		Сообщить(СтрШаблон("  [старт %1/%2] %3", СледующийИндекс + 1, ВсегоФайлов, Файл.Имя));
		СледующийИндекс = СледующийИндекс + 1;
	КонецЦикла;

	// Сбор завершившихся.
	Ждущие = Новый Массив;
	Для Каждого Работа Из Активные Цикл
		Если Работа.Процесс.Завершен Тогда
			Код = Работа.Процесс.КодВозврата;
			Результаты.Добавить(Новый Структура("Файл,Код,Лог", Работа.Файл, Код, Работа.Лог));
			Сообщить(СтрШаблон("  [готово %1] %2",
				?(Код = 0, "OK", "FAIL(" + Код + ")"), Работа.Файл));
		Иначе
			Ждущие.Добавить(Работа);
		КонецЕсли;
	КонецЦикла;
	Активные = Ждущие;

	Если Активные.Количество() > 0 Тогда
		Приостановить(200);
	КонецЕсли;

КонецЦикла;

// --- Итог: логи упавших наборов + сводка ---
Упало = 0;
Для Каждого Рез Из Результаты Цикл
	Если Рез.Код <> 0 Тогда
		Упало = Упало + 1;
		Сообщить("");
		Сообщить("================= FAIL: " + Рез.Файл + " =================");
		Сообщить(ПрочитатьФайлЦеликом(Рез.Лог));
	КонецЕсли;
КонецЦикла;

Сообщить("");
Сообщить(СтрШаблон("ИТОГ: всего=%1, успешно=%2, упало=%3",
	Результаты.Количество(), Результаты.Количество() - Упало, Упало));

Если Упало > 0 Тогда
	ВызватьИсключение СтрШаблон("Параллельное тестирование завершилось неудачно: упало наборов — %1", Упало);
КонецЕсли;
