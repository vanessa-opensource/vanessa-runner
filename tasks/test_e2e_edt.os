// BSLLS-off
// Раннер EDT-блока e2e-тестов (tests/e2e/edt-tests).
//
// Этот блок ТРЕБУЕТ установленной 1С:EDT (1cedtcli) и поэтому намеренно вынесен
// из основного e2e-прогона (tasks/test_e2e.os -> tests/e2e/client-tests).
// На CI без EDT блок не запускается; запускайте его локально/на раннере с EDT:
//
//   oscript tasks/test_e2e_edt.os
//
// 1cedtcli ищется через библиотеку edtfind (по умолчанию - максимальная версия EDT),
// либо переопределяется переменными VRUNNER_EDT_VERSION / PATH.

#Использовать 1commands

ПутьКОтчетуJUnit = ОбъединитьПути(".", "build", "reports", "junit-edt.xml");
КаталогОтчетов = ОбъединитьПути(".", "build", "reports");
Файл = Новый Файл(КаталогОтчетов);
Если Не Файл.Существует() Тогда
	СоздатьКаталог(КаталогОтчетов);
КонецЕсли;

Команда = Новый Команда;
Команда.УстановитьКоманду("oneunit");
Команда.ДобавитьПараметр("execute");
Команда.ДобавитьПараметр("-d tests/e2e/edt-tests -r");
Команда.ДобавитьПараметр("--junit " + ПутьКОтчетуJUnit);
Команда.ПоказыватьВыводНемедленно(Истина);

КодВозврата = Команда.Исполнить();

Если КодВозврата <> 0 Тогда
	ВызватьИсключение "Тестирование EDT-блока завершилось неудачно!";
КонецЕсли;
