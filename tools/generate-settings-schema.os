// BSLLS:MissingVariablesDescription-off Состояние генератора.
// BSLLS:MissingParameterDescription-off Внутренние функции скрипта.
// BSLLS:MissingReturnedValueDescription-off Внутренние функции скрипта.
// BSLLS:LatinAndCyrillicSymbolInWord-off Ключи JSON Schema.
// BSLLS:DuplicateStringLiteral-off Ключи JSON Schema (description, properties).
// BSLLS:Typo-off Доменные термины (аппендеры, логгеры).
// Генератор JSON Schema файла настроек vrunner (autumn-properties.json).
//
// Источник истины - аннотации команд и наборов опций (&КомандаПриложения, &Опция, &Аргумент,
// &НаборОпций, &Флаговый, &ТЧисло, &ТМассивСтрок, &Перечисление, &ВОкружении), как у справки
// и MCP-моста; ничего не дублируется. Ключ настройки = длинное имя опции, для позиционного
// аргумента - его имя в нижнем регистре. Значения можно задавать для всех команд, группы или
// конкретной команды (см. docs/product/настройка/10-настройки.md), поэтому опции команды
// поднимаются в схему группы и корня объединением.
//
// Использование:
//   oscript tools/generate-settings-schema.os [ФАЙЛ]   (по умолчанию build/vrunner-settings-schema.json)

// oscript-yaml должен загрузиться раньше autumn - причина в src/main.os.
#Использовать oscript-yaml

#Использовать autumn
#Использовать autumn-cli
#Использовать autumn-logos

#Использовать "../src/core/Файлы"
#Использовать "../src/core/Процессы"
#Использовать "../src/core/Движки"
#Использовать "../src/core/Покрытие"
#Использовать "../src/core/Сервисы"
#Использовать "../src/core/Приложение"
#Использовать "../src/core/Настройки"
#Использовать "../src/cli"

Перем Поделка;
Перем ИмяПакета;
Перем Версия;

#Область Схема

Функция СобратьСхему()

	Описание = СтрШаблон("Файл настроек vrunner %1. Ключи секции vrunner - имена опций и аргументов команд;"
		+ " значение можно задать для всех команд, для группы или для конкретной команды.", Версия);

	Схема = Новый Соответствие;
	Схема.Вставить("$schema", "http://json-schema.org/draft-07/schema#");
	Схема.Вставить("$id", "https://github.com/vanessa-opensource/vanessa-runner/releases/latest/download/"
		+ "vrunner-settings-schema.json");
	Схема.Вставить("title", "Настройки vanessa-runner (autumn-properties.json)");
	Схема.Вставить("description", Описание);
	Схема.Вставить("x-vrunner-version", Версия);
	Схема.Вставить("type", "object");

	Свойства = Новый Соответствие;
	Свойства.Вставить("vrunner", СхемаСекцииVrunner());
	Свойства.Вставить("logos", ОбъектСОписанием("Логирование (autumn-logos): уровни логгеров и аппендеры"));
	ДобавитьДетальки(Свойства);
	Схема.Вставить("properties", Свойства);

	Возврат Схема;

КонецФункции

// Секция vrunner: общие ключи, объединение опций всех команд, затем группы с подкомандами.
Функция СхемаСекцииVrunner()

	Команды = ДеревоКоманд();

	СхемаSettings = СхемаЗначения("string", "Дополнительный файл настроек того же формата;"
		+ " накладывается поверх autumn-properties.json (env $VRUNNER_SETTINGS)");
	СхемаLogOutput = СхемаПеречисления(СтрРазделить("stdout,stderr", ","),
		"Поток вывода лога: stdout (по умолчанию) или stderr (env $VRUNNER_LOG_OUTPUT)");

	Свойства = Новый Соответствие;
	Свойства.Вставить("settings", СхемаSettings);
	Свойства.Вставить("log-output", СхемаLogOutput);

	Для Каждого Группа Из Команды Цикл
		Свойства.Вставить(Группа.Имя, СхемаКоманды(Группа));
	КонецЦикла;

	Для Каждого Группа Из Команды Цикл
		ОбъединитьОпции(Свойства, Группа);
	КонецЦикла;

	Возврат СхемаОбъекта(Свойства, "Настройки команд vrunner: общие ключи, группы команд и их подкоманды");

КонецФункции

// Схема команды: собственные опции и аргументы, подкоманды и объединение их опций.
Функция СхемаКоманды(Знач Команда)

	Свойства = Новый Соответствие;
	Для Каждого Подкоманда Из Команда.Подкоманды Цикл
		Свойства.Вставить(Подкоманда.Имя, СхемаКоманды(Подкоманда));
	КонецЦикла;

	Для Каждого Опция Из Команда.Опции Цикл
		Свойства.Вставить(Опция.Ключ, Опция.Значение);
	КонецЦикла;
	Для Каждого Подкоманда Из Команда.Подкоманды Цикл
		ОбъединитьОпции(Свойства, Подкоманда);
	КонецЦикла;

	Возврат СхемаОбъекта(Свойства, Команда.Описание);

КонецФункции

// Поднять опции команды и её подкоманд на уровень выше: опции одного типа сливаются
// (остаётся первое описание), разные типы одного ключа - через anyOf.
Процедура ОбъединитьОпции(Свойства, Знач Команда)

	Для Каждого Опция Из Команда.Опции Цикл
		ДобавитьОбъединяя(Свойства, Опция.Ключ, Опция.Значение);
	КонецЦикла;

	Для Каждого Подкоманда Из Команда.Подкоманды Цикл
		ОбъединитьОпции(Свойства, Подкоманда);
	КонецЦикла;

КонецПроцедуры

// Схема опции - один объект на всех уровнях (команда, группа, корень), поэтому на объединяемый
// уровень кладётся копия: замена описания на общее не должна менять описание у самой команды.
Процедура ДобавитьОбъединяя(Свойства, Знач Ключ, Знач Схема)

	Текущая = Свойства.Получить(Ключ);
	Если Текущая = Неопределено Тогда
		Свойства.Вставить(Ключ, КопияСхемы(Схема));
		Возврат;
	КонецЕсли;

	Если Текущая.Получить("properties") <> Неопределено Тогда
		Возврат; // ключ занят вложенной командой (например, cluster.session)
	КонецЕсли;

	Варианты = Текущая.Получить("anyOf");
	Если Варианты = Неопределено Тогда
		Варианты = Новый Массив;
		Варианты.Добавить(Текущая);
	КонецЕсли;

	Для Каждого Вариант Из Варианты Цикл
		Если СигнатураТипа(Вариант) = СигнатураТипа(Схема) Тогда
			Если Вариант.Получить("description") <> Схема.Получить("description") Тогда
				Вариант.Вставить("description", СтрШаблон("Общее значение --%1 для команд, у которых есть эта опция", Ключ));
			КонецЕсли;
			Возврат;
		КонецЕсли;
	КонецЦикла;

	Варианты.Добавить(КопияСхемы(Схема));
	Объединенная = Новый Соответствие;
	Объединенная.Вставить("anyOf", Варианты);
	Свойства.Вставить(Ключ, Объединенная);

КонецПроцедуры

Функция КопияСхемы(Знач Схема)

	Копия = Новый Соответствие;
	Для Каждого Пара Из Схема Цикл
		Копия.Вставить(Пара.Ключ, Пара.Значение);
	КонецЦикла;
	Возврат Копия;

КонецФункции

// Детальки приложения (&Деталька "секция.ключ") - секции на верхнем уровне файла.
Процедура ДобавитьДетальки(Свойства)

	Для Каждого Определение Из Поделка.ПолучитьОпределенияЖелудей() Цикл
		Для Каждого Параметр Из ПараметрыКонструктора(Определение.Значение) Цикл
			Аннотация = РаботаСАннотациями.НайтиАннотацию(Параметр.Аннотации, "Деталька");
			Если Аннотация = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Путь = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(Аннотация, "Значение", "");
			Если СтрНайти(Путь, ".") = 0 ИЛИ СтрНачинаетсяС(Путь, "logos.") ИЛИ СтрНачинаетсяС(Путь, "core.") Тогда
				Продолжить; // секции библиотек autumn описаны отдельно
			КонецЕсли;
			ПоУмолчанию = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(Аннотация, "ЗначениеПоУмолчанию", "");
			Описание = СтрШаблон("Настройка приложения %1%2", Путь,
				?(ЗначениеЗаполнено(ПоУмолчанию), СтрШаблон(" (по умолчанию: %1)", ПоУмолчанию), ""));
			ДобавитьПоПути(Свойства, СтрРазделить(Путь, "."), СхемаЗначения("string", Описание));
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Функция ПараметрыКонструктора(Знач ОпределениеЖелудя)

	Пусто = Новый Массив;
	Завязь = ОпределениеЖелудя.Завязь();
	Если Завязь = Неопределено Тогда
		Возврат Пусто;
	КонецЕсли;

	ДанныеМетода = Завязь.ДанныеМетода(); // строка таблицы методов рефлектора
	Если ДанныеМетода = Неопределено ИЛИ ДанныеМетода.Владелец().Колонки.Найти("Параметры") = Неопределено Тогда
		Возврат Пусто;
	КонецЕсли;

	Возврат ДанныеМетода.Параметры;

КонецФункции

Процедура ДобавитьПоПути(Свойства, Знач Сегменты, Знач Схема)

	Ключ = Сегменты[0];
	Если Сегменты.Количество() = 1 Тогда
		Свойства.Вставить(Ключ, Схема);
		Возврат;
	КонецЕсли;

	Секция = Свойства.Получить(Ключ);
	Если Секция = Неопределено Тогда
		Секция = ОбъектСОписанием("Секция " + Ключ);
		Свойства.Вставить(Ключ, Секция);
	КонецЕсли;
	Если Секция.Получить("properties") = Неопределено Тогда
		Секция.Вставить("properties", Новый Соответствие);
	КонецЕсли;

	Сегменты.Удалить(0);
	ДобавитьПоПути(Секция.Получить("properties"), Сегменты, Схема);

КонецПроцедуры

#КонецОбласти

#Область Команды

// Дерево команд по аннотациям: Имя, Описание, Опции (ключ -> схема), Подкоманды.
Функция ДеревоКоманд()

	Таблица = Поделка.НайтиЖелуди("КомандаПриложения", Неопределено, "ТаблицаЗначений");

	Узлы = Новый Соответствие; // имя желудя -> узел
	Корни = Новый Массив;
	Для Каждого Строка Из Таблица Цикл
		Аннотация = АннотацияКонструктора(Строка.ОпределениеЖелудя, "КомандаПриложения");
		Имя = ДлинноеИмя(РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(Аннотация, "Имя"));
		Если Имя = "help" Тогда
			Продолжить; // встроенная справка autumn-cli, настроек не имеет
		КонецЕсли;
		Узел = Новый Структура("Имя, Опции, Подкоманды", Имя, ОпцииКоманды(Строка.ОпределениеЖелудя), Новый Массив);
		Узел.Вставить("Описание", РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(Аннотация, "Описание", ""));
		Узел.Вставить("Родитель", РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(Аннотация, "Родитель", ""));
		Узлы.Вставить(Строка.Имя, Узел);
	КонецЦикла;

	Для Каждого Пара Из Узлы Цикл
		Узел = Пара.Значение;
		Родитель = Узлы.Получить(Узел.Родитель);
		Если Родитель = Неопределено Тогда
			Корни.Добавить(Узел);
		Иначе
			Родитель.Подкоманды.Добавить(Узел);
		КонецЕсли;
	КонецЦикла;

	Возврат Корни;

КонецФункции

// Опции и аргументы команды, включая поля подключённых наборов опций.
Функция ОпцииКоманды(Знач ОпределениеЖелудя)

	Опции = Новый Соответствие;
	ДобавитьСвойства(Опции, ОпределениеЖелудя.Свойства());
	Возврат Опции;

КонецФункции

// Набор опций может подключать другой набор (НаборОпцийИсходников -> НаборОпцийEDT),
// поэтому поля наборов раскрываются рекурсивно - как это делает autumn-cli при разборе.
Процедура ДобавитьСвойства(Опции, Знач Свойства)

	Для Каждого Свойство Из Свойства Цикл

		АннотацияНабора = РаботаСАннотациями.ПолучитьАннотацию(Свойство, "НаборОпций");
		Если АннотацияНабора <> Неопределено Тогда
			ИмяНабора = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(АннотацияНабора);
			ДобавитьСвойства(Опции, СвойстваНабора(ИмяНабора));
			Продолжить;
		КонецЕсли;

		ДобавитьОпцию(Опции, Свойство);

	КонецЦикла;

КонецПроцедуры

Функция СвойстваНабора(Знач ИмяНабора)

	Для Каждого Строка Из Поделка.НайтиЖелуди(ИмяНабора, Неопределено, "ТаблицаЗначений") Цикл
		Возврат Строка.ОпределениеЖелудя.Свойства();
	КонецЦикла;

	Возврат Новый Массив;

КонецФункции

Процедура ДобавитьОпцию(Опции, Знач Свойство)

	АннотацияОпции = РаботаСАннотациями.ПолучитьАннотацию(Свойство, "Опция");
	АннотацияАргумента = РаботаСАннотациями.ПолучитьАннотацию(Свойство, "Аргумент");
	Аннотация = ?(АннотацияОпции <> Неопределено, АннотацияОпции, АннотацияАргумента);
	Если Аннотация = Неопределено ИЛИ ИмеетАннотацию(Свойство, "СкрытьВСправке") Тогда
		Возврат;
	КонецЕсли;

	Ключ = ДлинноеИмя(РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(Аннотация, "Имя"));
	Если АннотацияАргумента <> Неопределено Тогда
		Ключ = НРег(Ключ);
	КонецЕсли;
	Если Ключ = "settings" Тогда
		Возврат; // действует только на верхнем уровне секции vrunner, описан там вручную
	КонецЕсли;

	Описание = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(Аннотация, "Описание", "");
	АннотацияОкружения = РаботаСАннотациями.ПолучитьАннотацию(Свойство, "ВОкружении");
	Если АннотацияОкружения <> Неопределено Тогда
		Описание = СтрШаблон("%1 (env $%2)", Описание,
			РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(АннотацияОкружения));
	КонецЕсли;

	Опции.Вставить(Ключ, СхемаОпции(Свойство, Описание));

КонецПроцедуры

Функция СхемаОпции(Знач Свойство, Знач Описание)

	ЭтоФлаг = ИмеетАннотацию(Свойство, "Флаговый") ИЛИ ИмеетАннотацию(Свойство, "Флаг")
		ИЛИ ИмеетАннотацию(Свойство, "ТБулево");
	Если ЭтоФлаг Тогда
		Возврат СхемаЗначения("boolean", Описание);
	КонецЕсли;

	Если ИмеетАннотацию(Свойство, "ТЧисло") Тогда
		Возврат СхемаЗначения("number", Описание);
	КонецЕсли;

	Если ИмеетАннотацию(Свойство, "ТМассивСтрок") ИЛИ ИмеетАннотацию(Свойство, "ТМассивДат") Тогда
		Возврат СхемаМассива("string", Описание);
	КонецЕсли;

	Если ИмеетАннотацию(Свойство, "ТМассивЧисел") Тогда
		Возврат СхемаМассива("number", Описание);
	КонецЕсли;

	Перечисление = Перечисление(Свойство);
	Если Перечисление.Количество() > 0 Тогда
		Возврат СхемаПеречисления(Перечисление, Описание);
	КонецЕсли;

	Возврат СхемаЗначения("string", Описание);

КонецФункции

Функция Перечисление(Знач Свойство)

	Значения = Новый Массив;
	Аннотации = РаботаСАннотациями.ПолучитьАннотации(Свойство, "Перечисление");
	Если Аннотации = Неопределено Тогда
		Возврат Значения;
	КонецЕсли;

	Для Каждого Аннотация Из Аннотации Цикл
		Значение = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(Аннотация, "Значение", Неопределено, Истина);
		Если Значение <> Неопределено Тогда
			Значения.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат Значения;

КонецФункции

Функция АннотацияКонструктора(Знач ОпределениеЖелудя, Знач ИмяАннотации)
	Конструктор = ОпределениеЖелудя.Завязь().ДанныеМетода();
	Возврат РаботаСАннотациями.НайтиАннотацию(Конструктор.Аннотации, ИмяАннотации);
КонецФункции

Функция ИмеетАннотацию(Знач Свойство, Знач ИмяАннотации)
	Возврат РаботаСАннотациями.ПолучитьАннотацию(Свойство, ИмяАннотации) <> Неопределено;
КонецФункции

// Из имени с синонимами ("s src") - самый длинный токен.
Функция ДлинноеИмя(Знач ИмяПолное)

	Результат = "";
	Для Каждого Токен Из СтрРазделить(ИмяПолное, " ", Ложь) Цикл
		Если СтрДлина(Токен) > СтрДлина(Результат) Тогда
			Результат = Токен;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ЭлементыСхемы

Функция СхемаОбъекта(Знач Свойства, Знач Описание)

	Схема = ОбъектСОписанием(Описание);
	Схема.Вставить("properties", Свойства);
	Схема.Вставить("additionalProperties", Ложь);

	Возврат Схема;

КонецФункции

Функция ОбъектСОписанием(Знач Описание)
	Схема = Новый Соответствие;
	Схема.Вставить("type", "object");
	Схема.Вставить("description", Описание);
	Возврат Схема;
КонецФункции

Функция СхемаЗначения(Знач Тип, Знач Описание)
	Схема = Новый Соответствие;
	Схема.Вставить("type", Тип);
	Схема.Вставить("description", Описание);
	Возврат Схема;
КонецФункции

Функция СхемаМассива(Знач ТипЭлемента, Знач Описание)
	Элементы = Новый Соответствие;
	Элементы.Вставить("type", ТипЭлемента);
	Схема = СхемаЗначения("array", Описание);
	Схема.Вставить("items", Элементы);
	Возврат Схема;
КонецФункции

Функция СхемаПеречисления(Знач Значения, Знач Описание)
	Схема = СхемаЗначения("string", Описание);
	Схема.Вставить("enum", Значения);
	Возврат Схема;
КонецФункции

// Тип, элементы массива и перечисление - без описания.
Функция СигнатураТипа(Знач Схема)

	Части = Новый Массив;
	Для Каждого Ключ Из СтрРазделить("type,items,enum", ",") Цикл
		Значение = Схема.Получить(Ключ);
		Если Значение <> Неопределено Тогда
			Запись = Новый ЗаписьJSON;
			Запись.УстановитьСтроку();
			ЗаписатьJSON(Запись, Значение);
			Части.Добавить(Запись.Закрыть());
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Части, "|");

КонецФункции

#КонецОбласти

#Область Запуск

Функция ПостроитьПоделку()

	Настройки = Новый Соответствие;
	Настройки.Вставить("ЗапускатьРогатки", Ложь);
	Детали = Новый Соответствие;
	Детали.Вставить("core", Настройки);

	Совет = Новый СоветДругогоМастера;
	Совет.ЗначенияДеталек(Детали);

	Контекст = Новый Поделка(Совет);
	Контекст.ЗапуститьПриложение();

	Возврат Контекст;

КонецФункции

Функция ПутьВывода()

	Если АргументыКоманднойСтроки.Количество() > 0 Тогда
		Возврат АргументыКоманднойСтроки[0];
	КонецЕсли;

	Возврат ОбъединитьПути(ТекущийКаталог(), "build", "vrunner-settings-schema.json");

КонецФункции

Процедура ЗаписатьСхему(Знач Схема, Знач Путь)

	Каталог = Новый Файл(Путь).Путь;
	Если ЗначениеЗаполнено(Каталог) И НЕ Новый Файл(Каталог).Существует() Тогда
		СоздатьКаталог(Каталог);
	КонецЕсли;

	Запись = Новый ЗаписьJSON;
	Запись.ОткрытьФайл(Путь, "UTF-8", Ложь, Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, "  "));
	ЗаписатьJSON(Запись, Схема);
	Запись.Закрыть();

КонецПроцедуры

Поделка = ПостроитьПоделку();
Описание = Поделка.НайтиЖелудь("ОписаниеКонсольногоПриложения");
ИмяПакета = Описание.ИмяПриложения();
Версия = Описание.ВерсияПриложения();

Путь = ПутьВывода();
ЗаписатьСхему(СобратьСхему(), Путь);
Сообщить(СтрШаблон("Схема настроек %1 %2 записана: %3", ИмяПакета, Версия, Путь));

#КонецОбласти
