// migrate26to30.os
// Конвертирует файл настроек vrunner.json (формат 2.x) в autumn-properties.json (формат 3.0)
//
// Использование:
//   oscript tools/migrate26to30.os [--input <файл>] [--output <файл>]
//
// Параметры:
//   --input  <файл>  Исходный файл настроек (по умолчанию: vrunner.json)
//   --output <файл>  Выходной файл настроек (по умолчанию: autumn-properties.json)
//
// Пример:
//   oscript tools/migrate26to30.os
//   oscript tools/migrate26to30.os --input tools/vrunner.json --output autumn-properties.json

Перем ФайлВвода;
Перем ФайлВывода;
Перем Предупреждения;
Перем КодВыхода;
Перем МаппингСекций;
Перем СекцииСПредупреждением;
Перем ГлобальноеПереименование;

// ============================================================
// Вспомогательные функции
// ============================================================

Функция УбратьПрефикс(Ключ)
    Если Лев(Ключ, 2) = "--" Тогда
        Возврат Сред(Ключ, 3);
    КонецЕсли;
    Возврат Ключ;
КонецФункции

Функция РазбитьПоТочке(Строка)
    Результат = Новый Массив();
    Остаток = Строка;
    Пока Остаток <> "" Цикл
        Поз = Найти(Остаток, ".");
        Если Поз = 0 Тогда
            Результат.Добавить(Остаток);
            Остаток = "";
        Иначе
            Результат.Добавить(Лев(Остаток, Поз - 1));
            Остаток = Сред(Остаток, Поз + 1);
        КонецЕсли;
    КонецЦикла;
    Возврат Результат;
КонецФункции

Функция КопироватьМассив(Исх)
    Рез = Новый Массив();
    Для Каждого Эл Из Исх Цикл
        Рез.Добавить(Эл);
    КонецЦикла;
    Возврат Рез;
КонецФункции

Процедура УстановитьВложенноеЗначение(Корень, МассивКлючей, Значение)
    Текущий = Корень;
    Для Инд = 0 По МассивКлючей.Количество() - 2 Цикл
        К = МассивКлючей[Инд];
        Если Текущий[К] = Неопределено Тогда
            Текущий[К] = Новый Соответствие();
        КонецЕсли;
        Текущий = Текущий[К];
    КонецЦикла;
    Текущий[МассивКлючей[МассивКлючей.Количество() - 1]] = Значение;
КонецПроцедуры

Функция ПреобразоватьКлюч(Ключ)
    ЧистыйКлюч = УбратьПрефикс(Ключ);
    Переименован = ГлобальноеПереименование[ЧистыйКлюч];
    Если Переименован <> Неопределено Тогда
        Возврат Переименован;
    КонецЕсли;
    Возврат ЧистыйКлюч;
КонецФункции

Функция ПреобразоватьЗначение(ЧистыйКлюч, Значение, Секция)
    Если ЧистыйКлюч = "mode" Тогда
        Если ТипЗнч(Значение) = Тип("Массив") Тогда
            НовыеЗначения = Новый Массив();
            Для Каждого Режим Из Значение Цикл
                Если ТипЗнч(Режим) = Тип("Строка") И Лев(Режим, 1) = "-" Тогда
                    НовыеЗначения.Добавить(Сред(Режим, 2));
                    Предупреждения.Добавить("  [" + Секция + "] mode """ + Режим + """ → """ + Сред(Режим, 2) + """ (убран ведущий дефис)");
                Иначе
                    НовыеЗначения.Добавить(Режим);
                КонецЕсли;
            КонецЦикла;
            Возврат НовыеЗначения;
        ИначеЕсли ТипЗнч(Значение) = Тип("Строка") И Лев(Значение, 1) = "-" Тогда
            НовоеЗначение = Сред(Значение, 2);
            Предупреждения.Добавить("  [" + Секция + "] mode """ + Значение + """ → """ + НовоеЗначение + """ (убран ведущий дефис)");
            Возврат НовоеЗначение;
        КонецЕсли;
    КонецЕсли;
    Возврат Значение;
КонецФункции

// ============================================================
// Инициализация
// ============================================================

ФайлВвода  = "vrunner.json";
ФайлВывода = "autumn-properties.json";
Предупреждения = Новый Массив();
КодВыхода = 0;

// Маппинг секций 2.x → путь в иерархии 3.0
МаппингСекций = Новый Соответствие();
МаппингСекций["default"]       = "runner";
МаппингСекций["xunit"]         = "runner.test.xunit";
МаппингСекций["vanessa"]       = "runner.test.vanessa";
МаппингСекций["syntax-check"]  = "runner.validate.syntax-check";
МаппингСекций["compile"]       = "runner.cf.compile";
МаппингСекций["compileconf"]   = "runner.cf.compile";
МаппингСекций["decompile"]     = "runner.cf.decompile";
МаппингСекций["decompileconf"] = "runner.cf.decompile";
МаппингСекций["compileepf"]    = "runner.epf.compile";
МаппингСекций["decompileepf"]  = "runner.epf.decompile";
МаппингСекций["compileext"]    = "runner.cfe.compile";
МаппингСекций["decompileext"]  = "runner.cfe.decompile";
МаппингСекций["updatedb"]      = "runner.infobase.update";
МаппингСекций["run"]           = "runner.run.enterprise";
МаппингСекций["loadrepo"]      = "runner.repo.load";
МаппингСекций["designer"]      = "runner.run.designer";

// Секции без автоконвертации
СекцииСПредупреждением = Новый Массив();
СекцииСПредупреждением.Добавить("init-dev");
СекцииСПредупреждением.Добавить("update-dev");
СекцииСПредупреждением.Добавить("init-project");

// Глобальные переименования ключей
ГлобальноеПереименование = Новый Соответствие();
ГлобальноеПереименование["inputPath"]     = "src";
ГлобальноеПереименование["outputPath"]    = "out";
ГлобальноеПереименование["extensionName"] = "extension-name";

// ============================================================
// Разбор аргументов командной строки
// ============================================================

Инд = 0;
Пока Инд < АргументыКоманднойСтроки.Количество() Цикл
    Арг = АргументыКоманднойСтроки[Инд];
    Если Арг = "--input" И Инд + 1 < АргументыКоманднойСтроки.Количество() Тогда
        ФайлВвода = АргументыКоманднойСтроки[Инд + 1];
        Инд = Инд + 2;
    ИначеЕсли Арг = "--output" И Инд + 1 < АргументыКоманднойСтроки.Количество() Тогда
        ФайлВывода = АргументыКоманднойСтроки[Инд + 1];
        Инд = Инд + 2;
    ИначеЕсли Арг = "--help" Или Арг = "-h" Тогда
        Сообщить("Использование: oscript tools/migrate26to30.os [--input <файл>] [--output <файл>]");
        Сообщить("  --input  <файл>  Исходный файл vrunner.json (по умолчанию: vrunner.json)");
        Сообщить("  --output <файл>  Выходной autumn-properties.json (по умолчанию: autumn-properties.json)");
        ЗавершитьРаботу(0);
    Иначе
        Инд = Инд + 1;
    КонецЕсли;
КонецЦикла;

// ============================================================
// Чтение исходного файла
// ============================================================

ПроверкаФайла = Новый Файл(ФайлВвода);
Если НЕ ПроверкаФайла.Существует() Тогда
    Сообщить("Ошибка: файл не найден: " + ФайлВвода);
    ЗавершитьРаботу(1);
КонецЕсли;

Попытка
    Чтение = Новый ЧтениеJSON();
    Чтение.ОткрытьФайл(ФайлВвода, "UTF-8");
    Исходные = ПрочитатьJSON(Чтение, Истина);
    Чтение.Закрыть();
Исключение
    Сообщить("Ошибка чтения файла " + ФайлВвода + ": " + ОписаниеОшибки());
    ЗавершитьРаботу(1);
КонецПопытки;

Если ТипЗнч(Исходные) <> Тип("Соответствие") Тогда
    Сообщить("Ошибка: " + ФайлВвода + " должен содержать JSON-объект ({}), а не массив или примитив.");
    ЗавершитьРаботу(1);
КонецЕсли;

// ============================================================
// Основная конвертация
// ============================================================

Результат = Новый Соответствие();

Для Каждого КВ Из Исходные Цикл
    Секция = КВ.Ключ;
    Данные  = КВ.Значение;

    // Секции с предупреждением без автоконвертации
    Найдено = Ложь;
    Для Каждого С Из СекцииСПредупреждением Цикл
        Если С = Секция Тогда
            Найдено = Истина;
            Прервать;
        КонецЕсли;
    КонецЦикла;
    Если Найдено Тогда
        Предупреждения.Добавить("  [" + Секция + "] — не мигрирует автоматически. Смотрите: docs/product/миграция/" + Секция + ".md");
        КодВыхода = 1;
        Продолжить;
    КонецЕсли;

    // Неизвестные секции
    ЦелевойПуть = МаппингСекций[Секция];
    Если ЦелевойПуть = Неопределено Тогда
        Предупреждения.Добавить("  [" + Секция + "] — неизвестная секция, пропущена. Обработайте вручную.");
        КодВыхода = 1;
        Продолжить;
    КонецЕсли;

    Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
        Предупреждения.Добавить("  [" + Секция + "] — ожидался объект JSON, секция пропущена.");
        КодВыхода = 1;
        Продолжить;
    КонецЕсли;

    БазовыйМассивКлючей = РазбитьПоТочке(ЦелевойПуть);

    // Специальная обработка: флаги --v1/--v2 в updatedb → rtype
    Если Секция = "updatedb" Тогда
        ЕстьV2 = (Данные["--v2"] = Истина) Или (Данные["v2"] = Истина);
        ЕстьV1 = (Данные["--v1"] = Истина) Или (Данные["v1"] = Истина);
        Если ЕстьV2 Тогда
            Путь = КопироватьМассив(БазовыйМассивКлючей);
            Путь.Добавить("rtype");
            УстановитьВложенноеЗначение(Результат, Путь, "v2");
            Предупреждения.Добавить("  [updatedb] --v2 → infobase.update.rtype = ""v2""");
        ИначеЕсли ЕстьV1 Тогда
            Путь = КопироватьМассив(БазовыйМассивКлючей);
            Путь.Добавить("rtype");
            УстановитьВложенноеЗначение(Результат, Путь, "v1");
            Предупреждения.Добавить("  [updatedb] --v1 → infobase.update.rtype = ""v1""");
        КонецЕсли;
    КонецЕсли;

    // Предупреждение об устаревшем --reportxunit
    Если Данные["--reportxunit"] <> Неопределено Или Данные["reportxunit"] <> Неопределено Тогда
        Предупреждения.Добавить("  [" + Секция + "] --reportxunit устарел → используйте reportsxunit с форматом ""jUnit{./путь/report.xml}""");
    КонецЕсли;

    // Предупреждение об устаревшем testsPath
    Если Данные["testsPath"] <> Неопределено Тогда
        Предупреждения.Добавить("  [" + Секция + "] testsPath не переносится — передавайте путь позиционным аргументом CLI или через VRUNNER_TESTSPATH");
    КонецЕсли;

    // Перебор ключей секции
    Для Каждого КВДанных Из Данные Цикл
        КлючИсх = КВДанных.Ключ;
        ЗначИсх = КВДанных.Значение;

        ЧистыйКлюч = УбратьПрефикс(КлючИсх);

        // Пропустить флаги v1/v2 в updatedb (уже обработаны)
        Если (ЧистыйКлюч = "v1" Или ЧистыйКлюч = "v2") И Секция = "updatedb" Тогда
            Продолжить;
        КонецЕсли;

        // Пропустить testsPath
        Если ЧистыйКлюч = "testsPath" Тогда
            Продолжить;
        КонецЕсли;

        НовыйКлюч     = ПреобразоватьКлюч(КлючИсх);
        НовоеЗначение = ПреобразоватьЗначение(НовыйКлюч, ЗначИсх, Секция);

        Путь = КопироватьМассив(БазовыйМассивКлючей);
        Путь.Добавить(НовыйКлюч);
        УстановитьВложенноеЗначение(Результат, Путь, НовоеЗначение);
    КонецЦикла;
КонецЦикла;

// ============================================================
// Запись результата
// ============================================================

Попытка
    ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, "  ");
    Запись = Новый ЗаписьJSON();
    Запись.ОткрытьФайл(ФайлВывода, "UTF-8", , ПараметрыЗаписи);
    ЗаписатьJSON(Запись, Результат);
    Запись.Закрыть();
Исключение
    Сообщить("Ошибка записи файла " + ФайлВывода + ": " + ОписаниеОшибки());
    ЗавершитьРаботу(1);
КонецПопытки;

// ============================================================
// Итоговый вывод
// ============================================================

Сообщить("Готово: " + ФайлВывода);

Если Предупреждения.Количество() > 0 Тогда
    Сообщить("");
    Сообщить("Предупреждения (" + Предупреждения.Количество() + ") — требуют ручной проверки:");
    Для Каждого Пред Из Предупреждения Цикл
        Сообщить(Пред);
    КонецЦикла;
    Сообщить("");
    Сообщить("Проверьте " + ФайлВывода + " перед использованием.");
    Сообщить("Документация: docs/product/миграция/");
КонецЕсли;

ЗавершитьРаботу(КодВыхода);
