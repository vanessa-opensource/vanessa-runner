// BSLLS-off
// Тестовый набор: cf load из исходников в формате 1С:EDT.
// Загрузка конфигурации из готового EDT-проекта в информационную базу
// (vrunner экспортирует EDT -> XML через 1cedtcli, затем грузит XML в базу платформой).
//
// ВНИМАНИЕ: EDT-блок (tests/e2e/edt-tests) ТРЕБУЕТ установленной 1С:EDT (1cedtcli)
// и намеренно вынесен из client-tests, поэтому на CI без EDT не запускается.
// Запуск блока: oscript tasks/test_e2e_edt.os
//
// Фикстура: tests/e2e/fixtures/edt/Конфигурация - готовый EDT-проект конфигурации.

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands
#Использовать "../../utils"

Перем НакопленныеВременныеФайлы;
Перем КаталогБазы;

#Область СлужебныйПрограммныйИнтерфейс

// Загрузка EDT-исходников конфигурации в существующую базу.
&Тест
Процедура ТестДолжен_ЗагрузитьВБазуИзEDTИсходников() Экспорт

	// Дано - копия EDT-фикстуры и пустая база
	Исполнитель = СоздатьИсполнителя();
	КаталогEDT = СкопироватьФикстуруEDT(Исполнитель);
	СтрокаПодключения = "/F""" + КаталогБазы + """";
	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Исполнитель.ДобавитьОпцию("--src-format", "edt");
	Исполнитель.ДобавитьАргумент(КаталогEDT);

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "загрузка конфигурации из EDT-исходников в базу");

КонецПроцедуры

// Инкрементальная загрузка из EDT: первый запуск - полная (строит индекс по EDT-исходникам),
// второй после правки модуля объекта - выборочная загрузка XML-файлов изменённого объекта.
&Тест
Процедура ТестДолжен_ПоддерживатьИнкрементальнуюЗагрузкуИзEDT() Экспорт

	// Дано - копия EDT-фикстуры и пустая база
	Исполнитель = СоздатьИсполнителя();
	КаталогEDT = СкопироватьФикстуруEDT(Исполнитель);
	СтрокаПодключения = "/F""" + КаталогБазы + """";
	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Исполнитель.ДобавитьОпцию("--src-format", "edt");
	Исполнитель.ДобавитьФлаг("--increment");
	Исполнитель.ДобавитьАргумент(КаталогEDT);

	// Когда - первый запуск (индекса ещё нет)
	Исполнитель.ВыполнитьКоманду();

	// Тогда - полная загрузка по EDT-пути
	Исполнитель.ОжидаемЧтоКодВозврата(0, "первая инкрементальная загрузка из EDT");
	Исполнитель.ОжидаемЧтоВыводСодержит("Инкрементальная загрузка (EDT): индекс не найден");

	// И - изменяем модуль объекта Справочник1
	ПутьКМодулю = ОбъединитьПути(КаталогEDT, "src", "Catalogs", "Справочник1");
	ПутьКМодулю = ОбъединитьПути(ПутьКМодулю, "ObjectModule.bsl");
	ДобавитьМетодВМодуль(ПутьКМодулю);

	// Когда - второй запуск после изменения
	Исполнитель.ВыполнитьКоманду();

	// Тогда - выборочная загрузка XML-файлов изменённого объекта
	Исполнитель.ОжидаемЧтоКодВозврата(0, "вторая инкрементальная загрузка из EDT");
	Исполнитель.ОжидаемЧтоВыводСодержит("Инкрементальная загрузка: будет загружено");
	Исполнитель.ОжидаемЧтоВыводСодержит("ObjectModule.bsl");
	Исполнитель.ОжидаемЧтоВыводНеСодержит("изменений в исходниках не найдено");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
	КаталогБазы = ФикстурнаяФайловаяБД.СкопироватьВоВременнойКаталог();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсполнителя()
	Аргументы = Новый Массив;
	Аргументы.Добавить("cf");
	Аргументы.Добавить("load");
	Исполнитель = Новый ИсполнительCLI(Аргументы);
	// Тесты проверяют экспорт EDT и загрузку: обновление конфигурации БД (по умолчанию) отключаем.
	Исполнитель.ДобавитьФлаг("--no-update-db");
	Возврат Исполнитель;
КонецФункции

// Скопировать EDT-фикстуру конфигурации во временный каталог.
Функция СкопироватьФикстуруEDT(Исполнитель)
	Источник = Исполнитель.ПутьФикстуры("edt", "Конфигурация");
	Назначение = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "Конфигурация");
	КопироватьКаталог(Источник, Назначение);
	Возврат Назначение;
КонецФункции

Процедура КопироватьКаталог(Знач КаталогИсточник, Знач КаталогНазначения)

	ПрефиксИсточника = Новый Файл(КаталогИсточник).ПолноеИмя;
	Разделитель = ПолучитьРазделительПути();
	Если Прав(ПрефиксИсточника, 1) <> Разделитель Тогда
		ПрефиксИсточника = ПрефиксИсточника + Разделитель;
	КонецЕсли;

	Элементы = НайтиФайлы(ПрефиксИсточника, "*", Истина);
	Для Каждого Элемент Из Элементы Цикл
		Если НЕ Элемент.ЭтоФайл() Тогда
			Продолжить;
		КонецЕсли;
		ОтносительныйПуть = Сред(Элемент.ПолноеИмя, СтрДлина(ПрефиксИсточника) + 1);
		ПутьНазначения = ОбъединитьПути(КаталогНазначения, ОтносительныйПуть);
		КаталогФайлаНазначения = Новый Файл(ПутьНазначения).Путь;
		Если НЕ Новый Файл(КаталогФайлаНазначения).Существует() Тогда
			СоздатьКаталог(КаталогФайлаНазначения);
		КонецЕсли;
		КопироватьФайл(Элемент.ПолноеИмя, ПутьНазначения);
	КонецЦикла;

КонецПроцедуры

// Дописать в модуль новый метод, чтобы изменить его содержимое (и размер) для детекта инкрементом.
Процедура ДобавитьМетодВМодуль(Знач ПутьКМодулю)

	Чтение = Новый ЧтениеТекста(ПутьКМодулю, "UTF-8");
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();

	ИмяМетода = "ТестовыйИнкремент_" + Формат(ТекущаяДата(), "ДФ=yyyyMMddHHmmss");
	Дополнение = Символы.ПС
		+ "Процедура " + ИмяМетода + "() Экспорт" + Символы.ПС
		+ "КонецПроцедуры" + Символы.ПС;

	Запись = Новый ЗаписьТекста(ПутьКМодулю, "UTF-8");
	Запись.Записать(Текст + Дополнение);
	Запись.Закрыть();

КонецПроцедуры

#КонецОбласти
