// BSLLS-off
// Тестовый набор: cf compile из исходников в формате 1С:EDT.
// Сборка конфигурации из готового EDT-проекта в файл .cf
// (vrunner экспортирует EDT -> XML через 1cedtcli, затем собирает .cf платформой).
//
// ВНИМАНИЕ: EDT-блок (tests/e2e/edt-tests) ТРЕБУЕТ установленной 1С:EDT (1cedtcli)
// и намеренно вынесен из client-tests, поэтому на CI без EDT не запускается.
// Запуск блока: oscript tasks/test_e2e_edt.os
//
// Фикстура: tests/e2e/fixtures/edt/Конфигурация - готовый EDT-проект конфигурации.

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands
#Использовать "../../utils"

Перем НакопленныеВременныеФайлы;

#Область СлужебныйПрограммныйИнтерфейс

// Сборка .cf из EDT-исходников конфигурации.
&Тест
Процедура ТестДолжен_СобратьCfИзEDTИсходников() Экспорт

	// Дано - копия EDT-фикстуры (чтобы не менять коммитнутую)
	Исполнитель = СоздатьИсполнителя();
	КаталогEDT = СкопироватьФикстуруEDT(Исполнитель);
	Исполнитель.ДобавитьОпцию("--src", КаталогEDT);
	Исполнитель.ДобавитьОпцию("--src-format", "edt");
	Исполнитель.ДобавитьАргумент("1Cv8.cf");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "сборка .cf из EDT-исходников");
	Исполнитель.ОжидаемЧтоФайлСуществует("1Cv8.cf");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсполнителя()
	Аргументы = Новый Массив;
	Аргументы.Добавить("cf");
	Аргументы.Добавить("compile");
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

// Скопировать EDT-фикстуру конфигурации во временный каталог.
Функция СкопироватьФикстуруEDT(Исполнитель)
	Источник = Исполнитель.ПутьФикстуры("edt", "Конфигурация");
	Назначение = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "Конфигурация");
	КопироватьКаталог(Источник, Назначение);
	Возврат Назначение;
КонецФункции

Процедура КопироватьКаталог(Знач КаталогИсточник, Знач КаталогНазначения)

	ПрефиксИсточника = Новый Файл(КаталогИсточник).ПолноеИмя;
	Разделитель = ПолучитьРазделительПути();
	Если Прав(ПрефиксИсточника, 1) <> Разделитель Тогда
		ПрефиксИсточника = ПрефиксИсточника + Разделитель;
	КонецЕсли;

	Элементы = НайтиФайлы(ПрефиксИсточника, "*", Истина);
	Для Каждого Элемент Из Элементы Цикл
		Если НЕ Элемент.ЭтоФайл() Тогда
			Продолжить;
		КонецЕсли;
		ОтносительныйПуть = Сред(Элемент.ПолноеИмя, СтрДлина(ПрефиксИсточника) + 1);
		ПутьНазначения = ОбъединитьПути(КаталогНазначения, ОтносительныйПуть);
		КаталогФайлаНазначения = Новый Файл(ПутьНазначения).Путь;
		Если НЕ Новый Файл(КаталогФайлаНазначения).Существует() Тогда
			СоздатьКаталог(КаталогФайлаНазначения);
		КонецЕсли;
		КопироватьФайл(Элемент.ПолноеИмя, ПутьНазначения);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
