// BSLLS-off
// Тестовый набор: cf decompile в формат 1С:EDT.
// Разборка файла .cf в готовый EDT-проект конфигурации
// (vrunner выгружает .cf -> XML платформой, затем импортирует XML -> EDT через 1cedtcli).
//
// ВНИМАНИЕ: EDT-блок (tests/e2e/edt-tests) ТРЕБУЕТ установленной 1С:EDT (1cedtcli)
// и намеренно вынесен из client-tests, поэтому на CI без EDT не запускается.
// Запуск блока: oscript tasks/test_e2e_edt.os
//
// Фикстуры: tests/e2e/fixtures/cf - XML-исходники конфигурации (для сборки .cf).

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands
#Использовать v8runner
#Использовать "../../utils"

Перем НакопленныеВременныеФайлы;

#Область СлужебныйПрограммныйИнтерфейс

// Разборка .cf в EDT-проект конфигурации.
&Тест
Процедура ТестДолжен_РазобратьCfВEDTИсходники() Экспорт

	// Дано - собираем .cf из XML-фикстуры
	ПутьCf = СобратьCfИзФикстур();

	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьОпцию("--cf-file", ПутьCf);
	Исполнитель.ДобавитьОпцию("--src-format", "edt");
	Исполнитель.ДобавитьАргумент("edt-out");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда - получен EDT-проект
	Исполнитель.ОжидаемЧтоКодВозврата(0, "разборка .cf в формат EDT");
	Исполнитель.ОжидаемЧтоФайлСуществует(ОбъединитьПути("edt-out", ".project"));
	Исполнитель.ОжидаемЧтоКаталогСуществует(ОбъединитьПути("edt-out", "src"));

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсполнителя()
	Аргументы = Новый Массив;
	Аргументы.Добавить("cf");
	Аргументы.Добавить("decompile");
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

// Собрать .cf из XML-фикстуры конфигурации (через УправлениеКонфигуратором).
Функция СобратьCfИзФикстур()
	КаталогБазы = ФикстурнаяФайловаяБД.СкопироватьВоВременнойКаталог();
	КаталогSrc = СоздатьИсполнителя().ПутьФикстуры("cf");
	Конфигуратор = Новый УправлениеКонфигуратором;
	Конфигуратор.УстановитьКонтекст("/F""" + КаталогБазы + """", "", "");
	Конфигуратор.ЗагрузитьКонфигурациюИзФайлов(КаталогSrc);
	ПутьCf = ВременныеФайлы.НовоеИмяФайла("cf");
	Конфигуратор.ВыгрузитьКонфигурациюВФайл(ПутьCf);
	Возврат ПутьCf;
КонецФункции

#КонецОбласти
