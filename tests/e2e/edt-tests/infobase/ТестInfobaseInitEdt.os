// BSLLS-off
// Тестовый набор: infobase init с загрузкой расширений из исходников 1С:EDT.
// Проверяет загрузку нескольких расширений разных типов одной командой:
// EDT-проект расширения (vrunner экспортирует EDT -> XML через 1cedtcli) и
// каталог XML-исходников. Формат каждого каталога определяется автоматически
// (EDT по .project, XML по Configuration.xml).
//
// ВНИМАНИЕ: EDT-блок (tests/e2e/edt-tests) ТРЕБУЕТ установленной 1С:EDT (1cedtcli)
// и намеренно вынесен из client-tests, поэтому на CI без EDT не запускается.
// Запуск блока: oscript tasks/test_e2e_edt.os
//
// Фикстуры: tests/e2e/fixtures/edt/Расширение - EDT-проект расширения (имя "test");
//           tests/e2e/fixtures/cfe2 - XML-исходники второго расширения (имя "secondext").

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands
#Использовать "../../utils"

Перем НакопленныеВременныеФайлы;

#Область СлужебныйПрограммныйИнтерфейс

// Создание базы и загрузка двух расширений разных типов одной командой:
// EDT-проект и каталог XML-исходников. Формат каждого определяется автоматически.
&Тест
Процедура ТестДолжен_ЗагрузитьРасширенияРазныхТиповВключаяEDT() Экспорт

	// Дано - EDT-проект расширения (копия) и каталог XML-исходников второго расширения
	Исполнитель = СоздатьИсполнителя();
	КаталогEDT = СкопироватьФикстуруEDT(Исполнитель);
	КаталогXml = Исполнитель.ПутьФикстуры("cfe2");
	Исполнитель.ДобавитьОпцию("--ext", КаталогEDT);
	Исполнитель.ДобавитьОпцию("--ext", КаталогXml);
	// --src-format не задаём: формат каждого каталога определяется автоматически

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "загрузка расширений разных типов (EDT и XML) при инициализации");
	Исполнитель.ОжидаемЧтоКаталогСуществует(ОбъединитьПути("build", "ib"));

КонецПроцедуры

// Загрузка одного расширения из EDT-исходников с явным --src-format edt.
&Тест
Процедура ТестДолжен_ЗагрузитьРасширениеИзEDTСЯвнымФорматом() Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителя();
	КаталогEDT = СкопироватьФикстуруEDT(Исполнитель);
	Исполнитель.ДобавитьОпцию("--ext", КаталогEDT);
	Исполнитель.ДобавитьОпцию("--src-format", "edt");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "загрузка расширения из EDT-исходников при инициализации");
	Исполнитель.ОжидаемЧтоКаталогСуществует(ОбъединитьПути("build", "ib"));

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсполнителя()
	Аргументы = Новый Массив;
	Аргументы.Добавить("infobase");
	Аргументы.Добавить("init");
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

// Скопировать EDT-фикстуру расширения во временный каталог
// (экспорт через 1cedtcli может писать служебные данные в каталог проекта).
Функция СкопироватьФикстуруEDT(Исполнитель)
	Источник = Исполнитель.ПутьФикстуры("edt", "Расширение");
	Назначение = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "Расширение");
	КопироватьКаталог(Источник, Назначение);
	Возврат Назначение;
КонецФункции

Процедура КопироватьКаталог(Знач КаталогИсточник, Знач КаталогНазначения)

	ПрефиксИсточника = Новый Файл(КаталогИсточник).ПолноеИмя;
	Разделитель = ПолучитьРазделительПути();
	Если Прав(ПрефиксИсточника, 1) <> Разделитель Тогда
		ПрефиксИсточника = ПрефиксИсточника + Разделитель;
	КонецЕсли;

	Элементы = НайтиФайлы(ПрефиксИсточника, "*", Истина);
	Для Каждого Элемент Из Элементы Цикл
		Если НЕ Элемент.ЭтоФайл() Тогда
			Продолжить;
		КонецЕсли;
		ОтносительныйПуть = Сред(Элемент.ПолноеИмя, СтрДлина(ПрефиксИсточника) + 1);
		ПутьНазначения = ОбъединитьПути(КаталогНазначения, ОтносительныйПуть);
		КаталогФайлаНазначения = Новый Файл(ПутьНазначения).Путь;
		Если НЕ Новый Файл(КаталогФайлаНазначения).Существует() Тогда
			СоздатьКаталог(КаталогФайлаНазначения);
		КонецЕсли;
		КопироватьФайл(Элемент.ПолноеИмя, ПутьНазначения);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
