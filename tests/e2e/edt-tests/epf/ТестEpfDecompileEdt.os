// BSLLS-off
// Тестовый набор: команда `epf decompile --src-format edt` - разборка внешней обработки (.epf)
// в EDT-проект внешних объектов. .epf → XML Конфигуратором/ibcmd → импорт (import 1cedtcli) в EDT.
//
// ВНИМАНИЕ: EDT-блок (tests/e2e/edt-tests) ТРЕБУЕТ установленной 1С:EDT (1cedtcli) И платформы
// 1С:Предприятие, поэтому намеренно вынесен из client-tests. Запуск: oscript tasks/test_e2e_edt.os
//
// Фикстура: tests/e2e/fixtures/epf/ТестоваяОбработка - XML-исходники обработки (сначала собираем .epf).

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands
#Использовать "../../utils"

Перем НакопленныеВременныеФайлы;

#Область СлужебныйПрограммныйИнтерфейс

// Разборка .epf в EDT-проект. Прогоняется дважды: с ibcmd и через конфигуратор.
&ПараметризованныйТест
&ИсточникЗначение("ibcmd")
&ИсточникЗначение("designer")
Процедура ТестДолжен_РазобратьEpfВEDTПроект(Режим) Экспорт

	// Дано - собранный .epf из XML-фикстуры
	ПутьEpf = СобратьОбработкуИзФикстуры("ТестоваяОбработка", Режим);
	КаталогEDT = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "edt");

	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьОпцию("--src-format", "edt");
	Исполнитель.ДобавитьОпцию("--out", КаталогEDT);
	ДобавитьФлагРежима(Исполнитель, Режим);
	Исполнитель.ДобавитьАргумент(ПутьEpf);

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда - получен EDT-проект внешних объектов
	Исполнитель.ОжидаемЧтоКодВозврата(0, "разборка .epf в EDT-проект");
	Ожидаем.Что(Новый Файл(ОбъединитьПути(КаталогEDT, ".project")).Существует(),
		"в каталоге назначения создан .project").ЭтоИстина();
	ПутьMdo = ОбъединитьПути(ОбъединитьПути(КаталогEDT, "src", "ExternalDataProcessors"),
		"ТестоваяОбработка", "ТестоваяОбработка.mdo");
	Ожидаем.Что(Новый Файл(ПутьMdo).Существует(), "импортирована ТестоваяОбработка.mdo").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсполнителя()
	Аргументы = Новый Массив;
	Аргументы.Добавить("epf");
	Аргументы.Добавить("decompile");
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

Функция СобратьОбработкуИзФикстуры(Знач ИмяОбработки, Знач Режим)

	ИсполнительСборки = СоздатьИсполнителяСборки();
	КаталогSrc = ИсполнительСборки.ПутьФикстуры("epf", ИмяОбработки);
	ИсполнительСборки.ДобавитьОпцию("--out", ИсполнительСборки.КаталогРаботы());
	ДобавитьФлагРежима(ИсполнительСборки, Режим);
	ИсполнительСборки.ДобавитьАргумент(КаталогSrc);
	ИсполнительСборки.ВыполнитьКоманду();

	Ожидаем.Что(ИсполнительСборки.КодВозврата(), "сборка фикстуры .epf").Равно(0);
	Возврат ОбъединитьПути(ИсполнительСборки.КаталогРаботы(), ИмяОбработки + ".epf");

КонецФункции

Функция СоздатьИсполнителяСборки()
	Аргументы = Новый Массив;
	Аргументы.Добавить("epf");
	Аргументы.Добавить("compile");
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

Процедура ДобавитьФлагРежима(Исполнитель, Режим)
	Если Режим = "ibcmd" Тогда
		Исполнитель.ДобавитьФлаг("--ibcmd");
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
