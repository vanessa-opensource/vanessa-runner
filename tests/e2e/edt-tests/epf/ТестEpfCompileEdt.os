// BSLLS-off
// Тестовый набор: команда `epf compile --src-format edt` - сборка внешних обработок (.epf)
// из EDT-проекта внешних объектов. EDT → XML (export 1cedtcli) → сборка .epf Конфигуратором/ibcmd.
//
// ВНИМАНИЕ: EDT-блок (tests/e2e/edt-tests) ТРЕБУЕТ установленной 1С:EDT (1cedtcli) И платформы
// 1С:Предприятие, поэтому намеренно вынесен из client-tests. Запуск: oscript tasks/test_e2e_edt.os
//
// Фикстура: tests/e2e/fixtures/edt/ВнешниеОбработки - EDT-проект с двумя обработками.

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands
#Использовать "../../utils"

Перем НакопленныеВременныеФайлы;

#Область СлужебныйПрограммныйИнтерфейс

// Сборка .epf из EDT-проекта. Прогоняется дважды: с ibcmd и через конфигуратор.
&ПараметризованныйТест
&ИсточникЗначение("ibcmd")
&ИсточникЗначение("designer")
Процедура ТестДолжен_СобратьEpfИзEDTПроекта(Режим) Экспорт

	// Дано - копия EDT-фикстуры проекта внешних обработок
	Исполнитель = СоздатьИсполнителя();
	КаталогEDT = СкопироватьФикстуруEDT(Исполнитель, "ВнешниеОбработки");

	Исполнитель.ДобавитьОпцию("--src-format", "edt");
	Исполнитель.ДобавитьОпцию("--out", Исполнитель.КаталогРаботы());
	ДобавитьФлагРежима(Исполнитель, Режим);
	Исполнитель.ДобавитьАргумент(КаталогEDT);

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда - обе обработки собраны в .epf
	Исполнитель.ОжидаемЧтоКодВозврата(0, "сборка .epf из EDT-проекта");
	Исполнитель.ОжидаемЧтоФайлСуществует("ТестоваяОбработка.epf");
	Исполнитель.ОжидаемЧтоФайлСуществует("ВтораяОбработка.epf");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсполнителя()
	Аргументы = Новый Массив;
	Аргументы.Добавить("epf");
	Аргументы.Добавить("compile");
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

Процедура ДобавитьФлагРежима(Исполнитель, Режим)
	Если Режим = "ibcmd" Тогда
		Исполнитель.ДобавитьФлаг("--ibcmd");
	КонецЕсли;
КонецПроцедуры

Функция СкопироватьФикстуруEDT(Исполнитель, Знач ИмяПроекта)
	Источник = Исполнитель.ПутьФикстуры("edt", ИмяПроекта);
	Назначение = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), ИмяПроекта);
	КопироватьКаталог(Источник, Назначение);
	Возврат Назначение;
КонецФункции

Процедура КопироватьКаталог(Знач КаталогИсточник, Знач КаталогНазначения)

	ПрефиксИсточника = Новый Файл(КаталогИсточник).ПолноеИмя;
	Разделитель = ПолучитьРазделительПути();
	Если Прав(ПрефиксИсточника, 1) <> Разделитель Тогда
		ПрефиксИсточника = ПрефиксИсточника + Разделитель;
	КонецЕсли;

	Элементы = НайтиФайлы(ПрефиксИсточника, "*", Истина);
	Для Каждого Элемент Из Элементы Цикл
		Если НЕ Элемент.ЭтоФайл() Тогда
			Продолжить;
		КонецЕсли;
		ОтносительныйПуть = Сред(Элемент.ПолноеИмя, СтрДлина(ПрефиксИсточника) + 1);
		ПутьНазначения = ОбъединитьПути(КаталогНазначения, ОтносительныйПуть);
		КаталогФайлаНазначения = Новый Файл(ПутьНазначения).Путь;
		Если НЕ Новый Файл(КаталогФайлаНазначения).Существует() Тогда
			СоздатьКаталог(КаталогФайлаНазначения);
		КонецЕсли;
		КопироватьФайл(Элемент.ПолноеИмя, ПутьНазначения);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
