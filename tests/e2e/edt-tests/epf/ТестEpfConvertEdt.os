// BSLLS-off
// Тестовый набор: команда `epf convert` - двунаправленная конвертация внешних отчётов
// и обработок между форматами 1С:EDT и XML Конфигуратора (issue #728).
//
// Направление определяется автоматически (штатные export/import 1cedtcli, без сборки
// .epf и без временной информационной базы):
//   EDT-проект → XML-дампы (ExternalDataProcessors/ + ExternalReports/, по <Имя>.xml);
//   XML-дампы  → EDT-проект внешних объектов.
//
// ВНИМАНИЕ: EDT-блок (tests/e2e/edt-tests) ТРЕБУЕТ установленной 1С:EDT (1cedtcli)
// и намеренно вынесен из client-tests, поэтому на CI без EDT не запускается.
// Запуск блока: oscript tasks/test_e2e_edt.os
//
// Фикстура: tests/e2e/fixtures/edt/ВнешниеОбработки - готовый EDT-проект внешних
// обработок (V8ExternalObjectsNature) с двумя обработками.

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands
#Использовать "../../utils"

Перем НакопленныеВременныеФайлы;

#Область СлужебныйПрограммныйИнтерфейс

// EDT → XML: обе обработки выгружены, корневой XML - настоящий дамп ExternalDataProcessor.
&Тест
Процедура ТестДолжен_КонвертироватьПроектВнешнихОбработокEDTвXML() Экспорт

	// Дано - копия EDT-фикстуры проекта внешних обработок
	Исполнитель = СоздатьИсполнителя();
	КаталогEDT = СкопироватьФикстуруEDT(Исполнитель, "ВнешниеОбработки");
	КаталогXML = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "xml");

	Исполнитель.ДобавитьОпцию("--src", КаталогEDT);
	Исполнитель.ДобавитьАргумент(КаталогXML);

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда - обе обработки выгружены в ExternalDataProcessors/, XML содержит объект
	Исполнитель.ОжидаемЧтоКодВозврата(0, "конвертация EDT → XML");
	Исполнитель.ОжидаемЧтоВыводСодержит("EDT → XML");
	ПутьXml = ОбъединитьПути(КаталогXML, "ExternalDataProcessors", "ТестоваяОбработка.xml");
	Ожидаем.Что(Новый Файл(ПутьXml).Существует(), "выгружен ТестоваяОбработка.xml").ЭтоИстина();
	Ожидаем.Что(Новый Файл(ОбъединитьПути(КаталогXML, "ExternalDataProcessors", "ВтораяОбработка.xml")).Существует(),
		"выгружен ВтораяОбработка.xml").ЭтоИстина();
	Ожидаем.Что(ПрочитатьТекст(ПутьXml), "XML содержит объект ExternalDataProcessor").Содержит("ExternalDataProcessor");

КонецПроцедуры

// Round-trip: EDT → XML → EDT. Обратная конвертация восстанавливает EDT-проект внешних объектов.
&Тест
Процедура ТестДолжен_КонвертироватьВнешниеОбъектыEDTвXMLиОбратно() Экспорт

	// Дано - EDT-фикстура → XML
	Исполнитель1 = СоздатьИсполнителя();
	КаталогEDT = СкопироватьФикстуруEDT(Исполнитель1, "ВнешниеОбработки");
	КаталогXML = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "xml");
	Исполнитель1.ДобавитьОпцию("--src", КаталогEDT);
	Исполнитель1.ДобавитьАргумент(КаталогXML);
	Исполнитель1.ВыполнитьКоманду();
	Исполнитель1.ОжидаемЧтоКодВозврата(0, "конвертация EDT → XML");

	// Когда - обратная конвертация XML → EDT
	КаталогEDTОбратно = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "edt");
	Исполнитель2 = СоздатьИсполнителя();
	Исполнитель2.ДобавитьОпцию("--src", КаталогXML);
	Исполнитель2.ДобавитьАргумент(КаталогEDTОбратно);
	Исполнитель2.ВыполнитьКоманду();

	// Тогда - получен EDT-проект внешних объектов с исходной обработкой
	Исполнитель2.ОжидаемЧтоКодВозврата(0, "конвертация XML → EDT");
	Исполнитель2.ОжидаемЧтоВыводСодержит("XML → EDT");
	Ожидаем.Что(Новый Файл(ОбъединитьПути(КаталогEDTОбратно, ".project")).Существует(),
		"в каталоге назначения создан .project").ЭтоИстина();
	ПутьMdo = ОбъединитьПути(ОбъединитьПути(КаталогEDTОбратно, "src", "ExternalDataProcessors"),
		"ТестоваяОбработка", "ТестоваяОбработка.mdo");
	Ожидаем.Что(Новый Файл(ПутьMdo).Существует(), "импортирована ТестоваяОбработка.mdo").ЭтоИстина();

КонецПроцедуры

// Источник не является ни EDT-проектом, ни XML-дампом внешних объектов - осмысленная ошибка.
&Тест
Процедура ТестДолжен_УпастьЕслиНаправлениеНеОпределено() Экспорт

	// Дано - каталог без маркеров
	ПустойКаталог = ВременныеФайлы.СоздатьКаталог();
	Назначение = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "out");

	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьОпцию("--src", ПустойКаталог);
	Исполнитель.ДобавитьАргумент(Назначение);

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда - ненулевой код возврата и осмысленная ошибка
	Ожидаем.Что(Исполнитель.КодВозврата(), "команда должна завершиться с ошибкой").Не_().Равно(0);
	Исполнитель.ОжидаемЧтоВыводСодержит("Не удалось определить тип исходников");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсполнителя()
	Аргументы = Новый Массив;
	Аргументы.Добавить("epf");
	Аргументы.Добавить("convert");
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

Функция СкопироватьФикстуруEDT(Исполнитель, Знач ИмяПроекта)
	Источник = Исполнитель.ПутьФикстуры("edt", ИмяПроекта);
	Назначение = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), ИмяПроекта);
	КопироватьКаталог(Источник, Назначение);
	Возврат Назначение;
КонецФункции

Функция ПрочитатьТекст(Знач Путь)
	Чтение = Новый ЧтениеТекста(Путь);
	Содержимое = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат Содержимое;
КонецФункции

Процедура КопироватьКаталог(Знач КаталогИсточник, Знач КаталогНазначения)

	ПрефиксИсточника = Новый Файл(КаталогИсточник).ПолноеИмя;
	Разделитель = ПолучитьРазделительПути();
	Если Прав(ПрефиксИсточника, 1) <> Разделитель Тогда
		ПрефиксИсточника = ПрефиксИсточника + Разделитель;
	КонецЕсли;

	Элементы = НайтиФайлы(ПрефиксИсточника, "*", Истина);
	Для Каждого Элемент Из Элементы Цикл
		Если НЕ Элемент.ЭтоФайл() Тогда
			Продолжить;
		КонецЕсли;
		ОтносительныйПуть = Сред(Элемент.ПолноеИмя, СтрДлина(ПрефиксИсточника) + 1);
		ПутьНазначения = ОбъединитьПути(КаталогНазначения, ОтносительныйПуть);
		КаталогФайлаНазначения = Новый Файл(ПутьНазначения).Путь;
		Если НЕ Новый Файл(КаталогФайлаНазначения).Существует() Тогда
			СоздатьКаталог(КаталогФайлаНазначения);
		КонецЕсли;
		КопироватьФайл(Элемент.ПолноеИмя, ПутьНазначения);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
