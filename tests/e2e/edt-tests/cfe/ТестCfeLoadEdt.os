// BSLLS-off
// Тестовый набор: cfe load из исходников в формате 1С:EDT.
// Загрузка расширения из готового EDT-проекта в информационную базу
// (vrunner экспортирует EDT -> XML через 1cedtcli, затем грузит XML в базу платформой).
//
// ВНИМАНИЕ: EDT-блок (tests/e2e/edt-tests) ТРЕБУЕТ установленной 1С:EDT (1cedtcli)
// и намеренно вынесен из client-tests, поэтому на CI без EDT не запускается.
// Запуск блока: oscript tasks/test_e2e_edt.os
//
// Фикстура: tests/e2e/fixtures/edt/Расширение - готовый EDT-проект расширения (только корень:
// Configuration.mdo и модуль управляемого приложения). Для сценария выборочной загрузки
// в изолированную копию фикстуры добавляется собственный общий модуль расширения.

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands
#Использовать "../../utils"

Перем НакопленныеВременныеФайлы;
Перем КаталогБазы;
Перем ИмяРасширения;

#Область СлужебныйПрограммныйИнтерфейс

// Загрузка EDT-исходников расширения в существующую базу.
&Тест
Процедура ТестДолжен_ЗагрузитьРасширениеВБазуИзEDTИсходников() Экспорт

	// Дано - изолированная копия EDT-фикстуры и пустая база
	Исполнитель = СоздатьИсполнителя();
	КаталогEDT = Исполнитель.ПутьФикстуры("edt", "Расширение");
	Исполнитель.ДобавитьОпцию("--src-format", "edt");
	Исполнитель.ДобавитьАргумент(КаталогEDT);

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "загрузка расширения из EDT-исходников в базу");
	Исполнитель.ОжидаемЧтоВыводСодержит("Конвертация EDT");
	Исполнитель.ОжидаемЧтоВыводСодержит("Расширение '" + ИмяРасширения + "' загружено из файлов");

КонецПроцедуры

// Инкрементальная загрузка расширения из EDT: изменения детектируются по каталогу EDT-проекта,
// а не по временному XML-дампу. Первый запуск - полная загрузка (строит индекс), повторный без
// изменений - пропуск, после правки модуля объекта - выборочная загрузка XML-файлов объекта,
// после правки корня расширения (модуль управляемого приложения) - снова полная (политика v1).
&Тест
Процедура ТестДолжен_ПоддерживатьИнкрементальнуюЗагрузкуИзEDT() Экспорт

	// Дано - изолированная копия EDT-фикстуры с собственным общим модулем и пустая база
	Исполнитель = СоздатьИсполнителя();
	КаталогEDT = Исполнитель.ПутьФикстуры("edt", "Расширение");
	ДобавитьОбщийМодульВПроект(КаталогEDT);
	Исполнитель.ДобавитьОпцию("--src-format", "edt");
	Исполнитель.ДобавитьФлаг("--increment");
	Исполнитель.ДобавитьАргумент(КаталогEDT);

	// Когда - первый запуск (индекса ещё нет)
	Исполнитель.ВыполнитьКоманду();

	// Тогда - полная загрузка по EDT-пути
	Исполнитель.ОжидаемЧтоКодВозврата(0, "первая инкрементальная загрузка расширения из EDT");
	Исполнитель.ОжидаемЧтоВыводСодержит(ПрефиксЛогаИнкремента() + ": индекс не найден");
	Исполнитель.ОжидаемЧтоВыводСодержит("Расширение '" + ИмяРасширения + "' загружено из файлов");

	// Когда - повторный запуск без изменений (XML-дамп экспортируется заново, но исходники EDT те же)
	Исполнитель.ВыполнитьКоманду();

	// Тогда - загрузка пропущена
	Исполнитель.ОжидаемЧтоКодВозврата(0, "повторная инкрементальная загрузка расширения без изменений");
	Исполнитель.ОжидаемЧтоВыводСодержит(ПрефиксЛогаИнкремента() + ": изменений в исходниках не найдено, загрузка пропущена");
	Исполнитель.ОжидаемЧтоВыводНеСодержит("Расширение '" + ИмяРасширения + "' загружено из файлов");

	// И - изменяем модуль общего модуля расширения
	ПутьКМодулю = ОбъединитьПути(КаталогМодуля(КаталогEDT), "Module.bsl");
	ДобавитьМетодВМодуль(ПутьКМодулю);

	// Когда - запуск после изменения модуля объекта
	Исполнитель.ВыполнитьКоманду();

	// Тогда - выборочная загрузка XML-файлов изменённого объекта
	Исполнитель.ОжидаемЧтоКодВозврата(0, "инкрементальная загрузка расширения после изменения модуля объекта");
	Исполнитель.ОжидаемЧтоВыводСодержит("Инкрементальная загрузка: будет загружено");
	Исполнитель.ОжидаемЧтоВыводСодержит(ИмяОбщегоМодуля());
	Исполнитель.ОжидаемЧтоВыводСодержит("Module.bsl");
	Исполнитель.ОжидаемЧтоВыводНеСодержит("изменений в исходниках не найдено");
	Исполнитель.ОжидаемЧтоВыводСодержит("Расширение '" + ИмяРасширения + "' загружено из файлов");

	// И - изменяем модуль управляемого приложения (корень расширения src/Configuration)
	ПутьККорневомуМодулю = ОбъединитьПути(КаталогEDT, "src", "Configuration", "ManagedApplicationModule.bsl");
	ДобавитьМетодВМодуль(ПутьККорневомуМодулю);

	// Когда - запуск после изменения корня
	Исполнитель.ВыполнитьКоманду();

	// Тогда - полная загрузка
	Исполнитель.ОжидаемЧтоКодВозврата(0, "инкрементальная загрузка расширения после изменения корня");
	Исполнитель.ОжидаемЧтоВыводСодержит("изменение корня расширения, будет выполнена полная загрузка");
	Исполнитель.ОжидаемЧтоВыводНеСодержит("Инкрементальная загрузка: будет загружено");
	Исполнитель.ОжидаемЧтоВыводСодержит("Расширение '" + ИмяРасширения + "' загружено из файлов");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
	КаталогБазы = ФикстурнаяФайловаяБД.СкопироватьВоВременнойКаталог();
	ИмяРасширения = "test";
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсполнителя()
	Аргументы = Новый Массив;
	Аргументы.Добавить("cfe");
	Аргументы.Добавить("load");
	Исполнитель = Новый ИсполнительCLI(Аргументы);
	Исполнитель.ДобавитьОпцию("--ibconnection", "/F""" + КаталогБазы + """");
	Исполнитель.ДобавитьОпцию("--extension-name", ИмяРасширения);
	// Тесты проверяют экспорт EDT и загрузку: обновление конфигурации БД (по умолчанию) отключаем.
	Исполнитель.ДобавитьФлаг("--no-update-db");
	Возврат Исполнитель;
КонецФункции

// Префикс сообщений EDT-инкремента расширения (см. СервисРасчетаИнкремента).
Функция ПрефиксЛогаИнкремента()
	Возврат "Инкрементальная загрузка (EDT) расширения '" + ИмяРасширения + "'";
КонецФункции

Функция ИмяОбщегоМодуля()
	Возврат "Ext1_ОбщийМодуль";
КонецФункции

// Каталог собственного общего модуля внутри EDT-проекта.
Функция КаталогМодуля(Знач КаталогEDT)
	Возврат ОбъединитьПути(КаталогEDT, "src", "CommonModules", ИмяОбщегоМодуля());
КонецФункции

// Добавить в копию EDT-проекта собственный общий модуль расширения и зарегистрировать его в корне.
// Фикстура содержит только корень расширения, а выборочная загрузка (политика v1) применяется
// лишь к изменениям объектов вне src/Configuration - без объекта сценарий не воспроизвести.
Процедура ДобавитьОбщийМодульВПроект(Знач КаталогEDT)

	Каталог = КаталогМодуля(КаталогEDT);
	СоздатьКаталог(Каталог);
	ЗаписатьТекст(ОбъединитьПути(Каталог, ИмяОбщегоМодуля() + ".mdo"), ТекстОписанияОбщегоМодуля());
	ЗаписатьТекст(ОбъединитьПути(Каталог, "Module.bsl"),
		"Процедура Ext1_Проверка() Экспорт" + Символы.ПС + "КонецПроцедуры" + Символы.ПС);

	ПутьКорня = ОбъединитьПути(КаталогEDT, "src", "Configuration", "Configuration.mdo");
	Регистрация = "  <commonModules>CommonModule." + ИмяОбщегоМодуля() + "</commonModules>" + Символы.ПС;
	ТекстКорня = СтрЗаменить(ПрочитатьТекст(ПутьКорня),
		"</mdclass:Configuration>", Регистрация + "</mdclass:Configuration>");
	ЗаписатьТекст(ПутьКорня, ТекстКорня);

КонецПроцедуры

// Описание серверного общего модуля в формате EDT (.mdo).
Функция ТекстОписанияОбщегоМодуля()

	Строки = Новый Массив;
	Строки.Добавить("<?xml version=""1.0"" encoding=""UTF-8""?>");
	Строки.Добавить("<mdclass:CommonModule xmlns:mdclass=""http://g5.1c.ru/v8/dt/metadata/mdclass"""
		+ " uuid=""6f1d2c3b-4a5e-4f60-8b7c-9d0e1f2a3b4c"">");
	Строки.Добавить("  <name>" + ИмяОбщегоМодуля() + "</name>");
	Строки.Добавить("  <synonym>");
	Строки.Добавить("    <key>ru</key>");
	Строки.Добавить("    <value>Общий модуль расширения</value>");
	Строки.Добавить("  </synonym>");
	Строки.Добавить("  <server>true</server>");
	Строки.Добавить("</mdclass:CommonModule>");
	Строки.Добавить("");

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция ПрочитатьТекст(Знач ПутьКФайлу)
	Чтение = Новый ЧтениеТекста(ПутьКФайлу, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат Текст;
КонецФункции

Процедура ЗаписатьТекст(Знач ПутьКФайлу, Знач Текст)
	Запись = Новый ЗаписьТекста(ПутьКФайлу, КодировкаТекста.UTF8NoBOM);
	Запись.Записать(Текст);
	Запись.Закрыть();
КонецПроцедуры

// Дописать в модуль новый метод, чтобы изменить его содержимое (и размер) для детекта инкрементом.
Процедура ДобавитьМетодВМодуль(Знач ПутьКМодулю)

	ИмяМетода = "ТестовыйИнкремент_" + Формат(ТекущаяДата(), "ДФ=yyyyMMddHHmmss");
	Дополнение = Символы.ПС
		+ "Процедура " + ИмяМетода + "() Экспорт" + Символы.ПС
		+ "КонецПроцедуры" + Символы.ПС;
	ЗаписатьТекст(ПутьКМодулю, ПрочитатьТекст(ПутьКМодулю) + Дополнение);

КонецПроцедуры

#КонецОбласти
