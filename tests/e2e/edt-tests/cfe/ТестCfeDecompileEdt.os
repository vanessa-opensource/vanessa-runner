// BSLLS-off
// Тестовый набор: cfe decompile в формат 1С:EDT.
// Разборка файла .cfe в готовый EDT-проект расширения
// (vrunner выгружает .cfe -> XML платформой, затем импортирует XML -> EDT через 1cedtcli).
//
// ВНИМАНИЕ: EDT-блок (tests/e2e/edt-tests) ТРЕБУЕТ установленной 1С:EDT (1cedtcli)
// и намеренно вынесен из client-tests, поэтому на CI без EDT не запускается.
// Запуск блока: oscript tasks/test_e2e_edt.os
//
// Фикстуры: tests/e2e/fixtures/cfe - XML-исходники расширения (для сборки .cfe).

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands
#Использовать "../../utils"

Перем НакопленныеВременныеФайлы;
Перем ИмяРасширения;

#Область СлужебныйПрограммныйИнтерфейс

// Разборка .cfe в EDT-проект расширения.
&Тест
Процедура ТестДолжен_РазобратьCfeВEDTИсходники() Экспорт

	// Дано - собираем .cfe из XML-фикстуры
	ПутьCfe = СобратьCfeИзФикстур();

	Исполнитель = СоздатьИсполнителяDecompile();
	Исполнитель.ДобавитьОпцию("--cfe-file", ПутьCfe);
	Исполнитель.ДобавитьОпцию("--extension-name", ИмяРасширения);
	Исполнитель.ДобавитьОпцию("--src-format", "edt");
	Исполнитель.ДобавитьАргумент("edt-out");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда - получен EDT-проект расширения
	Исполнитель.ОжидаемЧтоКодВозврата(0, "разборка .cfe в формат EDT");
	Исполнитель.ОжидаемЧтоФайлСуществует(ОбъединитьПути("edt-out", ".project"));

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
	ИмяРасширения = "test";
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсполнителяDecompile()
	Аргументы = Новый Массив;
	Аргументы.Добавить("cfe");
	Аргументы.Добавить("decompile");
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

Функция СоздатьИсполнителяCompile()
	Аргументы = Новый Массив;
	Аргументы.Добавить("cfe");
	Аргументы.Добавить("compile");
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

// Собрать .cfe из XML-фикстуры расширения (cfe compile во временную базу).
Функция СобратьCfeИзФикстур()
	Исполнитель = СоздатьИсполнителяCompile();
	КаталогSrc = Исполнитель.ПутьФикстуры("cfe");
	Исполнитель.ДобавитьОпцию("--src", КаталогSrc);
	Исполнитель.ДобавитьОпцию("--extension-name", ИмяРасширения);
	ПутьCfe = ВременныеФайлы.НовоеИмяФайла("cfe");
	Исполнитель.ДобавитьАргумент(ПутьCfe);
	Исполнитель.ВыполнитьКоманду();
	Ожидаем.Что(Исполнитель.КодВозврата(), "Сборка фикстуры .cfe должна завершиться успешно").Равно(0);
	Возврат ПутьCfe;
КонецФункции

#КонецОбласти
