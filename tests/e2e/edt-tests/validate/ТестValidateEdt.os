// BSLLS-off
// Тестовый набор: команда `validate edt` - проверка EDT-проекта через 1cedtcli validate.
//
// ВНИМАНИЕ: EDT-блок (tests/e2e/edt-tests) ТРЕБУЕТ установленной 1С:EDT (1cedtcli)
// и намеренно вынесен из client-tests, поэтому на CI без EDT не запускается.
// Запуск блока: oscript tasks/test_e2e_edt.os
//
// Фикстуры: tests/e2e/fixtures/edt/Конфигурация - готовый EDT-проект конфигурации;
//           tests/e2e/fixtures/cf - XML-выгрузка Конфигуратора.

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands
#Использовать "../../utils"

Перем НакопленныеВременныеФайлы;

#Область СлужебныйПрограммныйИнтерфейс

// Проверка EDT-проекта без порога блокировки (--min-severity none): команда успешна,
// все три формата отчёта выгружаются в один каталог - junit, allure и edt (сырой файл
// 1cedtcli для edt-ripper/SonarQube).
&Тест
Процедура ТестДолжен_ПроверитьEDTПроект_ИСформироватьОтчеты() Экспорт

	// Дано - копия EDT-фикстуры
	Исполнитель = СоздатьИсполнителя();
	КаталогEDT = СкопироватьФикстуруEDT(Исполнитель);
	Исполнитель.ДобавитьОпцию("--src", КаталогEDT);
	Исполнитель.ДобавитьОпцию("--min-severity", "none");
	Исполнитель.ДобавитьОпцию("--report-format", "junit");
	Исполнитель.ДобавитьОпцию("--report-format", "allure");
	Исполнитель.ДобавитьОпцию("--report-format", "edt");
	Исполнитель.ДобавитьОпцию("--report-path", "build/reports");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда - команда успешна (порог none не блокирует), все три отчёта созданы
	// (каталог build/reports создан командой до начала проверки)
	Исполнитель.ОжидаемЧтоКодВозврата(0, "проверка EDT-проекта с --min-severity none");
	Исполнитель.ОжидаемЧтоФайлСуществует("build/reports/junit.xml");
	Исполнитель.ОжидаемЧтоФайлСуществует("build/reports/edt-validate.tsv");
	Исполнитель.ОжидаемЧтоВыводСодержит("Проверка EDT завершена");
	Исполнитель.ОжидаемЧтоВыводСодержит("Отчёт проверки EDT сохранён");

	// Исходный отчёт EDT - текст с замечаниями по строке, поля через табуляцию (фикстура содержит замечания)
	ОтчетEDT = ПрочитатьФайл(ОбъединитьПути(Исполнитель.КаталогРаботы(), "build", "reports", "edt-validate.tsv"));
	Ожидаем.Что(СтрНайти(ОтчетEDT, Символы.Таб) > 0, "исходный отчёт EDT в формате TSV").ЭтоИстина();

	// Результаты Allure - каталог с файлом на каждое замечание. При пороге none замечания
	// сборку не роняют, поэтому их кейсы broken, а не failed.
	Исполнитель.ОжидаемЧтоКаталогСуществует("build/reports/allure");
	Результаты = ПрочитатьРезультатыAllure(Исполнитель, "build/reports/allure");
	Ожидаем.Что(Результаты.Количество() > 0, "результаты Allure сформированы").ЭтоИстина();
	Ожидаем.Что(Результаты[0].Получить("status"), "статус неблокирующего замечания").Равно("broken");

КонецПроцедуры

// При наличии замечаний и пороге minor команда завершается с ошибкой (гейт работает).
&Тест
Процедура ТестДолжен_ЗавершитьсяОшибкой_ПриЗамечанияхИПорогеMinor() Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителя();
	КаталогEDT = СкопироватьФикстуруEDT(Исполнитель);
	Исполнитель.ДобавитьОпцию("--src", КаталогEDT);
	Исполнитель.ДобавитьОпцию("--min-severity", "minor");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда - фикстура содержит замечания (права роли и т.п.), порог minor -> ненулевой код
	Ожидаем.Что(Исполнитель.КодВозврата(), "порог minor при наличии замечаний должен блокировать")
		.Не_().Равно(0);
	Исполнитель.ОжидаемЧтоВыводСодержит("блокирующие замечания");

КонецПроцедуры

// XML-выгрузка Конфигуратора конвертируется во временный EDT-проект и проверяется.
&Тест
Процедура ТестДолжен_ПроверитьXMLВыгрузку_ЧерезКонвертациюВEDT() Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьОпцию("--src", Исполнитель.ПутьФикстуры("cf"));
	Исполнитель.ДобавитьОпцию("--min-severity", "none");
	Исполнитель.ДобавитьОпцию("--report-format", "edt");
	Исполнитель.ДобавитьОпцию("--report-path", "build/reports/edt-validate.tsv");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда - проект в отчёте назван как каталог исходников
	Исполнитель.ОжидаемЧтоКодВозврата(0, "проверка XML-выгрузки с --min-severity none");
	Исполнитель.ОжидаемЧтоВыводСодержит("Конвертация XML");
	Исполнитель.ОжидаемЧтоВыводСодержит("Проверка EDT завершена");
	Исполнитель.ОжидаемЧтоФайлСуществует("build/reports/edt-validate.tsv");
	ОтчетEDT = ПрочитатьФайл(ОбъединитьПути(Исполнитель.КаталогРаботы(), "build", "reports", "edt-validate.tsv"));
	Ожидаем.Что(ОтчетEDT, "имя проекта в отчёте").Содержит(Символы.Таб + "cf" + Символы.Таб);

КонецПроцедуры

// Файл *.cf разбирается во временной базе, конвертируется в EDT-проект и проверяется;
// проект в отчёте назван как файл без расширения.
&Тест
Процедура ТестДолжен_ПроверитьФайлCf_ЧерезРазборкуИКонвертациюВEDT() Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьОпцию("--src", Исполнитель.ПутьФикстуры("1cv8.cf"));
	Исполнитель.ДобавитьОпцию("--min-severity", "none");
	Исполнитель.ДобавитьОпцию("--report-format", "edt");
	Исполнитель.ДобавитьОпцию("--report-path", "build/reports/edt-validate.tsv");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "проверка файла cf с --min-severity none");
	Исполнитель.ОжидаемЧтоВыводСодержит("Разборка CF");
	Исполнитель.ОжидаемЧтоВыводСодержит("Конвертация XML");
	Исполнитель.ОжидаемЧтоВыводСодержит("Проверка EDT завершена");
	Исполнитель.ОжидаемЧтоФайлСуществует("build/reports/edt-validate.tsv");
	ОтчетEDT = ПрочитатьФайл(ОбъединитьПути(Исполнитель.КаталогРаботы(), "build", "reports", "edt-validate.tsv"));
	Ожидаем.Что(ОтчетEDT, "имя проекта в отчёте").Содержит(Символы.Таб + "1cv8" + Символы.Таб);

КонецПроцедуры

// Файл *.cfe разбирается во временной базе под именем файла и проверяется как проект расширения
// без основной конфигурации.
&Тест
Процедура ТестДолжен_ПроверитьФайлCfe_ЧерезРазборкуИКонвертациюВEDT() Экспорт

	// Дано - cfe собирается в теле теста: тело модуля oneunit выполняется перед каждым тестом
	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьОпцию("--src", СобратьCfeИзФикстур(Исполнитель));
	Исполнитель.ДобавитьФлаг("--ibcmd");
	Исполнитель.ДобавитьОпцию("--min-severity", "none");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "проверка файла cfe с --min-severity none");
	Исполнитель.ОжидаемЧтоВыводСодержит("Разборка CFE");
	Исполнитель.ОжидаемЧтоВыводСодержит("без проекта основной конфигурации");
	Исполнитель.ОжидаемЧтоВыводСодержит("Проверка EDT завершена");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсполнителя()
	Аргументы = Новый Массив;
	Аргументы.Добавить("validate");
	Аргументы.Добавить("edt");
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

Функция СкопироватьФикстуруEDT(Исполнитель)
	Источник = Исполнитель.ПутьФикстуры("edt", "Конфигурация");
	Назначение = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "Конфигурация");
	КопироватьКаталог(Источник, Назначение);
	Возврат Назначение;
КонецФункции

// Собрать test.cfe из XML-фикстуры расширения (имя файла = имя расширения в фикстуре).
Функция СобратьCfeИзФикстур(Исполнитель)
	Аргументы = Новый Массив;
	Аргументы.Добавить("cfe");
	Аргументы.Добавить("compile");
	Компилятор = Новый ИсполнительCLI(Аргументы);
	Компилятор.ДобавитьОпцию("--src", Исполнитель.ПутьФикстуры("cfe"));
	Компилятор.ДобавитьОпцию("--extension-name", "test");
	Компилятор.ДобавитьФлаг("--ibcmd");
	ПутьCfe = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "test.cfe");
	Компилятор.ДобавитьАргумент(ПутьCfe);
	Компилятор.ВыполнитьКоманду();
	Компилятор.ОжидаемЧтоКодВозврата(0, "сборка cfe из фикстуры");
	Возврат ПутьCfe;
КонецФункции

Функция ПрочитатьФайл(Знач Путь)
	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат Текст;
КонецФункции

// Разобранные файлы результатов Allure из каталога прогона.
Функция ПрочитатьРезультатыAllure(Исполнитель, ОтносительныйПуть)

	Каталог = ОбъединитьПути(Исполнитель.КаталогРаботы(), ОтносительныйПуть);
	Результаты = Новый Массив;

	Если НЕ Новый Файл(Каталог).Существует() Тогда
		Возврат Результаты;
	КонецЕсли;

	Для Каждого Файл Из НайтиФайлы(Каталог, "*-result.json") Цикл
		Чтение = Новый ЧтениеJSON;
		Чтение.ОткрытьФайл(Файл.ПолноеИмя);
		Результаты.Добавить(ПрочитатьJSON(Чтение, Истина));
		Чтение.Закрыть();
	КонецЦикла;

	Возврат Результаты;

КонецФункции

Процедура КопироватьКаталог(Знач КаталогИсточник, Знач КаталогНазначения)

	ПрефиксИсточника = Новый Файл(КаталогИсточник).ПолноеИмя;
	Разделитель = ПолучитьРазделительПути();
	Если Прав(ПрефиксИсточника, 1) <> Разделитель Тогда
		ПрефиксИсточника = ПрефиксИсточника + Разделитель;
	КонецЕсли;

	Элементы = НайтиФайлы(ПрефиксИсточника, "*", Истина);
	Для Каждого Элемент Из Элементы Цикл
		Если НЕ Элемент.ЭтоФайл() Тогда
			Продолжить;
		КонецЕсли;
		ОтносительныйПуть = Сред(Элемент.ПолноеИмя, СтрДлина(ПрефиксИсточника) + 1);
		ПутьНазначения = ОбъединитьПути(КаталогНазначения, ОтносительныйПуть);
		КаталогФайлаНазначения = Новый Файл(ПутьНазначения).Путь;
		Если НЕ Новый Файл(КаталогФайлаНазначения).Существует() Тогда
			СоздатьКаталог(КаталогФайлаНазначения);
		КонецЕсли;
		КопироватьФайл(Элемент.ПолноеИмя, ПутьНазначения);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
