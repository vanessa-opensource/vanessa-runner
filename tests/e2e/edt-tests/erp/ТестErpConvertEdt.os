// BSLLS-off
// Тестовый набор: команда `erp convert` - конвертация исходников между форматами 1С:EDT и XML.
// Проверяется автоопределение типа исходников, конвертация в обе стороны (EDT -> XML -> EDT)
// и падение с ошибкой, когда тип исходников определить не удалось.
//
// ВНИМАНИЕ: EDT-блок (tests/e2e/edt-tests) ТРЕБУЕТ установленной 1С:EDT (1cedtcli)
// и намеренно вынесен из client-tests, поэтому на CI без EDT не запускается.
// Запуск блока: oscript tasks/test_e2e_edt.os
//
// Фикстура: tests/e2e/fixtures/edt/Конфигурация - готовый EDT-проект конфигурации.

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands
#Использовать "../../utils"

Перем НакопленныеВременныеФайлы;

#Область СлужебныйПрограммныйИнтерфейс

// Конвертация EDT -> XML, затем обратного XML -> EDT (round-trip) - обе стороны через 1cedtcli.
&Тест
Процедура ТестДолжен_КонвертироватьEDTвXMLиОбратно() Экспорт

	// Дано - копия EDT-фикстуры
	Исполнитель1 = СоздатьИсполнителя();
	КаталогEDT = СкопироватьФикстуруEDT(Исполнитель1);
	КаталогXML = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "xml");

	// Когда - конвертация EDT -> XML (тип определяется автоматически)
	Исполнитель1.ДобавитьОпцию("--src", КаталогEDT);
	Исполнитель1.ДобавитьАргумент(КаталогXML);
	Исполнитель1.ВыполнитьКоманду();

	// Тогда - получен XML-дамп Конфигуратора
	Исполнитель1.ОжидаемЧтоКодВозврата(0, "конвертация EDT -> XML");
	Исполнитель1.ОжидаемЧтоВыводСодержит("Конвертация EDT");
	Ожидаем.Что(Новый Файл(ОбъединитьПути(КаталогXML, "Configuration.xml")).Существует(),
		"в каталоге назначения создан Configuration.xml").ЭтоИстина();

	// Когда - конвертация обратно XML -> EDT
	КаталогEDTОбратно = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "edt");
	Исполнитель2 = СоздатьИсполнителя();
	Исполнитель2.ДобавитьОпцию("--src", КаталогXML);
	Исполнитель2.ДобавитьАргумент(КаталогEDTОбратно);
	Исполнитель2.ВыполнитьКоманду();

	// Тогда - получен EDT-проект
	Исполнитель2.ОжидаемЧтоКодВозврата(0, "конвертация XML -> EDT");
	Исполнитель2.ОжидаемЧтоВыводСодержит("Конвертация XML");
	Ожидаем.Что(Новый Файл(ОбъединитьПути(КаталогEDTОбратно, ".project")).Существует(),
		"в каталоге назначения создан .project").ЭтоИстина();

КонецПроцедуры

// Если тип исходников определить не удалось - команда завершается с ошибкой.
&Тест
Процедура ТестДолжен_УпастьЕслиТипИсходниковНеОпределён() Экспорт

	// Дано - каталог без маркеров EDT и без Configuration.xml
	ПустойКаталог = ВременныеФайлы.СоздатьКаталог();
	КаталогOut = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "out");

	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьОпцию("--src", ПустойКаталог);
	Исполнитель.ДобавитьАргумент(КаталогOut);

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда - ненулевой код возврата и осмысленная ошибка
	Ожидаем.Что(Исполнитель.КодВозврата() <> 0, "команда должна завершиться с ошибкой").ЭтоИстина();
	Исполнитель.ОжидаемЧтоВыводСодержит("Не удалось определить тип исходников");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсполнителя()
	Аргументы = Новый Массив;
	Аргументы.Добавить("erp");
	Аргументы.Добавить("convert");
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

Функция СкопироватьФикстуруEDT(Исполнитель)
	Источник = Исполнитель.ПутьФикстуры("edt", "Конфигурация");
	Назначение = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "Конфигурация");
	КопироватьКаталог(Источник, Назначение);
	Возврат Назначение;
КонецФункции

Процедура КопироватьКаталог(Знач КаталогИсточник, Знач КаталогНазначения)

	ПрефиксИсточника = Новый Файл(КаталогИсточник).ПолноеИмя;
	Разделитель = ПолучитьРазделительПути();
	Если Прав(ПрефиксИсточника, 1) <> Разделитель Тогда
		ПрефиксИсточника = ПрефиксИсточника + Разделитель;
	КонецЕсли;

	Элементы = НайтиФайлы(ПрефиксИсточника, "*", Истина);
	Для Каждого Элемент Из Элементы Цикл
		Если НЕ Элемент.ЭтоФайл() Тогда
			Продолжить;
		КонецЕсли;
		ОтносительныйПуть = Сред(Элемент.ПолноеИмя, СтрДлина(ПрефиксИсточника) + 1);
		ПутьНазначения = ОбъединитьПути(КаталогНазначения, ОтносительныйПуть);
		КаталогФайлаНазначения = Новый Файл(ПутьНазначения).Путь;
		Если НЕ Новый Файл(КаталогФайлаНазначения).Существует() Тогда
			СоздатьКаталог(КаталогФайлаНазначения);
		КонецЕсли;
		КопироватьФайл(Элемент.ПолноеИмя, ПутьНазначения);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
