// BSLLS:Typo-off
// Хелпер для работы с фикстурами файловых ИБ.
//
// Вместо динамического создания базы (CREATEINFOBASE или cf load через ibcmd,
// что вызывает конкуренцию за общие ресурсы платформы при параллельном выполнении
// тестов на CI) копирует заранее подготовленный файл ИБ из фикстуры.
//
// Фикстуры, каталог tests/e2e/fixtures, файл 1Cv8.1CD:
//   empty-ib      - пустая ИБ без конфигурации
//   configured-ib - пустая ИБ с загруженным 1cv8.cf и обновлённой конфигурацией БД
//                   (пересоздание: tasks/create_ib_fixtures.os)
//
// BSLLS:CommentedCode-off
// Использование:
//   #Использовать tempfiles
//   #Использовать "../../utils"
//   ...
//   КаталогБазы = ФикстурнаяФайловаяБД.СкопироватьВоВременнойКаталог();
// BSLLS:CommentedCode-on

#Использовать tempfiles

#Область ПрограммныйИнтерфейс

// Скопировать ИБ из фикстуры во временный каталог.
//
// Создаёт временный каталог через ВременныеФайлы.СоздатьКаталог(),
// который автоматически удаляется при вызове ВременныеФайлы.УдалитьНакопленныеВременныеФайлы().
//
// Параметры:
//   ИмяФикстуры - Строка - имя каталога фикстуры в tests/e2e/fixtures (по умолчанию empty-ib)
//
// Возвращаемое значение:
//   Строка - полный путь к временному каталогу с копией базы
//
Функция СкопироватьВоВременнойКаталог(Знач ИмяФикстуры = "empty-ib") Экспорт

	ПутьКФикстуре = НайтиФайлФикстуры(ИмяФикстуры);

	КаталогВр = ВременныеФайлы.СоздатьКаталог();
	КопироватьФайл(ПутьКФикстуре, ОбъединитьПути(КаталогВр, "1Cv8.1CD"));

	Возврат КаталогВр;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НайтиФайлФикстуры(Знач ИмяФикстуры)

	КаталогПроекта = ТекущийКаталог();
	Путь = ОбъединитьПути(КаталогПроекта, "tests");
	Путь = ОбъединитьПути(Путь, "e2e");
	Путь = ОбъединитьПути(Путь, "fixtures");
	Путь = ОбъединитьПути(Путь, ИмяФикстуры);
	Путь = ОбъединитьПути(Путь, "1Cv8.1CD");

	Если НЕ Новый Файл(Путь).Существует() Тогда
		ВызватьИсключение "Фикстура ИБ не найдена: " + Путь;
	КонецЕсли;

	Возврат Путь;

КонецФункции

#КонецОбласти
