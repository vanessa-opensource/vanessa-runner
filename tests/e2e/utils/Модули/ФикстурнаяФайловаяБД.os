// BSLLS:Typo-off
// Хелпер для работы с фикстурой пустой файловой ИБ.
//
// Вместо динамического создания базы через CREATEINFOBASE (что вызывает
// конкуренцию за общие ресурсы платформы при параллельном выполнении тестов
// на CI), копирует заранее подготовленную пустую ИБ из фикстуры.
//
// Фикстура: tests/e2e/fixtures/empty-ib/1Cv8.1CD
// Скрипт создания: tasks/create_ib_fixture.os
//
// BSLLS:CommentedCode-off
// Использование:
//   #Использовать tempfiles
//   #Использовать "../../utils"
//   ...
//   КаталогБазы = ФикстурнаяФайловаяБД.СкопироватьВоВременнойКаталог();
// BSLLS:CommentedCode-on

#Использовать tempfiles

#Область ПрограммныйИнтерфейс

// Скопировать пустую ИБ из фикстуры во временный каталог.
//
// Создаёт временный каталог через ВременныеФайлы.СоздатьКаталог(),
// который автоматически удаляется при вызове ВременныеФайлы.УдалитьНакопленныеВременныеФайлы().
//
// Возвращаемое значение:
//   Строка - полный путь к временному каталогу с копией базы
//
Функция СкопироватьВоВременнойКаталог() Экспорт

	ПутьКФикстуре = НайтиФайлФикстуры();

	КаталогВр = ВременныеФайлы.СоздатьКаталог();
	КопироватьФайл(ПутьКФикстуре, ОбъединитьПути(КаталогВр, "1Cv8.1CD"));

	Возврат КаталогВр;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НайтиФайлФикстуры()

	КаталогПроекта = ТекущийКаталог();
	Путь = ОбъединитьПути(КаталогПроекта, "tests");
	Путь = ОбъединитьПути(Путь, "e2e");
	Путь = ОбъединитьПути(Путь, "fixtures");
	Путь = ОбъединитьПути(Путь, "empty-ib");
	Путь = ОбъединитьПути(Путь, "1Cv8.1CD");

	Если НЕ Новый Файл(Путь).Существует() Тогда
		ВызватьИсключение "Фикстура пустой ИБ не найдена: " + Путь
			+ ". Запустите tasks/create_ib_fixture.os для создания фикстуры.";
	КонецЕсли;

	Возврат Путь;

КонецФункции

#КонецОбласти
