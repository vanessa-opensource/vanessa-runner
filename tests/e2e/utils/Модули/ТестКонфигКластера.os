// Конфигурация интеграционных кластерных тестов.
//
// Читает настройки кластера 1С / RAS / СУБД из переменных окружения
// (с разумными дефолтами, повторяющими исторически захардкоженные значения).
//
// Переменные окружения:
//   VRUNNER_TEST_RAS         — адрес RAS                  (default: localhost:1545)
//   VRUNNER_TEST_AGENT       — адрес ragent (для /S)      (default: localhost)
//   VRUNNER_TEST_DBMS_TYPE   — тип СУБД                   (default: PostgreSQL)
//   VRUNNER_TEST_DBMS_SERVER — адрес сервера СУБД         (default: 10.20.3.100)
//   VRUNNER_TEST_DBMS_USER   — пользователь СУБД          (default: postgres)
//   VRUNNER_TEST_DBMS_PWD    — пароль пользователя СУБД   (default: postgres)
//
// Использование:
//   #Использовать "../utils"
//   ...
//   ТестКонфигКластера.ДобавитьОпцииRAS(Исполнитель);
//   ТестКонфигКластера.ДобавитьОпцииСУБД(Исполнитель, ИмяБазы);

#Использовать asserts

#Область ПрограммныйИнтерфейс

// Адрес RAS (host:port).
//
// Возвращаемое значение:
//   Строка
//
Функция АдресRAS() Экспорт
	Возврат ПрочитатьПеременную("VRUNNER_TEST_RAS", "localhost:1545");
КонецФункции

// Адрес ragent для строки подключения /S (без \DefAlias).
//
// Возвращаемое значение:
//   Строка
//
Функция АдресАгента() Экспорт
	Возврат ПрочитатьПеременную("VRUNNER_TEST_AGENT", "localhost");
КонецФункции

// Тип СУБД.
//
// Возвращаемое значение:
//   Строка
//
Функция ТипСУБД() Экспорт
	Возврат ПрочитатьПеременную("VRUNNER_TEST_DBMS_TYPE", "PostgreSQL");
КонецФункции

// Адрес сервера СУБД.
//
// Возвращаемое значение:
//   Строка
//
Функция СерверСУБД() Экспорт
	Возврат ПрочитатьПеременную("VRUNNER_TEST_DBMS_SERVER", "10.20.3.100");
КонецФункции

// Пользователь СУБД.
//
// Возвращаемое значение:
//   Строка
//
Функция ПользовательСУБД() Экспорт
	Возврат ПрочитатьПеременную("VRUNNER_TEST_DBMS_USER", "postgres");
КонецФункции

// Пароль СУБД.
//
// Возвращаемое значение:
//   Строка
//
Функция ПарольСУБД() Экспорт
	Возврат ПрочитатьПеременную("VRUNNER_TEST_DBMS_PWD", "postgres");
КонецФункции

// Добавить в исполнитель опцию --ras.
//
// Параметры:
//   Исполнитель - ИсполнительCLI
//
Процедура ДобавитьОпцииRAS(Исполнитель) Экспорт
	Исполнитель.ДобавитьОпцию("--ras", АдресRAS());
КонецПроцедуры

// Добавить в исполнитель опции СУБД для команды cluster create / cf load --ibcmd.
//
// Параметры:
//   Исполнитель - ИсполнительCLI
//   ИмяБазы     - Строка - имя базы данных СУБД (по умолчанию совпадает с --db)
//
Процедура ДобавитьОпцииСУБД(Исполнитель, Знач ИмяБазы) Экспорт
	Исполнитель.ДобавитьОпцию("--dbms-type",   ТипСУБД());
	Исполнитель.ДобавитьОпцию("--dbms-server", СерверСУБД());
	Исполнитель.ДобавитьОпцию("--dbms-base",   ИмяБазы);
	Исполнитель.ДобавитьОпцию("--dbms-user",   ПользовательСУБД());
	Исполнитель.ДобавитьОпцию("--dbms-pwd",    ПарольСУБД());
КонецПроцедуры

// Сформировать строку подключения к серверной базе через ragent.
//
// Параметры:
//   ИмяБазы - Строка
//
// Возвращаемое значение:
//   Строка - например /S"localhost\base"
//
Функция СтрокаПодключенияСервер(Знач ИмяБазы) Экспорт
	Возврат "/S""" + АдресАгента() + "\" + ИмяБазы + """";
КонецФункции

// Создать тестовую базу в кластере (cluster create) с дефолтными СУБД-параметрами.
// Имя базы данных СУБД совпадает с именем ИБ.
//
// Параметры:
//   ИмяБазы - Строка - имя ИБ в кластере (одновременно имя --dbms-base)
//
Процедура СоздатьТестовуюБазу(Знач ИмяБазы) Экспорт
	Аргументы = Новый Массив;
	Аргументы.Добавить("cluster");
	Аргументы.Добавить("create");

	Исполнитель = Новый ИсполнительCLI(Аргументы);
	ДобавитьОпцииRAS(Исполнитель);
	Исполнитель.ДобавитьОпцию("--db-name", ИмяБазы);
	ДобавитьОпцииСУБД(Исполнитель, ИмяБазы);

	Исполнитель.ВыполнитьКоманду();
	Исполнитель.ОжидаемЧтоКодВозврата(0, "создание тестовой базы в кластере");
КонецПроцедуры

// Удалить тестовую базу из кластера вместе с базой данных СУБД.
// Не выбрасывает исключение, если база уже отсутствует.
//
// Параметры:
//   ИмяБазы - Строка
//
Процедура УдалитьТестовуюБазу(Знач ИмяБазы) Экспорт
	Аргументы = Новый Массив;
	Аргументы.Добавить("cluster");
	Аргументы.Добавить("remove");

	Исполнитель = Новый ИсполнительCLI(Аргументы);
	ДобавитьОпцииRAS(Исполнитель);
	Исполнитель.ДобавитьОпцию("--db-name", ИмяБазы);
	Исполнитель.ДобавитьФлаг("--drop-db");

	Попытка
		Исполнитель.ВыполнитьКоманду();
	Исключение
	КонецПопытки;
КонецПроцедуры

// Сгенерировать уникальное имя тестовой базы.
//
// Возвращаемое значение:
//   Строка
//
Функция НовоеИмяТестовойБазы() Экспорт
	Возврат "vrunner_test_" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПрочитатьПеременную(Знач Имя, Знач Дефолт)
	Значение = ПолучитьПеременнуюСреды(Имя);
	Если ЗначениеЗаполнено(Значение) Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат Дефолт;
КонецФункции

#КонецОбласти
