// BSLLS:Typo-off
// Аккуратное завершение 1С-клиента, запущенного --no-wait тестом.
//
// Тест с `--no-wait` запускает `1cv8c.exe` и сразу возвращает управление, не
// дожидаясь клиента. Оставленный процесс держит shared-кэш платформы и файловые
// блокировки; следующий по последовательному расписанию тест с любой
// ibcmd-операцией над файловой ИБ падает с "[WARN] Ошибка при работе с файлом"
// (нестабильно, только на Windows — там блокировки mandatory).
//
// Подход (НЕ глобальный taskkill): тест запоминает PID-ы клиентов ДО запуска,
// а в teardown ДОЖИДАЕТСЯ ШТАТНОГО завершения именно СВОИХ новых клиентов
// (раннер xUnit/Vanessa закрывает 1С после прогона фикстуры сам). Если клиент
// не закрылся за разумный таймаут — гасим ровно его, по PID, не трогая чужие
// процессы. Так нет «кувалды» `taskkill /IM 1cv8.exe`, способной убить клиент
// соседнего теста.
//
// Использование (в наборах, которые запускают клиент с --no-wait):
//   #Использовать "../../utils"
//   Перем _КлиентыДо;
//   &ПередКаждым  ... _КлиентыДо = КлиентыТеста.СнимокЗапущенных();
//   &ПослеКаждого ... КлиентыТеста.ДождатьсяЗавершенияНовых(_КлиентыДо);

#Использовать 1commands

#Область ПрограммныйИнтерфейс

// Снимок PID-ов запущенных 1С-клиентов (1cv8c.exe / 1cv8.exe) на текущий момент.
// На не-Windows возвращает пустое соответствие: orphan-проблемы там нет
// (блокировки advisory), а уборку процессов делает раннер CI.
//
// Возвращаемое значение:
//   Соответствие - ключ: PID (Строка), значение: Истина
//
Функция СнимокЗапущенных() Экспорт
	Возврат PIDыКлиентов1С();
КонецФункции

// Дождаться штатного завершения клиентов, появившихся ПОСЛЕ снимка, и погасить
// по PID тех, кто не завершился за таймаут. Чужие (бывшие в снимке) процессы не
// трогаются. Безопасно вызывать, даже если новых клиентов нет.
//
// Параметры:
//   СнимокДо - Соответствие - результат СнимокЗапущенных(), снятый в &ПередКаждым
//
Процедура ДождатьсяЗавершенияНовых(Знач СнимокДо) Экспорт

	Если НЕ ЭтоWindows() Тогда
		Возврат;
	КонецЕсли;

	МаксОжиданиеМс = 20000; // BSLLS:MagicNumber-off Потолок ожидания штатного закрытия клиента, мс.
	ШагОпросаМс    = 300;   // BSLLS:MagicNumber-off Интервал опроса, мс.
	ПрошлоМс = 0;

	Пока ПрошлоМс < МаксОжиданиеМс Цикл
		Оставшиеся = НовыеЖивыеPID(СнимокДо);
		Если Оставшиеся.Количество() = 0 Тогда
			Возврат; // все наши клиенты закрылись штатно
		КонецЕсли;
		Приостановить(ШагОпросаМс);
		ПрошлоМс = ПрошлоМс + ШагОпросаМс;
	КонецЦикла;

	// Не дождались штатного закрытия — гасим ровно свои PID и ждём освобождения хэндлов.
	Для Каждого PID Из НовыеЖивыеPID(СнимокДо) Цикл
		ВыполнитьТихо("taskkill", СтрРазделить("/PID " + PID + " /T /F", " ", Ложь));
	КонецЦикла;
	ДождатьсяИсчезновения(СнимокДо, МаксОжиданиеМс, ШагОпросаМс);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// PID-ы, появившиеся после снимка и всё ещё живые.
Функция НовыеЖивыеPID(Знач СнимокДо)
	Текущие = PIDыКлиентов1С();
	Новые = Новый Массив;
	Для Каждого Элемент Из Текущие Цикл
		Если СнимокДо.Получить(Элемент.Ключ) = Неопределено Тогда
			Новые.Добавить(Элемент.Ключ);
		КонецЕсли;
	КонецЦикла;
	Возврат Новые;
КонецФункции

// Дождаться, пока ОС снимет погашенные процессы (taskkill /F асинхронен).
Процедура ДождатьсяИсчезновения(Знач СнимокДо, Знач МаксОжиданиеМс, Знач ШагОпросаМс)
	ПрошлоМс = 0;
	Пока ПрошлоМс < МаксОжиданиеМс Цикл
		Если НовыеЖивыеPID(СнимокДо).Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		Приостановить(ШагОпросаМс);
		ПрошлоМс = ПрошлоМс + ШагОпросаМс;
	КонецЦикла;
КонецПроцедуры

// Соответствие PID->Истина для запущенных 1cv8c.exe / 1cv8.exe (только Windows).
Функция PIDыКлиентов1С()
	Результат = Новый Соответствие;
	Если НЕ ЭтоWindows() Тогда
		Возврат Результат;
	КонецЕсли;
	// tasklist в CSV без заголовка: "1cv8c.exe","1234","Console","1","12 345 K"
	Вывод = ВыводКомандыТихо("tasklist", СтрРазделить("/FO CSV /NH", " ", Ложь));
	Для Каждого Строка Из СтрРазделить(Вывод, Символы.ПС, Ложь) Цикл
		Строка = НРег(СокрЛП(Строка));
		Если НЕ (СтрНачинаетсяС(Строка, """1cv8c.exe""") ИЛИ СтрНачинаетсяС(Строка, """1cv8.exe""")) Тогда
			Продолжить;
		КонецЕсли;
		Поля = СтрРазделить(Строка, ",", Истина);
		Если Поля.Количество() >= 2 Тогда
			PID = СтрЗаменить(СокрЛП(Поля[1]), """", "");
			Если ЗначениеЗаполнено(PID) Тогда
				Результат.Вставить(PID, Истина);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ЭтоWindows()
	СисИнфо = Новый СистемнаяИнформация();
	Возврат Найти(НРег(СисИнфо.ВерсияОС), "windows") > 0;
КонецФункции

Функция ВыводКомандыТихо(Знач Приложение, Знач МассивПараметров)
	Попытка
		Команда = Новый Команда();
		Команда.УстановитьКоманду(Приложение);
		Команда.ДобавитьПараметры(МассивПараметров);
		Команда.УстановитьИсполнениеЧерезКомандыСистемы(Истина);
		Команда.Исполнить();
		Возврат Команда.ПолучитьВывод();
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		Возврат "";
	КонецПопытки;
КонецФункции

Процедура ВыполнитьТихо(Знач Приложение, Знач МассивПараметров)
	Попытка
		Команда = Новый Команда();
		Команда.УстановитьКоманду(Приложение);
		Команда.ДобавитьПараметры(МассивПараметров);
		Команда.УстановитьИсполнениеЧерезКомандыСистемы(Истина);
		Команда.Исполнить();
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		// процесс мог завершиться сам; ненулевой код taskkill - это нормально
	КонецПопытки;
КонецПроцедуры

#КонецОбласти
