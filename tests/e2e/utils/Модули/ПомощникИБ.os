// Помощник для управления общей файловой ИБ в интеграционных тестах.
//
// Создаёт файловую ИБ из 1cv8.cf один раз на процесс;
// каждый следующий вызов ПолучитьИзолированнуюИБ() возвращает
// изолированную копию — без ibcmd, без конкуренции за кэш платформы.

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands

Перем _ОбщаяИБ;

#Область ПрограммныйИнтерфейс

// Вернуть изолированную копию файловой ИБ, инициализированной из 1cv8.cf.
// ИБ создаётся через ibcmd один раз при загрузке модуля; повторные вызовы
// возвращают свежую файловую копию.
//
// Возвращаемое значение:
//   Строка - путь к каталогу изолированной копии ИБ
//
Функция ПолучитьИзолированнуюИБ() Экспорт
	Возврат СкопироватьИБ(_ОбщаяИБ);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СоздатьИБ(КаталогБазы)
	// Готовим общую ИБ тем же способом, что и рабочий per-test вариант:
	// пустая ИБ из фикстуры + cf load --update-db. Это даёт корректную
	// конфигурацию БД (CompatibilityMode=8.3.14) — без неё xUnit/BDD-раннеры
	// падают на проверке версии платформы. infobase init --source такого
	// состояния БД не обеспечивает.
	СоздатьКаталог(КаталогБазы);

	Аргументы = Новый Массив;
	Аргументы.Добавить("cf");
	Аргументы.Добавить("load");
	Исполнитель = Новый ИсполнительCLI(Аргументы);

	КопироватьФайл(Исполнитель.ПутьФикстуры("empty-ib", "1Cv8.1CD"),
		ОбъединитьПути(КаталогБазы, "1Cv8.1CD"));

	Исполнитель.ДобавитьОпцию("--ibconnection", "/F""" + КаталогБазы + """");
	Исполнитель.ДобавитьФлаг("--ibcmd");
	Исполнитель.ДобавитьФлаг("--update-db");
	Исполнитель.ДобавитьАргумент(Исполнитель.ПутьФикстуры("1cv8.cf"));
	Исполнитель.ВыполнитьКоманду();
	Исполнитель.ОжидаемЧтоКодВозврата(0, "создание общей ИБ (cf load --update-db)");
КонецПроцедуры

Функция СкопироватьИБ(ОбщаяИБ)
	// Файловая ИБ 1С — это единственный файл 1Cv8.1CD; копируем именно его.
	// (Рекурсивный обход каталога был ненадёжен: при некоторых разделителях
	// путей копия получалась пустой, и раннер падал с "Отсутствует файл базы данных".)
	КаталогКопии = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "ib");
	СоздатьКаталог(КаталогКопии);
	КопироватьФайл(ОбъединитьПути(ОбщаяИБ, "1Cv8.1CD"), ОбъединитьПути(КаталогКопии, "1Cv8.1CD"));
	Возврат КаталогКопии;
КонецФункции

#КонецОбласти

// Инициализация при загрузке модуля: общая ИБ создаётся один раз на процесс.
// ВАЖНО: путь берём через ПолучитьИмяВременногоФайла() (глобальная функция),
// а НЕ через ВременныеФайлы.СоздатьКаталог(). Иначе общая ИБ регистрируется в
// tempfiles и удаляется per-test очисткой &ПослеКаждого
// (УдалитьНакопленныеВременныеФайлы удаляет всё, зарегистрированное после снапшота).
// Незарегистрированный путь живёт весь процесс; per-test копии (СкопироватьИБ),
// наоборот, идут через ВременныеФайлы и убираются после каждого теста.
_ОбщаяИБ = ПолучитьИмяВременногоФайла();
СоздатьИБ(_ОбщаяИБ);
