// BSLLS:MissingVariablesDescription-off
// BSLLS:Typo-off
// Исполнитель CLI-команд для интеграционных тестов.
//
// Запускает `oscript src/main.os <аргументы>` как подпроцесс,
// перехватывает вывод и код возврата.
// Предоставляет fluent-методы для добавления аргументов и assertion-хелперы.
//
// Зависимости (подключаются в тестовом скрипте): 1commands, tempfiles, asserts

#Использовать asserts
#Использовать 1commands
#Использовать tempfiles

Перем МассивАргументов;
Перем ТекущийРабочийКаталог;
Перем ПоследнийКодВозврата;
Перем ПоследнийВывод;
Перем ПутьКСкрипту;
Перем КаталогФикстур;
Перем _ПутьОСкрипт;

#Область ПрограммныйИнтерфейс

// Каталог, в котором выполняется команда (временный).
//
// Возвращаемое значение:
//   Строка
//
Функция КаталогРаботы() Экспорт
	Возврат ТекущийРабочийКаталог;
КонецФункции

// Установить рабочий каталог (для совместного использования несколькими исполнителями).
//
// Параметры:
//   Каталог - Строка - полный путь к каталогу
//
Процедура УстановитьКаталогРаботы(Знач Каталог) Экспорт
	ТекущийРабочийКаталог = Каталог;
КонецПроцедуры

// Установить путь к скрипту точки входа.
// По умолчанию используется src/main.os.
//
// Параметры:
//   Путь - Строка - полный путь к .os-файлу
//
Процедура УстановитьСкрипт(Знач Путь) Экспорт
	ПутьКСкрипту = Путь;
КонецПроцедуры

// Добавить опцию вида --name value.
//
// Параметры:
//   Имя - Строка - имя опции, напр. "--src"
//   Значение - Строка - значение опции
//
Процедура ДобавитьОпцию(Имя, Значение) Экспорт
	МассивАргументов.Добавить(Имя);
	МассивАргументов.Добавить(Значение);
КонецПроцедуры

// Добавить флаг (опцию без значения) вида --flag.
//
// Параметры:
//   Имя - Строка - имя флага, напр. "--ibcmd"
//
Процедура ДобавитьФлаг(Имя) Экспорт
	МассивАргументов.Добавить(Имя);
КонецПроцедуры

// Добавить позиционный аргумент.
//
// Параметры:
//   Значение - Строка - значение аргумента
//
Процедура ДобавитьАргумент(Значение) Экспорт
	МассивАргументов.Добавить(Значение);
КонецПроцедуры

// Путь к каталогу фикстур (tests/e2e/fixtures).
//
// Параметры:
//   Сегмент1 - Строка - первый подкаталог
//   Сегмент2 - Строка, Неопределено - второй подкаталог (необязательный)
//   Сегмент3 - Строка, Неопределено - третий подкаталог (необязательный)
//
// Возвращаемое значение:
//   Строка - полный путь
//
Функция ПутьФикстуры(Сегмент1, Сегмент2 = Неопределено, Сегмент3 = Неопределено) Экспорт
	Результат = ОбъединитьПути(КаталогФикстур, Сегмент1);
	Если Сегмент2 <> Неопределено Тогда
		Результат = ОбъединитьПути(Результат, Сегмент2);
	КонецЕсли;
	Если Сегмент3 <> Неопределено Тогда
		Результат = ОбъединитьПути(Результат, Сегмент3);
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Выполнить команду и вернуть код возврата.
//
// Возвращаемое значение:
//   Число - код возврата
//
Функция ВыполнитьКоманду() Экспорт

	Команда = Новый Команда;
	Команда.УстановитьКоманду("oscript");
	Команда.ДобавитьПараметр(ПутьКСкрипту);
	Для Каждого Арг Из МассивАргументов Цикл
		Команда.ДобавитьПараметр(Арг);
	КонецЦикла;
	Команда.УстановитьРабочийКаталог(ТекущийРабочийКаталог);
	Команда.ПоказыватьВыводНемедленно(Истина);

	ПоследнийКодВозврата = Команда.Исполнить();
	ПоследнийВывод = Команда.ПолучитьВывод();

	Возврат ПоследнийКодВозврата;

КонецФункции

// Вывод последней выполненной команды.
//
// Возвращаемое значение:
//   Строка
//
Функция Вывод() Экспорт
	Возврат ПоследнийВывод;
КонецФункции

// Код возврата последней выполненной команды.
//
// Возвращаемое значение:
//   Число
//
Функция КодВозврата() Экспорт
	Возврат ПоследнийКодВозврата;
КонецФункции

// Найти EPF из пакета add (bddRunner.epf / xddTestRunner.epf).
// Использует OVM_OSCRIPTBIN или where.exe для определения lib-каталога.
//
// Параметры:
//   ИмяФайла - Строка - имя EPF-файла (bddRunner.epf или xddTestRunner.epf)
//
// Возвращаемое значение:
//   Строка - полный путь к EPF
//
Функция НайтиEpfADD(ИмяФайла) Экспорт

	Если НЕ ЗначениеЗаполнено(_ПутьОСкрипт) Тогда
		Возврат "";
	КонецЕсли;

	КаталогBin = Новый Файл(_ПутьОСкрипт).Путь;
	КаталогLib = ОбъединитьПути(ОбъединитьПути(КаталогBin, ".."), "lib");
	Возврат Новый Файл(ОбъединитьПути(ОбъединитьПути(КаталогLib, "add"), ИмяФайла)).ПолноеИмя;

КонецФункции

// ---------- Assertion-хелперы ----------

// Проверить, что вывод содержит подстроку.
//
// Параметры:
//   Подстрока - Строка - ожидаемая подстрока
//
Процедура ОжидаемЧтоВыводСодержит(Подстрока) Экспорт
	Ожидаем.Что(ПоследнийВывод, "Вывод должен содержать: " + Подстрока).Содержит(Подстрока);
КонецПроцедуры

// Проверить, что вывод НЕ содержит подстроку.
//
// Параметры:
//   Подстрока - Строка - неожиданная подстрока
//
Процедура ОжидаемЧтоВыводНеСодержит(Подстрока) Экспорт
	Ожидаем.Что(ПоследнийВывод, "Вывод не должен содержать: " + Подстрока).Не_().Содержит(Подстрока);
КонецПроцедуры

// Проверить, что файл существует в рабочем каталоге.
//
// Параметры:
//   ОтносительныйПуть - Строка - путь относительно рабочего каталога
//
Процедура ОжидаемЧтоФайлСуществует(ОтносительныйПуть) Экспорт

	ПолныйПуть = ОбъединитьПути(ТекущийРабочийКаталог, ОтносительныйПуть);
	Файл = Новый Файл(ПолныйПуть);
	ФайлСуществует = Файл.Существует() И Файл.ЭтоФайл();
	Сообщение = СтрШаблон("Ожидали, что файл %1 существует", ОтносительныйПуть);

	Ожидаем.Что(ФайлСуществует, Сообщение).ЭтоИстина();

КонецПроцедуры

// Проверить, что каталог существует в рабочем каталоге.
//
// Параметры:
//   ОтносительныйПуть - Строка - путь относительно рабочего каталога
//
Процедура ОжидаемЧтоКаталогСуществует(ОтносительныйПуть) Экспорт

	ПолныйПуть = ОбъединитьПути(ТекущийРабочийКаталог, ОтносительныйПуть);
	Файл = Новый Файл(ПолныйПуть);
	КаталогСуществует = Файл.Существует() И Файл.ЭтоКаталог();
	Сообщение = СтрШаблон("Ожидали, что каталог %1 существует", ОтносительныйПуть);

	Ожидаем.Что(КаталогСуществует, Сообщение).ЭтоИстина();

КонецПроцедуры

// Проверить, что код возврата равен ожидаемому.
//
// Параметры:
//   ОжидаемыйКод - Число - ожидаемый код возврата (по умолчанию 0)
//   Описание - Строка - осмысленное описание действия (для сообщения об ошибке)
//
Процедура ОжидаемЧтоКодВозврата(ОжидаемыйКод = 0, Знач Описание = "") Экспорт

	Если ЗначениеЗаполнено(Описание) Тогда
		Сообщение = СтрШаблон("%1. Код возврата должен быть %2 (получен %3). Вывод:%4%5",
			Описание, ОжидаемыйКод, ПоследнийКодВозврата, Символы.ПС, ПоследнийВывод);
	Иначе
		Сообщение = СтрШаблон("Код возврата должен быть %1 (получен %2). Вывод:%3%4",
			ОжидаемыйКод, ПоследнийКодВозврата, Символы.ПС, ПоследнийВывод);
	КонецЕсли;

	Ожидаем.Что(ПоследнийКодВозврата, Сообщение).Равно(ОжидаемыйКод);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

// Конструктор.
//
// Параметры:
//   Аргументы - Массив из Строка - начальные аргументы CLI, напр. "cf", "compile"
//
Процедура ПриСозданииОбъекта(Знач Аргументы)

	МассивАргументов = Новый Массив;
	Для Каждого Арг Из Аргументы Цикл
		МассивАргументов.Добавить(Арг);
	КонецЦикла;

	ТекущийРабочийКаталог = ВременныеФайлы.СоздатьКаталог();

	КорневойКаталогПроекта = ТекущийКаталог();
	ПутьКСкрипту = ОбъединитьПути(КорневойКаталогПроекта, "src");
	ПутьКСкрипту = ОбъединитьПути(ПутьКСкрипту, "main.os");
	КаталогФикстур = ОбъединитьПути(КорневойКаталогПроекта, "tests");
	КаталогФикстур = ОбъединитьПути(КаталогФикстур, "e2e");
	КаталогФикстур = ОбъединитьПути(КаталогФикстур, "fixtures");

	СкопироватьНастройкиОСени(КорневойКаталогПроекта);

	_ПутьОСкрипт = НайтиПутьОСкрипт();

	ПоследнийКодВозврата = -1;
	ПоследнийВывод = "";

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СкопироватьНастройкиОСени(КорневойКаталог)
	Источник = ОбъединитьПути(КорневойКаталог, "tests", "e2e", "fixtures");
	Источник = ОбъединитьПути(Источник, "autumn-properties.json");
	Приемник = ОбъединитьПути(ТекущийРабочийКаталог, "autumn-properties.json");
	КопироватьФайл(Источник, Приемник);
КонецПроцедуры

// Найти путь к бинарному файлу oscript кросс-платформенно.
// На Windows использует «where», на Linux/macOS - «which».
// Это необходимо, т.к. на Windows «which» (из Git) возвращает Unix-путь вида
// /c/Users/..., который неверно интерпретируется в контексте текущего диска.
//
// Возвращаемое значение:
//   Строка - полный путь к oscript / oscript.exe, или "" если не найден
//
Функция НайтиПутьОСкрипт()

	СисИнфо = Новый СистемнаяИнформация;
	ЭтоWindows = СтрНачинаетсяС(Строка(СисИнфо.ТипПлатформы), "Windows");

	Если ЭтоWindows Тогда
		КмдWhere = Новый Команда;
		КмдWhere.УстановитьКоманду("where");
		КмдWhere.ДобавитьПараметр("oscript.exe");
		Если КмдWhere.Исполнить() = 0 Тогда
			Возврат СокрЛП(СтрРазделить(КмдWhere.ПолучитьВывод(), Символы.ПС)[0]);
		КонецЕсли;
	Иначе
		КмдWhich = Новый Команда;
		КмдWhich.УстановитьКоманду("which");
		КмдWhich.ДобавитьПараметр("oscript");
		Если КмдWhich.Исполнить() = 0 Тогда
			Возврат СокрЛП(СтрРазделить(КмдWhich.ПолучитьВывод(), Символы.ПС)[0]);
		КонецЕсли;
	КонецЕсли;

	Возврат "";

КонецФункции
#КонецОбласти
