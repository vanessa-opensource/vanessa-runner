// BSLLS-off
// Тестовый набор: контроль опции --src-format (cf).
// Проверяет осмысленную ошибку при некорректном указании формата исходников:
// --src-format edt на каталоге, который является XML-дампом Конфигуратора.
//
// EDT для этого теста НЕ нужна: ошибка возникает на этапе разбора формата исходников,
// до обращения к 1cedtcli и платформе. Поэтому тест живёт в client-tests и идёт на CI.
//
// Фикстуры: tests/e2e/fixtures/cf/ - XML-исходники конфигурации.

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands
#Использовать "../../utils"

Перем НакопленныеВременныеФайлы;

#Область СлужебныйПрограммныйИнтерфейс

// --src-format edt на XML-дампе -> понятная ошибка, а не сбой ниже по пайплайну.
&Тест
Процедура ТестДолжен_ВыдатьОсмысленнуюОшибку_ФорматEdtНаXMLИсходниках() Экспорт

	// Дано - каталог XML-исходников (фикстура cf) и форсированный формат edt
	Исполнитель = СоздатьИсполнителяCompile();
	КаталогXML = Исполнитель.ПутьФикстуры("cf");
	Исполнитель.ДобавитьОпцию("--src", КаталогXML);
	Исполнитель.ДобавитьОпцию("--src-format", "edt");
	Исполнитель.ДобавитьАргумент("1Cv8.cf");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда - ненулевой код и осмысленное сообщение
	Ожидаем.Что(Исполнитель.КодВозврата(), "форсирование edt на XML должно завершаться ошибкой")
		.Не_().Равно(0);
	Исполнитель.ОжидаемЧтоВыводСодержит("Указан формат исходников");
	Исполнитель.ОжидаемЧтоВыводСодержит("--src-format");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсполнителяCompile()
	Аргументы = Новый Массив;
	Аргументы.Добавить("cf");
	Аргументы.Добавить("compile");
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

#КонецОбласти
