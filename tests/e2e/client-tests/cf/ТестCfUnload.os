// BSLLS-off
// Тестовый набор: cf unload
// Интеграционные тесты выгрузки конфигурации из базы в файл cf.
//
// Фикстуры: tests/e2e/fixtures/cf/ - XML-исходники конфигурации

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands
#Использовать v8runner
#Использовать "../../utils"

Перем НакопленныеВременныеФайлы;
Перем КаталогБазы;

#Область СлужебныйПрограммныйИнтерфейс

// Выгрузка конфигурации из базы в файл cf.
// Прогоняется дважды: с ibcmd и через конфигуратор.
&ПараметризованныйТест
&ИсточникЗначение("ibcmd")
&ИсточникЗначение("designer")
Процедура ТестДолжен_ВыгрузитьКонфигурациюВФайлCf(Режим) Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителя();
	СтрокаПодключения = СтрокаПодключенияДляРежима(КаталогБазы, Режим);
	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	ДобавитьФлагРежима(Исполнитель, Режим);
	Исполнитель.ДобавитьАргумент("1Cv8.cf");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "выгрузка конфигурации в CF-файл");
	Исполнитель.ОжидаемЧтоФайлСуществует("1Cv8.cf");

КонецПроцедуры

// Каталог для выходного файла отсутствует - движок создаёт недостающие каталоги,
// команда завершается успешно (регрессия: раньше cf unload падал с ошибкой).
&ПараметризованныйТест
&ИсточникЗначение("ibcmd")
&ИсточникЗначение("designer")
Процедура ТестДолжен_СоздатьОтсутствующийКаталогПриВыгрузке(Режим) Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителя();
	СтрокаПодключения = СтрокаПодключенияДляРежима(КаталогБазы, Режим);
	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	ДобавитьФлагРежима(Исполнитель, Режим);
	ОтносительныйПутьВыхода = ОбъединитьПути("отсутствующий-каталог", "1Cv8.cf");
	Исполнитель.ДобавитьАргумент(ОтносительныйПутьВыхода);

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "выгрузка конфигурации в несуществующий каталог");
	Исполнитель.ОжидаемЧтоФайлСуществует(ОтносительныйПутьВыхода);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
	КаталогБазы = СоздатьБазуСКонфигурацией();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсполнителя()
	Аргументы = Новый Массив;
	Аргументы.Добавить("cf");
	Аргументы.Добавить("unload");
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

Функция СоздатьБазуСКонфигурацией()
	Каталог = ФикстурнаяФайловаяБД.СкопироватьВоВременнойКаталог();
	КаталогSrc = СоздатьИсполнителя().ПутьФикстуры("cf");
	Конфигуратор = Новый УправлениеКонфигуратором;
	Конфигуратор.УстановитьКонтекст("/F""" + Каталог + """", "", "");
	Конфигуратор.ЗагрузитьКонфигурациюИзФайлов(КаталогSrc);
	Возврат Каталог;
КонецФункции

Процедура ДобавитьФлагРежима(Исполнитель, Режим)
	Если Режим = "ibcmd" Тогда
		Исполнитель.ДобавитьФлаг("--ibcmd");
	КонецЕсли;
КонецПроцедуры

Функция СтрокаПодключенияДляРежима(Каталог, Режим)
	Если Режим = "ibcmd" Тогда
		Возврат Каталог;
	КонецЕсли;
	Возврат "/F""" + Каталог + """";
КонецФункции

#КонецОбласти
