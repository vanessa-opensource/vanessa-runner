// BSLLS-off
// Тестовый набор: cf load
// Интеграционные тесты загрузки конфигурации в базу.
//
// Фикстуры: tests/e2e/fixtures/cf/ - XML-исходники конфигурации

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands
#Использовать v8runner
#Использовать "../../utils"

Перем НакопленныеВременныеФайлы;
Перем КаталогБазы;

#Область СлужебныйПрограммныйИнтерфейс

// --settings должен быть не только виден в справке, но и реально участвовать
// в заполнении параметров cf load.
&Тест
Процедура ТестДолжен_ПрочитатьПараметрыИзФайлаНастроек() Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителя();
	КаталогSrc = Исполнитель.ПутьФикстуры("cf");
	ПутьНастроек = СоздатьНастройкиЗагрузки(КаталогБазы);
	Исполнитель.ДобавитьОпцию("--settings", ПутьНастроек);
	Исполнитель.ДобавитьАргумент(КаталогSrc);

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда: подключение и --no-update-db получены из JSON, а не из CLI.
	Исполнитель.ОжидаемЧтоКодВозврата(0, "загрузка конфигурации с параметрами из --settings");
	Исполнитель.ОжидаемЧтоВыводСодержит("Обновление конфигурации БД пропущено (--no-update-db)");

КонецПроцедуры

// Загрузка исходников в существующую базу.
// Прогоняется дважды: с ibcmd и через конфигуратор.
// Флаг не передаётся: заодно проверяем, что конфигурация БД обновляется по умолчанию.
&ПараметризованныйТест
&ИсточникЗначение("ibcmd")
&ИсточникЗначение("designer")
Процедура ТестДолжен_ЗагрузитьКонфигурациюИзИсходниковВБазу(Режим) Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителя();
	КаталогSrc = Исполнитель.ПутьФикстуры("cf");
	СтрокаПодключения = СтрокаПодключенияДляРежима(КаталогБазы, Режим);
	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	ДобавитьФлагРежима(Исполнитель, Режим);
	Исполнитель.ДобавитьАргумент(КаталогSrc);

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "загрузка конфигурации из исходников в базу");
	Исполнитель.ОжидаемЧтоВыводСодержит("Обновление основной конфигурации БД");

КонецПроцедуры

// Загрузка из файла cf в существующую базу.
// Прогоняется дважды: с ibcmd и через конфигуратор.
// Флаг --no-update-db: обновление конфигурации БД по умолчанию отключается.
&ПараметризованныйТест
&ИсточникЗначение("ibcmd")
&ИсточникЗначение("designer")
Процедура ТестДолжен_ЗагрузитьКонфигурациюИзФайлаCf(Режим) Экспорт

	// Дано
	ФайлCf = СобратьCfИзФикстур();

	Исполнитель = СоздатьИсполнителя();
	СтрокаПодключения = СтрокаПодключенияДляРежима(КаталогБазы, Режим);
	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	ДобавитьФлагРежима(Исполнитель, Режим);
	Исполнитель.ДобавитьФлаг("--no-update-db");
	Исполнитель.ДобавитьАргумент(ФайлCf);

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "загрузка конфигурации из CF-файла в базу");
	Исполнитель.ОжидаемЧтоВыводСодержит("Обновление конфигурации БД пропущено (--no-update-db)");
	Исполнитель.ОжидаемЧтоВыводНеСодержит("Обновление основной конфигурации БД");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("ibcmd")
&ИсточникЗначение("designer")
Процедура ТестДолжен_ПоддерживатьИнкрементальнуюЗагрузку(Режим) Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителя();
	КаталогSrc = ВременныеФайлы.СоздатьКаталог();
	КопироватьКаталог(Исполнитель.ПутьФикстуры("cf"), КаталогSrc);
	СтрокаПодключения = СтрокаПодключенияДляРежима(КаталогБазы, Режим);
	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	ДобавитьФлагРежима(Исполнитель, Режим);
	Исполнитель.ДобавитьФлаг("--increment");
	Исполнитель.ДобавитьФлаг("--no-update-db"); // тест инкремента: применение к БД не проверяем
	Исполнитель.ДобавитьАргумент(КаталогSrc);

	// Когда: первый запуск (индекса еще нет)
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "инкрементальная загрузка конфигурации");
	Исполнитель.ОжидаемЧтоВыводСодержит("ОТЛАДКА - [v.ПодкомандаCfLoad] - Начало выполнения команды cf load");

	// И: изменяем исходники
	ПутьКМодулю = ОбъединитьПути(КаталогSrc, "Ext", "ManagedApplicationModule.bsl");
	ДобавитьМетодВМодуль(ПутьКМодулю);

	// Когда: второй запуск после изменения исходников
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "инкрементальная загрузка конфигурации");
	Исполнитель.ОжидаемЧтоВыводСодержит("Инкрементальная загрузка: будет загружено");
	Исполнитель.ОжидаемЧтоВыводСодержит("ManagedApplicationModule.bsl");
	Исполнитель.ОжидаемЧтоВыводНеСодержит("Инкрементальная загрузка: изменений не найдено, загрузка пропущена");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
	КаталогБазы = СоздатьПустуюБазу();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсполнителя()
	Аргументы = Новый Массив;
	Аргументы.Добавить("cf");
	Аргументы.Добавить("load");
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

Функция СоздатьПустуюБазу()
	Возврат ФикстурнаяФайловаяБД.СкопироватьВоВременнойКаталог();
КонецФункции

Функция СоздатьНастройкиЗагрузки(Знач Каталог)

	НастройкиLoad = Новый Соответствие;
	НастройкиLoad.Вставить("ibconnection", "/F""" + Каталог + """");
	НастройкиLoad.Вставить("no-update-db", Истина);

	НастройкиCf = Новый Соответствие;
	НастройкиCf.Вставить("load", НастройкиLoad);

	НастройкиVrunner = Новый Соответствие;
	НастройкиVrunner.Вставить("cf", НастройкиCf);

	Корень = Новый Соответствие;
	Корень.Вставить("vrunner", НастройкиVrunner);

	Путь = ВременныеФайлы.НовоеИмяФайла("json");
	Запись = Новый ЗаписьJSON;
	Запись.ОткрытьФайл(Путь, "UTF-8");
	ЗаписатьJSON(Запись, Корень);
	Запись.Закрыть();

	Возврат Путь;

КонецФункции

Функция СобратьCfИзФикстур()
	КаталогСборки = СоздатьПустуюБазу();
	КаталогSrc = СоздатьИсполнителя().ПутьФикстуры("cf");
	Конфигуратор = Новый УправлениеКонфигуратором;
	Конфигуратор.УстановитьКонтекст("/F""" + КаталогСборки + """", "", "");
	Конфигуратор.ЗагрузитьКонфигурациюИзФайлов(КаталогSrc);
	ФайлCf = ВременныеФайлы.НовоеИмяФайла("cf");
	Конфигуратор.ВыгрузитьКонфигурациюВФайл(ФайлCf);
	Возврат ФайлCf;
КонецФункции

Процедура ДобавитьФлагРежима(Исполнитель, Режим)
	Если Режим = "ibcmd" Тогда
		Исполнитель.ДобавитьФлаг("--ibcmd");
	КонецЕсли;
КонецПроцедуры

Функция СтрокаПодключенияДляРежима(Каталог, Режим)
	Если Режим = "ibcmd" Тогда
		Возврат Каталог;
	КонецЕсли;
	Возврат "/F""" + Каталог + """";
КонецФункции

Процедура КопироватьКаталог(Знач КаталогИсточник, Знач КаталогНазначения)

	ПрефиксИсточника = Новый Файл(КаталогИсточник).ПолноеИмя;
	Разделитель = ПолучитьРазделительПути();
	Если Прав(ПрефиксИсточника, 1) <> Разделитель Тогда
		ПрефиксИсточника = ПрефиксИсточника + Разделитель;
	КонецЕсли;

	Элементы = НайтиФайлы(ПрефиксИсточника, "*", Истина);
	Для Каждого Элемент Из Элементы Цикл
		Если НЕ Элемент.ЭтоФайл() Тогда
			Продолжить;
		КонецЕсли;

		ОтносительныйПуть = Сред(Элемент.ПолноеИмя, СтрДлина(ПрефиксИсточника) + 1);
		ПутьНазначения = ОбъединитьПути(КаталогНазначения, ОтносительныйПуть);
		КаталогФайлаНазначения = Новый Файл(ПутьНазначения).Путь;
		Если НЕ Новый Файл(КаталогФайлаНазначения).Существует() Тогда
			СоздатьКаталог(КаталогФайлаНазначения);
		КонецЕсли;

		КопироватьФайл(Элемент.ПолноеИмя, ПутьНазначения);
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьМетодВМодуль(Знач ПутьКМодулю)

	Чтение = Новый ЧтениеТекста(ПутьКМодулю, "UTF-8");
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();

	ИмяМетода = "ТестовыйИнкремент_" + Формат(ТекущаяДата(), "ДФ=yyyyMMddHHmmss");
	Дополнение = Символы.ПС
		+ "Процедура " + ИмяМетода + "() Экспорт" + Символы.ПС
		+ "КонецПроцедуры" + Символы.ПС;

	Запись = Новый ЗаписьТекста(ПутьКМодулю, "UTF-8");
	Запись.Записать(Текст + Дополнение);
	Запись.Закрыть();

КонецПроцедуры

#КонецОбласти
