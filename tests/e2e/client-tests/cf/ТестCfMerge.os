// BSLLS-off
// Тестовый набор: cf merge
// Интеграционные тесты объединения конфигурации с cf-файлом.
//
// Фикстуры: tests/e2e/fixtures/1cv8.cf, tests/e2e/fixtures/merge-settings.xml

#Использовать asserts
#Использовать tempfiles
#Использовать v8runner
#Использовать "../../utils"

Перем НакопленныеВременныеФайлы;
Перем КаталогБазы;

#Область СлужебныйПрограммныйИнтерфейс

// Команда должна завершиться ошибкой, если не задана строка подключения.
&Тест
Процедура ТестДолжен_ВыброситьОшибкуЕслиНеЗаданаСтрокаПодключения() Экспорт

	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьОпцию("--src", Исполнитель.ПутьФикстуры("1cv8.cf"));
	Исполнитель.ДобавитьОпцию("--merge-settings", Исполнитель.ПутьФикстуры("merge-settings.xml"));

	Исполнитель.ВыполнитьКоманду();

	Исполнитель.ОжидаемЧтоКодВозврата(1, "cf merge без --ibconnection");

КонецПроцедуры

// Команда должна завершиться ошибкой, если не задан src.
&Тест
Процедура ТестДолжен_ВыброситьОшибкуЕслиНеЗаданSrc() Экспорт

	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьОпцию("--ibconnection", "/F""" + КаталогБазы + """");
	Исполнитель.ДобавитьОпцию("--merge-settings", Исполнитель.ПутьФикстуры("merge-settings.xml"));

	Исполнитель.ВыполнитьКоманду();

	Исполнитель.ОжидаемЧтоКодВозврата(1, "cf merge без --src");

КонецПроцедуры

// Команда должна завершиться ошибкой, если не задан merge-settings.
&Тест
Процедура ТестДолжен_ВыброситьОшибкуЕслиНеЗаданMergeSettings() Экспорт

	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьОпцию("--ibconnection", "/F""" + КаталогБазы + """");
	Исполнитель.ДобавитьОпцию("--src", Исполнитель.ПутьФикстуры("1cv8.cf"));

	Исполнитель.ВыполнитьКоманду();

	Исполнитель.ОжидаемЧтоКодВозврата(1, "cf merge без --merge-settings");

КонецПроцедуры

// Объединение конфигурации базы с cf-файлом.
&Тест
Процедура ТестДолжен_ОбъединитьКонфигурациюCfСБазой() Экспорт

	// Дано: загружаем конфигурацию в базу
	СтрокаПодключения = "/F""" + КаталогБазы + """";
	Конфигуратор = Новый УправлениеКонфигуратором;
	Конфигуратор.УстановитьКонтекст(СтрокаПодключения, "", "");
	Конфигуратор.ЗагрузитьКонфигурациюИзФайла(СоздатьИсполнителя().ПутьФикстуры("1cv8.cf"));

	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Исполнитель.ДобавитьОпцию("--src",           Исполнитель.ПутьФикстуры("1cv8.cf"));
	Исполнитель.ДобавитьОпцию("--merge-settings", Исполнитель.ПутьФикстуры("merge-settings.xml"));
	Исполнитель.ДобавитьФлаг("--force");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "объединение конфигурации с CF-файлом");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
	КаталогБазы = СоздатьПустуюБазу();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсполнителя()
	Аргументы = Новый Массив;
	Аргументы.Добавить("cf");
	Аргументы.Добавить("merge");
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

Функция СоздатьПустуюБазу()
	Возврат ФикстурнаяФайловаяБД.СкопироватьВоВременнойКаталог();
КонецФункции

#КонецОбласти
