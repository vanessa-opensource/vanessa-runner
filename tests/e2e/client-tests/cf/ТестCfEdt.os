// BSLLS-off
// Тестовый набор: поддержка формата 1С:EDT для команды cf.
// Round-trip: cf decompile --src-format edt (cf -> EDT-проект),
// затем cf compile --src-format edt (EDT-проект -> cf).
//
// Требуется установленная 1С:EDT (1cedtcli). Если она не найдена - тест самопропускается
// (логирует причину и завершается успешно), т.к. на CI без EDT проверить нечего.
//
// Фикстуры: tests/e2e/fixtures/cf/ - XML-исходники конфигурации.

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands
#Использовать v8runner
#Использовать "../../utils"

Перем НакопленныеВременныеФайлы;

#Область СлужебныйПрограммныйИнтерфейс

// cf decompile в формат EDT с последующей cf compile из EDT.
&Тест
Процедура ТестДолжен_РазобратьВEDTИСобратьОбратно() Экспорт

	// Дано
	ПутьCf = СобратьCfИзФикстур();

	Разборщик = СоздатьИсполнителяDecompile();
	Разборщик.ДобавитьОпцию("--cf-file", ПутьCf);
	Разборщик.ДобавитьОпцию("--src-format", "edt");
	Разборщик.ДобавитьАргумент("edt-out");

	// Когда
	Разборщик.ВыполнитьКоманду();

	// EDT не установлена -> самопропуск
	Если EDTНеДоступна(Разборщик) Тогда
		Сообщить("ПРОПУЩЕНО: 1cedtcli не найдена - тест EDT round-trip не выполняется");
		Возврат;
	КонецЕсли;

	// Тогда - получен EDT-проект
	Разборщик.ОжидаемЧтоКодВозврата(0, "cf decompile в формат EDT");
	Разборщик.ОжидаемЧтоФайлСуществует(ОбъединитьПути("edt-out", ".project"));

	// И - собираем cf обратно из EDT-проекта
	КаталогEDT = ОбъединитьПути(Разборщик.КаталогРаботы(), "edt-out");
	ПутьCf2 = ВременныеФайлы.НовоеИмяФайла("cf");

	Сборщик = СоздатьИсполнителяCompile();
	Сборщик.ДобавитьОпцию("--s", КаталогEDT);
	Сборщик.ДобавитьОпцию("--src-format", "edt");
	Сборщик.ДобавитьАргумент(ПутьCf2);
	Сборщик.ВыполнитьКоманду();

	Сборщик.ОжидаемЧтоКодВозврата(0, "cf compile из EDT-проекта");
	Ожидаем.Что(Новый Файл(ПутьCf2).Существует(), "собранный cf из EDT существует").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсполнителяDecompile()
	Аргументы = Новый Массив;
	Аргументы.Добавить("cf");
	Аргументы.Добавить("decompile");
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

Функция СоздатьИсполнителяCompile()
	Аргументы = Новый Массив;
	Аргументы.Добавить("cf");
	Аргументы.Добавить("compile");
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

// EDT считается недоступной, если команда упала с сообщением о ненайденной 1cedtcli.
Функция EDTНеДоступна(Исполнитель)
	Возврат Исполнитель.КодВозврата() <> 0
		И СтрНайти(Исполнитель.Вывод(), "Не удалось найти 1cedtcli") > 0;
КонецФункции

Функция СобратьCfИзФикстур()
	Исполнитель = СоздатьИсполнителяDecompile();
	КаталогБазы = ФикстурнаяФайловаяБД.СкопироватьВоВременнойКаталог();
	КаталогSrc = Исполнитель.ПутьФикстуры("cf");
	Конфигуратор = Новый УправлениеКонфигуратором;
	Конфигуратор.УстановитьКонтекст("/F""" + КаталогБазы + """", "", "");
	Конфигуратор.ЗагрузитьКонфигурациюИзФайлов(КаталогSrc);
	ПутьCf = ВременныеФайлы.НовоеИмяФайла("cf");
	Конфигуратор.ВыгрузитьКонфигурациюВФайл(ПутьCf);
	Возврат ПутьCf;
КонецФункции

#КонецОбласти
