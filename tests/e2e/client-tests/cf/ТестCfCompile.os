// BSLLS-off
// Тестовый набор: cf compile
// Интеграционные тесты сборки конфигурации из исходников.
//
// Тесты запускают реальную CLI-команду `vrunner cf compile` через подпроцесс.
// Базовые сценарии параметризованы по режиму (ibcmd / конфигуратор).
//
// Фикстуры: tests/e2e/fixtures/cf/ — XML-исходники конфигурации

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands
#Использовать v8runner
#Использовать "../../utils"

Перем НакопленныеВременныеФайлы;

#Область СлужебныйПрограммныйИнтерфейс

// Сборка исходников в файл cf.
// Прогоняется дважды: с ibcmd и через конфигуратор.
&ПараметризованныйТест
&ИсточникЗначение("ibcmd")
&ИсточникЗначение("designer")
Процедура ТестДолжен_СобратьКонфигурациюИзИсходниковВФайлCf(Режим) Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителя();
	КаталогSrc = Исполнитель.ПутьФикстуры("cf");
	Исполнитель.ДобавитьОпцию("--src", КаталогSrc);
	ДобавитьФлагРежима(Исполнитель, Режим);
	Исполнитель.ДобавитьАргумент("1Cv8.cf");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "сборка конфигурации из исходников в CF-файл");
	Исполнитель.ОжидаемЧтоФайлСуществует("1Cv8.cf");

КонецПроцедуры

// Сборка исходников в файл cf с использованием существующей файловой базы.
&Тест
Процедура ТестДолжен_СобратьCfИзСуществующейБазыДизайнер() Экспорт

	// Дано
	КаталогБазы = ВременныеФайлы.СоздатьКаталог();
	Конфигуратор = Новый УправлениеКонфигуратором;
	Конфигуратор.СоздатьФайловуюБазу(КаталогБазы);

	Исполнитель = СоздатьИсполнителя();
	КаталогSrc = Исполнитель.ПутьФикстуры("cf");
	Исполнитель.ДобавитьОпцию("--src", КаталогSrc);
	СтрокаПодключения = "/F""" + КаталогБазы + """";
	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Исполнитель.ДобавитьАргумент("1Cv8.cf");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "сборка CF через конфигуратор с существующей базой");
	Исполнитель.ОжидаемЧтоФайлСуществует("1Cv8.cf");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсполнителя()
	Аргументы = Новый Массив;
	Аргументы.Добавить("cf");
	Аргументы.Добавить("compile");
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

Процедура ДобавитьФлагРежима(Исполнитель, Режим)
	Если Режим = "ibcmd" Тогда
		Исполнитель.ДобавитьФлаг("--ibcmd");
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
