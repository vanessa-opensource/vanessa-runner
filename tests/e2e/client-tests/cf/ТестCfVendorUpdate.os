// BSLLS-off
// Тестовый набор: cf vendor-update
// Интеграционные тесты обновления конфигурации на поддержке из файла поставщика (/UpdateCfg).
//
// Пакетный /UpdateCfg работает только с базой, уже находящейся на поддержке, и требует
// дистрибутив другой версии («Файл не содержит доступных обновлений» иначе). Поэтому сценарий:
//   1) один раз на процесс готовятся два дистрибутива поставки (1.0.0.0 и 1.0.1.0) в build/,
//   2) per-test база ставится на поддержку объединением с дистрибутивом 1.0.0.0,
//   3) команда обновляет её дистрибутивом 1.0.1.0.
//
// Фикстуры: tests/e2e/fixtures/1cv8.cf (Поставщик=Vanessa-Runner, Версия=1.0.0.0),
//           tests/e2e/fixtures/cf (XML-исходники той же конфигурации),
//           tests/e2e/fixtures/merge-settings.xml

#Использовать asserts
#Использовать tempfiles
#Использовать v8runner
#Использовать "../../utils"

Перем НакопленныеВременныеФайлы;

#Область СлужебныйПрограммныйИнтерфейс

// Команда должна завершиться ошибкой, если не задана строка подключения.
&Тест
Процедура ТестДолжен_ВыброситьОшибкуЕслиНеЗаданаСтрокаПодключения() Экспорт

	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьОпцию("--src", Исполнитель.ПутьФикстуры("1cv8.cf"));

	Исполнитель.ВыполнитьКоманду();

	Исполнитель.ОжидаемЧтоКодВозврата(1, "cf vendor-update без --ibconnection");

КонецПроцедуры

// Команда должна завершиться ошибкой, если не задан src.
&Тест
Процедура ТестДолжен_ВыброситьОшибкуЕслиНеЗаданSrc() Экспорт

	КаталогБазы = ПомощникИБ.ПолучитьИзолированнуюИБ();
	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьОпцию("--ibconnection", "/F""" + КаталогБазы + """");

	Исполнитель.ВыполнитьКоманду();

	Исполнитель.ОжидаемЧтоКодВозврата(1, "cf vendor-update без --src");

КонецПроцедуры

// Команда должна завершиться ошибкой, если файл обновления не существует.
&Тест
Процедура ТестДолжен_ВыброситьОшибкуЕслиФайлНеНайден() Экспорт

	КаталогБазы = ПомощникИБ.ПолучитьИзолированнуюИБ();
	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьОпцию("--ibconnection", "/F""" + КаталогБазы + """");
	Исполнитель.ДобавитьОпцию("--src", ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "нет-такого.cfu"));

	Исполнитель.ВыполнитьКоманду();

	Исполнитель.ОжидаемЧтоКодВозврата(1, "cf vendor-update с несуществующим файлом");
	Исполнитель.ОжидаемЧтоВыводСодержит("Файл обновления конфигурации не найден");

КонецПроцедуры

// Обновление базы на поддержке дистрибутивом новой версии поставщика.
&Тест
&Тег("integration")
Процедура ТестДолжен_ОбновитьКонфигурациюНаПоддержке() Экспорт

	// Дано: база на поддержке от версии 1.0.0.0 и дистрибутив 1.0.1.0
	ПодготовитьДистрибутивы();
	КаталогБазы = ПодготовитьБазуНаПоддержке();

	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьОпцию("--ibconnection", "/F""" + КаталогБазы + """");
	Исполнитель.ДобавитьОпцию("--src", ПутьДистрибутива2());
	Исполнитель.ДобавитьФлаг("--force");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "обновление конфигурации на поддержке");
	Исполнитель.ОжидаемЧтоВыводСодержит("Конфигурация успешно обновлена из файла");
	Исполнитель.ОжидаемЧтоВыводСодержит("Конфигурация базы данных обновлена");

КонецПроцедуры

// Шаблон $version в имени файла: из двух дистрибутивов выбирается старшая версия.
&Тест
&Тег("integration")
Процедура ТестДолжен_ВыбратьСтаршийДистрибутивПоШаблонуВерсии() Экспорт

	// Дано: база на поддержке 1.0.0.0; в build/e2e-fixtures лежат дистрибутивы 1.0.0.0 и 1.0.1.0
	ПодготовитьДистрибутивы();
	КаталогБазы = ПодготовитьБазуНаПоддержке();

	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьОпцию("--ibconnection", "/F""" + КаталогБазы + """");
	Исполнитель.ДобавитьОпцию("--src",
		ОбъединитьПути(ТекущийКаталог(), "build", "e2e-fixtures", "vendor-dist-$version.cf"));
	Исполнитель.ДобавитьФлаг("--force");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "обновление по шаблону $version");
	Исполнитель.ОжидаемЧтоВыводСодержит("выбран файл");
	Исполнитель.ОжидаемЧтоВыводСодержит("vendor-dist-1.0.1.0.cf");
	Исполнитель.ОжидаемЧтоВыводСодержит("Конфигурация успешно обновлена из файла");

КонецПроцедуры

// С флагом --no-update-db конфигурация БД не обновляется.
&Тест
&Тег("integration")
Процедура ТестДолжен_ПропуститьОбновлениеБДПоФлагу() Экспорт

	// Дано
	ПодготовитьДистрибутивы();
	КаталогБазы = ПодготовитьБазуНаПоддержке();

	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьОпцию("--ibconnection", "/F""" + КаталогБазы + """");
	Исполнитель.ДобавитьОпцию("--src", ПутьДистрибутива2());
	Исполнитель.ДобавитьФлаг("--force");
	Исполнитель.ДобавитьФлаг("--no-update-db");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "обновление с --no-update-db");
	Исполнитель.ОжидаемЧтоВыводСодержит("Обновление конфигурации БД пропущено");
	Исполнитель.ОжидаемЧтоВыводНеСодержит("Конфигурация базы данных обновлена");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсполнителя()
	Аргументы = Новый Массив;
	Аргументы.Добавить("cf");
	Аргументы.Добавить("vendor-update");
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

Функция ПутьДистрибутива1()
	Возврат ОбъединитьПути(ТекущийКаталог(), "build", "e2e-fixtures", "vendor-dist-1.0.0.0.cf");
КонецФункции

Функция ПутьДистрибутива2()
	Возврат ОбъединитьПути(ТекущийКаталог(), "build", "e2e-fixtures", "vendor-dist-1.0.1.0.cf");
КонецФункции

// Готовит дистрибутивы поставки версий 1.0.0.0 и 1.0.1.0 ровно один раз на процесс
// (стабильные пути в build/ + гард по существованию, см. e2e-tests-authoring).
Процедура ПодготовитьДистрибутивы()

	Если Новый Файл(ПутьДистрибутива1()).Существует() И Новый Файл(ПутьДистрибутива2()).Существует() Тогда
		Возврат;
	КонецЕсли;

	КаталогБазы = ПомощникИБ.ПолучитьИзолированнуюИБ();
	Конфигуратор = Новый УправлениеКонфигуратором;
	Конфигуратор.УстановитьКонтекст("/F""" + КаталогБазы + """", "", "");
	Конфигуратор.СоздатьФайлыПоставки(ПутьДистрибутива1());

	// Исходники с поднятой версией → та же база → дистрибутив новой версии
	КаталогИсходников = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "src");
	СкопироватьКаталог(СоздатьИсполнителя().ПутьФикстуры("cf"), КаталогИсходников);
	ПоднятьВерсиюКонфигурации(ОбъединитьПути(КаталогИсходников, "Configuration.xml"));
	Конфигуратор.ЗагрузитьКонфигурациюИзФайлов(КаталогИсходников, Неопределено);
	// CreateDistributionFiles требует применённую к БД конфигурацию
	Конфигуратор.ОбновитьКонфигурациюБазыДанных();
	Конфигуратор.СоздатьФайлыПоставки(ПутьДистрибутива2());

КонецПроцедуры

// Возвращает каталог изолированной базы, поставленной на поддержку
// объединением с дистрибутивом 1.0.0.0 (пакетный /UpdateCfg работает только на поддержке).
Функция ПодготовитьБазуНаПоддержке()

	КаталогБазы = ПомощникИБ.ПолучитьИзолированнуюИБ();
	Конфигуратор = Новый УправлениеКонфигуратором;
	Конфигуратор.УстановитьКонтекст("/F""" + КаталогБазы + """", "", "");
	Конфигуратор.ОбъединитьКонфигурациюСФайлом(ПутьДистрибутива1(),
		СоздатьИсполнителя().ПутьФикстуры("merge-settings.xml"), Истина, Неопределено, Истина);
	Возврат КаталогБазы;

КонецФункции

Процедура СкопироватьКаталог(Знач Источник, Знач Приемник)

	СоздатьКаталог(Приемник);
	Для Каждого Файл Из НайтиФайлы(Источник, "*", Ложь) Цикл
		Если Файл.ЭтоКаталог() Тогда
			СкопироватьКаталог(Файл.ПолноеИмя, ОбъединитьПути(Приемник, Файл.Имя));
		Иначе
			КопироватьФайл(Файл.ПолноеИмя, ОбъединитьПути(Приемник, Файл.Имя));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПоднятьВерсиюКонфигурации(Знач ПутьКФайлу)

	Чтение = Новый ЧтениеТекста(ПутьКФайлу, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();

	ТекстНовый = СтрЗаменить(Текст, "<Version>1.0.0.0</Version>", "<Version>1.0.1.0</Version>");
	Если ТекстНовый = Текст Тогда
		ВызватьИсключение "Не удалось поднять версию конфигурации: строка <Version>1.0.0.0</Version> не найдена в " + ПутьКФайлу;
	КонецЕсли;

	Запись = Новый ЗаписьТекста(ПутьКФайлу, КодировкаТекста.UTF8);
	Запись.Записать(ТекстНовый);
	Запись.Закрыть();

КонецПроцедуры

#КонецОбласти
