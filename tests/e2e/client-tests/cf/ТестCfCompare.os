// BSLLS-off
// Тестовый набор: cf compare
// Интеграционные тесты сравнения конфигурации.
//
// Режим 1: cf vs cf  - --first-cf + --second-cf (ibconnection не обязателен)
// Режим 2: база vs cf - только --second-cf (ibconnection обязателен)

#Использовать asserts
#Использовать tempfiles
#Использовать v8runner
#Использовать "../../utils"

Перем НакопленныеВременныеФайлы;
Перем КаталогБазы;

#Область СлужебныйПрограммныйИнтерфейс

// Команда должна завершиться ошибкой, если не задан second-cf.
&Тест
Процедура ТестДолжен_ВыброситьОшибкуЕслиНеЗаданВторойCf() Экспорт

	Исполнитель = СоздатьИсполнителя();

	Исполнитель.ВыполнитьКоманду();

	Исполнитель.ОжидаемЧтоКодВозврата(1, "cf compare без --second-cf");

КонецПроцедуры

// В режиме сравнения с базой команда должна требовать ibconnection.
&Тест
Процедура ТестДолжен_ВыброситьОшибкуЕслиНетБазыПриСравненииСБазой() Экспорт

	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьОпцию("--second-cf", Исполнитель.ПутьФикстуры("1cv8.cf"));

	Исполнитель.ВыполнитьКоманду();

	Исполнитель.ОжидаемЧтоКодВозврата(1, "cf compare с базой без --ibconnection");

КонецПроцедуры

// Сравнение двух cf-файлов: файл против самого себя → отчёт в текущем каталоге.
&Тест
Процедура ТестДолжен_СравнитьДваФайлаCf() Экспорт

	КаталогОтчётов = ВременныеФайлы.СоздатьКаталог();
	ПутьCf = СоздатьИсполнителя().ПутьФикстуры("1cv8.cf");

	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьОпцию("--first-cf",    ПутьCf);
	Исполнитель.ДобавитьОпцию("--second-cf",   ПутьCf);
	Исполнитель.ДобавитьОпцию("--report-dir",  КаталогОтчётов);

	Исполнитель.ВыполнитьКоманду();

	Исполнитель.ОжидаемЧтоКодВозврата(0, "сравнение двух CF-файлов");

	// Отчёт должен появиться в каталоге
	ФайлыОтчёта = НайтиФайлы(КаталогОтчётов, "compare_report_*.txt", Ложь);
	Ожидаем.Что(ФайлыОтчёта.Количество()).Больше(0);

КонецПроцедуры

// Пользовательский каталог отчётов: файл появляется именно там.
&Тест
Процедура ТестДолжен_СохранитьОтчётВУказанныйКаталог() Экспорт

	КаталогОтчётов = ВременныеФайлы.СоздатьКаталог();
	ПутьCf = СоздатьИсполнителя().ПутьФикстуры("1cv8.cf");

	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьОпцию("--first-cf",      ПутьCf);
	Исполнитель.ДобавитьОпцию("--second-cf",      ПутьCf);
	Исполнитель.ДобавитьОпцию("--report-dir",     КаталогОтчётов);
	Исполнитель.ДобавитьОпцию("--report-type",    "Brief");
	Исполнитель.ДобавитьОпцию("--report-format",  "txt");

	Исполнитель.ВыполнитьКоманду();

	Исполнитель.ОжидаемЧтоКодВозврата(0);

	ФайлыОтчёта = НайтиФайлы(КаталогОтчётов, "compare_report_brief_*.txt", Ложь);
	Ожидаем.Что(ФайлыОтчёта.Количество()).Больше(0);

КонецПроцедуры

// Сравнение конфигурации базы с cf-файлом (режим база vs cf).
&Тест
Процедура ТестДолжен_СравнитьКонфигурациюБазыСCf() Экспорт

	// Дано: загружаем конфигурацию в базу
	СтрокаПодключения = "/F""" + КаталогБазы + """";
	Конфигуратор = Новый УправлениеКонфигуратором;
	Конфигуратор.УстановитьКонтекст(СтрокаПодключения, "", "");
	Конфигуратор.ЗагрузитьКонфигурациюИзФайла(СоздатьИсполнителя().ПутьФикстуры("1cv8.cf"));

	КаталогОтчётов = ВременныеФайлы.СоздатьКаталог();

	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьОпцию("--ibconnection",  СтрокаПодключения);
	Исполнитель.ДобавитьОпцию("--second-cf",     Исполнитель.ПутьФикстуры("1cv8.cf"));
	Исполнитель.ДобавитьОпцию("--report-dir",    КаталогОтчётов);

	Исполнитель.ВыполнитьКоманду();

	Исполнитель.ОжидаемЧтоКодВозврата(0, "сравнение конфигурации базы с CF-файлом");

	ФайлыОтчёта = НайтиФайлы(КаталогОтчётов, "compare_report_*.txt", Ложь);
	Ожидаем.Что(ФайлыОтчёта.Количество()).Больше(0);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
	КаталогБазы = СоздатьПустуюБазу();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсполнителя()
	Аргументы = Новый Массив;
	Аргументы.Добавить("cf");
	Аргументы.Добавить("compare");
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

Функция СоздатьПустуюБазу()
	Возврат ФикстурнаяФайловаяБД.СкопироватьВоВременнойКаталог();
КонецФункции

#КонецОбласти
