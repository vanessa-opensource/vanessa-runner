// BSLLS-off
// Тестовый набор: cf make-dist - создание полного файла поставки Конфигуратором.

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands
#Использовать "../../utils"

Перем НакопленныеВременныеФайлы;

#Область СлужебныйПрограммныйИнтерфейс

&Тест
&Тег("integration")
Процедура ТестДолжен_СоздатьПолныйФайлПоставки() Экспорт

	// Дано
	КаталогБазы = ПомощникИБ.ПолучитьИзолированнуюИБ();
	КаталогРезультата = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "dist");
	ПутьПоставки = ОбъединитьПути(КаталогРезультата, "1Cv8.cf");

	Аргументы = Новый Массив;
	Аргументы.Добавить("cf");
	Аргументы.Добавить("make-dist");
	Исполнитель = Новый ИсполнительCLI(Аргументы);
	Исполнитель.ДобавитьОпцию("--ibconnection", "/F""" + КаталогБазы + """");
	Исполнитель.ДобавитьАргумент(ПутьПоставки);

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "создание полного файла поставки");
	Исполнитель.ОжидаемЧтоВыводСодержит("Полный файл поставки конфигурации создан");
	Ожидаем.Что(Новый Файл(ПутьПоставки).Существует(),
		"Конфигуратор должен создать полный файл поставки").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти
