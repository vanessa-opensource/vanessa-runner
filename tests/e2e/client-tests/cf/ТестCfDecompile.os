// BSLLS-off
// Тестовый набор: cf decompile
// Интеграционные тесты разборки конфигурации из файла cf в исходники.
//
// Фикстуры: tests/e2e/fixtures/cf/ - XML-исходники конфигурации

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands
#Использовать v8runner
#Использовать "../../utils"

Перем НакопленныеВременныеФайлы;

#Область СлужебныйПрограммныйИнтерфейс

// Разборка файла cf в каталог исходников.
// Прогоняется дважды: с ibcmd и через конфигуратор.
&ПараметризованныйТест
&ИсточникЗначение("ibcmd")
&ИсточникЗначение("designer")
Процедура ТестДолжен_РазобратьКонфигурациюИзФайлаCfВИсходники(Режим) Экспорт

	// Дано
	ПутьCf = СобратьCfИзФикстур(Режим);
	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьОпцию("--cf-file", ПутьCf);
	ДобавитьФлагРежима(Исполнитель, Режим);
	Исполнитель.ДобавитьАргумент("out");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "разборка конфигурации из CF-файла в исходники");
	Исполнитель.ОжидаемЧтоКаталогСуществует("out");
	Исполнитель.ОжидаемЧтоФайлСуществует(ОбъединитьПути("out", "Configuration.xml"));

КонецПроцедуры

// Разборка в исходники напрямую из существующей ИБ, без указания cf-файла.
// Стадия загрузки cf пропускается, конфигурация выгружается из переданной базы.
&ПараметризованныйТест
&ИсточникЗначение("ibcmd")
&ИсточникЗначение("designer")
Процедура ТестДолжен_ВыгрузитьИсходникиИзБазыБезCf(Режим) Экспорт

	// Дано - заполненная фикстурой файловая ИБ, cf-файл не задаётся
	КаталогБазы = ПодготовитьБазуИзФикстур();
	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьОпцию("--ibconnection", "/F""" + КаталогБазы + """");
	ДобавитьФлагРежима(Исполнитель, Режим);
	Исполнитель.ДобавитьАргумент("out");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "разборка конфигурации из ИБ в исходники без cf-файла");
	Исполнитель.ОжидаемЧтоКаталогСуществует("out");
	Исполнитель.ОжидаемЧтоФайлСуществует(ОбъединитьПути("out", "Configuration.xml"));

КонецПроцедуры

// Если не заданы ни cf-файл, ни ИБ (потребовалась бы пустая временная база) -
// команда должна завершиться с ошибкой: выгружать нечего.
&Тест
Процедура ТестДолжен_ВернутьОшибку_ЕслиНетCfИНетБазы() Экспорт

	// Дано - ни --cf-file, ни --ibconnection
	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьАргумент("out");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Ожидаем.Что(Исполнитель.КодВозврата(),
		"команда без cf-файла и без базы должна завершиться с ненулевым кодом").Не_().Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсполнителя()
	Аргументы = Новый Массив;
	Аргументы.Добавить("cf");
	Аргументы.Добавить("decompile");
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

// Скопировать пустую ИБ из фикстуры и загрузить в неё конфигурацию из XML-исходников.
// Возвращает каталог заполненной файловой ИБ.
Функция ПодготовитьБазуИзФикстур()
	Исполнитель = СоздатьИсполнителя();
	КаталогБазы = ФикстурнаяФайловаяБД.СкопироватьВоВременнойКаталог();
	КаталогSrc = Исполнитель.ПутьФикстуры("cf");
	Конфигуратор = Новый УправлениеКонфигуратором;
	Конфигуратор.УстановитьКонтекст("/F""" + КаталогБазы + """", "", "");
	Конфигуратор.ЗагрузитьКонфигурациюИзФайлов(КаталогSrc);
	Возврат КаталогБазы;
КонецФункции

Функция СобратьCfИзФикстур(Режим)
	КаталогБазы = ПодготовитьБазуИзФикстур();
	Конфигуратор = Новый УправлениеКонфигуратором;
	Конфигуратор.УстановитьКонтекст("/F""" + КаталогБазы + """", "", "");
	ПутьCf = ВременныеФайлы.НовоеИмяФайла("cf");
	Конфигуратор.ВыгрузитьКонфигурациюВФайл(ПутьCf);
	Возврат ПутьCf;
КонецФункции

Процедура ДобавитьФлагРежима(Исполнитель, Режим)
	Если Режим = "ibcmd" Тогда
		Исполнитель.ДобавитьФлаг("--ibcmd");
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
