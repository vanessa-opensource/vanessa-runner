// BSLLS-off
// Тестовый набор: settings
// Интеграционные тесты каскадного разрешения настроек.
//
// Проверяет:
// - Чтение настроек из файла --settings
// - Каскадный поиск: vrunner.debug.echo.src → vrunner.debug.src → vrunner.src
// - Приоритет CLI-аргументов над настройками
// - Команду echo (чистое чтение настроек)
// - Команду resolve (CLI + настройки)
//
// Фикстуры: tests/e2e/fixtures/settings/*.json

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands
#Использовать "../../utils"

Перем НакопленныеВременныеФайлы;

#Область СлужебныйПрограммныйИнтерфейс

// ---------- debug echo: чистое чтение настроек ----------

// При передаче --settings с корневыми настройками
// каскадный поиск по пути debug.echo находит значения на уровне vrunner.*
&Тест
Процедура ТестДолжен_ПрочитатьНастройкиИзФайлаНаКорневомУровне() Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителяEcho();
	Исполнитель.ДобавитьОпцию("--settings", Исполнитель.ПутьФикстуры("settings", "root-only.json"));

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "чтение настроек из файла на корневом уровне");
	Исполнитель.ОжидаемЧтоВыводСодержит("src=root-src");
	Исполнитель.ОжидаемЧтоВыводСодержит("ibcmd=true");
	Исполнитель.ОжидаемЧтоВыводСодержит("ibconnection=/Froot/ib");
	Исполнитель.ОжидаемЧтоВыводСодержит("v8version=8.3.20");
	Исполнитель.ОжидаемЧтоВыводСодержит("db-user=root-admin");

КонецПроцедуры

// Каскадный поиск: наиболее специфичный ключ выигрывает.
// cascade.json: vrunner.debug.echo.src = "echo-src" (самый специфичный),
// vrunner.debug.src = "debug-src", vrunner.src = "root-src"
&Тест
Процедура ТестДолжен_КаскадныйПоискВозвращаетСамоеСпецифичноеЗначение() Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителяEcho();
	Исполнитель.ДобавитьОпцию("--settings", Исполнитель.ПутьФикстуры("settings", "cascade.json"));

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "каскадный поиск настроек");
	// src: задан на всех трёх уровнях → берём echo-src (самый специфичный)
	Исполнитель.ОжидаемЧтоВыводСодержит("src=echo-src");
	// ibconnection: задан на уровне debug и root → берём debug-level
	Исполнитель.ОжидаемЧтоВыводСодержит("ibconnection=/Fdebug/ib");
	// ibcmd: задан только на root → берём root-level
	Исполнитель.ОжидаемЧтоВыводСодержит("ibcmd=true");
	// v8version: задан на root и debug.resolve, но НЕ на debug.echo → берём root
	Исполнитель.ОжидаемЧтоВыводСодержит("v8version=8.3.20");
	// db-user: задан только на debug.echo → берём echo-level
	Исполнитель.ОжидаемЧтоВыводСодержит("db-user=echo-admin");

КонецПроцедуры

// Если --settings не передан, настройки из vrunner.* не найдены (пустые значения).
&Тест
Процедура ТестДолжен_БезФайлаНастроекВозвращатьПустыеЗначения() Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителяEcho();

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "работа без файла настроек");
	Исполнитель.ОжидаемЧтоВыводСодержит("src=");
	Исполнитель.ОжидаемЧтоВыводСодержит("ibcmd=");
	Исполнитель.ОжидаемЧтоВыводСодержит("ibconnection=");

КонецПроцедуры

// ---------- debug resolve: CLI + настройки ----------

// CLI-аргументы имеют приоритет над настройками файла.
&Тест
Процедура ТестДолжен_CLIАргументыПриоритетнееНастроек() Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителяResolve();
	Исполнитель.ДобавитьОпцию("--settings", Исполнитель.ПутьФикстуры("settings", "root-only.json"));
	Исполнитель.ДобавитьОпцию("--src", "cli-src");
	Исполнитель.ДобавитьОпцию("--ibconnection", "/Fcli/ib");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "CLI-аргументы имеют приоритет над настройками");
	// CLI значения побеждают
	Исполнитель.ОжидаемЧтоВыводСодержит("src=cli-src");
	Исполнитель.ОжидаемЧтоВыводСодержит("ibconnection=/Fcli/ib");
	// Незаданные через CLI — из настроек
	Исполнитель.ОжидаемЧтоВыводСодержит("v8version=8.3.20");
	Исполнитель.ОжидаемЧтоВыводСодержит("ibcmd=true");

КонецПроцедуры

// Только настройки без CLI-аргументов: пустые опции заполняются из файла.
&Тест
Процедура ТестДолжен_ЗаполнитьПустыеОпцииИзНастроек() Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителяResolve();
	Исполнитель.ДобавитьОпцию("--settings", Исполнитель.ПутьФикстуры("settings", "root-only.json"));

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "заполнение пустых опций из файла настроек");
	Исполнитель.ОжидаемЧтоВыводСодержит("src=root-src");
	Исполнитель.ОжидаемЧтоВыводСодержит("ibconnection=/Froot/ib");
	Исполнитель.ОжидаемЧтоВыводСодержит("v8version=8.3.20");
	Исполнитель.ОжидаемЧтоВыводСодержит("ibcmd=true");

КонецПроцедуры

// Каскад в resolve: настройки берутся по специфичности пути команды.
&Тест
Процедура ТестДолжен_КаскадВResolveБеретСпецифичныеНastройки() Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителяResolve();
	Исполнитель.ДобавитьОпцию("--settings", Исполнитель.ПутьФикстуры("settings", "cascade.json"));

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "каскадное чтение настроек в resolve");
	// src: нет на debug.resolve → берём debug.src → "debug-src"
	Исполнитель.ОжидаемЧтоВыводСодержит("src=debug-src");
	// v8version: есть на debug.resolve → "8.3.25"
	Исполнитель.ОжидаемЧтоВыводСодержит("v8version=8.3.25");
	// ibconnection: нет на debug.resolve → берём debug → "/Fdebug/ib"
	Исполнитель.ОжидаемЧтоВыводСодержит("ibconnection=/Fdebug/ib");
	// ibcmd: нет на debug.resolve, нет на debug → берём root → true
	Исполнитель.ОжидаемЧтоВыводСодержит("ibcmd=true");

КонецПроцедуры

// CLI-флаг --ibcmd переопределяет false в настройках.
&Тест
Процедура ТестДолжен_ФлагCLIПереопределяетНастройкиFalse() Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителяResolve();
	Исполнитель.ДобавитьОпцию("--settings", Исполнитель.ПутьФикстуры("settings", "override.json"));
	Исполнитель.ДобавитьФлаг("--ibcmd");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "CLI-флаг переопределяет настройку со значением false");
	// CLI --ibcmd побеждает (Истина), несмотря на ibcmd=false в настройках
	Исполнитель.ОжидаемЧтоВыводСодержит("ibcmd=true");
	// ibconnection из настроек
	Исполнитель.ОжидаемЧтоВыводСодержит("ibconnection=/Foverride/ib");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсполнителяEcho()
	Аргументы = Новый Массив;
	Аргументы.Добавить("debug");
	Аргументы.Добавить("echo");
	Возврат НовыйИсполнитель(Аргументы);
КонецФункции

Функция СоздатьИсполнителяResolve()
	Аргументы = Новый Массив;
	Аргументы.Добавить("debug");
	Аргументы.Добавить("resolve");
	Возврат НовыйИсполнитель(Аргументы);
КонецФункции

Функция НовыйИсполнитель(Аргументы)
	КорневойКаталогПроекта = ТекущийКаталог();
	Скрипт = ОбъединитьПути(КорневойКаталогПроекта, "tests");
	Скрипт = ОбъединитьПути(Скрипт, "e2e");
	Скрипт = ОбъединитьПути(Скрипт, "fixtures");
	Скрипт = ОбъединитьПути(Скрипт, "main-debug.os");

	Исполнитель = Новый ИсполнительCLI(Аргументы);
	Исполнитель.УстановитьСкрипт(Скрипт);
	Возврат Исполнитель;
КонецФункции

#КонецОбласти
