// Отладочная команда: выводит значения настроек, разрешённые каскадным поиском.
// Используется для тестирования механизма чтения настроек.

&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисНастроек;

&НаборОпций("НаборОпцийНастроек")
Перем ОпцииНастроек; // BSLLS:UnusedLocalVariable-off

&ПодкомандаПриложения(Имя = "echo", Родитель = "КомандаDebug", Описание = "Вывести разрешённые настройки")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	ПутьКоманды = Новый Массив;
	ПутьКоманды.Добавить("debug");
	ПутьКоманды.Добавить("echo");

	Сообщить("src=" + ПредставлениеЗначения(СервисНастроек.Разрешить("src", ПутьКоманды, "")));
	Сообщить("ibcmd=" + ПредставлениеЗначения(СервисНастроек.Разрешить("ibcmd", ПутьКоманды, "")));
	Сообщить("ibconnection=" + ПредставлениеЗначения(СервисНастроек.Разрешить("ibconnection", ПутьКоманды, "")));
	Сообщить("v8version=" + ПредставлениеЗначения(СервисНастроек.Разрешить("v8version", ПутьКоманды, "")));
	Сообщить("db-user=" + ПредставлениеЗначения(СервисНастроек.Разрешить("db-user", ПутьКоманды, "")));

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Функция ПредставлениеЗначения(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Формат(Значение, "БЛ=false; БИ=true");
	КонецЕсли;

	Возврат Строка(Значение);

КонецФункции

#КонецОбласти
