// BSLLS:MissingVariablesDescription-off
// Отладочная команда: выводит значения опций с учётом CLI-аргументов и настроек.
// CLI-аргументы имеют приоритет; пустые заполняются из каскадных настроек.

&Лог("vrunner")
Перем Лог; // BSLLS:UnusedLocalVariable-off

&Пластилин
Перем СервисНастроек;

&НаборОпций("НаборОпцийНастроек")
Перем ОпцииНастроек; // BSLLS:UnusedLocalVariable-off

&Опция(Имя = "s src", Описание = "Каталог исходников")
&ТСтрока
Перем КаталогИсходников;

&Опция(Имя = "ibconnection", Описание = "Строка подключения к информационной базе")
&ТСтрока
Перем СтрокаПодключения;

&Опция(Имя = "v8version", Описание = "Версия платформы 1С")
&ТСтрока
Перем ВерсияПлатформы;

&Опция(Имя = "ibcmd", Описание = "Использовать ibcmd")
&Флаговый
Перем ИспользоватьIbcmd;

&ПодкомандаПриложения(Имя = "resolve", Родитель = "КомандаDebug", Описание = "Вывести опции с разрешением из настроек")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	ПутьКоманды = Новый Массив;
	ПутьКоманды.Добавить("debug");
	ПутьКоманды.Добавить("resolve");

	// Строковые опции: если не заданы через CLI - берём из настроек
	Если НЕ ЗначениеЗаполнено(КаталогИсходников) Тогда
		КаталогИсходников = СервисНастроек.Разрешить("src", ПутьКоманды, "");
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(СтрокаПодключения) Тогда
		СтрокаПодключения = СервисНастроек.Разрешить("ibconnection", ПутьКоманды, "");
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ВерсияПлатформы) Тогда
		ВерсияПлатформы = СервисНастроек.Разрешить("v8version", ПутьКоманды, "");
	КонецЕсли;

	// Булевы флаги: если не переданы через CLI - берём из настроек
	Если НЕ ИспользоватьIbcmd = Истина Тогда
		РезультатНастройки = СервисНастроек.Разрешить("ibcmd", ПутьКоманды, Ложь);
		ИспользоватьIbcmd = РезультатНастройки = Истина;
	КонецЕсли;

	Сообщить("src=" + КаталогИсходников);
	Сообщить("ibconnection=" + СтрокаПодключения);
	Сообщить("v8version=" + ВерсияПлатформы);

	Если ИспользоватьIbcmd = Истина Тогда
		Сообщить("ibcmd=true");
	Иначе
		Сообщить("ibcmd=false");
	КонецЕсли;

КонецПроцедуры
