// BSLLS-off
// Тестовый набор: validate edt
// Тесты заглушки команды validate edt.

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands
#Использовать "../../utils"

Перем НакопленныеВременныеФайлы;

#Область СлужебныйПрограммныйИнтерфейс

// EDT-команда должна вернуть ошибку (команда ещё не реализована).
&Тест
Процедура ТестДолжен_ВернутьОшибкуНеРеализовано() Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителя();

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(1, "validate edt - команда не реализована");
	Исполнитель.ОжидаемЧтоВыводСодержит("не реализована");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсполнителя()
	Аргументы = Новый Массив;
	Аргументы.Добавить("validate");
	Аргументы.Добавить("edt");
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

#КонецОбласти
