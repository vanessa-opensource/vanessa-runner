// BSLLS-off
// Тестовый набор: validate syntax-check
// Интеграционные тесты проверки синтаксиса конфигурации.
//
// Тесты запускают реальную CLI-команду `vrunner validate syntax-check` через подпроцесс.
// Для проверки создаётся файловая база с загруженной конфигурацией из фикстур.
//
// Фикстуры: tests/e2e/fixtures/cf/ - XML-исходники конфигурации

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands
#Использовать v8runner
#Использовать "../../utils"

Перем НакопленныеВременныеФайлы;
Перем КаталогБазы;

#Область СлужебныйПрограммныйИнтерфейс

// Проверка синтаксиса конфигурации с режимами по умолчанию.
// Фикстура - минимальная конфигурация без ошибок, проверка должна пройти.
// Цель не задана, значит проверяется всё: и конфигурация, и все расширения
// (та же семантика --target, что у infobase update).
&Тест
Процедура ТестДолжен_ПроверитьСинтаксисКонфигурацииУспешно() Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения());

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "проверка синтаксиса конфигурации");
	Исполнитель.ОжидаемЧтоВыводСодержит("Проверка конфигурации завершена");
	Исполнитель.ОжидаемЧтоВыводСодержит("основная конфигурация");
	Исполнитель.ОжидаемЧтоВыводСодержит("все расширения");

КонецПроцедуры

// Проверка с конкретным режимом Server.
&Тест
Процедура ТестДолжен_ПроверитьСинтаксисВРежимеServer() Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения());
	Исполнитель.ДобавитьОпцию("--mode", "Server");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "проверка синтаксиса в режиме сервера");

КонецПроцедуры

// Проверка с несколькими режимами.
&Тест
Процедура ТестДолжен_ПроверитьСинтаксисСНесколькимиРежимами() Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения());
	Исполнитель.ДобавитьОпцию("--mode", "ThinClient");
	Исполнитель.ДобавитьОпцию("--mode", "Server");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "проверка синтаксиса с несколькими режимами");

КонецПроцедуры

// Проверка синтаксиса с генерацией JUnit-отчёта.
&Тест
Процедура ТестДолжен_СформироватьОтчетJUnit() Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения());
	Исполнитель.ДобавитьОпцию("--junitpath", "junit-syntax.xml");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "формирование JUnit-отчёта при проверке синтаксиса");
	Исполнитель.ОжидаемЧтоФайлСуществует("junit-syntax.xml");

КонецПроцедуры

// Проверка синтаксиса с именем тестового набора.
&Тест
Процедура ТестДолжен_СформироватьОтчетJUnitСИменемНабора() Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения());
	Исполнитель.ДобавитьОпцию("--junitpath", "junit-named.xml");
	Исполнитель.ДобавитьОпцию("--testsuitename", "my-suite");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "формирование JUnit-отчёта с именем тест-набора");
	Исполнитель.ОжидаемЧтоФайлСуществует("junit-named.xml");

КонецПроцедуры

// issue #746: каталог из --junitpath может не существовать (build/ в репозиториях не хранят).
// Проверка идёт минутами, поэтому падать на записи отчёта в конце недопустимо -
// каталог создаём сами.
&Тест
Процедура ТестДолжен_СоздатьКаталогОтчетаJUnit_ЕслиЕгоНет() Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения());
	Исполнитель.ДобавитьОпцию("--junitpath", "build/out/syntax-check/junit/junit.xml");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "проверка синтаксиса с отчётом в несуществующем каталоге");
	Исполнитель.ОжидаемЧтоФайлСуществует("build/out/syntax-check/junit/junit.xml");

КонецПроцедуры

// Группировка замечаний по объектам метаданных: один тест-кейс на объект,
// а не на строку лога. Опция была объявлена, но не влияла на отчёт.
&Тест
Процедура ТестДолжен_СгруппироватьЗамечанияПоМетаданным() Экспорт

	// Дано - база с заведомо некорректным модулем
	Исполнитель = СоздатьИсполнителя();
	КаталогБазыСОшибкой = СоздатьБазуСОшибкойВМодуле(Исполнитель);
	Исполнитель.ДобавитьОпцию("--ibconnection", "/F""" + КаталогБазыСОшибкой + """");
	Исполнитель.ДобавитьОпцию("--junitpath", "junit-grouped.xml");
	Исполнитель.ДобавитьФлаг("--groupbymetadata");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда - проверка нашла замечание (код 1), в отчёте тест-кейс назван объектом метаданных
	Исполнитель.ОжидаемЧтоКодВозврата(1, "проверка синтаксиса конфигурации с замечанием");
	Исполнитель.ОжидаемЧтоФайлСуществует("junit-grouped.xml");

	Отчет = ПрочитатьОтчет(Исполнитель, "junit-grouped.xml");
	Ожидаем.Что(Отчет, "тест-кейс должен быть назван объектом метаданных")
		.Содержит("name=""Справочник.Справочник1.МодульОбъекта""");

КонецПроцедуры

// --target main сужает проверку до основной конфигурации: расширения не гоняются.
&Тест
Процедура ТестДолжен_ПроверитьТолькоКонфигурацию_ПоЦелиMain() Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения());
	Исполнитель.ДобавитьОпцию("--target", "main");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "проверка синтаксиса по цели main");
	Исполнитель.ОжидаемЧтоВыводСодержит("основная конфигурация");
	Исполнитель.ОжидаемЧтоВыводНеСодержит("все расширения");

КонецПроцедуры

// Несуществующее расширение: платформа отказывается выполнять проверку,
// команда не должна выдать зелёный отчёт по непроверенной цели.
&Тест
Процедура ТестДолжен_УпастьНаНеизвестномРасширении() Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения());
	Исполнитель.ДобавитьОпцию("--target", "НетТакогоРасширения");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(1, "проверка по неизвестному расширению");
	Исполнитель.ОжидаемЧтоВыводСодержит("расширение конфигурации с указанным именем не найдено");

КонецПроцедуры

// Проверка без явной базы - должна создать временную.
&Тест
Процедура ТестДолжен_ПроверитьСинтаксисБезЯвнойБазы() Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьОпцию("--mode", "Server");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "проверка синтаксиса без явно указанной базы");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
	КаталогБазы = СоздатьБазуСКонфигурацией();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсполнителя()
	Аргументы = Новый Массив;
	Аргументы.Добавить("validate");
	Аргументы.Добавить("syntax-check");
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

Функция СоздатьБазуСКонфигурацией()
	Каталог = ФикстурнаяФайловаяБД.СкопироватьВоВременнойКаталог();
	КаталогSrc = СоздатьИсполнителя().ПутьФикстуры("cf");
	Конфигуратор = Новый УправлениеКонфигуратором;
	Конфигуратор.УстановитьКонтекст("/F""" + Каталог + """", "", "");
	Конфигуратор.ЗагрузитьКонфигурациюИзФайлов(КаталогSrc);
	Возврат Каталог;
КонецФункции

Функция СтрокаПодключения()
	Возврат "/F""" + КаталогБазы + """";
КонецФункции

// Собрать базу, в модуле объекта которой есть заведомое замечание синтакс-контроля.
Функция СоздатьБазуСОшибкойВМодуле(Исполнитель)

	КаталогSrc = Исполнитель.ПутьФикстуры("cf");

	// Фикстура копируется под каждого исполнителя, поэтому портим копию, а не общий каталог.
	// ConfigDumpInfo.xml убираем, иначе конфигуратор не заметит правку модуля.
	ФайлИнформацииОВыгрузке = Новый Файл(ОбъединитьПути(КаталогSrc, "ConfigDumpInfo.xml"));
	Если ФайлИнформацииОВыгрузке.Существует() Тогда
		УдалитьФайлы(ФайлИнформацииОВыгрузке.ПолноеИмя);
	КонецЕсли;

	ПутьМодуля = ОбъединитьПути(КаталогSrc, "Catalogs", "Справочник1");
	ПутьМодуля = ОбъединитьПути(ПутьМодуля, "Ext", "ObjectModule.bsl");

	Чтение = Новый ЧтениеТекста(ПутьМодуля, КодировкаТекста.UTF8);
	ТекстМодуля = Чтение.Прочитать();
	Чтение.Закрыть();

	Запись = Новый ЗаписьТекста(ПутьМодуля, КодировкаТекста.UTF8);
	Запись.ЗаписатьСтроку(ТекстМодуля);
	Запись.ЗаписатьСтроку("Процедура ПроцедураПослеТелаМодуля() Экспорт");
	Запись.ЗаписатьСтроку("КонецПроцедуры");
	Запись.Закрыть();

	Каталог = ФикстурнаяФайловаяБД.СкопироватьВоВременнойКаталог();
	Конфигуратор = Новый УправлениеКонфигуратором;
	Конфигуратор.УстановитьКонтекст("/F""" + Каталог + """", "", "");
	Конфигуратор.ЗагрузитьКонфигурациюИзФайлов(КаталогSrc);

	Возврат Каталог;

КонецФункции

Функция ПрочитатьОтчет(Исполнитель, ИмяФайла)

	Чтение = Новый ЧтениеТекста(ОбъединитьПути(Исполнитель.КаталогРаботы(), ИмяФайла), КодировкаТекста.UTF8);
	Содержимое = Чтение.Прочитать();
	Чтение.Закрыть();

	Возврат Содержимое;

КонецФункции

#КонецОбласти
