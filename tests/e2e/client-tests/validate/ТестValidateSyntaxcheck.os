// BSLLS-off
// Тестовый набор: validate syntax-check
// Интеграционные тесты проверки синтаксиса конфигурации.
//
// Тесты запускают реальную CLI-команду `vrunner validate syntax-check` через подпроцесс.
// Для проверки создаётся файловая база с загруженной конфигурацией из фикстур.
//
// Фикстуры: tests/e2e/fixtures/cf/ - XML-исходники конфигурации

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands
#Использовать v8runner
#Использовать "../../utils"

Перем НакопленныеВременныеФайлы;
Перем КаталогБазы;

#Область СлужебныйПрограммныйИнтерфейс

// Проверка синтаксиса конфигурации с режимами по умолчанию.
// Фикстура - минимальная конфигурация без ошибок, проверка должна пройти.
&Тест
Процедура ТестДолжен_ПроверитьСинтаксисКонфигурацииУспешно() Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения());

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "проверка синтаксиса конфигурации");
	Исполнитель.ОжидаемЧтоВыводСодержит("Проверка конфигурации завершена");

КонецПроцедуры

// Проверка с конкретным режимом Server.
&Тест
Процедура ТестДолжен_ПроверитьСинтаксисВРежимеServer() Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения());
	Исполнитель.ДобавитьОпцию("--mode", "Server");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "проверка синтаксиса в режиме сервера");

КонецПроцедуры

// Проверка с несколькими режимами.
&Тест
Процедура ТестДолжен_ПроверитьСинтаксисСНесколькимиРежимами() Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения());
	Исполнитель.ДобавитьОпцию("--mode", "ThinClient");
	Исполнитель.ДобавитьОпцию("--mode", "Server");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "проверка синтаксиса с несколькими режимами");

КонецПроцедуры

// Проверка синтаксиса с генерацией JUnit-отчёта.
&Тест
Процедура ТестДолжен_СформироватьОтчетJUnit() Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения());
	Исполнитель.ДобавитьОпцию("--junitpath", "junit-syntax.xml");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "формирование JUnit-отчёта при проверке синтаксиса");
	Исполнитель.ОжидаемЧтоФайлСуществует("junit-syntax.xml");

КонецПроцедуры

// Проверка синтаксиса с именем тестового набора.
&Тест
Процедура ТестДолжен_СформироватьОтчетJUnitСИменемНабора() Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения());
	Исполнитель.ДобавитьОпцию("--junitpath", "junit-named.xml");
	Исполнитель.ДобавитьОпцию("--testsuitename", "my-suite");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "формирование JUnit-отчёта с именем тест-набора");
	Исполнитель.ОжидаемЧтоФайлСуществует("junit-named.xml");

КонецПроцедуры

// Проверка без явной базы - должна создать временную.
&Тест
Процедура ТестДолжен_ПроверитьСинтаксисБезЯвнойБазы() Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьОпцию("--mode", "Server");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "проверка синтаксиса без явно указанной базы");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
	КаталогБазы = СоздатьБазуСКонфигурацией();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсполнителя()
	Аргументы = Новый Массив;
	Аргументы.Добавить("validate");
	Аргументы.Добавить("syntax-check");
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

Функция СоздатьБазуСКонфигурацией()
	Каталог = ВременныеФайлы.СоздатьКаталог();
	Конфигуратор = Новый УправлениеКонфигуратором;
	Конфигуратор.СоздатьФайловуюБазу(Каталог);
	КаталогSrc = СоздатьИсполнителя().ПутьФикстуры("cf");
	Конфигуратор.УстановитьКонтекст("/F""" + Каталог + """", "", "");
	Конфигуратор.ЗагрузитьКонфигурациюИзФайлов(КаталогSrc);
	Возврат Каталог;
КонецФункции

Функция СтрокаПодключения()
	Возврат "/F""" + КаталогБазы + """";
КонецФункции

#КонецОбласти
