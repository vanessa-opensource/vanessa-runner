// BSLLS-off
// Тестовый набор: validate edt - ошибки источника --src до запуска платформы и 1С:EDT.
// Проверка самих файлов *.cf/*.cfe требует EDT и живёт в tests/e2e/edt-tests/validate.

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands
#Использовать "../../utils"

Перем НакопленныеВременныеФайлы;

#Область СлужебныйПрограммныйИнтерфейс

// Несуществующий файл *.cf отклоняется до создания временной базы.
&Тест
Процедура ТестДолжен_УпастьНаНесуществующемФайлеCf() Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьОпцию("--src", "нет-такого.cf");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(1, "validate edt с несуществующим файлом cf");
	Исполнитель.ОжидаемЧтоВыводСодержит("Файл источника не найден");

КонецПроцедуры

// Выгрузка ИБ (*.dt) - не источник исходников.
&Тест
Процедура ТестДолжен_УпастьНаВыгрузкеDt() Экспорт

	// Дано
	ПутьDt = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "base.dt");
	Запись = Новый ЗаписьТекста(ПутьDt);
	Запись.Закрыть();
	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьОпцию("--src", ПутьDt);

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(1, "validate edt с выгрузкой dt");
	Исполнитель.ОжидаемЧтоВыводСодержит("не поддерживается как источник исходников");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсполнителя()
	Аргументы = Новый Массив;
	Аргументы.Добавить("validate");
	Аргументы.Добавить("edt");
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

#КонецОбласти
