// BSLLS-off
// Тестовый набор: repo lock / unlock
// Интеграционные тесты операций захвата и отпускания объектов в хранилище.
//
// Каждый тест создаёт хранилище с подключённой базой, выполняет операцию.
// Фикстуры: tests/e2e/fixtures/cf/ - XML-исходники конфигурации

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands
#Использовать v8runner
#Использовать "../../utils"

Перем НакопленныеВременныеФайлы;
Перем КаталогБазы;
Перем КаталогХранилища;
Перем СтрокаПодключения;
Перем ОбщийРабочийКаталог;

#Область СлужебныйПрограммныйИнтерфейс

&Тест
Процедура ТестДолжен_ЗахватитьОбъектыВХранилище() Экспорт

	// Дано
	СоздатьХранилищеСПодключённойБазой();

	// Когда - захватываем все объекты
	Исполнитель = СоздатьИсполнителяRepo("lock");
	Исполнитель.УстановитьКаталогРаботы(ОбщийРабочийКаталог);
	Исполнитель.ДобавитьОпцию("--storage-name", КаталогХранилища);
	Исполнитель.ДобавитьОпцию("--storage-user", "Администратор");
	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "захват объектов в хранилище конфигурации");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗахватитьИОтпуститьОбъекты() Экспорт

	// Дано
	СоздатьХранилищеСПодключённойБазой();

	// Захватываем объекты
	ИсполнительLock = СоздатьИсполнителяRepo("lock");
	ИсполнительLock.УстановитьКаталогРаботы(ОбщийРабочийКаталог);
	ИсполнительLock.ДобавитьОпцию("--storage-name", КаталогХранилища);
	ИсполнительLock.ДобавитьОпцию("--storage-user", "Администратор");
	ИсполнительLock.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	ИсполнительLock.ВыполнитьКоманду();
	ИсполнительLock.ОжидаемЧтоКодВозврата(0, "захват объектов в хранилище");

	// Когда - отпускаем объекты
	ИсполнительUnlock = СоздатьИсполнителяRepo("unlock");
	ИсполнительUnlock.УстановитьКаталогРаботы(ОбщийРабочийКаталог);
	ИсполнительUnlock.ДобавитьОпцию("--storage-name", КаталогХранилища);
	ИсполнительUnlock.ДобавитьОпцию("--storage-user", "Администратор");
	ИсполнительUnlock.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	ИсполнительUnlock.ВыполнитьКоманду();

	// Тогда
	ИсполнительUnlock.ОжидаемЧтоКодВозврата(0, "освобождение объектов в хранилище");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтпуститьОбъектыСФлагомForce() Экспорт

	// Дано
	СоздатьХранилищеСПодключённойБазой();

	// Захватываем объекты
	ИсполнительLock = СоздатьИсполнителяRepo("lock");
	ИсполнительLock.УстановитьКаталогРаботы(ОбщийРабочийКаталог);
	ИсполнительLock.ДобавитьОпцию("--storage-name", КаталогХранилища);
	ИсполнительLock.ДобавитьОпцию("--storage-user", "Администратор");
	ИсполнительLock.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	ИсполнительLock.ВыполнитьКоманду();
	ИсполнительLock.ОжидаемЧтоКодВозврата(0, "захват объектов в хранилище");

	// Когда - отпускаем с игнорированием локальных изменений
	ИсполнительUnlock = СоздатьИсполнителяRepo("unlock");
	ИсполнительUnlock.УстановитьКаталогРаботы(ОбщийРабочийКаталог);
	ИсполнительUnlock.ДобавитьОпцию("--storage-name", КаталогХранилища);
	ИсполнительUnlock.ДобавитьОпцию("--storage-user", "Администратор");
	ИсполнительUnlock.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	ИсполнительUnlock.ДобавитьФлаг("--force");
	ИсполнительUnlock.ВыполнитьКоманду();

	// Тогда
	ИсполнительUnlock.ОжидаемЧтоКодВозврата(0, "освобождение объектов в хранилище");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПоместитьИзмененияВХранилище() Экспорт

	// Дано
	СоздатьХранилищеСПодключённойБазой();

	// Захватываем объекты перед помещением
	ИсполнительLock = СоздатьИсполнителяRepo("lock");
	ИсполнительLock.УстановитьКаталогРаботы(ОбщийРабочийКаталог);
	ИсполнительLock.ДобавитьОпцию("--storage-name", КаталогХранилища);
	ИсполнительLock.ДобавитьОпцию("--storage-user", "Администратор");
	ИсполнительLock.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	ИсполнительLock.ВыполнитьКоманду();
	ИсполнительLock.ОжидаемЧтоКодВозврата(0, "захват объектов в хранилище");

	// Когда - помещаем изменения
	Исполнитель = СоздатьИсполнителяRepo("commit");
	Исполнитель.УстановитьКаталогРаботы(ОбщийРабочийКаталог);
	Исполнитель.ДобавитьОпцию("--storage-name", КаталогХранилища);
	Исполнитель.ДобавитьОпцию("--storage-user", "Администратор");
	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Исполнитель.ДобавитьОпцию("--comment", "тест");
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "помещение изменений в хранилище");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПоместитьИзмененияСФлагомKeepLocked() Экспорт

	// Дано
	СоздатьХранилищеСПодключённойБазой();

	// Захватываем объекты перед помещением
	ИсполнительLock = СоздатьИсполнителяRepo("lock");
	ИсполнительLock.УстановитьКаталогРаботы(ОбщийРабочийКаталог);
	ИсполнительLock.ДобавитьОпцию("--storage-name", КаталогХранилища);
	ИсполнительLock.ДобавитьОпцию("--storage-user", "Администратор");
	ИсполнительLock.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	ИсполнительLock.ВыполнитьКоманду();
	ИсполнительLock.ОжидаемЧтоКодВозврата(0, "захват объектов в хранилище");

	// Когда - помещаем с сохранением захвата
	Исполнитель = СоздатьИсполнителяRepo("commit");
	Исполнитель.УстановитьКаталогРаботы(ОбщийРабочийКаталог);
	Исполнитель.ДобавитьОпцию("--storage-name", КаталогХранилища);
	Исполнитель.ДобавитьОпцию("--storage-user", "Администратор");
	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Исполнитель.ДобавитьФлаг("--keep-locked");
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "помещение изменений с сохранением захвата");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗахватитьОбъектыСФлагомRevised() Экспорт

	// Дано
	СоздатьХранилищеСПодключённойБазой();

	// Когда - захватываем с получением захваченных объектов
	Исполнитель = СоздатьИсполнителяRepo("lock");
	Исполнитель.УстановитьКаталогРаботы(ОбщийРабочийКаталог);
	Исполнитель.ДобавитьОпцию("--storage-name", КаталогХранилища);
	Исполнитель.ДобавитьОпцию("--storage-user", "Администратор");
	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Исполнитель.ДобавитьФлаг("--revised");
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "захват объектов с флагом --revised");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СоздатьХранилищеСПодключённойБазой()

	// Создаём файловую ИБ
	КаталогБазы = ВременныеФайлы.СоздатьКаталог();
	Конфигуратор = Новый УправлениеКонфигуратором;
	Конфигуратор.СоздатьФайловуюБазу(КаталогБазы);

	СтрокаПодключения = "/F""" + КаталогБазы + """";

	// Создаём хранилище
	КаталогХранилища = ВременныеФайлы.СоздатьКаталог();
	ИсполнительCreate = СоздатьИсполнителяRepo("create");
	ИсполнительCreate.ДобавитьОпцию("--storage-name", КаталогХранилища);
	ИсполнительCreate.ДобавитьОпцию("--storage-user", "Администратор");
	ИсполнительCreate.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	ИсполнительCreate.ВыполнитьКоманду();
	ИсполнительCreate.ОжидаемЧтоКодВозврата(0);

	ОбщийРабочийКаталог = ИсполнительCreate.КаталогРаботы();

	// Подключаемся к хранилищу
	ИсполнительBind = СоздатьИсполнителяRepo("bind");
	ИсполнительBind.УстановитьКаталогРаботы(ОбщийРабочийКаталог);
	ИсполнительBind.ДобавитьОпцию("--storage-name", КаталогХранилища);
	ИсполнительBind.ДобавитьОпцию("--storage-user", "Администратор");
	ИсполнительBind.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	ИсполнительBind.ВыполнитьКоманду();
	ИсполнительBind.ОжидаемЧтоКодВозврата(0);

КонецПроцедуры

Функция СоздатьИсполнителяRepo(ИмяПодкоманды)
	Аргументы = Новый Массив;
	Аргументы.Добавить("repo");
	Аргументы.Добавить(ИмяПодкоманды);
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

#КонецОбласти
