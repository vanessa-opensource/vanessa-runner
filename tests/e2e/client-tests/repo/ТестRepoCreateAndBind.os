// BSLLS-off
// Тестовый набор: repo create / bind / unbind
// Интеграционные тесты операций с хранилищем конфигурации.
//
// Тесты создают файловое хранилище, подключают/отключают БД.
// Фикстуры: tests/e2e/fixtures/cf/ — XML-исходники конфигурации

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands
#Использовать v8runner
#Использовать "../../utils"

Перем НакопленныеВременныеФайлы;
Перем КаталогБазы;
Перем КаталогХранилища;

#Область СлужебныйПрограммныйИнтерфейс

&Тест
Процедура ТестДолжен_СоздатьХранилище() Экспорт

	// Дано
	КаталогХранилища = ВременныеФайлы.СоздатьКаталог();
	Исполнитель = СоздатьИсполнителяRepo("create");
	Исполнитель.ДобавитьОпцию("--storage-name", КаталогХранилища);
	Исполнитель.ДобавитьОпцию("--storage-user", "Администратор");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "создание хранилища конфигурации");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьХранилищеИПодключитьБазу() Экспорт

	// Дано — создаём файловую ИБ
	КаталогБазы = ВременныеФайлы.СоздатьКаталог();
	Конфигуратор = Новый УправлениеКонфигуратором;
	Конфигуратор.СоздатьФайловуюБазу(КаталогБазы);

	СтрокаПодключения = "/F""" + КаталогБазы + """";

	// Создаём хранилище
	КаталогХранилища = ВременныеФайлы.СоздатьКаталог();
	ИсполнительCreate = СоздатьИсполнителяRepo("create");
	ИсполнительCreate.ДобавитьОпцию("--storage-name", КаталогХранилища);
	ИсполнительCreate.ДобавитьОпцию("--storage-user", "Администратор");
	ИсполнительCreate.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	ИсполнительCreate.ВыполнитьКоманду();
	ИсполнительCreate.ОжидаемЧтоКодВозврата(0, "создание хранилища конфигурации (подготовка)");

	// Подключаем к хранилищу
	ИсполнительBind = СоздатьИсполнителяRepo("bind");
	ИсполнительBind.УстановитьКаталогРаботы(ИсполнительCreate.КаталогРаботы());
	ИсполнительBind.ДобавитьОпцию("--storage-name", КаталогХранилища);
	ИсполнительBind.ДобавитьОпцию("--storage-user", "Администратор");
	ИсполнительBind.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	ИсполнительBind.ВыполнитьКоманду();

	// Тогда
	ИсполнительBind.ОжидаемЧтоКодВозврата(0, "подключение базы к хранилищу");

	// Отключаемся от хранилища
	ИсполнительUnbind = СоздатьИсполнителяRepo("unbind");
	ИсполнительUnbind.УстановитьКаталогРаботы(ИсполнительCreate.КаталогРаботы());
	ИсполнительUnbind.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	ИсполнительUnbind.ВыполнитьКоманду();

	// Тогда
	ИсполнительUnbind.ОжидаемЧтоКодВозврата(0, "отвязка базы от хранилища");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьХранилищеИВыгрузитьCf() Экспорт

	// Дано — создаём файловую ИБ
	КаталогБазы = ВременныеФайлы.СоздатьКаталог();
	Конфигуратор = Новый УправлениеКонфигуратором;
	Конфигуратор.СоздатьФайловуюБазу(КаталогБазы);

	// Создаём хранилище с привязкой базы
	КаталогХранилища = ВременныеФайлы.СоздатьКаталог();
	ИсполнительCreate = СоздатьИсполнителяRepo("create");
	ИсполнительCreate.ДобавитьОпцию("--storage-name", КаталогХранилища);
	ИсполнительCreate.ДобавитьОпцию("--storage-user", "Администратор");
	СтрокаПодключения = "/F""" + КаталогБазы + """";
	ИсполнительCreate.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	ИсполнительCreate.ВыполнитьКоманду();
	ИсполнительCreate.ОжидаемЧтоКодВозврата(0, "создание хранилища конфигурации (подготовка)");

	// Выгружаем cf из хранилища
	ИсполнительSave = СоздатьИсполнителяRepo("save-cf");
	ИсполнительSave.УстановитьКаталогРаботы(ИсполнительCreate.КаталогРаботы());
	ИсполнительSave.ДобавитьОпцию("--storage-name", КаталогХранилища);
	ИсполнительSave.ДобавитьОпцию("--storage-user", "Администратор");
	ИсполнительSave.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	ИсполнительSave.ДобавитьАргумент("repo-config.cf");
	ИсполнительSave.ВыполнитьКоманду();

	// Тогда
	ИсполнительSave.ОжидаемЧтоКодВозврата(0, "сохранение конфигурации в хранилище");
	ИсполнительSave.ОжидаемЧтоФайлСуществует("repo-config.cf");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсполнителяRepo(ИмяПодкоманды)
	Аргументы = Новый Массив;
	Аргументы.Добавить("repo");
	Аргументы.Добавить(ИмяПодкоманды);
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

#КонецОбласти
