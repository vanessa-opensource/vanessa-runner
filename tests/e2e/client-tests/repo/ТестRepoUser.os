// BSLLS-off
// Тестовый набор: repo create-user / copy-user
// Интеграционные тесты операций с пользователями хранилища конфигурации.
//
// Тесты создают хранилище, добавляют пользователей, копируют между хранилищами.
// Фикстуры: tests/e2e/fixtures/cf/ — XML-исходники конфигурации

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands
#Использовать v8runner
#Использовать "../../utils"

Перем НакопленныеВременныеФайлы;

#Область СлужебныйПрограммныйИнтерфейс

&Тест
Процедура ТестДолжен_СоздатьПользователяХранилищаReadOnly() Экспорт

	// Дано
	КаталогХранилища = ВременныеФайлы.СоздатьКаталог();
	ИсполнительCreate = СоздатьИсполнителяRepo("create");
	ИсполнительCreate.ДобавитьОпцию("--storage-name", КаталогХранилища);
	ИсполнительCreate.ДобавитьОпцию("--storage-user", "Администратор");
	ИсполнительCreate.ВыполнитьКоманду();
	ИсполнительCreate.ОжидаемЧтоКодВозврата(0, "создание хранилища конфигурации (подготовка)");

	// Когда — создаём пользователя с ролью ReadOnly
	Исполнитель = СоздатьИсполнителяRepo("create-user");
	Исполнитель.УстановитьКаталогРаботы(ИсполнительCreate.КаталогРаботы());
	Исполнитель.ДобавитьОпцию("--storage-name", КаталогХранилища);
	Исполнитель.ДобавитьОпцию("--storage-user", "Администратор");
	Исполнитель.ДобавитьОпцию("--new-user-name", "Читатель");
	Исполнитель.ДобавитьОпцию("--new-user-pwd", "password123");
	Исполнитель.ДобавитьОпцию("--new-user-role", "ReadOnly");
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "создание пользователя хранилища только для чтения");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьПользователяСПравомЗахвата() Экспорт

	// Дано
	КаталогХранилища = ВременныеФайлы.СоздатьКаталог();
	ИсполнительCreate = СоздатьИсполнителяRepo("create");
	ИсполнительCreate.ДобавитьОпцию("--storage-name", КаталогХранилища);
	ИсполнительCreate.ДобавитьОпцию("--storage-user", "Администратор");
	ИсполнительCreate.ВыполнитьКоманду();
	ИсполнительCreate.ОжидаемЧтоКодВозврата(0, "создание хранилища конфигурации (подготовка)");

	// Когда — создаём пользователя с ролью LockObjects
	Исполнитель = СоздатьИсполнителяRepo("create-user");
	Исполнитель.УстановитьКаталогРаботы(ИсполнительCreate.КаталогРаботы());
	Исполнитель.ДобавитьОпцию("--storage-name", КаталогХранилища);
	Исполнитель.ДобавитьОпцию("--storage-user", "Администратор");
	Исполнитель.ДобавитьОпцию("--new-user-name", "Разработчик");
	Исполнитель.ДобавитьОпцию("--new-user-pwd", "dev123");
	Исполнитель.ДобавитьОпцию("--new-user-role", "LockObjects");
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "создание пользователя с правом захвата");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьПользователяАдминистратора() Экспорт

	// Дано
	КаталогХранилища = ВременныеФайлы.СоздатьКаталог();
	ИсполнительCreate = СоздатьИсполнителяRepo("create");
	ИсполнительCreate.ДобавитьОпцию("--storage-name", КаталогХранилища);
	ИсполнительCreate.ДобавитьОпцию("--storage-user", "Администратор");
	ИсполнительCreate.ВыполнитьКоманду();
	ИсполнительCreate.ОжидаемЧтоКодВозврата(0, "создание хранилища конфигурации (подготовка)");

	// Когда — создаём пользователя с ролью Administration
	Исполнитель = СоздатьИсполнителяRepo("create-user");
	Исполнитель.УстановитьКаталогРаботы(ИсполнительCreate.КаталогРаботы());
	Исполнитель.ДобавитьОпцию("--storage-name", КаталогХранилища);
	Исполнитель.ДобавитьОпцию("--storage-user", "Администратор");
	Исполнитель.ДобавитьОпцию("--new-user-name", "Админ");
	Исполнитель.ДобавитьОпцию("--new-user-pwd", "admin123");
	Исполнитель.ДобавитьОпцию("--new-user-role", "Administration");
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "создание пользователя-администратора хранилища");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьПользователяБезРоли() Экспорт

	// Дано
	КаталогХранилища = ВременныеФайлы.СоздатьКаталог();
	ИсполнительCreate = СоздатьИсполнителяRepo("create");
	ИсполнительCreate.ДобавитьОпцию("--storage-name", КаталогХранилища);
	ИсполнительCreate.ДобавитьОпцию("--storage-user", "Администратор");
	ИсполнительCreate.ВыполнитьКоманду();
	ИсполнительCreate.ОжидаемЧтоКодВозврата(0, "создание хранилища конфигурации (подготовка)");

	// Когда — создаём пользователя без указания роли
	Исполнитель = СоздатьИсполнителяRepo("create-user");
	Исполнитель.УстановитьКаталогРаботы(ИсполнительCreate.КаталогРаботы());
	Исполнитель.ДобавитьОпцию("--storage-name", КаталогХранилища);
	Исполнитель.ДобавитьОпцию("--storage-user", "Администратор");
	Исполнитель.ДобавитьОпцию("--new-user-name", "Пользователь");
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "создание пользователя без роли");

КонецПроцедуры

&Тест
Процедура ТестДолжен_КопироватьПользователейИзДругогоХранилища() Экспорт

	// Дано — создаём хранилище-источник с пользователем
	КаталогХранилищаИсточника = ВременныеФайлы.СоздатьКаталог();
	ИсполнительCreate1 = СоздатьИсполнителяRepo("create");
	ИсполнительCreate1.ДобавитьОпцию("--storage-name", КаталогХранилищаИсточника);
	ИсполнительCreate1.ДобавитьОпцию("--storage-user", "Администратор");
	ИсполнительCreate1.ВыполнитьКоманду();
	ИсполнительCreate1.ОжидаемЧтоКодВозврата(0, "создание первого хранилища (подготовка)");

	// Создаём пользователя в источнике
	ИсполнительUser = СоздатьИсполнителяRepo("create-user");
	ИсполнительUser.УстановитьКаталогРаботы(ИсполнительCreate1.КаталогРаботы());
	ИсполнительUser.ДобавитьОпцию("--storage-name", КаталогХранилищаИсточника);
	ИсполнительUser.ДобавитьОпцию("--storage-user", "Администратор");
	ИсполнительUser.ДобавитьОпцию("--new-user-name", "Копируемый");
	ИсполнительUser.ДобавитьОпцию("--new-user-pwd", "pass123");
	ИсполнительUser.ДобавитьОпцию("--new-user-role", "LockObjects");
	ИсполнительUser.ВыполнитьКоманду();
	ИсполнительUser.ОжидаемЧтоКодВозврата(0, "создание пользователя хранилища");

	// Создаём хранилище-приёмник
	КаталогХранилищаПриёмника = ВременныеФайлы.СоздатьКаталог();
	ИсполнительCreate2 = СоздатьИсполнителяRepo("create");
	ИсполнительCreate2.УстановитьКаталогРаботы(ИсполнительCreate1.КаталогРаботы());
	ИсполнительCreate2.ДобавитьОпцию("--storage-name", КаталогХранилищаПриёмника);
	ИсполнительCreate2.ДобавитьОпцию("--storage-user", "Администратор");
	ИсполнительCreate2.ВыполнитьКоманду();
	ИсполнительCreate2.ОжидаемЧтоКодВозврата(0, "создание второго хранилища (подготовка)");

	// Когда — копируем пользователей из источника в приёмник
	Исполнитель = СоздатьИсполнителяRepo("copy-user");
	Исполнитель.УстановитьКаталогРаботы(ИсполнительCreate1.КаталогРаботы());
	Исполнитель.ДобавитьОпцию("--storage-name", КаталогХранилищаПриёмника);
	Исполнитель.ДобавитьОпцию("--storage-user", "Администратор");
	Исполнитель.ДобавитьОпцию("--source-storage-name", КаталогХранилищаИсточника);
	Исполнитель.ДобавитьОпцию("--source-storage-user", "Администратор");
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "копирование пользователей из другого хранилища");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсполнителяRepo(ИмяПодкоманды)
	Аргументы = Новый Массив;
	Аргументы.Добавить("repo");
	Аргументы.Добавить(ИмяПодкоманды);
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

#КонецОбласти
