// BSLLS-off
// Тестовый набор: test vanessa
// Интеграционные тесты запуска BDD-тестирования через Vanessa-ADD.
//
// Тесты запускают реальную CLI-команду `vrunner test vanessa` через подпроцесс.
//
// Аналог легаси-тестов ТестДолжен_ВыполнитьФичуПаузаIbsrv и ТестДолжен_ВыполнитьНереализованнуюФичуIbsrv.
// Вместо проверки "Все фичи/сценарии выполнены!" (in-process лог) проверяем:
//   - buildstatus.log, который Vanessa-ADD пишет при ВыгружатьСтатусВыполненияСценариевВФайл = Истина
//   - код возврата 0
//
// Фикстуры: tests/e2e/fixtures/vanessa/ - фича-файлы и настройки

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands
#Использовать "../../utils"

Перем НакопленныеВременныеФайлы;

#Область СлужебныйПрограммныйИнтерфейс

// Проверка справки команды - содержит все обязательные опции.
&Тест
Процедура ТестДолжен_ВывестиСправкуСОпциямиVanessa() Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьФлаг("--help");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "вывод справки vrunner test vanessa --help");
	Исполнитель.ОжидаемЧтоВыводСодержит("vanessa");
	Исполнитель.ОжидаемЧтоВыводСодержит("--feature-path");
	Исполнитель.ОжидаемЧтоВыводСодержит("--bddrunner-path");
	Исполнитель.ОжидаемЧтоВыводСодержит("--vanessasettings");
	Исполнитель.ОжидаемЧтоВыводСодержит("--workspace");
	Исполнитель.ОжидаемЧтоВыводСодержит("--tags-ignore");
	Исполнитель.ОжидаемЧтоВыводСодержит("--tags-filter");
	Исполнитель.ОжидаемЧтоВыводСодержит("--additional-keys");
	Исполнитель.ОжидаемЧтоВыводСодержит("--no-wait");

КонецПроцедуры

// Общие опции подключения и платформы доступны.
&Тест
Процедура ТестДолжен_ПоддерживатьОпцииПодключенияИПлатформы() Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьФлаг("--help");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "наличие опций подключения и платформы в справке");
	Исполнитель.ОжидаемЧтоВыводСодержит("--ibconnection");
	Исполнитель.ОжидаемЧтоВыводСодержит("--db-user");
	Исполнитель.ОжидаемЧтоВыводСодержит("--db-pwd");
	Исполнитель.ОжидаемЧтоВыводСодержит("--v8version");
	Исполнитель.ОжидаемЧтоВыводСодержит("--ordinaryapp");
	Исполнитель.ОжидаемЧтоВыводСодержит("--additional");

КонецПроцедуры

// Запуск vanessa BDD с фичей-паузой: аналог ТестДолжен_ВыполнитьФичуПаузаIbsrv.
// Vanessa-ADD должна выполнить пауза.feature и записать buildstatus.log = 0.
&Тест
&Тег("integration")
Процедура ТестДолжен_ВыполнитьФичуПаузы() Экспорт

	// Дано
	КаталогБазы = ФикстурнаяФайловаяБД.СкопироватьВоВременнойКаталог();
	ИнициализироватьИБСКонфигурацией(КаталогБазы);

	Исполнитель = СоздатьИсполнителя();
	ПутьФич = Исполнитель.ПутьФикстуры("vanessa", "features");
	ПутьНастроек = СоздатьVbParams(Исполнитель.КаталогРаботы(), ПутьФич);
	СтрокаПодключения = "/F""" + КаталогБазы + """";

	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Исполнитель.ДобавитьОпцию("--feature-path", ПутьФич);
	Исполнитель.ДобавитьОпцию("--vanessasettings", ПутьНастроек);
	Исполнитель.ДобавитьОпцию("--workspace", Исполнитель.КаталогРаботы());
	Исполнитель.ДобавитьОпцию("--bddrunner-path", Исполнитель.НайтиEpfADD("bddRunner.epf"));

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда - аналог "Все фичи/сценарии выполнены!" в легаси
	Исполнитель.ОжидаемЧтоКодВозврата(0, "выполнение BDD-фичи с командой паузы");
	Исполнитель.ОжидаемЧтоВыводСодержит("Тестирование поведения завершено");

	// Vanessa-ADD пишет buildstatus.log при ВыгружатьСтатусВыполненияСценариевВФайл=Истина
	ПутьСтатуса = ОбъединитьПути(Исполнитель.КаталогРаботы(), "buildstatus.log");
	ФайлСтатуса = Новый Файл(ПутьСтатуса);
	Ожидаем.Что(ФайлСтатуса.Существует(), "Vanessa-ADD должна создать buildstatus.log").ЭтоИстина();

	ЧтениеТекста = Новый ЧтениеТекста(ПутьСтатуса, "UTF-8");
	Статус = СокрЛП(ЧтениеТекста.Прочитать());
	ЧтениеТекста.Закрыть();
	Ожидаем.Что(Статус, "buildstatus.log должен содержать 0 - все сценарии прошли").Равно("0");

КонецПроцедуры

// Запуск vanessa BDD с фильтром тегов: аналог ТестДолжен_ВыполнитьФичуПаузаIbsrv с @smoke.
// При --tags-ignore @skip Vanessa-ADD должна пройти все не-skip сценарии.
&Тест
&Тег("integration")
Процедура ТестДолжен_ВыполнитьФичуСПутемКVanessaПоУмолчанию() Экспорт

	// Дано
	КаталогБазы = ФикстурнаяФайловаяБД.СкопироватьВоВременнойКаталог();
	ИнициализироватьИБСКонфигурацией(КаталогБазы);

	Исполнитель = СоздатьИсполнителя();
	ПутьФич = Исполнитель.ПутьФикстуры("vanessa", "features");
	ПутьНастроек = СоздатьVbParams(Исполнитель.КаталогРаботы(), ПутьФич);
	СтрокаПодключения = "/F""" + КаталогБазы + """";

	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Исполнитель.ДобавитьОпцию("--feature-path", ПутьФич);
	Исполнитель.ДобавитьОпцию("--vanessasettings", ПутьНастроек);
	Исполнитель.ДобавитьОпцию("--workspace", Исполнитель.КаталогРаботы());

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "выполнение BDD-фичи с путём к Vanessa-ADD по умолчанию");
	Исполнитель.ОжидаемЧтоВыводСодержит("Тестирование поведения завершено");

	ПутьСтатуса = ОбъединитьПути(Исполнитель.КаталогРаботы(), "buildstatus.log");
	ФайлСтатуса = Новый Файл(ПутьСтатуса);
	Ожидаем.Что(ФайлСтатуса.Существует(), "Vanessa-ADD должна создать buildstatus.log").ЭтоИстина();

	ЧтениеТекста = Новый ЧтениеТекста(ПутьСтатуса, "UTF-8");
	Статус = СокрЛП(ЧтениеТекста.Прочитать());
	ЧтениеТекста.Закрыть();
	Ожидаем.Что(Статус, "buildstatus.log должен содержать 0 - все сценарии прошли").Равно("0");

КонецПроцедуры

// Запуск vanessa BDD с фильтром тегов: аналог ТестДолжен_ВыполнитьФичуПаузаIbsrv с @smoke.
// При --tags-ignore @skip Vanessa-ADD должна пройти все не-skip сценарии.
&Тест
&Тег("integration")
Процедура ТестДолжен_ВыполнитьФичуСФильтромТегов() Экспорт

	// Дано
	КаталогБазы = ФикстурнаяФайловаяБД.СкопироватьВоВременнойКаталог();
	ИнициализироватьИБСКонфигурацией(КаталогБазы);

	Исполнитель = СоздатьИсполнителя();
	ПутьФич = Исполнитель.ПутьФикстуры("vanessa", "features");
	ПутьНастроек = СоздатьVbParams(Исполнитель.КаталогРаботы(), ПутьФич);
	СтрокаПодключения = "/F""" + КаталогБазы + """";

	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Исполнитель.ДобавитьОпцию("--feature-path", ПутьФич);
	Исполнитель.ДобавитьОпцию("--vanessasettings", ПутьНастроек);
	Исполнитель.ДобавитьОпцию("--workspace", Исполнитель.КаталогРаботы());
	Исполнитель.ДобавитьОпцию("--bddrunner-path", Исполнитель.НайтиEpfADD("bddRunner.epf"));
	Исполнитель.ДобавитьОпцию("--tags-ignore", "@skip");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "выполнение BDD-фичи с фильтром тегов");

	ПутьСтатуса = ОбъединитьПути(Исполнитель.КаталогРаботы(), "buildstatus.log");
	ФайлСтатуса = Новый Файл(ПутьСтатуса);
	Ожидаем.Что(ФайлСтатуса.Существует(), "buildstatus.log должен быть создан Vanessa-ADD").ЭтоИстина();

	ЧтениеТекста = Новый ЧтениеТекста(ПутьСтатуса, "UTF-8");
	Статус = СокрЛП(ЧтениеТекста.Прочитать());
	ЧтениеТекста.Закрыть();
	Ожидаем.Что(Статус, "buildstatus.log должен содержать 0").Равно("0");

КонецПроцедуры

// Запуск vanessa без ожидания - 1С запущен, команда вернулась сразу.
// Нельзя проверить buildstatus.log: 1С ещё работает.
&Тест
&Тег("integration")
Процедура ТестДолжен_ЗапуститьVanessaБезОжидания() Экспорт

	// Дано
	КаталогБазы = ФикстурнаяФайловаяБД.СкопироватьВоВременнойКаталог();
	ИнициализироватьИБСКонфигурацией(КаталогБазы);

	Исполнитель = СоздатьИсполнителя();
	ПутьФич = Исполнитель.ПутьФикстуры("vanessa", "features");
	ПутьНастроек = СоздатьVbParams(Исполнитель.КаталогРаботы(), ПутьФич);
	СтрокаПодключения = "/F""" + КаталогБазы + """";

	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Исполнитель.ДобавитьОпцию("--feature-path", ПутьФич);
	Исполнитель.ДобавитьОпцию("--vanessasettings", ПутьНастроек);
	Исполнитель.ДобавитьОпцию("--workspace", Исполнитель.КаталогРаботы());
	Исполнитель.ДобавитьОпцию("--bddrunner-path", Исполнитель.НайтиEpfADD("bddRunner.epf"));
	Исполнитель.ДобавитьФлаг("--no-wait");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда - команда успешно запустила 1С и немедленно вернула управление
	Исполнитель.ОжидаемЧтоКодВозврата(0, "запуск Vanessa-ADD без ожидания завершения");
	Исполнитель.ОжидаемЧтоВыводСодержит("Тестирую поведение");
	Исполнитель.ОжидаемЧтоВыводСодержит("1С:Предприятие запущено");

КонецПроцедуры

// Запуск vanessa с дополнительными ключами /С.
&Тест
&Тег("integration")
Процедура ТестДолжен_ЗапуститьVanessaСДопКлючами() Экспорт

	// Дано
	КаталогБазы = ФикстурнаяФайловаяБД.СкопироватьВоВременнойКаталог();
	ИнициализироватьИБСКонфигурацией(КаталогБазы);

	Исполнитель = СоздатьИсполнителя();
	ПутьФич = Исполнитель.ПутьФикстуры("vanessa", "features");
	ПутьНастроек = СоздатьVbParams(Исполнитель.КаталогРаботы(), ПутьФич);
	СтрокаПодключения = "/F""" + КаталогБазы + """";

	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Исполнитель.ДобавитьОпцию("--feature-path", ПутьФич);
	Исполнитель.ДобавитьОпцию("--vanessasettings", ПутьНастроек);
	Исполнитель.ДобавитьОпцию("--workspace", Исполнитель.КаталогРаботы());
	Исполнитель.ДобавитьОпцию("--bddrunner-path", Исполнитель.НайтиEpfADD("bddRunner.epf"));
	Исполнитель.ДобавитьОпцию("--additional-keys", "NoLoadTestClientsTable");
	Исполнитель.ДобавитьФлаг("--no-wait");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда - команда запустила 1С с доп. ключом и вернулась
	Исполнитель.ОжидаемЧтоКодВозврата(0, "запуск Vanessa-ADD с дополнительными ключами");
	Исполнитель.ОжидаемЧтоВыводСодержит("1С:Предприятие запущено");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	// Добиваем orphan-процессы 1С, оставленные тестами с --no-wait,
	// чтобы они не ломали кэш платформы для ibcmd в соседнем тесте.
	ТестОчисткаПроцессов.УбитьОрфанныеПроцессы1С();
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Инициализировать файловую ИБ из CF-фикстуры 1cv8.cf (через ibcmd).
// Нужно для загрузки конфигурации с CompatibilityMode=8.3.14 - без этого
// bddRunner.epf 6.8.0 падает на проверке версии платформы.
//
// Параметры:
//   КаталогБазы - Строка - путь к каталогу файловой ИБ
//
Процедура ИнициализироватьИБСКонфигурацией(КаталогБазы)
	// База уже скопирована из фикстуры — загружаем только конфигурацию.
	Аргументы = Новый Массив;
	Аргументы.Добавить("cf");
	Аргументы.Добавить("load");
	Исполнитель = Новый ИсполнительCLI(Аргументы);

	СтрокаПодключения = "/F""" + КаталогБазы + """";
	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Исполнитель.ДобавитьФлаг("--ibcmd");
	Исполнитель.ДобавитьФлаг("--update-db");
	Исполнитель.ДобавитьАргумент(Исполнитель.ПутьФикстуры("1cv8.cf"));

	Исполнитель.ВыполнитьКоманду();
	Исполнитель.ОжидаемЧтоКодВозврата(0, "загрузка конфигурации в ИБ (подготовка теста)");

КонецПроцедуры

Функция СоздатьИсполнителя()
	Аргументы = Новый Массив;
	Аргументы.Добавить("test");
	Аргументы.Добавить("vanessa");
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

// Создать vb-params.json в рабочем каталоге с абсолютным путём к buildstatus.log.
// Нужно потому, что bddRunner.epf не подставляет $workspaceRoot в пути из JSON.
//
// Параметры:
//   КаталогРаботы - Строка - рабочий каталог (workspace)
//   ПутьКФичам - Строка - абсолютный путь к каталогу фич
//
// Возвращаемое значение:
//   Строка - полный путь к созданному vb-params.json
//
Функция СоздатьVbParams(КаталогРаботы, ПутьКФичам)

	КаталогФичВРаботе = ОбъединитьПути(КаталогРаботы, "feature");
	Если НЕ Новый Файл(КаталогФичВРаботе).Существует() Тогда
		СоздатьКаталог(КаталогФичВРаботе);
	КонецЕсли;

	КопироватьКаталогФич(ПутьКФичам, КаталогФичВРаботе);

	ПутьСтатуса  = ОбъединитьПути(КаталогРаботы, "buildstatus.log");
	ПутьНастроек = ОбъединитьПути(КаталогРаботы, "vb-params.json");

	ПутьСтатусаJSON = "$workspaceRoot/buildstatus.log";
	ПутьКФичамJSON = "$workspaceRoot/feature/";

	ЗаписьТекста = Новый ЗаписьТекста(ПутьНастроек, "UTF-8");
	ЗаписьТекста.ЗаписатьСтроку("{");
	ЗаписьТекста.ЗаписатьСтроку("    ""КаталогФич"": """ + ПутьКФичамJSON + """,");
	ЗаписьТекста.ЗаписатьСтроку("    ""ВыполнитьСценарии"": ""Истина"",");
	ЗаписьТекста.ЗаписатьСтроку("    ""ЗавершитьРаботуСистемы"": true,");
	ЗаписьТекста.ЗаписатьСтроку("    ""ЗакрытьTestClientПослеЗапускаСценариев"": ""Истина"",");
	ЗаписьТекста.ЗаписатьСтроку("    ""ДелатьЛогВыполненияСценариевВТекстовыйФайл"": true,");
	ЗаписьТекста.ЗаписатьСтроку("    ""ИмяФайлаЛогВыполненияСценариев"": ""$workspaceRoot/vanessaonline.txt"",");
	ЗаписьТекста.ЗаписатьСтроку("    ""ВыгружатьСтатусВыполненияСценариевВФайл"": ""Истина"",");
	ЗаписьТекста.ЗаписатьСтроку("    ""ПутьКФайлуДляВыгрузкиСтатусаВыполненияСценариев"": """ + ПутьСтатусаJSON + """");
	ЗаписьТекста.ЗаписатьСтроку("}");
	ЗаписьТекста.Закрыть();

	Возврат ПутьНастроек;

КонецФункции

Процедура КопироватьКаталогФич(Знач КаталогИсточник, Знач КаталогНазначения)

	ПрефиксИсточника = Новый Файл(КаталогИсточник).ПолноеИмя;
	Если Прав(ПрефиксИсточника, 1) <> "\\" Тогда
		ПрефиксИсточника = ПрефиксИсточника + "\\";
	КонецЕсли;

	Элементы = НайтиФайлы(ПрефиксИсточника, "*", Истина);
	Для Каждого Элемент Из Элементы Цикл
		Если НЕ Элемент.ЭтоФайл() Тогда
			Продолжить;
		КонецЕсли;

		ОтносительныйПуть = Сред(Элемент.ПолноеИмя, СтрДлина(ПрефиксИсточника) + 1);
		ПутьНазначения = ОбъединитьПути(КаталогНазначения, ОтносительныйПуть);
		КаталогФайлаНазначения = Новый Файл(ПутьНазначения).Путь;
		Если НЕ Новый Файл(КаталогФайлаНазначения).Существует() Тогда
			СоздатьКаталог(КаталогФайлаНазначения);
		КонецЕсли;

		КопироватьФайл(Элемент.ПолноеИмя, ПутьНазначения);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
