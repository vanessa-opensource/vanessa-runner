// BSLLS-off
// Тестовый набор: test yaxunit
// Интеграционные тесты запуска модульного тестирования YAxUnit через CLI.
//
// Лёгкие тесты (справка, валидация) запускают реальную CLI-команду `vrunner test yaxunit`
// через подпроцесс и НЕ требуют установленной платформы 1С.
// Полноценный прогон YAxUnit (с реальной ИБ и расширениями yaxunit+tests) помечен
// тегом integration и требует платформу 1С - фикстуры в tests/e2e/fixtures/yaxunit/.

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands
#Использовать "../../utils"

Перем НакопленныеВременныеФайлы;

#Область СлужебныйПрограммныйИнтерфейс

// Проверка справки команды - содержит ключевые опции YAxUnit.
&Тест
Процедура ТестДолжен_ВывестиСправкуСОпциямиYaxunit() Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьФлаг("--help");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "Вывод справки vrunner test yaxunit --help");
	Исполнитель.ОжидаемЧтоВыводСодержит("yaxunit");
	Исполнитель.ОжидаемЧтоВыводСодержит("--yaxunit-config");
	Исполнитель.ОжидаемЧтоВыводСодержит("--ext");
	Исполнитель.ОжидаемЧтоВыводСодержит("--modules");
	Исполнитель.ОжидаемЧтоВыводСодержит("--tests");
	Исполнитель.ОжидаемЧтоВыводСодержит("--tags");
	Исполнитель.ОжидаемЧтоВыводСодержит("--suites");
	Исполнитель.ОжидаемЧтоВыводСодержит("--report");
	Исполнитель.ОжидаемЧтоВыводСодержит("--exitcode");
	Исполнитель.ОжидаемЧтоВыводСодержит("--project-path");
	Исполнитель.ОжидаемЧтоВыводСодержит("--workspace");
	Исполнитель.ОжидаемЧтоВыводСодержит("--show-report");
	Исполнитель.ОжидаемЧтоВыводСодержит("--no-close");
	Исполнитель.ОжидаемЧтоВыводСодержит("--no-wait");

КонецПроцедуры

// Общие опции подключения и платформы доступны.
&Тест
Процедура ТестДолжен_ПоддерживатьОпцииПодключенияИПлатформы() Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьФлаг("--help");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "Вывод справки vrunner test yaxunit --help (общие опции)");
	Исполнитель.ОжидаемЧтоВыводСодержит("--ibconnection");
	Исполнитель.ОжидаемЧтоВыводСодержит("--db-user");
	Исполнитель.ОжидаемЧтоВыводСодержит("--v8version");

КонецПроцедуры

// Указан несуществующий готовый конфиг - быстрая ошибка ещё до запуска платформы.
&Тест
Процедура ТестДолжен_ВернутьОшибкуПриОтсутствииКонфига() Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителя();
	ПутьНесуществующего = ОбъединитьПути(Исполнитель.КаталогРаботы(), "нет_такого_yaxunit.json");
	Исполнитель.ДобавитьОпцию("--ibconnection", "/F""some/path""");
	Исполнитель.ДобавитьОпцию("--yaxunit-config", ПутьНесуществующего);

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда - ненулевой код возврата и понятное сообщение (платформа не запускалась)
	КодВозврата = Исполнитель.КодВозврата();
	Ожидаем.Что(КодВозврата, "Ожидаем ненулевой код возврата при отсутствии конфига").Не_().Равно(0);
	Исполнитель.ОжидаемЧтоВыводСодержит("не найден");

КонецПроцедуры

// Полноценный прогон YAxUnit: пустая ИБ → движок YAxUnit + тестовое расширение →
// запуск тестов. Проверяет, что тест "Сложение" реально исполнен движком и пройден.
// Фикстуры: tests/e2e/fixtures/yaxunit/ (YAxUnit.cfe + tests-ext).
&Тест
&Тег("integration")
Процедура ТестДолжен_ПрогнатьТестЧерезYaxunit() Экспорт

	// Дано - пустая ИБ с загруженными движком YAxUnit и тестовым расширением
	КаталогБазы = ФикстурнаяФайловаяБД.СкопироватьВоВременнойКаталог();
	СтрокаПодключения = "/F""" + КаталогБазы + """";

	ЗагрузитьРасширение(СтрокаПодключения, "YAxUnit", СоздатьИсполнителя().ПутьФикстуры("yaxunit", "YAxUnit.cfe"));
	ЗагрузитьРасширение(СтрокаПодключения, "test", СоздатьИсполнителя().ПутьФикстуры("yaxunit", "tests-ext"));

	Прогон = СоздатьИсполнителя();
	ПутьОтчёта = ОбъединитьПути(Прогон.КаталогРаботы(), "junit.xml");
	ПутьСтатуса = ОбъединитьПути(Прогон.КаталогРаботы(), "exitCode.txt");
	Прогон.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Прогон.ДобавитьОпцию("--ext", "test");
	Прогон.ДобавитьОпцию("--report", ПутьОтчёта);
	Прогон.ДобавитьОпцию("--exitcode", ПутьСтатуса);

	// Когда
	Прогон.ВыполнитьКоманду();

	// Тогда - команда успешна, движок исполнил тест, отчёт содержит пройденный тест
	Прогон.ОжидаемЧтоКодВозврата(0, "прогон YAxUnit с тестовым расширением");
	Прогон.ОжидаемЧтоФайлСуществует("junit.xml");

	ЧтениеСтатуса = Новый ЧтениеТекста(ПутьСтатуса, "UTF-8");
	Статус = СокрЛП(ЧтениеСтатуса.Прочитать());
	ЧтениеСтатуса.Закрыть();
	Ожидаем.Что(Статус, "exitCode YAxUnit (все тесты пройдены)").Равно("0");

	ЧтениеОтчёта = Новый ЧтениеТекста(ПутьОтчёта, "UTF-8");
	Отчёт = ЧтениеОтчёта.Прочитать();
	ЧтениеОтчёта.Закрыть();
	Ожидаем.Что(Отчёт, "Отчёт содержит исполненный тест Сложение").Содержит("Сложение");
	Ожидаем.Что(Отчёт, "В отчёте нет проваленных тестов").Содержит("failures=""0""");
	Ожидаем.Что(Отчёт, "В отчёте нет ошибок выполнения").Содержит("errors=""0""");

	// И - в консоль выведено короткое саммари
	Прогон.ОжидаемЧтоВыводСодержит("YAxUnit: всего");
	Прогон.ОжидаемЧтоВыводСодержит("провалено 0");

КонецПроцедуры

// Zero-config прогон: только строка подключения и фильтр расширения, без --report/--exitcode.
// Отчёт формируется во временном файле, результат выводится коротким саммари в консоль.
&Тест
&Тег("integration")
Процедура ТестДолжен_ПрогнатьТестБезУказанияОтчета() Экспорт

	// Дано - пустая ИБ с загруженными движком YAxUnit и тестовым расширением
	КаталогБазы = ФикстурнаяФайловаяБД.СкопироватьВоВременнойКаталог();
	СтрокаПодключения = "/F""" + КаталогБазы + """";

	ЗагрузитьРасширение(СтрокаПодключения, "YAxUnit", СоздатьИсполнителя().ПутьФикстуры("yaxunit", "YAxUnit.cfe"));
	ЗагрузитьРасширение(СтрокаПодключения, "test", СоздатьИсполнителя().ПутьФикстуры("yaxunit", "tests-ext"));

	Прогон = СоздатьИсполнителя();
	Прогон.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Прогон.ДобавитьОпцию("--ext", "test");
	// --report и --exitcode НЕ заданы - проверяем zero-config режим

	// Когда
	Прогон.ВыполнитьКоманду();

	// Тогда - команда успешна и вывела саммари с пройденным тестом
	Прогон.ОжидаемЧтоКодВозврата(0, "zero-config прогон YAxUnit (только подключение и фильтр)");
	Прогон.ОжидаемЧтоВыводСодержит("YAxUnit: всего");
	Прогон.ОжидаемЧтоВыводСодержит("провалено 0");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсполнителя()
	Возврат НовыйИсполнитель("test", "yaxunit");
КонецФункции

Функция НовыйИсполнитель(Знач Подкоманда1, Знач Подкоманда2)
	Аргументы = Новый Массив;
	Аргументы.Добавить(Подкоманда1);
	Аргументы.Добавить(Подкоманда2);
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

// Загружает расширение (.cfe-файл или каталог XML-исходников) в файловую ИБ
// через конфигуратор с применением к базе (--update-db, безопасный режим выключен).
Процедура ЗагрузитьРасширение(Знач СтрокаПодключения, Знач ИмяРасширения, Знач ПутьИсточника)
	Загрузчик = НовыйИсполнитель("cfe", "load");
	Загрузчик.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Загрузчик.ДобавитьОпцию("--extension-name", ИмяРасширения);
	Загрузчик.ДобавитьФлаг("--update-db");
	Загрузчик.ДобавитьАргумент(ПутьИсточника);
	Загрузчик.ВыполнитьКоманду();
	Загрузчик.ОжидаемЧтоКодВозврата(0, "загрузка расширения " + ИмяРасширения + " в ИБ");
КонецПроцедуры

#КонецОбласти
