// BSLLS-off
// Тестовый набор: сбор покрытия тестов (--coverage-report) для команд test.
//
// Лёгкие тесты (справка, валидация --no-wait) НЕ требуют платформы 1С.
// Полноценный сбор покрытия (тег integration) требует платформу 1С, компоненту coveragebsl
// и сервер отладки dbgs: поднимает файловую ИБ с движком YAxUnit и тестовым расширением,
// прогоняет тесты с покрытием и проверяет сформированный genericCoverage-отчёт.
//
// Фикстуры: tests/e2e/fixtures/yaxunit/ (YAxUnit.cfe + tests-ext, имя расширения "test").

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands
#Использовать v8find
#Использовать "../../utils"

Перем НакопленныеВременныеФайлы;

#Область СлужебныйПрограммныйИнтерфейс

// Справка yaxunit содержит все опции покрытия.
&Тест
Процедура ТестДолжен_ВывестиОпцииПокрытияВСправке() Экспорт

	Исполнитель = СоздатьИсполнителя("yaxunit");
	Исполнитель.ДобавитьФлаг("--help");

	Исполнитель.ВыполнитьКоманду();

	Исполнитель.ОжидаемЧтоКодВозврата(0, "справка test yaxunit --help");
	Исполнитель.ОжидаемЧтоВыводСодержит("--coverage-report");
	Исполнитель.ОжидаемЧтоВыводСодержит("--coverage-format");
	Исполнитель.ОжидаемЧтоВыводСодержит("--coverage-src");
	Исполнитель.ОжидаемЧтоВыводСодержит("--coverage-ext");
	Исполнитель.ОжидаемЧтоВыводСодержит("--coverage-server");

КонецПроцедуры

// Опции покрытия доступны и в xunit, и в vanessa.
&Тест
Процедура ТестДолжен_ВывестиОпцииПокрытияДляXunitИVanessa() Экспорт

	ИсполнительXunit = СоздатьИсполнителя("xunit");
	ИсполнительXunit.ДобавитьФлаг("--help");
	ИсполнительXunit.ВыполнитьКоманду();
	ИсполнительXunit.ОжидаемЧтоКодВозврата(0, "справка test xunit --help");
	ИсполнительXunit.ОжидаемЧтоВыводСодержит("--coverage-report");

	ИсполнительVanessa = СоздатьИсполнителя("vanessa");
	ИсполнительVanessa.ДобавитьФлаг("--help");
	ИсполнительVanessa.ВыполнитьКоманду();
	ИсполнительVanessa.ОжидаемЧтоКодВозврата(0, "справка test vanessa --help");
	ИсполнительVanessa.ОжидаемЧтоВыводСодержит("--coverage-report");

КонецПроцедуры

// Покрытие несовместимо с --no-wait: команда падает с понятной ошибкой (без запуска платформы).
&Тест
Процедура ТестДолжен_ОтклонитьПокрытиеСNoWait() Экспорт

	Исполнитель = СоздатьИсполнителя("yaxunit");
	Исполнитель.ДобавитьОпцию("--ibconnection", "/F""" + ВременныеФайлы.СоздатьКаталог() + """");
	Исполнитель.ДобавитьОпцию("--coverage-report", ОбъединитьПути(Исполнитель.КаталогРаботы(), "gc.xml"));
	Исполнитель.ДобавитьФлаг("--no-wait");

	Исполнитель.ВыполнитьКоманду();

	КодВозврата = Исполнитель.КодВозврата();
	Ожидаем.Что(КодВозврата, "ненулевой код при покрытии с --no-wait").Не_().Равно(0);
	Исполнитель.ОжидаемЧтоВыводСодержит("no-wait");

КонецПроцедуры

// Полный сбор покрытия YAxUnit с проверкой корректности: код РЕАЛЬНО исполняется
// (covered="true" от coveragebsl) и ЧИТАЕТСЯ утилитой lines-to-cover
// (covered="false" для покрываемых, но не исполненных строк), процент посчитан,
// а отчёт согласован (покрытые + непокрытые = всего покрываемых).
&Тест
&Тег("integration")
Процедура ТестДолжен_СобратьПокрытиеYAxUnit() Экспорт

	// Дано - ИБ с движком YAxUnit и тестовым расширением "test"
	КаталогБазы = ФикстурнаяФайловаяБД.СкопироватьВоВременнойКаталог();
	СтрокаПодключения = "/F""" + КаталогБазы + """";

	ЗагрузитьРасширение(СтрокаПодключения, "YAxUnit", ПутьФикстуры("YAxUnit.cfe"));
	ЗагрузитьРасширение(СтрокаПодключения, "test", ПутьФикстуры("tests-ext"));

	Прогон = СоздатьИсполнителя("yaxunit");
	ПутьОтчёта = ОбъединитьПути(Прогон.КаталогРаботы(), "coverage", "genericCoverage.xml");
	Прогон.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Прогон.ДобавитьОпцию("--ext", "test");
	Прогон.ДобавитьОпцию("--coverage-report", ПутьОтчёта);
	Прогон.ДобавитьОпцию("--coverage-ext", ПутьФикстуры("tests-ext"));

	// Когда
	Прогон.ВыполнитьКоманду();

	// Тогда - команда успешна, процент посчитан, отчёт сформирован
	Прогон.ОжидаемЧтоКодВозврата(0, "прогон YAxUnit со сбором покрытия");
	Прогон.ОжидаемЧтоВыводСодержит("Включён сбор покрытия");
	Прогон.ОжидаемЧтоВыводСодержит("Покрытие строк:"); // процент залогирован (merge исполненных + покрываемых)
	Прогон.ОжидаемЧтоВыводСодержит("Отчёт покрытия сформирован");
	Прогон.ОжидаемЧтоФайлСуществует("coverage/genericCoverage.xml");

	Отчёт = ПрочитатьФайл(ПутьОтчёта);

	// Отчёт корректно сформирован (well-formed genericCoverage) и содержит модуль расширения.
	Ожидаем.Что(Отчёт, "genericCoverage открыт").Содержит("<coverage");
	Ожидаем.Что(Отчёт, "genericCoverage закрыт").Содержит("</coverage>");
	Ожидаем.Что(Отчёт, "модуль тестового расширения в отчёте").Содержит("Ext1_ПервыйТест");

	// В блоке <file> модуля есть И исполненные, И покрываемые-но-неисполненные строки:
	//   covered="true"  <- код реально исполнился (СложитьДляПокрытия, вызвана тестом);
	//   covered="false" <- код прочитан lines-to-cover, но не исполнялся
	//                      (НеИсполняемыйКодЗнаменателя) - это и есть знаменатель процента.
	БлокМодуля = БлокФайлаОтчёта(Отчёт, "Ext1_ПервыйТест");
	Ожидаем.Что(ЗначениеЗаполнено(БлокМодуля), "найден блок <file> модуля").ЭтоИстина();
	Ожидаем.Что(БлокМодуля, "исполненные строки (covered=true)").Содержит("covered=""true""");
	Ожидаем.Что(БлокМодуля, "покрываемые-неисполненные строки (covered=false)").Содержит("covered=""false""");

	// Отчёт согласован: покрытые + непокрытые = всего покрываемых (корректность объединения).
	ВсегоСтрок = ЧислоВхождений(Отчёт, "<lineToCover ");
	Покрыто = ЧислоВхождений(Отчёт, "covered=""true""");
	НеПокрыто = ЧислоВхождений(Отчёт, "covered=""false""");
	Ожидаем.Что(Покрыто, "есть исполненные строки").Не_().Равно(0);
	Ожидаем.Что(НеПокрыто, "есть покрываемые-неисполненные строки").Не_().Равно(0);
	Ожидаем.Что(Покрыто + НеПокрыто, "покрытые+непокрытые = всего покрываемых").Равно(ВсегоСтрок);

КонецПроцедуры

// Контраст: с --coverage-skip-lines знаменатель НЕ считается - в отчёте только исполненные
// строки, без процента и без covered="false". Доказывает, что covered="false" и процент
// появляются именно благодаря утилите lines-to-cover.
&Тест
&Тег("integration")
Процедура ТестДолжен_НеСчитатьЗнаменательСоSkipLines() Экспорт

	// Дано
	КаталогБазы = ФикстурнаяФайловаяБД.СкопироватьВоВременнойКаталог();
	СтрокаПодключения = "/F""" + КаталогБазы + """";
	ЗагрузитьРасширение(СтрокаПодключения, "YAxUnit", ПутьФикстуры("YAxUnit.cfe"));
	ЗагрузитьРасширение(СтрокаПодключения, "test", ПутьФикстуры("tests-ext"));

	Прогон = СоздатьИсполнителя("yaxunit");
	ПутьОтчёта = ОбъединитьПути(Прогон.КаталогРаботы(), "coverage", "genericCoverage.xml");
	Прогон.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Прогон.ДобавитьОпцию("--ext", "test");
	Прогон.ДобавитьОпцию("--coverage-report", ПутьОтчёта);
	Прогон.ДобавитьОпцию("--coverage-ext", ПутьФикстуры("tests-ext"));
	Прогон.ДобавитьФлаг("--coverage-skip-lines");

	// Когда
	Прогон.ВыполнитьКоманду();

	// Тогда - отчёт есть (исполненные строки), но без процента и без covered="false"
	Прогон.ОжидаемЧтоКодВозврата(0, "прогон YAxUnit без знаменателя (--coverage-skip-lines)");
	Прогон.ОжидаемЧтоВыводНеСодержит("Покрытие строк:");
	Прогон.ОжидаемЧтоФайлСуществует("coverage/genericCoverage.xml");

	Отчёт = ПрочитатьФайл(ПутьОтчёта);
	Ожидаем.Что(Отчёт, "исполненные строки в отчёте").Содержит("covered=""true""");
	Ожидаем.Что(Отчёт, "без знаменателя нет covered=false").Не_().Содержит("covered=""false""");

КонецПроцедуры

// Порт сервера отладки по умолчанию (1550) занят другим dbgs - сбор покрытия подбирает
// свободный порт и всё равно отрабатывает (проверка авто-подбора порта на реальном dbgs).
// Занимаем порт ИМЕННО реальным dbgs: обычный TCP-слушатель на Windows dbgs перебивает,
// а другой dbgs на том же порту честно падает ("порт занят").
&Тест
&Тег("integration")
Процедура ТестДолжен_ПодобратьПортЕслиДефолтныйЗанят() Экспорт

	// Дано - реальный dbgs держит порт 1550
	Занимающий = ЗанятьПортDBGS();

	Попытка
		КаталогБазы = ФикстурнаяФайловаяБД.СкопироватьВоВременнойКаталог();
		СтрокаПодключения = "/F""" + КаталогБазы + """";
		ЗагрузитьРасширение(СтрокаПодключения, "YAxUnit", ПутьФикстуры("YAxUnit.cfe"));
		ЗагрузитьРасширение(СтрокаПодключения, "test", ПутьФикстуры("tests-ext"));

		Прогон = СоздатьИсполнителя("yaxunit");
		ПутьОтчёта = ОбъединитьПути(Прогон.КаталогРаботы(), "coverage", "genericCoverage.xml");
		Прогон.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
		Прогон.ДобавитьОпцию("--ext", "test");
		Прогон.ДобавитьОпцию("--coverage-report", ПутьОтчёта);
		Прогон.ДобавитьОпцию("--coverage-ext", ПутьФикстуры("tests-ext"));
		// --coverage-server НЕ задаём => авто-подбор свободного порта

		// Когда
		Прогон.ВыполнитьКоманду();
	Исключение
		ОсвободитьПорт(Занимающий);
		ВызватьИсключение;
	КонецПопытки;
	ОсвободитьПорт(Занимающий);

	// Тогда - несмотря на занятый 1550, сервер отладки поднялся на ДРУГОМ порту, покрытие собрано
	Прогон.ОжидаемЧтоКодВозврата(0, "покрытие при занятом порту сервера отладки по умолчанию");
	Прогон.ОжидаемЧтоВыводСодержит("Запущен сервер отладки http://127.0.0.1:");
	Прогон.ОжидаемЧтоВыводНеСодержит("Запущен сервер отладки http://127.0.0.1:" + XMLСтрока(ПортDBGSПоУмолчанию()));
	Прогон.ОжидаемЧтоФайлСуществует("coverage/genericCoverage.xml");

КонецПроцедуры

// Формат отчёта переопределяется через --coverage-format (cobertura).
&Тест
&Тег("integration")
Процедура ТестДолжен_СформироватьОтчётCobertura() Экспорт

	// Дано
	КаталогБазы = ФикстурнаяФайловаяБД.СкопироватьВоВременнойКаталог();
	СтрокаПодключения = "/F""" + КаталогБазы + """";

	ЗагрузитьРасширение(СтрокаПодключения, "YAxUnit", ПутьФикстуры("YAxUnit.cfe"));
	ЗагрузитьРасширение(СтрокаПодключения, "test", ПутьФикстуры("tests-ext"));

	Прогон = СоздатьИсполнителя("yaxunit");
	ПутьОтчёта = ОбъединитьПути(Прогон.КаталогРаботы(), "coverage", "cobertura.xml");
	Прогон.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Прогон.ДобавитьОпцию("--ext", "test");
	Прогон.ДобавитьОпцию("--coverage-report", ПутьОтчёта);
	Прогон.ДобавитьОпцию("--coverage-format", "cobertura");
	Прогон.ДобавитьОпцию("--coverage-ext", ПутьФикстуры("tests-ext"));

	// Когда
	Прогон.ВыполнитьКоманду();

	// Тогда
	Прогон.ОжидаемЧтоКодВозврата(0, "прогон YAxUnit с отчётом Cobertura");
	Прогон.ОжидаемЧтоФайлСуществует("coverage/cobertura.xml");
	Отчёт = ПрочитатьФайл(ПутьОтчёта);
	Ожидаем.Что(Отчёт, "Cobertura XML").Содержит("coverage");

КонецПроцедуры

// Сбор покрытия через автономный сервер (ibsrv): серверный код исполняется в процессе ibsrv,
// который подключается к нашему серверу отладки - покрытие модуля расширения попадает в отчёт.
&Тест
&Тег("integration")
Процедура ТестДолжен_СобратьПокрытиеЧерезIbsrv() Экспорт

	// Дано
	КаталогБазы = ФикстурнаяФайловаяБД.СкопироватьВоВременнойКаталог();
	СтрокаПодключения = "/F""" + КаталогБазы + """";

	ЗагрузитьРасширение(СтрокаПодключения, "YAxUnit", ПутьФикстуры("YAxUnit.cfe"));
	ЗагрузитьРасширение(СтрокаПодключения, "test", ПутьФикстуры("tests-ext"));

	Прогон = СоздатьИсполнителя("yaxunit");
	ПутьОтчёта = ОбъединитьПути(Прогон.КаталогРаботы(), "coverage", "genericCoverage.xml");
	Прогон.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Прогон.ДобавитьОпцию("--ext", "test");
	Прогон.ДобавитьОпцию("--coverage-report", ПутьОтчёта);
	Прогон.ДобавитьОпцию("--coverage-ext", ПутьФикстуры("tests-ext"));
	Прогон.ДобавитьФлаг("--ibsrv");

	// Когда
	Прогон.ВыполнитьКоманду();

	// Тогда - покрытие серверного кода ibsrv попало в отчёт
	Прогон.ОжидаемЧтоКодВозврата(0, "прогон YAxUnit со сбором покрытия через ibsrv");
	Прогон.ОжидаемЧтоВыводСодержит("Отчёт покрытия сформирован");
	Прогон.ОжидаемЧтоФайлСуществует("coverage/genericCoverage.xml");

	Отчёт = ПрочитатьФайл(ПутьОтчёта);
	Ожидаем.Что(Отчёт, "покрыт модуль тестового расширения (ibsrv)").Содержит("Ext1_ПервыйТест");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсполнителя(Знач Подкоманда)
	Аргументы = Новый Массив;
	Аргументы.Добавить("test");
	Аргументы.Добавить(Подкоманда);
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

Функция ПутьФикстуры(Знач ИмяФайла)
	Возврат СоздатьИсполнителя("yaxunit").ПутьФикстуры("yaxunit", ИмяФайла);
КонецФункции

Процедура ЗагрузитьРасширение(Знач СтрокаПодключения, Знач ИмяРасширения, Знач ПутьИсточника)
	Аргументы = Новый Массив;
	Аргументы.Добавить("cfe");
	Аргументы.Добавить("load");
	Загрузчик = Новый ИсполнительCLI(Аргументы);
	Загрузчик.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Загрузчик.ДобавитьОпцию("--extension-name", ИмяРасширения);
	Загрузчик.ДобавитьФлаг("--update-db");
	Загрузчик.ДобавитьАргумент(ПутьИсточника);
	Загрузчик.ВыполнитьКоманду();
	Загрузчик.ОжидаемЧтоКодВозврата(0, "загрузка расширения " + ИмяРасширения);
КонецПроцедуры

Функция ПрочитатьФайл(Знач Путь)
	Чтение = Новый ЧтениеТекста(Путь, "UTF-8");
	Содержимое = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат Содержимое;
КонецФункции

// Извлечь фрагмент <file ...>...</file> для файла, чей путь содержит ФрагментПути.
Функция БлокФайлаОтчёта(Знач Отчёт, Знач ФрагментПути)

	ПозицияФрагмента = СтрНайти(Отчёт, ФрагментПути);
	Если ПозицияФрагмента = 0 Тогда
		Возврат "";
	КонецЕсли;

	Префикс = Лев(Отчёт, ПозицияФрагмента);
	НачалоТега = СтрНайти(Префикс, "<file ", НаправлениеПоиска.СКонца);
	Если НачалоТега = 0 Тогда
		Возврат "";
	КонецЕсли;

	ОтносительныйКонец = СтрНайти(Сред(Отчёт, ПозицияФрагмента), "</file>");
	Если ОтносительныйКонец = 0 Тогда
		Возврат Сред(Отчёт, НачалоТега);
	КонецЕсли;

	КонецБлока = ПозицияФрагмента + ОтносительныйКонец + СтрДлина("</file>") - 2;
	Возврат Сред(Отчёт, НачалоТега, КонецБлока - НачалоТега + 1);

КонецФункции

Функция ЧислоВхождений(Знач Текст, Знач Фрагмент)
	Возврат СтрЧислоВхождений(Текст, Фрагмент);
КонецФункции

// Порт сервера отладки dbgs по умолчанию (совпадает с СервисСервераОтладки.ПортПоУмолчанию).
Функция ПортDBGSПоУмолчанию()
	Возврат 1550;
КонецФункции

// Обеспечить, что порт dbgs по умолчанию (1550) ЗАНЯТ на время теста, и вернуть свой dbgs-процесс
// (или Неопределено). Сначала пытаемся занять 1550 своим dbgs; если не вышло - порт УЖЕ держит
// чужой (orphan) dbgs предыдущего теста (на Linux teardown dbgs не всегда штатный), и это тоже
// валидное "1550 занято": возвращаем Неопределено, покрытие должно подобрать другой порт.
// TCP-слушатель для занятия не годится: на Windows dbgs встаёт поверх него; конфликт даёт только dbgs.
Функция ЗанятьПортDBGS()

	ПутьDBGS = Платформа1С.ПутьКDBGS("");
	Если НЕ ЗначениеЗаполнено(ПутьDBGS) ИЛИ НЕ Новый Файл(ПутьDBGS).Существует() Тогда
		ВызватьИсключение "Не найден dbgs для занятия порта в тесте авто-подбора";
	КонецЕсли;

	Оповещение = ВременныеФайлы.НовоеИмяФайла("notify");
	СтрокаЗапуска = """" + ПутьDBGS + """ --addr=127.0.0.1 --port=" + XMLСтрока(ПортDBGSПоУмолчанию())
		+ " --notify=""" + Оповещение + """";
	Процесс = СоздатьПроцесс(СтрокаЗапуска);
	Процесс.Запустить();

	Прошло = 0;
	Пока Прошло < 15000 Цикл
		Если Новый Файл(Оповещение).Существует() Тогда
			Возврат Процесс; // заняли 1550 сами
		КонецЕсли;
		Если Процесс.Завершен Тогда
			Прервать; // dbgs упал: 1550 уже держит чужой (orphan) dbgs
		КонецЕсли;
		Приостановить(200);
		Прошло = Прошло + 200;
	КонецЦикла;

	Если Новый Файл(Оповещение).Существует() Тогда
		Возврат Процесс;
	КонецЕсли;

	// Сами не заняли, но 1550 занят чужим dbgs - для теста этого достаточно.
	ОсвободитьПорт(Процесс);
	Возврат Неопределено;

КонецФункции

Процедура ОсвободитьПорт(Знач Процесс)
	Если Процесс <> Неопределено Тогда
		Попытка
			Процесс.Завершить();
		Исключение
			// освобождение порта - best-effort
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
