	Исполнитель.ОжидаемЧтоВыводСодержит("Выполняю тесты");
	Исполнитель.ОжидаемЧтоВыводСодержит("1С:Предприятие запущено");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	// Гарантируем чистый кэш платформы 1С перед ibcmd-подготовкой теста:
	// orphan-процесс от предыдущего --no-wait теста иначе ломает ibcmd
	// с "Ошибка при работе с файлом".
	ТестОчисткаПроцессов.УбитьОрфанныеПроцессы1С();
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	// Добиваем orphan-процессы 1С, оставленные тестами с --no-wait,
	// чтобы они не ломали кэш платформы для ibcmd в соседнем тесте.
	ТестОчисткаПроцессов.УбитьОрфанныеПроцессы1С();
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Инициализировать файловую ИБ из CF-фикстуры 1cv8.cf (через ibcmd).
// Нужно для загрузки конфигурации с CompatibilityMode=8.3.14 - без этого
// xddTestRunner.epf падает на проверке версии платформы.
//
// Параметры:
//   КаталогБазы - Строка - путь к каталогу файловой ИБ
//
Процедура ИнициализироватьИБСКонфигурацией(КаталогБазы)
	// База уже скопирована из фикстуры — загружаем только конфигурацию.
	Аргументы = Новый Массив;
	Аргументы.Добавить("cf");
	Аргументы.Добавить("load");
	Исполнитель = Новый ИсполнительCLI(Аргументы);

	СтрокаПодключения = "/F""" + КаталогБазы + """";
	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Исполнитель.ДобавитьФлаг("--ibcmd");
	Исполнитель.ДобавитьФлаг("--update-db");
	Исполнитель.ДобавитьАргумент(Исполнитель.ПутьФикстуры("1cv8.cf"));

	Исполнитель.ВыполнитьКоманду();
	Исполнитель.ОжидаемЧтоКодВозврата(0, "загрузка конфигурации в ИБ (подготовка теста)");

КонецПроцедуры

Функция СоздатьИсполнителя()
	Аргументы = Новый Массив;
	Аргументы.Добавить("test");
	Аргументы.Добавить("xunit");
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

Функция СоздатьИсполнителяEpfCompile()
	Аргументы = Новый Массив;
	Аргументы.Добавить("epf");
