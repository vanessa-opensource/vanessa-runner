// BSLLS-off
// Тестовый набор: test xunit
// Интеграционные тесты запуска xUnit-тестирования через Vanessa-ADD.
//
// Тесты запускают реальную CLI-команду `vrunner test xunit` через подпроцесс.
// ИБ предоставляется через ПомощникИБ; EPF компилируется один раз при загрузке модуля.
//
// Фикстуры: tests/e2e/fixtures/xunit/ - тестовая обработка xUnit

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands
#Использовать "../../utils"

Перем НакопленныеВременныеФайлы;
Перем _ОбщийEpf;
Перем _КлиентыДо;

#Область СлужебныйПрограммныйИнтерфейс

// Проверка справки команды - содержит все обязательные опции.
&Тест
Процедура ТестДолжен_ВывестиСправкуСОпциямиXunit() Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьФлаг("--help");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "Вывод справки vrunner test xunit --help");
	Исполнитель.ОжидаемЧтоВыводСодержит("xunit");
	Исполнитель.ОжидаемЧтоВыводСодержит("--reportsxunit");
	Исполнитель.ОжидаемЧтоВыводСодержит("--pathxunit");
	Исполнитель.ОжидаемЧтоВыводСодержит("--xddExitCodePath");
	Исполнитель.ОжидаемЧтоВыводСодержит("--xddConfig");
	Исполнитель.ОжидаемЧтоВыводСодержит("--testclient");
	Исполнитель.ОжидаемЧтоВыводСодержит("--config-tests");
	Исполнитель.ОжидаемЧтоВыводСодержит("--xdddebug");
	Исполнитель.ОжидаемЧтоВыводСодержит("--no-shutdown");
	Исполнитель.ОжидаемЧтоВыводСодержит("--clear-reports");
	Исполнитель.ОжидаемЧтоВыводСодержит("--no-wait");
	Исполнитель.ОжидаемЧтоВыводСодержит("--workspace");

КонецПроцедуры

// Без обязательного аргумента testsPath - ошибка.
&Тест
Процедура ТестДолжен_ВернутьОшибкуБезПутиКТестам() Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьОпцию("--ibconnection", "/F""some/path""");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	КодВозврата = Исполнитель.КодВозврата();
	Ожидаем.Что(КодВозврата, "Ожидаем ненулевой код возврата без пути к тестам").Не_().Равно(0);

КонецПроцедуры

// Общие опции подключения и платформы доступны.
&Тест
Процедура ТестДолжен_ПоддерживатьОпцииПодключенияИПлатформы() Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьФлаг("--help");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "Вывод справки vrunner test xunit --help (опции подключения)");
	Исполнитель.ОжидаемЧтоВыводСодержит("--ibconnection");
	Исполнитель.ОжидаемЧтоВыводСодержит("--db-user");
	Исполнитель.ОжидаемЧтоВыводСодержит("--db-pwd");
	Исполнитель.ОжидаемЧтоВыводСодержит("--v8version");
	Исполнитель.ОжидаемЧтоВыводСодержит("--ordinaryapp");
	Исполнитель.ОжидаемЧтоВыводСодержит("--additional");

КонецПроцедуры

// Запуск xUnit с тестовой обработкой: аналог ТестДолжен_ВыполнитьУспешноеТестированиеПроектаIbsrv.
&Тест
&Тег("integration")
Процедура ТестДолжен_ВыполнитьТестыXUnit() Экспорт

	// Дано
	КаталогБазы = ПомощникИБ.ПолучитьИзолированнуюИБ();

	Исполнитель = СоздатьИсполнителя();
	СтрокаПодключения = "/F""" + КаталогБазы + """";
	ПутьСтатуса = ОбъединитьПути(Исполнитель.КаталогРаботы(), "exitCode.txt");

	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Исполнитель.ДобавитьОпцию("--workspace", Исполнитель.КаталогРаботы());
	Исполнитель.ДобавитьОпцию("--xddExitCodePath", ПутьСтатуса);
	Исполнитель.ДобавитьОпцию("--pathxunit", Исполнитель.НайтиEpfADD("xddTestRunner.epf"));
	Исполнитель.ДобавитьАргумент(_ОбщийEpf);

	// Когда
	Исполнитель.ВыполнитьКоманду();
	Если Исполнитель.КодВозврата() <> 0 Тогда
		ВызватьИсключение "Диагностика xUnit: " + Исполнитель.Вывод();
	КонецЕсли;

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "запуск xUnit-тестирования в 1С");
	Исполнитель.ОжидаемЧтоВыводСодержит("Выполнение в режиме 1С:Предприятие завершено успешно");

	ФайлСтатуса = Новый Файл(ПутьСтатуса);
	Ожидаем.Что(ФайлСтатуса.Существует(), "xUnit должен создать exitCode.txt").ЭтоИстина();

	ЧтениеТекста = Новый ЧтениеТекста(ПутьСтатуса, "UTF-8");
	Статус = СокрЛП(ЧтениеТекста.Прочитать());
	ЧтениеТекста.Закрыть();
	Ожидаем.Что(Статус, "Все тесты должны пройти (exitCode.txt = 0)").Равно("0");

КонецПроцедуры

// Запуск xUnit с генерацией JUnit-отчёта.
&Тест
&Тег("integration")
Процедура ТестДолжен_ЗапуститьXunitСОтчётомJUnit() Экспорт

	// Дано
	КаталогБазы = ПомощникИБ.ПолучитьИзолированнуюИБ();

	Исполнитель = СоздатьИсполнителя();
	СтрокаПодключения = "/F""" + КаталогБазы + """";
	ПутьОтчёта = ОбъединитьПути(Исполнитель.КаталогРаботы(), "junit.xml");
	ПутьСтатуса = ОбъединитьПути(Исполнитель.КаталогРаботы(), "exitCode.txt");

	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Исполнитель.ДобавитьОпцию("--workspace", Исполнитель.КаталогРаботы());
	Исполнитель.ДобавитьОпцию("--reportsxunit", "ГенераторОтчетаJUnitXML{" + ПутьОтчёта + "}");
	Исполнитель.ДобавитьОпцию("--xddExitCodePath", ПутьСтатуса);
	Исполнитель.ДобавитьОпцию("--pathxunit", Исполнитель.НайтиEpfADD("xddTestRunner.epf"));
	Исполнитель.ДобавитьАргумент(_ОбщийEpf);

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0);
	Исполнитель.ОжидаемЧтоВыводСодержит("Выполнение в режиме 1С:Предприятие завершено успешно");
	Исполнитель.ОжидаемЧтоФайлСуществует("junit.xml");

КонецПроцедуры

// Запуск xUnit с очисткой каталогов отчётов.
&Тест
&Тег("integration")
Процедура ТестДолжен_ЗапуститьXunitСОчисткойОтчётов() Экспорт

	// Дано
	КаталогБазы = ПомощникИБ.ПолучитьИзолированнуюИБ();

	Исполнитель = СоздатьИсполнителя();
	СтрокаПодключения = "/F""" + КаталогБазы + """";

	КаталогJunit = ОбъединитьПути(Исполнитель.КаталогРаботы(), "junitreport");
	СоздатьКаталог(КаталогJunit);
	ПутьОтчёта = ОбъединитьПути(КаталогJunit, "junit.xml");
	ПутьСтатуса = ОбъединитьПути(Исполнитель.КаталогРаботы(), "exitCode.txt");

	// Создаём файл-заглушку, который должен быть удалён при --clear-reports
	ПутьЗаглушки = ОбъединитьПути(КаталогJunit, "dummy.xml");
	ЗаписьТекста = Новый ЗаписьТекста(ПутьЗаглушки);
	ЗаписьТекста.ЗаписатьСтроку("dummy");
	ЗаписьТекста.Закрыть();

	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Исполнитель.ДобавитьОпцию("--workspace", Исполнитель.КаталогРаботы());
	Исполнитель.ДобавитьОпцию("--reportsxunit", "ГенераторОтчетаJUnitXML{" + ПутьОтчёта + "}");
	Исполнитель.ДобавитьОпцию("--xddExitCodePath", ПутьСтатуса);
	Исполнитель.ДобавитьОпцию("--pathxunit", Исполнитель.НайтиEpfADD("xddTestRunner.epf"));
	Исполнитель.ДобавитьФлаг("--clear-reports");
	Исполнитель.ДобавитьАргумент(_ОбщийEpf);

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0);
	ФайлЗаглушки = Новый Файл(ПутьЗаглушки);
	Ожидаем.Что(ФайлЗаглушки.Существует(), "Файл-заглушка должен быть удалён при --clear-reports").ЭтоЛожь();

КонецПроцедуры

// Запуск xUnit с тест-клиентом.
&Тест
&Тег("integration")
Процедура ТестДолжен_ЗапуститьXunitСТестКлиентом() Экспорт

	// Дано
	КаталогБазы = ПомощникИБ.ПолучитьИзолированнуюИБ();

	Исполнитель = СоздатьИсполнителя();
	СтрокаПодключения = "/F""" + КаталогБазы + """";

	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Исполнитель.ДобавитьОпцию("--workspace", Исполнитель.КаталогРаботы());
	Исполнитель.ДобавитьОпцию("--db-user", "Администратор");
	Исполнитель.ДобавитьОпцию("--db-pwd", "пароль");
	Исполнитель.ДобавитьОпцию("--testclient", "::1538");
	Исполнитель.ДобавитьОпцию("--pathxunit", Исполнитель.НайтиEpfADD("xddTestRunner.epf"));
	Исполнитель.ДобавитьФлаг("--no-wait");
	Исполнитель.ДобавитьАргумент(_ОбщийEpf);

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда - команда сформировала строку с тест-клиентом и запустила 1С
	Исполнитель.ОжидаемЧтоКодВозврата(0, "запуск xUnit с тест-клиентом");
	Исполнитель.ОжидаемЧтоВыводСодержит("1С:Предприятие запущено");

КонецПроцедуры

// Запуск xUnit без ожидания - 1С запущен, команда вернулась сразу.
&Тест
&Тег("integration")
Процедура ТестДолжен_ЗапуститьXunitБезОжидания() Экспорт

	// Дано
	КаталогБазы = ПомощникИБ.ПолучитьИзолированнуюИБ();

	Исполнитель = СоздатьИсполнителя();
	СтрокаПодключения = "/F""" + КаталогБазы + """";

	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Исполнитель.ДобавитьОпцию("--workspace", Исполнитель.КаталогРаботы());
	Исполнитель.ДобавитьОпцию("--pathxunit", Исполнитель.НайтиEpfADD("xddTestRunner.epf"));
	Исполнитель.ДобавитьФлаг("--no-wait");
	Исполнитель.ДобавитьАргумент(_ОбщийEpf);

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда - команда запустила 1С и немедленно вернулась
	Исполнитель.ОжидаемЧтоКодВозврата(0, "запуск xUnit без ожидания завершения");
	Исполнитель.ОжидаемЧтоВыводСодержит("Выполняю тесты");
	Исполнитель.ОжидаемЧтоВыводСодержит("1С:Предприятие запущено");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	_КлиентыДо = КлиентыТеста.СнимокЗапущенных();
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	// Тесты с --no-wait запускают 1С-клиент и сразу возвращаются. Дожидаемся
	// штатного завершения именно нашего клиента (раннер закрывает 1С после
	// прогона сам), иначе orphan держит файловые блокировки и ломает ibcmd
	// следующего теста — "Ошибка при работе с файлом" (Windows). Без глобального
	// taskkill: гасим, если что, ровно свой PID. См. КлиентыТеста.
	КлиентыТеста.ДождатьсяЗавершенияНовых(_КлиентыДо);
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсполнителя()
	Аргументы = Новый Массив;
	Аргументы.Добавить("test");
	Аргументы.Добавить("xunit");
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

#КонецОбласти

// --------------------------------------------------------------------------
// Инициализация модуля: компилируем EPF один раз до запуска любых тестов.
// ИБ создаётся через ПомощникИБ при первом обращении теста.
// --------------------------------------------------------------------------

_АргументыEpf = Новый Массив;
_АргументыEpf.Добавить("epf");
_АргументыEpf.Добавить("compile");
ИсполнительEpfОбщий = Новый ИсполнительCLI(_АргументыEpf);
ИсполнительEpfОбщий.ДобавитьОпцию("--out", ИсполнительEpfОбщий.КаталогРаботы());
ИсполнительEpfОбщий.ДобавитьФлаг("--ibcmd");
ИсполнительEpfОбщий.ДобавитьАргумент(ИсполнительEpfОбщий.ПутьФикстуры("xunit", "xdd_test"));
ИсполнительEpfОбщий.ВыполнитьКоманду();
Если ИсполнительEpfОбщий.КодВозврата() <> 0 Тогда
	ВызватьИсключение "Инициализация модуля: не удалось скомпилировать xdd_test.epf. Вывод:" + Символы.ПС + ИсполнительEpfОбщий.Вывод();
КонецЕсли;
_ОбщийEpf = ОбъединитьПути(ИсполнительEpfОбщий.КаталогРаботы(), "xdd_test.epf");
