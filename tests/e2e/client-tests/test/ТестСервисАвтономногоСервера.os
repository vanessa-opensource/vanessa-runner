// BSLLS-off
// Юнит-тесты для СервисАвтономногоСервера.
// Проверяют только локальную логику (не запускают ibsrv-процесс):
//   - формирование строки подключения /WS и /S
//   - детектирование файловой ИБ по строке подключения
//   - извлечение каталога файловой ИБ из параметров подключения
//
// Использование сервиса напрямую (минуя контейнер autumn): создаётся
// через Загрузить (в ОС: simple instantiation) — &Желудь не требуется
// для прямого создания.

#Использовать asserts
#Использовать "../../../../src/core/Сервисы"

#Область СлужебныйПрограммныйИнтерфейс

&Тест
Процедура ТестДолжен_ОпределитьФайловуюИБ() Экспорт

	Сервис = Новый СервисАвтономногоСервера;

	Ожидаем.Что(Сервис.ЭтоФайловаяИБ("/F""C:\base""")).ЭтоИстина();
	Ожидаем.Что(Сервис.ЭтоФайловаяИБ("/F""/tmp/base""")).ЭтоИстина();
	Ожидаем.Что(Сервис.ЭтоФайловаяИБ("  /f""path""  ")).ЭтоИстина(); // регистр и пробелы

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОпределитьЧтоЭтоНеФайловаяИБ() Экспорт

	Сервис = Новый СервисАвтономногоСервера;

	Ожидаем.Что(Сервис.ЭтоФайловаяИБ("/S""localhost\base""")).ЭтоЛожь();
	Ожидаем.Что(Сервис.ЭтоФайловаяИБ("/WS""http://x/y""")).ЭтоЛожь();
	Ожидаем.Что(Сервис.ЭтоФайловаяИБ("")).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьСтруктуруПараметровАСПоУмолчанию() Экспорт

	Сервис = Новый СервисАвтономногоСервера;
	Параметры = Сервис.НовыеПараметрыАС();

	Ожидаем.Что(Параметры.ИспользоватьПрямоеСоединение).ЭтоЛожь();
	Ожидаем.Что(Параметры.ИспользоватьОтладку).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьWSПодключениеПоУмолчанию() Экспорт

	Сервис = Новый СервисАвтономногоСервера;
	// без запуска сервера используется порт по умолчанию 8314
	СтрокаПодключения = Сервис.СтрокаПодключения();

	Ожидаем.Что(СтрокаПодключения).Содержит("/WS");
	Ожидаем.Что(СтрокаПодключения).Содержит("http://localhost:");
	Ожидаем.Что(СтрокаПодключения).Содержит("8314");

КонецПроцедуры

#КонецОбласти
