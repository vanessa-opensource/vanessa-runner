// BSLLS-off
// Тестовый набор: infobase init
// Интеграционные тесты инициализации информационной базы.
//
// Тесты запускают реальную CLI-команду `vrunner infobase init` через подпроцесс.
// Базовые сценарии параметризованы по режиму (ibcmd / конфигуратор).
//
// Фикстуры: tests/e2e/fixtures/cf/ - XML-исходники конфигурации

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands
#Использовать v8runner
#Использовать "../../utils"

Перем НакопленныеВременныеФайлы;

#Область СлужебныйПрограммныйИнтерфейс

// Создание пустой файловой базы без загрузки конфигурации.
&ПараметризованныйТест
&ИсточникЗначение("ibcmd")
&ИсточникЗначение("designer")
Процедура ТестДолжен_СоздатьПустуюФайловуюБазу(Режим) Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителя();
	КаталогБазы = ОбъединитьПути(Исполнитель.КаталогРаботы(), "build", "ib");
	ДобавитьФлагРежима(Исполнитель, Режим);

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "создание пустой файловой ИБ");
	Исполнитель.ОжидаемЧтоКаталогСуществует(ОбъединитьПути("build", "ib"));

КонецПроцедуры

// Создание базы с загрузкой конфигурации из исходников.
&ПараметризованныйТест
&ИсточникЗначение("ibcmd")
&ИсточникЗначение("designer")
Процедура ТестДолжен_СоздатьБазуИзИсходников(Режим) Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителя();
	КаталогSrc = Исполнитель.ПутьФикстуры("cf");
	Исполнитель.ДобавитьОпцию("--src", КаталогSrc);
	ДобавитьФлагРежима(Исполнитель, Режим);

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "создание ИБ из исходников конфигурации");
	Исполнитель.ОжидаемЧтоКаталогСуществует(ОбъединитьПути("build", "ib"));

КонецПроцедуры

// Создание базы из исходников, заданных ОТНОСИТЕЛЬНЫМ путём с префиксом "./".
// Регрессия: ibcmd на таком пути открывает корневой каталог, но вложенные файлы ищет мимо
// и падает с "файл <путь> отсутствует либо поврежден" - каждый раз на другом файле.
&ПараметризованныйТест
&ИсточникЗначение("ibcmd")
&ИсточникЗначение("designer")
Процедура ТестДолжен_СоздатьБазуИзИсходников_ПоОтносительномуПути(Режим) Экспорт

	// Дано - фикстура материализуется в каталоге работы исполнителя, он же рабочий каталог команды
	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ПутьФикстуры("cf");
	Исполнитель.ДобавитьОпцию("--src", "./fixtures/cf");
	ДобавитьФлагРежима(Исполнитель, Режим);

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "создание ИБ из исходников по относительному пути");
	Исполнитель.ОжидаемЧтоКаталогСуществует(ОбъединитьПути("build", "ib"));

КонецПроцедуры

// Создание базы с загрузкой конфигурации из cf-файла.
// Требуется cf-файл, сначала собираем его, потом создаём базу из него.
&ПараметризованныйТест
&ИсточникЗначение("ibcmd")
&ИсточникЗначение("designer")
Процедура ТестДолжен_СоздатьБазуИзФайлаCf(Режим) Экспорт

	// Дано - сначала собрать cf
	ИсполнительCf = СоздатьИсполнителяCfCompile();
	КаталогSrc = ИсполнительCf.ПутьФикстуры("cf");
	ИсполнительCf.ДобавитьОпцию("--src", КаталогSrc);
	ДобавитьФлагРежима(ИсполнительCf, Режим);
	ИсполнительCf.ДобавитьАргумент("1Cv8.cf");
	ИсполнительCf.ВыполнитьКоманду();
	ИсполнительCf.ОжидаемЧтоКодВозврата(0, "загрузка CF-файла в базу (подготовка теста)");

	ПутьКCf = ОбъединитьПути(ИсполнительCf.КаталогРаботы(), "1Cv8.cf");

	// Дано - создать базу из cf
	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьОпцию("--src", ПутьКCf);
	ДобавитьФлагРежима(Исполнитель, Режим);

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "создание ИБ из CF-файла");
	Исполнитель.ОжидаемЧтоКаталогСуществует(ОбъединитьПути("build", "ib"));

КонецПроцедуры

// Создание базы с указанным путём подключения.
&ПараметризованныйТест
&ИсточникЗначение("ibcmd")
&ИсточникЗначение("designer")
Процедура ТестДолжен_СоздатьБазуСУказаннымПутемПодключения(Режим) Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителя();
	КаталогSrc = Исполнитель.ПутьФикстуры("cf");
	Исполнитель.ДобавитьОпцию("--src", КаталогSrc);
	КаталогБазы = ОбъединитьПути(Исполнитель.КаталогРаботы(), "custom-db");
	СтрокаПодключения = "/F""" + КаталогБазы + """";
	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	ДобавитьФлагРежима(Исполнитель, Режим);

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "создание ИБ с явно указанным путём подключения");
	Исполнитель.ОжидаемЧтоКаталогСуществует("custom-db");

КонецПроцедуры

// Псевдоним --source сохранён для обратной совместимости и работает как --src.
&Тест
Процедура ТестДолжен_ПринятьПсевдонимSourceКакSrc() Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителя();
	КаталогSrc = Исполнитель.ПутьФикстуры("cf");
	Исполнитель.ДобавитьОпцию("--source", КаталогSrc);

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "создание ИБ из исходников через псевдоним --source");
	Исполнитель.ОжидаемЧтоКаталогСуществует(ОбъединитьПути("build", "ib"));

КонецПроцедуры

// Создание базы и загрузка расширения из XML-исходников опцией --ext.
// Имя расширения определяется автоматически из имени каталога-источника ("cfe").
&ПараметризованныйТест
&ИсточникЗначение("ibcmd")
&ИсточникЗначение("designer")
Процедура ТестДолжен_СоздатьБазуИЗагрузитьРасширение(Режим) Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителя();
	КаталогРасширения = Исполнитель.ПутьФикстуры("cfe");
	Исполнитель.ДобавитьОпцию("--ext", КаталогРасширения);
	ДобавитьФлагРежима(Исполнитель, Режим);

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "создание ИБ и загрузка расширения из исходников");
	Исполнитель.ОжидаемЧтоКаталогСуществует(ОбъединитьПути("build", "ib"));

КонецПроцедуры

// Создание базы и загрузка двух расширений разных типов одной командой:
// .cfe-файл и каталог XML-исходников. Имя каждого определяется из имени файла/каталога.
&ПараметризованныйТест
&ИсточникЗначение("ibcmd")
&ИсточникЗначение("designer")
Процедура ТестДолжен_ЗагрузитьДваРасширенияРазныхТипов(Режим) Экспорт

	// Дано - первое расширение как .cfe-файл, второе как каталог XML-исходников
	ФайлCfe = СобратьCfeВФайл(Режим, "ПервоеРасширение");

	Исполнитель = СоздатьИсполнителя();
	КаталогXml = Исполнитель.ПутьФикстуры("cfe2");
	Исполнитель.ДобавитьОпцию("--ext", ФайлCfe);
	Исполнитель.ДобавитьОпцию("--ext", КаталогXml);
	ДобавитьФлагРежима(Исполнитель, Режим);

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "загрузка двух расширений разных типов (.cfe и XML)");
	Исполнитель.ОжидаемЧтоКаталогСуществует(ОбъединитьПути("build", "ib"));

КонецПроцедуры

// --recursive: cf-файл лежит в подкаталоге, не непосредственно в --src.
// vrunner должен найти его рекурсивно и создать базу.
&ПараметризованныйТест
&ИсточникЗначение("ibcmd")
&ИсточникЗначение("designer")
Процедура ТестДолжен_НайтиCfВложенноРекурсивно(Режим) Экспорт

	// Дано: cf-файл спрятан в подкаталоге рабочего каталога
	Исполнитель = СоздатьИсполнителя();
	КаталогСrc = СоздатьВложенныйCf(Исполнитель, "project", "releases");

	Исполнитель.ДобавитьОпцию("--src", КаталогСrc);
	Исполнитель.ДобавитьФлаг("--recursive");
	ДобавитьФлагРежима(Исполнитель, Режим);

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "создание ИБ из cf-файла, найденного рекурсивно");
	Исполнитель.ОжидаемЧтоКаталогСуществует(ОбъединитьПути("build", "ib"));

КонецПроцедуры

// --recursive: расширения лежат в подкаталогах --ext.
// vrunner должен найти оба расширения и загрузить их.
&ПараметризованныйТест
&ИсточникЗначение("ibcmd")
&ИсточникЗначение("designer")
Процедура ТестДолжен_НайтиРасширенияВложенноРекурсивно(Режим) Экспорт

	// Дано: два каталога XML-исходников расширений вложены в общий каталог
	Исполнитель = СоздатьИсполнителя();
	КаталогРасш = ОбъединитьПути(Исполнитель.КаталогРаботы(), "allext");
	СоздатьКаталог(КаталогРасш);
	КопироватьКаталогФикстуры(Исполнитель, "cfe", КаталогРасш, "cfe");
	КопироватьКаталогФикстуры(Исполнитель, "cfe2", КаталогРасш, "cfe2");

	Исполнитель.ДобавитьОпцию("--ext", КаталогРасш);
	Исполнитель.ДобавитьФлаг("--recursive");
	ДобавитьФлагРежима(Исполнитель, Режим);

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "загрузка расширений, найденных рекурсивно в --ext");
	Исполнитель.ОжидаемЧтоКаталогСуществует(ОбъединитьПути("build", "ib"));

КонецПроцедуры

// --recursive: в каталоге --src найдено два источника конфигурации.
// vrunner должен завершиться с ошибкой и описанием.
&Тест
Процедура ТестДолжен_ВернутьОшибкуЕслиНесколькоКонфигурацийНайдено() Экспорт

	Исполнитель = СоздатьИсполнителя();
	КорневойCrc = ОбъединитьПути(Исполнитель.КаталогРаботы(), "multi");
	СоздатьКаталог(КорневойCrc);
	КаталогConf1 = ОбъединитьПути(КорневойCrc, "conf1");
	КаталогConf2 = ОбъединитьПути(КорневойCrc, "conf2");
	СоздатьКаталог(КаталогConf1);
	СоздатьКаталог(КаталогConf2);
	СоздатьПустойФайл(ОбъединитьПути(КаталогConf1, "Configuration.xml"));
	СоздатьПустойФайл(ОбъединитьПути(КаталогConf2, "Configuration.xml"));

	Исполнитель.ДобавитьОпцию("--src", КорневойCrc);
	Исполнитель.ДобавитьФлаг("--recursive");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Ожидаем.Что(Исполнитель.КодВозврата(), "несколько конфигураций — ненулевой код").Не_().Равно(0);
	Исполнитель.ОжидаемЧтоВыводСодержит("conf1");
	Исполнитель.ОжидаемЧтоВыводСодержит("conf2");

КонецПроцедуры

// --recursive: в каталоге --ext найдены два расширения с одинаковым именем.
// vrunner должен завершиться с ошибкой ещё до загрузки.
&Тест
Процедура ТестДолжен_ВернутьОшибкуЕслиДублирующиесяИменаРасширений() Экспорт

	// Дано: собираем .cfe-файл с именем "cfe" (имя берётся из папки fixtures/cfe)
	//       и рядом кладём XML-каталог "cfe" — коллизия имён
	ФайлCfe = СобратьCfeВФайл("ibcmd", "cfe");

	Исполнитель = СоздатьИсполнителя();
	КаталогРасш = ОбъединитьПути(Исполнитель.КаталогРаботы(), "dupext");
	СоздатьКаталог(КаталогРасш);

	// Первый источник — .cfe-файл
	КопироватьФайл(ФайлCfe, ОбъединитьПути(КаталогРасш, "cfe.cfe"));
	// Второй источник — XML-каталог расширения с тем же именем "cfe" (с маркером расширения)
	КаталогXmlCfe = ОбъединитьПути(КаталогРасш, "cfe");
	СоздатьКаталог(КаталогXmlCfe);
	ЗаписатьКонфигурациюРасширения(КаталогXmlCfe);

	Исполнитель.ДобавитьОпцию("--ext", КаталогРасш);
	Исполнитель.ДобавитьФлаг("--recursive");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Ожидаем.Что(Исполнитель.КодВозврата(), "дублирующееся имя расширения — ненулевой код").Не_().Равно(0);
	Исполнитель.ОжидаемЧтоВыводСодержит("cfe");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсполнителя()
	Аргументы = Новый Массив;
	Аргументы.Добавить("infobase");
	Аргументы.Добавить("init");
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

Функция СоздатьИсполнителяCfCompile()
	Аргументы = Новый Массив;
	Аргументы.Добавить("cf");
	Аргументы.Добавить("compile");
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

Процедура ДобавитьФлагРежима(Исполнитель, Режим)
	Если Режим = "ibcmd" Тогда
		Исполнитель.ДобавитьФлаг("--ibcmd");
	КонецЕсли;
КонецПроцедуры

// Создать вложенную структуру <работа>/<sub1>/<sub2>/1Cv8.cf, скопировав фикстуру 1cv8.cf.
// Возвращает путь к <работа>/<sub1> — корневой каталог для передачи в --src --recursive.
Функция СоздатьВложенныйCf(Исполнитель, Суб1, Суб2)
	Корень = ОбъединитьПути(Исполнитель.КаталогРаботы(), Суб1);
	Вложенный = ОбъединитьПути(Корень, Суб2);
	СоздатьКаталог(Корень);
	СоздатьКаталог(Вложенный);
	КопироватьФайл(Исполнитель.ПутьФикстуры("1cv8.cf"), ОбъединитьПути(Вложенный, "1Cv8.cf"));
	Возврат Корень;
КонецФункции

// Скопировать каталог фикстуры целиком в целевой каталог под именем ЦелевоеИмя.
// Используется для создания вложенной структуры расширений для --recursive.
Процедура КопироватьКаталогФикстуры(Исполнитель, ИмяФикстуры, ЦелевойКаталог, ЦелевоеИмя)
	Источник = Исполнитель.ПутьФикстуры(ИмяФикстуры);
	Назначение = ОбъединитьПути(ЦелевойКаталог, ЦелевоеИмя);
	СоздатьКаталог(Назначение);
	Для Каждого ФайлИсточника Из НайтиФайлы(Источник, "*", Истина) Цикл
		Если ФайлИсточника.ЭтоКаталог() Тогда
			Продолжить;
		КонецЕсли;
		ОтносительныйПуть = ОтносительныйПутьВнутри(Источник, ФайлИсточника.ПолноеИмя);
		ПутьНазначения = ОбъединитьПути(Назначение, ОтносительныйПуть);
		ОбеспечитьРодительскийКаталог(ПутьНазначения);
		КопироватьФайл(ФайлИсточника.ПолноеИмя, ПутьНазначения);
	КонецЦикла;
КонецПроцедуры

// Относительный путь файла внутри базового каталога, без ведущих разделителей.
// Иначе ОбъединитьПути(назначение, "\file") трактует путь как абсолютный (корень диска).
Функция ОтносительныйПутьВнутри(БазовыйКаталог, ПолныйПуть)
	Относительный = СтрЗаменить(ПолныйПуть, БазовыйКаталог, "");
	Пока СтрДлина(Относительный) > 0 И (Лев(Относительный, 1) = "\" ИЛИ Лев(Относительный, 1) = "/") Цикл
		Относительный = Сред(Относительный, 2);
	КонецЦикла;
	Возврат Относительный;
КонецФункции

// Создать родительский каталог для файла, если его ещё нет.
Процедура ОбеспечитьРодительскийКаталог(ПутьФайла)
	РодительскийКаталог = Новый Файл(ПутьФайла).Путь;
	Если НЕ Новый Файл(РодительскийКаталог).Существует() Тогда
		СоздатьКаталог(РодительскийКаталог);
	КонецЕсли;
КонецПроцедуры

// Создать пустой файл (только для тестирования обнаружения, не для загрузки).
Процедура СоздатьПустойФайл(ПолныйПуть)
	Запись = Новый ЗаписьТекста(ПолныйПуть, КодировкаТекста.UTF8);
	Запись.Закрыть();
КонецПроцедуры

// Записать минимальный Configuration.xml расширения (с маркером ConfigurationExtensionPurpose),
// чтобы каталог распознавался рекурсивным поиском именно как расширение, а не конфигурация.
Процедура ЗаписатьКонфигурациюРасширения(КаталогРасширения)
	Строки = Новый Массив;
	Строки.Добавить("<?xml version=""1.0"" encoding=""UTF-8""?>");
	Строки.Добавить("<MetaDataObject><Configuration><Properties>");
	Строки.Добавить("<ConfigurationExtensionPurpose>Customization</ConfigurationExtensionPurpose>");
	Строки.Добавить("</Properties></Configuration></MetaDataObject>");
	Запись = Новый ЗаписьТекста(ОбъединитьПути(КаталогРасширения, "Configuration.xml"), КодировкаТекста.UTF8);
	Запись.ЗаписатьСтроку(СтрСоединить(Строки, Символы.ПС));
	Запись.Закрыть();
КонецПроцедуры

// Собрать .cfe-файл из XML-фикстуры расширения "cfe" во временном каталоге.
// Имя .cfe-файла (без расширения) задаёт имя расширения при последующей загрузке.
Функция СобратьCfeВФайл(Режим, ИмяБезРасширения)
	Аргументы = Новый Массив;
	Аргументы.Добавить("cfe");
	Аргументы.Добавить("compile");
	Исполнитель = Новый ИсполнительCLI(Аргументы);
	Исполнитель.ДобавитьОпцию("--src", Исполнитель.ПутьФикстуры("cfe"));
	Исполнитель.ДобавитьОпцию("--extension-name", ИмяБезРасширения);
	ДобавитьФлагРежима(Исполнитель, Режим);
	ПутьCfe = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), ИмяБезРасширения + ".cfe");
	Исполнитель.ДобавитьАргумент(ПутьCfe);
	Исполнитель.ВыполнитьКоманду();
	Возврат ПутьCfe;
КонецФункции

#КонецОбласти
