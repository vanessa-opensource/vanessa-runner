// BSLLS-off
// Тестовый набор: infobase extensions create / delete / list
// Интеграционные тесты управления установленными расширениями через CLI.
//
// Команды запускаются против файловой ИБ (фикстура пустой базы):
//   - create  - создаёт пустое расширение конфигуратором (генерация минимальных исходников);
//   - list    - выводит имена (или таблицу с --verbose) в режиме 1С:Предприятие;
//   - delete  - удаляет расширение по имени в режиме 1С:Предприятие.
//
// Фикстуры: tests/e2e/fixtures/empty-ib/1Cv8.1CD

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands
#Использовать "../../utils"

Перем НакопленныеВременныеФайлы;
Перем КаталогБазы;
Перем ИмяРасширения;

#Область СлужебныйПрограммныйИнтерфейс

// create создаёт пустое расширение, которое затем видно в списке.
&Тест
Процедура ТестДолжен_СоздатьРасширениеИВывестиВСписке() Экспорт

	СоздатьРасширение(ИмяРасширения);

	Список = СоздатьИсполнителя("list");
	Список.ДобавитьОпцию("--ibconnection", СтрокаПодключения());
	Список.ВыполнитьКоманду();

	Список.ОжидаемЧтоКодВозврата(0, "список расширений");
	Список.ОжидаемЧтоВыводСодержит(ИмяРасширения);

КонецПроцедуры

// Повторное создание существующего расширения без --overwrite завершается ошибкой.
&Тест
Процедура ТестДолжен_ВернутьОшибкуПриСозданииСуществующегоБезOverwrite() Экспорт

	СоздатьРасширение(ИмяРасширения);

	Повтор = СоздатьИсполнителя("create");
	Повтор.ДобавитьОпцию("--ibconnection", СтрокаПодключения());
	Повтор.ДобавитьАргумент(ИмяРасширения);
	КодВозврата = Повтор.ВыполнитьКоманду();

	Ожидаем.Что(КодВозврата, "Повторное создание без --overwrite должно упасть").Не_().Равно(0);
	Повтор.ОжидаемЧтоВыводСодержит("уже существует");

КонецПроцедуры

// С флагом --overwrite существующее расширение пересоздаётся без ошибки.
&Тест
Процедура ТестДолжен_ПересоздатьСуществующееСOverwrite() Экспорт

	СоздатьРасширение(ИмяРасширения);

	Повтор = СоздатьИсполнителя("create");
	Повтор.ДобавитьФлаг("--overwrite");
	Повтор.ДобавитьОпцию("--ibconnection", СтрокаПодключения());
	Повтор.ДобавитьАргумент(ИмяРасширения);
	Повтор.ВыполнитьКоманду();

	Повтор.ОжидаемЧтоКодВозврата(0, "пересоздание расширения с --overwrite");

КонецПроцедуры

// delete удаляет расширение; после удаления его нет в списке.
&Тест
Процедура ТестДолжен_УдалитьРасширение() Экспорт

	СоздатьРасширение(ИмяРасширения);

	Удаление = СоздатьИсполнителя("delete");
	Удаление.ДобавитьОпцию("--ibconnection", СтрокаПодключения());
	Удаление.ДобавитьАргумент(ИмяРасширения);
	Удаление.ВыполнитьКоманду();
	Удаление.ОжидаемЧтоКодВозврата(0, "удаление расширения");

	Список = СоздатьИсполнителя("list");
	Список.ДобавитьОпцию("--ibconnection", СтрокаПодключения());
	Список.ВыполнитьКоманду();
	Список.ОжидаемЧтоКодВозврата(0, "список после удаления");
	Список.ОжидаемЧтоВыводНеСодержит(ИмяРасширения);

КонецПроцедуры

// Удаление несуществующего расширения завершается ошибкой.
&Тест
Процедура ТестДолжен_ВернутьОшибкуПриУдаленииНесуществующего() Экспорт

	Удаление = СоздатьИсполнителя("delete");
	Удаление.ДобавитьОпцию("--ibconnection", СтрокаПодключения());
	Удаление.ДобавитьАргумент("НесуществующееРасширение");
	КодВозврата = Удаление.ВыполнитьКоманду();

	Ожидаем.Что(КодВозврата, "Удаление несуществующего расширения должно упасть").Не_().Равно(0);
	Удаление.ОжидаемЧтоВыводСодержит("не найдено");

КонецПроцедуры

// list --verbose выводит таблицу с заголовком и строкой расширения.
&Тест
Процедура ТестДолжен_ВывестиПодробныйСписокТаблицей() Экспорт

	СоздатьРасширение(ИмяРасширения);

	Список = СоздатьИсполнителя("list");
	Список.ДобавитьФлаг("-v");
	Список.ДобавитьОпцию("--ibconnection", СтрокаПодключения());
	Список.ВыполнитьКоманду();

	Список.ОжидаемЧтоКодВозврата(0, "подробный список расширений");
	Список.ОжидаемЧтоВыводСодержит("Безопасный режим");
	Список.ОжидаемЧтоВыводСодержит(ИмяРасширения);

КонецПроцедуры

// set-options меняет активность расширения (и только её).
&Тест
Процедура ТестДолжен_ИзменитьАктивностьЧерезSetOptions() Экспорт

	СоздатьРасширение(ИмяРасширения);

	Настройка = СоздатьИсполнителя("set-options");
	Настройка.ДобавитьОпцию("--active", "false");
	Настройка.ДобавитьОпцию("--ibconnection", СтрокаПодключения());
	Настройка.ДобавитьАргумент(ИмяРасширения);
	Настройка.ВыполнитьКоманду();

	Настройка.ОжидаемЧтоКодВозврата(0, "изменение активности расширения");
	Настройка.ОжидаемЧтоВыводСодержит("неактивно");

КонецПроцедуры

// На базе без расширений list сообщает, что их нет.
&Тест
Процедура ТестДолжен_СообщитьЧтоРасширенийНет() Экспорт

	Список = СоздатьИсполнителя("list");
	Список.ДобавитьОпцию("--ibconnection", СтрокаПодключения());
	Список.ВыполнитьКоманду();

	Список.ОжидаемЧтоКодВозврата(0, "список на пустой базе");
	Список.ОжидаемЧтоВыводСодержит("Установленных расширений нет");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
	ИмяРасширения = "test_ext";
	КаталогБазы = ФикстурнаяФайловаяБД.СкопироватьВоВременнойКаталог();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсполнителя(Знач ИмяПодкоманды)
	Аргументы = Новый Массив;
	Аргументы.Добавить("infobase");
	Аргументы.Добавить("extensions");
	Аргументы.Добавить(ИмяПодкоманды);
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

Функция СтрокаПодключения()
	Возврат "/F""" + КаталогБазы + """";
КонецФункции

Процедура СоздатьРасширение(Знач Имя)
	Создать = СоздатьИсполнителя("create");
	Создать.ДобавитьОпцию("--ibconnection", СтрокаПодключения());
	Создать.ДобавитьАргумент(Имя);
	Создать.ВыполнитьКоманду();
	Создать.ОжидаемЧтоКодВозврата(0, "создание пустого расширения (подготовка теста)");
КонецПроцедуры

#КонецОбласти
