// BSLLS-off
// Тестовый набор: infobase dump-dt / restore-dt
// Интеграционные тесты выгрузки и загрузки информационной базы в формат DT.
//
// Тесты запускают реальные CLI-команды `vrunner infobase dump-dt` и `vrunner infobase restore-dt` через подпроцесс.
// Базовые сценарии параметризованы по режиму (ibcmd / конфигуратор).
//
// Фикстуры: tests/e2e/fixtures/cf/ - XML-исходники конфигурации

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands
#Использовать v8runner
#Использовать "../../utils"

Перем НакопленныеВременныеФайлы;

#Область СлужебныйПрограммныйИнтерфейс

// Выгрузка информационной базы в DT-файл.
&ПараметризованныйТест
&ИсточникЗначение("ibcmd")
&ИсточникЗначение("designer")
Процедура ТестДолжен_ВыгрузитьБазуВФайлDT(Режим) Экспорт

	// Дано - создать базу
	ИсполнительInit = СоздатьИсполнителяInit();
	ДобавитьФлагРежима(ИсполнительInit, Режим);
	ИсполнительInit.ВыполнитьКоманду();
	ИсполнительInit.ОжидаемЧтоКодВозврата(0, "инициализация ИБ (подготовка теста)");

	// Дано - параметры подключения для dump-dt
	КаталогБазы = ОбъединитьПути(ИсполнительInit.КаталогРаботы(), "build", "ib");
	СтрокаПодключения = "/F""" + КаталогБазы + """";

	// Когда - выгрузить в DT
	Исполнитель = СоздатьИсполнителяDumpDt();
	Исполнитель.УстановитьКаталогРаботы(ИсполнительInit.КаталогРаботы());
	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	ДобавитьФлагРежима(Исполнитель, Режим);
	Исполнитель.ДобавитьАргумент("backup.dt");
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "выгрузка ИБ в DT-файл");
	Исполнитель.ОжидаемЧтоФайлСуществует("backup.dt");

КонецПроцедуры

// Полный цикл: создать базу → выгрузить DT → восстановить в новую базу.
&ПараметризованныйТест
&ИсточникЗначение("ibcmd")
&ИсточникЗначение("designer")
Процедура ТестДолжен_ВосстановитьБазуИзФайлаDT(Режим) Экспорт

	// Дано - создать базу
	ИсполнительInit = СоздатьИсполнителяInit();
	ДобавитьФлагРежима(ИсполнительInit, Режим);
	ИсполнительInit.ВыполнитьКоманду();
	ИсполнительInit.ОжидаемЧтоКодВозврата(0, "инициализация ИБ (подготовка теста)");

	КаталогБазы = ОбъединитьПути(ИсполнительInit.КаталогРаботы(), "build", "ib");
	СтрокаПодключения = "/F""" + КаталогБазы + """";

	// Дано - выгрузить базу в DT
	ИсполнительDump = СоздатьИсполнителяDumpDt();
	ИсполнительDump.УстановитьКаталогРаботы(ИсполнительInit.КаталогРаботы());
	ИсполнительDump.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	ДобавитьФлагРежима(ИсполнительDump, Режим);
	ИсполнительDump.ДобавитьАргумент("backup.dt");
	ИсполнительDump.ВыполнитьКоманду();
	ИсполнительDump.ОжидаемЧтоКодВозврата(0, "выгрузка ИБ в DT-файл (подготовка восстановления)");

	ПутьКDT = ОбъединитьПути(ИсполнительInit.КаталогРаботы(), "backup.dt");

	// Дано - создать новую базу для восстановления
	ИсполнительInit2 = СоздатьИсполнителяInit();
	ДобавитьФлагРежима(ИсполнительInit2, Режим);
	ИсполнительInit2.ВыполнитьКоманду();
	ИсполнительInit2.ОжидаемЧтоКодВозврата(0, "инициализация второй ИБ (подготовка теста)");

	КаталогБазы2 = ОбъединитьПути(ИсполнительInit2.КаталогРаботы(), "build", "ib");
	СтрокаПодключения2 = "/F""" + КаталогБазы2 + """";

	// Когда - восстановить из DT
	Исполнитель = СоздатьИсполнителяRestoreDt();
	Исполнитель.УстановитьКаталогРаботы(ИсполнительInit2.КаталогРаботы());
	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения2);
	ДобавитьФлагРежима(Исполнитель, Режим);
	Исполнитель.ДобавитьАргумент(ПутьКDT);
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "восстановление ИБ из DT-файла");

КонецПроцедуры

// Ошибка при отсутствии аргумента OUT для dump-dt.
&Тест
Процедура ТестДолжен_ВернутьОшибкуЕслиНеУказанПутьDT_Dump() Экспорт

	// Дано - создать базу
	ИсполнительInit = СоздатьИсполнителяInit();
	ИсполнительInit.ВыполнитьКоманду();
	ИсполнительInit.ОжидаемЧтоКодВозврата(0, "инициализация ИБ (подготовка теста)");

	КаталогБазы = ОбъединитьПути(ИсполнительInit.КаталогРаботы(), "build", "ib");
	СтрокаПодключения = "/F""" + КаталогБазы + """";

	// Дано (без аргумента OUT)
	Исполнитель = СоздатьИсполнителяDumpDt();
	Исполнитель.УстановитьКаталогРаботы(ИсполнительInit.КаталогРаботы());
	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения);

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Ожидаем.Что(Исполнитель.КодВозврата(), "Код возврата должен быть != 0").Не_().Равно(0);

КонецПроцедуры

// Ошибка при восстановлении из несуществующего файла DT.
&Тест
Процедура ТестДолжен_ВернутьОшибкуЕслиФайлDTНеСуществует() Экспорт

	// Дано - создать базу
	ИсполнительInit = СоздатьИсполнителяInit();
	ИсполнительInit.ВыполнитьКоманду();
	ИсполнительInit.ОжидаемЧтоКодВозврата(0, "инициализация ИБ (подготовка теста)");

	КаталогБазы = ОбъединитьПути(ИсполнительInit.КаталогРаботы(), "build", "ib");
	СтрокаПодключения = "/F""" + КаталогБазы + """";

	// Дано
	Исполнитель = СоздатьИсполнителяRestoreDt();
	Исполнитель.УстановитьКаталогРаботы(ИсполнительInit.КаталогРаботы());
	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Исполнитель.ДобавитьАргумент("nonexistent.dt");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Ожидаем.Что(Исполнитель.КодВозврата(), "Код возврата должен быть != 0").Не_().Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсполнителяInit()
	Аргументы = Новый Массив;
	Аргументы.Добавить("infobase");
	Аргументы.Добавить("init");
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

Функция СоздатьИсполнителяDumpDt()
	Аргументы = Новый Массив;
	Аргументы.Добавить("infobase");
	Аргументы.Добавить("dump-dt");
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

Функция СоздатьИсполнителяRestoreDt()
	Аргументы = Новый Массив;
	Аргументы.Добавить("infobase");
	Аргументы.Добавить("restore-dt");
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

Процедура ДобавитьФлагРежима(Исполнитель, Режим)
	Если Режим = "ibcmd" Тогда
		Исполнитель.ДобавитьФлаг("--ibcmd");
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
