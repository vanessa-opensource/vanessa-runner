// BSLLS-off
// Тестовый набор: infobase update
// Интеграционные тесты обновления информационной базы.
//
// Тесты запускают реальные CLI-команды `vrunner infobase init` и `vrunner infobase update` через подпроцесс.
// Базовые сценарии параметризованы по режиму (ibcmd / конфигуратор).
//
// Фикстуры: tests/e2e/fixtures/cf/ - XML-исходники конфигурации

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands
#Использовать v8runner
#Использовать "../../utils"

Перем НакопленныеВременныеФайлы;
Перем ОбщийКаталогРаботы;

#Область СлужебныйПрограммныйИнтерфейс

// Обновление базы из исходников.
// Сначала создаём пустую базу, затем обновляем из исходников.
&ПараметризованныйТест
&ИсточникЗначение("ibcmd")
&ИсточникЗначение("designer")
Процедура ТестДолжен_ОбновитьБазуИзИсходников(Режим) Экспорт

	// Дано - создать базу
	ИсполнительInit = СоздатьИсполнителяInit();
	ДобавитьФлагРежима(ИсполнительInit, Режим);
	ИсполнительInit.ВыполнитьКоманду();
	ИсполнительInit.ОжидаемЧтоКодВозврата(0, "инициализация ИБ (подготовка теста)");

	// Дано - обновить из исходников
	Исполнитель = СоздатьИсполнителяUpdate();
	Исполнитель.УстановитьКаталогРаботы(ИсполнительInit.КаталогРаботы());
	КаталогSrc = Исполнитель.ПутьФикстуры("cf");
	Исполнитель.ДобавитьОпцию("--source", КаталогSrc);
	ДобавитьФлагРежима(Исполнитель, Режим);

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "обновление ИБ из исходников");

КонецПроцедуры

// Обновление базы из cf-файла.
&ПараметризованныйТест
&ИсточникЗначение("ibcmd")
&ИсточникЗначение("designer")
Процедура ТестДолжен_ОбновитьБазуИзФайлаCf(Режим) Экспорт

	// Дано - собрать cf
	ИсполнительCf = СоздатьИсполнителяCfCompile();
	КаталогSrc = ИсполнительCf.ПутьФикстуры("cf");
	ИсполнительCf.ДобавитьОпцию("--src", КаталогSrc);
	ДобавитьФлагРежима(ИсполнительCf, Режим);
	ИсполнительCf.ДобавитьАргумент("1Cv8.cf");
	ИсполнительCf.ВыполнитьКоманду();
	ИсполнительCf.ОжидаемЧтоКодВозврата(0, "загрузка CF-файла в базу (подготовка теста)");

	ПутьКCf = ОбъединитьПути(ИсполнительCf.КаталогРаботы(), "1Cv8.cf");

	// Дано - создать базу
	ИсполнительInit = СоздатьИсполнителяInit();
	ДобавитьФлагРежима(ИсполнительInit, Режим);
	ИсполнительInit.ВыполнитьКоманду();
	ИсполнительInit.ОжидаемЧтоКодВозврата(0, "инициализация ИБ (подготовка теста)");

	// Дано - обновить из cf
	Исполнитель = СоздатьИсполнителяUpdate();
	Исполнитель.УстановитьКаталогРаботы(ИсполнительInit.КаталогРаботы());
	Исполнитель.ДобавитьОпцию("--source", ПутьКCf);
	ДобавитьФлагРежима(Исполнитель, Режим);

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "обновление ИБ из CF-файла");

КонецПроцедуры

// Обновление базы без указания источника (только обновление конфигурации БД).
&ПараметризованныйТест
&ИсточникЗначение("ibcmd")
&ИсточникЗначение("designer")
Процедура ТестДолжен_ОбновитьБазуБезИсточника(Режим) Экспорт

	// Дано - создать базу с конфигурацией
	ИсполнительInit = СоздатьИсполнителяInit();
	КаталогSrc = ИсполнительInit.ПутьФикстуры("cf");
	ИсполнительInit.ДобавитьОпцию("--source", КаталогSrc);
	ДобавитьФлагРежима(ИсполнительInit, Режим);
	ИсполнительInit.ВыполнитьКоманду();
	ИсполнительInit.ОжидаемЧтоКодВозврата(0, "инициализация ИБ (подготовка теста)");

	// Дано - обновить без источника
	Исполнитель = СоздатьИсполнителяUpdate();
	Исполнитель.УстановитьКаталогРаботы(ИсполнительInit.КаталогРаботы());
	ДобавитьФлагРежима(Исполнитель, Режим);

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "обновление ИБ без явного источника");

КонецПроцедуры

// Обновление с указанием цели --target main.
&Тест
Процедура ТестДолжен_ОбновитьБазуСЦельюMain() Экспорт

	// Дано - создать базу с конфигурацией
	ИсполнительInit = СоздатьИсполнителяInit();
	КаталогSrc = ИсполнительInit.ПутьФикстуры("cf");
	ИсполнительInit.ДобавитьОпцию("--source", КаталогSrc);
	ИсполнительInit.ДобавитьФлаг("--ibcmd");
	ИсполнительInit.ВыполнитьКоманду();
	ИсполнительInit.ОжидаемЧтоКодВозврата(0, "инициализация ИБ (подготовка теста)");

	// Дано - обновить с target main
	Исполнитель = СоздатьИсполнителяUpdate();
	Исполнитель.УстановитьКаталогРаботы(ИсполнительInit.КаталогРаботы());
	КаталогSrc2 = Исполнитель.ПутьФикстуры("cf");
	Исполнитель.ДобавитьОпцию("--source", КаталогSrc2);
	Исполнитель.ДобавитьОпцию("--target", "main");
	Исполнитель.ДобавитьФлаг("--ibcmd");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "обновление ИБ с целью main");

КонецПроцедуры

// Обновление несуществующей базы должно вернуть ошибку.
&Тест
Процедура ТестДолжен_ВернутьОшибкуПриОбновленииНесуществующейБазы() Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителяUpdate();
	КаталогБазы = ОбъединитьПути(Исполнитель.КаталогРаботы(), "nonexistent-db");
	СтрокаПодключения = "/F""" + КаталогБазы + """";
	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения);

	// Когда
	КодВозврата = Исполнитель.ВыполнитьКоманду();

	// Тогда
	Ожидаем.Что(КодВозврата, "Код возврата должен быть != 0").Не_().Равно(0);

КонецПроцедуры

// Обновление без таргета обновляет основную конфигурацию и все расширения.
// При отсутствии --target команда должна последовательно вызвать обновление
// основной конфигурации, а затем - все расширения по списку.
//   - Конфигуратор: используется нативный флаг -AllExtensions.
//   - ibcmd: внутри движка получается список расширений и обновляется по очереди.
&ПараметризованныйТест
&ИсточникЗначение("ibcmd")
&ИсточникЗначение("designer")
Процедура ТестДолжен_ОбновитьОсновнуюКонфИВсеРасширенияПриОтсутствииТаргета(Режим) Экспорт

	// Дано - создать базу с конфигурацией
	ИсполнительInit = СоздатьИсполнителяInit();
	КаталогSrc = ИсполнительInit.ПутьФикстуры("cf");
	ИсполнительInit.ДобавитьОпцию("--source", КаталогSrc);
	ДобавитьФлагРежима(ИсполнительInit, Режим);
	ИсполнительInit.ВыполнитьКоманду();
	ИсполнительInit.ОжидаемЧтоКодВозврата(0, "инициализация ИБ (подготовка теста)");

	КаталогРаботы = ИсполнительInit.КаталогРаботы();
	СтрокаПодключения = "/F""" + ОбъединитьПути(КаталогРаботы, "build", "ib") + """";

	// Дано - загрузить расширение в базу
	ИсполнительCfeLoad = СоздатьИсполнителяCfeLoad();
	ИсполнительCfeLoad.УстановитьКаталогРаботы(КаталогРаботы);
	КаталогCfeSrc = ИсполнительCfeLoad.ПутьФикстуры("cfe");
	ИсполнительCfeLoad.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	ИсполнительCfeLoad.ДобавитьОпцию("--extension-name", "test");
	// Только загрузка: применение к БД сделает проверяемый infobase update (основная конфигурация +
	// расширения вместе). Раздельное применение здесь упало бы на несовпадении РежимСовместимости.
	ИсполнительCfeLoad.ДобавитьФлаг("--no-update-db");
	ИсполнительCfeLoad.ДобавитьАргумент(КаталогCfeSrc);
	ИсполнительCfeLoad.ВыполнитьКоманду();
	ИсполнительCfeLoad.ОжидаемЧтоКодВозврата(0, "загрузка CFE-расширения (подготовка теста)");

	// Дано - обновить без таргета (должно обновить основную конфигурацию + все расширения)
	Исполнитель = СоздатьИсполнителяUpdate();
	Исполнитель.УстановитьКаталогРаботы(КаталогРаботы);
	ДобавитьФлагРежима(Исполнитель, Режим);

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "обновление конфигурации и расширений без явного таргета");
	// Должны быть пройдены обе фазы: основная конфигурация и все расширения.
	Исполнитель.ОжидаемЧтоВыводСодержит("Обновление основной конфигурации БД");
	Исполнитель.ОжидаемЧтоВыводСодержит("Обновление всех расширений БД");
	Исполнитель.ОжидаемЧтоВыводСодержит("Обновление информационной базы завершено");
	// Признаки реальной итерации по списку расширений (для ibcmd движок логирует имена).
	Если Режим = "ibcmd" Тогда
		Исполнитель.ОжидаемЧтоВыводСодержит("Обновление расширений через ibcmd: найдено");
		Исполнитель.ОжидаемЧтоВыводСодержит("Обновление расширения 'test' через ibcmd");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
	ОбщийКаталогРаботы = ВременныеФайлы.СоздатьКаталог();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсполнителяInit()
	Аргументы = Новый Массив;
	Аргументы.Добавить("infobase");
	Аргументы.Добавить("init");
	Исполнитель = Новый ИсполнительCLI(Аргументы);
	Возврат Исполнитель;
КонецФункции

Функция СоздатьИсполнителяUpdate()
	Аргументы = Новый Массив;
	Аргументы.Добавить("infobase");
	Аргументы.Добавить("update");
	Исполнитель = Новый ИсполнительCLI(Аргументы);
	Возврат Исполнитель;
КонецФункции

Функция СоздатьИсполнителяCfCompile()
	Аргументы = Новый Массив;
	Аргументы.Добавить("cf");
	Аргументы.Добавить("compile");
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

Функция СоздатьИсполнителяCfeLoad()
	Аргументы = Новый Массив;
	Аргументы.Добавить("cfe");
	Аргументы.Добавить("load");
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

Процедура ДобавитьФлагРежима(Исполнитель, Режим)
	Если Режим = "ibcmd" Тогда
		Исполнитель.ДобавитьФлаг("--ibcmd");
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
