// BSLLS-off
// Тестовый набор: infobase create-user
// Интеграционные тесты создания первого пользователя-администратора.
//
// Тесты запускают реальные CLI-команды `vrunner infobase init` и
// `vrunner infobase create-user` через подпроцесс.
//
// Команда выполняет встроенную обработку в режиме 1С:Предприятие
// (через конфигуратор), поэтому режим ibcmd здесь неприменим.
//
// Регрессии:
//   1) При пустой строке подключения команда уходила во временную базу
//      платформы (v8r_TempDB) вместо build/ib и ложно сообщала об успехе.
//   2) При аварийном завершении платформы (код возврата <> 0) команда всё
//      равно сообщала об успехе, так как игнорировала код возврата процесса.
//
// Фикстуры: tests/e2e/fixtures/cf/ - XML-исходники конфигурации

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands
#Использовать v8runner
#Использовать "../../utils"

Перем НакопленныеВременныеФайлы;

#Область СлужебныйПрограммныйИнтерфейс

// Создание первого пользователя-администратора в файловой базе build/ib.
// Проверяет, что команда подключается к реальной базе (а не к v8r_TempDB)
// и фактически создаёт пользователя.
&Тест
Процедура ТестДолжен_СоздатьПользователяАдминистратора() Экспорт

	// Дано - создать базу с конфигурацией
	ИсполнительInit = СоздатьИсполнителяInit();
	КаталогSrc = ИсполнительInit.ПутьФикстуры("cf");
	ИсполнительInit.ДобавитьОпцию("--source", КаталогSrc);
	ИсполнительInit.ВыполнитьКоманду();
	ИсполнительInit.ОжидаемЧтоКодВозврата(0, "инициализация ИБ (подготовка теста)");

	// Когда - создать пользователя-администратора
	Исполнитель = СоздатьИсполнителяCreateUser("admin");
	Исполнитель.УстановитьКаталогРаботы(ИсполнительInit.КаталогРаботы());
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "создание пользователя-администратора");
	// Регрессия 1: команда не должна уходить во временную базу платформы
	Исполнитель.ОжидаемЧтоВыводНеСодержит("v8r_TempDB");
	// Обработка реально отработала и сообщила о создании пользователя
	Исполнитель.ОжидаемЧтоВыводСодержит("admin создан");

КонецПроцедуры

// Регрессия 2: повторный запуск без учётных данных против базы, которая уже
// требует аутентификацию, должен ЗАВЕРШИТЬСЯ ОШИБКОЙ, а не ложным успехом.
// Это одновременно доказывает, что первый запуск реально записал пользователя
// в build/ib (иначе аутентификация бы не потребовалась).
&Тест
Процедура ТестДолжен_НеЛожноСообщатьОбУспехеПриПовторномЗапускеБезУчётки() Экспорт

	// Дано - создать базу с конфигурацией
	ИсполнительInit = СоздатьИсполнителяInit();
	КаталогSrc = ИсполнительInit.ПутьФикстуры("cf");
	ИсполнительInit.ДобавитьОпцию("--source", КаталогSrc);
	ИсполнительInit.ВыполнитьКоманду();
	ИсполнительInit.ОжидаемЧтоКодВозврата(0, "инициализация ИБ (подготовка теста)");

	КаталогРаботы = ИсполнительInit.КаталогРаботы();

	// Дано - первый администратор создан
	ИсполнительПервый = СоздатьИсполнителяCreateUser("admin");
	ИсполнительПервый.УстановитьКаталогРаботы(КаталогРаботы);
	ИсполнительПервый.ВыполнитьКоманду();
	ИсполнительПервый.ОжидаемЧтоКодВозврата(0, "создание первого администратора (подготовка теста)");

	// Когда - повторный запуск без учётных данных (база уже требует аутентификацию)
	ИсполнительВторой = СоздатьИсполнителяCreateUser("admin2");
	ИсполнительВторой.УстановитьКаталогРаботы(КаталогРаботы);
	КодВозврата = ИсполнительВторой.ВыполнитьКоманду();

	// Тогда - команда обязана упасть, а не сообщать о ложном успехе
	Ожидаем.Что(КодВозврата, "Повторный запуск без учётки должен завершиться ошибкой").Не_().Равно(0);
	ИсполнительВторой.ОжидаемЧтоВыводНеСодержит("admin2 создан");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсполнителяInit()
	Аргументы = Новый Массив;
	Аргументы.Добавить("infobase");
	Аргументы.Добавить("init");
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

Функция СоздатьИсполнителяCreateUser(Знач ИмяПользователя)
	Аргументы = Новый Массив;
	Аргументы.Добавить("infobase");
	Аргументы.Добавить("create-user");
	Аргументы.Добавить(ИмяПользователя);
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

#КонецОбласти
