// BSLLS-off
// Тестовый набор: opm build
// Интеграционный тест полной сборки пакета vanessa-runner через opm.
//
// Тест запускает реальную команду `opm build` в корне проекта.
// Хук `ПередСборкой` в packagedef выполняет:
//   1. opm install --dev    — установка локальных зависимостей
//   2. oscript src/main.os epf compile -R epf — сборка внешних обработок
//
// Затем opm создаёт .ospx-архив в корне проекта.

#Использовать asserts
#Использовать 1commands

Перем КорневойКаталогПроекта;
Перем ВремяСтартаТеста;

#Область СлужебныйПрограммныйИнтерфейс

// Полная сборка пакета: opm install --dev + epf compile + сборка ospx.
&Тест
Процедура ТестДолжен_СобратьПакетКомандойOpmBuild() Экспорт

	// Дано
	Команда = Новый Команда;
	Команда.УстановитьКоманду("opm");
	Команда.ДобавитьПараметр("build");
	Команда.УстановитьРабочийКаталог(КорневойКаталогПроекта);
	Команда.ПоказыватьВыводНемедленно(Истина);

	// Когда
	КодВозврата = Команда.Исполнить();
	Вывод = Команда.ПолучитьВывод();

	// Тогда
	Сообщение = СтрШаблон("opm build должен завершиться успешно. Код: %1. Вывод:%2%3",
		КодВозврата, Символы.ПС, Вывод);
	Ожидаем.Что(КодВозврата, Сообщение).Равно(0);

	АрхивыПослеСборки = НайтиАрхивыOspx(КорневойКаталогПроекта);
	СвежийАрхив = ПерваяСвежаяСборка(АрхивыПослеСборки, ВремяСтартаТеста);
	Сообщение = СтрШаблон("После opm build должен появиться/обновиться .ospx (mtime >= %1). Найдено: %2",
		ВремяСтартаТеста, АрхивыПослеСборки.Количество());
	Ожидаем.Что(ЗначениеЗаполнено(СвежийАрхив), Сообщение).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	КорневойКаталогПроекта = ТекущийКаталог();
	// -1 секунда — запас под гранулярность mtime файловой системы.
	ВремяСтартаТеста = ТекущаяДата() - 1;
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	// Удаляем только архивы, появившиеся/обновлённые в ходе текущего теста.
	Для Каждого Архив Из НайтиАрхивыOspx(КорневойКаталогПроекта) Цикл
		Файл = Новый Файл(Архив);
		Если Файл.Существует() И Файл.ПолучитьВремяИзменения() >= ВремяСтартаТеста Тогда
			УдалитьФайлы(Архив);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НайтиАрхивыOspx(Каталог)
	Результат = Новый Массив;
	Для Каждого Файл Из НайтиФайлы(Каталог, "*.ospx", Ложь) Цикл
		Если Файл.ЭтоФайл() Тогда
			Результат.Добавить(Файл.ПолноеИмя);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ПерваяСвежаяСборка(СписокАрхивов, ПорогВремени)
	Для Каждого Путь Из СписокАрхивов Цикл
		Файл = Новый Файл(Путь);
		Если Файл.Существует() И Файл.ПолучитьВремяИзменения() >= ПорогВремени Тогда
			Возврат Путь;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

#КонецОбласти
