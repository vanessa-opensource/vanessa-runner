// BSLLS-off
// Тестовый набор: cfe load
// Интеграционные тесты загрузки расширения в базу.
//
// Фикстуры: tests/e2e/fixtures/cfe/ - XML-исходники расширения

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands
#Использовать "../../utils"

Перем НакопленныеВременныеФайлы;

Перем КаталогБазы;
Перем ИмяРасширения;

#Область СлужебныйПрограммныйИнтерфейс

// Загрузка расширения из XML-исходников в существующую базу.
// Прогоняется дважды: с ibcmd и через конфигуратор.
&ПараметризованныйТест
&ИсточникЗначение("ibcmd")
&ИсточникЗначение("designer")
Процедура ТестДолжен_ЗагрузитьРасширениеИзИсходниковВБазу(Режим) Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителя();
	КаталогSrc = Исполнитель.ПутьФикстуры("cfe");
	СтрокаПодключения = СтрокаПодключенияДляРежима(КаталогБазы, Режим);
	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Исполнитель.ДобавитьОпцию("--extension-name", ИмяРасширения);
	ДобавитьФлагРежима(Исполнитель, Режим);
	Исполнитель.ДобавитьФлаг("--no-update-db"); // тест загрузки: применение к БД не проверяем
	Исполнитель.ДобавитьАргумент(КаталогSrc);

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "загрузка расширения из исходников в базу");

КонецПроцедуры

// Имя расширения с ведущим подчёркиванием (например, _ДемоРасширение) - валидное имя 1С.
// Регрессия #709: проверка имени не должна отклонять ведущий "_".
&ПараметризованныйТест
&ИсточникЗначение("ibcmd")
&ИсточникЗначение("designer")
Процедура ТестДолжен_ЗагрузитьРасширениеСВедущимПодчёркиванием(Режим) Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителя();
	КаталогSrc = Исполнитель.ПутьФикстуры("cfe");
	СтрокаПодключения = СтрокаПодключенияДляРежима(КаталогБазы, Режим);
	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Исполнитель.ДобавитьОпцию("--extension-name", "_ДемоРасширение");
	ДобавитьФлагРежима(Исполнитель, Режим);
	Исполнитель.ДобавитьФлаг("--no-update-db"); // тест загрузки: применение к БД не проверяем
	Исполнитель.ДобавитьАргумент(КаталогSrc);

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "загрузка расширения с именем, начинающимся с подчёркивания");
	Исполнитель.ОжидаемЧтоВыводНеСодержит("Неверное имя!");

КонецПроцедуры

// Прямая загрузка движком перезаписывает уже установленное расширение молча:
// повторная загрузка без каких-либо флагов завершается успешно.
&Тест
Процедура ТестДолжен_ПерезагрузитьРасширениеБезОшибки() Экспорт

	Режим = "designer";
	КаталогSrc = СоздатьИсполнителя().ПутьФикстуры("cfe");
	СтрокаПодключения = СтрокаПодключенияДляРежима(КаталогБазы, Режим);

	// Дано - расширение уже загружено
	Первый = СоздатьИсполнителя();
	Первый.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Первый.ДобавитьОпцию("--extension-name", ИмяРасширения);
	Первый.ДобавитьФлаг("--no-update-db"); // тест перезагрузки: применение к БД не проверяем
	Первый.ДобавитьАргумент(КаталогSrc);
	Первый.ВыполнитьКоманду();
	Первый.ОжидаемЧтоКодВозврата(0, "первичная загрузка расширения");

	// Когда - повторная загрузка без флагов свойств
	Второй = СоздатьИсполнителя();
	Второй.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Второй.ДобавитьОпцию("--extension-name", ИмяРасширения);
	Второй.ДобавитьФлаг("--no-update-db");
	Второй.ДобавитьАргумент(КаталогSrc);
	Второй.ВыполнитьКоманду();

	// Тогда - перезагрузка успешна (расширение перезаписано)
	Второй.ОжидаемЧтоКодВозврата(0, "повторная загрузка расширения перезаписывает молча");

КонецПроцедуры

// Загрузка расширения из .cfe-файла в существующую базу.
// Прогоняется дважды: с ibcmd и через конфигуратор.
&ПараметризованныйТест
&ИсточникЗначение("ibcmd")
&ИсточникЗначение("designer")
Процедура ТестДолжен_ЗагрузитьРасширениеИзФайлаCfe(Режим) Экспорт

	// Дано
	ФайлCfe = СобратьCfeИзФикстур(Режим);

	Исполнитель = СоздатьИсполнителя();
	СтрокаПодключения = СтрокаПодключенияДляРежима(КаталогБазы, Режим);
	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Исполнитель.ДобавитьОпцию("--extension-name", ИмяРасширения);
	ДобавитьФлагРежима(Исполнитель, Режим);
	Исполнитель.ДобавитьФлаг("--no-update-db"); // тест загрузки: применение к БД не проверяем
	Исполнитель.ДобавитьАргумент(ФайлCfe);

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "загрузка расширения из CFE-файла в базу");

КонецПроцедуры

// Инкрементальная загрузка поддерживается только в режиме ibcmd.
// Для режима 1С:Предприятие выполняется полная загрузка с предупреждением.
&Тест
Процедура ТестДолжен_ПоддерживатьИнкрементальнуюЗагрузку() Экспорт

	Режим = "ibcmd";

	// Дано
	Исполнитель = СоздатьИсполнителя();
	КаталогSrc = ВременныеФайлы.СоздатьКаталог();
	КопироватьКаталог(Исполнитель.ПутьФикстуры("cfe"), КаталогSrc);
	СтрокаПодключения = СтрокаПодключенияДляРежима(КаталогБазы, Режим);
	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Исполнитель.ДобавитьОпцию("--extension-name", ИмяРасширения);
	ДобавитьФлагРежима(Исполнитель, Режим);
	Исполнитель.ДобавитьФлаг("--increment");
	Исполнитель.ДобавитьФлаг("--no-update-db"); // тест загрузки: применение к БД не проверяем
	Исполнитель.ДобавитьАргумент(КаталогSrc);

	// Когда: первый запуск (индекса еще нет)
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "инкрементальная загрузка конфигурации");
	Исполнитель.ОжидаемЧтоВыводСодержит("ОТЛАДКА - [v.ПодкомандаCfeLoad] - Начало выполнения команды cfe load");

	// И: изменяем исходники
	ПутьКМодулю = ОбъединитьПути(КаталогSrc, "Ext", "ManagedApplicationModule.bsl");
	ДобавитьМетодВМодуль(ПутьКМодулю);

	// Когда: второй запуск после изменения исходников
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "инкрементальная загрузка конфигурации");
	Исполнитель.ОжидаемЧтоВыводСодержит("Инкрементальная загрузка: будет загружено");
	Исполнитель.ОжидаемЧтоВыводСодержит("ManagedApplicationModule.bsl");
	Исполнитель.ОжидаемЧтоВыводНеСодержит("Инкрементальная загрузка: изменений не найдено, загрузка пропущена");

КонецПроцедуры

// В режиме конфигуратора инкрементальная загрузка теперь поддерживается напрямую
// (выборочной загрузкой файлов), без обработки 1С:Предприятие.
&Тест
Процедура ТестДолжен_ПоддерживатьИнкрементВКонфигураторе() Экспорт

	Режим = "designer";

	// Дано
	Исполнитель = СоздатьИсполнителя();
	КаталогSrc = Исполнитель.ПутьФикстуры("cfe");
	СтрокаПодключения = СтрокаПодключенияДляРежима(КаталогБазы, Режим);
	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Исполнитель.ДобавитьОпцию("--extension-name", ИмяРасширения);
	ДобавитьФлагРежима(Исполнитель, Режим);
	Исполнитель.ДобавитьФлаг("--increment");
	Исполнитель.ДобавитьФлаг("--no-update-db"); // тест загрузки: применение к БД не проверяем
	Исполнитель.ДобавитьАргумент(КаталогSrc);

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "инкрементальная загрузка расширения через конфигуратор");
	Исполнитель.ОжидаемЧтоВыводНеСодержит("Инкрементальная загрузка не поддерживается в режиме 1С:Предприятие");

КонецПроцедуры

// Установка свойств расширения (only ibcmd).
&Тест
Процедура ТестДолжен_УстановитьСвойстваРасширенияIbcmd() Экспорт

	// Дано
	ЗагрузитьРасширениеВБазу("ibcmd");

	Исполнитель = СоздатьИсполнителя();
	СтрокаПодключения = "/F""" + КаталогБазы + """";
	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Исполнитель.ДобавитьОпцию("--extension-name", ИмяРасширения);
	Исполнитель.ДобавитьФлаг("--ibcmd");
	// --safe-mode: не передаём, флаг по умолчанию выключен (БезопасныйРежим=Ложь)
	Исполнитель.ДобавитьФлаг("--active");
	КаталогSrc = Исполнитель.ПутьФикстуры("cfe");
	Исполнитель.ДобавитьАргумент(КаталогSrc);

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "установка свойств расширения через ibcmd");

КонецПроцедуры

// Обновление конфигурации БД теперь выполняется по умолчанию (без каких-либо флагов):
// после загрузки расширение применяется к базе (UpdateDBCfg / config apply).
&Тест
Процедура ТестДолжен_ОбновитьБДПоУмолчанию() Экспорт

	Режим = "ibcmd";

	// Дано
	Исполнитель = СоздатьИсполнителя();
	КаталогSrc = Исполнитель.ПутьФикстуры("cfe");
	СтрокаПодключения = СтрокаПодключенияДляРежима(КаталогБазы, Режим);
	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Исполнитель.ДобавитьОпцию("--extension-name", ИмяРасширения);
	ДобавитьФлагРежима(Исполнитель, Режим);
	Исполнитель.ДобавитьАргумент(КаталогSrc);
	// флаг обновления не передаём - обновление БД должно произойти по умолчанию

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "загрузка расширения с обновлением БД по умолчанию");
	Исполнитель.ОжидаемЧтоВыводСодержит("Обновление расширения '" + ИмяРасширения + "' БД");

КонецПроцедуры

// Флаг --no-update-db: обновление конфигурации БД по умолчанию отключается, и тогда, даже
// при заданных флагах свойств, команда просто загружает расширение и выходит - ни обновления
// БД, ни изменения свойств не выполняется.
&Тест
Процедура ТестДолжен_ПропуститьОбновлениеИСвойстваПриNoUpdateDb() Экспорт

	Режим = "designer";

	// Дано
	Исполнитель = СоздатьИсполнителя();
	КаталогSrc = Исполнитель.ПутьФикстуры("cfe");
	СтрокаПодключения = СтрокаПодключенияДляРежима(КаталогБазы, Режим);
	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Исполнитель.ДобавитьОпцию("--extension-name", ИмяРасширения);
	ДобавитьФлагРежима(Исполнитель, Режим);
	Исполнитель.ДобавитьФлаг("--active");        // даже с флагом свойств...
	Исполнитель.ДобавитьФлаг("--no-update-db");  // ...обновление и свойства пропускаются
	Исполнитель.ДобавитьАргумент(КаталогSrc);

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "загрузка расширения с --no-update-db");
	Исполнитель.ОжидаемЧтоВыводНеСодержит("Обновление расширения '" + ИмяРасширения + "' БД");
	Исполнитель.ОжидаемЧтоВыводНеСодержит("Свойства расширения '" + ИмяРасширения + "' обновлены");

КонецПроцедуры

// Автоопределение имени расширения из имени каталога-источника (--extension-name не передаётся).
// Имя каталога фикстур "cfe" - валидное имя расширения.
&Тест
Процедура ТестДолжен_ОпределитьИмяРасширенияИзКаталога() Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителя();
	КаталогSrc = Исполнитель.ПутьФикстуры("cfe");
	СтрокаПодключения = "/F""" + КаталогБазы + """";
	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Исполнитель.ДобавитьФлаг("--ibcmd");
	Исполнитель.ДобавитьАргумент(КаталогSrc);
	// --extension-name не передаётся - имя должно определиться из имени каталога

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "автоопределение имени расширения из имени каталога");

КонецПроцедуры

// Автоопределение имени расширения из имени .cfe-файла (--extension-name не передаётся).
&Тест
Процедура ТестДолжен_ОпределитьИмяРасширенияИзФайлаCfe() Экспорт

	// Дано
	ФайлCfe = СобратьCfeВФайл("my_ext");

	Исполнитель = СоздатьИсполнителя();
	СтрокаПодключения = "/F""" + КаталогБазы + """";
	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Исполнитель.ДобавитьФлаг("--ibcmd");
	Исполнитель.ДобавитьАргумент(ФайлCfe);
	// --extension-name не передаётся - имя должно определиться из имени файла (my_ext)

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "автоопределение имени расширения из имени CFE-файла");

КонецПроцедуры

// Имя, автоматически определённое из пути, нарушает требования (начинается с цифры).
// Ожидаем ненулевой код возврата и сообщение об ошибке.
&Тест
Процедура ТестДолжен_ВернутьОшибкуПриНеверномИмениКаталога() Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителя();
	СтрокаПодключения = "/F""" + КаталогБазы + """";
	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Исполнитель.ДобавитьФлаг("--ibcmd");
	// Путь заканчивается именем, начинающимся с цифры - невалидное имя расширения
	КаталогВрем = ВременныеФайлы.СоздатьКаталог();
	НевалидноеИмя = ОбъединитьПути(КаталогВрем, "123bad_ext");
	Исполнитель.ДобавитьАргумент(НевалидноеИмя);
	// --extension-name не передаётся

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(1, "cfe load с невалидным именем каталога");
	Исполнитель.ОжидаемЧтоВыводСодержит("Неверное имя!");

КонецПроцедуры

// Имя, автоматически определённое из пути к .cfe-файлу, содержит недопустимые символы (дефис).
&Тест
Процедура ТестДолжен_ВернутьОшибкуПриНеверномИмениФайлаCfe() Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителя();
	СтрокаПодключения = "/F""" + КаталогБазы + """";
	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Исполнитель.ДобавитьФлаг("--ibcmd");
	// Имя файла содержит дефис - недопустимый символ
	КаталогВрем = ВременныеФайлы.СоздатьКаталог();
	НевалидноеИмя = ОбъединитьПути(КаталогВрем, "bad-name.cfe");
	Исполнитель.ДобавитьАргумент(НевалидноеИмя);

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(1, "cfe load с невалидным именем CFE-файла");
	Исполнитель.ОжидаемЧтоВыводСодержит("Неверное имя!");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
	ИмяРасширения = "test";
	КаталогБазы = СоздатьПустуюБазу();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсполнителя()
	Аргументы = Новый Массив;
	Аргументы.Добавить("cfe");
	Аргументы.Добавить("load");
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

Функция СоздатьПустуюБазу()
	Возврат ФикстурнаяФайловаяБД.СкопироватьВоВременнойКаталог();
КонецФункции

Функция СтрокаПодключенияДляРежима(КаталогБазы, Режим)
	Возврат "/F""" + КаталогБазы + """";
КонецФункции

Функция СобратьCfeИзФикстур(Режим)
	АргументыКомпиляции = Новый Массив;
	АргументыКомпиляции.Добавить("cfe");
	АргументыКомпиляции.Добавить("compile");
	Исполнитель = Новый ИсполнительCLI(АргументыКомпиляции);
	КаталогSrc = Исполнитель.ПутьФикстуры("cfe");
	Исполнитель.ДобавитьОпцию("--src", КаталогSrc);
	Исполнитель.ДобавитьОпцию("--extension-name", ИмяРасширения);
	ДобавитьФлагРежима(Исполнитель, Режим);
	ПутьCfe = ВременныеФайлы.НовоеИмяФайла("cfe");
	Исполнитель.ДобавитьАргумент(ПутьCfe);
	Исполнитель.ВыполнитьКоманду();
	Возврат ПутьCfe;
КонецФункции

Процедура ЗагрузитьРасширениеВБазу(Режим)
	АргументыЗагрузки = Новый Массив;
	АргументыЗагрузки.Добавить("cfe");
	АргументыЗагрузки.Добавить("load");
	Исполнитель = Новый ИсполнительCLI(АргументыЗагрузки);
	КаталогSrc = Исполнитель.ПутьФикстуры("cfe");
	СтрокаПодключения = "/F""" + КаталогБазы + """";
	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Исполнитель.ДобавитьОпцию("--extension-name", ИмяРасширения);
	ДобавитьФлагРежима(Исполнитель, Режим);
	Исполнитель.ДобавитьАргумент(КаталогSrc);
	Исполнитель.ВыполнитьКоманду();
КонецПроцедуры

Процедура ДобавитьФлагРежима(Исполнитель, Режим)
	Если Режим = "ibcmd" Тогда
		Исполнитель.ДобавитьФлаг("--ibcmd");
	КонецЕсли;
КонецПроцедуры

Процедура КопироватьКаталог(Знач КаталогИсточник, Знач КаталогНазначения)

	ПрефиксИсточника = Новый Файл(КаталогИсточник).ПолноеИмя;
	Разделитель = ПолучитьРазделительПути();
	Если Прав(ПрефиксИсточника, 1) <> Разделитель Тогда
		ПрефиксИсточника = ПрефиксИсточника + Разделитель;
	КонецЕсли;

	Элементы = НайтиФайлы(ПрефиксИсточника, "*", Истина);
	Для Каждого Элемент Из Элементы Цикл
		Если НЕ Элемент.ЭтоФайл() Тогда
			Продолжить;
		КонецЕсли;

		ОтносительныйПуть = Сред(Элемент.ПолноеИмя, СтрДлина(ПрефиксИсточника) + 1);
		ПутьНазначения = ОбъединитьПути(КаталогНазначения, ОтносительныйПуть);
		КаталогФайлаНазначения = Новый Файл(ПутьНазначения).Путь;
		Если НЕ Новый Файл(КаталогФайлаНазначения).Существует() Тогда
			СоздатьКаталог(КаталогФайлаНазначения);
		КонецЕсли;

		КопироватьФайл(Элемент.ПолноеИмя, ПутьНазначения);
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьМетодВМодуль(Знач ПутьКМодулю)

	Чтение = Новый ЧтениеТекста(ПутьКМодулю, "UTF-8");
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();

	ИмяМетода = "ТестовыйИнкремент_" + Формат(ТекущаяДата(), "ДФ=yyyyMMddHHmmss");
	Дополнение = Символы.ПС
		+ "Процедура " + ИмяМетода + "() Экспорт" + Символы.ПС
		+ "КонецПроцедуры" + Символы.ПС;

	Запись = Новый ЗаписьТекста(ПутьКМодулю, "UTF-8");
	Запись.Записать(Текст + Дополнение);
	Запись.Закрыть();

КонецПроцедуры

Функция СобратьCfeВФайл(ИмяБезРасширения)
	АргументыКомпиляции = Новый Массив;
	АргументыКомпиляции.Добавить("cfe");
	АргументыКомпиляции.Добавить("compile");
	Исполнитель = Новый ИсполнительCLI(АргументыКомпиляции);
	КаталогSrc = Исполнитель.ПутьФикстуры("cfe");
	Исполнитель.ДобавитьОпцию("--src", КаталогSrc);
	Исполнитель.ДобавитьОпцию("--extension-name", "temp");
	Исполнитель.ДобавитьФлаг("--ibcmd");
	КаталогВрем = ВременныеФайлы.СоздатьКаталог();
	ПутьCfe = ОбъединитьПути(КаталогВрем, ИмяБезРасширения + ".cfe");
	Исполнитель.ДобавитьАргумент(ПутьCfe);
	Исполнитель.ВыполнитьКоманду();
	Возврат ПутьCfe;
КонецФункции

#КонецОбласти
