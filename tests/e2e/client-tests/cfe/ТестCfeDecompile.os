// BSLLS-off
// Тестовый набор: cfe decompile
// Интеграционные тесты разборки .cfe-файла расширения в XML-исходники.
//
// Фикстуры: tests/e2e/fixtures/cfe/ - XML-исходники расширения

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands
#Использовать "../../utils"

Перем НакопленныеВременныеФайлы;

Перем ИмяРасширения;

#Область СлужебныйПрограммныйИнтерфейс

// Разборка .cfe-файла в каталог XML-исходников.
// Прогоняется дважды: с ibcmd и через конфигуратор.
&ПараметризованныйТест
&ИсточникЗначение("ibcmd")
&ИсточникЗначение("designer")
Процедура ТестДолжен_РазобратьРасширениеИзФайлаCfeВИсходники(Режим) Экспорт

	// Дано
	ПутьCfe = СобратьCfeИзФикстур(Режим);
	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьОпцию("--cfe-file", ПутьCfe);
	Исполнитель.ДобавитьОпцию("--extension-name", ИмяРасширения);
	ДобавитьФлагРежима(Исполнитель, Режим);
	Исполнитель.ДобавитьАргумент("out");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "разборка расширения из CFE-файла в исходники");
	Исполнитель.ОжидаемЧтоКаталогСуществует("out");
	Исполнитель.ОжидаемЧтоФайлСуществует(ОбъединитьПути("out", "Configuration.xml"));

КонецПроцедуры

// Разборка в исходники напрямую из существующей ИБ, без указания cfe-файла.
// Стадия загрузки cfe пропускается, расширение выгружается из переданной базы.
&ПараметризованныйТест
&ИсточникЗначение("ibcmd")
&ИсточникЗначение("designer")
Процедура ТестДолжен_ВыгрузитьИсходникиИзБазыБезCfe(Режим) Экспорт

	// Дано - файловая ИБ с установленным расширением, cfe-файл не задаётся
	КаталогБазы = ПодготовитьБазуСРасширением(Режим);
	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьОпцию("--ibconnection", "/F""" + КаталогБазы + """");
	Исполнитель.ДобавитьОпцию("--extension-name", ИмяРасширения);
	ДобавитьФлагРежима(Исполнитель, Режим);
	Исполнитель.ДобавитьАргумент("out");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "разборка расширения из ИБ в исходники без cfe-файла");
	Исполнитель.ОжидаемЧтоКаталогСуществует("out");
	Исполнитель.ОжидаемЧтоФайлСуществует(ОбъединитьПути("out", "Configuration.xml"));

КонецПроцедуры

// Если не заданы ни cfe-файл, ни ИБ (потребовалась бы пустая временная база) -
// команда должна завершиться с ошибкой: выгружать нечего.
&Тест
Процедура ТестДолжен_ВернутьОшибку_ЕслиНетCfeИНетБазы() Экспорт

	// Дано - ни --cfe-file, ни --ibconnection
	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьОпцию("--extension-name", ИмяРасширения);
	Исполнитель.ДобавитьАргумент("out");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Ожидаем.Что(Исполнитель.КодВозврата(),
		"команда без cfe-файла и без базы должна завершиться с ненулевым кодом").Не_().Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
	ИмяРасширения = "test";
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсполнителя()
	Аргументы = Новый Массив;
	Аргументы.Добавить("cfe");
	Аргументы.Добавить("decompile");
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

Функция СобратьCfeИзФикстур(Режим)
	Компилятор = Новый ИсполнительCLI(Новый Массив);
	КаталогSrc = Компилятор.ПутьФикстуры("cfe");
	АргументыКомпиляции = Новый Массив;
	АргументыКомпиляции.Добавить("cfe");
	АргументыКомпиляции.Добавить("compile");
	Исполнитель = Новый ИсполнительCLI(АргументыКомпиляции);
	Исполнитель.ДобавитьОпцию("--src", КаталогSrc);
	Исполнитель.ДобавитьОпцию("--extension-name", ИмяРасширения);
	ДобавитьФлагРежима(Исполнитель, Режим);
	ПутьCfe = ВременныеФайлы.НовоеИмяФайла("cfe");
	Исполнитель.ДобавитьАргумент(ПутьCfe);
	Исполнитель.ВыполнитьКоманду();
	Возврат ПутьCfe;
КонецФункции

// Скопировать пустую ИБ из фикстуры и загрузить в неё расширение из XML-исходников.
// Возвращает каталог заполненной файловой ИБ.
Функция ПодготовитьБазуСРасширением(Режим)
	КаталогБазы = ФикстурнаяФайловаяБД.СкопироватьВоВременнойКаталог();
	АргументыЗагрузки = Новый Массив;
	АргументыЗагрузки.Добавить("cfe");
	АргументыЗагрузки.Добавить("load");
	Исполнитель = Новый ИсполнительCLI(АргументыЗагрузки);
	КаталогSrc = Исполнитель.ПутьФикстуры("cfe");
	Исполнитель.ДобавитьОпцию("--ibconnection", "/F""" + КаталогБазы + """");
	Исполнитель.ДобавитьОпцию("--extension-name", ИмяРасширения);
	ДобавитьФлагРежима(Исполнитель, Режим);
	Исполнитель.ДобавитьАргумент(КаталогSrc);
	Исполнитель.ВыполнитьКоманду();
	Возврат КаталогБазы;
КонецФункции

Процедура ДобавитьФлагРежима(Исполнитель, Режим)
	Если Режим = "ibcmd" Тогда
		Исполнитель.ДобавитьФлаг("--ibcmd");
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
