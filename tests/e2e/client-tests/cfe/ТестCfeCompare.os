// BSLLS-off
// Тестовый набор: cfe compare
// Интеграционные тесты сравнения расширения с .cfe-файлом.
//
// Сравнение выполняется Конфигуратором в контексте базы: расширение (-Extension) должно быть
// установлено в подключаемой ИБ, поэтому happy-path прогоняется в режиме «база vs cfe»
// (--ibconnection + --second-cfe). Отчёт складывается в каталог --report-dir с автогенерируемым
// именем compare_report_<тип>_<дата>.<формат> — единый вид с `cf compare`.
//
// Фикстуры: tests/e2e/fixtures/cfe/ - XML-исходники расширения

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands
#Использовать "../../utils"

Перем НакопленныеВременныеФайлы;
Перем КаталогБазы;
Перем ИмяРасширения;

#Область СлужебныйПрограммныйИнтерфейс

// Команда должна завершиться ошибкой, если не задан second-cfe.
&Тест
Процедура ТестДолжен_ВыброситьОшибкуЕслиНеЗаданВторойCfe() Экспорт

	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьОпцию("--extension-name", ИмяРасширения);

	Исполнитель.ВыполнитьКоманду();

	Исполнитель.ОжидаемЧтоКодВозврата(1, "cfe compare без --second-cfe");

КонецПроцедуры

// В режиме сравнения с базой команда должна требовать ibconnection.
&Тест
Процедура ТестДолжен_ВыброситьОшибкуЕслиНетБазыПриСравненииСБазой() Экспорт

	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьОпцию("--extension-name", ИмяРасширения);
	Исполнитель.ДобавитьОпцию("--second-cfe", "second.cfe");

	Исполнитель.ВыполнитьКоманду();

	Исполнитель.ОжидаемЧтоКодВозврата(1, "cfe compare с базой без --ibconnection");

КонецПроцедуры

// Сравнение расширения из базы с cfe-файлом: отчёт появляется в указанном каталоге.
&Тест
Процедура ТестДолжен_СравнитьРасширениеБазыСCfe() Экспорт

	// Дано: расширение установлено в базу, и есть cfe-файл для сравнения
	ЗагрузитьРасширениеВБазу();
	ПутьCfe = СобратьФайлCfe();
	КаталогОтчётов = ВременныеФайлы.СоздатьКаталог();

	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьОпцию("--ibconnection",   СтрокаПодключенияКБазе());
	Исполнитель.ДобавитьОпцию("--extension-name", ИмяРасширения);
	Исполнитель.ДобавитьОпцию("--second-cfe",     ПутьCfe);
	Исполнитель.ДобавитьОпцию("--report-dir",     КаталогОтчётов);

	Исполнитель.ВыполнитьКоманду();

	Исполнитель.ОжидаемЧтоКодВозврата(0, "сравнение расширения базы с CFE-файлом");

	ФайлыОтчёта = НайтиФайлы(КаталогОтчётов, "compare_report_*.txt", Ложь);
	Ожидаем.Что(ФайлыОтчёта.Количество()).Больше(0);

КонецПроцедуры

// Тип отчёта попадает в имя файла (compare_report_brief_*.txt).
&Тест
Процедура ТестДолжен_СохранитьОтчётСТипомBrief() Экспорт

	// Дано: расширение установлено в базу, и есть cfe-файл для сравнения
	ЗагрузитьРасширениеВБазу();
	ПутьCfe = СобратьФайлCfe();
	КаталогОтчётов = ВременныеФайлы.СоздатьКаталог();

	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьОпцию("--ibconnection",    СтрокаПодключенияКБазе());
	Исполнитель.ДобавитьОпцию("--extension-name",  ИмяРасширения);
	Исполнитель.ДобавитьОпцию("--second-cfe",      ПутьCfe);
	Исполнитель.ДобавитьОпцию("--report-dir",      КаталогОтчётов);
	Исполнитель.ДобавитьОпцию("--report-type",     "Brief");
	Исполнитель.ДобавитьОпцию("--report-format",   "txt");

	Исполнитель.ВыполнитьКоманду();

	Исполнитель.ОжидаемЧтоКодВозврата(0);

	ФайлыОтчёта = НайтиФайлы(КаталогОтчётов, "compare_report_brief_*.txt", Ложь);
	Ожидаем.Что(ФайлыОтчёта.Количество()).Больше(0);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
	ИмяРасширения = "test";
	КаталогБазы = СоздатьПустуюБазу();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсполнителя()
	Аргументы = Новый Массив;
	Аргументы.Добавить("cfe");
	Аргументы.Добавить("compare");
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

Функция СоздатьПустуюБазу()
	Возврат ФикстурнаяФайловаяБД.СкопироватьВоВременнойКаталог();
КонецФункции

Функция СтрокаПодключенияКБазе()
	Возврат "/F""" + КаталогБазы + """";
КонецФункции

// Собрать .cfe-файл из фикстурных XML-исходников (через конфигуратор) и вернуть абсолютный путь.
Функция СобратьФайлCfe()
	Аргументы = Новый Массив;
	Аргументы.Добавить("cfe");
	Аргументы.Добавить("compile");
	Исполнитель = Новый ИсполнительCLI(Аргументы);
	КаталогSrc = Исполнитель.ПутьФикстуры("cfe");
	Исполнитель.ДобавитьОпцию("--src", КаталогSrc);
	Исполнитель.ДобавитьОпцию("--extension-name", ИмяРасширения);
	Исполнитель.ДобавитьАргумент("ext.cfe");
	Исполнитель.ВыполнитьКоманду();
	Исполнитель.ОжидаемЧтоКодВозврата(0, "подготовка: сборка .cfe для сравнения");
	Возврат ОбъединитьПути(Исполнитель.КаталогРаботы(), "ext.cfe");
КонецФункции

// Загрузить расширение из фикстурных исходников в базу (через конфигуратор).
Процедура ЗагрузитьРасширениеВБазу()
	Аргументы = Новый Массив;
	Аргументы.Добавить("cfe");
	Аргументы.Добавить("load");
	Исполнитель = Новый ИсполнительCLI(Аргументы);
	КаталогSrc = Исполнитель.ПутьФикстуры("cfe");
	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключенияКБазе());
	Исполнитель.ДобавитьОпцию("--extension-name", ИмяРасширения);
	Исполнитель.ДобавитьАргумент(КаталогSrc);
	Исполнитель.ВыполнитьКоманду();
	Исполнитель.ОжидаемЧтоКодВозврата(0, "подготовка: загрузка расширения в базу");
КонецПроцедуры

#КонецОбласти
