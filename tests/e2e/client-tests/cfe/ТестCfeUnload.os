// BSLLS-off
// Тестовый набор: cfe unload
// Интеграционные тесты выгрузки расширения из базы в .cfe-файл.
//
// Фикстуры: tests/e2e/fixtures/cfe/ - XML-исходники расширения

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands
#Использовать v8runner
#Использовать "../../utils"

Перем НакопленныеВременныеФайлы;

Перем КаталогБазы;
Перем ИмяРасширения;

#Область СлужебныйПрограммныйИнтерфейс

// Выгрузка расширения из базы в .cfe-файл.
// Прогоняется дважды: с ibcmd и через конфигуратор.
&ПараметризованныйТест
&ИсточникЗначение("ibcmd")
&ИсточникЗначение("designer")
Процедура ТестДолжен_ВыгрузитьРасширениеИзБазыВФайлCfe(Режим) Экспорт

	// Дано
	ЗагрузитьРасширениеВБазу(Режим);

	Исполнитель = СоздатьИсполнителя();
	СтрокаПодключения = "/F""" + КаталогБазы + """";
	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Исполнитель.ДобавитьОпцию("--extension-name", ИмяРасширения);
	ДобавитьФлагРежима(Исполнитель, Режим);
	Исполнитель.ДобавитьАргумент("out.cfe");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "выгрузка расширения в CFE-файл");
	Исполнитель.ОжидаемЧтоФайлСуществует("out.cfe");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
	ИмяРасширения = "test";
	КаталогБазы = СоздатьПустуюБазу();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсполнителя()
	Аргументы = Новый Массив;
	Аргументы.Добавить("cfe");
	Аргументы.Добавить("unload");
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

Функция СоздатьПустуюБазу()
	КаталогВрБазы = ВременныеФайлы.СоздатьКаталог();
	Конфигуратор = Новый УправлениеКонфигуратором;
	Конфигуратор.СоздатьФайловуюБазу(КаталогВрБазы);
	Возврат КаталогВрБазы;
КонецФункции

Процедура ЗагрузитьРасширениеВБазу(Режим)
	АргументыЗагрузки = Новый Массив;
	АргументыЗагрузки.Добавить("cfe");
	АргументыЗагрузки.Добавить("load");
	Исполнитель = Новый ИсполнительCLI(АргументыЗагрузки);
	КаталогSrc = Исполнитель.ПутьФикстуры("cfe");
	СтрокаПодключения = "/F""" + КаталогБазы + """";
	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Исполнитель.ДобавитьОпцию("--extension-name", ИмяРасширения);
	ДобавитьФлагРежима(Исполнитель, Режим);
	Исполнитель.ДобавитьАргумент(КаталогSrc);
	Исполнитель.ВыполнитьКоманду();
КонецПроцедуры

Процедура ДобавитьФлагРежима(Исполнитель, Режим)
	Если Режим = "ibcmd" Тогда
		Исполнитель.ДобавитьФлаг("--ibcmd");
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
