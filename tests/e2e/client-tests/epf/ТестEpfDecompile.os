// BSLLS-off
// Тестовый набор: epf decompile
// Интеграционные тесты разборки внешних обработок в XML-исходники.
//
// Тесты запускают реальную CLI-команду `vrunner epf decompile` через подпроцесс.
//
// Фикстуры: tests/e2e/fixtures/epf/ - XML-исходники обработок

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands
#Использовать v8runner
#Использовать "../../utils"

Перем НакопленныеВременныеФайлы;

#Область СлужебныйПрограммныйИнтерфейс

// Разборка конкретного EPF-файла в исходники.
// Прогоняется дважды: с ibcmd и через конфигуратор.
&ПараметризованныйТест
&ИсточникЗначение("ibcmd")
&ИсточникЗначение("designer")
Процедура ТестДолжен_РазобратьОбработкуВИсходники(Режим) Экспорт

	// Дано: сначала собираем EPF из фикстуры
	ПутьEpf = СобратьОбработкуИзФикстуры("ТестоваяОбработка");

	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьОпцию("--out", Исполнитель.КаталогРаботы());
	ДобавитьФлагРежима(Исполнитель, Режим);
	Исполнитель.ДобавитьАргумент(ПутьEpf);

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "разборка обработки в исходники");
	Исполнитель.ОжидаемЧтоКаталогСуществует("ТестоваяОбработка");

КонецПроцедуры

// Разборка обработок из каталога с рекурсивным поиском.
// Прогоняется дважды: с ibcmd и через конфигуратор.
&ПараметризованныйТест
&ИсточникЗначение("ibcmd")
&ИсточникЗначение("designer")
Процедура ТестДолжен_РазобратьОбработкиИзКаталогаРекурсивно(Режим) Экспорт

	// Дано: собираем обработки
	КаталогEpf = ВременныеФайлы.СоздатьКаталог();
	СобратьОбработкуВКаталог("ТестоваяОбработка", КаталогEpf);
	СобратьОбработкуВКаталог("ВтораяОбработка", КаталогEpf);

	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьФлаг("-R");
	Исполнитель.ДобавитьОпцию("--out", Исполнитель.КаталогРаботы());
	ДобавитьФлагРежима(Исполнитель, Режим);
	Исполнитель.ДобавитьАргумент(КаталогEpf);

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "рекурсивная разборка обработок из каталога");
	Исполнитель.ОжидаемЧтоКаталогСуществует("ТестоваяОбработка");
	Исполнитель.ОжидаемЧтоКаталогСуществует("ВтораяОбработка");

КонецПроцедуры

// Ошибка при несуществующем файле.
&Тест
Процедура ТестДолжен_ВернутьОшибкуЕслиФайлНеСуществует() Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьАргумент("несуществующий.epf");

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Ожидаем.Что(Исполнитель.КодВозврата(), "Код возврата должен быть ненулевым").Не_().Равно(0);

КонецПроцедуры

// Ошибка при отсутствии аргумента.
&Тест
Процедура ТестДолжен_ВернутьОшибкуБезАргументов() Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителя();

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Ожидаем.Что(Исполнитель.КодВозврата(), "Код возврата должен быть ненулевым").Не_().Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсполнителя()
	Аргументы = Новый Массив;
	Аргументы.Добавить("epf");
	Аргументы.Добавить("decompile");
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

Функция СобратьОбработкуИзФикстуры(Знач ИмяОбработки)

	ИсполнительСборки = СоздатьИсполнителяСборки();
	КаталогSrc = ИсполнительСборки.ПутьФикстуры("epf", ИмяОбработки);
	ИсполнительСборки.ДобавитьОпцию("--out", ИсполнительСборки.КаталогРаботы());
	ИсполнительСборки.ДобавитьАргумент(КаталогSrc);
	ИсполнительСборки.ВыполнитьКоманду();

	Ожидаем.Что(ИсполнительСборки.КодВозврата(), "Сборка фикстуры должна завершиться успешно").Равно(0);
	Возврат ОбъединитьПути(ИсполнительСборки.КаталогРаботы(), ИмяОбработки + ".epf");

КонецФункции

Процедура СобратьОбработкуВКаталог(Знач ИмяОбработки, Знач КаталогВыгрузки)

	ИсполнительСборки = СоздатьИсполнителяСборки();
	КаталогSrc = ИсполнительСборки.ПутьФикстуры("epf", ИмяОбработки);
	ИсполнительСборки.ДобавитьОпцию("--out", КаталогВыгрузки);
	ИсполнительСборки.ДобавитьАргумент(КаталогSrc);
	ИсполнительСборки.ВыполнитьКоманду();

	Ожидаем.Что(ИсполнительСборки.КодВозврата(), "Сборка фикстуры должна завершиться успешно").Равно(0);

КонецПроцедуры

Функция СоздатьИсполнителяСборки()
	Аргументы = Новый Массив;
	Аргументы.Добавить("epf");
	Аргументы.Добавить("compile");
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

Процедура ДобавитьФлагРежима(Исполнитель, Режим)
	Если Режим = "ibcmd" Тогда
		Исполнитель.ДобавитьФлаг("--ibcmd");
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
