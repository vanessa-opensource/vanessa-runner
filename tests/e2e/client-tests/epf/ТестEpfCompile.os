// BSLLS-off
// Тестовый набор: epf compile
// Интеграционные тесты сборки внешних обработок и отчётов из XML-исходников.
//
// Тесты запускают реальную CLI-команду `vrunner epf compile` через подпроцесс.
//
// Фикстуры: tests/e2e/fixtures/epf/ - XML-исходники обработок (ExternalDataProcessor)
// и внешнего отчёта (ExternalReport, собирается в .erf)

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands
#Использовать "../../utils"

Перем НакопленныеВременныеФайлы;

#Область СлужебныйПрограммныйИнтерфейс

// Сборка обработки из исходников - указан конкретный каталог.
// Прогоняется дважды: с ibcmd и через конфигуратор.
&ПараметризованныйТест
&ИсточникЗначение("ibcmd")
&ИсточникЗначение("designer")
Процедура ТестДолжен_СобратьОбработкуИзИсходников(Режим) Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителя();
	КаталогSrc = Исполнитель.ПутьФикстуры("epf", "ТестоваяОбработка");
	Исполнитель.ДобавитьОпцию("--out", Исполнитель.КаталогРаботы());
	ДобавитьФлагРежима(Исполнитель, Режим);
	Исполнитель.ДобавитьАргумент(КаталогSrc);

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "сборка обработки из исходников");
	Исполнитель.ОжидаемЧтоФайлСуществует("ТестоваяОбработка.epf");

КонецПроцедуры

// Сборка внешнего отчёта из исходников: ExternalReport собирается в .erf, а не в .epf.
// Прогоняется дважды: с ibcmd и через конфигуратор.
&ПараметризованныйТест
&ИсточникЗначение("ibcmd")
&ИсточникЗначение("designer")
Процедура ТестДолжен_СобратьОтчетИзИсходников(Режим) Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителя();
	КаталогSrc = Исполнитель.ПутьФикстуры("epf", "ТестовыйОтчет");
	Исполнитель.ДобавитьОпцию("--out", Исполнитель.КаталогРаботы());
	ДобавитьФлагРежима(Исполнитель, Режим);
	Исполнитель.ДобавитьАргумент(КаталогSrc);

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "сборка внешнего отчёта из исходников");
	Исполнитель.ОжидаемЧтоФайлСуществует("ТестовыйОтчет.erf");
	Ожидаем.Что(Новый Файл(ОбъединитьПути(Исполнитель.КаталогРаботы(), "ТестовыйОтчет.epf")).Существует(),
		"отчёт не должен собираться в .epf").ЭтоЛожь();

КонецПроцедуры

// Рекурсивная сборка обработок и отчётов.
// Прогоняется дважды: с ibcmd и через конфигуратор.
&ПараметризованныйТест
&ИсточникЗначение("ibcmd")
&ИсточникЗначение("designer")
Процедура ТестДолжен_СобратьОбработкиРекурсивно(Режим) Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителя();
	КаталогSrc = Исполнитель.ПутьФикстуры("epf");
	Исполнитель.ДобавитьФлаг("-R");
	Исполнитель.ДобавитьОпцию("--out", Исполнитель.КаталогРаботы());
	ДобавитьФлагРежима(Исполнитель, Режим);
	Исполнитель.ДобавитьАргумент(КаталогSrc);

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "рекурсивная сборка обработок из каталога");
	Исполнитель.ОжидаемЧтоФайлСуществует("ТестоваяОбработка.epf");
	Исполнитель.ОжидаемЧтоФайлСуществует("ВтораяОбработка.epf");
	Исполнитель.ОжидаемЧтоФайлСуществует("ТестовыйОтчет.erf");

КонецПроцедуры

// Сборка обработки из существующей файловой базы.
&Тест
Процедура ТестДолжен_СобратьОбработкуИзСуществующейБазы() Экспорт

	// Дано
	КаталоГБазы = ФикстурнаяФайловаяБД.СкопироватьВоВременнойКаталог();

	Исполнитель = СоздатьИсполнителя();
	КаталогSrc = Исполнитель.ПутьФикстуры("epf", "ТестоваяОбработка");
	Исполнитель.ДобавитьОпцию("--out", Исполнитель.КаталогРаботы());
	СтрокаПодключения = "/F""" + КаталогБазы + """";
	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Исполнитель.ДобавитьАргумент(КаталогSrc);

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Исполнитель.ОжидаемЧтоКодВозврата(0, "сборка обработки с использованием существующей базы");
	Исполнитель.ОжидаемЧтоФайлСуществует("ТестоваяОбработка.epf");

КонецПроцедуры

// Ошибка при отсутствии XML с ExternalDataProcessor.
&Тест
Процедура ТестДолжен_ВернутьОшибкуЕслиНетXmlОбработки() Экспорт

	// Дано
	Исполнитель = СоздатьИсполнителя();
	Исполнитель.ДобавитьАргумент(Исполнитель.КаталогРаботы());

	// Когда
	Исполнитель.ВыполнитьКоманду();

	// Тогда
	Ожидаем.Что(Исполнитель.КодВозврата(), "Код возврата должен быть ненулевым").Не_().Равно(0);
	Исполнитель.ОжидаемЧтоВыводСодержит("ExternalDataProcessor");

КонецПроцедуры

// Примечание: формат EDT для epf compile теперь ПОДДЕРЖИВАЕТСЯ (через 1cedtcli export →
// сборка XML). Проверяется в EDT-блоке tests/e2e/edt-tests/epf (требует 1С:EDT), здесь нет.

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсполнителя()
	Аргументы = Новый Массив;
	Аргументы.Добавить("epf");
	Аргументы.Добавить("compile");
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

Процедура ДобавитьФлагРежима(Исполнитель, Режим)
	Если Режим = "ibcmd" Тогда
		Исполнитель.ДобавитьФлаг("--ibcmd");
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
