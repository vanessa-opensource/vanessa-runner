// BSLLS-off
// Тестовый набор: cluster jobs lock / unlock
// Интеграционные тесты управления регламентными заданиями ИБ в кластере.
// См. tests/e2e/utils/Модули/ТестКонфигКластера.os для настройки окружения.

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands
#Использовать "../../utils"

Перем ИмяТестовойБазы;

#Область СлужебныйПрограммныйИнтерфейс

&Тест
&Тег("cluster")
Процедура ТестДолжен_ЗаблокироватьРегламентныеЗадания() Экспорт

	Исполнитель = СоздатьИсполнителя("jobs", "lock");
	Исполнитель.ВыполнитьКоманду();
	Исполнитель.ОжидаемЧтоКодВозврата(0, "блокировка регламентных заданий");

	ИсполнительInfo = СоздатьИсполнителя("info");
	ИсполнительInfo.ВыполнитьКоманду();
	ИсполнительInfo.ОжидаемЧтоКодВозврата(0, "получение информации об ИБ в кластере (проверка)");
	ИсполнительInfo.ОжидаемЧтоВыводСодержит("scheduled-jobs-deny");

КонецПроцедуры

&Тест
&Тег("cluster")
Процедура ТестДолжен_РазблокироватьРегламентныеЗадания() Экспорт

	Блокировщик = СоздатьИсполнителя("jobs", "lock");
	Блокировщик.ВыполнитьКоманду();
	Блокировщик.ОжидаемЧтоКодВозврата(0, "предварительная блокировка (подготовка)");

	Исполнитель = СоздатьИсполнителя("jobs", "unlock");
	Исполнитель.ВыполнитьКоманду();
	Исполнитель.ОжидаемЧтоКодВозврата(0, "разблокировка регламентных заданий");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	ИмяТестовойБазы = ТестКонфигКластера.НовоеИмяТестовойБазы();
	ТестКонфигКластера.СоздатьТестовуюБазу(ИмяТестовойБазы);
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ТестКонфигКластера.УдалитьТестовуюБазу(ИмяТестовойБазы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсполнителя(Команда, Подкоманда = Неопределено)
	Аргументы = Новый Массив;
	Аргументы.Добавить("cluster");
	Аргументы.Добавить(Команда);
	Если Подкоманда <> Неопределено Тогда
		Аргументы.Добавить(Подкоманда);
	КонецЕсли;

	Исполнитель = Новый ИсполнительCLI(Аргументы);
	ТестКонфигКластера.ДобавитьОпцииRAS(Исполнитель);
	Исполнитель.ДобавитьОпцию("--db-name", ИмяТестовойБазы);
	Возврат Исполнитель;
КонецФункции

#КонецОбласти
