// BSLLS-off
// Тестовый набор: cluster process turn-off
// Настоящее выключение rphost на общем кластере CI оборвало бы базы соседних тестов, а сервер
// CI может быть старше 8.3.27: проверяется путь до вызова RAS - опции, вход в кластер, поиск процесса.
// См. tests/e2e/utils/Модули/ТестКонфигКластера.os для настройки окружения.

#Использовать asserts
#Использовать "../../utils"

#Область СлужебныйПрограммныйИнтерфейс

&Тест
&Тег("cluster")
Процедура ТестДолжен_СообщитьОНенайденномРабочемПроцессе() Экспорт

	Исполнитель = Новый ИсполнительCLI(СтрРазделить("cluster process turn-off", " "));
	ТестКонфигКластера.ДобавитьОпцииRAS(Исполнитель);
	Исполнитель.ДобавитьОпцию("--pid", "999999999");
	Исполнитель.ВыполнитьКоманду();

	Исполнитель.ОжидаемЧтоКодВозврата(1, "выключение несуществующего рабочего процесса");
	Исполнитель.ОжидаемЧтоВыводСодержит("не найден в кластере");

КонецПроцедуры

#КонецОбласти
