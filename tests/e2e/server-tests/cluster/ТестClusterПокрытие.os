// BSLLS-off
// Тестовый набор: сбор покрытия (--coverage-report) на серверной (клиент-серверной) ИБ.
// Подтверждает требование: покрытие собирается не только на файловых, но и на серверных базах.
// См. tests/e2e/utils/Модули/ТестКонфигКластера.os для настройки окружения кластера.
//
// Полный сценарий (тег cluster): создать серверную ИБ -> загрузить базовую конфигурацию,
// движок YAxUnit и тестовое расширение -> прогнать тесты со сбором покрытия ->
// проверить сформированный genericCoverage-отчёт с покрытым модулем расширения.

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands
#Использовать "../../utils"

Перем ИмяТестовойБазы;

#Область СлужебныйПрограммныйИнтерфейс

&Тест
&Тег("cluster")
Процедура ТестДолжен_СобратьПокрытиеНаСервернойБазе() Экспорт

	Подключение = ТестКонфигКластера.СтрокаПодключенияСервер(ИмяТестовойБазы);

	// Дано - серверная ИБ с базовой конфигурацией, движком YAxUnit и тестовым расширением "test"
	ЗагрузитьКонфигурацию(Подключение, ПутьФикстуры("1cv8.cf", ""));
	ЗагрузитьРасширение(Подключение, "YAxUnit", ПутьФикстуры("yaxunit", "YAxUnit.cfe"));
	ЗагрузитьРасширение(Подключение, "test", ПутьФикстуры("yaxunit", "tests-ext"));

	Прогон = СоздатьИсполнителя();
	ПутьОтчёта = ОбъединитьПути(Прогон.КаталогРаботы(), "coverage", "genericCoverage.xml");
	Прогон.ДобавитьОпцию("--ibconnection", Подключение);
	Прогон.ДобавитьОпцию("--ext", "test");
	Прогон.ДобавитьОпцию("--coverage-report", ПутьОтчёта);
	Прогон.ДобавитьОпцию("--coverage-ext", ПутьФикстуры("yaxunit", "tests-ext"));

	// Когда
	Прогон.ВыполнитьКоманду();

	// Тогда - конвейер покрытия отработал на серверной ИБ и сформировал корректный отчёт.
	// ВАЖНО: полнота покрытия СЕРВЕРНОГО кода (в rphost) зависит от того, разрешена ли отладка
	// на самом кластере (серверная настройка, вне контроля команды test) - это общее ограничение
	// инструментов покрытия 1С для клиент-серверных баз. Поэтому здесь проверяем факт формирования
	// отчёта, а не конкретные покрытые строки серверного модуля.
	Прогон.ОжидаемЧтоКодВозврата(0, "прогон YAxUnit со сбором покрытия на серверной ИБ");
	Прогон.ОжидаемЧтоВыводСодержит("Отчёт покрытия сформирован");
	Прогон.ОжидаемЧтоФайлСуществует("coverage/genericCoverage.xml");

	Отчёт = ПрочитатьФайл(ПутьОтчёта);
	Ожидаем.Что(Отчёт, "genericCoverage XML").Содержит("<coverage");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	ИмяТестовойБазы = ТестКонфигКластера.НовоеИмяТестовойБазы();
	ТестКонфигКластера.СоздатьТестовуюБазу(ИмяТестовойБазы);
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ТестКонфигКластера.УдалитьТестовуюБазу(ИмяТестовойБазы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсполнителя()
	Аргументы = Новый Массив;
	Аргументы.Добавить("test");
	Аргументы.Добавить("yaxunit");
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

Функция ПутьФикстуры(Знач Сегмент1, Знач Сегмент2)
	Исполнитель = СоздатьИсполнителя();
	Если ЗначениеЗаполнено(Сегмент2) Тогда
		Возврат Исполнитель.ПутьФикстуры(Сегмент1, Сегмент2);
	КонецЕсли;
	Возврат Исполнитель.ПутьФикстуры(Сегмент1);
КонецФункции

Процедура ЗагрузитьКонфигурацию(Знач Подключение, Знач ФайлИлиКаталог)
	Аргументы = Новый Массив;
	Аргументы.Добавить("cf");
	Аргументы.Добавить("load");
	Загрузчик = Новый ИсполнительCLI(Аргументы);
	Загрузчик.ДобавитьОпцию("--ibconnection", Подключение);
	Загрузчик.ДобавитьАргумент(ФайлИлиКаталог);
	Загрузчик.ВыполнитьКоманду();
	Загрузчик.ОжидаемЧтоКодВозврата(0, "загрузка базовой конфигурации в серверную ИБ");
КонецПроцедуры

Процедура ЗагрузитьРасширение(Знач Подключение, Знач ИмяРасширения, Знач ПутьИсточника)
	Аргументы = Новый Массив;
	Аргументы.Добавить("cfe");
	Аргументы.Добавить("load");
	Загрузчик = Новый ИсполнительCLI(Аргументы);
	Загрузчик.ДобавитьОпцию("--ibconnection", Подключение);
	Загрузчик.ДобавитьОпцию("--extension-name", ИмяРасширения);
	Загрузчик.ДобавитьФлаг("--update-db");
	Загрузчик.ДобавитьАргумент(ПутьИсточника);
	Загрузчик.ВыполнитьКоманду();
	Загрузчик.ОжидаемЧтоКодВозврата(0, "загрузка расширения " + ИмяРасширения + " в серверную ИБ");
КонецПроцедуры

Функция ПрочитатьФайл(Знач Путь)
	Чтение = Новый ЧтениеТекста(Путь, "UTF-8");
	Содержимое = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат Содержимое;
КонецФункции

#КонецОбласти
