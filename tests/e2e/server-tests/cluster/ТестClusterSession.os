// BSLLS-off
// Тестовый набор: cluster session lock / unlock / kill / closed / list
// Интеграционные тесты управления сеансами ИБ в кластере.
// См. tests/e2e/utils/Модули/ТестКонфигКластера.os для настройки окружения.

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands
#Использовать "../../utils"

Перем ИмяТестовойБазы;
Перем КлиентыДо;

#Область СлужебныйПрограммныйИнтерфейс

&Тест
&Тег("cluster")
Процедура ТестДолжен_ЗаблокироватьНовыеСеансы() Экспорт

	Исполнитель = СоздатьИсполнителя("session", "lock");
	Исполнитель.ВыполнитьКоманду();
	Исполнитель.ОжидаемЧтоКодВозврата(0, "блокировка новых сеансов");

	ИсполнительInfo = СоздатьИсполнителя("info");
	ИсполнительInfo.ВыполнитьКоманду();
	ИсполнительInfo.ОжидаемЧтоКодВозврата(0, "получение информации об ИБ в кластере (проверка)");
	ИсполнительInfo.ОжидаемЧтоВыводСодержит("sessions-deny");

КонецПроцедуры

&Тест
&Тег("cluster")
Процедура ТестДолжен_РазблокироватьНовыеСеансы() Экспорт

	Блокировщик = СоздатьИсполнителя("session", "lock");
	Блокировщик.ВыполнитьКоманду();
	Блокировщик.ОжидаемЧтоКодВозврата(0, "предварительная блокировка (подготовка)");

	Исполнитель = СоздатьИсполнителя("session", "unlock");
	Исполнитель.ВыполнитьКоманду();
	Исполнитель.ОжидаемЧтоКодВозврата(0, "разблокировка новых сеансов");

КонецПроцедуры

&Тест
&Тег("cluster")
Процедура ТестДолжен_ЗавершитьВсеСеансы() Экспорт

	Исполнитель = СоздатьИсполнителя("session", "kill");
	Исполнитель.ВыполнитьКоманду();
	Исполнитель.ОжидаемЧтоКодВозврата(0, "завершение всех активных сеансов");

КонецПроцедуры

&Тест
&Тег("cluster")
Процедура ТестДолжен_ЗавершитьСеансыПоОтбору() Экспорт

	Исполнитель = СоздатьИсполнителя("session", "kill");
	Исполнитель.ДобавитьОпцию("--filter-app", "Designer");
	// список пользователей - повтором опции: ";" внутри значения разрезал бы
	// командную строку sh на Linux (1commands исполняет команду через shell)
	Исполнитель.ДобавитьОпцию("--filter-name", "регламент");
	Исполнитель.ДобавитьОпцию("--filter-name", "администратор");
	Исполнитель.ДобавитьФлаг("--no-lock");
	Исполнитель.ВыполнитьКоманду();
	Исполнитель.ОжидаемЧтоКодВозврата(0, "завершение сеансов по отбору");

КонецПроцедуры

&Тест
&Тег("cluster")
Процедура ТестДолжен_ЗавершитьСеансыСРетраямиИТаймаутом() Экспорт

	Исполнитель = СоздатьИсполнителя("session", "kill");
	Исполнитель.ДобавитьОпцию("--retry", "1");
	Исполнитель.ДобавитьФлаг("--no-lock");
	Исполнитель.ВыполнитьКоманду();
	Исполнитель.ОжидаемЧтоКодВозврата(0, "завершение сеансов с одной попыткой");

	ИсполнительТаймаут = СоздатьИсполнителя("session", "kill");
	ИсполнительТаймаут.ДобавитьОпцию("--timeout", "10");
	ИсполнительТаймаут.ДобавитьФлаг("--no-lock");
	ИсполнительТаймаут.ВыполнитьКоманду();
	ИсполнительТаймаут.ОжидаемЧтоКодВозврата(0, "завершение сеансов по таймауту");

КонецПроцедуры

// Полный сценарий на живом сеансе: клиент 1С держит сеанс -> closed видит его (код 1),
// closed --timeout реально ждёт (замер длительности), kill завершает с верификацией,
// после чего closed зелёный. "Вечно зависший" сеанс в e2e не эмулировать (rac штатно
// завершает всё) - незавершаемость покрыта юнит-тестами СервисКластера со стабами.
&Тест
&Тег("cluster")
Процедура ТестДолжен_УвидетьЖивойСеанс_ДождатьсяИЗавершитьЕго() Экспорт

	// Дано - клиент 1С, удерживающий сеанс на тестовой базе
	Запуск = Новый ИсполнительCLI(СтрРазделить("run enterprise", " "));
	Запуск.ДобавитьОпцию("--ibconnection", ТестКонфигКластера.СтрокаПодключенияСервер(ИмяТестовойБазы));
	Запуск.ДобавитьФлаг("--no-wait");
	Запуск.ВыполнитьКоманду();
	Запуск.ОжидаемЧтоКодВозврата(0, "запуск клиента 1С на тестовой базе (--no-wait)");

	ДождатьсяПоявленияСеанса();

	// Тогда (1) - closed падает при активном сеансе
	Проверка = СоздатьИсполнителя("session", "closed");
	Проверка.ВыполнитьКоманду();
	Проверка.ОжидаемЧтоКодВозврата(1, "closed при активном сеансе");
	Проверка.ОжидаемЧтоВыводСодержит("Найдены активные сеансы");

	// Тогда (2) - closed --timeout действительно ждёт: сеанс не исчезает, команда
	// возвращает 1 не раньше истечения таймаута
	НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Ожидание = СоздатьИсполнителя("session", "closed");
	Ожидание.ДобавитьОпцию("--timeout", "5");
	Ожидание.ВыполнитьКоманду();
	ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс;

	Ожидание.ОжидаемЧтоКодВозврата(1, "closed --timeout при неисчезающем сеансе");
	Ожидаем.Что(ДлительностьМс >= 4000,
		СтрШаблон("closed --timeout 5 должен ждать таймаут, а вернулся за %1 мс", ДлительностьМс)).ЭтоИстина();

	// Когда - завершаем живой сеанс с верификацией завершения
	Завершение = СоздатьИсполнителя("session", "kill");
	Завершение.ДобавитьОпцию("--timeout", "60");
	Завершение.ВыполнитьКоманду();
	Завершение.ОжидаемЧтоКодВозврата(0, "kill живого сеанса с верификацией");

	// Тогда (3) - сеансов больше нет
	Финал = СоздатьИсполнителя("session", "closed");
	Финал.ВыполнитьКоманду();
	Финал.ОжидаемЧтоКодВозврата(0, "после kill сеансов нет");
	Финал.ОжидаемЧтоВыводСодержит("Сеансы отсутствуют");

КонецПроцедуры

&Тест
&Тег("cluster")
Процедура ТестДолжен_ПроверитьОтсутствиеСеансов() Экспорт

	Исполнитель = СоздатьИсполнителя("session", "closed");
	Исполнитель.ВыполнитьКоманду();
	Исполнитель.ОжидаемЧтоКодВозврата(0, "на свежей базе сеансов нет");
	Исполнитель.ОжидаемЧтоВыводСодержит("Сеансы отсутствуют");

КонецПроцедуры

// На пустой базе closed --timeout завершается сразу: таймаут - максимум ожидания,
// а не фиксированная пауза. Реальное ожидание проверяет сценарий с живым сеансом
// (ТестДолжен_УвидетьЖивойСеанс_ДождатьсяИЗавершитьЕго).
&Тест
&Тег("cluster")
Процедура ТестДолжен_ДождатьсяОтсутствияСеансовСТаймаутом() Экспорт

	Исполнитель = СоздатьИсполнителя("session", "closed");
	Исполнитель.ДобавитьОпцию("--timeout", "5");
	Исполнитель.ВыполнитьКоманду();
	Исполнитель.ОжидаемЧтоКодВозврата(0, "ожидание завершения сеансов на пустой базе");
	Исполнитель.ОжидаемЧтоВыводСодержит("Сеансы отсутствуют");

КонецПроцедуры

&Тест
&Тег("cluster")
Процедура ТестДолжен_ВывестиСписокСеансов() Экспорт

	Исполнитель = СоздатьИсполнителя("session", "list");
	Исполнитель.ВыполнитьКоманду();
	Исполнитель.ОжидаемЧтоКодВозврата(0, "вывод списка сеансов");
	Исполнитель.ОжидаемЧтоВыводСодержит("нет активных сеансов");

КонецПроцедуры

&Тест
&Тег("cluster")
Процедура ТестДолжен_ВывестиСписокСеансовССоединениями() Экспорт

	Исполнитель = СоздатьИсполнителя("session", "list");
	Исполнитель.ДобавитьФлаг("--connections");
	Исполнитель.ВыполнитьКоманду();
	Исполнитель.ОжидаемЧтоКодВозврата(0, "вывод сеансов с соединениями");
	Исполнитель.ОжидаемЧтоВыводСодержит("Соединения ИБ");

КонецПроцедуры

&Тест
&Тег("cluster")
Процедура ТестДолжен_ПроверитьОтсутствиеСеансовПоОтбору() Экспорт

	Исполнитель = СоздатьИсполнителя("session", "closed");
	Исполнитель.ДобавитьОпцию("--filter-app", "BackgroundJob");
	Исполнитель.ВыполнитьКоманду();
	Исполнитель.ОжидаемЧтоКодВозврата(0, "фоновых заданий на свежей базе нет");

КонецПроцедуры

&Тест
&Тег("cluster")
Процедура ТестДолжен_ОтклонитьНедопустимоеПриложениеОтбора() Экспорт

	Исполнитель = СоздатьИсполнителя("session", "kill");
	Исполнитель.ДобавитьОпцию("--filter-app", "NotAnApp");
	Исполнитель.ВыполнитьКоманду();
	Исполнитель.ОжидаемЧтоКодВозврата(1, "недопустимый идентификатор приложения");
	Исполнитель.ОжидаемЧтоВыводСодержит("Недопустимое значение --filter-app");

КонецПроцедуры

&Тест
&Тег("cluster")
Процедура ТестДолжен_ЗаблокироватьСеансыСКодомРазрешения() Экспорт

	Исполнитель = СоздатьИсполнителя("session", "lock");
	Исполнитель.ДобавитьОпцию("--uccode", "test-unlock-code");
	Исполнитель.ВыполнитьКоманду();
	Исполнитель.ОжидаемЧтоКодВозврата(0, "блокировка сеансов с кодом разрешения");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	КлиентыДо = КлиентыТеста.СнимокЗапущенных();
	ИмяТестовойБазы = ТестКонфигКластера.НовоеИмяТестовойБазы();
	ТестКонфигКластера.СоздатьТестовуюБазу(ИмяТестовойБазы);
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт

	// Страховка для сценариев с живым клиентом: если тест упал до своего kill,
	// сеанс мешал бы удалению базы. На пустой базе завершается мгновенно.
	Попытка
		Уборщик = СоздатьИсполнителя("session", "kill");
		Уборщик.ДобавитьФлаг("--no-lock");
		Уборщик.ВыполнитьКоманду();
	Исключение
		Сообщить("Страховочное завершение сеансов пропущено: " + ОписаниеОшибки());
	КонецПопытки;

	ТестКонфигКластера.УдалитьТестовуюБазу(ИмяТестовойБазы);

	// Клиент, чей сеанс завершён сервером, может остаться висеть процессом -
	// на Windows добиваем строго своих по PID (на Linux no-op, блокировки advisory)
	КлиентыТеста.ДождатьсяЗавершенияНовых(КлиентыДо);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсполнителя(Команда, Подкоманда = Неопределено)
	Аргументы = Новый Массив;
	Аргументы.Добавить("cluster");
	Аргументы.Добавить(Команда);
	Если Подкоманда <> Неопределено Тогда
		Аргументы.Добавить(Подкоманда);
	КонецЕсли;

	Исполнитель = Новый ИсполнительCLI(Аргументы);
	ТестКонфигКластера.ДобавитьОпцииRAS(Исполнитель);
	Исполнитель.ДобавитьОпцию("--db-name", ИмяТестовойБазы);
	Возврат Исполнитель;
КонецФункции

// Дождаться, пока запущенный клиент установит сеанс (клиент 1С стартует не мгновенно).
Процедура ДождатьсяПоявленияСеанса()

	МаксимумМс = 60000;
	ШагМс = 2000;
	НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Пока Истина Цикл

		Проверка = СоздатьИсполнителя("session", "closed");
		Проверка.ВыполнитьКоманду();
		Если Проверка.КодВозврата() <> 0 Тогда
			Возврат; // сеанс появился
		КонецЕсли;

		Если ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс > МаксимумМс Тогда
			ВызватьИсключение "Клиент 1С не установил сеанс за 60 секунд. Вывод последней проверки: "
				+ Проверка.Вывод();
		КонецЕсли;

		Приостановить(ШагМс);

	КонецЦикла;

КонецПроцедуры

#КонецОбласти
