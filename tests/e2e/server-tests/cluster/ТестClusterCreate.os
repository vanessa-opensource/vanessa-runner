// BSLLS-off
// Тестовый набор: cluster create / remove / info
// Интеграционные тесты создания и удаления ИБ в кластере.
// См. tests/e2e/utils/Модули/ТестКонфигКластера.os для настройки окружения.

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands
#Использовать "../../utils"

Перем ИмяТестовойБазы;

&Тест &Тег("cluster")
Процедура ТестДолжен_СоздатьИБВКластере() Экспорт
	Исполнитель = СоздатьИсполнителя("create");
	ТестКонфигКластера.ДобавитьОпцииСУБД(Исполнитель, ИмяТестовойБазы);
	Исполнитель.ВыполнитьКоманду();
	Исполнитель.ОжидаемЧтоКодВозврата(0, "создание ИБ в кластере");
КонецПроцедуры

&Тест &Тег("cluster")
Процедура ТестДолжен_ПолучитьИнформациюОбИБ() Экспорт
	ТестКонфигКластера.СоздатьТестовуюБазу(ИмяТестовойБазы);
	Исполнитель = СоздатьИсполнителя("info");
	Исполнитель.ВыполнитьКоманду();
	Исполнитель.ОжидаемЧтоКодВозврата(0, "получение информации об ИБ");
	Исполнитель.ОжидаемЧтоВыводСодержит(ИмяТестовойБазы);
КонецПроцедуры

&Тест &Тег("cluster")
Процедура ТестДолжен_УдалитьИБСУдалениемБД() Экспорт
	ТестКонфигКластера.СоздатьТестовуюБазу(ИмяТестовойБазы);
	Исполнитель = СоздатьИсполнителя("remove");
	Исполнитель.ДобавитьФлаг("--drop-db");
	Исполнитель.ВыполнитьКоманду();
	Исполнитель.ОжидаемЧтоКодВозврата(0, "удаление ИБ вместе с БД");
КонецПроцедуры

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	ИмяТестовойБазы = ТестКонфигКластера.НовоеИмяТестовойБазы();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ТестКонфигКластера.УдалитьТестовуюБазу(ИмяТестовойБазы);
КонецПроцедуры

Функция СоздатьИсполнителя(Подкоманда)
	Аргументы = Новый Массив;
	Аргументы.Добавить("cluster");
	Аргументы.Добавить(Подкоманда);
	Исполнитель = Новый ИсполнительCLI(Аргументы);
	ТестКонфигКластера.ДобавитьОпцииRAS(Исполнитель);
	Исполнитель.ДобавитьОпцию("--db-name", ИмяТестовойБазы);
	Возврат Исполнитель;
КонецФункции
