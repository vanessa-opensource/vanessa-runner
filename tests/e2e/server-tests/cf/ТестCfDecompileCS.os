// BSLLS-off
// Тестовый набор: cf decompile (клиент-серверный вариант)
// Интеграционные тесты разборки файла cf в исходники с использованием серверной ИБ.
// См. tests/e2e/utils/Модули/ТестКонфигКластера.os для настройки окружения.

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands
#Использовать v8runner
#Использовать "../../utils"

Перем ИмяТестовойБазы;

#Область СлужебныйПрограммныйИнтерфейс

&Тест
&Тег("cluster")
Процедура ТестДолжен_РазобратьCfЧерезКонфигуратор() Экспорт

	ПутьCf = СобратьCfИзФикстур();

	Исполнитель = СоздатьИсполнителяCfDecompile();
	Исполнитель.ДобавитьОпцию("--cf-file", ПутьCf);
	Исполнитель.ДобавитьОпцию("--ibconnection", ТестКонфигКластера.СтрокаПодключенияСервер(ИмяТестовойБазы));
	Исполнитель.ДобавитьАргумент("out");

	Исполнитель.ВыполнитьКоманду();
	Исполнитель.ОжидаемЧтоКодВозврата(0, "разборка CF через конфигуратор");
	Исполнитель.ОжидаемЧтоКаталогСуществует("out");
	Исполнитель.ОжидаемЧтоФайлСуществует(ОбъединитьПути("out", "Configuration.xml"));

КонецПроцедуры

&Тест
&Тег("cluster")
Процедура ТестДолжен_РазобратьCfЧерезIbcmd() Экспорт

	ПутьCf = СобратьCfИзФикстур();

	Исполнитель = СоздатьИсполнителяCfDecompile();
	Исполнитель.ДобавитьОпцию("--cf-file", ПутьCf);
	Исполнитель.ДобавитьФлаг("--ibcmd");
	ТестКонфигКластера.ДобавитьОпцииСУБД(Исполнитель, ИмяТестовойБазы);
	Исполнитель.ДобавитьАргумент("out");

	Исполнитель.ВыполнитьКоманду();
	Исполнитель.ОжидаемЧтоКодВозврата(0, "разборка CF через ibcmd");
	Исполнитель.ОжидаемЧтоКаталогСуществует("out");
	Исполнитель.ОжидаемЧтоФайлСуществует(ОбъединитьПути("out", "Configuration.xml"));

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	ИмяТестовойБазы = ТестКонфигКластера.НовоеИмяТестовойБазы();
	ТестКонфигКластера.СоздатьТестовуюБазу(ИмяТестовойБазы);
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ТестКонфигКластера.УдалитьТестовуюБазу(ИмяТестовойБазы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсполнителяCfDecompile()
	Аргументы = Новый Массив;
	Аргументы.Добавить("cf");
	Аргументы.Добавить("decompile");

	Исполнитель = Новый ИсполнительCLI(Аргументы);
	// Версия платформы определяется автоматически через v8find.
	Возврат Исполнитель;
КонецФункции

Функция СобратьCfИзФикстур()
	Исполнитель = СоздатьИсполнителяCfDecompile();
	КаталогБазы = ФикстурнаяФайловаяБД.СкопироватьВоВременнойКаталог();
	КаталогSrc = Исполнитель.ПутьФикстуры("cf");
	Конфигуратор = Новый УправлениеКонфигуратором;
	Конфигуратор.УстановитьКонтекст("/F""" + КаталогБазы + """", "", "");
	Конфигуратор.ЗагрузитьКонфигурациюИзФайлов(КаталогSrc);
	ПутьCf = ВременныеФайлы.НовоеИмяФайла("cf");
	Конфигуратор.ВыгрузитьКонфигурациюВФайл(ПутьCf);
	Возврат ПутьCf;
КонецФункции

#КонецОбласти
