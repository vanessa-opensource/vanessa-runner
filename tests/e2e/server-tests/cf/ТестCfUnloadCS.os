// BSLLS-off
// Тестовый набор: cf unload (клиент-серверный вариант)
// Интеграционные тесты выгрузки конфигурации из серверной ИБ в файл cf.
// См. tests/e2e/utils/Модули/ТестКонфигКластера.os для настройки окружения.

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands
#Использовать "../../utils"

Перем ИмяТестовойБазы;

#Область СлужебныйПрограммныйИнтерфейс

&Тест
&Тег("cluster")
Процедура ТестДолжен_ВыгрузитьCfЧерезКонфигуратор() Экспорт

	ЗагрузитьФикстурыВБазу();

	Исполнитель = СоздатьИсполнителяCfUnload();
	Исполнитель.ДобавитьОпцию("--ibconnection", ТестКонфигКластера.СтрокаПодключенияСервер(ИмяТестовойБазы));
	Исполнитель.ДобавитьАргумент("1Cv8.cf");

	Исполнитель.ВыполнитьКоманду();
	Исполнитель.ОжидаемЧтоКодВозврата(0, "выгрузка CF через конфигуратор");
	Исполнитель.ОжидаемЧтоФайлСуществует("1Cv8.cf");

КонецПроцедуры

&Тест
&Тег("cluster")
Процедура ТестДолжен_ВыгрузитьCfЧерезIbcmd() Экспорт

	ЗагрузитьФикстурыВБазу();

	Исполнитель = СоздатьИсполнителяCfUnload();
	Исполнитель.ДобавитьФлаг("--ibcmd");
	ТестКонфигКластера.ДобавитьОпцииСУБД(Исполнитель, ИмяТестовойБазы);
	Исполнитель.ДобавитьАргумент("1Cv8.cf");

	Исполнитель.ВыполнитьКоманду();
	Исполнитель.ОжидаемЧтоКодВозврата(0, "выгрузка CF через ibcmd");
	Исполнитель.ОжидаемЧтоФайлСуществует("1Cv8.cf");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	ИмяТестовойБазы = ТестКонфигКластера.НовоеИмяТестовойБазы();
	ТестКонфигКластера.СоздатьТестовуюБазу(ИмяТестовойБазы);
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ТестКонфигКластера.УдалитьТестовуюБазу(ИмяТестовойБазы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсполнителяCfUnload()
	Аргументы = Новый Массив;
	Аргументы.Добавить("cf");
	Аргументы.Добавить("unload");

	Исполнитель = Новый ИсполнительCLI(Аргументы);
	// Версия платформы определяется автоматически через v8find.
	Возврат Исполнитель;
КонецФункции

Процедура ЗагрузитьФикстурыВБазу()
	Аргументы = Новый Массив;
	Аргументы.Добавить("cf");
	Аргументы.Добавить("load");

	Исполнитель = Новый ИсполнительCLI(Аргументы);
	КаталогSrc = Исполнитель.ПутьФикстуры("cf");
	Исполнитель.ДобавитьОпцию("--ibconnection", ТестКонфигКластера.СтрокаПодключенияСервер(ИмяТестовойБазы));
	Исполнитель.ДобавитьФлаг("--no-update-db"); // выгрузка читает основную конфигурацию: применение к БД не требуется
	Исполнитель.ДобавитьАргумент(КаталогSrc);

	Исполнитель.ВыполнитьКоманду();
	Исполнитель.ОжидаемЧтоКодВозврата(0, "загрузка фикстур в базу (подготовка теста)");
КонецПроцедуры

#КонецОбласти
