// BSLLS-off
// Тестовый набор: cf load (клиент-серверный вариант)
// Интеграционные тесты загрузки конфигурации в серверную ИБ.
// См. tests/e2e/utils/Модули/ТестКонфигКластера.os для настройки окружения.

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands
#Использовать "../../utils"

Перем ИмяТестовойБазы;

#Область СлужебныйПрограммныйИнтерфейс

&Тест
&Тег("cluster")
Процедура ТестДолжен_ЗагрузитьИсходникиЧерезКонфигуратор() Экспорт

	Исполнитель = СоздатьИсполнителяCfLoad();
	КаталогSrc = Исполнитель.ПутьФикстуры("cf");
	Исполнитель.ДобавитьОпцию("--ibconnection", ТестКонфигКластера.СтрокаПодключенияСервер(ИмяТестовойБазы));
	Исполнитель.ДобавитьАргумент(КаталогSrc);

	Исполнитель.ВыполнитьКоманду();
	Исполнитель.ОжидаемЧтоКодВозврата(0, "загрузка исходников через конфигуратор");

КонецПроцедуры

&Тест
&Тег("cluster")
Процедура ТестДолжен_ЗагрузитьИсходникиЧерезIbcmd() Экспорт

	Исполнитель = СоздатьИсполнителяCfLoad();
	КаталогSrc = Исполнитель.ПутьФикстуры("cf");
	Исполнитель.ДобавитьФлаг("--ibcmd");
	ТестКонфигКластера.ДобавитьОпцииСУБД(Исполнитель, ИмяТестовойБазы);
	Исполнитель.ДобавитьАргумент(КаталогSrc);

	Исполнитель.ВыполнитьКоманду();
	Исполнитель.ОжидаемЧтоКодВозврата(0, "загрузка исходников через ibcmd");

КонецПроцедуры

&Тест
&Тег("cluster")
Процедура ТестДолжен_ЗагрузитьФайлCfЧерезКонфигуратор() Экспорт

	Исполнитель = СоздатьИсполнителяCfLoad();
	ФайлCf = Исполнитель.ПутьФикстуры("1cv8.cf");
	Исполнитель.ДобавитьОпцию("--ibconnection", ТестКонфигКластера.СтрокаПодключенияСервер(ИмяТестовойБазы));
	Исполнитель.ДобавитьАргумент(ФайлCf);

	Исполнитель.ВыполнитьКоманду();
	Исполнитель.ОжидаемЧтоКодВозврата(0, "загрузка CF-файла через конфигуратор");

КонецПроцедуры

&Тест
&Тег("cluster")
Процедура ТестДолжен_ЗагрузитьФайлCfЧерезIbcmd() Экспорт

	Исполнитель = СоздатьИсполнителяCfLoad();
	ФайлCf = Исполнитель.ПутьФикстуры("1cv8.cf");
	Исполнитель.ДобавитьФлаг("--ibcmd");
	ТестКонфигКластера.ДобавитьОпцииСУБД(Исполнитель, ИмяТестовойБазы);
	Исполнитель.ДобавитьАргумент(ФайлCf);

	Исполнитель.ВыполнитьКоманду();
	Исполнитель.ОжидаемЧтоКодВозврата(0, "загрузка CF-файла через ibcmd");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	ИмяТестовойБазы = ТестКонфигКластера.НовоеИмяТестовойБазы();
	ТестКонфигКластера.СоздатьТестовуюБазу(ИмяТестовойБазы);
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ТестКонфигКластера.УдалитьТестовуюБазу(ИмяТестовойБазы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсполнителяCfLoad()
	Аргументы = Новый Массив;
	Аргументы.Добавить("cf");
	Аргументы.Добавить("load");

	Исполнитель = Новый ИсполнительCLI(Аргументы);
	// Версия платформы определяется автоматически через v8find.
	// Тесты проверяют только загрузку: обновление конфигурации БД (по умолчанию) отключаем.
	Исполнитель.ДобавитьФлаг("--no-update-db");
	Возврат Исполнитель;
КонецФункции

#КонецОбласти
