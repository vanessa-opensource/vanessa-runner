// BSLLS-off
// Юнит-тесты ВыводЛогаВПотокОшибок: порог аппендера по уровню логгера-источника.
// Сам вывод в stderr здесь не перехватывается - его проверяют e2e-прогоны.

#Использовать asserts
#Использовать logos

#Использовать "../../../src/core/Приложение"

// В конфигурации аппендер стоит на DEBUG (общий пол logos), поэтому отладку
// логгера уровня INFO аппендер должен отсекать сам.
&Тест
Процедура ТестДолжен_ОтсечьОтладкуЛоггераУровняИнформация() Экспорт
	Аппендер = Новый ВыводЛогаВПотокОшибок;
	Событие = НовоеСобытие(УровниЛога.Отладка, УровниЛога.Информация);
	Ожидаем.Что(Аппендер.СобытиеПроходитПорог(Событие)).ЭтоЛожь();
КонецПроцедуры

&Тест
Процедура ТестДолжен_ПропуститьИнформациюЛоггераУровняИнформация() Экспорт
	Аппендер = Новый ВыводЛогаВПотокОшибок;
	Событие = НовоеСобытие(УровниЛога.Информация, УровниЛога.Информация);
	Ожидаем.Что(Аппендер.СобытиеПроходитПорог(Событие)).ЭтоИстина();
КонецПроцедуры

&Тест
Процедура ТестДолжен_ПропуститьОтладкуЛоггераУровняОтладка() Экспорт
	Аппендер = Новый ВыводЛогаВПотокОшибок;
	Событие = НовоеСобытие(УровниЛога.Отладка, УровниЛога.Отладка);
	Ожидаем.Что(Аппендер.СобытиеПроходитПорог(Событие)).ЭтоИстина();
КонецПроцедуры

&Тест
Процедура ТестДолжен_ПропуститьОшибкуЛоггераУровняПредупреждение() Экспорт
	Аппендер = Новый ВыводЛогаВПотокОшибок;
	Событие = НовоеСобытие(УровниЛога.Ошибка, УровниЛога.Предупреждение);
	Ожидаем.Что(Аппендер.СобытиеПроходитПорог(Событие)).ЭтоИстина();
КонецПроцедуры

Функция НовоеСобытие(Знач УровеньСобытия, Знач УровеньЛоггера)
	Возврат Новый СобытиеЛога("vrunner", УровеньСобытия, "сообщение", ТекущаяДата(), УровеньЛоггера);
КонецФункции
