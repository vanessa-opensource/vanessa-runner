// BSLLS-off
// Генератор JSON Schema файла настроек (tools/generate-settings-schema.os): схема строится
// по аннотациям команд, поэтому проверяем структуру на нескольких известных ключах.
// Один тест на набор: генерация поднимает весь контекст приложения (несколько секунд).

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands

#Область СлужебныйПрограммныйИнтерфейс

&Тест
Процедура ТестДолжен_СгенерироватьСхемуНастроек() Экспорт

	Схема = СгенерироватьСхему();

	ПроверитьКорневыеСекции(Схема);
	ПроверитьГруппыКомандыИОпции(Схема);
	ПроверитьТипыОпций(Схема);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьКорневыеСекции(Знач Схема)

	Свойства = Схема["properties"];

	Ожидаем.Что(Схема["$schema"], "черновик JSON Schema").Содержит("draft-07");
	Ожидаем.Что(Свойства["vrunner"], "секция vrunner").Заполнено();
	Ожидаем.Что(Свойства["logos"], "секция logos").Заполнено();
	Ожидаем.Что(Свойства["increment"]["properties"]["cache-dir"]["type"], "деталька increment.cache-dir").Равно("string");
	Ожидаем.Что(Свойства["coverage"]["properties"]["lines-tool"]["properties"]["version"]["description"],
		"описание детальки со значением по умолчанию").Содержит("по умолчанию");

КонецПроцедуры

Процедура ПроверитьГруппыКомандыИОпции(Знач Схема)

	Vrunner = Схема["properties"]["vrunner"];
	Группы = Vrunner["properties"];

	Ожидаем.Что(Vrunner["additionalProperties"], "неизвестные ключи запрещены").ЭтоЛожь();
	Ожидаем.Что(Группы["help"], "встроенной справки в схеме нет").ЭтоНеопределено();

	Compile = Группы["cf"]["properties"]["compile"]["properties"];
	Ожидаем.Что(Compile["src"]["type"], "опция команды").Равно("string");
	Ожидаем.Что(Compile["out"]["type"], "позиционный аргумент в нижнем регистре").Равно("string");
	Ожидаем.Что(Compile["ibcmd"]["type"], "флаг").Равно("boolean");
	Ожидаем.Что(Compile["settings"], "settings только на верхнем уровне").ЭтоНеопределено();

	Ожидаем.Что(Группы["cf"]["properties"]["src"]["type"], "опция поднята на уровень группы").Равно("string");
	Ожидаем.Что(Группы["ibconnection"]["type"], "опция поднята на корень").Равно("string");
	Ожидаем.Что(Группы["settings"]["type"], "общий ключ settings").Равно("string");
	Ожидаем.Что(Группы["log-output"]["enum"].Количество(), "перечисление log-output").Равно(2);

КонецПроцедуры

Процедура ПроверитьТипыОпций(Знач Схема)

	Xunit = Схема["properties"]["vrunner"]["properties"]["test"]["properties"]["xunit"]["properties"];

	Ожидаем.Что(Xunit["report-format"]["type"], "повторяемая опция").Равно("array");
	Ожидаем.Что(Xunit["report-format"]["items"]["type"], "элементы массива").Равно("string");
	Ожидаем.Что(Xunit["ordinaryapp"]["type"], "флаг набора опций").Равно("boolean");
	Ожидаем.Что(Xunit["ibsrv-port"]["type"], "числовая опция").Равно("number");
	Ожидаем.Что(Xunit["testspath"]["description"], "переменная окружения в описании").Содержит("VRUNNER_TESTSPATH");

	Формат = Схема["properties"]["vrunner"]["properties"]["validate"]["properties"]["syntax-check"]["properties"]["report-format"];
	Ожидаем.Что(Формат["type"], "повторяемая опция validate").Равно("array");

КонецПроцедуры

Функция СгенерироватьСхему()

	ФайлСхемы = ВременныеФайлы.НовоеИмяФайла("json");
	КореньПроекта = Новый Файл(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "..", "..")).ПолноеИмя;

	Генератор = Новый Команда;
	Генератор.УстановитьКоманду("oscript");
	Генератор.УстановитьРабочийКаталог(КореньПроекта);
	Генератор.ДобавитьПараметр("tools/generate-settings-schema.os");
	Генератор.ДобавитьПараметр(ФайлСхемы);

	КодВозврата = Генератор.Исполнить();
	Ожидаем.Что(КодВозврата, Генератор.ПолучитьВывод()).Равно(0);

	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(ФайлСхемы, "UTF-8");
	Схема = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();

	Возврат Схема;

КонецФункции

#КонецОбласти
