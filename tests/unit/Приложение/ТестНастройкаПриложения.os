// BSLLS-off
// Юнит-тесты НастройкаПриложения: каскад деталек autumn и выбор файла настроек.

#Использовать asserts
#Использовать tempfiles

#Использовать "../../../src/core/Приложение"

Перем НакопленныеВременныеФайлы;

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область Тесты

// Встроенные значения по умолчанию берутся из <пакет>/src/autumn-properties.json.
// Регрессия: путь к файлу считался на уровень выше нужного (src/core вместо src),
// и пакетные настройки молча не загружались.
&Тест
Процедура ТестДолжен_ЗагрузитьНастройкиПакета() Экспорт
	Настройка = Новый НастройкаПриложения(Новый Массив);
	Детальки = Настройка.Совет().ЗначенияДеталек();
	Логгеры = Секция(Секция(Детальки, "logos"), "logger");
	Ожидаем.Что(Логгеры.Получить("vrunner")).Равно("INFO");
КонецПроцедуры

// ---------- issue #752: локальный файл настроек поверх проектного ----------

// Ключ vrunner.settings проектного файла указывает на файл личных настроек разработчика;
// его значения перекрывают проектные, а незаданные в нём берутся из проектного файла.
&Тест
Процедура ТестДолжен_ПрименитьФайлИзКлючаSettings_ПоверхПроектного() Экспорт

	Каталог = ВременныеФайлы.СоздатьКаталог();
	ЗаписатьПроектныйФайл(Каталог,
		"{ ""vrunner"": { ""settings"": ""autumn-properties.local.json"", ""src"": ""project-src"", ""v8version"": ""8.3.24"" } }");
	ЗаписатьФайл(Каталог, "autumn-properties.local.json",
		"{ ""vrunner"": { ""src"": ""local-src"" } }");

	Настройка = Новый НастройкаПриложения(Новый Массив, Каталог);

	Ожидаем.Что(ЗначениеVrunner(Настройка.Совет().ЗначенияДеталек(), "src")).Равно("local-src");
	Ожидаем.Что(ЗначениеVrunner(Настройка.Совет().ЗначенияДеталек(), "v8version")).Равно("8.3.24");

КонецПроцедуры

// Проектный файл подразумевает локальный, а разработчик его не создал (или это CI):
// это не ошибка - действуют настройки проекта, а причина видна в описании для лога.
&Тест
Процедура ТестДолжен_ПропуститьОтсутствующийФайлИзКлючаSettings() Экспорт

	Каталог = ВременныеФайлы.СоздатьКаталог();
	ЗаписатьПроектныйФайл(Каталог,
		"{ ""vrunner"": { ""settings"": ""autumn-properties.local.json"", ""src"": ""project-src"" } }");

	Настройка = Новый НастройкаПриложения(Новый Массив, Каталог);

	Детальки = Настройка.Совет().ЗначенияДеталек();
	Ожидаем.Что(ЗначениеVrunner(Детальки, "src")).Равно("project-src");
	Ожидаем.Что(ОписаниеФайлаНастроек(Детальки)).Содержит("не найден");
	Ожидаем.Что(ОписаниеФайлаНастроек(Детальки)).Содержит("autumn-properties.local.json");

КонецПроцедуры

// Явно указанный в командной строке файл обязан существовать: молчаливая подмена настроек
// проектными - как раз та ошибка, которую сложно заметить (сборка в другой базе).
&Тест
Процедура ТестДолжен_УпастьЕслиФайлИзКоманднойСтрокиНеНайден() Экспорт

	Каталог = ВременныеФайлы.СоздатьКаталог();
	Аргументы = Новый Массив;
	Аргументы.Добавить("--settings");
	Аргументы.Добавить("нет-такого.json");

	Попытка
		Настройка = Новый НастройкаПриложения(Аргументы, Каталог);
		Ожидаем.Что(Настройка, "экземпляр не должен быть создан").Равно(Неопределено);
		ВызватьИсключение "ожидалось исключение об отсутствующем файле настроек";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("Файл настроек не найден");
		Ожидаем.Что(ОписаниеОшибки()).Содержит("нет-такого.json");
	КонецПопытки;

КонецПроцедуры

// Форма --settings=<файл> равноправна форме --settings <файл>.
&Тест
Процедура ТестДолжен_ПринятьФормуSettingsСоЗнакомРавно() Экспорт

	Каталог = ВременныеФайлы.СоздатьКаталог();
	ЗаписатьФайл(Каталог, "cli.json", "{ ""vrunner"": { ""src"": ""cli-src"" } }");
	Аргументы = Новый Массив;
	Аргументы.Добавить("--settings=cli.json");

	Настройка = Новый НастройкаПриложения(Аргументы, Каталог);

	Ожидаем.Что(ЗначениеVrunner(Настройка.Совет().ЗначенияДеталек(), "src")).Равно("cli-src");

КонецПроцедуры

// Командная строка выигрывает у ключа проектного файла: ключ - умолчание для всех,
// --settings - выбор конкретного запуска.
&Тест
Процедура ТестДолжен_ПредпочестьКоманднуюСтрокуКлючуSettings() Экспорт

	Каталог = ВременныеФайлы.СоздатьКаталог();
	ЗаписатьПроектныйФайл(Каталог,
		"{ ""vrunner"": { ""settings"": ""autumn-properties.local.json"", ""src"": ""project-src"" } }");
	ЗаписатьФайл(Каталог, "autumn-properties.local.json", "{ ""vrunner"": { ""src"": ""local-src"" } }");
	ЗаписатьФайл(Каталог, "cli.json", "{ ""vrunner"": { ""src"": ""cli-src"" } }");
	Аргументы = Новый Массив;
	Аргументы.Добавить("--settings");
	Аргументы.Добавить("cli.json");

	Настройка = Новый НастройкаПриложения(Аргументы, Каталог);

	Детальки = Настройка.Совет().ЗначенияДеталек();
	Ожидаем.Что(ЗначениеVrunner(Детальки, "src")).Равно("cli-src");
	Ожидаем.Что(ОписаниеФайлаНастроек(Детальки)).Содержит("--settings");

КонецПроцедуры

// Относительный путь из ключа считается от каталога проектного файла, а не от того,
// откуда физически запущен процесс.
&Тест
Процедура ТестДолжен_СчитатьПутьИзКлючаОтКаталогаПроекта() Экспорт

	Каталог = ВременныеФайлы.СоздатьКаталог();
	СоздатьКаталог(ОбъединитьПути(Каталог, "env"));
	ЗаписатьПроектныйФайл(Каталог, "{ ""vrunner"": { ""settings"": ""env/dev.json"" } }");
	ЗаписатьФайл(ОбъединитьПути(Каталог, "env"), "dev.json", "{ ""vrunner"": { ""src"": ""dev-src"" } }");

	Настройка = Новый НастройкаПриложения(Новый Массив, Каталог);

	Ожидаем.Что(ЗначениеVrunner(Настройка.Совет().ЗначенияДеталек(), "src")).Равно("dev-src");

КонецПроцедуры

// Без файла настроек описание для лога всё равно есть - чтобы в отладке было видно, что его не искали.
&Тест
Процедура ТестДолжен_ОписатьОтсутствиеФайлаНастроек() Экспорт

	Каталог = ВременныеФайлы.СоздатьКаталог();

	Настройка = Новый НастройкаПриложения(Новый Массив, Каталог);

	Ожидаем.Что(ОписаниеФайлаНастроек(Настройка.Совет().ЗначенияДеталек())).Равно("Файл настроек не задан");

КонецПроцедуры

// ---------- issue #753: ключ log-output ----------

// По умолчанию лог остаётся в stdout: корневой логгер logos не перенастраивается.
&Тест
Процедура ТестДолжен_ПоУмолчаниюОставитьЛогВStdout() Экспорт

	Настройка = Новый НастройкаПриложения(Новый Массив, ВременныеФайлы.СоздатьКаталог());

	Детальки = Настройка.Совет().ЗначенияДеталек();
	Ожидаем.Что(ЗначениеVrunner(Детальки, "log-output")).Равно("stdout");
	Ожидаем.Что(Секция(Секция(Детальки, "logos"), "logger").Получить("rootLogger")).Равно(Неопределено);

КонецПроцедуры

// log-output = stderr направляет корневой логгер в аппендер stderr; аппендер стоит на DEBUG,
// порог задаёт логгер (см. ВыводЛогаВПотокОшибок).
&Тест
Процедура ТестДолжен_НаправитьЛогВStderrПоКлючуLogOutput() Экспорт

	Каталог = ВременныеФайлы.СоздатьКаталог();
	ЗаписатьПроектныйФайл(Каталог, "{ ""vrunner"": { ""log-output"": ""stderr"" } }");

	Настройка = Новый НастройкаПриложения(Новый Массив, Каталог);

	Логос = Секция(Настройка.Совет().ЗначенияДеталек(), "logos");
	КорневойЛоггер = Секция(Секция(Логос, "logger"), "rootLogger");
	Ожидаем.Что(КорневойЛоггер.Получить("appenders")).Равно("stderr");
	АппендерStderr = Секция(Секция(Логос, "appender"), "stderr");
	Ожидаем.Что(АппендерStderr.Получить("type")).Равно("ВыводЛогаВПотокОшибок");
	Ожидаем.Что(АппендерStderr.Получить("level")).Равно("DEBUG");
	Ожидаем.Что(Секция(Логос, "logger").Получить("vrunner")).Равно("INFO");

КонецПроцедуры

// Переменная окружения VRUNNER_LOG_OUTPUT сильнее ключа в файле.
&Тест
Процедура ТестДолжен_ПрочитатьLogOutputИзПеременнойОкружения() Экспорт

	Каталог = ВременныеФайлы.СоздатьКаталог();
	ЗаписатьПроектныйФайл(Каталог, "{ ""vrunner"": { ""log-output"": ""stdout"" } }");

	УстановитьПеременнуюСреды("VRUNNER_LOG_OUTPUT", "stderr");
	Попытка
		Настройка = Новый НастройкаПриложения(Новый Массив, Каталог);
	Исключение
		УстановитьПеременнуюСреды("VRUNNER_LOG_OUTPUT", "");
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПеременнуюСреды("VRUNNER_LOG_OUTPUT", "");

	КорневойЛоггер = Секция(Секция(Секция(Настройка.Совет().ЗначенияДеталек(), "logos"), "logger"), "rootLogger");
	Ожидаем.Что(КорневойЛоггер.Получить("appenders")).Равно("stderr");

КонецПроцедуры

&Тест
Процедура ТестДолжен_УпастьПриНедопустимомLogOutput() Экспорт

	Каталог = ВременныеФайлы.СоздатьКаталог();
	ЗаписатьПроектныйФайл(Каталог, "{ ""vrunner"": { ""log-output"": ""file"" } }");

	Попытка
		Настройка = Новый НастройкаПриложения(Новый Массив, Каталог);
		Ожидаем.Что(Настройка, "экземпляр не должен быть создан").Равно(Неопределено);
		ВызватьИсключение "ожидалось исключение о недопустимом значении log-output";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("log-output");
		Ожидаем.Что(ОписаниеОшибки()).Содержит("file");
	КонецПопытки;

КонецПроцедуры

// Явная настройка rootLogger в проектном файле сильнее маршрутизации по log-output.
&Тест
Процедура ТестДолжен_ДатьПроектуПерекрытьМаршрутизациюЛогов() Экспорт

	Каталог = ВременныеФайлы.СоздатьКаталог();
	ЗаписатьПроектныйФайл(Каталог,
		"{ ""vrunner"": { ""log-output"": ""stderr"" },"
		+ " ""logos"": { ""logger"": { ""rootLogger"": { ""level"": ""INFO"", ""appenders"": ""console"" } } } }");

	Настройка = Новый НастройкаПриложения(Новый Массив, Каталог);

	КорневойЛоггер = Секция(Секция(Секция(Настройка.Совет().ЗначенияДеталек(), "logos"), "logger"), "rootLogger");
	Ожидаем.Что(КорневойЛоггер.Получить("appenders")).Равно("console");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Секция(Знач Родитель, Знач Имя)
	Результат = Родитель.Получить(Имя);
	Ожидаем.Что(Результат, "секция деталек " + Имя).Заполнено();
	Возврат Результат;
КонецФункции

Функция ЗначениеVrunner(Знач Детальки, Знач Ключ)
	Возврат Секция(Детальки, "vrunner").Получить(Ключ);
КонецФункции

Функция ОписаниеФайлаНастроек(Знач Детальки)
	Возврат Секция(Детальки, "vrunner-startup").Получить("settings");
КонецФункции

Процедура ЗаписатьПроектныйФайл(Знач Каталог, Знач Текст)
	ЗаписатьФайл(Каталог, "autumn-properties.json", Текст);
КонецПроцедуры

Процедура ЗаписатьФайл(Знач Каталог, Знач Имя, Знач Текст)
	Запись = Новый ЗаписьТекста(ОбъединитьПути(Каталог, Имя), КодировкаТекста.UTF8NoBOM);
	Запись.Записать(Текст);
	Запись.Закрыть();
КонецПроцедуры

#КонецОбласти
