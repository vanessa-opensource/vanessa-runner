// BSLLS-off
// Юнит-тесты НастройкаПриложения: каскад деталек autumn (пакетный, проектный, --settings, окружение),
// форматы файла настроек, однократное немонопольное чтение, маршрутизация лога по log-output. Файлы настоящие.

#Использовать asserts
#Использовать tempfiles
#Использовать "../../../src/core/Приложение"
#Использовать "../utils"

Перем Каталог;  // проектный каталог теста
Перем Читатель; // ФайловыйПоток: посторонний читатель файла настроек

&ПередКаждым
Процедура ПередКаждым() Экспорт
	Каталог = ВременныеФайлы.СоздатьКаталог();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт
	Если Читатель <> Неопределено Тогда
		Читатель.Закрыть();
	КонецЕсли;
	ВременныеФайлы.Удалить();
КонецПроцедуры

#Область НастройкиПакета

// Встроенные значения по умолчанию берутся из <пакет>/src/autumn-properties.json.
// Регрессия: путь к файлу считался на уровень выше нужного, и пакетные настройки молча не загружались.
&Тест
Процедура ТестДолжен_ЗагрузитьНастройкиПакета() Экспорт
	Ожидаем.Что(Детальки(Новый НастройкаПриложения(Новый Массив)).Параметр("logos.logger.vrunner")).Равно("INFO");
КонецПроцедуры

// Состав провайдеров autumn по умолчанию заменён полностью: autumn-properties из стандартных
// каталогов поиска (текущий каталог процесса, профиль пользователя) не подмешивается к проекту.
&Тест
Процедура ТестДолжен_ЗаменитьСоставПровайдеровПоУмолчанию() Экспорт

	Строитель = Настройка(Каталог).Совет().ПолучитьСтроительМенеджераПараметров();

	Ожидаем.Что(Строитель.Провайдер("default-json")).Равно(Неопределено);
	Ожидаем.Что(Строитель.Провайдер("project")).Равно(Неопределено);
	Ожидаем.Что(Строитель.Провайдер("package")).Не_().Равно(Неопределено);
	Ожидаем.Что(Строитель.Провайдер("env")).Не_().Равно(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область ФайлНастроек

// Ключ vrunner.settings проектного файла указывает на файл личных настроек разработчика (issue #752);
// его значения перекрывают проектные, а незаданные в нём берутся из проектного файла.
&Тест
Процедура ТестДолжен_ПрименитьФайлИзКлючаSettings_ПоверхПроектного() Экспорт

	ПроектныйФайл("{ ""vrunner"": { ""settings"": ""autumn-properties.local.json"", ""src"": ""project-src"", ""v8version"": ""8.3.24"" } }");
	ТестовыеФайлы.Файл(Каталог, "autumn-properties.local.json", "{ ""vrunner"": { ""src"": ""local-src"" } }");

	Детальки = Детальки(Настройка(Каталог));

	Ожидаем.Что(Детальки.Параметр("vrunner.src")).Равно("local-src");
	Ожидаем.Что(Детальки.Параметр("vrunner.v8version")).Равно("8.3.24");

КонецПроцедуры

// Проектный файл подразумевает локальный, а разработчик его не создал (или это CI):
// это не ошибка - действуют настройки проекта, а причина видна в описании для лога.
&Тест
Процедура ТестДолжен_ПропуститьОтсутствующийФайлИзКлючаSettings() Экспорт

	ПроектныйФайл("{ ""vrunner"": { ""settings"": ""autumn-properties.local.json"", ""src"": ""project-src"" } }");

	Детальки = Детальки(Настройка(Каталог));

	Ожидаем.Что(Детальки.Параметр("vrunner.src")).Равно("project-src");
	Ожидаем.Что(ОписаниеФайлаНастроек(Детальки)).Содержит("не найден");
	Ожидаем.Что(ОписаниеФайлаНастроек(Детальки)).Содержит("autumn-properties.local.json");

КонецПроцедуры

// Явно указанный в командной строке файл обязан существовать: молчаливая подмена настроек
// проектными - как раз та ошибка, которую сложно заметить (сборка в другой базе).
&Тест
Процедура ТестДолжен_Упасть_ЕслиФайлИзКоманднойСтрокиНеНайден() Экспорт

	Ожидаем.Что(ЭтотОбъект).Метод("Настройка", ТестовыеДанные.Массив(Каталог, ТестовыеДанные.Массив("--settings", "нет-такого.json")))
		.ВыбрасываетИсключение("Файл настроек не найден").ВыбрасываетИсключение("нет-такого.json");

КонецПроцедуры

// Форма --settings=<файл> равноправна форме --settings <файл>.
&Тест
Процедура ТестДолжен_ПринятьФормуSettingsСоЗнакомРавно() Экспорт

	ТестовыеФайлы.Файл(Каталог, "cli.json", "{ ""vrunner"": { ""src"": ""cli-src"" } }");

	Детальки = Детальки(Настройка(Каталог, ТестовыеДанные.Массив("--settings=cli.json")));

	Ожидаем.Что(Детальки.Параметр("vrunner.src")).Равно("cli-src");

КонецПроцедуры

// Командная строка выигрывает у ключа проектного файла: ключ - умолчание для всех,
// --settings - выбор конкретного запуска.
&Тест
Процедура ТестДолжен_ПредпочестьКоманднуюСтрокуКлючуSettings() Экспорт

	ПроектныйФайл("{ ""vrunner"": { ""settings"": ""autumn-properties.local.json"", ""src"": ""project-src"" } }");
	ТестовыеФайлы.Файл(Каталог, "autumn-properties.local.json", "{ ""vrunner"": { ""src"": ""local-src"" } }");
	ТестовыеФайлы.Файл(Каталог, "cli.json", "{ ""vrunner"": { ""src"": ""cli-src"" } }");

	Детальки = Детальки(Настройка(Каталог, ТестовыеДанные.Массив("--settings", "cli.json")));

	Ожидаем.Что(Детальки.Параметр("vrunner.src")).Равно("cli-src");
	Ожидаем.Что(ОписаниеФайлаНастроек(Детальки)).Содержит("--settings");

КонецПроцедуры

// Относительный путь из ключа считается от каталога проектного файла, а не от того,
// откуда физически запущен процесс.
&Тест
Процедура ТестДолжен_СчитатьПутьИзКлючаОтКаталогаПроекта() Экспорт

	ПроектныйФайл("{ ""vrunner"": { ""settings"": ""env/dev.json"" } }");
	ТестовыеФайлы.Файл(Каталог, "env/dev.json", "{ ""vrunner"": { ""src"": ""dev-src"" } }");

	Детальки = Детальки(Настройка(Каталог));

	Ожидаем.Что(Детальки.Параметр("vrunner.src")).Равно("dev-src");

КонецПроцедуры

// Без файла настроек описание для лога всё равно есть - чтобы в отладке было видно, что его не искали.
&Тест
Процедура ТестДолжен_ОписатьОтсутствиеФайлаНастроек() Экспорт
	Ожидаем.Что(ОписаниеФайлаНастроек(Детальки(Настройка(Каталог)))).Равно("Файл настроек не задан");
КонецПроцедуры

#КонецОбласти

#Область ФорматыФайлаНастроек

// Формат файла настроек определяется по расширению, поэтому YAML работает наравне с JSON.
&Тест
Процедура ТестДолжен_ПрочитатьФайлНастроекВФорматеYaml() Экспорт

	ПроектныйФайл("{ ""vrunner"": { ""src"": ""project-src"", ""v8version"": ""8.3.24"" } }");
	ТестовыеФайлы.Файл(Каталог, "local.yaml", "vrunner:" + Символы.ПС + "  src: yaml-src" + Символы.ПС);

	Детальки = Детальки(Настройка(Каталог, ТестовыеДанные.Массив("--settings=local.yaml")));

	Ожидаем.Что(Детальки.Параметр("vrunner.src")).Равно("yaml-src");
	Ожидаем.Что(Детальки.Параметр("vrunner.v8version")).Равно("8.3.24");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПрочитатьФайлНастроекВФорматеIni() Экспорт

	ТестовыеФайлы.Файл(Каталог, "local.ini", "vrunner.src=ini-src");

	Детальки = Детальки(Настройка(Каталог, ТестовыеДанные.Массив("--settings=local.ini")));

	Ожидаем.Что(Детальки.Параметр("vrunner.src")).Равно("ini-src");

КонецПроцедуры

&Тест
Процедура ТестДолжен_Упасть_НаНеподдерживаемомФорматеФайлаНастроек() Экспорт

	ТестовыеФайлы.Файл(Каталог, "local.txt", "vrunner.src=txt-src");

	Ожидаем.Что(ЭтотОбъект).Метод("Настройка", ТестовыеДанные.Массив(Каталог, ТестовыеДанные.Массив("--settings=local.txt")))
		.ВыбрасываетИсключение("Не удалось прочитать").ВыбрасываетИсключение(".txt");

КонецПроцедуры

// Менеджер параметров ошибку чтения провайдера только логирует и работает дальше без него.
// Запуск с молча потерянными настройками недопустим - битый файл роняет старт.
&Тест
Процедура ТестДолжен_Упасть_НаБитомПроектномФайле() Экспорт

	ПроектныйФайл("{ ""vrunner"": { ""src"": ");

	Ожидаем.Что(ЭтотОбъект).Метод("Настройка", ТестовыеДанные.Массив(Каталог))
		.ВыбрасываетИсключение("Не удалось прочитать").ВыбрасываетИсключение("autumn-properties.json");

КонецПроцедуры

#КонецОбласти

#Область ЧтениеФайлаНастроек

// Тот же файл одновременно читают параллельные запуски: монопольное открытие на нём падает.
&Тест
Процедура ТестДолжен_ПрочитатьФайлНастроек_ОткрытыйДругимЧитателем() Экспорт

	Читатель = ТестовыеФайлы.ОткрытьНаЧтение(ПроектныйФайл("{ ""vrunner"": { ""src"": ""project-src"" } }"));

	Ожидаем.Что(Детальки(Настройка(Каталог)).Параметр("vrunner.src")).Равно("project-src");

КонецПроцедуры

// Менеджер параметров перечитывает провайдеры и ошибку чтения глотает - повторно на диск не ходим.
&Тест
Процедура ТестДолжен_НеПеречитыватьФайлНастроекПослеСтарта() Экспорт

	ПутьФайла = ПроектныйФайл("{ ""vrunner"": { ""src"": ""project-src"" } }");
	Настройка = Настройка(Каталог);

	УдалитьФайлы(ПутьФайла);

	Ожидаем.Что(Детальки(Настройка).Параметр("vrunner.src")).Равно("project-src");

КонецПроцедуры

// Менеджер при слиянии дописывает в значения провайдеров: повторное чтение не должно их копить.
&Тест
Процедура ТестДолжен_НеНакапливатьМассивыПриПовторномЧтении() Экспорт

	ПроектныйФайл("{ ""vrunner"": { ""test"": { ""report-format"": [""junit""] } } }");
	ТестовыеФайлы.Файл(Каталог, "local.json", "{ ""vrunner"": { ""src"": ""local-src"" } }");

	Настройка = Настройка(Каталог, ТестовыеДанные.Массив("--settings=local.json"));
	Детальки(Настройка);

	Ожидаем.Что(Детальки(Настройка).Параметр("vrunner.test.report-format").Количество()).Равно(1);

КонецПроцедуры

#КонецОбласти

#Область LogOutput

// По умолчанию лог остаётся в stdout: корневой логгер logos не перенастраивается (issue #753).
&Тест
Процедура ТестДолжен_ПоУмолчаниюОставитьЛогВStdout() Экспорт

	Детальки = Детальки(Настройка(Каталог));

	Ожидаем.Что(Детальки.Параметр("vrunner.log-output")).Равно("stdout");
	Ожидаем.Что(Детальки.Параметр("logos.logger.rootLogger")).Равно(Неопределено);

КонецПроцедуры

// log-output = stderr направляет корневой логгер в аппендер stderr; аппендер стоит на DEBUG,
// порог задаёт логгер (см. ВыводЛогаВПотокОшибок).
&Тест
Процедура ТестДолжен_НаправитьЛогВStderrПоКлючуLogOutput() Экспорт

	ПроектныйФайл("{ ""vrunner"": { ""log-output"": ""stderr"" } }");

	Детальки = Детальки(Настройка(Каталог));

	Ожидаем.Что(Детальки.Параметр("logos.logger.rootLogger.appenders")).Равно("stderr");
	Ожидаем.Что(Детальки.Параметр("logos.appender.stderr.type")).Равно("ВыводЛогаВПотокОшибок");
	Ожидаем.Что(Детальки.Параметр("logos.appender.stderr.level")).Равно("DEBUG");
	Ожидаем.Что(Детальки.Параметр("logos.logger.vrunner")).Равно("INFO");

КонецПроцедуры

// Переменная окружения VRUNNER_LOG_OUTPUT сильнее ключа в файле.
&Тест
Процедура ТестДолжен_ПрочитатьLogOutputИзПеременнойОкружения() Экспорт

	ПроектныйФайл("{ ""vrunner"": { ""log-output"": ""stdout"" } }");

	УстановитьПеременнуюСреды("VRUNNER_LOG_OUTPUT", "stderr");
	Попытка
		Настройка = Настройка(Каталог);
	Исключение
		УстановитьПеременнуюСреды("VRUNNER_LOG_OUTPUT", "");
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПеременнуюСреды("VRUNNER_LOG_OUTPUT", "");

	Ожидаем.Что(Детальки(Настройка).Параметр("logos.logger.rootLogger.appenders")).Равно("stderr");

КонецПроцедуры

&Тест
Процедура ТестДолжен_Упасть_ПриНедопустимомLogOutput() Экспорт

	ПроектныйФайл("{ ""vrunner"": { ""log-output"": ""file"" } }");

	Ожидаем.Что(ЭтотОбъект).Метод("Настройка", ТестовыеДанные.Массив(Каталог))
		.ВыбрасываетИсключение("log-output").ВыбрасываетИсключение("file");

КонецПроцедуры

// Явная настройка rootLogger в проектном файле сильнее маршрутизации по log-output.
&Тест
Процедура ТестДолжен_ДатьПроектуПерекрытьМаршрутизациюЛогов() Экспорт

	ПроектныйФайл("{ ""vrunner"": { ""log-output"": ""stderr"" },"
		+ " ""logos"": { ""logger"": { ""rootLogger"": { ""level"": ""INFO"", ""appenders"": ""console"" } } } }");

	Детальки = Детальки(Настройка(Каталог));

	Ожидаем.Что(Детальки.Параметр("logos.logger.rootLogger.appenders")).Равно("console");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Настройка по проектному каталогу и аргументам командной строки.
// Экспортная: конструктор через Ожидаем.Метод напрямую не вызвать.
Функция Настройка(Знач ПроектныйКаталог, Знач Аргументы = Неопределено) Экспорт
	Возврат Новый НастройкаПриложения(Аргументы, ПроектныйКаталог);
КонецФункции

// Детальки так, как их увидит Поделка: она забирает у совета тот же строитель и читает его.
Функция Детальки(Знач Настройка)
	Строитель = Настройка.Совет().ПолучитьСтроительМенеджераПараметров();
	Строитель.Прочитать();
	Возврат Строитель;
КонецФункции

Функция ОписаниеФайлаНастроек(Знач Детальки)
	Возврат Детальки.Параметр("vrunner-startup.settings");
КонецФункции

Функция ПроектныйФайл(Знач Текст)
	Возврат ТестовыеФайлы.Файл(Каталог, "autumn-properties.json", Текст);
КонецФункции

#КонецОбласти
