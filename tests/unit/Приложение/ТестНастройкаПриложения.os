// BSLLS-off
// Юнит-тесты НастройкаПриложения: каскад деталек autumn и выбор файла настроек.

#Использовать asserts
#Использовать tempfiles

#Использовать "../../../src/core/Приложение"
#Использовать "../../../src/core/Файлы"

Перем НакопленныеВременныеФайлы;

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область Тесты

// Встроенные значения по умолчанию берутся из <пакет>/src/autumn-properties.json.
// Регрессия: путь к файлу считался на уровень выше нужного (src/core вместо src),
// и пакетные настройки молча не загружались.
&Тест
Процедура ТестДолжен_ЗагрузитьНастройкиПакета() Экспорт
	Настройка = Новый НастройкаПриложения(Новый Массив);
	Ожидаем.Что(Детальки(Настройка).Параметр("logos.logger.vrunner")).Равно("INFO");
КонецПроцедуры

// ---------- issue #752: локальный файл настроек поверх проектного ----------

// Ключ vrunner.settings проектного файла указывает на файл личных настроек разработчика;
// его значения перекрывают проектные, а незаданные в нём берутся из проектного файла.
&Тест
Процедура ТестДолжен_ПрименитьФайлИзКлючаSettings_ПоверхПроектного() Экспорт

	Каталог = ВременныеФайлы.СоздатьКаталог();
	ЗаписатьПроектныйФайл(Каталог,
		"{ ""vrunner"": { ""settings"": ""autumn-properties.local.json"", ""src"": ""project-src"", ""v8version"": ""8.3.24"" } }");
	ЗаписатьФайл(Каталог, "autumn-properties.local.json",
		"{ ""vrunner"": { ""src"": ""local-src"" } }");

	Настройка = Новый НастройкаПриложения(Новый Массив, Каталог);

	Детальки = Детальки(Настройка);
	Ожидаем.Что(Детальки.Параметр("vrunner.src")).Равно("local-src");
	Ожидаем.Что(Детальки.Параметр("vrunner.v8version")).Равно("8.3.24");

КонецПроцедуры

// Проектный файл подразумевает локальный, а разработчик его не создал (или это CI):
// это не ошибка - действуют настройки проекта, а причина видна в описании для лога.
&Тест
Процедура ТестДолжен_ПропуститьОтсутствующийФайлИзКлючаSettings() Экспорт

	Каталог = ВременныеФайлы.СоздатьКаталог();
	ЗаписатьПроектныйФайл(Каталог,
		"{ ""vrunner"": { ""settings"": ""autumn-properties.local.json"", ""src"": ""project-src"" } }");

	Настройка = Новый НастройкаПриложения(Новый Массив, Каталог);

	Детальки = Детальки(Настройка);
	Ожидаем.Что(Детальки.Параметр("vrunner.src")).Равно("project-src");
	Ожидаем.Что(ОписаниеФайлаНастроек(Детальки)).Содержит("не найден");
	Ожидаем.Что(ОписаниеФайлаНастроек(Детальки)).Содержит("autumn-properties.local.json");

КонецПроцедуры

// Явно указанный в командной строке файл обязан существовать: молчаливая подмена настроек
// проектными - как раз та ошибка, которую сложно заметить (сборка в другой базе).
&Тест
Процедура ТестДолжен_УпастьЕслиФайлИзКоманднойСтрокиНеНайден() Экспорт

	Каталог = ВременныеФайлы.СоздатьКаталог();
	Аргументы = Новый Массив;
	Аргументы.Добавить("--settings");
	Аргументы.Добавить("нет-такого.json");

	Попытка
		Настройка = Новый НастройкаПриложения(Аргументы, Каталог);
		Ожидаем.Что(Настройка, "экземпляр не должен быть создан").Равно(Неопределено);
		ВызватьИсключение "ожидалось исключение об отсутствующем файле настроек";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("Файл настроек не найден");
		Ожидаем.Что(ОписаниеОшибки()).Содержит("нет-такого.json");
	КонецПопытки;

КонецПроцедуры

// Форма --settings=<файл> равноправна форме --settings <файл>.
&Тест
Процедура ТестДолжен_ПринятьФормуSettingsСоЗнакомРавно() Экспорт

	Каталог = ВременныеФайлы.СоздатьКаталог();
	ЗаписатьФайл(Каталог, "cli.json", "{ ""vrunner"": { ""src"": ""cli-src"" } }");
	Аргументы = Новый Массив;
	Аргументы.Добавить("--settings=cli.json");

	Настройка = Новый НастройкаПриложения(Аргументы, Каталог);

	Ожидаем.Что(Детальки(Настройка).Параметр("vrunner.src")).Равно("cli-src");

КонецПроцедуры

// Командная строка выигрывает у ключа проектного файла: ключ - умолчание для всех,
// --settings - выбор конкретного запуска.
&Тест
Процедура ТестДолжен_ПредпочестьКоманднуюСтрокуКлючуSettings() Экспорт

	Каталог = ВременныеФайлы.СоздатьКаталог();
	ЗаписатьПроектныйФайл(Каталог,
		"{ ""vrunner"": { ""settings"": ""autumn-properties.local.json"", ""src"": ""project-src"" } }");
	ЗаписатьФайл(Каталог, "autumn-properties.local.json", "{ ""vrunner"": { ""src"": ""local-src"" } }");
	ЗаписатьФайл(Каталог, "cli.json", "{ ""vrunner"": { ""src"": ""cli-src"" } }");
	Аргументы = Новый Массив;
	Аргументы.Добавить("--settings");
	Аргументы.Добавить("cli.json");

	Настройка = Новый НастройкаПриложения(Аргументы, Каталог);

	Детальки = Детальки(Настройка);
	Ожидаем.Что(Детальки.Параметр("vrunner.src")).Равно("cli-src");
	Ожидаем.Что(ОписаниеФайлаНастроек(Детальки)).Содержит("--settings");

КонецПроцедуры

// Относительный путь из ключа считается от каталога проектного файла, а не от того,
// откуда физически запущен процесс.
&Тест
Процедура ТестДолжен_СчитатьПутьИзКлючаОтКаталогаПроекта() Экспорт

	Каталог = ВременныеФайлы.СоздатьКаталог();
	СоздатьКаталог(ОбъединитьПути(Каталог, "env"));
	ЗаписатьПроектныйФайл(Каталог, "{ ""vrunner"": { ""settings"": ""env/dev.json"" } }");
	ЗаписатьФайл(ОбъединитьПути(Каталог, "env"), "dev.json", "{ ""vrunner"": { ""src"": ""dev-src"" } }");

	Настройка = Новый НастройкаПриложения(Новый Массив, Каталог);

	Ожидаем.Что(Детальки(Настройка).Параметр("vrunner.src")).Равно("dev-src");

КонецПроцедуры

// Без файла настроек описание для лога всё равно есть - чтобы в отладке было видно, что его не искали.
&Тест
Процедура ТестДолжен_ОписатьОтсутствиеФайлаНастроек() Экспорт

	Каталог = ВременныеФайлы.СоздатьКаталог();

	Настройка = Новый НастройкаПриложения(Новый Массив, Каталог);

	Ожидаем.Что(ОписаниеФайлаНастроек(Детальки(Настройка))).Равно("Файл настроек не задан");

КонецПроцедуры

// ---------- источники деталек через строитель менеджера параметров autumn ----------

// Формат файла настроек определяется по расширению, поэтому YAML работает наравне с JSON.
&Тест
Процедура ТестДолжен_ПрочитатьФайлНастроекВФорматеYaml() Экспорт

	Каталог = ВременныеФайлы.СоздатьКаталог();
	ЗаписатьПроектныйФайл(Каталог, "{ ""vrunner"": { ""src"": ""project-src"", ""v8version"": ""8.3.24"" } }");
	ЗаписатьФайл(Каталог, "local.yaml", "vrunner:" + Символы.ПС + "  src: yaml-src" + Символы.ПС);
	Аргументы = Новый Массив;
	Аргументы.Добавить("--settings=local.yaml");

	Настройка = Новый НастройкаПриложения(Аргументы, Каталог);

	Детальки = Детальки(Настройка);
	Ожидаем.Что(Детальки.Параметр("vrunner.src")).Равно("yaml-src");
	Ожидаем.Что(Детальки.Параметр("vrunner.v8version")).Равно("8.3.24");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПрочитатьФайлНастроекВФорматеIni() Экспорт

	Каталог = ВременныеФайлы.СоздатьКаталог();
	ЗаписатьФайл(Каталог, "local.ini", "vrunner.src=ini-src");
	Аргументы = Новый Массив;
	Аргументы.Добавить("--settings=local.ini");

	Настройка = Новый НастройкаПриложения(Аргументы, Каталог);

	Ожидаем.Что(Детальки(Настройка).Параметр("vrunner.src")).Равно("ini-src");

КонецПроцедуры

&Тест
Процедура ТестДолжен_УпастьНаНеподдерживаемомФорматеФайлаНастроек() Экспорт

	Каталог = ВременныеФайлы.СоздатьКаталог();
	ЗаписатьФайл(Каталог, "local.txt", "vrunner.src=txt-src");
	Аргументы = Новый Массив;
	Аргументы.Добавить("--settings=local.txt");

	Попытка
		Настройка = Новый НастройкаПриложения(Аргументы, Каталог);
		Ожидаем.Что(Настройка, "экземпляр не должен быть создан").Равно(Неопределено);
		ВызватьИсключение "ожидалось исключение о неподдерживаемом формате файла настроек";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("Не удалось прочитать");
		Ожидаем.Что(ОписаниеОшибки()).Содержит(".txt");
	КонецПопытки;

КонецПроцедуры

// Менеджер параметров ошибку чтения провайдера только логирует и работает дальше без него.
// Запуск с молча потерянными настройками недопустим - битый файл роняет старт.
&Тест
Процедура ТестДолжен_УпастьНаБитомПроектномФайле() Экспорт

	Каталог = ВременныеФайлы.СоздатьКаталог();
	ЗаписатьПроектныйФайл(Каталог, "{ ""vrunner"": { ""src"": ");

	Попытка
		Настройка = Новый НастройкаПриложения(Новый Массив, Каталог);
		Ожидаем.Что(Настройка, "экземпляр не должен быть создан").Равно(Неопределено);
		ВызватьИсключение "ожидалось исключение о нечитаемом файле настроек";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("Не удалось прочитать");
		Ожидаем.Что(ОписаниеОшибки()).Содержит("autumn-properties.json");
	КонецПопытки;

КонецПроцедуры

// Состав провайдеров autumn по умолчанию заменён полностью: autumn-properties из стандартных
// каталогов поиска (текущий каталог процесса, профиль пользователя) не подмешивается к проекту,
// заданному явным рабочим каталогом.
&Тест
Процедура ТестДолжен_ЗаменитьСоставПровайдеровПоУмолчанию() Экспорт

	Настройка = Новый НастройкаПриложения(Новый Массив, ВременныеФайлы.СоздатьКаталог());

	Строитель = Настройка.Совет().ПолучитьСтроительМенеджераПараметров();
	Ожидаем.Что(Строитель.Провайдер("default-json")).Равно(Неопределено);
	Ожидаем.Что(Строитель.Провайдер("project")).Равно(Неопределено);
	Ожидаем.Что(Строитель.Провайдер("package")).Не_().Равно(Неопределено);
	Ожидаем.Что(Строитель.Провайдер("env")).Не_().Равно(Неопределено);

КонецПроцедуры

// ---------- файл настроек читается один раз и не монопольно ----------

// Тот же файл одновременно читают параллельные запуски: монопольное открытие на нём падает.
&Тест
Процедура ТестДолжен_ПрочитатьФайлНастроекОткрытыйДругимЧитателем() Экспорт

	Каталог = ВременныеФайлы.СоздатьКаталог();
	ЗаписатьПроектныйФайл(Каталог, "{ ""vrunner"": { ""src"": ""project-src"" } }");

	Поток = Новый ФайловыйПоток(ОбъединитьПути(Каталог, "autumn-properties.json"),
		РежимОткрытияФайла.Открыть, ДоступКФайлу.Чтение);
	Попытка
		Настройка = Новый НастройкаПриложения(Новый Массив, Каталог);
		Значение = Детальки(Настройка).Параметр("vrunner.src");
	Исключение
		Поток.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	Поток.Закрыть();

	Ожидаем.Что(Значение).Равно("project-src");

КонецПроцедуры

// Менеджер параметров перечитывает провайдеры и ошибку чтения глотает - повторно на диск не ходим.
&Тест
Процедура ТестДолжен_НеПеречитыватьФайлНастроекПослеСтарта() Экспорт

	Каталог = ВременныеФайлы.СоздатьКаталог();
	ЗаписатьПроектныйФайл(Каталог, "{ ""vrunner"": { ""src"": ""project-src"" } }");
	Настройка = Новый НастройкаПриложения(Новый Массив, Каталог);

	УдалитьФайлы(ОбъединитьПути(Каталог, "autumn-properties.json"));

	Ожидаем.Что(Детальки(Настройка).Параметр("vrunner.src")).Равно("project-src");

КонецПроцедуры

// Менеджер при слиянии дописывает в значения провайдеров: повторное чтение не должно их копить.
&Тест
Процедура ТестДолжен_НеНакапливатьМассивыПриПовторномЧтении() Экспорт

	Каталог = ВременныеФайлы.СоздатьКаталог();
	ЗаписатьПроектныйФайл(Каталог, "{ ""vrunner"": { ""test"": { ""report-format"": [""junit""] } } }");
	ЗаписатьФайл(Каталог, "local.json", "{ ""vrunner"": { ""src"": ""local-src"" } }");
	Аргументы = Новый Массив;
	Аргументы.Добавить("--settings=local.json");

	Настройка = Новый НастройкаПриложения(Аргументы, Каталог);
	Детальки(Настройка);

	Ожидаем.Что(Детальки(Настройка).Параметр("vrunner.test.report-format").Количество()).Равно(1);

КонецПроцедуры

// ---------- issue #753: ключ log-output ----------

// По умолчанию лог остаётся в stdout: корневой логгер logos не перенастраивается.
&Тест
Процедура ТестДолжен_ПоУмолчаниюОставитьЛогВStdout() Экспорт

	Настройка = Новый НастройкаПриложения(Новый Массив, ВременныеФайлы.СоздатьКаталог());

	Детальки = Детальки(Настройка);
	Ожидаем.Что(Детальки.Параметр("vrunner.log-output")).Равно("stdout");
	Ожидаем.Что(Детальки.Параметр("logos.logger.rootLogger")).Равно(Неопределено);

КонецПроцедуры

// log-output = stderr направляет корневой логгер в аппендер stderr; аппендер стоит на DEBUG,
// порог задаёт логгер (см. ВыводЛогаВПотокОшибок).
&Тест
Процедура ТестДолжен_НаправитьЛогВStderrПоКлючуLogOutput() Экспорт

	Каталог = ВременныеФайлы.СоздатьКаталог();
	ЗаписатьПроектныйФайл(Каталог, "{ ""vrunner"": { ""log-output"": ""stderr"" } }");

	Настройка = Новый НастройкаПриложения(Новый Массив, Каталог);

	Детальки = Детальки(Настройка);
	Ожидаем.Что(Детальки.Параметр("logos.logger.rootLogger.appenders")).Равно("stderr");
	Ожидаем.Что(Детальки.Параметр("logos.appender.stderr.type")).Равно("ВыводЛогаВПотокОшибок");
	Ожидаем.Что(Детальки.Параметр("logos.appender.stderr.level")).Равно("DEBUG");
	Ожидаем.Что(Детальки.Параметр("logos.logger.vrunner")).Равно("INFO");

КонецПроцедуры

// Переменная окружения VRUNNER_LOG_OUTPUT сильнее ключа в файле.
&Тест
Процедура ТестДолжен_ПрочитатьLogOutputИзПеременнойОкружения() Экспорт

	Каталог = ВременныеФайлы.СоздатьКаталог();
	ЗаписатьПроектныйФайл(Каталог, "{ ""vrunner"": { ""log-output"": ""stdout"" } }");

	УстановитьПеременнуюСреды("VRUNNER_LOG_OUTPUT", "stderr");
	Попытка
		Настройка = Новый НастройкаПриложения(Новый Массив, Каталог);
	Исключение
		УстановитьПеременнуюСреды("VRUNNER_LOG_OUTPUT", "");
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПеременнуюСреды("VRUNNER_LOG_OUTPUT", "");

	Ожидаем.Что(Детальки(Настройка).Параметр("logos.logger.rootLogger.appenders")).Равно("stderr");

КонецПроцедуры

&Тест
Процедура ТестДолжен_УпастьПриНедопустимомLogOutput() Экспорт

	Каталог = ВременныеФайлы.СоздатьКаталог();
	ЗаписатьПроектныйФайл(Каталог, "{ ""vrunner"": { ""log-output"": ""file"" } }");

	Попытка
		Настройка = Новый НастройкаПриложения(Новый Массив, Каталог);
		Ожидаем.Что(Настройка, "экземпляр не должен быть создан").Равно(Неопределено);
		ВызватьИсключение "ожидалось исключение о недопустимом значении log-output";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("log-output");
		Ожидаем.Что(ОписаниеОшибки()).Содержит("file");
	КонецПопытки;

КонецПроцедуры

// Явная настройка rootLogger в проектном файле сильнее маршрутизации по log-output.
&Тест
Процедура ТестДолжен_ДатьПроектуПерекрытьМаршрутизациюЛогов() Экспорт

	Каталог = ВременныеФайлы.СоздатьКаталог();
	ЗаписатьПроектныйФайл(Каталог,
		"{ ""vrunner"": { ""log-output"": ""stderr"" },"
		+ " ""logos"": { ""logger"": { ""rootLogger"": { ""level"": ""INFO"", ""appenders"": ""console"" } } } }");

	Настройка = Новый НастройкаПриложения(Новый Массив, Каталог);

	Ожидаем.Что(Детальки(Настройка).Параметр("logos.logger.rootLogger.appenders")).Равно("console");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Детальки так, как их увидит Поделка: она забирает у совета тот же строитель и читает его.
Функция Детальки(Знач Настройка)
	Строитель = Настройка.Совет().ПолучитьСтроительМенеджераПараметров();
	Строитель.Прочитать();
	Возврат Строитель;
КонецФункции

Функция ОписаниеФайлаНастроек(Знач Детальки)
	Возврат Детальки.Параметр("vrunner-startup.settings");
КонецФункции

Процедура ЗаписатьПроектныйФайл(Знач Каталог, Знач Текст)
	ЗаписатьФайл(Каталог, "autumn-properties.json", Текст);
КонецПроцедуры

Процедура ЗаписатьФайл(Знач Каталог, Знач Имя, Знач Текст)
	Запись = Новый ЗаписьТекста(ОбъединитьПути(Каталог, Имя), КодировкаТекста.UTF8NoBOM);
	Запись.Записать(Текст);
	Запись.Закрыть();
КонецПроцедуры

#КонецОбласти
