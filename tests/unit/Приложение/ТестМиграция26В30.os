// BSLLS-off
// Регрессии миграции настроек vanessa-runner 2.x -> 3.0.

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands

Перем НакопленныеВременныеФайлы;

#Область СлужебныйПрограммныйИнтерфейс

&Тест
Процедура ТестДолжен_ПереименоватьPathVanessaВBddrunnerPath() Экспорт

	// Дано
	Каталог = ВременныеФайлы.СоздатьКаталог();
	ФайлВвода = ОбъединитьПути(Каталог, "vrunner.json");
	ФайлВывода = ОбъединитьПути(Каталог, "autumn-properties.json");
	ЗаписатьТекст(ФайлВвода,
		"{""vanessa"":{""--pathvanessa"":""./tools/vanessa-automation-single.epf""}}");

	КореньПроекта = Новый Файл(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "..", "..")).ПолноеИмя;
	КомандаМиграции = Новый Команда;
	КомандаМиграции.УстановитьКоманду("oscript");
	КомандаМиграции.УстановитьРабочийКаталог(КореньПроекта);
	КомандаМиграции.ДобавитьПараметр("tools/migrate26to30.os");
	КомандаМиграции.ДобавитьПараметр("--input");
	КомандаМиграции.ДобавитьПараметр(ФайлВвода);
	КомандаМиграции.ДобавитьПараметр("--output");
	КомандаМиграции.ДобавитьПараметр(ФайлВывода);

	// Когда
	КодВозврата = КомандаМиграции.Исполнить();

	// Тогда
	Ожидаем.Что(КодВозврата, КомандаМиграции.ПолучитьВывод()).Равно(0);
	Результат = ПрочитатьФайлJSON(ФайлВывода);
	НастройкиVanessa = Результат["vrunner"]["test"]["vanessa"];
	Ожидаем.Что(НастройкиVanessa["bddrunner-path"]).Равно("./tools/vanessa-automation-single.epf");
	Ожидаем.Что(НастройкиVanessa["pathvanessa"]).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПеренестиСекциюUpdateВCfVendorUpdate() Экспорт

	// Дано
	Каталог = ВременныеФайлы.СоздатьКаталог();
	ФайлВвода = ОбъединитьПути(Каталог, "vrunner.json");
	ФайлВывода = ОбъединитьПути(Каталог, "autumn-properties.json");
	ЗаписатьТекст(ФайлВвода,
		"{""update"":{""--src"":""./updates/1cv8_$version.cfu"",""--update-settings"":""./us.xml""}}");

	КореньПроекта = Новый Файл(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "..", "..")).ПолноеИмя;
	КомандаМиграции = Новый Команда;
	КомандаМиграции.УстановитьКоманду("oscript");
	КомандаМиграции.УстановитьРабочийКаталог(КореньПроекта);
	КомандаМиграции.ДобавитьПараметр("tools/migrate26to30.os");
	КомандаМиграции.ДобавитьПараметр("--input");
	КомандаМиграции.ДобавитьПараметр(ФайлВвода);
	КомандаМиграции.ДобавитьПараметр("--output");
	КомандаМиграции.ДобавитьПараметр(ФайлВывода);

	// Когда
	КодВозврата = КомандаМиграции.Исполнить();

	// Тогда
	Ожидаем.Что(КодВозврата, КомандаМиграции.ПолучитьВывод()).Равно(0);
	Результат = ПрочитатьФайлJSON(ФайлВывода);
	НастройкиКоманды = Результат["vrunner"]["cf"]["vendor-update"];
	Ожидаем.Что(НастройкиКоманды["src"]).Равно("./updates/1cv8_$version.cfu");
	Ожидаем.Что(НастройкиКоманды["update-settings"]).Равно("./us.xml");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаписатьТекст(Знач Путь, Знач Текст)
	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Запись.Записать(Текст);
	Запись.Закрыть();
КонецПроцедуры

Функция ПрочитатьФайлJSON(Знач Путь)
	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(Путь, "UTF-8");
	Результат = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Результат;
КонецФункции

#КонецОбласти
