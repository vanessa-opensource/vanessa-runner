// BSLLS-off
// Регрессии миграции настроек vanessa-runner 2.x -> 3.0 (tools/migrate26to30.os): переименование
// ключей, перенос секций и позиционных аргументов. Скрипт запускается отдельным процессом oscript.

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands
#Использовать "../utils"

&ПослеКаждого
Процедура ПослеКаждого() Экспорт
	ВременныеФайлы.Удалить();
КонецПроцедуры

#Область Миграция

&Тест
Процедура ТестДолжен_ПереименоватьPathVanessaВBddrunnerPath() Экспорт

	Миграция = Мигрировать("{""vanessa"":{""--pathvanessa"":""./tools/vanessa-automation-single.epf""}}");

	НастройкиVanessa = Миграция.Настройки["vrunner"]["test"]["vanessa"];
	Ожидаем.Что(НастройкиVanessa["bddrunner-path"]).Равно("./tools/vanessa-automation-single.epf");
	Ожидаем.Что(НастройкиVanessa["pathvanessa"]).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПеренестиСекциюUpdateВCfVendorUpdate() Экспорт

	Миграция = Мигрировать("{""update"":{""--src"":""./updates/1cv8_$version.cfu"",""--update-settings"":""./us.xml""}}");

	НастройкиКоманды = Миграция.Настройки["vrunner"]["cf"]["vendor-update"];
	Ожидаем.Что(НастройкиКоманды["src"]).Равно("./updates/1cv8_$version.cfu");
	Ожидаем.Что(НастройкиКоманды["update-settings"]).Равно("./us.xml");

КонецПроцедуры

// Позиционный аргумент testsPath переносится ключом testspath: в 3.0 он читается из настроек.
&Тест
Процедура ТестДолжен_ПеренестиTestsPathВКлючTestspath() Экспорт

	Миграция = Мигрировать("{""xunit"":{""testsPath"":""./tests"",""--ibconnection"":""/F./ib""}}");

	НастройкиКоманды = Миграция.Настройки["vrunner"]["test"]["xunit"];
	Ожидаем.Что(НастройкиКоманды["testspath"]).Равно("./tests");
	Ожидаем.Что(НастройкиКоманды["ibconnection"]).Равно("/F./ib");
	Ожидаем.Что(СтрНайти(Миграция.Вывод, "testsPath не переносится")).Равно(0);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Прогнать мигратор над настройками 2.x; код возврата проверяется здесь же.
//
// Возвращаемое значение:
//   Структура - Настройки (Соответствие из autumn-properties.json), Вывод (Строка)
//
Функция Мигрировать(Знач ТекстНастроек)

	ФайлВвода = ТестовыеФайлы.ВременныйФайл("json", ТекстНастроек);
	ФайлВывода = ВременныеФайлы.НовоеИмяФайла("json");

	КомандаМиграции = Новый Команда;
	КомандаМиграции.УстановитьКоманду("oscript");
	КомандаМиграции.УстановитьРабочийКаталог(Новый Файл(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "..", "..")).ПолноеИмя);
	КомандаМиграции.ДобавитьПараметр("tools/migrate26to30.os");
	КомандаМиграции.ДобавитьПараметр("--input");
	КомандаМиграции.ДобавитьПараметр(ФайлВвода);
	КомандаМиграции.ДобавитьПараметр("--output");
	КомандаМиграции.ДобавитьПараметр(ФайлВывода);

	КодВозврата = КомандаМиграции.Исполнить();
	Ожидаем.Что(КодВозврата, КомандаМиграции.ПолучитьВывод()).Равно(0);

	Возврат Новый Структура("Настройки, Вывод", ТестовыеФайлы.ПрочитатьJSON(ФайлВывода), КомандаМиграции.ПолучитьВывод());

КонецФункции

#КонецОбласти
