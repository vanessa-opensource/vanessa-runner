// BSLLS-off
// Юнит-тесты СервисОкружения: корень пакета, рабочий каталог, каталог vanessa-add, каталог системных
// библиотек по oscript.cfg движка. Файловая система и окружение настоящие.

#Использовать asserts
#Использовать tempfiles
#Использовать "../utils"

Перем Сервис;

&ПередКаждым
Процедура ПередКаждым() Экспорт
	Сервис = Новый Стенд().Сервис("СервисОкружения");
КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт
	ВременныеФайлы.Удалить();
КонецПроцедуры

#Область КорневойКаталогПакета

&Тест
Процедура ТестДолжен_ВернутьКорневойКаталогПакета() Экспорт

	// tests/unit/Приложение/<этот файл> - корень репозитория на три уровня выше
	КаталогТеста = Новый Файл(ТекущийСценарий().Источник).Путь;
	Ожидаемый = Новый Файл(ОбъединитьПути(КаталогТеста, "..", "..", "..")).ПолноеИмя;

	Ожидаем.Что(Сервис.КорневойКаталогПакета()).Равно(Ожидаемый);
	Ожидаем.Что(ТестовыеФайлы.Существует(ОбъединитьПути(Сервис.КорневойКаталогПакета(), "packagedef")),
		"в корне пакета лежит packagedef").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область РабочийКаталог

&Тест
Процедура ТестДолжен_ВернутьРабочийКаталогЗапуска() Экспорт
	Ожидаем.Что(Сервис.РабочийКаталог()).Равно(ТекущийКаталог());
КонецПроцедуры

#КонецОбласти

#Область КаталогVanessaADD

&Тест
Процедура ТестДолжен_ВернутьСуществующийКаталогADD_ИлиПустуюСтроку() Экспорт

	// Пакет vanessa-add может быть не установлен: тогда честный ответ - пустая строка,
	// а не путь в никуда. Если установлен - это каталог add, который существует.
	Каталог = Сервис.КаталогVanessaADD();

	Если ЗначениеЗаполнено(Каталог) Тогда
		Ожидаем.Что(Новый Файл(Каталог).Имя).Равно("add");
		Ожидаем.Что(Новый Файл(Каталог).ЭтоКаталог(), "каталог add существует: " + Каталог).ЭтоИстина();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область КаталогСистемныхБиблиотек

&Тест
Процедура ТестДолжен_ПрочитатьКаталогБиблиотек_ИзКонфигаДвижка() Экспорт

	КаталогДвижка = КаталогДвижкаСКонфигом(
		"# Конфигурационный файл OneScript" + Символы.ПС
		+ "lib.additional = ./extra" + Символы.ПС
		+ "  lib.system =  ../lib  " + Символы.ПС
		+ "encoding.script = utf-8" + Символы.ПС);

	Ожидаем.Что(Сервис.КаталогСистемныхБиблиотек(КаталогДвижка)).Равно(КаталогLib(КаталогДвижка));

КонецПроцедуры

// Конфиг движка читает каждый стартующий oscript.
&Тест
Процедура ТестДолжен_ПрочитатьКонфигДвижка_ОткрытыйДругимЧитателем() Экспорт

	КаталогДвижка = КаталогДвижкаСКонфигом("lib.system = ../lib" + Символы.ПС);

	Поток = Новый ФайловыйПоток(ОбъединитьПути(КаталогДвижка, "oscript.cfg"),
		РежимОткрытияФайла.Открыть, ДоступКФайлу.Чтение);
	Каталог = Сервис.КаталогСистемныхБиблиотек(КаталогДвижка);
	Поток.Закрыть();

	Ожидаем.Что(Каталог).Равно(КаталогLib(КаталогДвижка));

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИгнорироватьЗакомментированныйLibSystem() Экспорт

	КаталогДвижка = КаталогДвижкаСКонфигом("#lib.system = ../lib" + Символы.ПС + "lib.additional = ./x" + Символы.ПС);

	Ожидаем.Что(Сервис.КаталогСистемныхБиблиотек(КаталогДвижка)).Равно("");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьПустуюСтроку_ЕслиКонфигаДвижкаНет() Экспорт
	Ожидаем.Что(Сервис.КаталогСистемныхБиблиотек(ВременныеФайлы.СоздатьКаталог())).Равно("");
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Временный каталог движка с oscript.cfg заданного содержимого.
Функция КаталогДвижкаСКонфигом(Знач Текст)
	КаталогДвижка = ВременныеФайлы.СоздатьКаталог();
	ТестовыеФайлы.Файл(КаталогДвижка, "oscript.cfg", Текст);
	Возврат КаталогДвижка;
КонецФункции

// Полный путь каталога lib рядом с каталогом движка (lib.system = ../lib).
Функция КаталогLib(Знач КаталогДвижка)
	Возврат Новый Файл(ОбъединитьПути(КаталогДвижка, "..", "lib")).ПолноеИмя;
КонецФункции

#КонецОбласти
