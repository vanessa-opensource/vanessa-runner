// BSLLS-off
// Юнит-тесты СервисОкружения: пути пакета, работающего движка OneScript и vanessa-add.
// Сервис не должен запускать where/which ради путей, которые движок знает сам.

#Использовать asserts
#Использовать tempfiles

#Использовать "../../../src/core/Приложение"

Перем Сервис;

#Область СлужебныйПрограммныйИнтерфейс

&Тест
Процедура ТестДолжен_ВернутьКорневойКаталогПакета() Экспорт

	// tests/unit/Приложение/<этот файл> - корень репозитория на три уровня выше
	КаталогТеста = Новый Файл(ТекущийСценарий().Источник).Путь;
	Ожидаемый = Новый Файл(ОбъединитьПути(КаталогТеста, "..", "..", "..")).ПолноеИмя;

	Ожидаем.Что(Сервис.КорневойКаталогПакета()).Равно(Ожидаемый);
	Ожидаем.Что(Новый Файл(ОбъединитьПути(Сервис.КорневойКаталогПакета(), "packagedef")).Существует(),
		"в корне пакета лежит packagedef").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьРабочийКаталогЗапуска() Экспорт
	Ожидаем.Что(Сервис.РабочийКаталог()).Равно(ТекущийКаталог());
КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиИсполняемыйФайлРаботающегоДвижка() Экспорт

	Путь = Сервис.ПутьОСкрипт();

	Ожидаем.Что(Путь, "путь к oscript").Заполнено();
	Ожидаем.Что(Новый Файл(Путь).Существует(), "файл движка существует: " + Путь).ЭтоИстина();
	Ожидаем.Что(СтрНачинаетсяС(НРег(Новый Файл(Путь).Имя), "oscript"), "имя файла: " + Путь).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПрочитатьКаталогБиблиотекИзКонфигаДвижка() Экспорт

	КаталогДвижка = ВременныеФайлы.СоздатьКаталог();
	ЗаписатьКонфиг(КаталогДвижка,
		"# Конфигурационный файл OneScript" + Символы.ПС
		+ "lib.additional = ./extra" + Символы.ПС
		+ "  lib.system =  ../lib  " + Символы.ПС
		+ "encoding.script = utf-8" + Символы.ПС);

	Ожидаемый = Новый Файл(ОбъединитьПути(КаталогДвижка, "..", "lib")).ПолноеИмя;
	Ожидаем.Что(Сервис.КаталогСистемныхБиблиотек(КаталогДвижка)).Равно(Ожидаемый);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИгнорироватьЗакомментированныйLibSystem() Экспорт

	КаталогДвижка = ВременныеФайлы.СоздатьКаталог();
	ЗаписатьКонфиг(КаталогДвижка, "#lib.system = ../lib" + Символы.ПС + "lib.additional = ./x" + Символы.ПС);

	Ожидаем.Что(Сервис.КаталогСистемныхБиблиотек(КаталогДвижка)).Равно("");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьПустуюСтроку_ЕслиКонфигаДвижкаНет() Экспорт
	Ожидаем.Что(Сервис.КаталогСистемныхБиблиотек(ВременныеФайлы.СоздатьКаталог())).Равно("");
КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьСуществующийКаталогADD_ИлиПустуюСтроку() Экспорт

	// Пакет vanessa-add может быть не установлен: тогда честный ответ - пустая строка,
	// а не путь в никуда. Если установлен - это каталог add, который существует.
	Каталог = Сервис.КаталогVanessaADD();

	Если ЗначениеЗаполнено(Каталог) Тогда
		Ожидаем.Что(Новый Файл(Каталог).Имя).Равно("add");
		Ожидаем.Что(Новый Файл(Каталог).ЭтоКаталог(), "каталог add существует: " + Каталог).ЭтоИстина();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	Сервис = Новый СервисОкружения;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаписатьКонфиг(Знач КаталогДвижка, Знач Текст)
	Запись = Новый ЗаписьТекста(ОбъединитьПути(КаталогДвижка, "oscript.cfg"), КодировкаТекста.UTF8);
	Запись.Записать(Текст);
	Запись.Закрыть();
КонецПроцедуры

#КонецОбласти
