// BSLLS-off
// Процессные регрессии единого синтаксиса справки через --help.

#Использовать asserts
#Использовать 1commands

#Область СлужебныйПрограммныйИнтерфейс

&Тест
Процедура ТестДолжен_ВывестиКорневуюСправку() Экспорт

	Аргументы = Новый Массив;
	Результат = ВыполнитьСправку(Аргументы);

	Ожидаем.Что(Результат.КодВозврата).Равно(0);
	Ожидаем.Что(Результат.Вывод).Содержит("Доступные команды");
	Ожидаем.Что(Результат.Вывод).Содержит("cf");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВывестиСправкуГруппыКоманд() Экспорт

	Аргументы = Новый Массив;
	Аргументы.Добавить("cf");
	Результат = ВыполнитьСправку(Аргументы);

	Ожидаем.Что(Результат.КодВозврата).Равно(0);
	Ожидаем.Что(Результат.Вывод).Содержит("Операции с конфигурацией");
	Ожидаем.Что(Результат.Вывод).Содержит("convert");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВывестиСправкуВложеннойКоманды() Экспорт

	Аргументы = Новый Массив;
	Аргументы.Добавить("cf");
	Аргументы.Добавить("convert");
	Результат = ВыполнитьСправку(Аргументы);

	Ожидаем.Что(Результат.КодВозврата).Равно(0);
	Ожидаем.Что(Результат.Вывод).Содержит("--edt-version");
	Ожидаем.Что(Результат.Вывод).Содержит("OUT");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПоказатьSettingsИCanonicalNoUpdateDbДляCfLoad() Экспорт

	Аргументы = Новый Массив;
	Аргументы.Добавить("cf");
	Аргументы.Добавить("load");
	Результат = ВыполнитьСправку(Аргументы);

	Ожидаем.Что(Результат.КодВозврата).Равно(0);
	Ожидаем.Что(Результат.Вывод).Содержит("--settings");
	Ожидаем.Что(Результат.Вывод).Содержит("--no-update-db");
	Ожидаем.Что(СтрНайти(Результат.Вывод, "--update-db"),
		"устаревшая opt-in опция отсутствует").Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВывестиСправкуCfMakeDist() Экспорт

	Аргументы = Новый Массив;
	Аргументы.Добавить("cf");
	Аргументы.Добавить("make-dist");
	Результат = ВыполнитьСправку(Аргументы);

	Ожидаем.Что(Результат.КодВозврата).Равно(0);
	Ожидаем.Что(Результат.Вывод).Содержит("OUT");
	Ожидаем.Что(Результат.Вывод).Содержит("--ibconnection");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВывестиСправкуEpfConvert() Экспорт

	Аргументы = Новый Массив;
	Аргументы.Добавить("epf");
	Аргументы.Добавить("convert");
	Результат = ВыполнитьСправку(Аргументы);

	Ожидаем.Что(Результат.КодВозврата).Равно(0);
	Ожидаем.Что(Результат.Вывод).Содержит("--edt-version");
	Ожидаем.Что(Результат.Вывод).Содержит("OUT");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВыполнитьСправку(Знач Аргументы)

	КомандаCLI = Новый Команда;
	КомандаCLI.УстановитьКоманду("oscript");
	КореньПроекта = Новый Файл(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "..", "..")).ПолноеИмя;
	КомандаCLI.УстановитьРабочийКаталог(КореньПроекта);
	КомандаCLI.ДобавитьПараметр("src/main.os");
	Для Каждого Аргумент Из Аргументы Цикл
		КомандаCLI.ДобавитьПараметр(Аргумент);
	КонецЦикла;
	КомандаCLI.ДобавитьПараметр("--help");

	КодВозврата = КомандаCLI.Исполнить();
	Возврат Новый Структура("КодВозврата, Вывод", КодВозврата, КомандаCLI.ПолучитьВывод());

КонецФункции

#КонецОбласти
