// BSLLS-off
// Юнит-тесты СервисПроцессов: запуск процесса, ожидание завершения с наблюдателем,
// ожидание файла готовности и безопасное завершение. Реальный процесс - oscript со скриптом.

#Использовать asserts
#Использовать tempfiles
#Использовать reflector
#Использовать logos
#Использовать "../../../src/core/Процессы"
#Использовать "../utils"

Перем Сервис;

#Область СлужебныйПрограммныйИнтерфейс

&Тест
Процедура ТестДолжен_ДождатьсяКодаВозврата_РеальногоПроцесса() Экспорт

	Скрипт = ЗаписатьСкрипт("ЗавершитьРаботу(3);");

	Процесс = Сервис.Запустить(СтрокаЗапускаOscript(Скрипт));
	КодВозврата = Сервис.ОжидатьЗавершения(Процесс, , , 50);

	Ожидаем.Что(КодВозврата, "код возврата").Равно(3);
	Ожидаем.Что(Сервис.Жив(Процесс), "процесс завершён").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПрочитатьВывод_ПриПеренаправлении() Экспорт

	Скрипт = ЗаписатьСкрипт("Сообщить(""hello-from-process"");");

	Процесс = Сервис.Запустить(СтрокаЗапускаOscript(Скрипт), Истина);
	Сервис.ОжидатьЗавершения(Процесс, , , 50);

	Ожидаем.Что(Сервис.ПрочитатьВывод(Процесс)).Содержит("hello-from-process");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВызыватьНаблюдателя_ПокаПроцессЖив() Экспорт

	Процесс = Новый ПроцессПлатформыСтаб();
	Наблюдатель = Новый НаблюдательПроцессаСтаб().ЗавершающийПроцесс();

	КодВозврата = Сервис.ОжидатьЗавершения(Процесс, Наблюдатель, 10, 5);

	Ожидаем.Что(Наблюдатель.КоличествоПроверок, "наблюдатель вызван").Равно(1);
	Ожидаем.Что(Процесс.Завершен, "процесс прерван наблюдателем").ЭтоИстина();
	Ожидаем.Что(КодВозврата).Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеВызыватьНаблюдателя_ЕслиПроцессУжеЗавершен() Экспорт

	Процесс = Новый ПроцессПлатформыСтаб().Завершенным();
	Наблюдатель = Новый НаблюдательПроцессаСтаб();

	Сервис.ОжидатьЗавершения(Процесс, Наблюдатель, 10, 5);

	Ожидаем.Что(Наблюдатель.КоличествоПроверок).Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьГотов_ЕслиФайлПоявился() Экспорт

	Файл = ВременныеФайлы.СоздатьФайл("notify");

	Ожидаем.Что(Сервис.ОжидатьФайла(Новый ПроцессПлатформыСтаб(), Файл, 100, 10)).Равно("готов");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьУмер_ЕслиПроцессЗавершилсяБезФайла() Экспорт

	Файл = ВременныеФайлы.НовоеИмяФайла("notify");
	Процесс = Новый ПроцессПлатформыСтаб().Завершенным();

	Ожидаем.Что(Сервис.ОжидатьФайла(Процесс, Файл, 100, 10)).Равно("умер");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьТаймаут_ЕслиФайлаНетАПроцессЖив() Экспорт

	Файл = ВременныеФайлы.НовоеИмяФайла("notify");

	Ожидаем.Что(Сервис.ОжидатьФайла(Новый ПроцессПлатформыСтаб(), Файл, 30, 10)).Равно("таймаут");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗавершитьПроцессБезопасно() Экспорт

	Процесс = Новый ПроцессПлатформыСтаб();

	Ожидаем.Что(Сервис.Завершить(Процесс), "завершение").ЭтоИстина();
	Ожидаем.Что(Процесс.КоличествоВызововЗавершить).Равно(1);
	Ожидаем.Что(Сервис.Завершить(Неопределено), "нет процесса - не ошибка").ЭтоИстина();
	Ожидаем.Что(Сервис.Жив(Неопределено), "нет процесса - не жив").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	Сервис = Новый СервисПроцессов;
	Рефлектор = Новый Рефлектор;
	Рефлектор.УстановитьСвойство(Сервис, "Лог", Логирование.ПолучитьЛог("vrunner"));
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗаписатьСкрипт(Знач Текст)
	Путь = ВременныеФайлы.НовоеИмяФайла("os");
	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Запись.ЗаписатьСтроку(Текст);
	Запись.Закрыть();
	Возврат Путь;
КонецФункции

Функция СтрокаЗапускаOscript(Знач Скрипт)
	Возврат "oscript """ + Скрипт + """";
КонецФункции

#КонецОбласти
