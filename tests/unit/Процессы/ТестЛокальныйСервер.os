// BSLLS-off
// Юнит-тесты ЛокальныйСервер: адрес, подбор кандидатов на порт (базовый первым, случайные
// сдвиги в заданном диапазоне, исчерпание попыток), перечень перебранных портов и пробы
// занятости порта / ответа по http. Реальный сервер не поднимается: занятый порт имитирует
// TCPСервер в тесте.

#Использовать asserts
#Использовать "../../../src/core/Процессы"

#Область СлужебныйПрограммныйИнтерфейс

&Тест
Процедура ТестДолжен_ВернутьАдресИзХостаИПорта() Экспорт

	Сервер = Новый ЛокальныйСервер("127.0.0.1", 1550);

	Ожидаем.Что(Сервер.Хост()).Равно("127.0.0.1");
	Ожидаем.Что(Сервер.Порт()).Равно(1550);
	Ожидаем.Что(Сервер.Адрес()).Равно("http://127.0.0.1:1550");
	Ожидаем.Что(Сервер.Сдвиг(), "до подбора порт базовый").Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_УстановитьПортБезПодбора_ИПосчитатьСдвиг() Экспорт

	Сервер = Новый ЛокальныйСервер("localhost", 8314);

	Сервер.УстановитьПорт(8414);

	Ожидаем.Что(Сервер.Порт()).Равно(8414);
	Ожидаем.Что(Сервер.Адрес()).Равно("http://localhost:8414");
	Ожидаем.Что(Сервер.Сдвиг()).Равно(100);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыдатьБазовыйПорт_ПервымКандидатом() Экспорт

	Сервер = Новый ЛокальныйСервер("localhost", 8314);
	Сервер.НачатьПодбор(8, 100, 32);

	Ожидаем.Что(Сервер.СледующийКандидат(), "первый кандидат есть").ЭтоИстина();
	Ожидаем.Что(Сервер.Порт()).Равно(8314);
	Ожидаем.Что(Сервер.Сдвиг()).Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыдатьСтолькоКандидатов_СколькоПопыток() Экспорт

	Сервер = Новый ЛокальныйСервер("localhost", 8314);
	Сервер.НачатьПодбор(8, 100, 32);

	Ожидаем.Что(КоличествоКандидатов(Сервер), "число кандидатов").Равно(8);
	Ожидаем.Что(Сервер.СледующийКандидат(), "после исчерпания - снова Ложь").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_СдвигатьПорт_КратноШагуВПределахДиапазона() Экспорт

	Сервер = Новый ЛокальныйСервер("localhost", 8314);
	Сервер.НачатьПодбор(50, 100, 32);
	Сервер.СледующийКандидат(); // базовый порт

	Пока Сервер.СледующийКандидат() Цикл
		Сдвиг = Сервер.Сдвиг();
		Ожидаем.Что(Сдвиг >= 100 И Сдвиг <= 3200, "сдвиг " + Сдвиг + " в диапазоне 100..3200").ЭтоИстина();
		Ожидаем.Что(Сдвиг % 100, "сдвиг " + Сдвиг + " кратен шагу").Равно(0);
		Ожидаем.Что(Сервер.Порт()).Равно(8314 + Сдвиг);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПеречислитьПеребранныеПорты() Экспорт

	Сервер = Новый ЛокальныйСервер("127.0.0.1", 1550);
	Сервер.НачатьПодбор(3, 1, 500);

	Ожидаем.Что(Сервер.ПеребранныеПорты(), "до первого кандидата").Равно("");

	Порты = Новый Массив;
	Пока Сервер.СледующийКандидат() Цикл
		Порты.Добавить(XMLСтрока(Сервер.Порт()));
	КонецЦикла;

	Ожидаем.Что(Сервер.ПеребранныеПорты()).Равно(СтрСоединить(Порты, ", "));
	Ожидаем.Что(СтрНачинаетсяС(Сервер.ПеребранныеПорты(), "1550, "), "первым идёт базовый").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_НачатьПодборЗаново_СПустымПеречнем() Экспорт

	Сервер = Новый ЛокальныйСервер("127.0.0.1", 1550);
	Сервер.НачатьПодбор(2, 1, 500);
	КоличествоКандидатов(Сервер);

	Сервер.НачатьПодбор(1, 1, 500);

	Ожидаем.Что(Сервер.ПеребранныеПорты(), "перечень сброшен").Равно("");
	Ожидаем.Что(КоличествоКандидатов(Сервер)).Равно(1);
	Ожидаем.Что(Сервер.ПеребранныеПорты()).Равно("1550");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СчитатьПортЗанятым_ЕслиНаНемСлушаютTCP() Экспорт

	Порт = 8771;
	TCPСервер = Новый TCPСервер(Порт);
	TCPСервер.Запустить();

	Попытка
		Ожидаем.Что(Новый ЛокальныйСервер("localhost", Порт).ПортСвободен()).ЭтоЛожь();
	Исключение
		TCPСервер.Остановить();
		ВызватьИсключение;
	КонецПопытки;

	TCPСервер.Остановить();

КонецПроцедуры

&Тест
Процедура ТестДолжен_СчитатьПортСвободным_ЕслиНиктоНеСлушает() Экспорт

	Ожидаем.Что(Новый ЛокальныйСервер("localhost", 8772).ПортСвободен()).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеОтвечатьПоHTTP_НаЗакрытомПорту() Экспорт

	Ожидаем.Что(Новый ЛокальныйСервер("localhost", 8773).ОтвечаетПоHTTP(1)).ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КоличествоКандидатов(Знач Сервер)
	Количество = 0;
	Пока Сервер.СледующийКандидат() Цикл
		Количество = Количество + 1;
	КонецЦикла;
	Возврат Количество;
КонецФункции

#КонецОбласти
