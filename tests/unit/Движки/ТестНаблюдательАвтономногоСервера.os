// BSLLS-off
// Юнит-тесты НаблюдательАвтономногоСервера: healthcheck-watchdog клиента 1С при работе через ibsrv.

#Использовать asserts

#Использовать "../../../src/core/Движки"
#Использовать "../utils"

#Область СлужебныйПрограммныйИнтерфейс

&Тест
Процедура ТестДолжен_ПрерватьПроцесс_ЕслиСерверМертв() Экспорт

	// Дано - процесс не завершён, монитор сообщает что сервер мёртв
	Процесс = Новый ПроцессПлатформыСтаб();
	Наблюдатель = Новый НаблюдательАвтономногоСервера(Новый МониторСервераСтаб().Мертвым());

	// Когда / Тогда - ожидаем исключение healthcheck и что процесс прерван
	Попытка
		Наблюдатель.ПроверитьПроцесс(Процесс);
		ВызватьИсключение "Должно было упасть";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("healthcheck");
	КонецПопытки;

	Ожидаем.Что(Процесс.КоличествоВызововЗавершить).Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеПрерывать_ЕслиСерверЖив() Экспорт

	Процесс = Новый ПроцессПлатформыСтаб();
	Наблюдатель = Новый НаблюдательАвтономногоСервера(Новый МониторСервераСтаб());

	Наблюдатель.ПроверитьПроцесс(Процесс);

	Ожидаем.Что(Процесс.КоличествоВызововЗавершить).Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_БытьNoOp_ЕслиМониторНеЗадан() Экспорт

	Процесс = Новый ПроцессПлатформыСтаб();
	Наблюдатель = Новый НаблюдательАвтономногоСервера(Неопределено);

	Наблюдатель.ПроверитьПроцесс(Процесс);

	Ожидаем.Что(Процесс.КоличествоВызововЗавершить).Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_БытьNoOp_ЕслиПроцессУжеЗавершен() Экспорт

	// Дано - процесс уже завершён, сервер мёртв (но прерывать уже нечего)
	Процесс = Новый ПроцессПлатформыСтаб().Завершенным();
	Наблюдатель = Новый НаблюдательАвтономногоСервера(Новый МониторСервераСтаб().Мертвым());

	Наблюдатель.ПроверитьПроцесс(Процесс);

	Ожидаем.Что(Процесс.КоличествоВызововЗавершить).Равно(0);

КонецПроцедуры

#КонецОбласти
