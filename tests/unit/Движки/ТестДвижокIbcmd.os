// BSLLS-off
// Юнит-тесты ДвижокIbcmd: делегации в ibcmdrunner, контекст ИБ, версия платформы и каталог данных
// автономного сервера, разбор изменений конфигурации. ibcmdrunner.УправлениеИБ замокан и подставлен через фабрику.

#Использовать asserts
#Использовать moskito
#Использовать tempfiles
#Использовать "../utils"

Перем Стенд;
Перем Движок;
Перем Менеджер; // мок ibcmdrunner.УправлениеИБ, который движок получает из фабрики
Перем Фабрика;  // ФабрикаСтаб: первый параметр каждого вызова Создать - версия платформы
Перем База;     // файловая ИБ с авторизацией
Перем Любое;

&ПередКаждым
Процедура ПередКаждым() Экспорт
	Стенд = Новый Стенд;
	Стенд.Реальный("ФайловыеОперации"); // движок нормализует пути и создаёт каталоги вывода
	Менеджер = Стенд.Мок("УправлениеИБ");
	Фабрика = Стенд.Подменить("_ФабрикаУправленияИБ", Новый ФабрикаСтаб(Менеджер));
	Движок = Стенд.Сервис("ДвижокIbcmd");
	База = ТестовыеДанные.Файловая("base");
	База.Пользователь = "Admin";
	База.Пароль = "secret";
	Любое = Матчеры.ЛюбоеЗначение();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт
	ВременныеФайлы.Удалить();
КонецПроцедуры

#Область ВерсияПлатформыИКаталогДанных

&Тест
Процедура ТестДолжен_ИспользоватьВерсиюПлатформы8_ЕслиПараметрыНеЗаданы() Экспорт

	Движок.СоздатьВременнуюБазу();

	Ожидаем.Что(Фабрика.Вызовы[0][0]).Равно("8");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПередатьВерсиюПлатформы_ИзПараметров() Экспорт

	Движок.СоздатьФайловуюБазу("base", Новый Структура("ВерсияПлатформы", "8.3.22.1"));

	Ожидаем.Что(Фабрика.Вызовы[0][0]).Равно("8.3.22.1");

КонецПроцедуры

&Тест
Процедура ТестДолжен_УстановитьКаталогДанныхАвтономногоСервера_ВоВременномКаталоге() Экспорт

	// Когда
	Движок.СоздатьФайловуюБазу("base");

	// Тогда
	Каталог = КаталогДанных(0);
	Ожидаем.Что(Каталог).Заполнено();
	Ожидаем.Что(ТестовыеФайлы.Существует(Каталог), "каталог создан на диске").ЭтоИстина();
	Ожидаем.Что(ВременныеФайлы.Файлы().Найти(Каталог), "каталог учтён как временный").Не_().Равно(Неопределено);

КонецПроцедуры

// Один каталог данных на экземпляр движка (= на команду vrunner): цепочка операций
// не плодит по каталогу на 256+ МБ на каждый вызов ibcmd (issue #749).
&Тест
Процедура ТестДолжен_ПереиспользоватьКаталогДанных_ВЦепочкеОпераций() Экспорт

	// Когда
	Движок.СоздатьФайловуюБазу("base");
	Движок.ОбновитьКонфигурациюБД(База);

	// Тогда
	Ожидаем.Что(Стенд.Вызовы("УправлениеИБ", "УстановитьПараметрыАвтономногоСервера")).ИмеетДлину(2);
	Ожидаем.Что(КаталогДанных(1)).Равно(КаталогДанных(0));

КонецПроцедуры

// После очистки временных файлов (конец команды; в MCP - между вызовами) каталог создаётся заново.
&Тест
Процедура ТестДолжен_СоздатьНовыйКаталогДанных_ЕслиПрежнийУдалён() Экспорт

	// Дано
	Движок.СоздатьФайловуюБазу("base");
	ВременныеФайлы.УдалитьФайл(КаталогДанных(0));

	// Когда
	Движок.СоздатьФайловуюБазу("base");

	// Тогда
	Ожидаем.Что(КаталогДанных(1)).Не_().Равно(КаталогДанных(0));
	Ожидаем.Что(ТестовыеФайлы.Существует(КаталогДанных(1)), "новый каталог создан на диске").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область КонтекстИБ

&Тест
Процедура ТестДолжен_УстановитьКонтекстСервернойИБ_ЕслиЗаданТипСУБД() Экспорт

	Движок.ЗагрузитьКонфигурациюИзФайла(СервернаяБаза(), "my.cf");

	Менеджер.ПроверитьЧтоВызывалсяМетод().УстановитьПараметрыСервернойИБ("PostgreSQL", "pg", "ib", "u", "x");
	Менеджер.ПроверитьЧтоВызывалсяМетод().УстановитьПараметрыАвторизацииИБ("Admin", "p");
	Стенд.ПроверитьЧтоНеВызывался("УправлениеИБ", "УстановитьПараметрыФайловойИБ");

КонецПроцедуры

&Тест
Процедура ТестДолжен_УстановитьКонтекстФайловойИБ_ИзКаталогаБазы() Экспорт

	Движок.ЗагрузитьКонфигурациюИзФайла(База, "my.cf");

	Менеджер.ПроверитьЧтоВызывалсяМетод().УстановитьПараметрыФайловойИБ("base");
	Менеджер.ПроверитьЧтоВызывалсяМетод().УстановитьПараметрыАвторизацииИБ("Admin", "secret");
	Стенд.ПроверитьЧтоНеВызывался("УправлениеИБ", "УстановитьПараметрыСервернойИБ");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПропуститьАвторизацию_ЕслиПользовательНеЗадан() Экспорт

	Движок.ЗагрузитьКонфигурациюИзФайла(ТестовыеДанные.Файловая("base"), "my.cf");

	Стенд.ПроверитьЧтоНеВызывался("УправлениеИБ", "УстановитьПараметрыАвторизацииИБ");

КонецПроцедуры

#КонецОбласти

#Область СоздатьВременнуюБазу

&Тест
Процедура ТестДолжен_СоздатьВременнуюБазу_ИВернутьПараметры() Экспорт

	// Когда
	Результат = Движок.СоздатьВременнуюБазу();

	// Тогда
	Ожидаем.Что(Результат.КаталогБазы).Заполнено();
	Менеджер.ПроверитьЧтоВызывалсяМетод().УстановитьПараметрыФайловойИБ(Результат.КаталогБазы);
	Менеджер.ПроверитьЧтоВызывалсяМетод().СоздатьИБ();

КонецПроцедуры

#КонецОбласти

#Область ЗагрузитьКонфигурациюИзФайлов

&Тест
Процедура ТестДолжен_ЗагрузитьКонфигурациюИзФайлов_БезСписка() Экспорт

	Движок.ЗагрузитьКонфигурациюИзФайлов(База, АбсолютныйПуть("src"));

	Менеджер.ПроверитьЧтоВызывалсяМетод().ЗагрузитьКонфигурациюИзФайлов(АбсолютныйПуть("src"), "");
	Стенд.ПроверитьЧтоНеВызывался("УправлениеИБ", "ЗагрузитьВыбранныеФайлыКонфигурации");

КонецПроцедуры

// ibcmd падает на относительном каталоге исходников с префиксом "./" -
// "файл <путь> отсутствует либо поврежден" на случайных файлах. Передаём абсолютный путь.
&Тест
Процедура ТестДолжен_ПередатьАбсолютныйКаталогИсходников_ЕслиПутьОтносительный() Экспорт

	Движок.ЗагрузитьКонфигурациюИзФайлов(База, "./build/src/cf");

	Менеджер.ПроверитьЧтоВызывалсяМетод().ЗагрузитьКонфигурациюИзФайлов(АбсолютныйПуть("./build/src/cf"), "");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПередатьАбсолютныйБазовыйКаталог_ПриВыборочнойЗагрузке() Экспорт

	Движок.ЗагрузитьКонфигурациюИзФайлов(База, "./build/src/cf", Неопределено, СписокФайлов("Configuration.xml"));

	Менеджер.ПроверитьЧтоВызывалсяМетод()
		.ЗагрузитьВыбранныеФайлыКонфигурации(АбсолютныйПуть("./build/src/cf"), Любое, "");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗагрузитьВыбранныеФайлы_ЕслиЗаданСписок() Экспорт

	// Когда
	Движок.ЗагрузитьКонфигурациюИзФайлов(База, "src", Неопределено, СписокФайлов(
		"Configuration.xml
		|Catalogs/Товары.xml"));

	// Тогда
	Файлы = Стенд.Вызовы("УправлениеИБ", "ЗагрузитьВыбранныеФайлыКонфигурации")[0].ВыбранныеФайлы;
	Ожидаем.Что(Файлы).ИмеетДлину(2);
	Ожидаем.Что(Файлы).Содержит("Catalogs/Товары.xml");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗагрузитьИзФайлов_ЕслиСписокПустой() Экспорт

	Движок.ЗагрузитьКонфигурациюИзФайлов(База, "src", Неопределено, СписокФайлов(""));

	Стенд.ПроверитьЧтоНеВызывался("УправлениеИБ", "ЗагрузитьВыбранныеФайлыКонфигурации");
	Ожидаем.Что(Стенд.Вызовы("УправлениеИБ", "ЗагрузитьКонфигурациюИзФайлов")).ИмеетДлину(1);

КонецПроцедуры

#КонецОбласти

#Область ПолучитьИзмененияКонфигурации

&Тест
Процедура ТестДолжен_ВернутьПустыеИзменения_ЕслиКешНеЗадан() Экспорт

	Результат = Движок.ПолучитьИзмененияКонфигурации(База, "src");

	Ожидаем.Что(Результат.ТребуетсяПолнаяЗагрузка).ЭтоЛожь();
	Ожидаем.Что(Результат.ИзмененныеФайлы).ИмеетДлину(0);
	Стенд.ПроверитьЧтоНеВызывался("УправлениеИБ", "ВыгрузитьВФайлИзмененияКонфигурации");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьПустыеИзменения_ЕслиФайлКешаНеСуществует() Экспорт

	Результат = Движок.ПолучитьИзмененияКонфигурации(База, "src", "not-exists/dump-info.xml");

	Ожидаем.Что(Результат.ИзмененныеФайлы).ИмеетДлину(0);
	Стенд.ПроверитьЧтоНеВызывался("УправлениеИБ", "ВыгрузитьВФайлИзмененияКонфигурации");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьПустыеИзмененияИСохранитьКеш_ПриОшибкеВыгрузкиИзменений() Экспорт

	// Дано
	ПутьКеша = ФайлКеша();
	Менеджер.Когда().ВыгрузитьВФайлИзмененияКонфигурации(Любое, Любое, Любое, Любое)
		.ТогдаВыбрасываетИсключение("стаб: выгрузка изменений упала");

	// Когда
	Результат = Движок.ПолучитьИзмененияКонфигурации(База, "src", ПутьКеша);

	// Тогда - в отличие от конфигуратора, полная загрузка не запрашивается и кеш не очищается
	Ожидаем.Что(Результат.ТребуетсяПолнаяЗагрузка).ЭтоЛожь();
	Ожидаем.Что(Результат.ИзмененныеФайлы).ИмеетДлину(0);
	Ожидаем.Что(ТестовыеФайлы.Существует(ПутьКеша), "кеш ConfigDumpInfo сохранён").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазобратьИзмененныеОбъекты_ВОтносительныеПути() Экспорт

	Результат = ИзмененияИзФайла(
		"modified: Catalog.Номенклатура
		|modified: Document.ЗаказПокупателя
		|modified: CommonModule.ОбщегоНазначения");

	Ожидаем.Что(Результат.ТребуетсяПолнаяЗагрузка).ЭтоЛожь();
	Ожидаем.Что(Результат.ИзмененныеФайлы).ИмеетДлину(3);
	Ожидаем.Что(Результат.ИзмененныеФайлы).Содержит("Catalogs/Номенклатура.xml");
	Ожидаем.Что(Результат.ИзмененныеФайлы).Содержит("Documents/ЗаказПокупателя.xml");
	Ожидаем.Что(Результат.ИзмененныеФайлы).Содержит("CommonModules/ОбщегоНазначения.xml");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПотребоватьПолнуюЗагрузку_ПоМаркеруFulldump() Экспорт

	Результат = ИзмененияИзФайла(
		"FULLDUMP
		|modified: Catalog.Номенклатура");

	Ожидаем.Что(Результат.ТребуетсяПолнаяЗагрузка).ЭтоИстина();
	Ожидаем.Что(Результат.ИзмененныеФайлы, "при полной загрузке список пуст").ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПотребоватьПолнуюЗагрузку_ПоМаркеруModifiedAll() Экспорт

	Результат = ИзмененияИзФайла("Modified: ALL");

	Ожидаем.Что(Результат.ТребуетсяПолнаяЗагрузка).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_СхлопнутьПовторыИзмененногоОбъекта() Экспорт

	Результат = ИзмененияИзФайла(
		"modified: Catalog.Номенклатура
		|modified: catalog.номенклатура");

	Ожидаем.Что(Результат.ИзмененныеФайлы).ИмеетДлину(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазобратьИзменениеКорняКонфигурации_ВConfigurationXml() Экспорт

	Результат = ИзмененияИзФайла("modified: Configuration.УправлениеТорговлей");

	Ожидаем.Что(Результат.ИзмененныеФайлы).ИмеетДлину(1);
	Ожидаем.Что(Результат.ИзмененныеФайлы[0]).Равно("Configuration.xml");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПропуститьСтрокиБезИмениОбъектаИЧужиеСтроки() Экспорт

	Результат = ИзмененияИзФайла(
		"modified: БезТочки
		|added: Catalog.Новый
		|
		|modified: Document.Заказ");

	Ожидаем.Что(Результат.ИзмененныеФайлы).ИмеетДлину(1);
	Ожидаем.Что(Результат.ИзмененныеФайлы[0]).Равно("Documents/Заказ.xml");

КонецПроцедуры

#КонецОбласти

#Область ЗагрузитьКонфигурациюИзФайла

&Тест
Процедура ТестДолжен_ЗагрузитьКонфигурациюИзФайлаCf() Экспорт

	ПутьCf = АбсолютныйПуть("my.cf");

	Движок.ЗагрузитьКонфигурациюИзФайла(База, ПутьCf);

	Менеджер.ПроверитьЧтоВызывалсяМетод().ЗагрузитьКонфигурацию(ПутьCf, "");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПередатьАбсолютныйПутьКФайлуCf_ЕслиПутьОтносительный() Экспорт

	Движок.ЗагрузитьКонфигурациюИзФайла(База, "./build/1cv8.cf");

	Менеджер.ПроверитьЧтоВызывалсяМетод().ЗагрузитьКонфигурацию(АбсолютныйПуть("./build/1cv8.cf"), "");

КонецПроцедуры

#КонецОбласти

#Область ВыгрузитьКонфигурацию

&Тест
Процедура ТестДолжен_ВыгрузитьКонфигурациюВФайлCf() Экспорт

	ПутьCf = АбсолютныйПуть("out.cf");

	Движок.ВыгрузитьКонфигурациюВФайл(База, ПутьCf);

	Менеджер.ПроверитьЧтоВызывалсяМетод().ВыгрузитьКонфигурациюВФайл(ПутьCf);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьКаталогВывода_ПриВыгрузкеCf() Экспорт

	// Дано
	КаталогВывода = ТестовыеФайлы.Путь(ВременныеФайлы.СоздатьКаталог(), "build");

	// Когда
	Движок.ВыгрузитьКонфигурациюВФайл(База, ОбъединитьПути(КаталогВывода, "conf.cf"));

	// Тогда
	Ожидаем.Что(ТестовыеФайлы.Существует(КаталогВывода), "недостающий каталог вывода создаётся автоматически").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыгрузитьКонфигурациюВФайлы_ВСозданныйКаталог() Экспорт

	// Дано
	КаталогВыгрузки = ТестовыеФайлы.Путь(ВременныеФайлы.СоздатьКаталог(), "out");

	// Когда
	Движок.ВыгрузитьКонфигурациюВФайлы(База, КаталогВыгрузки);

	// Тогда
	Менеджер.ПроверитьЧтоВызывалсяМетод().ВыгрузитьКонфигурациюВФайлы(КаталогВыгрузки, "", "", Ложь);
	Ожидаем.Что(ТестовыеФайлы.Существует(КаталогВыгрузки)).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область СоздатьФайловуюБазу

&Тест
Процедура ТестДолжен_СоздатьФайловуюБазу_ВЗаданномКаталоге() Экспорт

	// Когда
	Результат = Движок.СоздатьФайловуюБазу("base");

	// Тогда
	Менеджер.ПроверитьЧтоВызывалсяМетод().УстановитьПараметрыФайловойИБ("base");
	Менеджер.ПроверитьЧтоВызывалсяМетод().СоздатьИБ();
	Ожидаем.Что(Результат.КаталогБазы).Равно("base");

КонецПроцедуры

#КонецОбласти

#Область ЗагрузитьВыгрузитьИнфобазу

&Тест
Процедура ТестДолжен_ЗагрузитьИнфобазуИзDT() Экспорт

	ПутьDT = АбсолютныйПуть("dump.dt");

	Движок.ЗагрузитьИнфобазуИзФайла(База, ПутьDT);

	Менеджер.ПроверитьЧтоВызывалсяМетод().ЗагрузитьДанныеИБ(ПутьDT);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыгрузитьИнфобазуВDT() Экспорт

	ПутьDT = АбсолютныйПуть("out.dt");

	Движок.ВыгрузитьИнфобазуВФайл(База, ПутьDT);

	Менеджер.ПроверитьЧтоВызывалсяМетод().ВыгрузитьДанныеИБ(ПутьDT);

КонецПроцедуры

#КонецОбласти

#Область ОбновитьКонфигурациюБД

&Тест
Процедура ТестДолжен_ВызватьОбновлениеБезИмени_ЕслиНастройкиПусты() Экспорт

	Движок.ОбновитьКонфигурациюБД(База);

	Менеджер.ПроверитьЧтоВызывалсяМетод().ОбновитьКонфигурациюБазыДанных();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВызватьОбновлениеСИменем_ЕслиЗаданоИмяРасширения() Экспорт

	Движок.ОбновитьКонфигурациюБД(База, Неопределено, Новый Структура("ИмяРасширения", "MyExt"));

	Менеджер.ПроверитьЧтоВызывалсяМетод().ОбновитьКонфигурациюБазыДанных("MyExt");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОбновитьВсеРасширения_ИзСпискаОписаний() Экспорт

	// Дано
	Менеджер.Когда().ОписанияРасширений()
		.ТогдаВозвращает(ТестовыеДанные.Массив(ОписаниеРасширения("ExtA"), ОписаниеРасширения("ExtB")));

	// Когда
	Движок.ОбновитьКонфигурациюБД(База, Неопределено, Новый Структура("ОбновитьВсеРасширения", Истина));

	// Тогда
	Ожидаем.Что(Стенд.Вызовы("УправлениеИБ", "ОбновитьКонфигурациюБазыДанных")).ИмеетДлину(2);
	Менеджер.ПроверитьЧтоВызывалсяМетод().ОбновитьКонфигурациюБазыДанных("ExtA");
	Менеджер.ПроверитьЧтоВызывалсяМетод().ОбновитьКонфигурациюБазыДанных("ExtB");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПропуститьОбновлениеВсех_ЕслиСписокПуст() Экспорт

	Движок.ОбновитьКонфигурациюБД(База, Неопределено, Новый Структура("ОбновитьВсеРасширения", Истина));

	Стенд.ПроверитьЧтоНеВызывался("УправлениеИБ", "ОбновитьКонфигурациюБазыДанных");

КонецПроцедуры

#КонецОбласти

#Область Расширения

&Тест
Процедура ТестДолжен_ЗагрузитьРасширениеИзФайла() Экспорт

	Движок.ЗагрузитьРасширениеИзФайла(База, "ext.cfe", "MyExt");

	Менеджер.ПроверитьЧтоВызывалсяМетод().ЗагрузитьКонфигурацию(АбсолютныйПуть("ext.cfe"), "MyExt");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыгрузитьРасширениеВФайл() Экспорт

	Движок.ВыгрузитьРасширениеВФайл(База, "ext.cfe", "MyExt");

	Менеджер.ПроверитьЧтоВызывалсяМетод().ВыгрузитьКонфигурациюВФайл(АбсолютныйПуть("ext.cfe"), "MyExt");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗагрузитьРасширениеИзФайлов_БезСписка() Экспорт

	Движок.ЗагрузитьРасширениеИзФайлов(База, "src", "MyExt");

	Менеджер.ПроверитьЧтоВызывалсяМетод().ЗагрузитьКонфигурациюИзФайлов(АбсолютныйПуть("src"), "MyExt");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗагрузитьВыбранныеФайлыРасширения_ЕслиЗаданСписок() Экспорт

	// Когда
	Движок.ЗагрузитьРасширениеИзФайлов(База, "src", "MyExt", Неопределено, СписокФайлов("Ext.xml"));

	// Тогда
	Вызов = Стенд.Вызовы("УправлениеИБ", "ЗагрузитьВыбранныеФайлыКонфигурации")[0];
	Ожидаем.Что(Вызов.КаталогВыгрузки).Равно(АбсолютныйПуть("src"));
	Ожидаем.Что(Вызов.ВыбранныеФайлы).Содержит("Ext.xml");
	Ожидаем.Что(Вызов.ИмяРасширения).Равно("MyExt");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыгрузитьРасширениеВФайлы() Экспорт

	// Дано
	КаталогВыгрузки = ТестовыеФайлы.Путь(ВременныеФайлы.СоздатьКаталог(), "ext-out");

	// Когда
	Движок.ВыгрузитьРасширениеВФайлы(База, КаталогВыгрузки, "MyExt");

	// Тогда
	Менеджер.ПроверитьЧтоВызывалсяМетод().ВыгрузитьКонфигурациюВФайлы(КаталогВыгрузки, "", "MyExt", Ложь);
	Ожидаем.Что(ТестовыеФайлы.Существует(КаталогВыгрузки)).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИзменитьСвойстваРасширения_ВПорядкеСигнатурыIbcmd() Экспорт

	// Дано
	Свойства = Новый Структура(
		"Активность, БезопасныйРежим, ИмяПрофиляБезопасности, ЗащитаОтОпасныхДействий, ИспользуетсяВ_РИБ, ОбластьДействия_ИБ",
		Истина, Ложь, "", Истина, Истина, "");

	// Когда
	Движок.ИзменитьСвойстваРасширения(База, "MyExt", Свойства);

	// Тогда
	Менеджер.ПроверитьЧтоВызывалсяМетод().ИзменитьСвойстваРасширения("MyExt", Истина, Ложь, "", Истина, Истина, "");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Каталог данных автономного сервера из N-го вызова УстановитьПараметрыАвтономногоСервера.
Функция КаталогДанных(Знач НомерВызова)
	Возврат Стенд.Вызовы("УправлениеИБ", "УстановитьПараметрыАвтономногоСервера")[НомерВызова].КаталогДанныхАС;
КонецФункции

Функция СервернаяБаза()

	Подключение = ТестовыеДанные.Подключение("", "Admin", "p");
	Подключение.Вставить("ТипСУБД", "PostgreSQL");
	Подключение.Вставить("СерверСУБД", "pg");
	Подключение.Вставить("ИмяБазыДанных", "ib");
	Подключение.Вставить("ПользовательСУБД", "u");
	Подключение.Вставить("ПарольСУБД", "x");

	Возврат Подключение;

КонецФункции

// Абсолютный путь для ожиданий: движок нормализует пути перед передачей в ibcmd, а литерал
// абсолютным считается только на той ОС, где он абсолютный (на Linux "C:\x" - относительный).
Функция АбсолютныйПуть(Знач Имя)
	Возврат Новый Файл(Имя).ПолноеИмя;
КонецФункции

Функция СписокФайлов(Знач Строки)
	Возврат ТестовыеФайлы.ЗаписатьФайл(ВременныеФайлы.НовоеИмяФайла("txt"), Строки);
КонецФункции

Функция ФайлКеша()
	Возврат ТестовыеФайлы.ЗаписатьФайл(ВременныеФайлы.НовоеИмяФайла("xml"), "<some/>");
КонецФункции

Функция ОписаниеРасширения(Знач Имя)
	Описание = Новый Соответствие;
	Описание.Вставить("name", Имя);
	Возврат Описание;
КонецФункции

// ПолучитьИзмененияКонфигурации с существующим кешем и менеджером, который пишет заданное
// содержимое в файл изменений (первый параметр ВыгрузитьВФайлИзмененияКонфигурации).
Функция ИзмененияИзФайла(Знач Содержимое)

	Менеджер.Когда().ВыгрузитьВФайлИзмененияКонфигурации(Любое, Любое, Любое, Любое)
		.ТогдаОтвечает(ТестовыеФайлы.ЗаписатьПриВызове(0, Содержимое));

	Возврат Движок.ПолучитьИзмененияКонфигурации(База, "src", ФайлКеша());

КонецФункции

#КонецОбласти
