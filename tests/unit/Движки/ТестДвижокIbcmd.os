// BSLLS-off
// Юнит-тесты ДвижокIbcmd - делегации к УправлениеИБ + ветки логики.

#Использовать asserts
#Использовать tempfiles

#Использовать "../../../src/core/Движки"
#Использовать "../utils"

Перем ПарПодключенияФайл;
Перем ПарПодключенияСервер;
Перем Менеджер;
Перем Движок;

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	ПарПодключенияФайл = Новый Структура("СтрокаПодключения, Пользователь, Пароль, КаталогБазы",
		"File=base", "Admin", "secret", "C:\\base");
	ПарПодключенияСервер = Новый Структура;
	ПарПодключенияСервер.Вставить("СтрокаПодключения", "");
	ПарПодключенияСервер.Вставить("Пользователь", "Admin");
	ПарПодключенияСервер.Вставить("Пароль", "p");
	ПарПодключенияСервер.Вставить("ТипСУБД", "PostgreSQL");
	ПарПодключенияСервер.Вставить("СерверСУБД", "pg");
	ПарПодключенияСервер.Вставить("ИмяБазыДанных", "ib");
	ПарПодключенияСервер.Вставить("ПользовательСУБД", "u");
	ПарПодключенияСервер.Вставить("ПарольСУБД", "x");
	Менеджер = Новый УправлениеИБСтаб();
	Движок = Новый БилдерДвижкаIbcmd()
		.СФабрикойУправленияИБ(Менеджер)
		.Собрать();
КонецПроцедуры

Функция Вызов(Имя)
	Для Каждого В Из Менеджер.Вызовы Цикл
		Если В.Метод = Имя Тогда
			Возврат В;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция КоличествоВызовов(Имя)
	К = 0;
	Для Каждого В Из Менеджер.Вызовы Цикл
		Если В.Метод = Имя Тогда К = К + 1; КонецЕсли;
	КонецЦикла;
	Возврат К;
КонецФункции

#Область ПлатформаИФабрика

&Тест
Процедура ТестДолжен_ИспользоватьВерсиюПо8_ЕслиПараметрыНеЗаданы() Экспорт
	Движок.СоздатьВременнуюБазу();
	Ожидаем.Что(Менеджер.ВерсияПлатформы_).Равно("8");
КонецПроцедуры

&Тест
Процедура ТестДолжен_ПередатьВерсиюИзПараметров() Экспорт
	ПП = Новый Структура("ВерсияПлатформы", "8.3.22.1");
	Движок.СоздатьФайловуюБазу("C:\\b", ПП);
	Ожидаем.Что(Менеджер.ВерсияПлатформы_).Равно("8.3.22.1");
КонецПроцедуры

&Тест
Процедура ТестДолжен_УстановитьКаталогДанныхАвтономногоСервера() Экспорт
