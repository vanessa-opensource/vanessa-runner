	Свойства.Вставить("Активность", Истина);
	Свойства.Вставить("БезопасныйРежим", Ложь);
	Свойства.Вставить("ИмяПрофиляБезопасности", "");
	Свойства.Вставить("ЗащитаОтОпасныхДействий", Истина);
	Свойства.Вставить("ИспользуетсяВ_РИБ", Истина);
	Свойства.Вставить("ОбластьДействия_ИБ", "");

	Движок.ИзменитьСвойстваРасширения(ПарПодключенияФайл, "MyExt", Свойства);
	Вызов_ = Вызов("ИзменитьСвойстваРасширения");
	Ожидаем.Что(Вызов_.Параметры.Имя).Равно("MyExt");
	Ожидаем.Что(Вызов_.Параметры.А1).ЭтоИстина();
