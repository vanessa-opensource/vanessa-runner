#Область ПолучитьИзмененияКонфигурации

&Тест
Процедура ТестДолжен_ВернутьПусто_ЕслиКешНеЗадан() Экспорт
	Результат = Движок.ПолучитьИзмененияКонфигурации(ПарПодключенияФайл, "C:\\src");
	Ожидаем.Что(Результат.ТребуетсяПолнаяЗагрузка).ЭтоЛожь();
	Ожидаем.Что(Результат.ИзмененныеФайлы.Количество()).Равно(0);
КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьПусто_ЕслиФайлКешаНеСуществует() Экспорт
	Результат = Движок.ПолучитьИзмененияКонфигурации(
		ПарПодключенияФайл, "C:\\src", "C:\\not-exists\\dump-info.xml");
	Ожидаем.Что(Результат.ИзмененныеФайлы.Количество()).Равно(0);
КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьПусто_ПриОшибкеВыгрузкиИзменений() Экспорт
	КатТмп = ВременныеФайлы.СоздатьКаталог();
	ПутьКеша = ОбъединитьПути(КатТмп, "dump-info.xml");
	Запись = Новый ЗаписьТекста(ПутьКеша, "UTF-8");
	Запись.ЗаписатьСтроку("<some/>");
	Запись.Закрыть();

	Менеджер.СБрасыванием("ВыгрузитьВФайлИзмененияКонфигурации");
	Результат = Движок.ПолучитьИзмененияКонфигурации(ПарПодключенияФайл, "C:\\src", ПутьКеша);

	Ожидаем.Что(Результат.ТребуетсяПолнаяЗагрузка).ЭтоЛожь();
	Ожидаем.Что(Результат.ИзмененныеФайлы.Количество()).Равно(0);
КонецПроцедуры

#КонецОбласти
