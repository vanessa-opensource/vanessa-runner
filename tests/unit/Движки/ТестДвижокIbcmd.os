	Вызов_ = Вызов("УстановитьПараметрыСервернойИБ");
	Ожидаем.Что(Вызов_).Заполнено();
	Ожидаем.Что(Вызов_.Параметры.Тип).Равно("PostgreSQL");
	Ожидаем.Что(Вызов_.Параметры.БД).Равно("ib");
	Ожидаем.Что(Вызов("УстановитьПараметрыАвторизацииИБ").Параметры.Польз).Равно("Admin");
КонецПроцедуры

