	Ожидаем.Что(Вызов("ЗагрузитьКонфигурациюИзФайлов").Параметры.Каталог).Равно("C:\\src");
	Ожидаем.Что(КоличествоВызовов("ЗагрузитьВыбранныеФайлыКонфигурации")).Равно(0);
