&Тест
Процедура ТестДолжен_ЗагрузитьВыбранныеФайлы_ЕслиЗаданСписок() Экспорт
	КатТмп = ВременныеФайлы.СоздатьКаталог();
	ПутьСписка = ОбъединитьПути(КатТмп, "list.txt");
	Запись = Новый ЗаписьТекста(ПутьСписка, "UTF-8");
	Запись.ЗаписатьСтроку("Configuration.xml");
	Запись.ЗаписатьСтроку("Catalogs/Товары.xml");
	Запись.Закрыть();

	Движок.ЗагрузитьКонфигурациюИзФайлов(ПарПодключенияФайл, "C:\\src", Неопределено, ПутьСписка);
	Вызов_ = Вызов("ЗагрузитьВыбранныеФайлыКонфигурации");
	Ожидаем.Что(Вызов_).Заполнено();
	Ожидаем.Что(Вызов_.Параметры.Файлы.Количество()).Равно(2);
КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗагрузитьИзФайлов_ЕслиСписокПустой() Экспорт
	КатТмп = ВременныеФайлы.СоздатьКаталог();
	ПутьСписка = ОбъединитьПути(КатТмп, "list.txt");
	Запись = Новый ЗаписьТекста(ПутьСписка, "UTF-8");
	Запись.ЗаписатьСтроку("");
	Запись.Закрыть();

	Движок.ЗагрузитьКонфигурациюИзФайлов(ПарПодключенияФайл, "C:\\src", Неопределено, ПутьСписка);
	Ожидаем.Что(КоличествоВызовов("ЗагрузитьВыбранныеФайлыКонфигурации")).Равно(0);
	Ожидаем.Что(КоличествоВызовов("ЗагрузитьКонфигурациюИзФайлов")).Равно(1);
КонецПроцедуры

