&Тест
Процедура ТестДолжен_ОбновитьВсеРасширения_ИзСпискаОписаний() Экспорт
	Описание1 = Новый Соответствие;
	Описание1.Вставить("name", "ExtA");
	Описание2 = Новый Соответствие;
	Описание2.Вставить("name", "ExtB");
	Менеджер.СписокОписанийРасширений.Добавить(Описание1);
	Менеджер.СписокОписанийРасширений.Добавить(Описание2);

	Настройки = Новый Структура("ОбновитьВсеРасширения", Истина);
	Движок.ОбновитьКонфигурациюБД(ПарПодключенияФайл, Неопределено, Настройки);

	Ожидаем.Что(КоличествоВызовов("ОбновитьКонфигурациюБазыДанных")).Равно(2);
КонецПроцедуры

&Тест
Процедура ТестДолжен_ПропуститьОбновлениеВсех_ЕслиСписокПуст() Экспорт
