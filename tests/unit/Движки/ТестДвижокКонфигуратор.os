	Ожидаем.Что(Стенд.Вызовы("УправлениеКонфигуратором", "УстановитьКонтекст")).ИмеетДлину(1);
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().УстановитьКонтекст("File=base", "Admin", "secret");

КонецПроцедуры

// issue #747: строка подключения уходит в командную строку платформы как есть, поэтому путь
// файловой ИБ без кавычек обрезался по первому пробелу, и команда молча работала с другой базой.
&Тест
Процедура ТестДолжен_ОбернутьПутьФайловойБазыВКавычки_ЕслиВНемЕстьПробел() Экспорт

	// Дано
	ПутьСПробелом = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "каталог с пробелом");
	СоздатьКаталог(ПутьСПробелом);

	// Когда
	Движок.НовыйКонфигуратор(Неопределено, ТестовыеДанные.Подключение("/F" + ПутьСПробелом));

	// Тогда
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().УстановитьКонтекст("/F""" + ПутьСПробелом + """", "", "");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьУжеЗакавыченныйПутьФайловойБазы() Экспорт

	Каталог = ВременныеФайлы.СоздатьКаталог();

	Движок.НовыйКонфигуратор(Неопределено, ТестовыеДанные.Подключение("/F""" + Каталог + """"));

	Конфигуратор.ПроверитьЧтоВызывалсяМетод().УстановитьКонтекст("/F""" + Каталог + """", "", "");

КонецПроцедуры

