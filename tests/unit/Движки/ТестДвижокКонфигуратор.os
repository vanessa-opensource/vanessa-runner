#КонецОбласти

#Область ВыполнитьПроверкуКонфигурации

&Тест
Процедура ТестДолжен_ВернутьУспешноИВыводКоманды_ПриУспешнойПроверке() Экспорт

	// Дано
	Конфигуратор.Когда().ВыводКоманды().ТогдаВозвращает("вывод проверки");

	// Когда
	Результат = Движок.ВыполнитьПроверкуКонфигурации(Подключение, ТестовыеДанные.Массив("-ThinClient", "-Server"));

	// Тогда - режимы переданы ключами, хранилище не задано
	Ожидаем.Что(Результат.Успешно).ЭтоИстина();
	Ожидаем.Что(Результат.ВыводКоманды).Равно("вывод проверки");
	Вызов = Стенд.Вызовы("УправлениеКонфигуратором", "ВыполнитьРасширеннуюПроверкуКонфигуратора")[0];
	Ожидаем.Что(Вызов.Ключи["-ThinClient"], "ключ -ThinClient").ЭтоИстина();
	Ожидаем.Что(Вызов.Ключи["-Server"], "ключ -Server").ЭтоИстина();
	Ожидаем.Что(Вызов.СтрокаСоединенияСХранилищем, "адрес хранилища").Равно("");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПередатьХранилищеВПроверку_ЕслиОноЗадано() Экспорт

	// Дано
	Хранилище = Новый Структура("АдресХранилища, Пользователь, Пароль", "tcp://r/repo", "u", "p");

	// Когда
	Движок.ВыполнитьПроверкуКонфигурации(Подключение, ТестовыеДанные.Массив("-Server"), Хранилище);

	// Тогда
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().ВыполнитьРасширеннуюПроверкуКонфигуратора(Любое, "tcp://r/repo", "u", "p");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьНеуспешноИВыводКоманды_ПриОшибкеПроверки() Экспорт

	// Дано
	Конфигуратор.Когда().ВыполнитьРасширеннуюПроверкуКонфигуратора(Любое, Любое, Любое, Любое)
		.ТогдаВыбрасываетИсключение("стаб: проверка упала");
	Конфигуратор.Когда().ВыводКоманды().ТогдаВозвращает("вывод проверки");

	// Когда
	Результат = Движок.ВыполнитьПроверкуКонфигурации(Подключение, ТестовыеДанные.Массив("-Server"));

	// Тогда - ошибка не пробрасывается, вывод сохраняется для разбора замечаний
	Ожидаем.Что(Результат.Успешно).ЭтоЛожь();
	Ожидаем.Что(Результат.ВыводКоманды).Равно("вывод проверки");

КонецПроцедуры

#КонецОбласти

#Область НовыйКонфигуратор

&Тест
Процедура ТестДолжен_ВернутьКонфигураторБезКонтекста_ЕслиПодключениеНеЗадано() Экспорт

