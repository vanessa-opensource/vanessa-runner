// Прогоняет ПолучитьИзмененияКонфигурации со стабом, который пишет
// заданное содержимое в файл изменений.
Функция ИзмененияИзФайла(Знач Содержимое)
	КаталогТмп = ВременныеФайлы.СоздатьКаталог();
	ПутьКешу = ОбъединитьПути(КаталогТмп, "dump-info.xml");
	Запись = Новый ЗаписьТекста(ПутьКешу, "UTF-8");
	Запись.ЗаписатьСтроку("<some/>");
	Запись.Закрыть();

	Конф.СодержимоеФайлаИзменений = Содержимое;

	Возврат Движок.ПолучитьИзмененияКонфигурации(ПарПодключения, "C:\\src", ПутьКешу);
КонецФункции

