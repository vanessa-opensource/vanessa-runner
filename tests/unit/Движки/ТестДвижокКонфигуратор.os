	Ожидаем.Что(Движок.СформироватьКоманднуюСтроку("C:\bin\1cv8.exe", Новый Массив), "без пробела - без кавычек")
		.Равно("C:\bin\1cv8.exe ");

КонецПроцедуры

#КонецОбласти

#Область ЗамаскироватьПароли

// Командная строка платформы уходит в DEBUG-лог (в CI e2e идут в DEBUG) - пароли ИБ и хранилища
// в ней не должны быть видны, остальные ключи остаются как есть.
&Тест
Процедура ТестДолжен_ЗамаскироватьПароли_ВКоманднойСтрокеДляЛога() Экспорт

	КоманднаяСтрока = "1cv8.exe DESIGNER /F""C:\base"" /N""Admin"" /P""se cret"""
		+ " /ConfigurationRepositoryF""C:\repo"" /ConfigurationRepositoryN""user"" /ConfigurationRepositoryP""repo-pwd"""
		+ " /Out""C:\out.txt"" /P123 /DisableStartupDialogs";

	Результат = Движок.ЗамаскироватьПароли(КоманднаяСтрока);

	Ожидаем.Что(СтрНайти(Результат, "se cret"), "пароль ИБ скрыт").Равно(0);
	Ожидаем.Что(СтрНайти(Результат, "repo-pwd"), "пароль хранилища скрыт").Равно(0);
	Ожидаем.Что(СтрНайти(Результат, "/P123"), "пароль без кавычек скрыт").Равно(0);
	Ожидаем.Что(Результат).Содержит("/P*** /ConfigurationRepositoryF");
	Ожидаем.Что(Результат).Содержит("/ConfigurationRepositoryP*** /Out");
	Ожидаем.Что(Результат).Содержит("/P*** /DisableStartupDialogs");
	Ожидаем.Что(Результат).Содержит("/N""Admin""");
	Ожидаем.Что(Результат).Содержит("/ConfigurationRepositoryN""user""");
	Ожидаем.Что(Результат).Содержит("/F""C:\base""");

КонецПроцедуры

#КонецОбласти

