#Область НормализацияСтрокиПодключения

// issue #747: строка подключения уходит в командную строку платформы как есть,
// поэтому путь файловой ИБ без кавычек обрезался по первому пробелу, и команда
// молча работала с другой базой.
&Тест
Процедура ТестДолжен_ОбернутьПутьФайловойБазыВКавычки_ЕслиВНемЕстьПробел() Экспорт

	// Дано
	Каталог = ВременныеФайлы.СоздатьКаталог();
	ПутьСПробелом = ОбъединитьПути(Каталог, "каталог с пробелом");
	СоздатьКаталог(ПутьСПробелом);
	Пар = Новый Структура("СтрокаПодключения, Пользователь, Пароль", "/F" + ПутьСПробелом, "", "");

	// Когда
	Движок.НовыйКонфигуратор(Неопределено, Пар);

	// Тогда
	Ожидаем.Что(Конф.СтрокаПодключения_).Равно("/F""" + ПутьСПробелом + """");

КонецПроцедуры

