#Область ПроверкаКонфигурации

&Тест
Процедура ТестДолжен_ВернутьУспешно_ПриУспешнойПроверке() Экспорт
	Режимы = Новый Массив;
	Режимы.Добавить("-ThinClient");
	Режимы.Добавить("-Server");
	Результат = Движок.ВыполнитьПроверкуКонфигурации(ПарПодключения, Режимы);
	Ожидаем.Что(Результат.Успешно).ЭтоИстина();
	Ожидаем.Что(Результат.ВыводКоманды).Равно("STDOUT-stub");
	Вызов_ = Вызов("ВыполнитьРасширеннуюПроверкуКонфигуратора");
	Ожидаем.Что(Вызов_.Параметры["-ThinClient"]).ЭтоИстина();
КонецПроцедуры

&Тест
Процедура ТестДолжен_ПодключитьсяКХранилищу_ЕслиЗадан() Экспорт
	Режимы = Новый Массив;
	Режимы.Добавить("-Server");
	ПХ = Новый Структура("АдресХранилища, Пользователь, Пароль",
		"tcp://r/repo", "u", "p");
	Движок.ВыполнитьПроверкуКонфигурации(ПарПодключения, Режимы, ПХ);
	Вызов_ = Вызов("ПодключитьсяКХранилищуКонфигурации");
	Ожидаем.Что(Вызов_.Параметры.Адрес).Равно("tcp://r/repo");
КонецПроцедуры

