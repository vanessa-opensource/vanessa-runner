// BSLLS-off
// Юнит-тесты ДвижокКонфигуратор: делегации в v8runner, ветки, обработка ошибок, чистые функции
// сборки командной строки. v8runner.УправлениеКонфигуратором замокан и подставлен через фабрику.
// Запуск процессов 1С (ЗапуститьПредприятие/ЗапуститьКонфигуратор) требует платформы - живёт в e2e.

#Использовать asserts
#Использовать moskito
#Использовать tempfiles
#Использовать "../utils"

Перем Стенд;
Перем Движок;
Перем Конфигуратор; // мок v8runner.УправлениеКонфигуратором, который движок получает из фабрики
Перем Подключение;
Перем Любое;

&ПередКаждым
Процедура ПередКаждым() Экспорт
	Стенд = Новый Стенд;
	Стенд.Реальный("ФайловыеОперации"); // движок создаёт каталоги выходных файлов
	Конфигуратор = Стенд.Мок("УправлениеКонфигуратором");
	Стенд.Подменить("_ФабрикаКонфигуратора", Новый ФабрикаСтаб(Конфигуратор));
	Движок = Стенд.Сервис("ДвижокКонфигуратор");
	Подключение = ТестовыеДанные.Подключение("File=base", "Admin", "secret");
	Любое = Матчеры.ЛюбоеЗначение();
КонецПроцедуры

#Область СоздатьВременнуюБазу

&Тест
Процедура ТестДолжен_СоздатьВременнуюБазу_ВНовомВременномКаталоге() Экспорт

	// Когда
	Результат = Движок.СоздатьВременнуюБазу();

	// Тогда
	Ожидаем.Что(Результат.КаталогБазы).Заполнено();
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().СоздатьФайловуюБазу(Результат.КаталогБазы, Любое, Любое);

КонецПроцедуры

#КонецОбласти

#Область ЗагрузитьКонфигурациюИзФайлов

&Тест
Процедура ТестДолжен_ЗагрузитьКонфигурациюИзФайлов_БезСпискаФайлов() Экспорт

	// Когда
	Движок.ЗагрузитьКонфигурациюИзФайлов(Подключение, "src");

	// Тогда
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().ЗагрузитьКонфигурациюИзФайлов("src", "");

КонецПроцедуры

#КонецОбласти

#Область ПолучитьИзмененияКонфигурации

&Тест
Процедура ТестДолжен_ВернутьПустыеИзменения_ЕслиКешНеЗадан() Экспорт

	// Когда
	Результат = Движок.ПолучитьИзмененияКонфигурации(Подключение, "src");

	// Тогда
	Ожидаем.Что(Результат.ТребуетсяПолнаяЗагрузка).ЭтоЛожь();
	Ожидаем.Что(Результат.ИзмененныеФайлы).ИмеетДлину(0);
	Стенд.ПроверитьЧтоНеВызывался("УправлениеКонфигуратором", "ВыгрузитьИзмененияКонфигурацииВФайл");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьПустыеИзменения_ЕслиФайлКешаНеСуществует() Экспорт

	// Когда
	Результат = Движок.ПолучитьИзмененияКонфигурации(Подключение, "src", "not-exists/dump-info.xml");

	// Тогда
	Ожидаем.Что(Результат.ИзмененныеФайлы).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПотребоватьПолнуюЗагрузкуИОчиститьКеш_ПриОшибкеВыгрузкиИзменений() Экспорт

	// Дано
	ПутьКешу = ТестовыеФайлы.ЗаписатьФайл(ВременныеФайлы.НовоеИмяФайла("xml"), "<some/>");
	Конфигуратор.Когда().ВыгрузитьИзмененияКонфигурацииВФайл(Любое, Любое, Любое, Любое, Любое)
		.ТогдаВыбрасываетИсключение("стаб: выгрузка изменений упала");

	// Когда
	Результат = Движок.ПолучитьИзмененияКонфигурации(Подключение, "src", ПутьКешу);

	// Тогда
	Ожидаем.Что(Результат.ТребуетсяПолнаяЗагрузка).ЭтоИстина();
	Ожидаем.Что(ТестовыеФайлы.Существует(ПутьКешу), "кеш ConfigDumpInfo очищен").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазобратьИзмененныеОбъекты_ВОтносительныеПути() Экспорт

	Результат = ИзмененияИзФайла(
		"modified: Catalog.Номенклатура
		|modified: Document.ЗаказПокупателя");

	Ожидаем.Что(Результат.ТребуетсяПолнаяЗагрузка).ЭтоЛожь();
	Ожидаем.Что(Результат.ИзмененныеФайлы).ИмеетДлину(2);
	Ожидаем.Что(Результат.ИзмененныеФайлы).Содержит("Catalogs/Номенклатура.xml");
	Ожидаем.Что(Результат.ИзмененныеФайлы).Содержит("Documents/ЗаказПокупателя.xml");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПотребоватьПолнуюЗагрузку_ПоМаркеруFulldump() Экспорт

	Результат = ИзмененияИзФайла("fulldump");

	Ожидаем.Что(Результат.ТребуетсяПолнаяЗагрузка).ЭтоИстина();
	Ожидаем.Что(Результат.ИзмененныеФайлы).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазобратьИзменениеКорняКонфигурации_ВConfigurationXml() Экспорт

	Результат = ИзмененияИзФайла(
		"modified: Configuration.УправлениеТорговлей
		|modified: БезИмениОбъекта");

	Ожидаем.Что(Результат.ИзмененныеФайлы).ИмеетДлину(1);
	Ожидаем.Что(Результат.ИзмененныеФайлы[0]).Равно("Configuration.xml");

КонецПроцедуры

#КонецОбласти

#Область ЗагрузитьВыгрузитьКонфигурацию

&Тест
Процедура ТестДолжен_ЗагрузитьКонфигурациюИзФайлаCf() Экспорт

	Движок.ЗагрузитьКонфигурациюИзФайла(Подключение, "my.cf");

	Конфигуратор.ПроверитьЧтоВызывалсяМетод().ЗагрузитьКонфигурациюИзФайла("my.cf", Любое);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыгрузитьКонфигурациюВФайлCf() Экспорт

	Движок.ВыгрузитьКонфигурациюВФайл(Подключение, "out.cf");

	Конфигуратор.ПроверитьЧтоВызывалсяМетод().ВыгрузитьКонфигурациюВФайл("out.cf");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьКаталогВывода_ПриВыгрузкеCf() Экспорт

	// Дано
	КаталогВывода = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "build");

	// Когда
	Движок.ВыгрузитьКонфигурациюВФайл(Подключение, ОбъединитьПути(КаталогВывода, "conf.cf"));

	// Тогда
	Ожидаем.Что(ТестовыеФайлы.Существует(КаталогВывода), "недостающий каталог вывода создаётся автоматически").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьПолныйФайлПоставки_СУстановкойКонтекста() Экспорт

	// Дано
	КаталогВывода = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "dist");
	ПутьCf = ОбъединитьПути(КаталогВывода, "1Cv8.cf");

	// Когда
	Движок.СоздатьФайлыПоставки(Подключение, ПутьCf);

	// Тогда
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().СоздатьФайлыПоставки(ПутьCf, Любое, Любое, Любое);
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().УстановитьКонтекст("File=base", "Admin", "secret");
	Ожидаем.Что(ТестовыеФайлы.Существует(КаталогВывода), "недостающий каталог файла поставки создаётся автоматически").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыгрузитьКонфигурациюВФайлы() Экспорт

	Движок.ВыгрузитьКонфигурациюВФайлы(Подключение, "src-out");

	Конфигуратор.ПроверитьЧтоВызывалсяМетод().ВыгрузитьКонфигурациюВФайлы("src-out", Любое, Любое, Любое, Любое);

КонецПроцедуры

#КонецОбласти

#Область ОбъединитьИОбновитьКонфигурацию

&Тест
Процедура ТестДолжен_ОбъединитьКонфигурациюСФайлом_СПереданнымиФлагами() Экспорт

	Движок.ОбъединитьКонфигурациюСФайлом(Подключение, "src.cf", "settings.xml", Истина, Ложь, Истина);

	Конфигуратор.ПроверитьЧтоВызывалсяМетод()
		.ОбъединитьКонфигурациюСФайлом("src.cf", "settings.xml", Истина, Ложь, Истина, Любое, Любое);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОбновитьКонфигурациюИзФайла_СПереданнымиФлагами() Экспорт

	// Когда - флаг неразрешённых ссылок не передан, принудительно, с выводом дважды изменённых свойств
	Движок.ОбновитьКонфигурациюИзФайла(Подключение, "1cv8.cfu", "settings.xml", Неопределено, Истина, Истина);

	// Тогда
	Конфигуратор.ПроверитьЧтоВызывалсяМетод()
		.ОбновитьКонфигурациюИзФайла("1cv8.cfu", "settings.xml", Неопределено, Истина, Истина);

КонецПроцедуры

#КонецОбласти

#Область СравнитьКонфигурации

&Тест
Процедура ТестДолжен_СравнитьДваФайла_ЕслиПервыйФайлЗадан() Экспорт

	Путь = Движок.СравнитьКонфигурации(Подключение, "b.cf", "report.txt", "полный", "txt", "a.cf");

	Ожидаем.Что(Путь).Равно("report.txt");
	Конфигуратор.ПроверитьЧтоВызывалсяМетод()
		.ПолучитьОтчетОСравненииКонфигурацииСФайлом("b.cf", "report.txt", "полный", "txt", Любое, "a.cf");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СравнитьСБазой_ЕслиПервыйФайлНеЗадан() Экспорт

	Движок.СравнитьКонфигурации(Подключение, "b.cf", "rep.txt", "полный", "txt");

	Конфигуратор.ПроверитьЧтоВызывалсяМетод()
		.ПолучитьОтчетОСравненииКонфигурацииСФайлом("b.cf", "rep.txt", "полный", "txt", Любое, Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СравнитьРасширения_СИменемРасширения() Экспорт

	Движок.СравнитьРасширения(Подключение, "MyExt", "b.cfe", "rep.txt", "полный", "txt");

	Конфигуратор.ПроверитьЧтоВызывалсяМетод()
		.ПолучитьОтчетОСравненииКонфигурацииСФайлом("b.cfe", "rep.txt", "полный", "txt", "MyExt", Неопределено);

КонецПроцедуры

#КонецОбласти

#Область СоздатьФайловуюБазу

&Тест
Процедура ТестДолжен_СоздатьФайловуюБазу_ИВернутьПараметрыПодключения() Экспорт

	// Когда
	Результат = Движок.СоздатьФайловуюБазу("base");

	// Тогда
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().СоздатьФайловуюБазу("base", Любое, Любое);
	Ожидаем.Что(Результат.КаталогБазы).Равно("base");
	Ожидаем.Что(Результат.СтрокаПодключения).Содержит("base");
	Ожидаем.Что(Результат.Пользователь).Равно("");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПеренаправитьСлужебныйФайлВывода_ВоВременныйКаталог() Экспорт

	// issue #721: /Out платформы по умолчанию оседает в рабочем каталоге пустым .txt.
	// Любая операция через конфигуратор перенаправляет его в зарегистрированный временный файл.
	ФайлыДо = ВременныеФайлы.Файлы();

	Движок.СоздатьФайловуюБазу("base");

	ФайлыПосле = ВременныеФайлы.Файлы();
	Ожидаем.Что(ФайлыПосле.Количество()).Равно(ФайлыДо.Количество() + 1);
	Конфигуратор.ПроверитьЧтоВызывалсяМетод()
		.УстановитьИмяФайлаСообщенийПлатформы(ФайлыПосле[ФайлыПосле.Количество() - 1], Любое);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеНастраиватьПлатформу_ЕслиПараметрыНеЗаданы() Экспорт

	Движок.СоздатьФайловуюБазу("base");

	Стенд.ПроверитьЧтоНеВызывался("УправлениеКонфигуратором", "ИспользоватьВерсиюПлатформы");
	Стенд.ПроверитьЧтоНеВызывался("УправлениеКонфигуратором", "УстановитьКлючРазрешенияЗапуска");
	Стенд.ПроверитьЧтоНеВызывался("УправлениеКонфигуратором", "УстановитьКодЯзыка");
	Стенд.ПроверитьЧтоНеВызывался("УправлениеКонфигуратором", "УстановитьКодЯзыкаСеанса");

КонецПроцедуры

&Тест
Процедура ТестДолжен_УстановитьВсеПараметрыПлатформы_ЕслиОниЗаданы() Экспорт

	// Дано
	ПараметрыПлатформы = Новый Структура("ВерсияПлатформы, КодРазрешения, Язык, Локаль",
		"8.3.20.1234", "key123", "ru", "ru_RU");

	// Когда
	Движок.СоздатьФайловуюБазу("base", ПараметрыПлатформы);

	// Тогда
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().ИспользоватьВерсиюПлатформы("8.3.20.1234", Любое);
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().УстановитьКлючРазрешенияЗапуска("key123");
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().УстановитьКодЯзыка("ru");
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().УстановитьКодЯзыкаСеанса("ru_RU");

КонецПроцедуры

#КонецОбласти

#Область ЗагрузитьВыгрузитьИнфобазу

&Тест
Процедура ТестДолжен_ЗагрузитьИнфобазуИзDT_СУстановкойКонтекста() Экспорт

	Движок.ЗагрузитьИнфобазуИзФайла(Подключение, "dump.dt");

	Конфигуратор.ПроверитьЧтоВызывалсяМетод().УстановитьКонтекст("File=base", "Admin", "secret");
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().ЗагрузитьИнформационнуюБазу("dump.dt", Любое);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыгрузитьИнфобазуВDT() Экспорт

	Движок.ВыгрузитьИнфобазуВФайл(Подключение, "out.dt");

	Конфигуратор.ПроверитьЧтоВызывалсяМетод().ВыгрузитьИнформационнуюБазу("out.dt");

КонецПроцедуры

#КонецОбласти

#Область ОбновитьКонфигурациюБД

&Тест
Процедура ТестДолжен_ВызватьСтандартноеОбновление_БезРежимаРеструктуризации() Экспорт

	Движок.ОбновитьКонфигурациюБД(Подключение);

	Конфигуратор.ПроверитьЧтоВызывалсяМетод().ОбновитьКонфигурациюБазыДанных(Ложь, Истина, Ложь, "", Ложь);
	Стенд.ПроверитьЧтоНеВызывался("УправлениеКонфигуратором", "ОбновитьКонфигурациюБазыДанныхНаСервере");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВызватьСервернуюВетку_ПриРежимеРеструктуризации() Экспорт

	// Дано
	Настройки = Новый Структура("РежимРеструктуризации, ИмяРасширения, ОбновитьВсеРасширения, ДинамическоеОбновление",
		"v2", "MyExt", Истина, Истина);

	// Когда
	Движок.ОбновитьКонфигурациюБД(Подключение, Неопределено, Настройки);

	// Тогда - серверная ветка; пятый параметр v8runner - ЗавершатьСеансы, а не «все расширения»
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().ОбновитьКонфигурациюБазыДанныхНаСервере(Ложь, Истина, "v2", "MyExt", Ложь);
	Стенд.ПроверитьЧтоНеВызывался("УправлениеКонфигуратором", "ОбновитьКонфигурациюБазыДанных");

КонецПроцедуры

#КонецОбласти

#Область ВнешниеОбработки

&Тест
Процедура ТестДолжен_СобратьВнешнююОбработку_ЧерезВыполнитьКоманду() Экспорт

	// Когда
	Движок.СобратьВнешнююОбработкуИзФайлов(Подключение, "src.xml", "out.epf");

	// Тогда - к стандартным параметрам запуска добавлен ключ загрузки из файлов и пути
	Параметры = Стенд.Вызовы("УправлениеКонфигуратором", "ВыполнитьКоманду")[0].Параметры;
	Ожидаем.Что(СтрСоединить(Параметры, " ")).Содержит("/LoadExternalDataProcessorOrReportFromFiles");
	Ожидаем.Что(СтрСоединить(Параметры, " ")).Содержит("src.xml");
	Ожидаем.Что(СтрСоединить(Параметры, " ")).Содержит("out.epf");

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазобратьВнешнююОбработку_ВФайлы() Экспорт

	Движок.РазобратьВнешнююОбработкуВФайлы(Подключение, "my.epf", "unp");

	Конфигуратор.ПроверитьЧтоВызывалсяМетод().ВыгрузитьВнешниеОтчетыИлиОбработкиВФайлы("unp", "my.epf", Любое);

КонецПроцедуры

#КонецОбласти

#Область Расширения

&Тест
Процедура ТестДолжен_ЗагрузитьРасширениеИзФайла() Экспорт

	Движок.ЗагрузитьРасширениеИзФайла(Подключение, "ext.cfe", "MyExt");

	Конфигуратор.ПроверитьЧтоВызывалсяМетод().ЗагрузитьРасширениеИзФайла("ext.cfe", "MyExt", Любое);

КонецПроцедуры

