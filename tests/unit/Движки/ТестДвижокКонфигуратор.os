// BSLLS:NumberOfValuesInStructureConstructor-off
// BSLLS-off
// Юнит-тесты ДвижокКонфигуратор - тонкие делегации, ветки и обработка ошибок.
// Запуск процессов 1С (ЗапуститьПредприятие/ЗапуститьКонфигуратор) - НЕ покрываем,
// они требуют реальной платформы и должны жить в e2e.

#Использовать asserts
#Использовать tempfiles

#Использовать "../../../src/core/Движки"
#Использовать "../utils"

Перем ПарПодключения;
Перем Конф;
Перем Движок;

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	ПарПодключения = Новый Структура("СтрокаПодключения, Пользователь, Пароль",
		"File=base", "Admin", "secret");
	Конф = Новый УправлениеКонфигураторомСтаб();
	Движок = Новый БилдерДвижкаКонфигуратор()
		.СФабрикойКонфигуратора(Конф)
		.Собрать();
КонецПроцедуры

Функция Вызов(Имя)
	Для Каждого В Из Конф.Вызовы Цикл
		Если В.Метод = Имя Тогда
			Возврат В;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция КоличествоВызовов(Имя)
	К = 0;
	Для Каждого В Из Конф.Вызовы Цикл
		Если В.Метод = Имя Тогда К = К + 1; КонецЕсли;
	КонецЦикла;
	Возврат К;
КонецФункции

// Копия стандартного массива параметров запуска v8runner: [2] содержит /Out,
// указывающий в рабочий каталог (эмуляция УправлениеКонфигураторомСтаб).
Функция ПараметрыЗапускаСтаб()
	Параметры = Новый Массив;
	Параметры.Добавить("ENTERPRISE");
	Параметры.Добавить("/IBConnectionString""File=stub""");
	Параметры.Добавить("/Out ""default-out""");
	Возврат Параметры;
КонецФункции

#Область СлужебныйФайлВывода

&Тест
Процедура ТестДолжен_ПеренаправитьСлужебныйФайлВыводаВоВременныйКаталог() Экспорт
	// issue #721: /Out платформы по умолчанию оседает в рабочем каталоге пустым .txt.
	// Любая операция через конфигуратор должна перенаправлять его во временный файл.
	ФайлыДо = ВременныеФайлы.Файлы();

	Движок.СоздатьФайловуюБазу("C:\\base");

	Вызов_ = Вызов("УстановитьИмяФайлаСообщенийПлатформы");
	Ожидаем.Что(Вызов_, "служебный файл вывода платформы должен быть переопределён").Заполнено();

	// Путь ведёт в зарегистрированный временный файл (создаётся и вычищается в temp,
	// а не в рабочем каталоге проекта).
	ФайлыПосле = ВременныеФайлы.Файлы();
	Ожидаем.Что(ФайлыПосле.Количество()).Равно(ФайлыДо.Количество() + 1);
	НовыйВременныйФайл = ФайлыПосле[ФайлыПосле.Количество() - 1];
	Ожидаем.Что(Вызов_.Параметры).Равно(НовыйВременныйФайл);
КонецПроцедуры

#КонецОбласти

