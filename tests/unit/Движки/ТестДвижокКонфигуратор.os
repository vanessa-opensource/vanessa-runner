		"C:\\not-exists\\dump-info.xml");
	Ожидаем.Что(Результат.ИзмененныеФайлы.Количество()).Равно(0);
КонецПроцедуры

&Тест
Процедура ТестДолжен_ПереключитьсяНаПолнуюЗагрузку_ПриОшибкеВыгрузки() Экспорт
	КаталогТмп = ВременныеФайлы.СоздатьКаталог();
	Попытка
		ПутьКешу = ОбъединитьПути(КаталогТмп, "dump-info.xml");
		Запись = Новый ЗаписьТекста(ПутьКешу, "UTF-8");
		Запись.ЗаписатьСтроку("<some/>");
		Запись.Закрыть();

		Конф.СБросанием("ВыгрузитьИзмененияКонфигурацииВФайл");
		Результат = Движок.ПолучитьИзмененияКонфигурации(ПарПодключения, "C:\\src", ПутьКешу);

		Ожидаем.Что(Результат.ТребуетсяПолнаяЗагрузка).ЭтоИстина();
	Исключение
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

#Область ПрерватьЕслиСерверМертв

&Тест
Процедура ТестДолжен_ПрерватьПроцесс_ЕслиСерверМертв() Экспорт

	// Дано - процесс не завершён, монитор сообщает что сервер мёртв
	Процесс = Новый ПроцессПлатформыСтаб();
	Монитор = Новый МониторСервераСтаб().Мертвым();

	// Когда / Тогда - ожидаем исключение healthcheck и что процесс прерван
	Попытка
		Движок.ПрерватьЕслиСерверМертв(Процесс, Монитор);
		ВызватьИсключение "Должно было упасть";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("healthcheck");
	КонецПопытки;

	Ожидаем.Что(Процесс.КоличествоВызововЗавершить).Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеПрерывать_ЕслиСерверЖив() Экспорт

	// Дано - процесс не завершён, сервер жив
	Процесс = Новый ПроцессПлатформыСтаб();
	Монитор = Новый МониторСервераСтаб();

	// Когда - проверка не должна бросать
	Движок.ПрерватьЕслиСерверМертв(Процесс, Монитор);

	// Тогда - процесс не прерывался
	Ожидаем.Что(Процесс.КоличествоВызововЗавершить).Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_БытьNoOp_ЕслиМониторНеЗадан() Экспорт

	// Дано - монитор отсутствует
	Процесс = Новый ПроцессПлатформыСтаб();

	// Когда - проверка с Неопределено-монитором
	Движок.ПрерватьЕслиСерверМертв(Процесс, Неопределено);

	// Тогда - процесс не тронут
	Ожидаем.Что(Процесс.КоличествоВызововЗавершить).Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_БытьNoOp_ЕслиПроцессУжеЗавершен() Экспорт

	// Дано - процесс уже завершён, сервер мёртв (но прерывать уже нечего)
	Процесс = Новый ПроцессПлатформыСтаб().Завершенным();
	Монитор = Новый МониторСервераСтаб().Мертвым();

	// Когда - проверка не должна бросать
	Движок.ПрерватьЕслиСерверМертв(Процесс, Монитор);

	// Тогда - Завершить не вызывался повторно
	Ожидаем.Что(Процесс.КоличествоВызововЗавершить).Равно(0);

КонецПроцедуры

#КонецОбласти

#Область НовыйКонфигуратор

&Тест
Процедура ТестДолжен_ВернутьКонфигуратор_БезПодключения_ЕслиПараметрыНеЗаданы() Экспорт
	Результат = Движок.НовыйКонфигуратор();
	Ожидаем.Что(Результат).Равно(Конф);
	Ожидаем.Что(КоличествоВызовов("УстановитьКонтекст")).Равно(0);
КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьКонфигуратор_СУстановкойКонтекста_ЕслиПодключениеЗадано() Экспорт
	Движок.НовыйКонфигуратор(Неопределено, ПарПодключения);
	Ожидаем.Что(КоличествоВызовов("УстановитьКонтекст")).Равно(1);
	Ожидаем.Что(Конф.СтрокаПодключения_).Равно("File=base");
КонецПроцедуры

#КонецОбласти
