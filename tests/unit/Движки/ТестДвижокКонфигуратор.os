// BSLLS:NumberOfValuesInStructureConstructor-off
// BSLLS-off
// Юнит-тесты ДвижокКонфигуратор - тонкие делегации, ветки и обработка ошибок.
// Запуск процессов 1С (ЗапуститьПредприятие/ЗапуститьКонфигуратор) - НЕ покрываем,
// они требуют реальной платформы и должны жить в e2e.

#Использовать asserts
#Использовать tempfiles

#Использовать "../../../src/core/Движки"
#Использовать "../utils"

Перем ПарПодключения;
Перем Конф;
Перем Движок;

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	ПарПодключения = Новый Структура("СтрокаПодключения, Пользователь, Пароль",
		"File=base", "Admin", "secret");
	Конф = Новый УправлениеКонфигураторомСтаб();
	Движок = Новый БилдерДвижкаКонфигуратор()
		.СФабрикойКонфигуратора(Конф)
		.Собрать();
КонецПроцедуры

Функция Вызов(Имя)
	Для Каждого В Из Конф.Вызовы Цикл
		Если В.Метод = Имя Тогда
			Возврат В;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция КоличествоВызовов(Имя)
	К = 0;
	Для Каждого В Из Конф.Вызовы Цикл
		Если В.Метод = Имя Тогда К = К + 1; КонецЕсли;
	КонецЦикла;
	Возврат К;
КонецФункции

#Область НастройкаПлатформы

&Тест
Процедура ТестДолжен_НеНастраиватьПлатформу_ЕслиПараметрыНеЗаданы() Экспорт
	Движок.СоздатьФайловуюБазу("C:\\base");
	Ожидаем.Что(КоличествоВызовов("ИспользоватьВерсиюПлатформы")).Равно(0);
	Ожидаем.Что(Конф.Язык_).Равно("");
КонецПроцедуры

&Тест
Процедура ТестДолжен_УстановитьВсеПараметрыПлатформы() Экспорт
	ПП = Новый Структура("ВерсияПлатформы, КодРазрешения, Язык, Локаль",
		"8.3.20.1234", "key123", "ru", "ru_RU");
	Движок.СоздатьФайловуюБазу("C:\\base", ПП);
	Ожидаем.Что(Конф.ВерсияПлатформы_).Равно("8.3.20.1234");
	Ожидаем.Что(Конф.КодРазрешения_).Равно("key123");
	Ожидаем.Что(Конф.Язык_).Равно("ru");
	Ожидаем.Что(Конф.Локаль_).Равно("ru_RU");
КонецПроцедуры

#КонецОбласти

