		.ВыбрасываетИсключение("неожиданный результат");
КонецПроцедуры

#КонецОбласти

#Область ПодготовитьФайлВыводаПлатформы

&Тест
Процедура ТестДолжен_ПеренаправитьВыводВоВременныйФайл_ВРежимеОжидания() Экспорт

	// Дано - стандартные параметры v8runner: [2] содержит /Out в рабочий каталог
	Параметры = Конфигуратор.ПолучитьПараметрыЗапуска();
	ФайлыДо = ВременныеФайлы.Файлы();

	// Когда
	ФайлВывода = Движок.ПодготовитьФайлВыводаПлатформы(Параметры, Ложь);

	// Тогда - создан ровно один временный файл, и /Out указывает именно на него
	Ожидаем.Что(ВременныеФайлы.Файлы().Количество()).Равно(ФайлыДо.Количество() + 1);
	Ожидаем.Что(ФайлВывода).Заполнено();
	Ожидаем.Что(Параметры[2]).Содержит("/Out");
	Ожидаем.Что(Параметры[2]).Содержит(ФайлВывода);
	Ожидаем.Что(Параметры[2]).Не_().Содержит("default-out");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПеренаправитьВыводВоВременныйФайл_ВРежимеБезОжидания() Экспорт

	// Дано
	Параметры = Конфигуратор.ПолучитьПараметрыЗапуска();
	ФайлыДо = ВременныеФайлы.Файлы();

	// Когда
	ФайлВывода = Движок.ПодготовитьФайлВыводаПлатформы(Параметры, Истина);

	// Тогда - путь не возвращается (файл нельзя удалить синхронно), но /Out всё равно во временном файле
	Ожидаем.Что(ФайлВывода).Равно("");
	ФайлыПосле = ВременныеФайлы.Файлы();
	Ожидаем.Что(ФайлыПосле.Количество()).Равно(ФайлыДо.Количество() + 1);
	Ожидаем.Что(Параметры[2]).Содержит(ФайлыПосле[ФайлыПосле.Количество() - 1]);
	Ожидаем.Что(Параметры[2]).Не_().Содержит("default-out");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// ПолучитьИзмененияКонфигурации с существующим кешем и конфигуратором, который пишет
// заданное содержимое в файл изменений (второй параметр ВыгрузитьИзмененияКонфигурацииВФайл).
Функция ИзмененияИзФайла(Знач Содержимое)

	ПутьКешу = ТестовыеФайлы.ЗаписатьФайл(ВременныеФайлы.НовоеИмяФайла("xml"), "<some/>");
	Конфигуратор.Когда().ВыгрузитьИзмененияКонфигурацииВФайл(Любое, Любое, Любое, Любое, Любое)
		.ТогдаОтвечает(ТестовыеФайлы.ЗаписатьПриВызове(1, Содержимое));

	Возврат Движок.ПолучитьИзмененияКонфигурации(Подключение, "src", ПутьКешу);

КонецФункции

Функция ФайлСтатуса(Знач Содержимое)
	Возврат ТестовыеФайлы.ЗаписатьФайл(ВременныеФайлы.НовоеИмяФайла("txt"), Содержимое);
КонецФункции

Функция НовыеПараметрыЗапускаПредприятия()
	Возврат Новый Структура(
		"НеОжидать, ТолстыйКлиент, КомандаЗапуска, ПутьОбработки, НавигационнаяСсылка,"
		+ " ДополнительныеПараметры, ПутьКФайлуСтатуса",
		Ложь, Ложь, "", "", "", "", "");
КонецФункции

#КонецОбласти
