#Область ПодготовкаФайлаВывода

&Тест
Процедура ТестДолжен_ПеренаправитьВыводВоВременныйФайл_ВРежимеОжидания() Экспорт
	Параметры = ПараметрыЗапускаСтаб();
	ФайлыДо = ВременныеФайлы.Файлы();

	ФайлВывода = Движок.ПодготовитьФайлВыводаПлатформы(Параметры, Ложь);

	// Создан ровно один временный файл, и /Out указывает именно на него.
	Ожидаем.Что(ВременныеФайлы.Файлы().Количество()).Равно(ФайлыДо.Количество() + 1);
	Ожидаем.Что(ФайлВывода).Заполнено();
	Ожидаем.Что(Параметры[2]).Содержит("/Out");
	Ожидаем.Что(Параметры[2]).Содержит(ФайлВывода);
	// Вывод больше не остаётся в рабочем каталоге (стандартный /Out от v8runner заменён).
	Ожидаем.Что(Параметры[2]).Не_().Содержит("default-out");
КонецПроцедуры

&Тест
Процедура ТестДолжен_ПеренаправитьВыводВоВременныйФайл_ВРежимеБезОжидания() Экспорт
	Параметры = ПараметрыЗапускаСтаб();
	ФайлыДо = ВременныеФайлы.Файлы();

	ФайлВывода = Движок.ПодготовитьФайлВыводаПлатформы(Параметры, Истина);

	// В режиме без ожидания путь не возвращается - файл нельзя удалить синхронно.
	Ожидаем.Что(ФайлВывода).Равно("");
	// Но /Out всё равно перенаправлен во временный файл, а не в рабочий каталог.
	ФайлыПосле = ВременныеФайлы.Файлы();
	Ожидаем.Что(ФайлыПосле.Количество()).Равно(ФайлыДо.Количество() + 1);
	НовыйВременныйФайл = ФайлыПосле[ФайлыПосле.Количество() - 1];
	Ожидаем.Что(Параметры[2]).Содержит(НовыйВременныйФайл);
	Ожидаем.Что(Параметры[2]).Не_().Содержит("default-out");
КонецПроцедуры

#КонецОбласти
