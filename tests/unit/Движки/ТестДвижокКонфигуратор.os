#КонецОбласти

#Область КомандаЗапускаДляОС

// Вне Windows OneScript сам режет строку запуска на argv, и с 2.2.0 удвоенная кавычка внутри
// кавычек стала экранированной: платформа получала бы буквальные кавычки в значении /C, а
// пакетный режим xddTestRunner на Linux с ними не стартует. Убираем их, как это де-факто
// делал разбор аргументов раньше; на Windows строка уходит платформе как есть.
&Тест
Процедура ТестДолжен_УбратьУдвоенныеКавычки_ВКомандеЗапускаВнеWindows() Экспорт

	Команда = "xddRun ЗагрузчикФайла """"/home/u/xdd_test.epf""""; workspaceRoot """"/home/u""""; xddShutdown";

	Ожидаем.Что(Движок.КомандаЗапускаДляОС(Команда, Ложь))
		.Равно("xddRun ЗагрузчикФайла /home/u/xdd_test.epf; workspaceRoot /home/u; xddShutdown");
	Ожидаем.Что(Движок.КомандаЗапускаДляОС(Команда, Истина), "Windows - как есть").Равно(Команда);
	Ожидаем.Что(Движок.КомандаЗапускаДляОС("", Ложь)).Равно("");

КонецПроцедуры

