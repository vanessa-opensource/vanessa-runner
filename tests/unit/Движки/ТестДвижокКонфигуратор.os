Функция ФайлСтатуса(Знач Содержимое)
	Путь = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "status.txt");
	Запись = Новый ЗаписьТекста(Путь, "UTF-8");
	Запись.Записать(Содержимое);
	Запись.Закрыть();
	Возврат Путь;
КонецФункции

