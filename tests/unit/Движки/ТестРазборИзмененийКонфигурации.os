// BSLLS-off
// Юнит-тесты РазборИзмененийКонфигурации: общий для движков разбор файла изменений
// (вывода сравнения с кешем ConfigDumpInfo) в относительные пути XML-выгрузки. Файлы - временные.

#Использовать asserts
#Использовать tempfiles
#Использовать "../../../src/core/Движки"
#Использовать "../utils"

Перем Разбор;

&ПередКаждым
Процедура ПередКаждым() Экспорт
	Разбор = Новый РазборИзмененийКонфигурации;
КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт
	ВременныеФайлы.Удалить();
КонецПроцедуры

#Область Разобрать

&Тест
Процедура ТестДолжен_ВернутьПусто_ЕслиФайлаНет() Экспорт

	Результат = Разбор.Разобрать(ВременныеФайлы.НовоеИмяФайла("txt"));

	Ожидаем.Что(Результат.ТребуетсяПолнаяЗагрузка).ЭтоЛожь();
	Ожидаем.Что(Результат.ИзмененныеФайлы.Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазобратьОбъекты_ВОтносительныеПути() Экспорт

	Результат = РазобратьТекст(
		"modified: Catalog.Номенклатура
		|modified: Document.Заказ");

	Ожидаем.Что(Результат.ИзмененныеФайлы.Количество()).Равно(2);
	Ожидаем.Что(Результат.ИзмененныеФайлы.Найти("Catalogs/Номенклатура.xml") <> Неопределено).ЭтоИстина();
	Ожидаем.Что(Результат.ИзмененныеФайлы.Найти("Documents/Заказ.xml") <> Неопределено).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПотребоватьПолнуюЗагрузку_ПоМаркерам() Экспорт

	Ожидаем.Что(РазобратьТекст("FULLDUMP").ТребуетсяПолнаяЗагрузка, "fulldump").ЭтоИстина();
	Ожидаем.Что(РазобратьТекст("Modified: ALL").ТребуетсяПолнаяЗагрузка, "modified: all").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_СхлопнутьПовторыИОтброситьМусор() Экспорт

	Результат = РазобратьТекст(
		"modified: Catalog.Номенклатура
		|modified: catalog.номенклатура
		|added: Catalog.Новый
		|modified: БезТочки
		|
		|modified: Configuration.Каркас");

	Ожидаем.Что(Результат.ИзмененныеФайлы.Количество()).Равно(2);
	Ожидаем.Что(Результат.ИзмененныеФайлы.Найти("Configuration.xml") <> Неопределено).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ПустойРезультат

&Тест
Процедура ТестДолжен_ВернутьПустойРезультат() Экспорт

	Результат = Разбор.ПустойРезультат();

	Ожидаем.Что(Результат.ТребуетсяПолнаяЗагрузка).ЭтоЛожь();
	Ожидаем.Что(Результат.ИзмененныеФайлы.Количество()).Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ПричинаПропускаСравнения

&Тест
Процедура ТестДолжен_НазватьПричинуПропускаСравнения_ЕслиКешНедоступен() Экспорт

	Ожидаем.Что(Разбор.ПричинаПропускаСравнения(""), "кеш не задан").Содержит("не задан");

	НетФайла = ВременныеФайлы.НовоеИмяФайла("xml");
	Причина = Разбор.ПричинаПропускаСравнения(НетФайла);
	Ожидаем.Что(Причина, "кеш не найден").Содержит("не найден");
	Ожидаем.Что(Причина, "путь в причине").Содержит(НетФайла);

	ЕстьФайл = ТестовыеФайлы.ЗаписатьФайл(ВременныеФайлы.НовоеИмяФайла("xml"), "<some/>");
	Ожидаем.Что(Разбор.ПричинаПропускаСравнения(ЕстьФайл), "кеш доступен").Равно("");

КонецПроцедуры

#КонецОбласти

#Область РазобратьИУдалить

&Тест
Процедура ТестДолжен_РазобратьИУдалитьВременныйФайл() Экспорт

	Путь = ТестовыеФайлы.ЗаписатьФайл(ВременныеФайлы.НовоеИмяФайла("txt"), "modified: Catalog.Номенклатура");

	Результат = Разбор.РазобратьИУдалить(Путь);

	Ожидаем.Что(Результат.ИзмененныеФайлы.Количество()).Равно(1);
	Ожидаем.Что(ТестовыеФайлы.Существует(Путь), "временный файл удалён").ЭтоЛожь();

	// Отсутствие файла - не ошибка
	Результат = Разбор.РазобратьИУдалить(Путь);
	Ожидаем.Что(Результат.ИзмененныеФайлы.Количество()).Равно(0);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РазобратьТекст(Знач Содержимое)
	Возврат Разбор.Разобрать(ТестовыеФайлы.ЗаписатьФайл(ВременныеФайлы.НовоеИмяФайла("txt"), Содержимое));
КонецФункции

#КонецОбласти
