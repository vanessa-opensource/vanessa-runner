// BSLLS-off
// Юнит-тесты РазборИзмененийКонфигурации: общий для движков разбор файла изменений
// (вывода сравнения с кешем ConfigDumpInfo) в относительные пути XML-выгрузки.

#Использовать asserts
#Использовать tempfiles

#Использовать "../../../src/core/Движки"

Перем Разбор;
Перем НакопленныеВременныеФайлы;

#Область Тесты

&Тест
Процедура ТестДолжен_ВернутьПусто_ЕслиФайлаНет() Экспорт

	Результат = Разбор.Разобрать(ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "нет.txt"));

	Ожидаем.Что(Результат.ТребуетсяПолнаяЗагрузка).ЭтоЛожь();
	Ожидаем.Что(Результат.ИзмененныеФайлы.Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазобратьОбъекты_ВОтносительныеПути() Экспорт

	Результат = РазобратьТекст(
		"modified: Catalog.Номенклатура
		|modified: Document.Заказ");

	Ожидаем.Что(Результат.ИзмененныеФайлы.Количество()).Равно(2);
	Ожидаем.Что(Результат.ИзмененныеФайлы.Найти("Catalogs/Номенклатура.xml") <> Неопределено).ЭтоИстина();
	Ожидаем.Что(Результат.ИзмененныеФайлы.Найти("Documents/Заказ.xml") <> Неопределено).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПотребоватьПолнуюЗагрузку_ПоМаркерам() Экспорт

	Ожидаем.Что(РазобратьТекст("FULLDUMP").ТребуетсяПолнаяЗагрузка, "fulldump").ЭтоИстина();
	Ожидаем.Что(РазобратьТекст("Modified: ALL").ТребуетсяПолнаяЗагрузка, "modified: all").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_СхлопнутьПовторыИОтброситьМусор() Экспорт

	Результат = РазобратьТекст(
		"modified: Catalog.Номенклатура
		|modified: catalog.номенклатура
		|added: Catalog.Новый
		|modified: БезТочки
		|
		|modified: Configuration.Каркас");

	Ожидаем.Что(Результат.ИзмененныеФайлы.Количество()).Равно(2);
	Ожидаем.Что(Результат.ИзмененныеФайлы.Найти("Configuration.xml") <> Неопределено).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
	Разбор = Новый РазборИзмененийКонфигурации;
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РазобратьТекст(Знач Содержимое)
	Путь = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "changes.txt");
	Запись = Новый ЗаписьТекста(Путь, "UTF-8");
	Запись.Записать(Содержимое);
	Запись.Закрыть();
	Возврат Разбор.Разобрать(Путь);
КонецФункции

#КонецОбласти
