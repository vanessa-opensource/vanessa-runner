// BSLLS-off
// Юнит-тесты ПараметрыФайловойИБ: общий для движков ответ СоздатьФайловуюБазу/СоздатьВременнуюБазу.

#Использовать asserts

#Использовать "../../../src/core/Движки"

#Область Тесты

&Тест
Процедура ТестДолжен_СобратьПараметрыПодключенияКФайловойИБ() Экспорт

	Параметры = Новый ПараметрыФайловойИБ().Создать("C:\base");

	Ожидаем.Что(Параметры.СтрокаПодключения).Равно("/F""C:\base""");
	Ожидаем.Что(Параметры.КаталогБазы).Равно("C:\base");
	Ожидаем.Что(Параметры.Пользователь).Равно("");
	Ожидаем.Что(Параметры.Пароль).Равно("");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗакавычитьПутьВСтрокеПодключения() Экспорт

	Ожидаем.Что(Новый ПараметрыФайловойИБ().СтрокаПодключения("C:\каталог с пробелом"))
		.Равно("/F""C:\каталог с пробелом""");

КонецПроцедуры

#КонецОбласти
