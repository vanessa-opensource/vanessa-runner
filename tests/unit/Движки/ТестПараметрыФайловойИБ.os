// BSLLS-off
// Юнит-тесты ПараметрыФайловойИБ: общий для движков ответ СоздатьФайловуюБазу/СоздатьВременнуюБазу.
// Файловая система не затрагивается.

#Использовать asserts
#Использовать "../../../src/core/Движки"

#Область Создать

&Тест
Процедура ТестДолжен_СобратьПараметрыПодключенияКФайловойИБ() Экспорт

	Параметры = Новый ПараметрыФайловойИБ().Создать("base");

	Ожидаем.Что(Параметры.СтрокаПодключения).Равно("/F""base""");
	Ожидаем.Что(Параметры.КаталогБазы).Равно("base");
	Ожидаем.Что(Параметры.Пользователь).Равно("");
	Ожидаем.Что(Параметры.Пароль).Равно("");

КонецПроцедуры

#КонецОбласти

#Область СтрокаПодключения

&Тест
Процедура ТестДолжен_ЗакавычитьПутьВСтрокеПодключения() Экспорт

	Ожидаем.Что(Новый ПараметрыФайловойИБ().СтрокаПодключения("каталог с пробелом"))
		.Равно("/F""каталог с пробелом""");

КонецПроцедуры

#КонецОбласти
