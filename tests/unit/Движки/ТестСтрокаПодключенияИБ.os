// BSLLS-off
// Юнит-тесты СтрокаПодключенияИБ: файловая (/F) и серверная (/S) строка без учёта регистра, каталог файловой ИБ
// с кавычками и без, /F внутри пути, голый путь, серверная и пустая строка, пустой путь.

#Использовать asserts
#Использовать "../../../src/core/Движки"

#Область ЭтоФайловая_ЭтоСерверная

&Тест
Процедура ТестДолжен_ОпределитьФайловую_БезУчетаРегистра() Экспорт

	Ожидаем.Что(Новый СтрокаПодключенияИБ("/F""base""").ЭтоФайловая()).ЭтоИстина();
	Ожидаем.Что(Новый СтрокаПодключенияИБ("  /f""base""").ЭтоФайловая(), "регистр и пробелы").ЭтоИстина();
	Ожидаем.Что(Новый СтрокаПодключенияИБ("build/ib").ЭтоФайловая(), "голый путь - без префикса /F").ЭтоЛожь();
	Ожидаем.Что(Новый СтрокаПодключенияИБ("/S""srv\base""").ЭтоФайловая(), "серверная").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОпределитьСерверную_БезУчетаРегистра() Экспорт

	Ожидаем.Что(Новый СтрокаПодключенияИБ("/S""srv\base""").ЭтоСерверная()).ЭтоИстина();
	Ожидаем.Что(Новый СтрокаПодключенияИБ(" /s srv\base").ЭтоСерверная(), "регистр и пробелы").ЭтоИстина();
	Ожидаем.Что(Новый СтрокаПодключенияИБ("/F""base""").ЭтоСерверная(), "файловая").ЭтоЛожь();
	Ожидаем.Что(Новый СтрокаПодключенияИБ("").ЭтоСерверная(), "пустая").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область КаталогФайловойБазы

&Тест
Процедура ТестДолжен_ВернутьПолныйПутьКаталога_СКавычкамиИБез() Экспорт

	ПолныйПуть = Новый Файл("build/ib").ПолноеИмя;

	Ожидаем.Что(Новый СтрокаПодключенияИБ("/F""build/ib""").КаталогФайловойБазы(), "в кавычках").Равно(ПолныйПуть);
	Ожидаем.Что(Новый СтрокаПодключенияИБ("/Fbuild/ib").КаталогФайловойБазы(), "без кавычек").Равно(ПолныйПуть);
	Ожидаем.Что(Новый СтрокаПодключенияИБ("/f"" build/ib """).КаталогФайловойБазы(), "регистр и пробелы").Равно(ПолныйПуть);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьFВнутриПути() Экспорт

	Подключение = Новый СтрокаПодключенияИБ("/F""build/Foo/Fbar""");

	Ожидаем.Что(Подключение.КаталогФайловойБазы()).Равно(Новый Файл("build/Foo/Fbar").ПолноеИмя);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СчитатьГолыйПутьКаталогомФайловойБазы() Экспорт

	ПолныйПуть = Новый Файл("build/ib").ПолноеИмя;

	Ожидаем.Что(Новый СтрокаПодключенияИБ("build/ib").КаталогФайловойБазы()).Равно(ПолныйПуть);
	Ожидаем.Что(Новый СтрокаПодключенияИБ("""build/ib""").КаталогФайловойБазы(), "в кавычках").Равно(ПолныйПуть);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьПустойКаталог_ДляСервернойПустойСтрокиИПустогоПути() Экспорт

	Ожидаем.Что(Новый СтрокаПодключенияИБ("/S""srv\base""").КаталогФайловойБазы(), "серверная").Равно("");
	Ожидаем.Что(Новый СтрокаПодключенияИБ("").КаталогФайловойБазы(), "пустая строка").Равно("");
	Ожидаем.Что(Новый СтрокаПодключенияИБ("/F""""").КаталогФайловойБазы(), "пустой путь").Равно("");

КонецПроцедуры

#КонецОбласти
