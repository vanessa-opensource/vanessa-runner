&Тест
Процедура ТестДолжен_СравнитьРасширения_ВернутьПутьКОтчёту() Экспорт

	// Дано
	МокКонфигуратор = Мок.Получить(Новый ДвижокКонфигуратор);
	МокКонфигуратор.Когда().СоздатьВременнуюБазу(Любое)
		.ТогдаВозвращает(Подключения.Файловая(ВременныеФайлы.СоздатьКаталог()));
	МокКонфигуратор.Когда().СравнитьРасширения(Любое, Любое, Любое, Любое, Любое, Любое, Любое, Любое)
		.ТогдаВозвращает("C:\report.txt");

	Сервис = Новый БилдерСервисаРасширений().СОдинаковымДвижком(МокКонфигуратор).Собрать();

	// Когда
	Результат = Сервис.СравнитьРасширения(Неопределено, "МоёРасш", "C:\b.cfe", "C:\reports", "Brief", "txt");

	// Тогда: сервис сам формирует имя файла отчёта в переданном каталоге
	МокКонфигуратор.ПроверитьЧтоВызывалсяМетод().СравнитьРасширения(
		Любое, "МоёРасш", "C:\b.cfe", Любое, "Brief", "txt", Любое, Любое);
	Ожидаем.Что(Результат).Содержит("compare_report_brief_");
	Ожидаем.Что(Результат).Содержит(".txt");

КонецПроцедуры

