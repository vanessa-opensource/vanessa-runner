КонецПроцедуры

#КонецОбласти

#Область СобратьВФайлCfe

&Тест
Процедура ТестДолжен_СобратьCfe_ЗагрузкаПлюсВыгрузка_ЧерезКонфигуратор() Экспорт

	// Дано
	МокДвижок = Мок.Получить(Новый ДвижокКонфигуратор);
	МокДвижок.Когда().СоздатьВременнуюБазу(Любое)
		.ТогдаВозвращает(Подключения.Файловая(ВременныеФайлы.СоздатьКаталог()));

	Сервис = Новый БилдерСервисаРасширений().СОдинаковымДвижком(МокДвижок).Собрать();

	// Когда
	Сервис.СобратьВФайлCfe("C:\src", "C:\out.cfe", "МоёРасш");

	// Тогда
	МокДвижок.ПроверитьЧтоВызывалсяМетод().ЗагрузитьРасширениеИзФайлов(Любое, "C:\src", "МоёРасш", Любое, Любое);
	МокДвижок.ПроверитьЧтоВызывалсяМетод().ВыгрузитьРасширениеВФайл(Любое, "C:\out.cfe", "МоёРасш", Любое);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОчиститьВременнуюБазуПриОшибкеСборкиCfe() Экспорт

	// Дано
	КаталогВременной = ВременныеФайлы.СоздатьКаталог();
	МокДвижок = Мок.Получить(Новый ДвижокКонфигуратор);
	МокДвижок.Когда().СоздатьВременнуюБазу(Любое)
		.ТогдаВозвращает(Подключения.Файловая(КаталогВременной));
	МокДвижок.Когда().ЗагрузитьРасширениеИзФайлов(Любое, Любое, Любое, Любое, Любое)
		.ТогдаВыбрасываетИсключение("Ошибка загрузки расширения");

	Сервис = Новый БилдерСервисаРасширений().СОдинаковымДвижком(МокДвижок).Собрать();

	// Когда / Тогда
	Попытка
		Сервис.СобратьВФайлCfe("C:\src", "C:\out.cfe", "МоёРасш");
		ВызватьИсключение "Должно было упасть";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("Ошибка загрузки расширения");
	КонецПопытки;

	Ожидаем.Что(Новый Файл(КаталогВременной).Существует()).ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область РазобратьРасширениеВИсходники

&Тест
Процедура ТестДолжен_РазобратьCfe_ЗагрузкаПлюсВыгрузкаВФайлы() Экспорт

	// Дано
	МокДвижок = Мок.Получить(Новый ДвижокКонфигуратор);
	МокДвижок.Когда().СоздатьВременнуюБазу(Любое)
		.ТогдаВозвращает(Подключения.Файловая(ВременныеФайлы.СоздатьКаталог()));

	Сервис = Новый БилдерСервисаРасширений().СОдинаковымДвижком(МокДвижок).Собрать();

	// Когда
	Сервис.РазобратьРасширениеВИсходники("C:\in.cfe", "C:\out", "МоёРасш");

	// Тогда
	МокДвижок.ПроверитьЧтоВызывалсяМетод().ЗагрузитьРасширениеИзФайла(Любое, "C:\in.cfe", "МоёРасш", Любое);
	МокДвижок.ПроверитьЧтоВызывалсяМетод().ВыгрузитьРасширениеВФайлы(Любое, "C:\out", "МоёРасш", Любое);

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазобратьРасширениеИзБазы_БезЗагрузкиCfe() Экспорт

	// Дано - переданная база; загрузка из файла и временная база при вызове кидают исключение,
	// что доказывает их пропуск (moskito не умеет проверять отсутствие вызова напрямую).
	МокДвижок = Мок.Получить(Новый ДвижокКонфигуратор);
	ВнешниеПараметры = Подключения.Файловая("C:\external\base");
	МокДвижок.Когда().ЗагрузитьРасширениеИзФайла(Любое, Любое, Любое, Любое)
		.ТогдаВыбрасываетИсключение(Новый ИнформацияОбОшибке("Загрузка не должна вызываться", Новый Структура));
	МокДвижок.Когда().СоздатьВременнуюБазу(Любое)
		.ТогдаВыбрасываетИсключение(Новый ИнформацияОбОшибке("Временная база не должна создаваться", Новый Структура));

	Сервис = Новый БилдерСервисаРасширений().СОдинаковымДвижком(МокДвижок).Собрать();

	// Когда - cfe не задан, выгрузка из переданной базы
	Сервис.РазобратьРасширениеВИсходники("", "C:\out", "МоёРасш", Ложь, Неопределено, ВнешниеПараметры);

	// Тогда - выгрузка выполнена (а пропуск загрузки/создания базы гарантирован отсутствием исключения)
	МокДвижок.ПроверитьЧтоВызывалсяМетод().ВыгрузитьРасширениеВФайлы(Любое, "C:\out", "МоёРасш", Любое);

КонецПроцедуры

&Тест
Процедура ТестДолжен_БроситьИсключение_ЕслиНетCfeИНетБазы() Экспорт

	// Дано
	МокДвижок = Мок.Получить(Новый ДвижокКонфигуратор);
	Сервис = Новый БилдерСервисаРасширений().СОдинаковымДвижком(МокДвижок).Собрать();

	// Когда - ни cfe, ни базы (потребовалась бы пустая временная)
	БылоИсключение = Ложь;
	ТекстИсключения = "";
	Попытка
		Сервис.РазобратьРасширениеВИсходники("", "C:\out", "МоёРасш");
	Исключение
		БылоИсключение = Истина;
		ТекстИсключения = ОписаниеОшибки();
	КонецПопытки;

	// Тогда - сработала именно проверка параметров (до любых вызовов движка)
	Ожидаем.Что(БылоИсключение).ЭтоИстина();
	Ожидаем.Что(ТекстИсключения).Содержит("не передана информационная база");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОчиститьВременнуюБазуПриОшибкеРазборкиCfe() Экспорт

	// Дано
	КаталогВременной = ВременныеФайлы.СоздатьКаталог();
	МокДвижок = Мок.Получить(Новый ДвижокКонфигуратор);
	МокДвижок.Когда().СоздатьВременнуюБазу(Любое)
		.ТогдаВозвращает(Подключения.Файловая(КаталогВременной));
	МокДвижок.Когда().ВыгрузитьРасширениеВФайлы(Любое, Любое, Любое, Любое)
		.ТогдаВыбрасываетИсключение("Ошибка выгрузки");

	Сервис = Новый БилдерСервисаРасширений().СОдинаковымДвижком(МокДвижок).Собрать();

	// Когда / Тогда
	Попытка
		Сервис.РазобратьРасширениеВИсходники("C:\in.cfe", "C:\out", "МоёРасш");
		ВызватьИсключение "Должно было упасть";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("Ошибка выгрузки");
	КонецПопытки;

	Ожидаем.Что(Новый Файл(КаталогВременной).Существует()).ЭтоЛожь();

КонецПроцедуры

