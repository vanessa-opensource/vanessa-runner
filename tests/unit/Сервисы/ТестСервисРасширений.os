&Тест
Процедура ТестДолжен_СоздатьПустоеРасширение_ВыброситьОшибку_ЕслиУжеСуществуетБезOverwrite() Экспорт

	// Дано - список расширений содержит создаваемое имя
	МокДвижок = Мок.Получить(Новый ДвижокКонфигуратор);
	МокЗапуска = Мок.Получить(Новый СервисЗапускаОбработок);
	МокЗапуска.Когда().ВыполнитьОбработку(Любое, Любое, Любое, Любое)
		.ТогдаВозвращает(РезультатСоСписком("МоёРасш"));

	Сервис = Новый БилдерСервисаРасширений()
		.СОдинаковымДвижком(МокДвижок)
		.СЗапускомОбработок(МокЗапуска)
		.Собрать();

	// Когда / Тогда
	Попытка
		Сервис.СоздатьПустоеРасширение(Подключения.Файловая("C:\base"), "МоёРасш", Ложь);
		ВызватьИсключение "Должно было упасть";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("уже существует");
	КонецПопытки;

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьПустоеРасширение_ЗагрузитьИсходники_ЕслиНеСуществует() Экспорт

	// Дано - список расширений не содержит создаваемое имя
	МокДвижок = Мок.Получить(Новый ДвижокКонфигуратор);
	МокЗапуска = Мок.Получить(Новый СервисЗапускаОбработок);
	МокЗапуска.Когда().ВыполнитьОбработку(Любое, Любое, Любое, Любое)
		.ТогдаВозвращает(РезультатСоСписком("ДругоеРасш"));

	Сервис = Новый БилдерСервисаРасширений()
		.СОдинаковымДвижком(МокДвижок)
		.СЗапускомОбработок(МокЗапуска)
		.Собрать();

	// Когда
	Сервис.СоздатьПустоеРасширение(Подключения.Файловая("C:\base"), "МоёРасш", Ложь);

	// Тогда - расширение создаётся загрузкой исходников через конфигуратор
	МокДвижок.ПроверитьЧтоВызывалсяМетод().ЗагрузитьРасширениеИзФайлов(Любое, Любое, "МоёРасш", Любое, Любое);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Создаёт реальный пустой .cfe-файл с заданным именем во временном каталоге и возвращает путь.
Функция СоздатьВременныйФайлCfe(Знач ИмяБезРасширения)
	ПутьCfe = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), ИмяБезРасширения + ".cfe");
	Запись = Новый ЗаписьТекста(ПутьCfe);
	Запись.Закрыть();
	Возврат ПутьCfe;
КонецФункции

// Создаёт реальный каталог исходников расширения с заданным именем и возвращает путь.
Функция СоздатьВременныйКаталогРасширения(Знач ИмяКаталога)
	ПутьКаталога = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), ИмяКаталога);
	СоздатьКаталог(ПутьКаталога);
	Возврат ПутьКаталога;
КонецФункции

// Формирует результат СервисЗапускаОбработок с заданными именами расширений в сообщениях.
Функция РезультатСоСписком(Знач ИмяРасширения)
	Сообщения = Новый Массив;
	Сообщения.Добавить(ИмяРасширения);
	Возврат Новый Структура("КодВозврата, Сообщения, Ошибка, ФайлНайден", 0, Сообщения, "", Истина);
КонецФункции

Функция КорневойКаталогРепо()
	// tests/unit/Сервисы/<этот файл> -> ../../.. = корень репо
	Возврат Новый Файл(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "..", "..")).ПолноеИмя;
КонецФункции

#КонецОбласти
