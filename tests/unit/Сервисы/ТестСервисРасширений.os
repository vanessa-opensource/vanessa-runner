// BSLLS:NumberOfValuesInStructureConstructor-off
// BSLLS-off
// Юнит-тесты СервисРасширений.
// Реальные движки и СервисЗапускаОбработок замоканы.
// Покрытие: прямая загрузка (Конфигуратор / Ibcmd), оркестрация СобратьВФайлCfe / РазобратьРасширениеВИсходники,
// ИзменитьСвойстваРасширения через ibcmd, УстановитьПараметрыРасширенияЧерезОбработку,
// СравнитьРасширения через конфигуратор, инкрементальная загрузка.

#Использовать asserts
#Использовать moskito
#Использовать tempfiles

#Использовать "../../../src/core/Движки"
#Использовать "../../../src/core/Сервисы"
#Использовать "../../../src/core/Приложение"
#Использовать "../utils"

Перем Подключения;
Перем Любое;

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	Подключения = Новый ДанныеПодключений;
	Любое = Матчеры.ЛюбоеЗначение();
КонецПроцедуры

#Область ЗагрузитьРасширениеВБазуИзФайла

&Тест
Процедура ТестДолжен_ЗагрузитьИзФайла_ЧерезIbcmd() Экспорт

	// Дано
	МокIbcmd = Мок.Получить(Новый ДвижокIbcmd);
	МокКонфигуратор = Мок.Получить(Новый ДвижокКонфигуратор);
	Сервис = Новый БилдерСервисаРасширений()
		.СДвижкомКонфигуратор(МокКонфигуратор)
		.СДвижкомIbcmd(МокIbcmd)
		.Собрать();
	Параметры = Подключения.Файловая("C:\base");

	// Когда - ИспользоватьIbcmd=Истина
	Сервис.ЗагрузитьРасширениеВБазуИзФайла(Параметры, "C:\ext.cfe", "МоёРасш", Истина);

	// Тогда - прямая загрузка движком ibcmd
	МокIbcmd.ПроверитьЧтоВызывалсяМетод().ЗагрузитьРасширениеИзФайла(Любое, "C:\ext.cfe", "МоёРасш", Любое);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗагрузитьИзФайла_ЧерезКонфигуратор_ПоУмолчанию() Экспорт

	// Дано
	МокКонфигуратор = Мок.Получить(Новый ДвижокКонфигуратор);
	Сервис = Новый БилдерСервисаРасширений().СОдинаковымДвижком(МокКонфигуратор).Собрать();
	Параметры = Подключения.Файловая("C:\base");

	// Когда - режим по умолчанию: конфигуратор (ИспользоватьIbcmd=Ложь)
	Сервис.ЗагрузитьРасширениеВБазуИзФайла(Параметры, "C:\ext.cfe", "МоёРасш", Ложь);

	// Тогда - прямая загрузка конфигуратором, без обработки/временной базы
	МокКонфигуратор.ПроверитьЧтоВызывалсяМетод().ЗагрузитьРасширениеИзФайла(Любое, "C:\ext.cfe", "МоёРасш", Любое);

КонецПроцедуры

#КонецОбласти

#Область ЗагрузитьРасширениеВБазуИзФайлов

&Тест
Процедура ТестДолжен_ЗагрузитьИзФайлов_ЧерезIbcmd_БезИнкремента() Экспорт

	// Дано
	МокIbcmd = Мок.Получить(Новый ДвижокКонфигуратор);
	Сервис = Новый БилдерСервисаРасширений().СОдинаковымДвижком(МокIbcmd).Собрать();
	Параметры = Подключения.Файловая("C:\base");

	// Когда
	Сервис.ЗагрузитьРасширениеВБазуИзФайлов(Параметры, "C:\src", "МоёРасш", Истина);

	// Тогда
	МокIbcmd.ПроверитьЧтоВызывалсяМетод().ЗагрузитьРасширениеИзФайлов(Любое, "C:\src", "МоёРасш", Любое, Любое);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПропуститьЗагрузкуРасширения_ЕслиИнкрементПусто() Экспорт

	// Дано
	МокIbcmd = Мок.Получить(Новый ДвижокКонфигуратор);
	МокИнкремент = Мок.Получить(Тип("СервисРасчетаИнкремента"));
	РезультатИнкремента = Новый Структура("ПропуститьЗагрузку, СписокФайловДляЗагрузки, КонтекстИнкремента",
		Истина, "", Новый Структура);
	МокИнкремент.Когда().РассчитатьИнкрементДляЗагрузкиРасширения(Любое, Любое, Любое, Любое, Любое)
		.ТогдаВозвращает(РезультатИнкремента);

	Сервис = Новый БилдерСервисаРасширений()
		.СОдинаковымДвижком(МокIbcmd)
		.СРасчетомИнкремента(МокИнкремент)
		.Собрать();
	Параметры = Подключения.Файловая("C:\base");

	// Когда
	Сервис.ЗагрузитьРасширениеВБазуИзФайлов(Параметры, "C:\src", "МоёРасш", Истина, Неопределено, Истина);

	// Тогда - расчёт инкремента вызван, но загрузка не вызвана (косвенно проверится через отсутствие
	// настройки ТогдаВозвращает на ЗагрузитьРасширениеИзФайлов - мок просто молча вернёт)
	МокИнкремент.ПроверитьЧтоВызывалсяМетод().РассчитатьИнкрементДляЗагрузкиРасширения(Любое, Любое, "МоёРасш", Любое, Любое);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗафиксироватьИнкрементРасширенияПослеЗагрузки() Экспорт

	// Дано
	МокIbcmd = Мок.Получить(Новый ДвижокКонфигуратор);
	МокИнкремент = Мок.Получить(Тип("СервисРасчетаИнкремента"));
	КонтекстИнкр = Новый Структура("Идентификатор", "abc");
	РезультатИнкремента = Новый Структура("ПропуститьЗагрузку, СписокФайловДляЗагрузки, КонтекстИнкремента",
		Ложь, "file1.xml", КонтекстИнкр);
	МокИнкремент.Когда().РассчитатьИнкрементДляЗагрузкиРасширения(Любое, Любое, Любое, Любое, Любое)
		.ТогдаВозвращает(РезультатИнкремента);

	Сервис = Новый БилдерСервисаРасширений()
		.СОдинаковымДвижком(МокIbcmd)
		.СРасчетомИнкремента(МокИнкремент)
		.Собрать();
	Параметры = Подключения.Файловая("C:\base");

	// Когда
	Сервис.ЗагрузитьРасширениеВБазуИзФайлов(Параметры, "C:\src", "МоёРасш", Истина, Неопределено, Истина);

	// Тогда - загрузка + фиксация инкремента
	МокIbcmd.ПроверитьЧтоВызывалсяМетод().ЗагрузитьРасширениеИзФайлов(Любое, "C:\src", "МоёРасш", Любое, "file1.xml");
	МокИнкремент.ПроверитьЧтоВызывалсяМетод().ЗафиксироватьИнкремент(Любое);

КонецПроцедуры

#КонецОбласти

#Область ЗагрузитьРасширениеВБазу

&Тест
Процедура ТестДолжен_ЗагрузитьИзИсточника_РаспознатьCfeФайл_ИОпределитьИмяИзПути() Экспорт

	// Дано - реальный .cfe-файл во временном каталоге
	МокДвижок = Мок.Получить(Новый ДвижокКонфигуратор);
	Сервис = Новый БилдерСервисаРасширений().СОдинаковымДвижком(МокДвижок).Собрать();
	Параметры = Подключения.Файловая("C:\base");
	ПутьCfe = СоздатьВременныйФайлCfe("ЗаказТовара");

	// Когда - имя не задано
	ИтоговоеИмя = Сервис.ЗагрузитьРасширениеВБазу(Параметры, ПутьCfe);

	// Тогда - прямая загрузка из файла, имя определено из имени файла
	Ожидаем.Что(ИтоговоеИмя).Равно("ЗаказТовара");
	МокДвижок.ПроверитьЧтоВызывалсяМетод().ЗагрузитьРасширениеИзФайла(Любое, ПутьCfe, "ЗаказТовара", Любое);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗагрузитьИзИсточника_РаспознатьКаталогИсходников_ИОпределитьИмяИзПути() Экспорт

	// Дано - реальный каталог исходников расширения
	МокДвижок = Мок.Получить(Новый ДвижокКонфигуратор);
	Сервис = Новый БилдерСервисаРасширений().СОдинаковымДвижком(МокДвижок).Собрать();
	Параметры = Подключения.Файловая("C:\base");
	ПутьКаталога = СоздатьВременныйКаталогРасширения("Управление");

	// Когда - имя не задано
	ИтоговоеИмя = Сервис.ЗагрузитьРасширениеВБазу(Параметры, ПутьКаталога);

	// Тогда - загрузка из исходников, имя определено из имени каталога
	Ожидаем.Что(ИтоговоеИмя).Равно("Управление");
	МокДвижок.ПроверитьЧтоВызывалсяМетод().ЗагрузитьРасширениеИзФайлов(Любое, ПутьКаталога, "Управление", Любое, Любое);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗагрузитьИзИсточника_ИспользоватьЗаданноеИмя() Экспорт

	// Дано
	МокДвижок = Мок.Получить(Новый ДвижокКонфигуратор);
	Сервис = Новый БилдерСервисаРасширений().СОдинаковымДвижком(МокДвижок).Собрать();
	Параметры = Подключения.Файловая("C:\base");
	ПутьCfe = СоздатьВременныйФайлCfe("ИмяФайла");

	// Когда - имя задано явно
	ИтоговоеИмя = Сервис.ЗагрузитьРасширениеВБазу(Параметры, ПутьCfe, "ЯвноеИмя");

	// Тогда - используется заданное имя, а не из пути
	Ожидаем.Что(ИтоговоеИмя).Равно("ЯвноеИмя");
	МокДвижок.ПроверитьЧтоВызывалсяМетод().ЗагрузитьРасширениеИзФайла(Любое, ПутьCfe, "ЯвноеИмя", Любое);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗагрузитьИзИсточника_БроситьОшибку_ЕслиФайлCfeНеНайден() Экспорт

	// Дано
	МокДвижок = Мок.Получить(Новый ДвижокКонфигуратор);
	Сервис = Новый БилдерСервисаРасширений().СОдинаковымДвижком(МокДвижок).Собрать();
	Параметры = Подключения.Файловая("C:\base");

	// Когда / Тогда
	БылоИсключение = Ложь;
	ТекстИсключения = "";
	Попытка
		Сервис.ЗагрузитьРасширениеВБазу(Параметры, "C:\нет\МоёРасш.cfe");
	Исключение
		БылоИсключение = Истина;
		ТекстИсключения = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(БылоИсключение).ЭтоИстина();
	Ожидаем.Что(ТекстИсключения).Содержит("Файл расширения не найден");

