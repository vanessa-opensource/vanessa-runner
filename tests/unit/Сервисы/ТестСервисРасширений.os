КонецПроцедуры

#КонецОбласти

#Область СобратьВФайлCfe

&Тест
Процедура ТестДолжен_СобратьCfe_ЗагрузкаПлюсВыгрузка_ЧерезКонфигуратор() Экспорт

	// Дано
	МокДвижок = Мок.Получить(Новый ДвижокКонфигуратор);
	МокДвижок.Когда().СоздатьВременнуюБазу(Любое)
		.ТогдаВозвращает(Подключения.Файловая(ВременныеФайлы.СоздатьКаталог()));

	Сервис = Новый БилдерСервисаРасширений().СОдинаковымДвижком(МокДвижок).Собрать();

	// Когда
	Сервис.СобратьВФайлCfe("C:\src", "C:\out.cfe", "МоёРасш");

	// Тогда
	МокДвижок.ПроверитьЧтоВызывалсяМетод().ЗагрузитьРасширениеИзФайлов(Любое, "C:\src", "МоёРасш", Любое, Любое);
	МокДвижок.ПроверитьЧтоВызывалсяМетод().ВыгрузитьРасширениеВФайл(Любое, "C:\out.cfe", "МоёРасш", Любое);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОчиститьВременнуюБазуПриОшибкеСборкиCfe() Экспорт

	// Дано
	КаталогВременной = ВременныеФайлы.СоздатьКаталог();
	МокДвижок = Мок.Получить(Новый ДвижокКонфигуратор);
	МокДвижок.Когда().СоздатьВременнуюБазу(Любое)
		.ТогдаВозвращает(Подключения.Файловая(КаталогВременной));
	МокДвижок.Когда().ЗагрузитьРасширениеИзФайлов(Любое, Любое, Любое, Любое, Любое)
		.ТогдаВыбрасываетИсключение("Ошибка загрузки расширения");

	Сервис = Новый БилдерСервисаРасширений().СОдинаковымДвижком(МокДвижок).Собрать();

	// Когда / Тогда
	Попытка
		Сервис.СобратьВФайлCfe("C:\src", "C:\out.cfe", "МоёРасш");
		ВызватьИсключение "Должно было упасть";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("Ошибка загрузки расширения");
	КонецПопытки;

	Ожидаем.Что(Новый Файл(КаталогВременной).Существует()).ЭтоЛожь();

КонецПроцедуры

