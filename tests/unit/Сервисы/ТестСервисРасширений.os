// BSLLS-off
// Юнит-тесты СервисРасширений: маршрутизация к движку, оркестрация временной базы,
// инкрементальная загрузка, свойства расширения через ibcmd/обработку, сравнение, создание пустого.
// Движки, СервисEDT, СервисРасчетаИнкремента, СервисЗапускаОбработок и СервисКонфигурации замоканы.

#Использовать asserts
#Использовать moskito
#Использовать tempfiles
#Использовать "../utils"

Перем Стенд;
Перем Сервис;
Перем База;
Перем Любое;

&ПередКаждым
Процедура ПередКаждым() Экспорт
	Стенд = Новый Стенд;
	Стенд.Реальный("СервисВременнойБазы");    // выбор движка и жизненный цикл временной ИБ настоящие, движки - моки
	Стенд.Реальный("СервисПоискаИсточников"); // вид источника определяется по маркерам на диске
	Сервис = Стенд.Сервис("СервисРасширений");
	База = ТестовыеДанные.Файловая("base");
	Любое = Матчеры.ЛюбоеЗначение();
КонецПроцедуры

#Область ЗагрузитьРасширениеВБазуИзФайла

&Тест
Процедура ТестДолжен_ЗагрузитьИзФайлаЧерезIbcmd_ЕслиИспользоватьIbcmd() Экспорт

	// Когда
	Сервис.ЗагрузитьРасширениеВБазуИзФайла(База, "ext.cfe", "МоёРасш", Истина);

	// Тогда - прямая загрузка движком ibcmd
	Стенд.Мок("ДвижокIbcmd").ПроверитьЧтоВызывалсяМетод().ЗагрузитьРасширениеИзФайла(База, "ext.cfe", "МоёРасш", Любое);
	Стенд.ПроверитьЧтоНеВызывался("ДвижокКонфигуратор", "ЗагрузитьРасширениеИзФайла");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗагрузитьИзФайлаЧерезКонфигуратор_ПоУмолчанию() Экспорт

	// Когда
	Сервис.ЗагрузитьРасширениеВБазуИзФайла(База, "ext.cfe", "МоёРасш", Ложь);

	// Тогда - прямая загрузка конфигуратором, без обработки и временной базы
	Стенд.Мок("ДвижокКонфигуратор").ПроверитьЧтоВызывалсяМетод().ЗагрузитьРасширениеИзФайла(База, "ext.cfe", "МоёРасш", Любое);
	Стенд.ПроверитьЧтоНеВызывался("ДвижокIbcmd", "ЗагрузитьРасширениеИзФайла");

КонецПроцедуры

#КонецОбласти

#Область ЗагрузитьРасширениеВБазуИзФайлов

&Тест
Процедура ТестДолжен_ЗагрузитьИзФайловБезСпискаИзменений_ЕслиИнкрементВыключен() Экспорт

	// Когда
	Сервис.ЗагрузитьРасширениеВБазуИзФайлов(База, "src", "МоёРасш", Истина);

	// Тогда - список файлов пустой, расчёт инкремента не вызывался
	Стенд.Мок("ДвижокIbcmd").ПроверитьЧтоВызывалсяМетод().ЗагрузитьРасширениеИзФайлов(База, "src", "МоёРасш", Любое, "");
	Стенд.ПроверитьЧтоНеВызывался("СервисРасчетаИнкремента", "РассчитатьИнкрементДляЗагрузкиРасширения");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПропуститьЗагрузку_ЕслиИнкрементПуст() Экспорт

	// Дано
	Стенд.Мок("СервисРасчетаИнкремента").Когда()
		.РассчитатьИнкрементДляЗагрузкиРасширения(Любое, Любое, Любое, Любое, Любое)
		.ТогдаВозвращает(ТестовыеДанные.РезультатИнкремента("", Истина));

	// Когда - ИнкрементальнаяЗагрузка = Истина
	Сервис.ЗагрузитьРасширениеВБазуИзФайлов(База, "src", "МоёРасш", Истина, Неопределено, Истина);

	// Тогда - инкремент рассчитан, загрузки и фиксации нет
	Стенд.Мок("СервисРасчетаИнкремента").ПроверитьЧтоВызывалсяМетод()
		.РассчитатьИнкрементДляЗагрузкиРасширения("src", База, "МоёРасш", Истина, Любое);
	Стенд.ПроверитьЧтоНеВызывался("ДвижокIbcmd", "ЗагрузитьРасширениеИзФайлов");
	Стенд.ПроверитьЧтоНеВызывался("СервисРасчетаИнкремента", "ЗафиксироватьИнкремент");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗафиксироватьИнкремент_ПослеЗагрузкиРасширенияИзФайлов() Экспорт

	// Дано
	Инкремент = ТестовыеДанные.РезультатИнкремента("file1.xml");
	Стенд.Мок("СервисРасчетаИнкремента").Когда()
		.РассчитатьИнкрементДляЗагрузкиРасширения(Любое, Любое, Любое, Любое, Любое).ТогдаВозвращает(Инкремент);

	// Когда
	Сервис.ЗагрузитьРасширениеВБазуИзФайлов(База, "src", "МоёРасш", Истина, Неопределено, Истина);

	// Тогда - выборочная загрузка через ibcmd и фиксация инкремента
	Стенд.Мок("ДвижокIbcmd").ПроверитьЧтоВызывалсяМетод()
		.ЗагрузитьРасширениеИзФайлов(База, "src", "МоёРасш", Любое, "file1.xml");
	Стенд.Мок("СервисРасчетаИнкремента").ПроверитьЧтоВызывалсяМетод().ЗафиксироватьИнкремент(Инкремент.КонтекстИнкремента);

КонецПроцедуры

&Тест
Процедура ТестДолжен_РассчитатьИнкрементПоКаталогуEDT_ЕслиИсходникиEDT() Экспорт

	// Дано - EDT-проект экспортирован во временный XML; инкремент считается по каталогу EDT-проекта
	Стенд.Мок("СервисEDT").Когда().ПодготовитьXML(Любое, Любое)
		.ТогдаВозвращает(ТестовыеДанные.КонтекстXML("xml-tmp", "edt", Истина));
	Инкремент = ТестовыеДанные.РезультатИнкремента("list.txt");
	Стенд.Мок("СервисРасчетаИнкремента").Когда()
		.РассчитатьИнкрементEDTДляЗагрузкиРасширения(Любое, Любое, Любое, Любое).ТогдаВозвращает(Инкремент);

	// Когда
	Сервис.ЗагрузитьРасширениеВБазуИзФайлов(База, "edt", "МоёРасш", Ложь, Неопределено, Истина,
		ТестовыеДанные.ПараметрыИсходников("edt"));

	// Тогда - EDT-инкремент по каталогу EDT и XML-дампу, выборочная загрузка из XML, фиксация, очистка XML
	Стенд.Мок("СервисРасчетаИнкремента").ПроверитьЧтоВызывалсяМетод()
		.РассчитатьИнкрементEDTДляЗагрузкиРасширения("edt", "xml-tmp", База, "МоёРасш");
	Стенд.ПроверитьЧтоНеВызывался("СервисРасчетаИнкремента", "РассчитатьИнкрементДляЗагрузкиРасширения");
	Стенд.Мок("ДвижокКонфигуратор").ПроверитьЧтоВызывалсяМетод()
		.ЗагрузитьРасширениеИзФайлов(База, "xml-tmp", "МоёРасш", Любое, "list.txt");
	Стенд.Мок("СервисРасчетаИнкремента").ПроверитьЧтоВызывалсяМетод().ЗафиксироватьИнкремент(Инкремент.КонтекстИнкремента);
	Стенд.Мок("СервисEDT").ПроверитьЧтоВызывалсяМетод().ЗавершитьXML(Любое);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПропуститьЗагрузкуИзEDT_ЕслиИзмененийНет() Экспорт

	// Дано
	Стенд.Мок("СервисEDT").Когда().ПодготовитьXML(Любое, Любое)
		.ТогдаВозвращает(ТестовыеДанные.КонтекстXML("xml-tmp", "edt", Истина));
	Стенд.Мок("СервисРасчетаИнкремента").Когда()
		.РассчитатьИнкрементEDTДляЗагрузкиРасширения(Любое, Любое, Любое, Любое)
		.ТогдаВозвращает(ТестовыеДанные.РезультатИнкремента("", Истина));

	// Когда
	Сервис.ЗагрузитьРасширениеВБазуИзФайлов(База, "edt", "МоёРасш", Ложь, Неопределено, Истина,
		ТестовыеДанные.ПараметрыИсходников("edt"));

	// Тогда - расчёт выполнен, загрузки нет, временный XML убран
	Стенд.Мок("СервисРасчетаИнкремента").ПроверитьЧтоВызывалсяМетод()
		.РассчитатьИнкрементEDTДляЗагрузкиРасширения(Любое, Любое, Любое, "МоёРасш");
	Стенд.ПроверитьЧтоНеВызывался("ДвижокКонфигуратор", "ЗагрузитьРасширениеИзФайлов");
	Стенд.Мок("СервисEDT").ПроверитьЧтоВызывалсяМетод().ЗавершитьXML(Любое);

КонецПроцедуры

#КонецОбласти

#Область ЗагрузитьРасширениеВБазу

&Тест
Процедура ТестДолжен_ЗагрузитьИзФайлаСИменемИзПути_ЕслиИсточникCfe() Экспорт

	// Дано - реальный .cfe-файл во временном каталоге
	ПутьCfe = ТестовыеФайлы.ФайлCfe("ЗаказТовара");

	// Когда - имя не задано
	ИтоговоеИмя = Сервис.ЗагрузитьРасширениеВБазу(База, ПутьCfe);

	// Тогда - прямая загрузка из файла, имя из имени файла
	Ожидаем.Что(ИтоговоеИмя).Равно("ЗаказТовара");
	Стенд.Мок("ДвижокКонфигуратор").ПроверитьЧтоВызывалсяМетод().ЗагрузитьРасширениеИзФайла(База, ПутьCfe, "ЗаказТовара", Любое);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗагрузитьИзФайловСИменемИзПути_ЕслиИсточникКаталогИсходников() Экспорт

	// Дано - реальный каталог XML-исходников расширения
	ПутьКаталога = ТестовыеФайлы.КаталогXML("Управление");

	// Когда - имя не задано
	ИтоговоеИмя = Сервис.ЗагрузитьРасширениеВБазу(База, ПутьКаталога);

	// Тогда - загрузка из исходников, имя из имени каталога
	Ожидаем.Что(ИтоговоеИмя).Равно("Управление");
	Стенд.Мок("ДвижокКонфигуратор").ПроверитьЧтоВызывалсяМетод()
		.ЗагрузитьРасширениеИзФайлов(База, ПутьКаталога, "Управление", Любое, Любое);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИспользоватьЗаданноеИмя_ВместоИмениИзПути() Экспорт

	// Дано
	ПутьCfe = ТестовыеФайлы.ФайлCfe("ИмяФайла");

	// Когда
	ИтоговоеИмя = Сервис.ЗагрузитьРасширениеВБазу(База, ПутьCfe, "ЯвноеИмя");

	// Тогда
	Ожидаем.Что(ИтоговоеИмя).Равно("ЯвноеИмя");
	Стенд.Мок("ДвижокКонфигуратор").ПроверитьЧтоВызывалсяМетод().ЗагрузитьРасширениеИзФайла(База, ПутьCfe, "ЯвноеИмя", Любое);

КонецПроцедуры

&Тест
Процедура ТестДолжен_БроситьИсключение_ЕслиФайлCfeНеНайден() Экспорт

	Ожидаем.Что(Сервис).Метод("ЗагрузитьРасширениеВБазу", ТестовыеДанные.Массив(База, "нет/МоёРасш.cfe"))
		.ВыбрасываетИсключение("Файл расширения не найден");

КонецПроцедуры

&Тест
Процедура ТестДолжен_БроситьИсключение_ЕслиКаталогИсходниковНеНайден() Экспорт

	Ожидаем.Что(Сервис).Метод("ЗагрузитьРасширениеВБазу", ТестовыеДанные.Массив(База, "нет/КаталогРасш"))
		.ВыбрасываетИсключение("Каталог исходников расширения не найден");

КонецПроцедуры

&Тест
Процедура ТестДолжен_БроситьИсключение_ЕслиКаталогБезМаркеров() Экспорт

	// Дано - существующий каталог без Configuration.xml и .project
	Ожидаем.Что(Сервис).Метод("ЗагрузитьРасширениеВБазу", ТестовыеДанные.Массив(База, ВременныеФайлы.СоздатьКаталог()))
		.ВыбрасываетИсключение("не распознан");

КонецПроцедуры

#КонецОбласти

#Область ВыгрузитьРасширениеВФайл

&Тест
Процедура ТестДолжен_ДелегироватьВыгрузкуВДвижок() Экспорт

	// Когда
	Сервис.ВыгрузитьРасширениеВФайл(База, "out.cfe", "МоёРасш");

	// Тогда
	Стенд.Мок("ДвижокКонфигуратор").ПроверитьЧтоВызывалсяМетод().ВыгрузитьРасширениеВФайл(База, "out.cfe", "МоёРасш", Любое);

КонецПроцедуры

#КонецОбласти

#Область СобратьВФайлCfe

&Тест
Процедура ТестДолжен_ЗагрузитьИВыгрузитьВоВременнойБазе_ПриСборкеCfe() Экспорт

	// Когда
	Сервис.СобратьВФайлCfe("src", "out.cfe", "МоёРасш");

	// Тогда - временная база создана, загрузка исходников и выгрузка .cfe в ней
	Движок = Стенд.Мок("ДвижокКонфигуратор");
	Движок.ПроверитьЧтоВызывалсяМетод().СоздатьВременнуюБазу(Любое);
	Движок.ПроверитьЧтоВызывалсяМетод().ЗагрузитьРасширениеИзФайлов(Любое, "src", "МоёРасш", Любое, Любое);
	Движок.ПроверитьЧтоВызывалсяМетод().ВыгрузитьРасширениеВФайл(Любое, "out.cfe", "МоёРасш", Любое);

КонецПроцедуры

&Тест
Процедура ТестДолжен_УдалитьВременнуюБазу_ПриОшибкеСборкиCfe() Экспорт

	// Дано
	КаталогВременной = ВременныеФайлы.СоздатьКаталог();
	Движок = Стенд.Мок("ДвижокКонфигуратор");
	Движок.Когда().СоздатьВременнуюБазу(Любое).ТогдаВозвращает(ТестовыеДанные.Файловая(КаталогВременной));
	Движок.Когда().ЗагрузитьРасширениеИзФайлов(Любое, Любое, Любое, Любое, Любое)
		.ТогдаВыбрасываетИсключение("Ошибка загрузки расширения");

	// Когда / Тогда
	Ожидаем.Что(Сервис).Метод("СобратьВФайлCfe", ТестовыеДанные.Массив("src", "out.cfe", "МоёРасш"))
		.ВыбрасываетИсключение("Ошибка загрузки расширения");
	Ожидаем.Что(ТестовыеФайлы.Существует(КаталогВременной), "временная база удалена").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область РазобратьРасширениеВИсходники

&Тест
Процедура ТестДолжен_ЗагрузитьИВыгрузитьВоВременнойБазе_ПриРазборкеCfe() Экспорт

	// Когда
	Сервис.РазобратьРасширениеВИсходники("in.cfe", "out", "МоёРасш");

	// Тогда
	Движок = Стенд.Мок("ДвижокКонфигуратор");
	Движок.ПроверитьЧтоВызывалсяМетод().СоздатьВременнуюБазу(Любое);
	Движок.ПроверитьЧтоВызывалсяМетод().ЗагрузитьРасширениеИзФайла(Любое, "in.cfe", "МоёРасш", Любое);
	Движок.ПроверитьЧтоВызывалсяМетод().ВыгрузитьРасширениеВФайлы(Любое, "out", "МоёРасш", Любое);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыгрузитьИзПереданнойБазы_ЕслиCfeНеЗадан() Экспорт

	// Дано
	ВнешняяБаза = ТестовыеДанные.Файловая("external/base");

	// Когда - cfe не задан, выгрузка из переданной базы
	Сервис.РазобратьРасширениеВИсходники("", "out", "МоёРасш", Ложь, Неопределено, ВнешняяБаза);

	// Тогда - без загрузки из файла и без временной базы
	Стенд.Мок("ДвижокКонфигуратор").ПроверитьЧтоВызывалсяМетод().ВыгрузитьРасширениеВФайлы(ВнешняяБаза, "out", "МоёРасш", Любое);
	Стенд.ПроверитьЧтоНеВызывался("ДвижокКонфигуратор", "ЗагрузитьРасширениеИзФайла");
	Стенд.ПроверитьЧтоНеВызывался("ДвижокКонфигуратор", "СоздатьВременнуюБазу");

КонецПроцедуры

&Тест
Процедура ТестДолжен_БроситьИсключение_ЕслиНетНиCfeНиБазы() Экспорт

	// Проверка параметров срабатывает до любых вызовов движка
	Ожидаем.Что(Сервис).Метод("РазобратьРасширениеВИсходники", ТестовыеДанные.Массив("", "out", "МоёРасш"))
		.ВыбрасываетИсключение("не передана информационная база");
	Стенд.ПроверитьЧтоНеВызывался("ДвижокКонфигуратор", "СоздатьВременнуюБазу");

КонецПроцедуры

&Тест
Процедура ТестДолжен_УдалитьВременнуюБазу_ПриОшибкеРазборкиCfe() Экспорт

	// Дано
	КаталогВременной = ВременныеФайлы.СоздатьКаталог();
	Движок = Стенд.Мок("ДвижокКонфигуратор");
	Движок.Когда().СоздатьВременнуюБазу(Любое).ТогдаВозвращает(ТестовыеДанные.Файловая(КаталогВременной));
	Движок.Когда().ВыгрузитьРасширениеВФайлы(Любое, Любое, Любое, Любое).ТогдаВыбрасываетИсключение("Ошибка выгрузки");

	// Когда / Тогда
	Ожидаем.Что(Сервис).Метод("РазобратьРасширениеВИсходники", ТестовыеДанные.Массив("in.cfe", "out", "МоёРасш"))
		.ВыбрасываетИсключение("Ошибка выгрузки");
	Ожидаем.Что(ТестовыеФайлы.Существует(КаталогВременной), "временная база удалена").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область ИзменитьСвойстваРасширения

&Тест
Процедура ТестДолжен_ИзменитьСвойстваЧерезIbcmd_Всегда() Экспорт

	// Дано
	Свойства = Новый Структура("Активность", Истина);

	// Когда
	Сервис.ИзменитьСвойстваРасширения(База, "МоёРасш", Свойства);

	// Тогда
	Стенд.Мок("ДвижокIbcmd").ПроверитьЧтоВызывалсяМетод().ИзменитьСвойстваРасширения(База, "МоёРасш", Свойства, Любое);

КонецПроцедуры

#КонецОбласти

#Область УстановитьПараметрыРасширенияЧерезОбработку

&Тест
Процедура ТестДолжен_УстановитьСвойстваЧерезОбработкуРаботаСРасширениями() Экспорт

	// Когда
	Сервис.УстановитьПараметрыРасширенияЧерезОбработку(База, "МоёРасш", Новый Структура("БезопасныйРежим", Истина));

	// Тогда - режим set-options: только установка параметров, имя и переданные флаги
	Стенд.Мок("СервисЗапускаОбработок").ПроверитьЧтоВызывалсяМетод()
		.ВыполнитьОбработку("РаботаСРасширениями", База, Любое, Любое, Любое);
	Параметры = Стенд.Вызовы("СервисЗапускаОбработок", "ВыполнитьОбработку")[0].Параметры;
	Ожидаем.Что(Параметры.ТолькоУстановитьПараметрыРасширения).ЭтоИстина();
	Ожидаем.Что(Параметры.Имя).Равно("МоёРасш");
	Ожидаем.Что(Параметры.БезопасныйРежим).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область СравнитьРасширения

&Тест
Процедура ТестДолжен_ВернутьПутьКОтчету_ПриСравненииРасширений() Экспорт

	// Дано - имя файла отчёта формирует СервисКонфигурации
	Стенд.Мок("СервисКонфигурации").Когда().ПутьКОтчетуСравнения("reports", "Brief", "txt")
		.ТогдаВозвращает("reports/compare_report_brief.txt");

	// Когда - база не передана: сравнение во временной базе
	Результат = Сервис.СравнитьРасширения(Неопределено, "МоёРасш", "b.cfe", "reports", "Brief", "txt");

	// Тогда
	Ожидаем.Что(Результат).Равно("reports/compare_report_brief.txt");
	Стенд.Мок("ДвижокКонфигуратор").ПроверитьЧтоВызывалсяМетод().СравнитьРасширения(
		Любое, "МоёРасш", "b.cfe", "reports/compare_report_brief.txt", "Brief", "txt", Любое, Любое);

КонецПроцедуры

&Тест
Процедура ТестДолжен_УдалитьВременнуюБазу_ПриОшибкеСравненияРасширений() Экспорт

	// Дано
	КаталогВременной = ВременныеФайлы.СоздатьКаталог();
	Движок = Стенд.Мок("ДвижокКонфигуратор");
	Движок.Когда().СоздатьВременнуюБазу(Любое).ТогдаВозвращает(ТестовыеДанные.Файловая(КаталогВременной));
	Движок.Когда().СравнитьРасширения(Любое, Любое, Любое, Любое, Любое, Любое, Любое, Любое)
		.ТогдаВыбрасываетИсключение("Сравнение упало");

	// Когда / Тогда
	Ожидаем.Что(Сервис).Метод("СравнитьРасширения",
		ТестовыеДанные.Массив(Неопределено, "МоёРасш", "b.cfe", "reports", "Brief", "txt"))
		.ВыбрасываетИсключение("Сравнение упало");
	Ожидаем.Что(ТестовыеФайлы.Существует(КаталогВременной), "временная база удалена").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область СоздатьПустоеРасширение

&Тест
Процедура ТестДолжен_БроситьИсключение_ЕслиРасширениеУжеЕстьБезOverwrite() Экспорт

	// Дано - список расширений содержит создаваемое имя
	Стенд.Мок("СервисЗапускаОбработок").Когда().ВыполнитьОбработку(Любое, Любое, Любое, Любое, Любое)
		.ТогдаВозвращает(ТестовыеДанные.РезультатОбработки(ТестовыеДанные.Массив("МоёРасш")));

	// Когда / Тогда
	Ожидаем.Что(Сервис).Метод("СоздатьПустоеРасширение", ТестовыеДанные.Массив(База, "МоёРасш", Ложь))
		.ВыбрасываетИсключение("уже существует");
	Стенд.ПроверитьЧтоНеВызывался("ДвижокКонфигуратор", "ЗагрузитьРасширениеИзФайлов");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗагрузитьИсходникиПустогоРасширения_ЕслиРасширенияНет() Экспорт

	// Дано - список расширений не содержит создаваемое имя
	Стенд.Мок("СервисЗапускаОбработок").Когда().ВыполнитьОбработку(Любое, Любое, Любое, Любое, Любое)
		.ТогдаВозвращает(ТестовыеДанные.РезультатОбработки(ТестовыеДанные.Массив("ДругоеРасш")));

	// Когда
	Сервис.СоздатьПустоеРасширение(База, "МоёРасш", Ложь);

	// Тогда - расширение создаётся загрузкой исходников через конфигуратор
	Стенд.Мок("ДвижокКонфигуратор").ПроверитьЧтоВызывалсяМетод().ЗагрузитьРасширениеИзФайлов(База, Любое, "МоёРасш", Любое, Любое);

КонецПроцедуры

#КонецОбласти
