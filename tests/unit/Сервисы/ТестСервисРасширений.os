#Область СравнитьРасширения

&Тест
Процедура ТестДолжен_СравнитьРасширения_ВернутьПутьКОтчёту() Экспорт

	// Дано
	МокКонфигуратор = Мок.Получить(Новый ДвижокКонфигуратор);
	МокКонфигуратор.Когда().СоздатьВременнуюБазу(Любое)
		.ТогдаВозвращает(Подключения.Файловая(ВременныеФайлы.СоздатьКаталог()));
	МокКонфигуратор.Когда().СравнитьРасширения(Любое, Любое, Любое, Любое, Любое, Любое, Любое, Любое)
		.ТогдаВозвращает("C:\report.txt");

	Сервис = Новый БилдерСервисаРасширений().СОдинаковымДвижком(МокКонфигуратор).Собрать();

	// Когда
	Результат = Сервис.СравнитьРасширения(Неопределено, "МоёРасш", "C:\b.cfe", "C:\r.txt", "Brief", "txt");

	// Тогда
	Ожидаем.Что(Результат).Равно("C:\report.txt");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОчиститьВременнуюБазуПриОшибкеСравненияРасширений() Экспорт

	// Дано
	КаталогВременной = ВременныеФайлы.СоздатьКаталог();
	МокКонфигуратор = Мок.Получить(Новый ДвижокКонфигуратор);
	МокКонфигуратор.Когда().СоздатьВременнуюБазу(Любое)
		.ТогдаВозвращает(Подключения.Файловая(КаталогВременной));
	МокКонфигуратор.Когда().СравнитьРасширения(Любое, Любое, Любое, Любое, Любое, Любое, Любое, Любое)
		.ТогдаВыбрасываетИсключение("Сравнение упало");

	Сервис = Новый БилдерСервисаРасширений().СОдинаковымДвижком(МокКонфигуратор).Собрать();

	// Когда / Тогда
	Попытка
		Сервис.СравнитьРасширения(Неопределено, "МоёРасш", "C:\b.cfe", "C:\r.txt", "Brief", "txt");
		ВызватьИсключение "Должно было упасть";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("Сравнение упало");
	КонецПопытки;

	Ожидаем.Что(Новый Файл(КаталогВременной).Существует()).ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область СоздатьПустоеРасширение

&Тест
Процедура ТестДолжен_СоздатьПустоеРасширение_ВыброситьОшибку_ЕслиУжеСуществуетБезOverwrite() Экспорт

	// Дано - список расширений содержит создаваемое имя
	МокДвижок = Мок.Получить(Новый ДвижокКонфигуратор);
	МокЗапуска = Мок.Получить(Новый СервисЗапускаОбработок);
	МокЗапуска.Когда().ВыполнитьОбработку(Любое, Любое, Любое, Любое)
		.ТогдаВозвращает(РезультатСоСписком("МоёРасш"));

	Сервис = Новый БилдерСервисаРасширений()
		.СОдинаковымДвижком(МокДвижок)
		.СЗапускомОбработок(МокЗапуска)
		.Собрать();

	// Когда / Тогда
	Попытка
		Сервис.СоздатьПустоеРасширение(Подключения.Файловая("C:\base"), "МоёРасш", Ложь);
		ВызватьИсключение "Должно было упасть";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("уже существует");
	КонецПопытки;

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьПустоеРасширение_ЗагрузитьИсходники_ЕслиНеСуществует() Экспорт

	// Дано - список расширений не содержит создаваемое имя
	МокДвижок = Мок.Получить(Новый ДвижокКонфигуратор);
	МокЗапуска = Мок.Получить(Новый СервисЗапускаОбработок);
	МокЗапуска.Когда().ВыполнитьОбработку(Любое, Любое, Любое, Любое)
		.ТогдаВозвращает(РезультатСоСписком("ДругоеРасш"));

	Сервис = Новый БилдерСервисаРасширений()
		.СОдинаковымДвижком(МокДвижок)
		.СЗапускомОбработок(МокЗапуска)
		.Собрать();

	// Когда
	Сервис.СоздатьПустоеРасширение(Подключения.Файловая("C:\base"), "МоёРасш", Ложь);

	// Тогда - расширение создаётся загрузкой исходников через конфигуратор
	МокДвижок.ПроверитьЧтоВызывалсяМетод().ЗагрузитьРасширениеИзФайлов(Любое, Любое, "МоёРасш", Любое, Любое);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Формирует результат СервисЗапускаОбработок с заданными именами расширений в сообщениях.
Функция РезультатСоСписком(Знач ИмяРасширения)
	Сообщения = Новый Массив;
	Сообщения.Добавить(ИмяРасширения);
	Возврат Новый Структура("КодВозврата, Сообщения, Ошибка, ФайлНайден", 0, Сообщения, "", Истина);
КонецФункции

Функция КорневойКаталогРепо()
	// tests/unit/Сервисы/<этот файл> -> ../../.. = корень репо
	Возврат Новый Файл(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "..", "..")).ПолноеИмя;
КонецФункции

// Создаёт реальный временный файл .cfe с фиктивным содержимым.
// Нужен, т.к. загрузка через 1С:Предприятие копирует cfe в рабочий каталог.
Функция СоздатьВременныйФайлCfe()
	Путь = ВременныеФайлы.НовоеИмяФайла("cfe");
	Запись = Новый ЗаписьТекста(Путь, "UTF-8");
	Запись.ЗаписатьСтроку("dummy cfe");
	Запись.Закрыть();
	Возврат Путь;
КонецФункции

#КонецОбласти
