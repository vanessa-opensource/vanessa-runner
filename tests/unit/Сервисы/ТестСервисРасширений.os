#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КорневойКаталогРепо()
	// tests/unit/Сервисы/<этот файл> -> ../../.. = корень репо
	Возврат Новый Файл(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "..", "..")).ПолноеИмя;
КонецФункции

// Создаёт временный каталог со структурой epf/ЗагрузитьРасширениеВРежимеПредприятия.epf -
// пустой заглушки достаточно: продакшен-код только проверяет существование файла.
// На CI реальный .epf отсутствует (gitignored, собирается e2e-таской).
Функция СоздатьКорневойКаталогСЗаглушкойEpf()
	КорневойКаталог = ВременныеФайлы.СоздатьКаталог();
	КаталогEpf = ОбъединитьПути(КорневойКаталог, "epf");
	СоздатьКаталог(КаталогEpf);
	ПутьКЗаглушке = ОбъединитьПути(КаталогEpf, "ЗагрузитьРасширениеВРежимеПредприятия.epf");
	Запись = Новый ЗаписьТекста(ПутьКЗаглушке, "UTF-8");
	Запись.Закрыть();
	Возврат КорневойКаталог;
КонецФункции

#КонецОбласти
