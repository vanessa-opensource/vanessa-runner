// BSLLS-off
// Юнит-тесты СервисОтчетовПроверки: каталоги отчётов (создание, очистка) и запись случаев проверки
// в JUnit и Allure по списку отчётов. Файлы - во временном каталоге, ФайловыеОперации настоящие.

#Использовать asserts
#Использовать tempfiles
#Использовать "../utils"

Перем Стенд;
Перем Сервис;
Перем Каталог;

&ПередКаждым
Процедура ПередКаждым() Экспорт
	Стенд = Новый Стенд;
	Стенд.Реальный("ФайловыеОперации");
	Сервис = Стенд.Сервис("СервисОтчетовПроверки");
	Каталог = ВременныеФайлы.СоздатьКаталог();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт
	ВременныеФайлы.Удалить();
КонецПроцедуры

#Область ПодготовитьКаталоги

&Тест
Процедура ТестДолжен_СоздатьКаталогФайлаОтчета() Экспорт

	// Дано
	ПутьОтчета = ТестовыеФайлы.Путь(Каталог, "build/junit/junit.xml");

	// Когда
	Сервис.ПодготовитьКаталоги(ТестовыеДанные.Массив(Отчет("junit", ПутьОтчета)));

	// Тогда
	Ожидаем.Что(ТестовыеФайлы.Существует(ТестовыеФайлы.Путь(Каталог, "build/junit")), "каталог файла").ЭтоИстина();
	Ожидаем.Что(ТестовыеФайлы.Существует(ПутьОтчета), "файл отчёта пишет генератор").ЭтоЛожь();

КонецПроцедуры

// Путь allure - каталог результатов, а не файл: создаётся он сам.
&Тест
Процедура ТестДолжен_СоздатьКаталогAllure() Экспорт

	// Дано
	КаталогAllure = ТестовыеФайлы.Путь(Каталог, "build/allure");

	// Когда
	Сервис.ПодготовитьКаталоги(ТестовыеДанные.Массив(Отчет("allure", КаталогAllure)));

	// Тогда
	Ожидаем.Что(ТестовыеФайлы.Существует(КаталогAllure), "каталог allure").ЭтоИстина();

КонецПроцедуры

// Каталог allure внутри каталога junit-файла: очистка junit не должна снести уже созданный allure.
&Тест
Процедура ТестДолжен_ОчиститьКаталогиОтчетов_ДоСоздания() Экспорт

	// Дано
	СтарыйJUnit = ТестовыеФайлы.Файл(Каталог, "build/old.xml", "прошлый прогон");
	СтарыйAllure = ТестовыеФайлы.Файл(Каталог, "build/allure/old-result.json", "{}");
	КаталогAllure = ТестовыеФайлы.Путь(Каталог, "build/allure");
	Отчеты = ТестовыеДанные.Массив(Отчет("junit", ТестовыеФайлы.Путь(Каталог, "build/junit.xml")),
		Отчет("allure", КаталогAllure));

	// Когда
	Сервис.ПодготовитьКаталоги(Отчеты, Истина);

	// Тогда
	Ожидаем.Что(ТестовыеФайлы.Существует(СтарыйJUnit), "старый файл каталога junit").ЭтоЛожь();
	Ожидаем.Что(ТестовыеФайлы.Существует(СтарыйAllure), "старый результат allure").ЭтоЛожь();
	Ожидаем.Что(ТестовыеФайлы.Существует(КаталогAllure), "каталог allure после очистки").ЭтоИстина();

КонецПроцедуры

// Allure штатно собирает отчёт из нескольких прогонов: без явной очистки каталог не трогаем.
&Тест
Процедура ТестДолжен_СохранитьПрошлыеРезультаты_БезОчистки() Экспорт

	// Дано
	СтарыйAllure = ТестовыеФайлы.Файл(Каталог, "build/allure/old-result.json", "{}");

	// Когда
	Сервис.ПодготовитьКаталоги(ТестовыеДанные.Массив(Отчет("allure", ТестовыеФайлы.Путь(Каталог, "build/allure"))));

	// Тогда
	Ожидаем.Что(ТестовыеФайлы.Существует(СтарыйAllure), "результат прошлого прогона").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Записать

&Тест
Процедура ТестДолжен_ЗаписатьОтчетJUnit_СоСлучаями() Экспорт

	// Дано
	ПутьОтчета = ТестовыеФайлы.Путь(Каталог, "junit.xml");
	Провален = Сервис.НовыйСлучай("Справочник.Справочник1.МодульОбъекта", "failed", "Ошибка компиляции");
	Провален.ИмяКласса = "edt.Категория";
	НижеПорога = Сервис.НовыйСлучай("Незначительное", "broken", "Замечание ниже порога");

	// Когда
	Сервис.Записать(ТестовыеДанные.Массив(Отчет("junit", ПутьОтчета)), ТестовыеДанные.Массив(Провален, НижеПорога),
		"edt", ТекущаяУниверсальнаяДата(), "Проверка прошла");

	// Тогда
	Текст = ТестовыеФайлы.ПрочитатьФайл(ПутьОтчета);
	Ожидаем.Что(Текст, "набор").Содержит("name=""edt""");
	Ожидаем.Что(Текст, "проваленный кейс").Содержит("name=""Справочник.Справочник1.МодульОбъекта""");
	Ожидаем.Что(Текст, "имя класса кейса").Содержит("classname=""edt.Категория""");
	Ожидаем.Что(Текст, "кейс ниже порога").Содержит("name=""Незначительное""");
	Ожидаем.Что(Текст, "имя класса по умолчанию - набор").Содержит("classname=""edt""");
	Ожидаем.Что(СтрЧислоВхождений(Текст, "<failure"), "failure только у failed").Равно(1);
	Ожидаем.Что(Текст, "текст замечания").Содержит("message=""Ошибка компиляции""");
	Ожидаем.Что(Текст, "успешный кейс не добавляется").Не_().Содержит("Проверка прошла");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗаписатьРезультатыAllure_ПоФайлуНаСлучай() Экспорт

	// Дано
	КаталогAllure = ТестовыеФайлы.Путь(Каталог, "allure");
	Случай = Сервис.НовыйСлучай("Справочник.Справочник1.МодульОбъекта", "broken", "Ошибка компиляции");
	Случай.Пакет = "Справочник.Справочник1";
	Случай.Важность = "critical";

	// Когда
	Сервис.Записать(ТестовыеДанные.Массив(Отчет("allure", КаталогAllure)), ТестовыеДанные.Массив(Случай),
		"syntax-check", ТекущаяУниверсальнаяДата(), "Проверка прошла");

	// Тогда
	Результат = ПрочитатьЕдинственныйРезультат(КаталогAllure);
	Ожидаем.Что(Результат.Получить("name"), "имя кейса").Равно("Справочник.Справочник1.МодульОбъекта");
	Ожидаем.Что(Результат.Получить("status"), "статус").Равно("broken");
	Ожидаем.Что(Результат.Получить("statusDetails").Получить("message"), "текст замечания").Равно("Ошибка компиляции");
	Метки = МеткиРезультата(Результат);
	Ожидаем.Что(Метки.Получить("suite"), "набор").Равно("syntax-check");
	Ожидаем.Что(Метки.Получить("package"), "пакет").Равно("Справочник.Справочник1");
	Ожидаем.Что(Метки.Получить("severity"), "важность").Равно("critical");

КонецПроцедуры

// Сырой файл edt пишет 1cedtcli: сервис его не трогает, но соседние форматы пишет.
&Тест
Процедура ТестДолжен_ПропуститьФорматEDT() Экспорт

	// Дано
	ПутьEDT = ТестовыеФайлы.Путь(Каталог, "edt-validate.tsv");
	ПутьJUnit = ТестовыеФайлы.Путь(Каталог, "junit.xml");
	Отчеты = ТестовыеДанные.Массив(Отчет("edt", ПутьEDT), Отчет("junit", ПутьJUnit));

	// Когда
	Сервис.Записать(Отчеты, Новый Массив, "edt", ТекущаяУниверсальнаяДата(), "Проверка EDT-проекта");

	// Тогда
	Ожидаем.Что(ТестовыеФайлы.Существует(ПутьEDT), "файл edt").ЭтоЛожь();
	Ожидаем.Что(ТестовыеФайлы.Существует(ПутьJUnit), "файл junit").ЭтоИстина();

КонецПроцедуры

// Пустой набор в отчёте неотличим от прогона, который до отчёта не дошёл: успешная проверка - один кейс.
&Тест
Процедура ТестДолжен_ЗаписатьОдинУспешныйСлучай_БезЗамечаний() Экспорт

	// Дано
	ПутьJUnit = ТестовыеФайлы.Путь(Каталог, "junit.xml");
	КаталогAllure = ТестовыеФайлы.Путь(Каталог, "allure");
	Отчеты = ТестовыеДанные.Массив(Отчет("junit", ПутьJUnit), Отчет("allure", КаталогAllure));

	// Когда
	Сервис.Записать(Отчеты, Новый Массив, "syntax-check", ТекущаяУниверсальнаяДата(), "Проверка прошла");

	// Тогда
	Текст = ТестовыеФайлы.ПрочитатьФайл(ПутьJUnit);
	Ожидаем.Что(СтрЧислоВхождений(Текст, "<testcase"), "кейсов junit").Равно(1);
	Ожидаем.Что(Текст, "имя успешного кейса").Содержит("name=""Проверка прошла""");
	Ожидаем.Что(Текст, "имя класса успешного кейса - набор").Содержит("classname=""syntax-check""");
	Ожидаем.Что(Текст, "успешный кейс без failure").Не_().Содержит("<failure");

	Результат = ПрочитатьЕдинственныйРезультат(КаталогAllure);
	Ожидаем.Что(Результат.Получить("name"), "имя успешного кейса").Равно("Проверка прошла");
	Ожидаем.Что(Результат.Получить("status"), "статус").Равно("passed");
	Ожидаем.Что(МеткиРезультата(Результат).Получить("severity"), "важность по умолчанию").Равно("normal");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Отчет(Знач Формат, Знач Путь)
	Возврат Новый Структура("Формат, Путь", Формат, Путь);
КонецФункции

Функция ПрочитатьЕдинственныйРезультат(Знач КаталогРезультатов)
	Файлы = НайтиФайлы(КаталогРезультатов, "*-result.json");
	Ожидаем.Что(Файлы.Количество(), "файлов результата").Равно(1);
	Возврат ТестовыеФайлы.ПрочитатьJSON(Файлы[0].ПолноеИмя);
КонецФункции

// Метки кейса в виде соответствия "имя метки -> значение".
Функция МеткиРезультата(Знач Результат)
	Метки = Новый Соответствие;
	Для Каждого Метка Из Результат.Получить("labels") Цикл
		Метки.Вставить(Метка.Получить("name"), Метка.Получить("value"));
	КонецЦикла;
	Возврат Метки;
КонецФункции

#КонецОбласти
