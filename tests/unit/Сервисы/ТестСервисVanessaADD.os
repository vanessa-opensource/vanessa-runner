// BSLLS-off
// Юнит-тесты СервисVanessaADD: поиск обработок vanessa-add (явный путь / каталог установки)
// и подстановка макроса $addRoot. Каталог установки подменяется стабом СервисОкружения.

#Использовать asserts
#Использовать tempfiles
#Использовать reflector
#Использовать logos

#Использовать "../../../src/core/Файлы"
#Использовать "../../../src/core/Сервисы"
#Использовать "../utils"

Перем Сервис;
Перем Окружение;

#Область СлужебныйПрограммныйИнтерфейс

&Тест
Процедура ТестДолжен_ВернутьЯвныйПуть_ЕслиФайлЕсть() Экспорт

	Файл = ВременныеФайлы.СоздатьФайл("epf");

	Путь = Сервис.ПутьКОбработке("xddTestRunner.epf", Файл, "--pathxunit");

	Ожидаем.Что(Путь).Равно(Новый Файл(Файл).ПолноеИмя);

КонецПроцедуры

&Тест
Процедура ТестДолжен_УпастьНаЯвномПути_ЕслиФайлаНет() Экспорт

	Путь = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "нет.epf");

	Попытка
		Сервис.ПутьКОбработке("xddTestRunner.epf", Путь, "--pathxunit");
		ВызватьИсключение "Должно было упасть";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("Файл обработки xddTestRunner.epf не найден");
		Ожидаем.Что(ОписаниеОшибки()).Содержит("--pathxunit");
	КонецПопытки;

КонецПроцедуры

&Тест
Процедура ТестДолжен_УпастьНаЯвномПути_ЕслиЭтоКаталог() Экспорт

	Попытка
		Сервис.ПутьКОбработке("bddRunner.epf", ВременныеФайлы.СоздатьКаталог(), "--bddrunner-path");
		ВызватьИсключение "Должно было упасть";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("не является файлом");
	КонецПопытки;

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиОбработку_ВКаталогеУстановки() Экспорт

	КаталогADD = ВременныеФайлы.СоздатьКаталог();
	Ожидаемый = ОбъединитьПути(КаталогADD, "bddRunner.epf");
	ЗаписатьПустойФайл(Ожидаемый);
	Окружение.СКаталогомADD(КаталогADD);

	Путь = Сервис.ПутьКОбработке("bddRunner.epf", "", "--bddrunner-path");

	Ожидаем.Что(Путь).Равно(Новый Файл(Ожидаемый).ПолноеИмя);

КонецПроцедуры

&Тест
Процедура ТестДолжен_УпастьСПодсказкой_ЕслиПакетНеУстановлен() Экспорт

	Окружение.СКаталогомADD("");

	Попытка
		Сервис.ПутьКОбработке("bddRunner.epf", "", "--bddrunner-path");
		ВызватьИсключение "Должно было упасть";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("vanessa-add");
		Ожидаем.Что(ОписаниеОшибки()).Содержит("bddRunner.epf");
		Ожидаем.Что(ОписаниеОшибки()).Содержит("--bddrunner-path");
	КонецПопытки;

КонецПроцедуры

&Тест
Процедура ТестДолжен_УпастьЕслиВКаталогеУстановкиНетОбработки() Экспорт

	Окружение.СКаталогомADD(ВременныеФайлы.СоздатьКаталог());

	Попытка
		Сервис.ПутьКОбработке("xddTestRunner.epf", "", "--pathxunit");
		ВызватьИсключение "Должно было упасть";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("Файл обработки xddTestRunner.epf не найден");
	КонецПопытки;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПодставитьМакросAddRoot() Экспорт

	Окружение.СКаталогомADD("C:\add");

	Ожидаем.Что(Сервис.ПодставитьМакросAddRoot("$addRoot/tests/smoke", "тестам")).Равно("C:\add/tests/smoke");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьПутьКакЕсть_БезМакроса() Экспорт

	Ожидаем.Что(Сервис.ПодставитьМакросAddRoot("./tests", "тестам")).Равно("./tests");
	Ожидаем.Что(Сервис.ПодставитьМакросAddRoot("", "тестам")).Равно("");
	Ожидаем.Что(Сервис.ПодставитьМакросAddRoot(Неопределено, "тестам")).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_УпастьНаМакросе_ЕслиПакетНеУстановлен() Экспорт

	Окружение.СКаталогомADD("");

	Попытка
		Сервис.ПодставитьМакросAddRoot("$addRoot/features", "фичам");
		ВызватьИсключение "Должно было упасть";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("$addRoot");
		Ожидаем.Что(ОписаниеОшибки()).Содержит("к фичам");
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт

	Окружение = Новый СервисОкруженияСтаб;
	Сервис = Новый СервисVanessaADD;

	Операции = Новый ФайловыеОперации;
	Рефлектор = Новый Рефлектор;
	Рефлектор.УстановитьСвойство(Операции, "Лог", Логирование.ПолучитьЛог("vrunner"));
	Рефлектор.УстановитьСвойство(Сервис, "СервисОкружения", Окружение);
	Рефлектор.УстановитьСвойство(Сервис, "ФайловыеОперации", Операции);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаписатьПустойФайл(Знач Путь)
	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Запись.Закрыть();
КонецПроцедуры

#КонецОбласти
