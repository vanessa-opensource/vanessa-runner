// BSLLS-off
// Юнит-тесты СервисVanessaADD: поиск обработок vanessa-add (явный путь / каталог установки)
// и подстановка макроса $addRoot. Каталог установки отдаёт мок СервисОкружения.

#Использовать asserts
#Использовать tempfiles
#Использовать "../utils"

Перем Стенд;
Перем Сервис;

&ПередКаждым
Процедура ПередКаждым() Экспорт
	Стенд = Новый Стенд;
	Стенд.Реальный("ФайловыеОперации");
	Сервис = Стенд.Сервис("СервисVanessaADD");
КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт
	ВременныеФайлы.Удалить();
КонецПроцедуры

#Область ПутьКОбработке

&Тест
Процедура ТестДолжен_ВернутьЯвныйПуть_ЕслиФайлЕсть() Экспорт

	Файл = ТестовыеФайлы.ВременныйФайл("epf");

	Путь = Сервис.ПутьКОбработке("xddTestRunner.epf", Файл, "--pathxunit");

	Ожидаем.Что(Путь).Равно(Новый Файл(Файл).ПолноеИмя);

КонецПроцедуры

&Тест
Процедура ТестДолжен_УпастьНаЯвномПути_ЕслиФайлаНет() Экспорт

	Путь = ТестовыеФайлы.НесуществующийПуть("нет.epf");

	Ожидаем.Что(Сервис).Метод("ПутьКОбработке", ТестовыеДанные.Массив("xddTestRunner.epf", Путь, "--pathxunit"))
		.ВыбрасываетИсключение("Файл обработки xddTestRunner.epf не найден")
		.ВыбрасываетИсключение("--pathxunit");

КонецПроцедуры

&Тест
Процедура ТестДолжен_УпастьНаЯвномПути_ЕслиЭтоКаталог() Экспорт

	Каталог = ВременныеФайлы.СоздатьКаталог();

	Ожидаем.Что(Сервис).Метод("ПутьКОбработке", ТестовыеДанные.Массив("bddRunner.epf", Каталог, "--bddrunner-path"))
		.ВыбрасываетИсключение("не является файлом");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиОбработку_ВКаталогеУстановки() Экспорт

	// Дано
	КаталогADD = ВременныеФайлы.СоздатьКаталог();
	Ожидаемый = ТестовыеФайлы.Файл(КаталогADD, "bddRunner.epf");
	Стенд.Мок("СервисОкружения").Когда().КаталогVanessaADD().ТогдаВозвращает(КаталогADD);

	// Когда
	Путь = Сервис.ПутьКОбработке("bddRunner.epf", "", "--bddrunner-path");

	// Тогда
	Ожидаем.Что(Путь).Равно(Новый Файл(Ожидаемый).ПолноеИмя);

КонецПроцедуры

&Тест
Процедура ТестДолжен_УпастьСПодсказкой_ЕслиПакетНеУстановлен() Экспорт

	// Дано - пресет мока: каталог vanessa-add не найден
	// Когда / Тогда
	Ожидаем.Что(Сервис).Метод("ПутьКОбработке", ТестовыеДанные.Массив("bddRunner.epf", "", "--bddrunner-path"))
		.ВыбрасываетИсключение("vanessa-add")
		.ВыбрасываетИсключение("bddRunner.epf")
		.ВыбрасываетИсключение("--bddrunner-path");

КонецПроцедуры

&Тест
Процедура ТестДолжен_Упасть_ЕслиВКаталогеУстановкиНетОбработки() Экспорт

	Стенд.Мок("СервисОкружения").Когда().КаталогVanessaADD().ТогдаВозвращает(ВременныеФайлы.СоздатьКаталог());

	Ожидаем.Что(Сервис).Метод("ПутьКОбработке", ТестовыеДанные.Массив("xddTestRunner.epf", "", "--pathxunit"))
		.ВыбрасываетИсключение("Файл обработки xddTestRunner.epf не найден");

КонецПроцедуры

#КонецОбласти

#Область ПодставитьМакросAddRoot

&Тест
Процедура ТестДолжен_ПодставитьМакросAddRoot() Экспорт

	Стенд.Мок("СервисОкружения").Когда().КаталогVanessaADD().ТогдаВозвращает("add-root");

	Ожидаем.Что(Сервис.ПодставитьМакросAddRoot("$addRoot/tests/smoke", "тестам")).Равно("add-root/tests/smoke");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьПутьКакЕсть_БезМакроса() Экспорт

	Ожидаем.Что(Сервис.ПодставитьМакросAddRoot("./tests", "тестам")).Равно("./tests");
	Ожидаем.Что(Сервис.ПодставитьМакросAddRoot("", "тестам")).Равно("");
	Ожидаем.Что(Сервис.ПодставитьМакросAddRoot(Неопределено, "тестам")).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_УпастьНаМакросе_ЕслиПакетНеУстановлен() Экспорт

	// Дано - пресет мока: каталог vanessa-add не найден
	// Когда / Тогда
	Ожидаем.Что(Сервис).Метод("ПодставитьМакросAddRoot", ТестовыеДанные.Массив("$addRoot/features", "фичам"))
		.ВыбрасываетИсключение("$addRoot")
		.ВыбрасываетИсключение("к фичам");

КонецПроцедуры

#КонецОбласти
