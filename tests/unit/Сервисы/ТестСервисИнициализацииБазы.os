// BSLLS-off
// Юнит-тесты СервисИнициализацииБазы: файловая и серверная ИБ, загрузка dt/cf/исходников, расширения
// с одним обновлением БД, рекурсивный поиск источников и его предупреждения. Сервисы платформы,
// конфигурации, расширений замоканы, лог - шпион.

#Использовать asserts
#Использовать logos
#Использовать moskito
#Использовать tempfiles
#Использовать "../utils"

Перем Стенд;
Перем Сервис;
Перем База;
Перем ПараметрыПлатформы;
Перем Любое;

&ПередКаждым
Процедура ПередКаждым() Экспорт
	Стенд = Новый Стенд;
	Сервис = Стенд.Сервис("СервисИнициализацииБазы");
	База = ТестовыеДанные.Подключение("/S""srv\base""");
	ПараметрыПлатформы = ТестовыеДанные.ПараметрыПлатформы();
	Любое = Матчеры.ЛюбоеЗначение();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт
	ВременныеФайлы.Удалить();
КонецПроцедуры

#Область РазрешитьИсточникиРекурсивно

&Тест
Процедура ТестДолжен_НайтиОднуКонфигурациюИРасширения() Экспорт

	// Дано - в --src конфигурация и расширение, в --ext расширение и игнорируемая конфигурация
	Лог = Стенд.Подменить("Лог", Мок.Следить(Логирование.ПолучитьЛог("vrunner")));
	Стенд.Реальный("СервисПоискаИсточников");
	КореньИсточника = ВременныеФайлы.СоздатьКаталог();
	ТестовыеФайлы.Файл(КореньИсточника, "cf/Configuration.xml");
	ПервоеРасширение = ТестовыеФайлы.Файл(КореньИсточника, "ext/Первое.cfe");
	КореньРасширений = ВременныеФайлы.СоздатьКаталог();
	ВтороеРасширение = ТестовыеФайлы.Файл(КореньРасширений, "Второе.cfe");
	ТестовыеФайлы.Файл(КореньРасширений, "cf/Configuration.xml");

	// Когда
	Найденные = Сервис.РазрешитьИсточникиРекурсивно(КореньИсточника, ТестовыеДанные.Массив(КореньРасширений));

	// Тогда
	Ожидаем.Что(Найденные.Источник).Равно(Новый Файл(ТестовыеФайлы.Путь(КореньИсточника, "cf")).ПолноеИмя);
	Ожидаем.Что(Найденные.Расширения).ИмеетДлину(2);
	Ожидаем.Что(Найденные.Расширения).Содержит(Новый Файл(ПервоеРасширение).ПолноеИмя);
	Ожидаем.Что(Найденные.Расширения).Содержит(Новый Файл(ВтороеРасширение).ПолноеИмя);
	Лог.ПроверитьЧтоВызывалсяМетод().Предупреждение(
		"В каталоге расширений ""%1"" обнаружены источники конфигурации (%2 шт.) - проигнорированы:"
		+ " --ext загружает только расширения.",
		КореньРасширений, 1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОставитьИсточникПустым_ЕслиКонфигурацияНеНайдена() Экспорт

	// Дано
	Лог = Стенд.Подменить("Лог", Мок.Следить(Логирование.ПолучитьЛог("vrunner")));
	Стенд.Реальный("СервисПоискаИсточников");
	КореньИсточника = ВременныеФайлы.СоздатьКаталог();
	ТестовыеФайлы.Файл(КореньИсточника, "МоёРасш.cfe");

	// Когда
	Найденные = Сервис.РазрешитьИсточникиРекурсивно(КореньИсточника, Неопределено);

	// Тогда - предупреждение в лог, найденное расширение загружается
	Ожидаем.Что(Найденные.Источник).Равно("");
	Ожидаем.Что(Найденные.Расширения).ИмеетДлину(1);
	Лог.ПроверитьЧтоВызывалсяМетод().Предупреждение(
		"Рекурсивный поиск в ""%1"": источник конфигурации не найден", КореньИсточника);

КонецПроцедуры

#КонецОбласти

#Область Инициализировать

&Тест
Процедура ТестДолжен_СоздатьФайловуюБазу_УдаливСуществующийКаталог() Экспорт

	// Дано
	КаталогБазы = ВременныеФайлы.СоздатьКаталог();
	ТестовыеФайлы.Файл(КаталогБазы, "1Cv8.1CD");
	Созданная = ТестовыеДанные.Файловая(КаталогБазы);
	Стенд.Мок("СервисПлатформы").Когда().СоздатьФайловуюБазу(Любое, Любое).ТогдаВозвращает(Созданная);
	Параметры = НовыеПараметры();
	Параметры.КаталогБазы = КаталогБазы;

	// Когда
	Результат = Сервис.Инициализировать(Параметры);

	// Тогда
	Ожидаем.Что(ТестовыеФайлы.Существует(КаталогБазы), "существующий каталог удалён").ЭтоЛожь();
	Стенд.Мок("СервисПлатформы").ПроверитьЧтоВызывалсяМетод().СоздатьФайловуюБазу(КаталогБазы, ПараметрыПлатформы);
	Ожидаем.Что(Результат).Равно(Созданная);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИспользоватьСервернуюБазу_БезСоздания() Экспорт

	// Когда - каталог базы не задан
	Результат = Сервис.Инициализировать(НовыеПараметры());

	// Тогда
	Стенд.ПроверитьЧтоНеВызывался("СервисПлатформы", "СоздатьФайловуюБазу");
	Стенд.ПроверитьЧтоНеВызывался("СервисКонфигурации", "ЗагрузитьИсточник");
	Стенд.ПроверитьЧтоНеВызывался("СервисРасширений", "ЗагрузитьРасширениеВБазу");
	Ожидаем.Что(Результат).Равно(База);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗагрузитьВБазуСУБД_БезСоздания() Экспорт

	// Дано - параметры СУБД, каталог базы не задан
	Лог = Стенд.Подменить("Лог", Мок.Следить(Логирование.ПолучитьЛог("vrunner")));
	База.Вставить("ТипСУБД", "PostgreSQL");
	Параметры = НовыеПараметры();
	Параметры.Источник = "src";

	// Когда
	Результат = Сервис.Инициализировать(Параметры);

	// Тогда - база создаётся при загрузке по переданным параметрам
	Лог.ПроверитьЧтоВызывалсяМетод().Информация("Создание серверной ИБ с использованием параметров СУБД");
	Стенд.ПроверитьЧтоНеВызывался("СервисПлатформы", "СоздатьФайловуюБазу");
	Стенд.Мок("СервисКонфигурации").ПроверитьЧтоВызывалсяМетод()
		.ЗагрузитьИсточник(База, "src", ПараметрыПлатформы, Неопределено, Ложь, "");
	Ожидаем.Что(Результат).Равно(База);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗагрузитьИнфобазуИзDt_БезОбновленияБД() Экспорт

	// Дано
	Стенд.Мок("СервисПоискаИсточников").Когда().ВидИсточника("base.dt", Истина).ТогдаВозвращает("dt");
	Параметры = НовыеПараметры();
	Параметры.Источник = "base.dt";

	// Когда
	Сервис.Инициализировать(Параметры);

	// Тогда
	Стенд.Мок("СервисПлатформы").ПроверитьЧтоВызывалсяМетод().ЗагрузитьИнфобазуИзФайла(База, "base.dt", ПараметрыПлатформы);
	Стенд.ПроверитьЧтоНеВызывался("СервисКонфигурации", "ЗагрузитьИсточник");
	Стенд.ПроверитьЧтоНеВызывался("СервисПлатформы", "ОбновитьКонфигурациюБД");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗагрузитьИсходники_ОбновитьБДИПересоздатьИндекс() Экспорт

	// Дано
	Стенд.Мок("СервисКонфигурации").Когда().ЗагрузитьИсточник(Любое, Любое, Любое, Любое, Любое, Любое)
		.ТогдаВозвращает("edt");
	Параметры = НовыеПараметры();
	Параметры.Источник = "src";
	Параметры.ПараметрыИсходников = ТестовыеДанные.ПараметрыИсходников("edt");

	// Когда
	Сервис.Инициализировать(Параметры);

	// Тогда
	Стенд.Мок("СервисКонфигурации").ПроверитьЧтоВызывалсяМетод()
		.ЗагрузитьИсточник(База, "src", ПараметрыПлатформы, Параметры.ПараметрыИсходников, Ложь, "");
	Стенд.Мок("СервисПлатформы").ПроверитьЧтоВызывалсяМетод().ОбновитьКонфигурациюБД(База, ПараметрыПлатформы, Неопределено);
	Стенд.Мок("СервисРасчетаИнкремента").ПроверитьЧтоВызывалсяМетод().ПересоздатьИндекс("src", База);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПересоздатьИндекс_ДляXmlИсходников() Экспорт

	// Дано
	Стенд.Мок("СервисКонфигурации").Когда().ЗагрузитьИсточник(Любое, Любое, Любое, Любое, Любое, Любое)
		.ТогдаВозвращает("xml");
	Параметры = НовыеПараметры();
	Параметры.Источник = "src";

	// Когда
	Сервис.Инициализировать(Параметры);

	// Тогда
	Стенд.Мок("СервисРасчетаИнкремента").ПроверитьЧтоВызывалсяМетод().ПересоздатьИндекс("src", База);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеПересоздаватьИндекс_ДляФайлаCf() Экспорт

	// Дано
	Стенд.Мок("СервисКонфигурации").Когда().ЗагрузитьИсточник(Любое, Любое, Любое, Любое, Любое, Любое)
		.ТогдаВозвращает("cf");
	Параметры = НовыеПараметры();
	Параметры.Источник = "base.cf";

	// Когда
	Сервис.Инициализировать(Параметры);

	// Тогда
	Стенд.Мок("СервисПлатформы").ПроверитьЧтоВызывалсяМетод().ОбновитьКонфигурациюБД(База, ПараметрыПлатформы, Неопределено);
	Стенд.ПроверитьЧтоНеВызывался("СервисРасчетаИнкремента", "ПересоздатьИндекс");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗагрузитьРасширения_ОдинРазОбновивБДИПрименивСвойства() Экспорт

	// Дано
	Расширения = Стенд.Мок("СервисРасширений");
	Расширения.Когда().ЗагрузитьРасширениеВБазу(Любое, "a.cfe", Любое, Любое, Любое, Любое).ТогдаВозвращает("A");
	Расширения.Когда().ЗагрузитьРасширениеВБазу(Любое, "b", Любое, Любое, Любое, Любое).ТогдаВозвращает("B");
	Параметры = НовыеПараметры();
	Параметры.Расширения = ТестовыеДанные.Массив("a.cfe", "b");

	// Когда
	Сервис.Инициализировать(Параметры);

	// Тогда - загрузка каждого, одно обновление всех расширений, свойства каждого без флагов
	Расширения.ПроверитьЧтоВызывалсяМетод().ЗагрузитьРасширениеВБазу(База, "a.cfe", "", ПараметрыПлатформы, Ложь, Неопределено);
	Расширения.ПроверитьЧтоВызывалсяМетод().ЗагрузитьРасширениеВБазу(База, "b", "", ПараметрыПлатформы, Ложь, Неопределено);
	Обновления = Стенд.Вызовы("СервисПлатформы", "ОбновитьКонфигурациюБД");
	Ожидаем.Что(Обновления).ИмеетДлину(1);
	Ожидаем.Что(Обновления[0].НастройкиОбновления.ОбновитьВсеРасширения).ЭтоИстина();
	Расширения.ПроверитьЧтоВызывалсяМетод().ПрименитьСвойства(База, "A", Любое, ПараметрыПлатформы);
	Расширения.ПроверитьЧтоВызывалсяМетод().ПрименитьСвойства(База, "B", Любое, ПараметрыПлатформы);
	Ожидаем.Что(Стенд.Вызовы("СервисРасширений", "ПрименитьСвойства")[0].Свойства.Количество(), "флаги не переданы").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыеПараметры()

	Параметры = Сервис.НовыеПараметры();
	Параметры.ПараметрыПодключения = База;
	Параметры.ПараметрыПлатформы = ПараметрыПлатформы;
	Возврат Параметры;

КонецФункции

#КонецОбласти
