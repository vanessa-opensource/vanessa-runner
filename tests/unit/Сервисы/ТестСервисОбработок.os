#КонецОбласти

#Область РазобратьОбработкиИзКаталога

&Тест
Процедура ТестДолжен_РазобратьВсеEpfИзКаталога() Экспорт

	// Дано
	Данные = Обработки.КаталогСНесколькимиEpf(2);
	МокДвижок = Мок.Получить(Новый ДвижокКонфигуратор);
	МокДвижок.Когда().СоздатьВременнуюБазу(Любое)
		.ТогдаВозвращает(Подключения.Файловая(ВременныеФайлы.СоздатьКаталог()));

	Сервис = Новый БилдерСервисаОбработок().СОдинаковымДвижком(МокДвижок).Собрать();

	// Когда
	Сервис.РазобратьОбработкиИзКаталога(Данные.Каталог);

	// Тогда
	МокДвижок.ПроверитьЧтоВызывалсяМетод().РазобратьВнешнююОбработкуВФайлы(Любое, Любое, Любое, Любое);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыброситьИсключение_ЕслиВКаталогеНетEpf() Экспорт

	// Дано
	ПустойКаталог = Обработки.ПустойКаталог();
	МокДвижок = Мок.Получить(Новый ДвижокКонфигуратор);
	Сервис = Новый БилдерСервисаОбработок().СОдинаковымДвижком(МокДвижок).Собрать();

	// Когда / Тогда
	Попытка
		Сервис.РазобратьОбработкиИзКаталога(ПустойКаталог);
		ВызватьИсключение "Должно было выброситься исключение";
	Исключение
