#Область СборкаИзEDT

&Тест
Процедура ТестДолжен_СобратьОбработкиИзEDTПроекта() Экспорт

	// Дано - источник EDT: СервисEDT выгрузил проект в два XML
	КаталогXml = ВременныеФайлы.СоздатьКаталог();
	ПутьТест = ОбъединитьПути(КаталогXml, "Тест.xml");
	ПутьВтор = ОбъединитьПути(КаталогXml, "Втор.xml");
	ЗаписатьТекстВФайл(ПутьТест, "<ExternalDataProcessor/>");
	ЗаписатьТекстВФайл(ПутьВтор, "<ExternalDataProcessor/>");
	ФайлыВыгрузки = Новый Массив;
	ФайлыВыгрузки.Добавить(Новый Файл(ПутьТест));
	ФайлыВыгрузки.Добавить(Новый Файл(ПутьВтор));

	МокEDT = Мок.Получить(Новый СервисEDT);
	МокEDT.Когда().ЭтоПроектВнешнихОбъектовEDT(Любое, Любое).ТогдаВозвращает(Истина);
	МокEDT.Когда().ЭкспортироватьВнешниеОбъекты(Любое, Любое, Любое).ТогдаВозвращает(ФайлыВыгрузки);
	КаталогВременнойБазы = ВременныеФайлы.СоздатьКаталог();
	МокДвижок = Мок.Получить(Новый ДвижокКонфигуратор);
	МокДвижок.Когда().СоздатьВременнуюБазу(Любое).ТогдаВозвращает(Подключения.Файловая(КаталогВременнойБазы));
	КаталогOut = ВременныеФайлы.СоздатьКаталог();
	Сервис = Новый БилдерСервисаОбработок().СОдинаковымДвижком(МокДвижок).СEDT(МокEDT).Собрать();

	// Когда
	Сервис.СобратьОбработку("C:\edt-project", КаталогOut, Ложь, Неопределено, Неопределено,
		Новый Структура("Формат, Версия, Workspace", "edt", "", ""));

	// Тогда - выгрузка EDT и сборка каждого объекта в .epf
	МокEDT.ПроверитьЧтоВызывалсяМетод().ЭкспортироватьВнешниеОбъекты("C:\edt-project", Любое, Любое);
	МокДвижок.ПроверитьЧтоВызывалсяМетод().СобратьВнешнююОбработкуИзФайлов(
		Любое, ПутьТест, ОбъединитьПути(КаталогOut, "Тест.epf"), Любое);
	МокДвижок.ПроверитьЧтоВызывалсяМетод().СобратьВнешнююОбработкуИзФайлов(
		Любое, ПутьВтор, ОбъединитьПути(КаталогOut, "Втор.epf"), Любое);
	Ожидаем.Что(Новый Файл(КаталогВременнойБазы).Существует(), "временная база удалена").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_СобиратьИзXMLНапрямую_ЕслиИсточникНеEDT() Экспорт

	// Дано - источник не EDT: сборка идёт напрямую из XML, export не вызывается
	КаталогДанные = Обработки.КаталогСОбработкой("МояОбработка");
	МокEDT = Мок.Получить(Новый СервисEDT);
	МокEDT.Когда().ЭтоПроектВнешнихОбъектовEDT(Любое, Любое).ТогдаВозвращает(Ложь);
	КаталогВременнойБазы = ВременныеФайлы.СоздатьКаталог();
	МокДвижок = Мок.Получить(Новый ДвижокКонфигуратор);
	МокДвижок.Когда().СоздатьВременнуюБазу(Любое).ТогдаВозвращает(Подключения.Файловая(КаталогВременнойБазы));
	Сервис = Новый БилдерСервисаОбработок().СОдинаковымДвижком(МокДвижок).СEDT(МокEDT).Собрать();

	// Когда
	Сервис.СобратьОбработку(КаталогДанные.Каталог);

	// Тогда - собрано напрямую из XML-файла обработки
	МокДвижок.ПроверитьЧтоВызывалсяМетод().СобратьВнешнююОбработкуИзФайлов(
		Любое, КаталогДанные.ФайлXml, Любое, Любое);

КонецПроцедуры

Процедура ЗаписатьТекстВФайл(Знач Путь, Знач Текст)
	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Запись.Записать(Текст);
	Запись.Закрыть();
КонецПроцедуры

#КонецОбласти
