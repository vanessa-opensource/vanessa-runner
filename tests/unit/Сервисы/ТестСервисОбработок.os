// BSLLS-off
// Юнит-тесты СервисОбработок: сборка/разборка EPF и ERF из XML, каталогов и EDT-проекта, расширение
// результата по типу объекта, очистка временной базы при ошибках, конвертация EDT. Движки замоканы;
// СервисEDT - шпион: тип объекта по XML настоящий, признак EDT-проекта и экспорт застаблены.

#Использовать asserts
#Использовать moskito
#Использовать tempfiles
#Использовать "../utils"

Перем Стенд;
Перем Сервис;
Перем Конфигуратор; // мок ДвижокКонфигуратор: сборка и разборка EPF всегда идут через него
Перем EDT;          // шпион над настоящим СервисEDT
Перем Любое;

&ПередКаждым
Процедура ПередКаждым() Экспорт
	Стенд = Новый Стенд;
	Стенд.Реальный("ФайловыеОперации");    // каталог выгрузки и временный XML создаются и удаляются по-настоящему
	Стенд.Реальный("СервисВременнойБазы"); // жизненный цикл временной ИБ настоящий, движки - моки
	EDT = Стенд.Подменить("СервисEDT", Мок.Следить(Стенд.Реальный("СервисEDT")));
	Сервис = Стенд.Сервис("СервисОбработок");
	Конфигуратор = Стенд.Мок("ДвижокКонфигуратор");
	Любое = Матчеры.ЛюбоеЗначение();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт
	ВременныеФайлы.Удалить();
КонецПроцедуры

#Область СобратьОбработку

&Тест
Процедура ТестДолжен_СобратьОбработкуИзКаталога_СоздавВременнуюБазуЕслиНетПодключения() Экспорт

	// Дано
	Данные = ДанныеОбработок.КаталогСОбработкой("МояОбработка");

	// Когда
	Сервис.СобратьОбработку(Данные.Каталог);

	// Тогда
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().СоздатьВременнуюБазу(Неопределено);
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().СобратьВнешнююОбработкуИзФайлов(Любое, Данные.ФайлXml, Любое, Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СобратьОбработку_ВУказанныйКаталогВыгрузки() Экспорт

	// Дано
	Данные = ДанныеОбработок.КаталогСОбработкой("МояОбработка");
	КаталогВыгрузки = ВременныеФайлы.СоздатьКаталог();

	// Когда
	Сервис.СобратьОбработку(Данные.Каталог, КаталогВыгрузки);

	// Тогда
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().СобратьВнешнююОбработкуИзФайлов(
		Любое, Данные.ФайлXml, ОбъединитьПути(КаталогВыгрузки, "МояОбработка.epf"), Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СобратьВнешнийОтчет_ВФайлErf() Экспорт

	// Дано - каталог с XML внешнего отчёта (ExternalReport), а не обработки
	Данные = ДанныеОбработок.КаталогСОтчетом("МойОтчет");
	КаталогВыгрузки = ВременныеФайлы.СоздатьКаталог();

	// Когда
	Сервис.СобратьОбработку(Данные.Каталог, КаталогВыгрузки);

	// Тогда - отчёт собран в .erf, а не в .epf
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().СобратьВнешнююОбработкуИзФайлов(
		Любое, Данные.ФайлXml, ОбъединитьПути(КаталогВыгрузки, "МойОтчет.erf"), Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_БроситьИсключение_ЕслиВКаталогеНетXml() Экспорт

	Ожидаем.Что(Сервис).Метод("СобратьОбработку", ТестовыеДанные.Массив(ДанныеОбработок.ПустойКаталог()))
		.ВыбрасываетИсключение("не найден XML-файл внешней обработки");
	Стенд.ПроверитьЧтоНеВызывался("ДвижокКонфигуратор", "СоздатьВременнуюБазу");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОчиститьВременнуюБазу_ПриОшибкеСборки() Экспорт

	// Дано
	Данные = ДанныеОбработок.КаталогСОбработкой();
	КаталогВременной = ВременныеФайлы.СоздатьКаталог();
	Конфигуратор.Когда().СоздатьВременнуюБазу(Любое).ТогдаВозвращает(ТестовыеДанные.Файловая(КаталогВременной));
	Конфигуратор.Когда().СобратьВнешнююОбработкуИзФайлов(Любое, Любое, Любое, Любое).ТогдаВыбрасываетИсключение("Сборка упала");

	// Когда / Тогда
	Ожидаем.Что(Сервис).Метод("СобратьОбработку", ТестовыеДанные.Массив(Данные.Каталог)).ВыбрасываетИсключение("Сборка упала");
	Ожидаем.Что(ТестовыеФайлы.Существует(КаталогВременной), "временная база удалена").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_СобратьОбработкиИзEDTПроекта() Экспорт

	// Дано - источник EDT: СервисEDT выгрузил проект в два XML; временная база одна на всех
	КаталогXml = ВременныеФайлы.СоздатьКаталог();
	ПутьТест = ТестовыеФайлы.Файл(КаталогXml, "Тест.xml", "<ExternalDataProcessor/>");
	ПутьВтор = ТестовыеФайлы.Файл(КаталогXml, "Втор.xml", "<ExternalDataProcessor/>");
	ЭкспортEDTВозвращает(ТестовыеДанные.Массив(ПутьТест, ПутьВтор));
	КаталогВременной = ВременныеФайлы.СоздатьКаталог();
	Конфигуратор.Когда().СоздатьВременнуюБазу(Любое).ТогдаВозвращает(ТестовыеДанные.Файловая(КаталогВременной));
	КаталогOut = ВременныеФайлы.СоздатьКаталог();

	// Когда
	СобратьИзПроектаEDT(КаталогOut);

	// Тогда - выгрузка EDT и сборка каждого объекта в .epf
	EDT.ПроверитьЧтоВызывалсяМетод().ЭкспортироватьВнешниеОбъекты("edt-project", Любое, Любое);
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().СобратьВнешнююОбработкуИзФайлов(
		Любое, ПутьТест, ОбъединитьПути(КаталогOut, "Тест.epf"), Неопределено);
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().СобратьВнешнююОбработкуИзФайлов(
		Любое, ПутьВтор, ОбъединитьПути(КаталогOut, "Втор.epf"), Неопределено);
	Ожидаем.Что(Стенд.Вызовы("ДвижокКонфигуратор", "СоздатьВременнуюБазу")).ИмеетДлину(1);
	Ожидаем.Что(ТестовыеФайлы.Существует(КаталогВременной), "временная база удалена").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_СобратьОтчетИзEDTПроекта_ВФайлErf() Экспорт

	// Дано - раскладка export 1С:EDT: ExternalDataProcessors/ и ExternalReports/
	КаталогXml = ВременныеФайлы.СоздатьКаталог();
	ПутьОбработки = ТестовыеФайлы.Файл(КаталогXml, "ExternalDataProcessors/МояОбработка.xml",
		"<ExternalDataProcessor uuid=""00000000-0000-0000-0000-000000000001""/>");
	ПутьОтчета = ТестовыеФайлы.Файл(КаталогXml, "ExternalReports/МойОтчет.xml",
		"<ExternalReport uuid=""00000000-0000-0000-0000-000000000002""/>");
	ЭкспортEDTВозвращает(ТестовыеДанные.Массив(ПутьОбработки, ПутьОтчета));
	КаталогOut = ВременныеФайлы.СоздатьКаталог();

	// Когда
	СобратьИзПроектаEDT(КаталогOut);

	// Тогда - обработка собрана в .epf, отчёт - в .erf
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().СобратьВнешнююОбработкуИзФайлов(
		Любое, ПутьОбработки, ОбъединитьПути(КаталогOut, "МояОбработка.epf"), Неопределено);
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().СобратьВнешнююОбработкуИзФайлов(
		Любое, ПутьОтчета, ОбъединитьПути(КаталогOut, "МойОтчет.erf"), Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОпределитьТипОбъектаEDT_ПоКаталогуРаскладки() Экспорт

	// Дано - корневой тег без uuid не распознан, тип берётся из каталога раскладки export
	ПутьОтчета = ТестовыеФайлы.Файл(ВременныеФайлы.СоздатьКаталог(), "ExternalReports/МойОтчет.xml", "<ExternalReport/>");
	ЭкспортEDTВозвращает(ТестовыеДанные.Массив(ПутьОтчета));
	КаталогOut = ВременныеФайлы.СоздатьКаталог();

	// Когда
	СобратьИзПроектаEDT(КаталогOut);

	// Тогда - объект из ExternalReports/ собран в .erf
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().СобратьВнешнююОбработкуИзФайлов(
		Любое, ПутьОтчета, ОбъединитьПути(КаталогOut, "МойОтчет.erf"), Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СобиратьИзXMLНапрямую_ЕслиИсточникНеEDT() Экспорт

	// Дано - источник не EDT: сборка идёт напрямую из XML
	Данные = ДанныеОбработок.КаталогСОбработкой("МояОбработка");
	EDT.Когда().ЭтоПроектВнешнихОбъектовEDT(Любое, Любое).ТогдаВозвращает(Ложь);

	// Когда
	Сервис.СобратьОбработку(Данные.Каталог);

	// Тогда - собрано напрямую из XML-файла обработки
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().СобратьВнешнююОбработкуИзФайлов(Любое, Данные.ФайлXml, Любое, Неопределено);

КонецПроцедуры

#КонецОбласти

#Область СобратьОбработкиРекурсивно

&Тест
Процедура ТестДолжен_СобратьВсеОбработкиИзПодкаталогов() Экспорт

	// Дано
	Данные = ДанныеОбработок.КаталогСНесколькимиОбработками(3);

	// Когда
	Сервис.СобратьОбработкиРекурсивно(Данные.Каталог);

	// Тогда - по сборке на каждую найденную обработку в одной временной базе
	Ожидаем.Что(Стенд.Вызовы("ДвижокКонфигуратор", "СобратьВнешнююОбработкуИзФайлов")).ИмеетДлину(3);
	Ожидаем.Что(Стенд.Вызовы("ДвижокКонфигуратор", "СоздатьВременнуюБазу")).ИмеетДлину(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СобратьОбработкуИОтчет_СРазнымиРасширениями() Экспорт

	// Дано - в дереве лежат и обработка, и внешний отчёт
	Данные = ДанныеОбработок.КаталогСОбработкойИОтчетом("МояОбработка", "МойОтчет");
	КаталогВыгрузки = ВременныеФайлы.СоздатьКаталог();

	// Когда
	Сервис.СобратьОбработкиРекурсивно(Данные.Каталог, КаталогВыгрузки);

	// Тогда - каждый объект собран со своим расширением
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().СобратьВнешнююОбработкуИзФайлов(
		Любое, Данные.ФайлОбработки, ОбъединитьПути(КаталогВыгрузки, "МояОбработка.epf"), Неопределено);
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().СобратьВнешнююОбработкуИзФайлов(
		Любое, Данные.ФайлОтчета, ОбъединитьПути(КаталогВыгрузки, "МойОтчет.erf"), Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_БроситьИсключение_ЕслиРекурсивноНичегоНеНайдено() Экспорт

	Ожидаем.Что(Сервис).Метод("СобратьОбработкиРекурсивно", ТестовыеДанные.Массив(ДанныеОбработок.ПустойКаталог()))
		.ВыбрасываетИсключение("не найдено XML-файлов внешних обработок");
	Стенд.ПроверитьЧтоНеВызывался("ДвижокКонфигуратор", "СоздатьВременнуюБазу");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОчиститьВременнуюБазу_ПриОшибкеРекурсивнойСборки() Экспорт

	// Дано
	Данные = ДанныеОбработок.КаталогСНесколькимиОбработками(2);
	КаталогВременной = ВременныеФайлы.СоздатьКаталог();
	Конфигуратор.Когда().СоздатьВременнуюБазу(Любое).ТогдаВозвращает(ТестовыеДанные.Файловая(КаталогВременной));
	Конфигуратор.Когда().СобратьВнешнююОбработкуИзФайлов(Любое, Любое, Любое, Любое).ТогдаВыбрасываетИсключение("Сборка упала");

	// Когда / Тогда
	Ожидаем.Что(Сервис).Метод("СобратьОбработкиРекурсивно", ТестовыеДанные.Массив(Данные.Каталог))
		.ВыбрасываетИсключение("Сборка упала");
	Ожидаем.Что(ТестовыеФайлы.Существует(КаталогВременной), "временная база удалена").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область РазобратьОбработку

&Тест
Процедура ТестДолжен_РазобратьEpfВКаталог_СоздавВременнуюБазу() Экспорт

	// Дано
	Epf = ДанныеОбработок.ВременныйEpf("ТестОбработка");

	// Когда
	Сервис.РазобратьОбработку(Epf.ПутьКФайлу);

	// Тогда - каталог разборки рядом с EPF, по имени без расширения
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().СоздатьВременнуюБазу(Неопределено);
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().РазобратьВнешнююОбработкуВФайлы(
		Любое, Epf.ПутьКФайлу, ОбъединитьПути(Epf.Каталог, "ТестОбработка"), Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазобратьEpf_ВУказанныйКаталог() Экспорт

	// Дано
	Epf = ДанныеОбработок.ВременныйEpf("МояОбр");
	КаталогВыгрузки = ВременныеФайлы.СоздатьКаталог();

	// Когда
	Сервис.РазобратьОбработку(Epf.ПутьКФайлу, КаталогВыгрузки);

	// Тогда
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().РазобратьВнешнююОбработкуВФайлы(
		Любое, Epf.ПутьКФайлу, ОбъединитьПути(КаталогВыгрузки, "МояОбр"), Неопределено);

