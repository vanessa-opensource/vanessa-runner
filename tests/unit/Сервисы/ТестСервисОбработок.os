КонецПроцедуры

&Тест
Процедура ТестДолжен_ОчиститьВременнуюБазу_ПриОшибкеРазборки() Экспорт

	// Дано
	Epf = ДанныеОбработок.ВременныйEpf();
	КаталогВременной = ВременныеФайлы.СоздатьКаталог();
	Конфигуратор.Когда().СоздатьВременнуюБазу(Любое).ТогдаВозвращает(ТестовыеДанные.Файловая(КаталогВременной));
	Конфигуратор.Когда().РазобратьВнешнююОбработкуВФайлы(Любое, Любое, Любое, Любое).ТогдаВыбрасываетИсключение("Разборка упала");

	// Когда / Тогда
	Ожидаем.Что(Сервис).Метод("РазобратьОбработку", ТестовыеДанные.Массив(Epf.ПутьКФайлу)).ВыбрасываетИсключение("Разборка упала");
	Ожидаем.Что(ТестовыеФайлы.Существует(КаталогВременной), "временная база удалена").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область РазобратьОбработкиИзКаталога

&Тест
Процедура ТестДолжен_РазобратьВсеEpfИзКаталога() Экспорт

	// Дано
	Данные = ДанныеОбработок.КаталогСНесколькимиEpf(2);

	// Когда
	Сервис.РазобратьОбработкиИзКаталога(Данные.Каталог);

	// Тогда - по разборке на каждый файл в одной временной базе
	Ожидаем.Что(Стенд.Вызовы("ДвижокКонфигуратор", "РазобратьВнешнююОбработкуВФайлы")).ИмеетДлину(2);
	Ожидаем.Что(Стенд.Вызовы("ДвижокКонфигуратор", "СоздатьВременнуюБазу")).ИмеетДлину(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазобратьИEpfИErfИзКаталога() Экспорт

	// Дано - в каталоге и обработка, и внешний отчёт
	Данные = ДанныеОбработок.КаталогСФайламиОбработкиИОтчета("МояОбработка", "МойОтчет");
	КаталогВыгрузки = ВременныеФайлы.СоздатьКаталог();

	// Когда
	Сервис.РазобратьОбработкиИзКаталога(Данные.Каталог, Ложь, КаталогВыгрузки);

	// Тогда - разобраны оба файла, каждый в каталог по своему имени
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().РазобратьВнешнююОбработкуВФайлы(
		Любое, Данные.ФайлОбработки, ОбъединитьПути(КаталогВыгрузки, "МояОбработка"), Неопределено);
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().РазобратьВнешнююОбработкуВФайлы(
		Любое, Данные.ФайлОтчета, ОбъединитьПути(КаталогВыгрузки, "МойОтчет"), Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_БроситьИсключение_ЕслиВКаталогеНетEpf() Экспорт

	Ожидаем.Что(Сервис).Метод("РазобратьОбработкиИзКаталога", ТестовыеДанные.Массив(ДанныеОбработок.ПустойКаталог()))
		.ВыбрасываетИсключение("не найдено файлов обработок");
	Стенд.ПроверитьЧтоНеВызывался("ДвижокКонфигуратор", "СоздатьВременнуюБазу");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИспользоватьВнешнееПодключение_БезСозданияВременной() Экспорт

	// Дано
	Данные = ДанныеОбработок.КаталогСНесколькимиEpf(1);
	ВнешняяБаза = ТестовыеДанные.Файловая("external");

	// Когда
	Сервис.РазобратьОбработкиИзКаталога(Данные.Каталог, Ложь, "", Ложь, Неопределено, ВнешняяБаза);

	// Тогда - внешняя база использована напрямую
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().РазобратьВнешнююОбработкуВФайлы(ВнешняяБаза, Данные.Файлы[0], Любое, Неопределено);
	Стенд.ПроверитьЧтоНеВызывался("ДвижокКонфигуратор", "СоздатьВременнуюБазу");

КонецПроцедуры

#КонецОбласти

#Область КонвертироватьПроектEDT

&Тест
Процедура ТестДолжен_ДелегироватьКонвертациюВнешнихОбъектов_ВСервисEDT() Экспорт

	// Дано
	ПараметрыEDT = ТестовыеДанные.ПараметрыИсходников("edt", "2024.1");
	РезультатEDT = Новый Структура("ИсходныйФормат, ЦелевойФормат, Количество", "edt", "xml", 2);
	EDT.Когда().КонвертироватьВнешниеОбъекты(Любое, Любое, Любое).ТогдаВозвращает(РезультатEDT);

	// Когда
	Результат = Сервис.КонвертироватьПроектEDT("src", "out", ПараметрыEDT);

	// Тогда
	Ожидаем.Что(Результат.Количество, "возвращено число объектов").Равно(2);
	Ожидаем.Что(Результат.ИсходныйФормат).Равно("edt");
	Ожидаем.Что(Результат.ЦелевойФормат).Равно("xml");
	EDT.ПроверитьЧтоВызывалсяМетод().КонвертироватьВнешниеОбъекты("src", "out", ПараметрыEDT);

КонецПроцедуры

&Тест
Процедура ТестДолжен_БроситьИсключение_ЕслиНеУказанКаталогНазначения() Экспорт

	Ожидаем.Что(Сервис).Метод("КонвертироватьПроектEDT", ТестовыеДанные.Массив("src", ""))
		.ВыбрасываетИсключение("Не указан каталог назначения");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПроброситьОшибкуКонвертацииEDT() Экспорт

	// Дано
	EDT.Когда().КонвертироватьВнешниеОбъекты(Любое, Любое, Любое).ТогдаВыбрасываетИсключение("Конвертация EDT упала");

	// Когда / Тогда
	Ожидаем.Что(Сервис).Метод("КонвертироватьПроектEDT", ТестовыеДанные.Массив("src", "out"))
		.ВыбрасываетИсключение("Конвертация EDT упала");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Источник считается EDT-проектом, экспорт которого дал перечисленные XML-файлы.
Процедура ЭкспортEDTВозвращает(Знач ПутиXml)

	Файлы = Новый Массив;
	Для Каждого Путь Из ПутиXml Цикл
		Файлы.Добавить(Новый Файл(Путь));
	КонецЦикла;
	EDT.Когда().ЭтоПроектВнешнихОбъектовEDT(Любое, Любое).ТогдаВозвращает(Истина);
	EDT.Когда().ЭкспортироватьВнешниеОбъекты(Любое, Любое, Любое).ТогдаВозвращает(Файлы);

КонецПроцедуры

// Сборка из EDT-проекта "edt-project" (до диска не доходит: экспорт застаблен) в заданный каталог.
Процедура СобратьИзПроектаEDT(Знач КаталогOut)
	Сервис.СобратьОбработку("edt-project", КаталогOut, Ложь, Неопределено, Неопределено, ТестовыеДанные.ПараметрыИсходников("edt"));
КонецПроцедуры

#КонецОбласти
