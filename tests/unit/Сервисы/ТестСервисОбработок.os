КонецПроцедуры

&Тест
Процедура ТестДолжен_ИспользоватьВнешнееПодключение_БезСозданияВременной() Экспорт

	// Дано
	Данные = Обработки.КаталогСНесколькимиEpf(1);
	МокДвижок = Мок.Получить(Новый ДвижокКонфигуратор);
	ВнешниеПараметры = Подключения.Файловая("C:\external");

	Сервис = Новый БилдерСервисаОбработок().СОдинаковымДвижком(МокДвижок).Собрать();

	// Когда
	Сервис.РазобратьОбработкиИзКаталога(Данные.Каталог, Ложь, "", Ложь, Неопределено, ВнешниеПараметры);

	// Тогда - внешняя база использована напрямую (если бы создавалась временная,
	// СоздатьВременнуюБазу вернула бы Неопределено и тест упал бы при доступе к КаталогБазы).
	МокДвижок.ПроверитьЧтоВызывалсяМетод().РазобратьВнешнююОбработкуВФайлы(Любое, Любое, Любое, Любое);

КонецПроцедуры

#КонецОбласти

#Область КонвертироватьПроектEDT

&Тест
Процедура ТестДолжен_ДелегироватьКонвертациюВнешнихОбъектовВСервисEDT() Экспорт

	КаталогНазначения = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "out");
	ПараметрыEDT = Новый Структура("Формат, Версия, Workspace", "edt", "2024.1", "");
	РезультатEDT = Новый Структура("ИсходныйФормат, ЦелевойФормат, Количество", "edt", "xml", 2);

	МокEDT = Мок.Получить(Новый СервисEDT);
	МокEDT.Когда().КонвертироватьВнешниеОбъекты(Любое, Любое, Любое).ТогдаВозвращает(РезультатEDT);
	Сервис = Новый БилдерСервисаОбработок().СEDT(МокEDT).Собрать();

	Результат = Сервис.КонвертироватьПроектEDT("C:\src", КаталогНазначения, ПараметрыEDT);

	Ожидаем.Что(Результат.Количество, "возвращено число объектов").Равно(2);
	Ожидаем.Что(Результат.ИсходныйФормат).Равно("edt");
	Ожидаем.Что(Результат.ЦелевойФормат).Равно("xml");
	МокEDT.ПроверитьЧтоВызывалсяМетод().КонвертироватьВнешниеОбъекты("C:\src", КаталогНазначения, ПараметрыEDT);

КонецПроцедуры

