// BSLLS-off
// Юнит-тесты СервисОбработок.
// Реальные движки (v8runner, ibcmd) не вызываются - все взаимодействия замоканы.
// Покрытие: оркестрация сборки/разборки EPF, поиск XML, выбор каталога выгрузки,
// очистка временной базы при ошибках, рекурсивный обход.

#Использовать asserts
#Использовать moskito
#Использовать tempfiles

#Использовать "../../../src/core/Движки"
#Использовать "../../../src/core/Сервисы"
#Использовать "../utils"

Перем Подключения;
Перем Обработки;
Перем Любое;

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	Подключения = Новый ДанныеПодключений;
	Обработки = Новый ДанныеОбработок;
	Любое = Матчеры.ЛюбоеЗначение();
КонецПроцедуры

#Область СобратьОбработку

&Тест
Процедура ТестДолжен_СобратьОбработкуИзКаталога_СоздавВременнуюБазуЕслиНетПодключения() Экспорт

	// Дано
	КаталогДанные = Обработки.КаталогСОбработкой("МояОбработка");
	МокДвижок = Мок.Получить(Новый ДвижокКонфигуратор);
	МокДвижок.Когда().СоздатьВременнуюБазу(Любое)
		.ТогдаВозвращает(Подключения.Файловая(ВременныеФайлы.СоздатьКаталог()));

	Сервис = Новый БилдерСервисаОбработок()
		.СОдинаковымДвижком(МокДвижок)
		.Собрать();

	// Когда
	Сервис.СобратьОбработку(КаталогДанные.Каталог);

	// Тогда
	МокДвижок.ПроверитьЧтоВызывалсяМетод().СоздатьВременнуюБазу(Любое);
	МокДвижок.ПроверитьЧтоВызывалсяМетод().СобратьВнешнююОбработкуИзФайлов(Любое, КаталогДанные.ФайлXml, Любое, Любое);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СобратьОбработку_УказанныйКаталогВыгрузки() Экспорт

	// Дано
	КаталогДанные = Обработки.КаталогСОбработкой("МояОбработка");
	КаталогВыгрузки = ВременныеФайлы.СоздатьКаталог();
	ОжидаемыйПуть = ОбъединитьПути(КаталогВыгрузки, "МояОбработка.epf");

	МокДвижок = Мок.Получить(Новый ДвижокКонфигуратор);
	МокДвижок.Когда().СоздатьВременнуюБазу(Любое)
		.ТогдаВозвращает(Подключения.Файловая(ВременныеФайлы.СоздатьКаталог()));

	Сервис = Новый БилдерСервисаОбработок().СОдинаковымДвижком(МокДвижок).Собрать();

	// Когда
	Сервис.СобратьОбработку(КаталогДанные.Каталог, КаталогВыгрузки);

	// Тогда
	МокДвижок.ПроверитьЧтоВызывалсяМетод().СобратьВнешнююОбработкуИзФайлов(Любое, Любое, ОжидаемыйПуть, Любое);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыброситьИсключение_ЕслиВКаталогеНетXml() Экспорт

	// Дано
	ПустойКаталог = Обработки.ПустойКаталог();
	МокДвижок = Мок.Получить(Новый ДвижокКонфигуратор);
	Сервис = Новый БилдерСервисаОбработок().СОдинаковымДвижком(МокДвижок).Собрать();

	// Когда / Тогда
	Попытка
		Сервис.СобратьОбработку(ПустойКаталог);
		ВызватьИсключение "Должно было выброситься исключение";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("не найден XML-файл внешней обработки");
	КонецПопытки;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОчиститьВременнуюБазуПриОшибкеСборки() Экспорт

	// Дано
	КаталогДанные = Обработки.КаталогСОбработкой();
	КаталогВременнойБазы = ВременныеФайлы.СоздатьКаталог();
	МокДвижок = Мок.Получить(Новый ДвижокКонфигуратор);
	МокДвижок.Когда().СоздатьВременнуюБазу(Любое)
		.ТогдаВозвращает(Подключения.Файловая(КаталогВременнойБазы));
	МокДвижок.Когда().СобратьВнешнююОбработкуИзФайлов(Любое, Любое, Любое, Любое)
		.ТогдаВыбрасываетИсключение("Сборка упала");

	Сервис = Новый БилдерСервисаОбработок().СОдинаковымДвижком(МокДвижок).Собрать();

	// Когда / Тогда
	Попытка
		Сервис.СобратьОбработку(КаталогДанные.Каталог);
		ВызватьИсключение "Должно было выброситься исключение";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("Сборка упала");
	КонецПопытки;

	Ожидаем.Что(Новый Файл(КаталогВременнойБазы).Существует(), "временная база удалена").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область СобратьОбработкиРекурсивно

&Тест
Процедура ТестДолжен_СобратьВсеОбработкиИзПодкаталогов() Экспорт

	// Дано
	КаталогДанные = Обработки.КаталогСНесколькимиОбработками(3);
	МокДвижок = Мок.Получить(Новый ДвижокКонфигуратор);
	МокДвижок.Когда().СоздатьВременнуюБазу(Любое)
		.ТогдаВозвращает(Подключения.Файловая(ВременныеФайлы.СоздатьКаталог()));

	Сервис = Новый БилдерСервисаОбработок().СОдинаковымДвижком(МокДвижок).Собрать();

	// Когда
	Сервис.СобратьОбработкиРекурсивно(КаталогДанные.Каталог);

	// Тогда - движок вызван 3 раза (по разу на каждую найденную обработку)
	МокДвижок.ПроверитьЧтоВызывалсяМетод().СобратьВнешнююОбработкуИзФайлов(Любое, Любое, Любое, Любое);
	// (moskito не считает количество вызовов, поэтому проверяем минимум один; полнота - через успешное завершение)

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыброситьИсключение_ЕслиРекурсивноНичегоНеНайдено() Экспорт

	// Дано
	ПустойКаталог = Обработки.ПустойКаталог();
	МокДвижок = Мок.Получить(Новый ДвижокКонфигуратор);
	Сервис = Новый БилдерСервисаОбработок().СОдинаковымДвижком(МокДвижок).Собрать();

	// Когда / Тогда
	Попытка
		Сервис.СобратьОбработкиРекурсивно(ПустойКаталог);
		ВызватьИсключение "Должно было выброситься исключение";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("не найдено XML-файлов внешних обработок");
	КонецПопытки;

КонецПроцедуры

