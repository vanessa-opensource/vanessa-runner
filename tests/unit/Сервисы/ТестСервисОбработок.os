КонецПроцедуры

#КонецОбласти

#Область РазобратьОбработку

&Тест
Процедура ТестДолжен_РазобратьEpfВКаталог_СоздавВременнуюБазу() Экспорт

	// Дано
	EpfДанные = Обработки.ВременныйEpf("ТестОбработка");
	МокДвижок = Мок.Получить(Новый ДвижокКонфигуратор);
	МокДвижок.Когда().СоздатьВременнуюБазу(Любое)
		.ТогдаВозвращает(Подключения.Файловая(ВременныеФайлы.СоздатьКаталог()));

	Сервис = Новый БилдерСервисаОбработок().СОдинаковымДвижком(МокДвижок).Собрать();

	// Когда
	Сервис.РазобратьОбработку(EpfДанные.ПутьКФайлу);

	// Тогда - каталог разборки рядом с EPF, по имени без расширения
	ОжидаемыйКаталог = ОбъединитьПути(EpfДанные.Каталог, EpfДанные.ИмяБезРасширения);
	МокДвижок.ПроверитьЧтоВызывалсяМетод().РазобратьВнешнююОбработкуВФайлы(Любое, EpfДанные.ПутьКФайлу, ОжидаемыйКаталог, Любое);

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазобратьEpfВУказанныйКаталог() Экспорт

	// Дано
	EpfДанные = Обработки.ВременныйEpf("МояОбр");
	КаталогВыгрузки = ВременныеФайлы.СоздатьКаталог();
	ОжидаемыйКаталог = ОбъединитьПути(КаталогВыгрузки, "МояОбр");

	МокДвижок = Мок.Получить(Новый ДвижокКонфигуратор);
	МокДвижок.Когда().СоздатьВременнуюБазу(Любое)
		.ТогдаВозвращает(Подключения.Файловая(ВременныеФайлы.СоздатьКаталог()));

	Сервис = Новый БилдерСервисаОбработок().СОдинаковымДвижком(МокДвижок).Собрать();

	// Когда
	Сервис.РазобратьОбработку(EpfДанные.ПутьКФайлу, КаталогВыгрузки);

	// Тогда
	МокДвижок.ПроверитьЧтоВызывалсяМетод().РазобратьВнешнююОбработкуВФайлы(Любое, Любое, ОжидаемыйКаталог, Любое);

