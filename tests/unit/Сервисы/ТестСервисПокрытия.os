&Тест
Процедура ТестДолжен_ПрочитатьИмяРасширения_ИзXMLДескриптора() Экспорт

	Каталог = ВременныеФайлы.СоздатьКаталог();
	ЗаписатьФайл(Каталог, "Configuration.xml",
		"<MetaDataObject><Configuration uuid=""x""><Name>МоеРасширение</Name></Configuration></MetaDataObject>");

	Ожидаем.Что(Сервис.ОпределитьИмяРасширения(Каталог, "XML")).Равно("МоеРасширение");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПрочитатьИмяРасширения_ИзEDTДескриптора() Экспорт

	Каталог = ВременныеФайлы.СоздатьКаталог();
	КаталогMdo = ОбъединитьПути(Каталог, "src", "Configuration");
	СоздатьКаталог(КаталогMdo);
	ЗаписатьФайл(КаталогMdo, "Configuration.mdo",
		"<mdclass:Configuration><name>РасширениеEDT</name></mdclass:Configuration>");

	Ожидаем.Что(Сервис.ОпределитьИмяРасширения(Каталог, "EDT")).Равно("РасширениеEDT");

КонецПроцедуры

