&Тест
Процедура ТестДолжен_ИзвлечьИмяИБ_ИзСерверногоПодключенияСоСлешем() Экспорт
	Подключение = ТестовыеДанные.Подключение("/Ssrv/base1");
	Ожидаем.Что(Сервис.ОпределитьАлиас(Подключение, "")).Равно("base1");
КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьАлиасПоУмолчанию_ДляФайловойИБ() Экспорт
	Ожидаем.Что(Сервис.ОпределитьАлиас(ТестовыеДанные.Файловая("base"), "")).Равно("DefAlias");
КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьАлиасПоУмолчанию_БезПараметровПодключения() Экспорт
	Ожидаем.Что(Сервис.ОпределитьАлиас(Неопределено, "")).Равно("DefAlias");
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Параметры покрытия с безопасными для тестов путями: каталог исходников не существует,
// чтобы сервис не сканировал реальный src рабочего каталога.
Функция НовыеПараметрыПокрытия()

	Параметры = Новый Структура;
	Параметры.Вставить("ПутьОтчета", ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "coverage.xml"));
	Параметры.Вставить("СерверОтладки", "");
	Параметры.Вставить("ПутьКСерверуОтладки", "");
	Параметры.Вставить("ПарольОтладки", "");
	Параметры.Вставить("АлиасИБ", "");
	Параметры.Вставить("КаталогИсходников", ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "нет-исходников"));
	Параметры.Вставить("КаталогиРасширений", Новый Массив);
	Параметры.Вставить("РассчитыватьПокрываемыеСтроки", Ложь);
	Параметры.Вставить("ФорматОтчета", "genericCoverage");
	Возврат Параметры;

КонецФункции

// Число вызовов метода стаба coveragebsl (менеджер и сессия).
Функция КоличествоВызовов(Знач Метод)
	Количество = 0;
	Для Каждого Вызов Из Менеджер.Вызовы Цикл
		Количество = Количество + ?(Вызов.Метод = Метод, 1, 0);
	КонецЦикла;
	Возврат Количество;
КонецФункции

Функция ДескрипторXML(Знач Имя)
	Возврат СтрШаблон("<MetaDataObject><Configuration uuid=""x""><Name>%1</Name></Configuration></MetaDataObject>", Имя);
КонецФункции

#КонецОбласти
