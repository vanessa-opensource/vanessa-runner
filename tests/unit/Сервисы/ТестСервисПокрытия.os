// BSLLS-off
// Юнит-тесты СервисПокрытия: разбор адреса сервера отладки, жизненный цикл сеанса сбора,
// алиас ИБ, имя расширения и корень проекта для отчёта.
// coveragebsl подменён МенеджерПокрытияСтаб; сервер отладки и покрываемые строки - моки.

#Использовать asserts
#Использовать moskito
#Использовать tempfiles
#Использовать "../utils"

Перем Стенд;
Перем Сервис;
Перем Поиск;         // реальный СервисПоискаИсточников: каталог исходников в тестах не существует
Перем Менеджер;      // МенеджерПокрытияСтаб: фабрика, менеджер и сессия coveragebsl в одном объекте
Перем СерверОтладки; // мок СервисСервераОтладки
Перем АдресСервера;
Перем Любое;

&ПередКаждым
Процедура ПередКаждым() Экспорт
	Стенд = Новый Стенд;
	Стенд.Реальный("ФайловыеОперации");
	Стенд.Реальный("СервисАвтономногоСервера"); // только ИмяИБПоУмолчанию()
	Поиск = Стенд.Реальный("СервисПоискаИсточников");
	Менеджер = Стенд.Подменить("_ФабрикаCoveragebsl", Новый МенеджерПокрытияСтаб);
	Сервис = Стенд.Сервис("СервисПокрытия");
	Любое = Матчеры.ЛюбоеЗначение();
	АдресСервера = "http://127.0.0.1:1550";
	СерверОтладки = Стенд.Мок("СервисСервераОтладки");
	СерверОтладки.Когда().НовыеПараметрыСервера().ТогдаВозвращает(Новый Структура(
		"Хост, Порт, ПутьКDBGS, ВерсияПлатформы, ПодключитьсяКСуществующему, Пароль", "", 0, "", "", Ложь, ""));
	СерверОтладки.Когда().ЗапуститьСервер(Любое).ТогдаВозвращает(Новый Структура("Адрес", АдресСервера));
КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт
	ВременныеФайлы.Удалить();
КонецПроцедуры

#Область НачатьСеанс

&Тест
Процедура ТестДолжен_НачатьСеанс_ИВернутьАргументыОтладки() Экспорт

	Контекст = Сервис.НачатьСеанс(НовыеПараметрыПокрытия(), Новый Структура);

	Ожидаем.Что(Контекст.Активен).ЭтоИстина();
	Ожидаем.Что(Контекст.АргументыОтладки).Равно("/Debug -http -attach /DEBUGGERURL " + АдресСервера);
	Ожидаем.Что(Менеджер.Алиас_, "алиас по умолчанию").Равно("DefAlias");
	Ожидаем.Что(КоличествоВызовов("НачатьСборПокрытия"), "сбор начат").Равно(1);
	Стенд.ПроверитьЧтоНеВызывался("СервисПокрываемыхСтрок", "ОбеспечитьУстановку");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПередатьЯвныйАлиас_ВСессию() Экспорт

	Параметры = НовыеПараметрыПокрытия();
	Параметры.АлиасИБ = "МояБаза";

	Сервис.НачатьСеанс(Параметры, Новый Структура);

	Ожидаем.Что(Менеджер.Алиас_).Равно("МояБаза");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПередатьВерсиюПлатформы_СерверуОтладки() Экспорт

	ПараметрыПлатформы = Новый Структура("ВерсияПлатформы", "8.3.25.100");

	Сервис.НачатьСеанс(НовыеПараметрыПокрытия(), Новый Структура, ПараметрыПлатформы);

	ПараметрыСервера = Стенд.Вызовы("СервисСервераОтладки", "ЗапуститьСервер")[0].ПараметрыСервера;
	Ожидаем.Что(ПараметрыСервера.ВерсияПлатформы).Равно("8.3.25.100");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОстановитьСервер_ЕслиСессияНеОткрылась() Экспорт

	Менеджер.СБросанием("НоваяСессияПокрытия");

	Ожидаем.Что(Сервис).Метод("НачатьСеанс", ТестовыеДанные.Массив(НовыеПараметрыПокрытия(), Новый Структура))
		.ВыбрасываетИсключение("Не удалось начать сбор покрытия");
	СерверОтладки.ПроверитьЧтоВызывалсяМетод().ОстановитьСервер();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗапроситьУстановкуРасчетаПокрываемых() Экспорт

	Параметры = НовыеПараметрыПокрытия();
	Параметры.РассчитыватьПокрываемыеСтроки = Истина;

	Контекст = Сервис.НачатьСеанс(Параметры, Новый Структура);

	Стенд.Мок("СервисПокрываемыхСтрок").ПроверитьЧтоВызывалсяМетод().ОбеспечитьУстановку();
	// Каталогов исходников нет - расчёт не стартует.
	Ожидаем.Что(Контекст.ЗаданиеПокрываемых).Равно(Неопределено);
	Стенд.ПроверитьЧтоНеВызывался("СервисПокрываемыхСтрок", "ЗапуститьФоновыйРасчет");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗапуститьФоновыйРасчет_ПоКаталогамРасширений() Экспорт

	// Дано
	Задание = Новый Структура("Метка", "задание");
	Стенд.Мок("СервисПокрываемыхСтрок").Когда().ЗапуститьФоновыйРасчет(Любое, Любое).ТогдаВозвращает(Задание);
	КаталогРасширения = ВременныеФайлы.СоздатьКаталог();
	Параметры = НовыеПараметрыПокрытия();
	Параметры.РассчитыватьПокрываемыеСтроки = Истина;
	Параметры.КаталогиРасширений.Добавить(КаталогРасширения);

	// Когда
	Контекст = Сервис.НачатьСеанс(Параметры, Новый Структура);

	// Тогда
	Каталоги = Стенд.Вызовы("СервисПокрываемыхСтрок", "ЗапуститьФоновыйРасчет")[0].КаталогиИсходников;
	Ожидаем.Что(Каталоги).ИмеетДлину(1);
	Ожидаем.Что(Каталоги[0]).Равно(Новый Файл(КаталогРасширения).ПолноеИмя);
	Ожидаем.Что(Контекст.ЗаданиеПокрываемых).Равно(Задание);

КонецПроцедуры

#КонецОбласти

#Область ЗавершитьСеанс

&Тест
Процедура ТестДолжен_ПропуститьЗавершение_НеактивногоКонтекста() Экспорт

	Сервис.ЗавершитьСеанс(Неопределено);
	Сервис.ЗавершитьСеанс(Новый Структура("Активен", Ложь));

	Ожидаем.Что(КоличествоВызовов("ЗавершитьСборПокрытия"), "сбор не завершался").Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПредупредитьИНеСформироватьОтчет_БезИсточников() Экспорт

	Параметры = НовыеПараметрыПокрытия();
	Контекст = Сервис.НачатьСеанс(Параметры, Новый Структура);

	Сервис.ЗавершитьСеанс(Контекст);

	Ожидаем.Что(Контекст.Активен, "контекст погашен").ЭтоЛожь();
	Ожидаем.Что(КоличествоВызовов("ЗавершитьСборПокрытия")).Равно(1);
	Ожидаем.Что(КоличествоВызовов("Отключить"), "сессия отключена").Равно(1);
	СерверОтладки.ПроверитьЧтоВызывалсяМетод().ОстановитьСервер();
	Ожидаем.Что(ТестовыеФайлы.Существует(Параметры.ПутьОтчета), "отчёт не сформирован").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОстановитьСервер_ПриОшибкеЗавершенияСбора() Экспорт

	Контекст = Сервис.НачатьСеанс(НовыеПараметрыПокрытия(), Новый Структура);
	Менеджер.СБросанием("ЗавершитьСборПокрытия");

	Ожидаем.Что(Сервис).Метод("ЗавершитьСеанс", ТестовыеДанные.Массив(Контекст))
		.ВыбрасываетИсключение("Не удалось завершить сбор покрытия");
	СерверОтладки.ПроверитьЧтоВызывалсяМетод().ОстановитьСервер();

КонецПроцедуры

#КонецОбласти

#Область ПрерватьСеанс

&Тест
Процедура ТестДолжен_ПрерватьСеанс_ИОстановитьСервер() Экспорт

	Контекст = Сервис.НачатьСеанс(НовыеПараметрыПокрытия(), Новый Структура);

	Сервис.ПрерватьСеанс(Контекст);
	Сервис.ПрерватьСеанс(Контекст); // повтор гасится по флагу Активен

	Ожидаем.Что(Контекст.Активен).ЭтоЛожь();
	Ожидаем.Что(КоличествоВызовов("Отключить"), "отключение однократное").Равно(1);
	Ожидаем.Что(Стенд.Вызовы("СервисСервераОтладки", "ОстановитьСервер"), "остановка однократная").ИмеетДлину(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПроглотитьОшибкуОтключения_ПриПрерывании() Экспорт

	Контекст = Сервис.НачатьСеанс(НовыеПараметрыПокрытия(), Новый Структура);
	Менеджер.СБросанием("Отключить");

	Сервис.ПрерватьСеанс(Контекст);

	СерверОтладки.ПроверитьЧтоВызывалсяМетод().ОстановитьСервер(); // несмотря на ошибку отключения

КонецПроцедуры

#КонецОбласти

#Область ВычислитьКореньПроекта

&Тест
Процедура ТестДолжен_НайтиОбщийКорень_КаталоговИсходников() Экспорт

	База = ВременныеФайлы.СоздатьКаталог();
	Каталоги = ТестовыеДанные.Массив(ТестовыеФайлы.Путь(База, "конфигурация"), ТестовыеФайлы.Путь(База, "расширение"));

	Корень = Сервис.ВычислитьКореньПроекта(Новый Соответствие, Каталоги);

	Ожидаем.Что(Корень).Равно(Новый Файл(База).ПолноеИмя);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВзятьКорень_ИзПутейПокрытия_ЕслиКаталоговНет() Экспорт

	База = ВременныеФайлы.СоздатьКаталог();
	Покрытие = Новый Соответствие;
	Покрытие.Вставить(ТестовыеФайлы.Путь(База, "Модуль1.os"), Новый Соответствие);
	Покрытие.Вставить(ТестовыеФайлы.Путь(База, "Модуль2.os"), Новый Соответствие);

	Корень = Сервис.ВычислитьКореньПроекта(Покрытие, Новый Массив);

	Ожидаем.Что(Корень).Равно(Новый Файл(ТестовыеФайлы.Путь(База, "Модуль1.os")).Путь);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОткатитьсяНаТекущийКаталог_БезДанных() Экспорт

	Корень = Сервис.ВычислитьКореньПроекта(Новый Соответствие, Новый Массив);

	Ожидаем.Что(Корень).Равно(Новый Файл(ТекущийКаталог()).ПолноеИмя);

КонецПроцедуры

#КонецОбласти

#Область РазобратьАдресСервера

&Тест
Процедура ТестДолжен_ПоднятьЛокально_ЕслиАдресПуст() Экспорт

	Адрес = Сервис.РазобратьАдресСервера("");

	Ожидаем.Что(Адрес.Подключиться, "локальный старт").ЭтоЛожь();
	Ожидаем.Что(Адрес.Хост, "хост").Равно("127.0.0.1");
	Ожидаем.Что(Адрес.Порт, "порт по умолчанию (0)").Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПоднятьЛокально_НаУказанномПорту() Экспорт

	Адрес = Сервис.РазобратьАдресСервера("9000");

	Ожидаем.Что(Адрес.Подключиться, "локальный старт").ЭтоЛожь();
	Ожидаем.Что(Адрес.Хост, "хост").Равно("127.0.0.1");
	Ожидаем.Что(Адрес.Порт, "порт").Равно(9000);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПоднятьЛокально_ДляФормыДвоеточиеПорт() Экспорт

	Адрес = Сервис.РазобратьАдресСервера(":9000");

	Ожидаем.Что(Адрес.Подключиться, "локальный старт").ЭтоЛожь();
	Ожидаем.Что(Адрес.Порт, "порт").Равно(9000);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПодключитьсяКУдаленному_ХостПорт() Экспорт

	Адрес = Сервис.РазобратьАдресСервера("build-agent:9000");

	Ожидаем.Что(Адрес.Подключиться, "подключение").ЭтоИстина();
	Ожидаем.Что(Адрес.Хост, "хост").Равно("build-agent");
	Ожидаем.Что(Адрес.Порт, "порт").Равно(9000);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПодключитьсяКХосту_БезПорта() Экспорт

	Адрес = Сервис.РазобратьАдресСервера("build-agent");

	Ожидаем.Что(Адрес.Подключиться, "подключение").ЭтоИстина();
	Ожидаем.Что(Адрес.Хост, "хост").Равно("build-agent");
	Ожидаем.Что(Адрес.Порт, "порт по умолчанию (0)").Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПодключитьсяКЛокальномуЗапущенному_ЕслиУказанХост() Экспорт

	// Явный локальный хост - подключение к уже запущенному (в отличие от голого порта).
	Адрес = Сервис.РазобратьАдресСервера("127.0.0.1:1550");

	Ожидаем.Что(Адрес.Подключиться, "подключение к локальному").ЭтоИстина();
	Ожидаем.Что(Адрес.Хост, "хост").Равно("127.0.0.1");
	Ожидаем.Что(Адрес.Порт, "порт").Равно(1550);

КонецПроцедуры

#КонецОбласти

#Область ОпределитьИмяРасширения

&Тест
Процедура ТестДолжен_ПрочитатьИмяРасширения_ИзXMLДескриптора() Экспорт

	Каталог = ВременныеФайлы.СоздатьКаталог();
	ТестовыеФайлы.Файл(Каталог, "Configuration.xml", ДескрипторXML("МоеРасширение"));

	Ожидаем.Что(Сервис.ОпределитьИмяРасширения(Поиск.Описать(Каталог))).Равно("МоеРасширение");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПрочитатьИмяРасширения_ДескрипторОткрытДругимЧитателем() Экспорт

	Каталог = ВременныеФайлы.СоздатьКаталог();
	ТестовыеФайлы.Файл(Каталог, "Configuration.xml", ДескрипторXML("МоеРасширение"));
	Источник = Поиск.Описать(Каталог);

	Поток = Новый ФайловыйПоток(Источник.Дескриптор, РежимОткрытияФайла.Открыть, ДоступКФайлу.Чтение);
	Имя = Сервис.ОпределитьИмяРасширения(Источник);
	Поток.Закрыть();

	Ожидаем.Что(Имя).Равно("МоеРасширение");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПрочитатьИмяРасширения_ИзEDTДескриптора() Экспорт

	Каталог = ТестовыеФайлы.КаталогEDT();
	ТестовыеФайлы.Файл(Каталог, "src/Configuration/Configuration.mdo",
		"<mdclass:Configuration><name>РасширениеEDT</name></mdclass:Configuration>");

	Ожидаем.Что(Сервис.ОпределитьИмяРасширения(Поиск.Описать(Каталог))).Равно("РасширениеEDT");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВзятьИмяКаталога_БезДескриптора() Экспорт

	Каталог = ВременныеФайлы.СоздатьКаталог();

	Ожидаем.Что(Сервис.ОпределитьИмяРасширения(Поиск.Описать(Каталог))).Равно(Новый Файл(Каталог).Имя);

КонецПроцедуры

#КонецОбласти

#Область ОпределитьАлиас

