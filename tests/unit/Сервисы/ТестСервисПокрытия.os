Процедура ТестДолжен_ОпределитьXMLФормат_ПоConfigurationXml() Экспорт

	Каталог = ВременныеФайлы.СоздатьКаталог();
	ЗаписатьФайл(Каталог, "Configuration.xml", "<Configuration><Name>Каркас</Name></Configuration>");

