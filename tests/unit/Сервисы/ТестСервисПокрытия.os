#КонецОбласти

#Область КореньПроекта

&Тест
Процедура ТестДолжен_НайтиОбщийКорень_КаталоговИсходников() Экспорт

	База = ВременныеФайлы.СоздатьКаталог();
	Каталоги = Новый Массив;
	Каталоги.Добавить(СоздатьПодкаталог(База, "конфигурация"));
	Каталоги.Добавить(СоздатьПодкаталог(База, "расширение"));

	Корень = Сервис.ВычислитьКореньПроекта(Новый Соответствие, Каталоги);

	Ожидаем.Что(Корень).Равно(Новый Файл(База).ПолноеИмя);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВзятьКорень_ИзПутейПокрытия_ЕслиКаталоговНет() Экспорт

	База = ВременныеФайлы.СоздатьКаталог();
	Покрытие = Новый Соответствие;
	Покрытие.Вставить(ОбъединитьПути(База, "Модуль1.os"), Новый Соответствие);
	Покрытие.Вставить(ОбъединитьПути(База, "Модуль2.os"), Новый Соответствие);

	Корень = Сервис.ВычислитьКореньПроекта(Покрытие, Новый Массив);

	Ожидаем.Что(Корень).Равно(Новый Файл(ОбъединитьПути(База, "Модуль1.os")).Путь);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОткатитьсяНаТекущийКаталог_БезДанных() Экспорт

	Корень = Сервис.ВычислитьКореньПроекта(Новый Соответствие, Новый Массив);

	Ожидаем.Что(Корень).Равно(Новый Файл(ТекущийКаталог()).ПолноеИмя);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт

	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();

	Менеджер = Новый МенеджерПокрытияСтаб;
	СерверОтладки = Новый СерверОтладкиСтаб;
	ПокрываемыеСтроки = Новый ПокрываемыеСтрокиСтаб;

	Сервис = Новый СервисПокрытия;
	Рефлектор = Новый Рефлектор;
	Рефлектор.УстановитьСвойство(Сервис, "Лог", Логирование.ПолучитьЛог("vrunner"));
	Рефлектор.УстановитьСвойство(Сервис, "ФайловыеОперации", Новый ФайловыеОперации);
	Рефлектор.УстановитьСвойство(Сервис, "СервисСервераОтладки", СерверОтладки);
	Рефлектор.УстановитьСвойство(Сервис, "СервисПокрываемыхСтрок", ПокрываемыеСтроки);
	Рефлектор.УстановитьСвойство(Сервис, "_ФабрикаCoveragebsl", Менеджер);

КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Параметры покрытия с безопасными для тестов путями: каталог исходников не существует,
// чтобы сервис не сканировал реальный src рабочего каталога.
Функция НовыеПараметрыПокрытия()

	Параметры = Новый Структура;
	Параметры.Вставить("ПутьОтчета", ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "coverage.xml"));
	Параметры.Вставить("СерверОтладки", "");
	Параметры.Вставить("ПутьКСерверуОтладки", "");
	Параметры.Вставить("ПарольОтладки", "");
	Параметры.Вставить("АлиасИБ", "");
	Параметры.Вставить("КаталогИсходников", ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "нет-исходников"));
	Параметры.Вставить("КаталогиРасширений", Новый Массив);
	Параметры.Вставить("РассчитыватьПокрываемыеСтроки", Ложь);
	Параметры.Вставить("ФорматОтчета", "genericCoverage");
	Возврат Параметры;

КонецФункции

Функция Вызван(Знач Метод)
	Для Каждого Вызов Из Менеджер.Вызовы Цикл
		Если Вызов.Метод = Метод Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция КоличествоВызовов(Знач Метод)
	Количество = 0;
	Для Каждого Вызов Из Менеджер.Вызовы Цикл
		Если Вызов.Метод = Метод Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Количество;
КонецФункции

Процедура ЗаписатьФайл(Знач Каталог, Знач Имя, Знач Содержимое)
	Запись = Новый ЗаписьТекста(ОбъединитьПути(Каталог, Имя), КодировкаТекста.UTF8);
	Запись.Записать(Содержимое);
	Запись.Закрыть();
КонецПроцедуры

Функция СоздатьПодкаталог(Знач База, Знач Имя)
	Путь = ОбъединитьПути(База, Имя);
	СоздатьКаталог(Путь);
	Возврат Путь;
КонецФункции

#КонецОбласти
