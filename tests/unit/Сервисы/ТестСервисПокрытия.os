Процедура ТестДолжен_ПредпочестьЯвныйАлиас() Экспорт
	Подключение = ТестовыеДанные.Подключение("/S""srv\ib""");
	Ожидаем.Что(Сервис.ОпределитьАлиас(Подключение, "Явный")).Равно("Явный");
