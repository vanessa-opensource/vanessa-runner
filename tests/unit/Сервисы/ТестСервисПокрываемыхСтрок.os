// BSLLS-off
// Юнит-тесты СервисПокрываемыхСтрок: детектор установки (готовность образа) и чистые помощники
// (имя ассета, URL загрузки, разбор URL) - без сети и без запуска java. СервисОкружения - шпион.

#Использовать asserts
#Использовать tempfiles
#Использовать "../utils"

Перем Стенд;

&ПередКаждым
Процедура ПередКаждым() Экспорт
	Стенд = Новый Стенд;
КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт
	ВременныеФайлы.Удалить();
КонецПроцедуры

#Область Установлена

&Тест
Процедура ТестДолжен_СчитатьНеУстановленной_ЕслиОбразаНет() Экспорт

	Дом = ОбъединитьПути(ВременныеФайлы.НовоеИмяФайла(), "нет-такого-образа");

	Ожидаем.Что(Сервис(Дом).Установлена(), "не установлена без файлов").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_СчитатьУстановленной_ЕслиОбразГотов() Экспорт

	Образ = СоздатьФейковыйОбраз();

	Ожидаем.Что(Сервис(Образ).Установлена(), "установлена при валидном образе").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ИмяАссетаДляПлатформы

&Тест
Процедура ТестДолжен_ВернутьИмяАссета_ПоПлатформе() Экспорт

	Ожидаем.Что(Сервис().ИмяАссетаДляПлатформы("Windows_x86_64"), "windows").Равно("lines-to-cover-windows.zip");
	Ожидаем.Что(Сервис().ИмяАссетаДляПлатформы("Linux_x86_64"), "linux").Равно("lines-to-cover-linux.zip");
	Ожидаем.Что(Сервис().ИмяАссетаДляПлатформы("MacOS_ARM64"), "macos").Равно("lines-to-cover-macos.zip");

КонецПроцедуры

&Тест
Процедура ТестДолжен_БроситьИсключение_НаНеизвестнойПлатформе() Экспорт

	Ожидаем.Что(Сервис()).Метод("ИмяАссетаДляПлатформы", ТестовыеДанные.Массив("Solaris_sparc"))
		.ВыбрасываетИсключение("Неподдерживаемая платформа");

КонецПроцедуры

#КонецОбласти

#Область URLЗагрузки

&Тест
Процедура ТестДолжен_СобратьURLЗагрузки_ИзВерсииИАссетаТекущейОС() Экспорт

	URL = Сервис().URLЗагрузки();

	Ожидаем.Что(URL, "версия в URL").Содержит("/download/v0.1.0/");
	Ожидаем.Что(URL, "ассет ОС в URL").Содержит(Сервис().ИмяАссетаДляПлатформы(Окружение().ТипПлатформы()));

КонецПроцедуры

#КонецОбласти

#Область РазобратьURL

&Тест
Процедура ТестДолжен_РазобратьURL_HttpsСПортомПоУмолчанию() Экспорт

	Разбор = Сервис().РазобратьURL("https://github.com/Segate-ekb/Lines_to_cover_1c/releases/download/v0.1.0/a.zip");

	Ожидаем.Что(Разбор.СХостом, "хост со схемой").Равно("https://github.com");
	Ожидаем.Что(Разбор.Порт, "порт https по умолчанию").Равно(443);
	Ожидаем.Что(Разбор.Ресурс, "ресурс").Равно("/Segate-ekb/Lines_to_cover_1c/releases/download/v0.1.0/a.zip");

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазобратьURL_HttpСЯвнымПортом() Экспорт

	Разбор = Сервис().РазобратьURL("http://build-agent:8080/x/y");

	Ожидаем.Что(Разбор.СХостом, "хост со схемой").Равно("http://build-agent");
	Ожидаем.Что(Разбор.Порт, "явный порт").Равно(8080);
	Ожидаем.Что(Разбор.Ресурс, "ресурс").Равно("/x/y");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// SUT собирается лениво: детальки конструктора (версия, база URL релизов, домашний каталог,
// каталог утилит) - параметры, а домашний каталог у тестов Установлена свой.
Функция Сервис(Знач Дом = "")
	Возврат Стенд.Сервис("СервисПокрываемыхСтрок", ТестовыеДанные.Массив(
		"0.1.0", "https://github.com/Segate-ekb/Lines_to_cover_1c/releases/download", Дом, ""));
КонецФункции

// Шпион СервисОкружения: определение ОС настоящее.
Функция Окружение()
	Возврат Стенд.Мок("СервисОкружения");
КонецФункции

// Каталог образа с минимумом файлов для детектора готовности: bin/java[.exe] и lib/*.jar.
Функция СоздатьФейковыйОбраз()

	Образ = ВременныеФайлы.СоздатьКаталог();
	ТестовыеФайлы.Файл(Образ, "bin/" + Окружение().ИмяИсполняемогоФайла("java"));
	ТестовыеФайлы.Файл(Образ, "lib/lines-to-cover-0.1.0.jar");

	Возврат Образ;

КонецФункции

#КонецОбласти
