// BSLLS-off
// Юнит-тесты СервисПокрываемыхСтрок: чистые помощники (разбор URL, имя ассета, URL загрузки)
// и детектор установки (готовность образа) - без сети и без запуска java.

#Использовать asserts
#Использовать "../../../src/core/Сервисы"

Перем Сервис;

#Область СлужебныйПрограммныйИнтерфейс

&Тест
Процедура ТестРазобратьURL_Https_ХостРесурсПорт443() Экспорт
	Разбор = Сервис.РазобратьURL("https://github.com/Segate-ekb/Lines_to_cover_1c/releases/download/v0.1.0/a.zip");
	Ожидаем.Что(Разбор.СХостом, "хост со схемой").Равно("https://github.com");
	Ожидаем.Что(Разбор.Порт, "порт https по умолчанию").Равно(443);
	Ожидаем.Что(Разбор.Ресурс, "ресурс").Равно("/Segate-ekb/Lines_to_cover_1c/releases/download/v0.1.0/a.zip");
КонецПроцедуры

&Тест
Процедура ТестРазобратьURL_Http_ЯвныйПорт() Экспорт
	Разбор = Сервис.РазобратьURL("http://build-agent:8080/x/y");
	Ожидаем.Что(Разбор.СХостом, "хост со схемой").Равно("http://build-agent");
	Ожидаем.Что(Разбор.Порт, "явный порт").Равно(8080);
	Ожидаем.Что(Разбор.Ресурс, "ресурс").Равно("/x/y");
КонецПроцедуры

&Тест
Процедура ТестИмяАссета_ПоПлатформам() Экспорт
	Ожидаем.Что(Сервис.ИмяАссетаДляПлатформы("Windows_x86_64"), "windows").Равно("lines-to-cover-windows.zip");
	Ожидаем.Что(Сервис.ИмяАссетаДляПлатформы("Linux_x86_64"), "linux").Равно("lines-to-cover-linux.zip");
	Ожидаем.Что(Сервис.ИмяАссетаДляПлатформы("MacOS_ARM64"), "macos").Равно("lines-to-cover-macos.zip");
КонецПроцедуры

&Тест
Процедура ТестИмяАссета_НеизвестнаяПлатформа_Исключение() Экспорт
	ВозниклоИсключение = Ложь;
	Попытка
		Сервис.ИмяАссетаДляПлатформы("Solaris_sparc");
	Исключение
		ВозниклоИсключение = Истина;
	КонецПопытки;
	Ожидаем.Что(ВозниклоИсключение, "исключение на неподдерживаемой платформе").ЭтоИстина();
КонецПроцедуры

&Тест
Процедура ТестURLЗагрузки_СодержитВерсиюИАссет() Экспорт
	URL = Сервис.URLЗагрузки();
	Ожидаем.Что(СтрНайти(URL, "/download/v0.1.0/") > 0, "версия в URL: " + URL).ЭтоИстина();
	Ожидаем.Что(СтрНайти(URL, ИмяАссетаТекущейОС()) > 0, "ассет ОС в URL: " + URL).ЭтоИстина();
КонецПроцедуры

&Тест
Процедура ТестУстановлена_Ложь_ЕслиОбразаНет() Экспорт
	Дом = ОбъединитьПути(ПолучитьИмяВременногоФайла(), "нет-такого-образа");
	Ожидаем.Что(НовыйСервис(Дом).Установлена(), "не установлена без файлов").ЭтоЛожь();
КонецПроцедуры

&Тест
Процедура ТестУстановлена_Истина_ЕслиОбразГотов() Экспорт
	Образ = СоздатьФейковыйОбраз();
	Ожидаем.Что(НовыйСервис(Образ).Установлена(), "установлена при валидном образе").ЭтоИстина();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	Сервис = НовыйСервис();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Конструктор с явными значениями деталек (autumn в тестах не инжектит - параметры обязательные).
Функция НовыйСервис(Знач Дом = "")
	Возврат Новый СервисПокрываемыхСтрок(
		"0.1.0",
		"https://github.com/Segate-ekb/Lines_to_cover_1c/releases/download",
		Дом,
		"");
КонецФункции

// Создать каталог образа с минимально достаточными файлами (bin/java[.exe] + lib/*.jar)
// для срабатывания детектора ОбразГотов, не скачивая реальный бандл.
Функция СоздатьФейковыйОбраз()

	Образ = ОбъединитьПути(ПолучитьИмяВременногоФайла(), "image");
	СоздатьКаталог(ОбъединитьПути(Образ, "bin"));
	СоздатьКаталог(ОбъединитьПути(Образ, "lib"));

	ИмяДжава = "java" + ?(ЭтоWindows(), ".exe", "");
	ЗаписатьПустойФайл(ОбъединитьПути(Образ, "bin", ИмяДжава));
	ЗаписатьПустойФайл(ОбъединитьПути(Образ, "lib", "lines-to-cover-0.1.0.jar"));

	Возврат Образ;

КонецФункции

Процедура ЗаписатьПустойФайл(Знач Путь)
	Запись = Новый ЗаписьТекста(Путь, "UTF-8");
	Запись.Закрыть();
КонецПроцедуры

Функция ИмяАссетаТекущейОС()
	Возврат Сервис.ИмяАссетаДляПлатформы(Строка(Новый СистемнаяИнформация().ТипПлатформы));
КонецФункции

Функция ЭтоWindows()
	Возврат СтрНачинаетсяС(НРег(Строка(Новый СистемнаяИнформация().ТипПлатформы)), "windows");
КонецФункции

#КонецОбласти
