// BSLLS-off
// Юнит-тесты НастройкиVanessa: наложение --report-format/--report-path на настройки
// Vanessa-ADD (файл ключа запуска VBParams).
//
// Ключей запуска для отчётов у bddRunner нет, поэтому опции превращаются в настройки.
// Проверяется, что нужные ключи проставлены, пользовательские сохранены, а исходный
// файл не переписан.

#Использовать asserts
#Использовать tempfiles

#Использовать "../../../src/core/Сервисы"

Перем Настройки;
Перем Каталоги;

#Область СлужебныйПрограммныйИнтерфейс

&Тест
Процедура ТестДолжен_ВернутьИсходныйПуть_БезОтчетов() Экспорт

	ПутьИсходных = ЗаписатьНастройки(Новый Соответствие);

	Ожидаем.Что(Настройки.ДополнитьОтчетами(ПутьИсходных, Новый Массив), "путь настроек")
		.Равно(ПутьИсходных);
	Ожидаем.Что(Настройки.ДополнитьОтчетами(ПутьИсходных, Неопределено), "путь настроек")
		.Равно(ПутьИсходных);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВключитьОтчетJUnit() Экспорт

	Результат = ПрочитатьРезультат("", Отчеты("junit", "C:/build/junit"));

	Ожидаем.Что(Результат.Получить("ДелатьОтчетВФорматеjUnit"), "флаг jUnit").Равно("Истина");
	Ожидаем.Что(Результат.Получить("КаталогOutputjUnit"), "каталог jUnit").Равно("C:/build/junit");

КонецПроцедуры

// У Allure нет флага «делать отчёт» - его включает сам каталог. Подкаталог сборки
// выключаем, иначе результат уезжает в непредсказуемый путь и CI не знает, что публиковать.
&Тест
Процедура ТестДолжен_ВключитьОтчетAllure_БезПодкаталогаСборки() Экспорт

	Результат = ПрочитатьРезультат("", Отчеты("allure", "C:/build/allure"));

	Ожидаем.Что(Результат.Получить("КаталогOutputAllureБазовый"), "базовый каталог")
		.Равно("C:/build/allure");
	Ожидаем.Что(Результат.Получить("КаталогOutputAllure"), "каталог").Равно("C:/build/allure");
	Ожидаем.Что(Результат.Получить("СоздаватьПодкаталогВКаталогеAllureДляЭтойСборки"), "подкаталог сборки")
		.Равно("Ложь");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВключитьОтчетCucumberJson() Экспорт

	Результат = ПрочитатьРезультат("", Отчеты("cucumberjson", "C:/build/cucumber"));

	Ожидаем.Что(Результат.Получить("ДелатьОтчетВФорматеCucumberJson"), "флаг Cucumber").Равно("Истина");
	Ожидаем.Что(Результат.Получить("КаталогOutputCucumberJson"), "каталог Cucumber")
		.Равно("C:/build/cucumber");

КонецПроцедуры

// Настройки пользователя - основа, а не помеха: всё, чего мы не трогаем, доезжает до ADD.
&Тест
Процедура ТестДолжен_СохранитьПользовательскиеНастройки() Экспорт

	Исходные = Новый Соответствие;
	Исходные.Вставить("ИмяСборки", "Тестовая сборка");
	Исходные.Вставить("ЗакрытьTestClientПослеЗапускаСценариев", "Истина");
	ПутьИсходных = ЗаписатьНастройки(Исходные);

	Результат = ПрочитатьРезультат(ПутьИсходных, Отчеты("junit", "C:/build/junit"));

	Ожидаем.Что(Результат.Получить("ИмяСборки"), "имя сборки").Равно("Тестовая сборка");
	Ожидаем.Что(Результат.Получить("ЗакрытьTestClientПослеЗапускаСценариев"), "закрытие клиента")
		.Равно("Истина");
	Ожидаем.Что(Результат.Получить("КаталогOutputjUnit"), "каталог jUnit").Равно("C:/build/junit");

КонецПроцедуры

// Опция командной строки должна выигрывать у одноимённой настройки, иначе она
// бесполезна: --vanessasettings есть почти в каждом проекте.
&Тест
Процедура ТестДолжен_ПерекрытьКаталогИзНастроек() Экспорт

	Исходные = Новый Соответствие;
	Исходные.Вставить("КаталогOutputjUnit", "$workspaceRoot/./ServiceBases/junitreport");
	ПутьИсходных = ЗаписатьНастройки(Исходные);

	Результат = ПрочитатьРезультат(ПутьИсходных, Отчеты("junit", "C:/build/junit"));

	Ожидаем.Что(Результат.Получить("КаталогOutputjUnit"), "каталог jUnit").Равно("C:/build/junit");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеПереписыватьИсходныйФайл() Экспорт

	Исходные = Новый Соответствие;
	Исходные.Вставить("ИмяСборки", "Тестовая сборка");
	ПутьИсходных = ЗаписатьНастройки(Исходные);

	ПутьРезультата = Настройки.ДополнитьОтчетами(ПутьИсходных, Отчеты("junit", "C:/build/junit"));

	Ожидаем.Что(ПутьРезультата = ПутьИсходных, "результат пишется в отдельный файл").ЭтоЛожь();
	Ожидаем.Что(ПрочитатьJSONФайла(ПутьИсходных).Получить("КаталогOutputjUnit") = Неопределено,
		"исходный файл не тронут").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_СобратьНастройкиСНуля_БезФайлаПользователя() Экспорт

	Результат = ПрочитатьРезультат("", Отчеты("junit", "C:/build/junit"));

	Ожидаем.Что(Результат.Получить("ДелатьОтчетВФорматеjUnit"), "флаг jUnit").Равно("Истина");

КонецПроцедуры

&Тест
Процедура ТестДолжен_УпастьНаНесуществующемФайлеНастроек() Экспорт

	Попытка
		Настройки.ДополнитьОтчетами("нет-такого-файла.json", Отчеты("junit", "C:/build/junit"));
		ВызватьИсключение "Должно было упасть";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("не найден");
	КонецПопытки;

КонецПроцедуры

&Тест
Процедура ТестДолжен_УпастьНаНеизвестномФормате() Экспорт

	Попытка
		Настройки.ДополнитьОтчетами("", Отчеты("mxl", "C:/build/mxl"));
		ВызватьИсключение "Должно было упасть";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("mxl");
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	Настройки = Новый НастройкиVanessa();
	Каталоги = Новый Массив;
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	Для Каждого Каталог Из Каталоги Цикл
		Попытка
			УдалитьФайлы(Каталог);
		Исключение
			// не критично для теста
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Отчеты(Знач Формат, Знач Путь)
	Результат = Новый Массив;
	Результат.Добавить(Новый Структура("Формат, Путь", Формат, Путь));
	Возврат Результат;
КонецФункции

Функция ЗаписатьНастройки(Знач Данные)

	Каталог = ВременныеФайлы.СоздатьКаталог();
	Каталоги.Добавить(Каталог);
	Путь = ОбъединитьПути(Каталог, "vb-params.json");

	Запись = Новый ЗаписьJSON;
	Запись.ОткрытьФайл(Путь, "UTF-8", Ложь);
	ЗаписатьJSON(Запись, Данные);
	Запись.Закрыть();

	Возврат Путь;

КонецФункции

Функция ПрочитатьJSONФайла(Знач Путь)
	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(Путь);
	Данные = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Данные;
КонецФункции

Функция ПрочитатьРезультат(Знач ПутьИсходных, Знач СписокОтчетов)
	Возврат ПрочитатьJSONФайла(Настройки.ДополнитьОтчетами(ПутьИсходных, СписокОтчетов));
КонецФункции

#КонецОбласти
