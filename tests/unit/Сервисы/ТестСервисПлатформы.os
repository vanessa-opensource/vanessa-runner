// Юнит-тесты СервисПлатформы.
// Покрытие: делегаты в движки, ветка ibsrv в ЗапуститьПредприятие, ОчиститьВременнуюБазу при ошибке проверки.

#Использовать asserts
#Использовать moskito
#Использовать tempfiles

#Использовать "../../../src/core/Движки"
#Использовать "../../../src/core/Сервисы"
#Использовать "../utils"

Перем Подключения;
Перем Любое;

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	Подключения = Новый ДанныеПодключений;
	Любое = Матчеры.ЛюбоеЗначение();
КонецПроцедуры

#Область СоздатьФайловуюБазу

&Тест
Процедура ТестДолжен_СоздатьФайловуюБазу_ЧерезКонфигуратор() Экспорт

	// Дано
	МокДвижок = Мок.Получить(Новый ДвижокКонфигуратор);
	МокДвижок.Когда().СоздатьФайловуюБазу(Любое, Любое).ТогдаВозвращает(Подключения.Файловая("C:\db"));

	Сервис = Новый БилдерСервисаПлатформы().СОдинаковымДвижком(МокДвижок).Собрать();

	// Когда
	Результат = Сервис.СоздатьФайловуюБазу("C:\db");

	// Тогда
	МокДвижок.ПроверитьЧтоВызывалсяМетод().СоздатьФайловуюБазу("C:\db", Любое);
	Ожидаем.Что(Результат.КаталогБазы).Равно("C:\db");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьФайловуюБазу_ЧерезIbcmd_ПриФлаге() Экспорт

	// Дано
	МокКонфигуратор = Мок.Получить(Новый ДвижокКонфигуратор);
	МокIbcmd = Мок.Получить(Новый ДвижокIbcmd);
	МокIbcmd.Когда().СоздатьФайловуюБазу(Любое, Любое).ТогдаВозвращает(Подключения.Файловая("C:\db"));

	Сервис = Новый БилдерСервисаПлатформы()
		.СДвижкомКонфигуратор(МокКонфигуратор)
		.СДвижкомIbcmd(МокIbcmd)
		.Собрать();

	// Когда
	Сервис.СоздатьФайловуюБазу("C:\db", Истина);

	// Тогда
	МокIbcmd.ПроверитьЧтоВызывалсяМетод().СоздатьФайловуюБазу("C:\db", Любое);

КонецПроцедуры

#КонецОбласти

