#КонецОбласти

#Область ПроверитьКонфигурацию

&Тест
Процедура ТестДолжен_ПроверитьКонфигурацию_ВернутьРезультат() Экспорт

	// Дано
	МокКонфигуратор = Мок.Получить(Новый ДвижокКонфигуратор);
	МокКонфигуратор.Когда().СоздатьВременнуюБазу(Любое)
		.ТогдаВозвращает(Подключения.Файловая(ВременныеФайлы.СоздатьКаталог()));
	Результат = Новый Структура("Успешно, ВыводКоманды", Истина, "ok");
	МокКонфигуратор.Когда().ВыполнитьПроверкуКонфигурации(Любое, Любое, Любое, Любое)
		.ТогдаВозвращает(Результат);

	Сервис = Новый БилдерСервисаПлатформы().СОдинаковымДвижком(МокКонфигуратор).Собрать();

	Режимы = Новый Массив;
	Режимы.Добавить("-ThinClient");

	// Когда
	Факт = Сервис.ПроверитьКонфигурацию(Неопределено, Режимы);

	// Тогда
	Ожидаем.Что(Факт.Успешно).ЭтоИстина();
	Ожидаем.Что(Факт.ВыводКоманды).Равно("ok");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОчиститьВременнуюБазуПриОшибкеПроверки() Экспорт

	// Дано
	КаталогВременной = ВременныеФайлы.СоздатьКаталог();
	МокКонфигуратор = Мок.Получить(Новый ДвижокКонфигуратор);
	МокКонфигуратор.Когда().СоздатьВременнуюБазу(Любое)
		.ТогдаВозвращает(Подключения.Файловая(КаталогВременной));
	МокКонфигуратор.Когда().ВыполнитьПроверкуКонфигурации(Любое, Любое, Любое, Любое)
		.ТогдаВыбрасываетИсключение("Проверка упала");

	Сервис = Новый БилдерСервисаПлатформы().СОдинаковымДвижком(МокКонфигуратор).Собрать();

	Режимы = Новый Массив;

	// Когда / Тогда
	Попытка
		Сервис.ПроверитьКонфигурацию(Неопределено, Режимы);
		ВызватьИсключение "Должно было упасть";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("Проверка упала");
	КонецПопытки;

	Ожидаем.Что(Новый Файл(КаталогВременной).Существует()).ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область ПолучитьИзмененияКонфигурации

&Тест
Процедура ТестДолжен_ПолучитьИзмененияКонфигурации_Делегат() Экспорт

	// Дано
	МокДвижок = Мок.Получить(Новый ДвижокКонфигуратор);
	Изменения = Новый Структура("ТребуетсяПолнаяЗагрузка", Ложь);
	МокДвижок.Когда().ПолучитьИзмененияКонфигурации(Любое, Любое, Любое, Любое, Любое)
		.ТогдаВозвращает(Изменения);

	Сервис = Новый БилдерСервисаПлатформы().СОдинаковымДвижком(МокДвижок).Собрать();

	// Когда
	Факт = Сервис.ПолучитьИзмененияКонфигурации(Подключения.Файловая("C:\b"), "C:\src");

	// Тогда
	Ожидаем.Что(Факт.ТребуетсяПолнаяЗагрузка).ЭтоЛожь();
	МокДвижок.ПроверитьЧтоВызывалсяМетод().ПолучитьИзмененияКонфигурации(Любое, "C:\src", Любое, Любое, Любое);

КонецПроцедуры

#КонецОбласти
