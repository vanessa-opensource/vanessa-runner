// BSLLS-off
// Юнит-тесты СервисПлатформы: делегаты в движки, ветка ibsrv в ЗапуститьПредприятие,
// очистка временной базы при ошибке проверки. Движки и СервисАвтономногоСервера замоканы.

#Использовать asserts
#Использовать moskito
#Использовать tempfiles
#Использовать "../utils"

Перем Стенд;
Перем Сервис;
Перем Конфигуратор; // мок ДвижокКонфигуратор
Перем База;
Перем Любое;

&ПередКаждым
Процедура ПередКаждым() Экспорт
	Стенд = Новый Стенд;
	Стенд.Реальный("СервисВременнойБазы"); // выбор движка и жизненный цикл временной ИБ настоящие, движки - моки
	Сервис = Стенд.Сервис("СервисПлатформы");
	Конфигуратор = Стенд.Мок("ДвижокКонфигуратор");
	База = ТестовыеДанные.Файловая("base");
	Любое = Матчеры.ЛюбоеЗначение();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт
	ВременныеФайлы.Удалить();
КонецПроцедуры

#Область СоздатьФайловуюБазу

&Тест
Процедура ТестДолжен_СоздатьФайловуюБазу_ЧерезКонфигуратор() Экспорт

	// Дано
	Конфигуратор.Когда().СоздатьФайловуюБазу(Любое, Любое).ТогдаВозвращает(ТестовыеДанные.Файловая("db"));

	// Когда
	Результат = Сервис.СоздатьФайловуюБазу("db");

	// Тогда
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().СоздатьФайловуюБазу("db", Неопределено);
	Ожидаем.Что(Результат.КаталогБазы).Равно("db");
	Стенд.ПроверитьЧтоНеВызывался("ДвижокIbcmd", "СоздатьФайловуюБазу");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьФайловуюБазу_ЧерезIbcmd_ПриФлаге() Экспорт

	// Дано
	Стенд.Мок("ДвижокIbcmd").Когда().СоздатьФайловуюБазу(Любое, Любое).ТогдаВозвращает(ТестовыеДанные.Файловая("db"));

	// Когда
	Результат = Сервис.СоздатьФайловуюБазу("db", Истина);

	// Тогда
	Стенд.Мок("ДвижокIbcmd").ПроверитьЧтоВызывалсяМетод().СоздатьФайловуюБазу("db", Неопределено);
	Ожидаем.Что(Результат.КаталогБазы).Равно("db");
	Стенд.ПроверитьЧтоНеВызывался("ДвижокКонфигуратор", "СоздатьФайловуюБазу");

КонецПроцедуры

#КонецОбласти

#Область ЗагрузитьИнфобазуИзФайла_ВыгрузитьИнфобазуВФайл

&Тест
Процедура ТестДолжен_ЗагрузитьИнфобазуИзDT_Делегат() Экспорт

	// Когда
	Сервис.ЗагрузитьИнфобазуИзФайла(База, "dump.dt");

	// Тогда
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().ЗагрузитьИнфобазуИзФайла(База, "dump.dt", Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыгрузитьИнфобазуВDT_Делегат() Экспорт

	// Когда
	Сервис.ВыгрузитьИнфобазуВФайл(База, "dump.dt");

	// Тогда
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().ВыгрузитьИнфобазуВФайл(База, "dump.dt", Неопределено);

КонецПроцедуры

#КонецОбласти

#Область ОбновитьКонфигурациюБД

&Тест
Процедура ТестДолжен_ОбновитьКонфигурациюБД_Делегат() Экспорт

	// Когда
	Сервис.ОбновитьКонфигурациюБД(База);

	// Тогда
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().ОбновитьКонфигурациюБД(База, Неопределено, Неопределено);

КонецПроцедуры

#КонецОбласти

#Область ЗапуститьПредприятие

&Тест
Процедура ТестДолжен_ЗапуститьПредприятие_БезIbsrv_Делегат() Экспорт

	// Дано
	ПараметрыЗапуска = Новый Структура("КомандаЗапуска", "");

	// Когда
	Сервис.ЗапуститьПредприятие(База, ПараметрыЗапуска);

	// Тогда - прямой запуск, автономный сервер не поднимался
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().ЗапуститьПредприятие(База, ПараметрыЗапуска, Неопределено);
	Стенд.ПроверитьЧтоНеВызывался("СервисАвтономногоСервера", "ЗапуститьСервер");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗапуститьПредприятие_ЧерезIbsrv_ПриФлагеИФайловойИБ() Экспорт

	// Дано
	АС = АвтономныйСерверФайловойИБ("/WS http://localhost:8314/");
	ПараметрыЗапуска = Новый Структура("ИспользоватьIbsrv", Истина);

	// Когда
	Сервис.ЗапуститьПредприятие(База, ПараметрыЗапуска);

	// Тогда - поднят сервер, предприятие запущено по строке подключения ibsrv, сервер остановлен
	АС.ПроверитьЧтоВызывалсяМетод().ЗапуститьСервер(База, Неопределено, Любое);
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().ЗапуститьПредприятие(Любое, ПараметрыЗапуска, Неопределено);
	Запуск = Стенд.Вызовы("ДвижокКонфигуратор", "ЗапуститьПредприятие")[0];
	Ожидаем.Что(Запуск.ПараметрыПодключения.СтрокаПодключения).Равно("/WS http://localhost:8314/");
	АС.ПроверитьЧтоВызывалсяМетод().ОстановитьСервер();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОстановитьIbsrv_ПриОшибкеЗапускаПредприятия() Экспорт

	// Дано
	АС = АвтономныйСерверФайловойИБ("/WS http://x/");
	Конфигуратор.Когда().ЗапуститьПредприятие(Любое, Любое, Любое).ТогдаВыбрасываетИсключение("Ошибка запуска");
	ПараметрыЗапуска = Новый Структура("ИспользоватьIbsrv", Истина);

	// Когда / Тогда
	Ожидаем.Что(Сервис).Метод("ЗапуститьПредприятие", ТестовыеДанные.Массив(База, ПараметрыЗапуска))
		.ВыбрасываетИсключение("Ошибка запуска");
	АС.ПроверитьЧтоВызывалсяМетод().ОстановитьСервер();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИгнорироватьIbsrv_ДляСервернойИБ() Экспорт

	// Дано
	Стенд.Мок("СервисАвтономногоСервера").Когда().ЭтоФайловаяИБ(Любое).ТогдаВозвращает(Ложь);
	ПараметрыЗапуска = Новый Структура("ИспользоватьIbsrv", Истина);
	Сервер = ТестовыеДанные.Подключение("/S srv/db");

	// Когда
	Сервис.ЗапуститьПредприятие(Сервер, ПараметрыЗапуска);

	// Тогда - ibsrv проигнорирован, прямой запуск через движок
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().ЗапуститьПредприятие(Сервер, ПараметрыЗапуска, Неопределено);
	Стенд.ПроверитьЧтоНеВызывался("СервисАвтономногоСервера", "ЗапуститьСервер");

КонецПроцедуры

#КонецОбласти

#Область ЗапуститьКонфигуратор

&Тест
Процедура ТестДолжен_ЗапуститьКонфигуратор_Делегат() Экспорт

	// Дано
	ПараметрыЗапуска = Новый Структура;

	// Когда
	Сервис.ЗапуститьКонфигуратор(База, ПараметрыЗапуска);

	// Тогда
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().ЗапуститьКонфигуратор(База, ПараметрыЗапуска, Неопределено);

КонецПроцедуры

#КонецОбласти

#Область ПроверитьКонфигурацию

&Тест
Процедура ТестДолжен_ПроверитьКонфигурацию_ВернутьРезультат() Экспорт

	// Дано
	Результат = Новый Структура("Успешно, ВыводКоманды", Истина, "ok");
	Конфигуратор.Когда().ВыполнитьПроверкуКонфигурации(Любое, Любое, Любое, Любое).ТогдаВозвращает(Результат);
	Режимы = ТестовыеДанные.Массив("-ThinClient");

	// Когда - база не передана: проверка во временной базе
	Факт = Сервис.ПроверитьКонфигурацию(Неопределено, Режимы);

	// Тогда
	Ожидаем.Что(Факт.Успешно).ЭтоИстина();
	Ожидаем.Что(Факт.ВыводКоманды).Равно("ok");
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().СоздатьВременнуюБазу(Неопределено);
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().ВыполнитьПроверкуКонфигурации(Любое, Режимы, Неопределено, Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОчиститьВременнуюБазуПриОшибкеПроверки() Экспорт

	// Дано
	КаталогВременной = ВременныеФайлы.СоздатьКаталог();
	Конфигуратор.Когда().СоздатьВременнуюБазу(Любое).ТогдаВозвращает(ТестовыеДанные.Файловая(КаталогВременной));
	Конфигуратор.Когда().ВыполнитьПроверкуКонфигурации(Любое, Любое, Любое, Любое)
		.ТогдаВыбрасываетИсключение("Проверка упала");

	// Когда / Тогда
	Ожидаем.Что(Сервис).Метод("ПроверитьКонфигурацию", ТестовыеДанные.Массив(Неопределено, Новый Массив))
		.ВыбрасываетИсключение("Проверка упала");
	Ожидаем.Что(ТестовыеФайлы.Существует(КаталогВременной), "временная база удалена").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область ПолучитьИзмененияКонфигурации

&Тест
Процедура ТестДолжен_ПолучитьИзмененияКонфигурации_Делегат() Экспорт

	// Дано
	Изменения = Новый Структура("ТребуетсяПолнаяЗагрузка", Ложь);
	Конфигуратор.Когда().ПолучитьИзмененияКонфигурации(Любое, Любое, Любое, Любое, Любое).ТогдаВозвращает(Изменения);

	// Когда
	Факт = Сервис.ПолучитьИзмененияКонфигурации(База, "src");

	// Тогда
	Ожидаем.Что(Факт.ТребуетсяПолнаяЗагрузка).ЭтоЛожь();
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().ПолучитьИзмененияКонфигурации(База, "src", "", Неопределено, "");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Мок автономного сервера, считающий базу файловой и поднимающий ibsrv с заданной строкой подключения.
Функция АвтономныйСерверФайловойИБ(Знач СтрокаПодключенияIbsrv)

	АС = Стенд.Мок("СервисАвтономногоСервера");
	АС.Когда().НовыеПараметрыАС()
		.ТогдаВозвращает(Новый Структура("ИспользоватьПрямоеСоединение, ИспользоватьОтладку", Ложь, Ложь));
	АС.Когда().ЭтоФайловаяИБ(Любое).ТогдаВозвращает(Истина);
	АС.Когда().ЗапуститьСервер(Любое, Любое, Любое)
		.ТогдаВозвращает(Новый Структура("СтрокаПодключения, ПортHttp, ПортПрямой", СтрокаПодключенияIbsrv, 8314, 8341));

	Возврат АС;

КонецФункции

#КонецОбласти
