// BSLLS-off
// Юнит-тесты СервисПлатформы: делегаты в движки, ветка ibsrv и сеанс покрытия в ЗапуститьПредприятие,
// очистка временной базы при ошибке проверки. Движки, СервисАвтономногоСервера и СервисПокрытия замоканы.

#Использовать asserts
#Использовать moskito
#Использовать tempfiles
#Использовать "../utils"

Перем Стенд;
Перем Сервис;
Перем Конфигуратор; // мок ДвижокКонфигуратор
Перем База;
Перем Любое;

&ПередКаждым
Процедура ПередКаждым() Экспорт
	Стенд = Новый Стенд;
	Стенд.Реальный("СервисВременнойБазы"); // выбор движка и жизненный цикл временной ИБ настоящие, движки - моки
	Сервис = Стенд.Сервис("СервисПлатформы");
	Конфигуратор = Стенд.Мок("ДвижокКонфигуратор");
	База = ТестовыеДанные.Файловая("base");
	Любое = Матчеры.ЛюбоеЗначение();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт
	ВременныеФайлы.Удалить();
КонецПроцедуры

#Область СоздатьФайловуюБазу

&Тест
Процедура ТестДолжен_СоздатьФайловуюБазу_ЧерезКонфигуратор() Экспорт

	// Дано
	Конфигуратор.Когда().СоздатьФайловуюБазу(Любое, Любое).ТогдаВозвращает(ТестовыеДанные.Файловая("db"));

	// Когда
	Результат = Сервис.СоздатьФайловуюБазу("db");

	// Тогда
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().СоздатьФайловуюБазу("db", Неопределено);
	Ожидаем.Что(Результат.КаталогБазы).Равно("db");
	Стенд.ПроверитьЧтоНеВызывался("ДвижокIbcmd", "СоздатьФайловуюБазу");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьФайловуюБазу_ЧерезIbcmd_ПриФлаге() Экспорт

	// Дано
	Стенд.Мок("ДвижокIbcmd").Когда().СоздатьФайловуюБазу(Любое, Любое).ТогдаВозвращает(ТестовыеДанные.Файловая("db"));
	ПараметрыПлатформы = ТестовыеДанные.ПараметрыПлатформы(Истина);

	// Когда
	Результат = Сервис.СоздатьФайловуюБазу("db", ПараметрыПлатформы);

	// Тогда
	Стенд.Мок("ДвижокIbcmd").ПроверитьЧтоВызывалсяМетод().СоздатьФайловуюБазу("db", ПараметрыПлатформы);
	Ожидаем.Что(Результат.КаталогБазы).Равно("db");
	Стенд.ПроверитьЧтоНеВызывался("ДвижокКонфигуратор", "СоздатьФайловуюБазу");

КонецПроцедуры

#КонецОбласти

#Область ЗагрузитьИнфобазуИзФайла_ВыгрузитьИнфобазуВФайл

&Тест
Процедура ТестДолжен_ЗагрузитьИнфобазуИзDT_Делегат() Экспорт

	// Когда
	Сервис.ЗагрузитьИнфобазуИзФайла(База, "dump.dt");

	// Тогда
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().ЗагрузитьИнфобазуИзФайла(База, "dump.dt", Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыгрузитьИнфобазуВDT_Делегат() Экспорт

	// Когда
	Сервис.ВыгрузитьИнфобазуВФайл(База, "dump.dt");

	// Тогда
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().ВыгрузитьИнфобазуВФайл(База, "dump.dt", Неопределено);

КонецПроцедуры

#КонецОбласти

#Область ОбновитьКонфигурациюБД

&Тест
Процедура ТестДолжен_ОбновитьКонфигурациюБД_Делегат() Экспорт

	// Когда
	Сервис.ОбновитьКонфигурациюБД(База);

	// Тогда
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().ОбновитьКонфигурациюБД(База, Неопределено, Неопределено);

КонецПроцедуры

#КонецОбласти

#Область НовыеПараметрыЗапуска

&Тест
Процедура ТестДолжен_СоздатьПараметрыЗапуска_СоВсемиКлючамиДвижка() Экспорт

	// Когда
	Параметры = Сервис.НовыеПараметрыЗапуска("cmd", "tool.epf");

	// Тогда
	Ожидаем.Что(Параметры.Количество()).Равно(8);
	Ожидаем.Что(Параметры.КомандаЗапуска).Равно("cmd");
	Ожидаем.Что(Параметры.ПутьОбработки).Равно("tool.epf");
	Ожидаем.Что(Параметры.НавигационнаяСсылка).Равно("");
	Ожидаем.Что(Параметры.НеОжидать).ЭтоЛожь();
	Ожидаем.Что(Параметры.ТолстыйКлиент).ЭтоЛожь();
	Ожидаем.Что(Параметры.ДополнительныеПараметры).Равно("");
	Ожидаем.Что(Параметры.ПутьКФайлуСтатуса).Равно("");
	Ожидаем.Что(Параметры.ПараметрыХранилища).Равно(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область ЗапуститьПредприятие

&Тест
Процедура ТестДолжен_ЗапуститьПредприятие_БезIbsrv_Делегат() Экспорт

	// Дано
	ПараметрыЗапуска = Новый Структура("КомандаЗапуска", "");

	// Когда
	Сервис.ЗапуститьПредприятие(База, ПараметрыЗапуска);

	// Тогда - прямой запуск, автономный сервер не поднимался, сеанс покрытия не начинался
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().ЗапуститьПредприятие(База, ПараметрыЗапуска, Неопределено);
	Стенд.ПроверитьЧтоНеВызывался("СервисАвтономногоСервера", "ЗапуститьСервер");
	Стенд.ПроверитьЧтоНеВызывался("СервисПокрытия", "НачатьСеанс");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗапуститьПредприятие_СПокрытием_ДописатьАргументыОтладкиИЗавершитьСеанс() Экспорт

	// Дано
	Контекст = НачатыйСеансПокрытия();
	ПараметрыЗапуска = Сервис.НовыеПараметрыЗапуска();
	ПараметрыЗапуска.ДополнительныеПараметры = "/TESTMANAGER";
	ПараметрыПокрытия = Новый Структура("ПутьОтчета", "coverage.xml");

	// Когда
	Сервис.ЗапуститьПредприятие(База, ПараметрыЗапуска, Неопределено, ПараметрыПокрытия);

	// Тогда - клиент запущен с аргументами отладки, сеанс завершён с отчётом
	Покрытие = Стенд.Мок("СервисПокрытия");
	Покрытие.ПроверитьЧтоВызывалсяМетод().НачатьСеанс(ПараметрыПокрытия, База, Неопределено);
	Ожидаем.Что(ПараметрыЗапуска.ДополнительныеПараметры).Равно("/TESTMANAGER " + Контекст.АргументыОтладки);
	Ожидаем.Что(ПараметрыЗапуска.АдресСервераОтладки).Равно(Контекст.АдресСервера);
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().ЗапуститьПредприятие(База, ПараметрыЗапуска, Неопределено);
	Покрытие.ПроверитьЧтоВызывалсяМетод().ЗавершитьСеанс(Контекст);
	Стенд.ПроверитьЧтоНеВызывался("СервисПокрытия", "ПрерватьСеанс");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПрерватьСеансПокрытия_ПриОшибкеЗапускаПредприятия() Экспорт

	// Дано
	Контекст = НачатыйСеансПокрытия();
	Конфигуратор.Когда().ЗапуститьПредприятие(Любое, Любое, Любое).ТогдаВыбрасываетИсключение("Ошибка запуска");
	Параметры = ТестовыеДанные.Массив(База, Сервис.НовыеПараметрыЗапуска(), Неопределено, Новый Структура);

	// Когда / Тогда
	Ожидаем.Что(Сервис).Метод("ЗапуститьПредприятие", Параметры).ВыбрасываетИсключение("Ошибка запуска");
	Стенд.Мок("СервисПокрытия").ПроверитьЧтоВызывалсяМетод().ПрерватьСеанс(Контекст);
	Стенд.ПроверитьЧтоНеВызывался("СервисПокрытия", "ЗавершитьСеанс");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВызватьИсключение_ПриПокрытииБезОжидания() Экспорт

	// Дано
	ПараметрыЗапуска = Сервис.НовыеПараметрыЗапуска();
	ПараметрыЗапуска.НеОжидать = Истина;
	Параметры = ТестовыеДанные.Массив(База, ПараметрыЗапуска, Неопределено, Новый Структура);

	// Когда / Тогда - клиент не запускался, сеанс не начинался
	Ожидаем.Что(Сервис).Метод("ЗапуститьПредприятие", Параметры).ВыбрасываетИсключение("несовместим с --no-wait");
	Стенд.ПроверитьЧтоНеВызывался("СервисПокрытия", "НачатьСеанс");
	Стенд.ПроверитьЧтоНеВызывался("ДвижокКонфигуратор", "ЗапуститьПредприятие");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПодключитьIbsrvКСерверуОтладкиПокрытия_ПриПокрытииЧерезIbsrv() Экспорт

	// Дано
	Контекст = НачатыйСеансПокрытия();
	АвтономныйСерверФайловойИБ("/WS http://localhost:8314/");
	ПараметрыЗапуска = Сервис.НовыеПараметрыЗапуска();
	ПараметрыЗапуска.Вставить("ИспользоватьIbsrv", Истина);

	// Когда
	Сервис.ЗапуститьПредприятие(База, ПараметрыЗапуска, Неопределено, Новый Структура);

	// Тогда - ibsrv поднят с адресом сервера отладки покрытия, сеанс завершён
	ПараметрыАС = Стенд.Вызовы("СервисАвтономногоСервера", "ЗапуститьСервер")[0].ПараметрыАС;
	Ожидаем.Что(ПараметрыАС.АдресВнешнегоСервераОтладки).Равно(Контекст.АдресСервера);
	Стенд.Мок("СервисПокрытия").ПроверитьЧтоВызывалсяМетод().ЗавершитьСеанс(Контекст);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗапуститьПредприятие_ЧерезIbsrv_ПриФлагеИФайловойИБ() Экспорт

	// Дано
	АС = АвтономныйСерверФайловойИБ("/WS http://localhost:8314/");
	ПараметрыЗапуска = Новый Структура("ИспользоватьIbsrv", Истина);

	// Когда
	Сервис.ЗапуститьПредприятие(База, ПараметрыЗапуска);

	// Тогда - поднят сервер, предприятие запущено по строке подключения ibsrv, сервер остановлен
	АС.ПроверитьЧтоВызывалсяМетод().ЗапуститьСервер(База, Неопределено, Любое);
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().ЗапуститьПредприятие(Любое, ПараметрыЗапуска, Неопределено);
	Запуск = Стенд.Вызовы("ДвижокКонфигуратор", "ЗапуститьПредприятие")[0];
	Ожидаем.Что(Запуск.ПараметрыПодключения.СтрокаПодключения).Равно("/WS http://localhost:8314/");
	АС.ПроверитьЧтоВызывалсяМетод().ОстановитьСервер();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОстановитьIbsrv_ПриОшибкеЗапускаПредприятия() Экспорт

	// Дано
	АС = АвтономныйСерверФайловойИБ("/WS http://x/");
	Конфигуратор.Когда().ЗапуститьПредприятие(Любое, Любое, Любое).ТогдаВыбрасываетИсключение("Ошибка запуска");
	ПараметрыЗапуска = Новый Структура("ИспользоватьIbsrv", Истина);

	// Когда / Тогда
	Ожидаем.Что(Сервис).Метод("ЗапуститьПредприятие", ТестовыеДанные.Массив(База, ПараметрыЗапуска))
		.ВыбрасываетИсключение("Ошибка запуска");
	АС.ПроверитьЧтоВызывалсяМетод().ОстановитьСервер();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИгнорироватьIbsrv_ДляСервернойИБ() Экспорт

	// Дано
	Стенд.Мок("СервисАвтономногоСервера").Когда().ЭтоФайловаяИБ(Любое).ТогдаВозвращает(Ложь);
	ПараметрыЗапуска = Новый Структура("ИспользоватьIbsrv", Истина);
	Сервер = ТестовыеДанные.Подключение("/S srv/db");

	// Когда
	Сервис.ЗапуститьПредприятие(Сервер, ПараметрыЗапуска);

	// Тогда - ibsrv проигнорирован, прямой запуск через движок
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().ЗапуститьПредприятие(Сервер, ПараметрыЗапуска, Неопределено);
	Стенд.ПроверитьЧтоНеВызывался("СервисАвтономногоСервера", "ЗапуститьСервер");

КонецПроцедуры

#КонецОбласти

