#Область ЗапуститьПредприятие

&Тест
Процедура ТестДолжен_ЗапуститьПредприятие_БезIbsrv_Делегат() Экспорт

	// Дано
	МокКонфигуратор = Мок.Получить(Новый ДвижокКонфигуратор);
	Сервис = Новый БилдерСервисаПлатформы().СОдинаковымДвижком(МокКонфигуратор).Собрать();

	ПараметрыЗапуска = Новый Структура("КомандаЗапуска", "");

	// Когда
	Сервис.ЗапуститьПредприятие(Подключения.Файловая("C:\b"), ПараметрыЗапуска);

	// Тогда
	МокКонфигуратор.ПроверитьЧтоВызывалсяМетод().ЗапуститьПредприятие(Любое, Любое, Любое);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗапуститьПредприятие_ЧерезIbsrv_ПриФлагеИФайловойИБ() Экспорт

	// Дано
	МокКонфигуратор = Мок.Получить(Новый ДвижокКонфигуратор);
	МокАС = Мок.Получить(Новый СервисАвтономногоСервера);
	МокАС.Когда().НовыеПараметрыАС()
		.ТогдаВозвращает(Новый Структура("ИспользоватьПрямоеСоединение, ИспользоватьОтладку", Ложь, Ложь));
	МокАС.Когда().ЭтоФайловаяИБ(Любое).ТогдаВозвращает(Истина);
	МокАС.Когда().ЗапуститьСервер(Любое, Любое, Любое)
		.ТогдаВозвращает(Новый Структура("СтрокаПодключения, ПортHttp, ПортПрямой",
			"/WS http://localhost:8314/", 8314, 8341));

	Сервис = Новый БилдерСервисаПлатформы()
		.СОдинаковымДвижком(МокКонфигуратор)
		.САвтономнымСервером(МокАС)
		.Собрать();

	ПараметрыЗапуска = Новый Структура("ИспользоватьIbsrv", Истина);
	ПараметрыПодключения = Подключения.Файловая("C:\b");
	ПараметрыПодключения.Вставить("СтрокаПодключения", "/F""C:\b""");

	// Когда
	Сервис.ЗапуститьПредприятие(ПараметрыПодключения, ПараметрыЗапуска);

	// Тогда - поднят сервер, запущено предприятие, сервер остановлен
	МокАС.ПроверитьЧтоВызывалсяМетод().ЗапуститьСервер(Любое, Любое, Любое);
	МокКонфигуратор.ПроверитьЧтоВызывалсяМетод().ЗапуститьПредприятие(Любое, Любое, Любое);
	МокАС.ПроверитьЧтоВызывалсяМетод().ОстановитьСервер();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОстановитьIbsrv_ПриОшибкеЗапускаПредприятия() Экспорт

	// Дано
	МокКонфигуратор = Мок.Получить(Новый ДвижокКонфигуратор);
	МокКонфигуратор.Когда().ЗапуститьПредприятие(Любое, Любое, Любое)
		.ТогдаВыбрасываетИсключение("Ошибка запуска");

	МокАС = Мок.Получить(Новый СервисАвтономногоСервера);
	МокАС.Когда().НовыеПараметрыАС()
		.ТогдаВозвращает(Новый Структура("ИспользоватьПрямоеСоединение, ИспользоватьОтладку", Ложь, Ложь));
	МокАС.Когда().ЭтоФайловаяИБ(Любое).ТогдаВозвращает(Истина);
	МокАС.Когда().ЗапуститьСервер(Любое, Любое, Любое)
		.ТогдаВозвращает(Новый Структура("СтрокаПодключения, ПортHttp, ПортПрямой", "/WS http://x/", 1, 2));

	Сервис = Новый БилдерСервисаПлатформы()
		.СОдинаковымДвижком(МокКонфигуратор)
		.САвтономнымСервером(МокАС)
		.Собрать();

	ПараметрыЗапуска = Новый Структура("ИспользоватьIbsrv", Истина);
	ПараметрыПодключения = Подключения.Файловая("C:\b");
	ПараметрыПодключения.Вставить("СтрокаПодключения", "/F""C:\b""");

	// Когда / Тогда
	Попытка
		Сервис.ЗапуститьПредприятие(ПараметрыПодключения, ПараметрыЗапуска);
		ВызватьИсключение "Должно было упасть";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("Ошибка запуска");
	КонецПопытки;

	МокАС.ПроверитьЧтоВызывалсяМетод().ОстановитьСервер();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИгнорироватьIbsrv_ДляСервернойИБ() Экспорт

	// Дано
	МокКонфигуратор = Мок.Получить(Новый ДвижокКонфигуратор);
	МокАС = Мок.Получить(Новый СервисАвтономногоСервера);
	МокАС.Когда().ЭтоФайловаяИБ(Любое).ТогдаВозвращает(Ложь);

	Сервис = Новый БилдерСервисаПлатформы()
		.СОдинаковымДвижком(МокКонфигуратор)
		.САвтономнымСервером(МокАС)
		.Собрать();

	ПараметрыЗапуска = Новый Структура("ИспользоватьIbsrv", Истина);
	ПараметрыПодключения = Новый Структура("СтрокаПодключения, Пользователь, Пароль",
		"/S srv/db", "", "");

	// Когда
	Сервис.ЗапуститьПредприятие(ПараметрыПодключения, ПараметрыЗапуска);

	// Тогда - ibsrv проигнорирован, прямой запуск через движок
	МокКонфигуратор.ПроверитьЧтоВызывалсяМетод().ЗапуститьПредприятие(Любое, Любое, Любое);

КонецПроцедуры

