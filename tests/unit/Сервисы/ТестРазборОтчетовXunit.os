// BSLLS-off
// Юнит-тесты РазборОтчетовXunit: разбор устаревших опций --reportsxunit/--reportxunit
// в канонические форматы, общие с парой --report-format/--report-path.

#Использовать asserts

#Использовать "../../../src/core/Сервисы"

Перем Разбор;

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	Разбор = Новый РазборОтчетовXunit;
КонецПроцедуры

#Область Алиасы

&Тест
Процедура ТестДолжен_РазобратьАлиасJunit() Экспорт

	Отчеты = Разбор.Разобрать("jUnit{build/junit.xml}");

	Ожидаем.Что(Отчеты.Количество()).Равно(1);
	Ожидаем.Что(Отчеты[0].ИмяОпции).Равно("--reportsxunit");
	Ожидаем.Что(Отчеты[0].Формат, "алиас в нижнем регистре").Равно("junit");
	// путь приводится к абсолютному
	Ожидаем.Что(Отчеты[0].Путь).Равно(Новый Файл("build/junit.xml").ПолноеИмя);

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазобратьАлиасAllure() Экспорт

	Отчеты = Разбор.Разобрать("allure{build/allure}");

	Ожидаем.Что(Отчеты[0].Формат).Равно("allure");
	Ожидаем.Что(Разбор.ГенераторПоФормату(Отчеты[0].Формат)).Равно("ГенераторОтчетаAllureXMLВерсия2");

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазобратьНесколькоФорматов() Экспорт

	Отчеты = Разбор.Разобрать("junit{build/junit.xml};allure{build/allure};json{build/report.json}");

	Ожидаем.Что(Отчеты.Количество()).Равно(3);
	Ожидаем.Что(Отчеты[2].Формат).Равно("json");

КонецПроцедуры

#КонецОбласти

#Область ПолныеИмена

// Полное имя известного генератора сводится к алиасу: так отчёт сольётся с "junit" из общей пары.
&Тест
Процедура ТестДолжен_СвестиПолноеИмяГенератораКАлиасу() Экспорт

	Отчеты = Разбор.Разобрать("ГенераторОтчетаJUnitXML{build/junit.xml}");

	Ожидаем.Что(Отчеты[0].Формат).Равно("junit");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПринятьПроизвольныйПлагинГенератора() Экспорт

	Отчеты = Разбор.Разобрать("ГенераторОтчетаJUnitXML_TFS{build/tfs.xml}");

	Ожидаем.Что(Отчеты[0].Формат).Равно("ГенераторОтчетаJUnitXML_TFS");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗаменитьАнглийскийПрефиксГенератора() Экспорт

	Отчеты = Разбор.Разобрать("GenerateReportAllureXML{build/allure}");

	Ожидаем.Что(Отчеты[0].Формат).Равно("ГенераторОтчетаAllureXML");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СвестиАнглийскоеИмяИзвестногоГенератораКАлиасу() Экспорт

	Отчеты = Разбор.Разобрать("GenerateReportJUnitXML{build/junit.xml}");

	Ожидаем.Что(Отчеты[0].Формат).Равно("junit");

КонецПроцедуры

#КонецОбласти

#Область КаноническийФормат

&Тест
Процедура ТестДолжен_ПривестиАлиасКНижнемуРегистру() Экспорт

	Ожидаем.Что(Разбор.КаноническийФормат("JUnit")).Равно("junit");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СчитатьТриНаписанияJunitОднимФорматом() Экспорт

	Ожидаем.Что(Разбор.КаноническийФормат("junit")).Равно("junit");
	Ожидаем.Что(Разбор.КаноническийФормат("ГенераторОтчетаJUnitXML")).Равно("junit");
	Ожидаем.Что(Разбор.КаноническийФормат("GenerateReportJUnitXML")).Равно("junit");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьИмяНеизвестногоГенератора() Экспорт

	Ожидаем.Что(Разбор.КаноническийФормат("ГенераторОтчетаМой")).Равно("ГенераторОтчетаМой");
	Ожидаем.Что(Разбор.КаноническийФормат("GenerateReportМой")).Равно("ГенераторОтчетаМой");

КонецПроцедуры

&Тест
Процедура ТестДолжен_БроситьИсключение_КаноническийФорматНеизвестен() Экспорт

	Попытка
		Разбор.КаноническийФормат("HTML");
		ВызватьИсключение "должно было упасть";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("Неизвестный формат отчёта");
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область ГенераторПоФормату

&Тест
Процедура ТестДолжен_ВернутьГенераторПоАлиасу() Экспорт

	Ожидаем.Что(Разбор.ГенераторПоФормату("junit")).Равно("ГенераторОтчетаJUnitXML");
	Ожидаем.Что(Разбор.ГенераторПоФормату("GENERICEXECUTION")).Равно("ГенераторОтчетаGenericExecution");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьГенераторПоЕгоИмени() Экспорт

	Ожидаем.Что(Разбор.ГенераторПоФормату("ГенераторОтчетаМой")).Равно("ГенераторОтчетаМой");
	Ожидаем.Что(Разбор.ГенераторПоФормату("GenerateReportМой")).Равно("ГенераторОтчетаМой");

КонецПроцедуры

#КонецОбласти

#Область УстаревшаяОпцияReportxunit

&Тест
Процедура ТестДолжен_ДобавитьJunitОтчет_ИзУстаревшейОпции() Экспорт

	Отчеты = Разбор.Разобрать("", "build/reports");

	Ожидаем.Что(Отчеты.Количество()).Равно(1);
	Ожидаем.Что(Отчеты[0].ИмяОпции).Равно("--reportxunit");
	Ожидаем.Что(Отчеты[0].Формат).Равно("junit");
	Ожидаем.Что(Отчеты[0].Путь).Равно(Новый Файл("build/reports").ПолноеИмя);

КонецПроцедуры

// Повторы формата не схлопываются: --reportxunit идёт первым, чтобы при объединении
// (РазборПараметровОтчетов.Объединить, побеждает последний) его перекрыл --reportsxunit.
&Тест
Процедура ТестДолжен_ВернутьReportxunitПередReportsxunit() Экспорт

	Отчеты = Разбор.Разобрать("junit{build/new.xml}", "build/old");

	Ожидаем.Что(Отчеты.Количество()).Равно(2);
	Ожидаем.Что(Отчеты[0].ИмяОпции).Равно("--reportxunit");
	Ожидаем.Что(Отчеты[1].ИмяОпции).Равно("--reportsxunit");
	Ожидаем.Что(Отчеты[0].Формат, "один формат - один отчёт после объединения").Равно(Отчеты[1].Формат);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СлитьАлиасИПолноеИмя_ПриОбъединении() Экспорт

	Устаревшие = Разбор.Разобрать("junit{build/old.xml};ГенераторОтчетаJUnitXML{build/new.xml}", "build/oldest");

	Отчеты = Новый РазборПараметровОтчетов(Новый Соответствие).Объединить(Устаревшие, Новый Массив);

	Ожидаем.Что(Отчеты.Количество(), "три написания junit - один отчёт").Равно(1);
	Ожидаем.Что(Отчеты[0].Формат).Равно("junit");
	Ожидаем.Что(Отчеты[0].Путь, "побеждает последний").Содержит("new.xml");

КонецПроцедуры

#КонецОбласти

#Область ПустыеЗначения

&Тест
Процедура ТестДолжен_ВернутьПустойМассив_БезПараметров() Экспорт

	Ожидаем.Что(Разбор.Разобрать("").Количество()).Равно(0);
	Ожидаем.Что(Разбор.Разобрать(Неопределено, Неопределено).Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПропуститьПустыеСегменты() Экспорт

	Отчеты = Разбор.Разобрать("junit{build/junit.xml};");

	Ожидаем.Что(Отчеты.Количество()).Равно(1);

КонецПроцедуры

#КонецОбласти

#Область ОшибкиРазбора

&Тест
Процедура ТестДолжен_БроситьИсключение_ПриФорматеБезСкобок() Экспорт

	Попытка
		Разбор.Разобрать("jUnit:build/junit.xml");
		ВызватьИсключение "должно было упасть";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("Неверный формат параметра отчёта");
	КонецПопытки;

КонецПроцедуры

&Тест
Процедура ТестДолжен_БроситьИсключение_ПриНеизвестномФормате() Экспорт

	Попытка
		Разбор.Разобрать("HTML{build/report.html}");
		ВызватьИсключение "должно было упасть";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("Неизвестный формат отчёта");
	КонецПопытки;

КонецПроцедуры

&Тест
Процедура ТестДолжен_БроситьИсключение_ПриПустомПути() Экспорт

	Попытка
		Разбор.Разобрать("junit{}");
		ВызватьИсключение "должно было упасть";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("Не задан путь");
	КонецПопытки;

КонецПроцедуры

#КонецОбласти
