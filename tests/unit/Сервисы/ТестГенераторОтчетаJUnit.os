// BSLLS-off
// Юнит-тесты ГенераторОтчетаJUnit: структура отчёта JUnit XML, кейсы с failure и без,
// экранирование значений атрибутов. Отчёт читается обратно штатным ЧтениеXML.

#Использовать asserts
#Использовать tempfiles

#Использовать "../../../src/core/Сервисы"

Перем Генератор;

#Область СлужебныйПрограммныйИнтерфейс

&Тест
Процедура ТестДолжен_ЗаписатьУспешныйКейс_БезFailure() Экспорт

	Путь = ВременныеФайлы.НовоеИмяФайла("xml");
	Случаи = Новый Массив;
	Случаи.Добавить(Генератор.НовыйСлучай("Проверка прошла"));

	Провалено = Генератор.Записать(Путь, Случаи, 2);

	Отчет = Прочитать(Путь);
	Ожидаем.Что(Провалено, "проваленных").Равно(0);
	Ожидаем.Что(Отчет.Набор.Имя, "имя набора").Равно("suite");
	Ожидаем.Что(Отчет.Набор.Тестов, "tests").Равно("1");
	Ожидаем.Что(Отчет.Набор.Провалов, "failures").Равно("0");
	Ожидаем.Что(Отчет.Набор.Время, "time").Равно("2");
	Ожидаем.Что(Отчет.Кейсы.Количество(), "кейсов").Равно(1);
	Ожидаем.Что(Отчет.Кейсы[0].Имя).Равно("Проверка прошла");
	Ожидаем.Что(Отчет.Кейсы[0].ИмяКласса, "classname по умолчанию - имя набора").Равно("suite");
	Ожидаем.Что(Отчет.Кейсы[0].СообщениеОшибки, "без failure").Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗаписатьFailure_ТолькоДляПроваленныхКейсов() Экспорт

	Путь = ВременныеФайлы.НовоеИмяФайла("xml");
	Случаи = Новый Массив;
	Случаи.Добавить(Генератор.НовыйСлучай("Замечание 1", "suite.Категория"));
	Проваленный = Генератор.НовыйСлучай("Замечание 2");
	Проваленный.Провален = Истина;
	Проваленный.Сообщение = "Определения процедур должны идти после текста модуля";
	Случаи.Добавить(Проваленный);

	Провалено = Генератор.Записать(Путь, Случаи, 7);

	Отчет = Прочитать(Путь);
	Ожидаем.Что(Провалено, "проваленных").Равно(1);
	Ожидаем.Что(Отчет.Набор.Тестов).Равно("2");
	Ожидаем.Что(Отчет.Набор.Провалов).Равно("1");
	Ожидаем.Что(Отчет.Кейсы[0].ИмяКласса, "явный classname").Равно("suite.Категория");
	Ожидаем.Что(Отчет.Кейсы[0].СообщениеОшибки).Равно(Неопределено);
	Ожидаем.Что(Отчет.Кейсы[1].СообщениеОшибки).Равно("Определения процедур должны идти после текста модуля");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЭкранироватьСпецсимволыВАтрибутах() Экспорт

	Путь = ВременныеФайлы.НовоеИмяФайла("xml");
	Случай = Генератор.НовыйСлучай("{Обработка.X.Форма(1,2)}: ""кавычки"" & <скобки>");
	Случай.Провален = Истина;
	Случай.Сообщение = "a < b & c > d";
	Случаи = Новый Массив;
	Случаи.Добавить(Случай);

	Генератор.Записать(Путь, Случаи, 0);

	Отчет = Прочитать(Путь);
	Ожидаем.Что(Отчет.Кейсы[0].Имя).Равно("{Обработка.X.Форма(1,2)}: ""кавычки"" & <скобки>");
	Ожидаем.Что(Отчет.Кейсы[0].СообщениеОшибки).Равно("a < b & c > d");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПисатьХотяБыОдинТест_ДляПустогоСписка() Экспорт

	Путь = ВременныеФайлы.НовоеИмяФайла("xml");

	Генератор.Записать(Путь, Новый Массив, 1);

	Отчет = Прочитать(Путь);
	Ожидаем.Что(Отчет.Набор.Тестов, "tests не бывает 0").Равно("1");
	Ожидаем.Что(Отчет.Кейсы.Количество()).Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	Генератор = Новый ГенераторОтчетаJUnit("suite");
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Прочитать отчёт: атрибуты testsuite и список кейсов с сообщением failure (Неопределено - без failure).
Функция Прочитать(Знач Путь)

	Набор = Неопределено;
	Кейсы = Новый Массив;

	Чтение = Новый ЧтениеXML;
	Чтение.ОткрытьФайл(Путь);
	Пока Чтение.Прочитать() Цикл
		Если Чтение.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда
			Продолжить;
		КонецЕсли;
		Если Чтение.Имя = "testsuite" Тогда
			Набор = Новый Структура("Имя, Тестов, Провалов, Время",
				Чтение.ПолучитьАтрибут("name"), Чтение.ПолучитьАтрибут("tests"),
				Чтение.ПолучитьАтрибут("failures"), Чтение.ПолучитьАтрибут("time"));
		ИначеЕсли Чтение.Имя = "testcase" Тогда
			Кейсы.Добавить(Новый Структура("Имя, ИмяКласса, СообщениеОшибки",
				Чтение.ПолучитьАтрибут("name"), Чтение.ПолучитьАтрибут("classname"), Неопределено));
		ИначеЕсли Чтение.Имя = "failure" Тогда
			Кейсы[Кейсы.ВГраница()].СообщениеОшибки = Чтение.ПолучитьАтрибут("message");
		КонецЕсли;
	КонецЦикла;
	Чтение.Закрыть();

	Возврат Новый Структура("Набор, Кейсы", Набор, Кейсы);

КонецФункции

#КонецОбласти
