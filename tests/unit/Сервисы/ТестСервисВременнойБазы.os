// BSLLS-off
// Юнит-тесты СервисВременнойБазы: выбор движка по флагу ibcmd и жизненный цикл временной ИБ.
// Реальные движки не вызываются - СоздатьВременнуюБазу замокан.

#Использовать asserts
#Использовать moskito
#Использовать tempfiles

#Использовать "../../../src/core/Движки"
#Использовать "../../../src/core/Сервисы"
#Использовать "../utils"

Перем Подключения;
Перем Любое;
Перем Конфигуратор;
Перем Ibcmd;
Перем Сервис;

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт

	Подключения = Новый ДанныеПодключений;
	Любое = Матчеры.ЛюбоеЗначение();

	Конфигуратор = Мок.Получить(Новый ДвижокКонфигуратор);
	Ibcmd = Мок.Получить(Новый ДвижокIbcmd);

	Движки = Новый Соответствие;
	Движки.Вставить("ДвижокКонфигуратор", Конфигуратор);
	Движки.Вставить("ДвижокIbcmd", Ibcmd);
	Сервис = Новый БилдерСервисаВременнойБазы().СДвижками(Движки).Собрать();

КонецПроцедуры

#Область ВыборДвижка

&Тест
Процедура ТестДолжен_ВыбратьКонфигуратор_БезФлагаIbcmd() Экспорт

	Ожидаем.Что(Сервис.ВыбратьДвижок(Ложь)).Равно(Конфигуратор);
	Ожидаем.Что(Сервис.ВыбратьДвижок(Неопределено), "Неопределено = конфигуратор").Равно(Конфигуратор);
	Ожидаем.Что(Сервис.ВыбратьДвижок(""), "пустая строка из CLI = конфигуратор").Равно(Конфигуратор);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыбратьIbcmd_ПриФлаге() Экспорт

	Ожидаем.Что(Сервис.ВыбратьДвижок(Истина)).Равно(Ibcmd);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтдатьДвижкиПоИмени() Экспорт

	Ожидаем.Что(Сервис.ДвижокКонфигуратор()).Равно(Конфигуратор);
	Ожидаем.Что(Сервис.ДвижокIbcmd()).Равно(Ibcmd);

КонецПроцедуры

#КонецОбласти

#Область ПодготовкаИОчистка

&Тест
Процедура ТестДолжен_ВернутьПереданнуюБазу_БезСозданияВременной() Экспорт

	// Дано
	ПараметрыПодключения = Подключения.Файловая("C:\base");
	Конфигуратор.Когда().СоздатьВременнуюБазу(Любое)
		.ТогдаВыбрасываетИсключение("Временная база не должна создаваться");

	// Когда
	Контекст = Сервис.Подготовить(Конфигуратор, ПараметрыПодключения, Неопределено);

	// Тогда
	Ожидаем.Что(Контекст.Временная).ЭтоЛожь();
	Ожидаем.Что(Контекст.ПараметрыПодключения).Равно(ПараметрыПодключения);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьВременнуюБазу_ЕслиСтрокаПодключенияПуста() Экспорт

	// Дано
	Временная = Подключения.ВременнаяФайловая();
	Ibcmd.Когда().СоздатьВременнуюБазу(Любое).ТогдаВозвращает(Временная);
	ПараметрыПлатформы = Новый Структура("ВерсияПлатформы", "8.3.25");

	// Когда
	Контекст = Сервис.Подготовить(Ibcmd, Новый Структура("СтрокаПодключения", ""), ПараметрыПлатформы);

	// Тогда - база создана переданным движком с параметрами платформы
	Ожидаем.Что(Контекст.Временная).ЭтоИстина();
	Ожидаем.Что(Контекст.ПараметрыПодключения).Равно(Временная);
	Ibcmd.ПроверитьЧтоВызывалсяМетод().СоздатьВременнуюБазу(ПараметрыПлатформы);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьВременнуюБазу_ЕслиПараметрыНеПереданы() Экспорт

	Конфигуратор.Когда().СоздатьВременнуюБазу(Любое).ТогдаВозвращает(Подключения.ВременнаяФайловая());

	Контекст = Сервис.Подготовить(Конфигуратор, Неопределено, Неопределено);

	Ожидаем.Что(Контекст.Временная).ЭтоИстина();
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().СоздатьВременнуюБазу(Любое);

КонецПроцедуры

&Тест
Процедура ТестДолжен_УдалитьКаталогВременнойБазы_ПриОчистке() Экспорт

	// Дано
	Временная = Подключения.ВременнаяФайловая();
	Конфигуратор.Когда().СоздатьВременнуюБазу(Любое).ТогдаВозвращает(Временная);
	Контекст = Сервис.Подготовить(Конфигуратор, Неопределено, Неопределено);

	// Когда
	Сервис.Очистить(Контекст);

	// Тогда
	Ожидаем.Что(Новый Файл(Временная.КаталогБазы).Существует(), "каталог временной ИБ удалён").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеТрогатьПереданнуюБазу_ПриОчистке() Экспорт

	// Дано
	Каталог = ВременныеФайлы.СоздатьКаталог();
	Контекст = Сервис.Подготовить(Конфигуратор, Подключения.Файловая(Каталог), Неопределено);

	// Когда
	Сервис.Очистить(Контекст);

	// Тогда
	Ожидаем.Что(Новый Файл(Каталог).Существует(), "чужая база не удаляется").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеПадать_ЕслиКаталогВременнойБазыУжеУдалён() Экспорт

	Временная = Подключения.ВременнаяФайловая();
	Конфигуратор.Когда().СоздатьВременнуюБазу(Любое).ТогдаВозвращает(Временная);
	Контекст = Сервис.Подготовить(Конфигуратор, Неопределено, Неопределено);
	УдалитьФайлы(Временная.КаталогБазы);

	Сервис.Очистить(Контекст);

	Ожидаем.Что(Новый Файл(Временная.КаталогБазы).Существует()).ЭтоЛожь();

КонецПроцедуры

#КонецОбласти
