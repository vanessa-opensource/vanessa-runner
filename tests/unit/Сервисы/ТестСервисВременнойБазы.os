// BSLLS-off
// Юнит-тесты СервисВременнойБазы: выбор движка по признаку ibcmd в параметрах платформы и жизненный цикл временной ИБ.
// Движки замоканы, СоздатьВременнуюБазу отдаёт настоящий временный каталог (пресет).

#Использовать asserts
#Использовать moskito
#Использовать tempfiles
#Использовать "../utils"

Перем Стенд;
Перем Сервис;
Перем Конфигуратор; // мок ДвижокКонфигуратор из соответствия движков сервиса
Перем Ibcmd;        // мок ДвижокIbcmd
Перем Любое;

&ПередКаждым
Процедура ПередКаждым() Экспорт
	Стенд = Новый Стенд;
	Сервис = Стенд.Сервис("СервисВременнойБазы");
	Конфигуратор = Стенд.Мок("ДвижокКонфигуратор");
	Ibcmd = Стенд.Мок("ДвижокIbcmd");
	Любое = Матчеры.ЛюбоеЗначение();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт
	ВременныеФайлы.Удалить();
КонецПроцедуры

#Область ВыбратьДвижок

&Тест
Процедура ТестДолжен_ВыбратьКонфигуратор_БезПараметровПлатформы() Экспорт

	Ожидаем.Что(Сервис.ВыбратьДвижок(Неопределено)).Равно(Конфигуратор);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыбратьКонфигуратор_БезПризнакаIbcmd() Экспорт

	Ожидаем.Что(Сервис.ВыбратьДвижок(Новый Структура("ВерсияПлатформы", "8.3.25"))).Равно(Конфигуратор);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыбратьКонфигуратор_ЕслиIbcmdВыключен() Экспорт

	Ожидаем.Что(Сервис.ВыбратьДвижок(ТестовыеДанные.ПараметрыПлатформы(Ложь))).Равно(Конфигуратор);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыбратьIbcmd_ЕслиIbcmdВключен() Экспорт

	Ожидаем.Что(Сервис.ВыбратьДвижок(ТестовыеДанные.ПараметрыПлатформы(Истина))).Равно(Ibcmd);

КонецПроцедуры

#КонецОбласти

#Область ДвижокКонфигуратор_ДвижокIbcmd

&Тест
Процедура ТестДолжен_ОтдатьДвижкиПоИмени() Экспорт

	Ожидаем.Что(Сервис.ДвижокКонфигуратор()).Равно(Конфигуратор);
	Ожидаем.Что(Сервис.ДвижокIbcmd()).Равно(Ibcmd);

КонецПроцедуры

#КонецОбласти

#Область Подготовить

&Тест
Процедура ТестДолжен_ВернутьПереданнуюБазу_БезСозданияВременной() Экспорт

	// Дано
	База = ТестовыеДанные.Файловая("base");

	// Когда
	Контекст = Сервис.Подготовить(Конфигуратор, База, Неопределено);

	// Тогда
	Ожидаем.Что(Контекст.Временная).ЭтоЛожь();
	Ожидаем.Что(Контекст.ПараметрыПодключения).Равно(База);
	Стенд.ПроверитьЧтоНеВызывался("ДвижокКонфигуратор", "СоздатьВременнуюБазу");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьВременнуюБазу_ЕслиСтрокаПодключенияПуста() Экспорт

	// Дано
	Временная = ТестовыеДанные.ВременнаяФайловая();
	Ibcmd.Когда().СоздатьВременнуюБазу(Любое).ТогдаВозвращает(Временная);
	ПараметрыПлатформы = Новый Структура("ВерсияПлатформы", "8.3.25");

	// Когда
	Контекст = Сервис.Подготовить(Ibcmd, ТестовыеДанные.Подключение(""), ПараметрыПлатформы);

	// Тогда - база создана переданным движком с параметрами платформы
	Ожидаем.Что(Контекст.Временная).ЭтоИстина();
	Ожидаем.Что(Контекст.ПараметрыПодключения).Равно(Временная);
	Ibcmd.ПроверитьЧтоВызывалсяМетод().СоздатьВременнуюБазу(ПараметрыПлатформы);
	Стенд.ПроверитьЧтоНеВызывался("ДвижокКонфигуратор", "СоздатьВременнуюБазу");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьВременнуюБазу_ЕслиПараметрыНеПереданы() Экспорт

	// Когда
	Контекст = Сервис.Подготовить(Конфигуратор, Неопределено, Неопределено);

	// Тогда
	Ожидаем.Что(Контекст.Временная).ЭтоИстина();
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().СоздатьВременнуюБазу(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область Очистить

&Тест
Процедура ТестДолжен_УдалитьКаталогВременнойБазы_ПриОчистке() Экспорт

	// Дано - пресет движка создаёт настоящий временный каталог
	Контекст = Сервис.Подготовить(Конфигуратор, Неопределено, Неопределено);
	Каталог = Контекст.ПараметрыПодключения.КаталогБазы;
	Ожидаем.Что(ТестовыеФайлы.Существует(Каталог), "каталог временной ИБ создан").ЭтоИстина();

	// Когда
	Сервис.Очистить(Контекст);

	// Тогда
	Ожидаем.Что(ТестовыеФайлы.Существует(Каталог), "каталог временной ИБ удалён").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеТрогатьПереданнуюБазу_ПриОчистке() Экспорт

	// Дано
	Каталог = ВременныеФайлы.СоздатьКаталог();
	Контекст = Сервис.Подготовить(Конфигуратор, ТестовыеДанные.Файловая(Каталог), Неопределено);

	// Когда
	Сервис.Очистить(Контекст);

	// Тогда
	Ожидаем.Что(ТестовыеФайлы.Существует(Каталог), "чужая база не удаляется").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеПадать_ЕслиКаталогВременнойБазыУжеУдалён() Экспорт

	// Дано
	Контекст = Сервис.Подготовить(Конфигуратор, Неопределено, Неопределено);
	Каталог = Контекст.ПараметрыПодключения.КаталогБазы;
	УдалитьФайлы(Каталог);

	// Когда
	Сервис.Очистить(Контекст);

	// Тогда
	Ожидаем.Что(ТестовыеФайлы.Существует(Каталог)).ЭтоЛожь();

КонецПроцедуры

#КонецОбласти
