// BSLLS-off
// Юнит-тесты РазборПараметровОтчетов: пара опций --report-format / --report-path - словарь форматов,
// разрешение пути (один формат - как есть, несколько - каталог с именами по соглашению), открытый словарь
// для генераторов Vanessa-ADD через РазборОтчетовXunit, объединение с устаревшими опциями,
// в том числе у команды с одним отчётом за прогон.

#Использовать asserts
#Использовать "../../../src/core/Сервисы"
#Использовать "../utils"

Перем Разбор;
Перем РазборОткрытый;

&ПередКаждым
Процедура ПередКаждым() Экспорт
	Разбор = Новый РазборПараметровОтчетов(СловарьФорматов(), "junit");
	РазборОткрытый = Новый РазборПараметровОтчетов(СловарьФорматов(), "junit", Новый РазборОтчетовXunit);
КонецПроцедуры

#Область Разобрать

&Тест
Процедура ТестДолжен_ВернутьПустойСписок_БезФорматаИПути() Экспорт

	Ожидаем.Что(Разбор.Разобрать(Неопределено, "").Количество(), "отчётов").Равно(0);
	Ожидаем.Что(Разбор.Разобрать(Новый Массив, Неопределено).Количество(), "отчётов").Равно(0);

КонецПроцедуры

// Один формат - путь пользователя берётся как есть: он сам решает, файл это или каталог.
&Тест
Процедура ТестДолжен_ВзятьПутьКакЕсть_ДляОдногоФормата() Экспорт

	Отчеты = Разбор.Разобрать(ТестовыеДанные.Массив("junit"), "build/reports/syntax.xml");

	Ожидаем.Что(Отчеты.Количество(), "отчётов").Равно(1);
	Ожидаем.Что(Отчеты[0].Формат, "формат").Равно("junit");
	Ожидаем.Что(Отчеты[0].Путь, "путь").Равно(ПолныйПуть("build/reports/syntax.xml"));

КонецПроцедуры

// Несколько форматов в один файл не положить - путь становится каталогом,
// а имена внутри берутся из словаря.
&Тест
Процедура ТестДолжен_РазложитьПоКаталогу_ДляНесколькихФорматов() Экспорт

	Отчеты = Разбор.Разобрать(ТестовыеДанные.Массив("junit", "allure"), "build/reports");

	Ожидаем.Что(Отчеты.Количество(), "отчётов").Равно(2);
	Ожидаем.Что(Отчеты[0].Путь, "путь junit")
		.Равно(ПолныйПуть(ОбъединитьПути("build/reports", "junit.xml")));
	Ожидаем.Что(Отчеты[1].Путь, "путь allure")
		.Равно(ПолныйПуть(ОбъединитьПути("build/reports", "allure")));

КонецПроцедуры

&Тест
Процедура ТестДолжен_УпастьНаНесколькихФорматахБезПути() Экспорт

	Ожидаем.Что(Разбор).Метод("Разобрать", ТестовыеДанные.Массив(ТестовыеДанные.Массив("junit", "allure"), ""))
		.ВыбрасываетИсключение("--report-path");

КонецПроцедуры

// Путь без формата - подставляем формат команды по умолчанию: "--report-path junit.xml"
// читается однозначно и экономит пользователю половину строки.
&Тест
Процедура ТестДолжен_ПодставитьФорматПоУмолчанию_ЕслиЗаданТолькоПуть() Экспорт

	Отчеты = Разбор.Разобрать(Новый Массив, "build/syntax.xml");

	Ожидаем.Что(Отчеты.Количество(), "отчётов").Равно(1);
	Ожидаем.Что(Отчеты[0].Формат, "формат по умолчанию").Равно("junit");

КонецПроцедуры

&Тест
Процедура ТестДолжен_УпастьНаПутиБезФормата_ЕслиУмолчанияНет() Экспорт

	БезУмолчания = Новый РазборПараметровОтчетов(СловарьФорматов());

	Ожидаем.Что(БезУмолчания).Метод("Разобрать", ТестовыеДанные.Массив(Новый Массив, "build/syntax.xml"))
		.ВыбрасываетИсключение("--report-format");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьПустойПуть_ЕслиПутьНеЗадан() Экспорт

	Отчеты = Разбор.Разобрать(ТестовыеДанные.Массив("junit"), "");

	Ожидаем.Что(Отчеты.Количество(), "отчётов").Равно(1);
	Ожидаем.Что(Отчеты[0].Путь, "путь").Равно("");

КонецПроцедуры

// В сообщении должен быть список доступных форматов - иначе пользователь гадает.
&Тест
Процедура ТестДолжен_УпастьНаНеизвестномФормате() Экспорт

	Ожидаем.Что(Разбор).Метод("Разобрать", ТестовыеДанные.Массив(ТестовыеДанные.Массив("cobertura"), "build/reports"))
		.ВыбрасываетИсключение("junit");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПривестиСловарныйФорматКНижнемуРегистру() Экспорт

	Отчеты = Разбор.Разобрать(ТестовыеДанные.Массив("jUnit"), "build/syntax.xml");

	Ожидаем.Что(Отчеты[0].Формат, "формат").Равно("junit");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СхлопнутьПовторыФорматов() Экспорт

	Отчеты = Разбор.Разобрать(ТестовыеДанные.Массив("junit", "JUNIT", "junit"), "build/syntax.xml");

	Ожидаем.Что(Отчеты.Количество(), "отчётов").Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПропуститьПустыеЗначенияФормата() Экспорт

	Отчеты = Разбор.Разобрать(ТестовыеДанные.Массив("", "  ", "junit"), "build/syntax.xml");

	Ожидаем.Что(Отчеты.Количество(), "отчётов").Равно(1);
	Ожидаем.Что(Отчеты[0].Формат, "формат").Равно("junit");

КонецПроцедуры

// Открытый словарь нужен xUnitFor1C: генераторы Vanessa-ADD расширяемы плагинами,
// и их имена регистрозависимы - в отличие от словарных алиасов их нельзя занижать.
// Чужие форматы отдаются разбору чужих форматов (здесь - РазборОтчетовXunit).
&Тест
Процедура ТестДолжен_ПропуститьЧужойФормат_ПриОткрытомСловаре() Экспорт

	Отчеты = РазборОткрытый.Разобрать(ТестовыеДанные.Массив("ГенераторОтчетаМой"), "build/report.xml");

	Ожидаем.Что(Отчеты.Количество(), "отчётов").Равно(1);
	Ожидаем.Что(Отчеты[0].Формат, "регистр чужого формата сохранён").Равно("ГенераторОтчетаМой");

КонецПроцедуры

// Полное имя известного генератора - тот же формат, что и словарный алиас: путь и имя файла
// разрешаются по алиасу, а с отчётом устаревшей опции "junit" он сливается в один.
&Тест
Процедура ТестДолжен_СвестиЧужойФорматКСловарному_ЧерезРазборЧужихФорматов() Экспорт

	Отчеты = РазборОткрытый.Разобрать(ТестовыеДанные.Массив("ГенераторОтчетаJUnitXML", "allure"), "build/reports");

	Ожидаем.Что(Отчеты[0].Формат, "формат").Равно("junit");
	Ожидаем.Что(Отчеты[0].Путь, "имя файла по словарю")
		.Равно(ПолныйПуть(ОбъединитьПути("build/reports", "junit.xml")));

КонецПроцедуры

&Тест
Процедура ТестДолжен_СхлопнутьРазныеНаписанияОдногоФормата() Экспорт

	Отчеты = РазборОткрытый.Разобрать(ТестовыеДанные.Массив("junit", "GenerateReportJUnitXML", "ГенераторОтчетаJUnitXML"),
		"build/junit.xml");

	Ожидаем.Что(Отчеты.Количество(), "отчётов").Равно(1);
	Ожидаем.Что(Отчеты[0].Путь, "один формат - путь как есть").Равно(ПолныйПуть("build/junit.xml"));

КонецПроцедуры

&Тест
Процедура ТестДолжен_УпастьНаНеизвестномФормате_ПриОткрытомСловаре() Экспорт

	Ожидаем.Что(РазборОткрытый).Метод("Разобрать", ТестовыеДанные.Массив(ТестовыеДанные.Массив("HTML"), "build/report.html"))
		.ВыбрасываетИсключение("Неизвестный формат отчёта");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИспользоватьИмяФормата_КакИмяФайлаЧужогоФормата() Экспорт

	Отчеты = РазборОткрытый.Разобрать(ТестовыеДанные.Массив("junit", "ГенераторОтчетаМой"), "build/reports");

	Ожидаем.Что(Отчеты[1].Путь, "путь чужого формата")
		.Равно(ПолныйПуть(ОбъединитьПути("build/reports", "ГенераторОтчетаМой")));

КонецПроцедуры

#КонецОбласти

#Область Объединить

// Устаревшие опции и общая пара складываются, при совпадении формата побеждает общая пара.
&Тест
Процедура ТестДолжен_ОбъединитьОтчеты_СПриоритетомОбщейПары() Экспорт

	Устаревшие = ТестовыеДанные.Массив(Отчет("junit", "old.xml"));
	Новые = ТестовыеДанные.Массив(Отчет("junit", "new.xml"), Отчет("allure", "allure-results"));

	Отчеты = Разбор.Объединить(Устаревшие, Новые);

	Ожидаем.Что(Отчеты.Количество(), "отчётов").Равно(2);
	Ожидаем.Что(Отчеты[0].Формат, "первым - формат из устаревшей опции").Равно("junit");
	Ожидаем.Что(Отчеты[0].Путь, "путь общей пары перекрыл устаревший").Равно("new.xml");
	Ожидаем.Что(Отчеты[1].Формат).Равно("allure");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьОтчетУстаревшейОпции_БезОбщейПары() Экспорт

	Отчеты = Разбор.Объединить(ТестовыеДанные.Массив(Отчет("allure", "results")), Новый Массив);

	Ожидаем.Что(Отчеты.Количество(), "отчётов").Равно(1);
	Ожидаем.Что(Отчеты[0].Путь).Равно("results");

КонецПроцедуры

// --junitpath x --report-format junit без --report-path: путь устаревшей опции не теряется.
&Тест
Процедура ТестДолжен_СохранитьПутьУстаревшейОпции_ЕслиУОбщейПарыНетПути() Экспорт

	Устаревшие = ТестовыеДанные.Массив(Отчет("junit", "old.xml"));
	Новые = ТестовыеДанные.Массив(Отчет("junit", ""));

	Отчеты = Разбор.Объединить(Устаревшие, Новые);

	Ожидаем.Что(Отчеты.Количество(), "отчётов").Равно(1);
	Ожидаем.Что(Отчеты[0].Путь, "пустой путь общей пары не затёр устаревший").Равно("old.xml");

КонецПроцедуры

&Тест
Процедура ТестДолжен_УпастьПриОбъединении_ЕслиУОтчетаНетПути() Экспорт

	Ожидаем.Что(Разбор).Метод("Объединить", ТестовыеДанные.Массив(Новый Массив, ТестовыеДанные.Массив(Отчет("junit", ""))))
		.ВыбрасываетИсключение("--report-path");

КонецПроцедуры

// Один отчёт за прогон (YAxUnit): путь устаревшей опции подходит отчёту любого формата.
&Тест
Процедура ТестДолжен_ВзятьПутьУстаревшейОпции_ДляДругогоФормата_ПриОдномОтчете() Экспорт

	Устаревшие = ТестовыеДанные.Массив(Отчет("junit", "old.xml"));
	Новые = ТестовыеДанные.Массив(Отчет("json", ""));

	Отчеты = Разбор.Объединить(Устаревшие, Новые, Истина);

	Ожидаем.Что(Отчеты.Количество(), "отчётов").Равно(1);
	Ожидаем.Что(Отчеты[0].Формат, "формат общей пары").Равно("json");
	Ожидаем.Что(Отчеты[0].Путь, "путь устаревшей опции").Равно("old.xml");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПредпочестьПутьОбщейПары_ПриОдномОтчете() Экспорт

	Устаревшие = ТестовыеДанные.Массив(Отчет("junit", "old.xml"));
	Новые = ТестовыеДанные.Массив(Отчет("junit", "new.xml"));

	Отчеты = Разбор.Объединить(Устаревшие, Новые, Истина);

	Ожидаем.Что(Отчеты.Количество(), "отчётов").Равно(1);
	Ожидаем.Что(Отчеты[0].Путь, "путь общей пары").Равно("new.xml");

КонецПроцедуры

// Без пути отчёт пишет сам инструмент (YAxUnit - во временный файл), это не ошибка настройки.
&Тест
Процедура ТестДолжен_ОставитьОтчетБезПути_ПриОдномОтчете() Экспорт

	Отчеты = Разбор.Объединить(Новый Массив, ТестовыеДанные.Массив(Отчет("json", "")), Истина);

	Ожидаем.Что(Отчеты.Количество(), "отчётов").Равно(1);
	Ожидаем.Что(Отчеты[0].Путь, "путь").Равно("");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВзятьОтчетУстаревшейОпции_ПриОдномОтчетеБезОбщейПары() Экспорт

	Отчеты = Разбор.Объединить(ТестовыеДанные.Массив(Отчет("junit", "old.xml")), Новый Массив, Истина);

	Ожидаем.Что(Отчеты.Количество(), "отчётов").Равно(1);
	Ожидаем.Что(Отчеты[0].Путь, "путь").Равно("old.xml");

КонецПроцедуры

// Устаревшая --report у test yaxunit задаёт только путь: формат - по умолчанию.
&Тест
Процедура ТестДолжен_ПодставитьФорматПоУмолчанию_ДляУстаревшейОпцииБезФормата_ПриОдномОтчете() Экспорт

	Отчеты = Разбор.Объединить(ТестовыеДанные.Массив(Отчет("", "old.xml")), Новый Массив, Истина);

	Ожидаем.Что(Отчеты.Количество(), "отчётов").Равно(1);
	Ожидаем.Что(Отчеты[0].Формат, "формат по умолчанию").Равно("junit");
	Ожидаем.Что(Отчеты[0].Путь, "путь").Равно("old.xml");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьОдинОтчет_ИзНесколькихУстаревших_ПриОдномОтчете() Экспорт

	Устаревшие = ТестовыеДанные.Массив(Отчет("junit", "first.xml"), Отчет("junit", "second.xml"));

	Отчеты = Разбор.Объединить(Устаревшие, Новый Массив, Истина);

	Ожидаем.Что(Отчеты.Количество(), "отчётов").Равно(1);
	Ожидаем.Что(Отчеты[0].Путь, "первая устаревшая опция").Равно("first.xml");

КонецПроцедуры

&Тест
Процедура ТестДолжен_УпастьНаНесколькихФорматах_ПриОдномОтчете() Экспорт

	Новые = ТестовыеДанные.Массив(Отчет("junit", "build/junit.xml"), Отчет("json", "build/report.json"));

	Ожидаем.Что(Разбор).Метод("Объединить", ТестовыеДанные.Массив(Новый Массив, Новые, Истина))
		.ВыбрасываетИсключение("один отчёт за прогон");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СловарьФорматов()
	Форматы = Новый Соответствие;
	Форматы.Вставить("junit", "junit.xml");
	Форматы.Вставить("allure", "allure");
	Возврат Форматы;
КонецФункции

Функция Отчет(Знач Формат, Знач Путь)
	Возврат Новый Структура("Формат, Путь", Формат, Путь);
КонецФункции

Функция ПолныйПуть(Знач Путь)
	Возврат Новый Файл(Путь).ПолноеИмя;
КонецФункции

#КонецОбласти
