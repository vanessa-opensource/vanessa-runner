// BSLLS-off
// Юнит-тесты РазборЗамечанийEDT: разбор .tsv-результата 1cedtcli validate, ранги важности, пороги
// --min-severity, отбор по порогу и важность Allure. Внешних зависимостей нет.

#Использовать asserts
#Использовать tempfiles
#Использовать "../../../src/core/Сервисы"
#Использовать "../utils"

Перем Разбор;

&ПередКаждым
Процедура ПередКаждым() Экспорт
	Разбор = Новый РазборЗамечанийEDT;
КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт
	ВременныеФайлы.Удалить();
КонецПроцедуры

#Область Разобрать

&Тест
Процедура ТестДолжен_РазобратьСтрокиTSV_ПропустивПустые() Экспорт

	// Дано - полная строка, пустые строки и строка с тремя колонками
	Строки = Новый Массив;
	Строки.Добавить(СтрСоединить(ТестовыеДанные.Массив("2026-01-01T00:00:00+0300", "Критическая", "Ошибки",
		"Проект", "check-id", "Справочник.Товары", "строка 5", "Текст замечания"), Символы.Таб));
	Строки.Добавить("   ");
	Строки.Добавить("");
	Строки.Добавить(СтрСоединить(ТестовыеДанные.Массив("2026-01-02", " Незначительная ", "Стандарты"), Символы.Таб));
	ФайлTSV = ТестовыеФайлы.ВременныйФайл("tsv", СтрСоединить(Строки, Символы.ПС));

	// Когда
	Замечания = Разбор.Разобрать(ФайлTSV);

	// Тогда
	Ожидаем.Что(Замечания, "пустые строки пропущены").ИмеетДлину(2);
	Ожидаем.Что(Замечания[0].Дата).Равно("2026-01-01T00:00:00+0300");
	Ожидаем.Что(Замечания[0].Важность).Равно("Критическая");
	Ожидаем.Что(Замечания[0].Категория).Равно("Ошибки");
	Ожидаем.Что(Замечания[0].Проект).Равно("Проект");
	Ожидаем.Что(Замечания[0].Проверка).Равно("check-id");
	Ожидаем.Что(Замечания[0].Объект).Равно("Справочник.Товары");
	Ожидаем.Что(Замечания[0].Место).Равно("строка 5");
	Ожидаем.Что(Замечания[0].Описание).Равно("Текст замечания");
	Ожидаем.Что(Замечания[1].Важность, "поле без пробелов по краям").Равно("Незначительная");
	Ожидаем.Что(Замечания[1].Категория).Равно("Стандарты");
	Ожидаем.Что(Замечания[1].Объект, "недостающая колонка - пустая").Равно("");
	Ожидаем.Что(Замечания[1].Описание, "недостающая колонка - пустая").Равно("");

КонецПроцедуры

#КонецОбласти

#Область РангВажности

&Тест
Процедура ТестДолжен_ОпределитьРанг_ПоВажности() Экспорт

	Ожидаем.Что(Разбор.РангВажности("Критическая")).Равно(3);
	Ожидаем.Что(Разбор.РангВажности(" КРИТИЧЕСКАЯ "), "без учёта регистра и пробелов").Равно(3);
	Ожидаем.Что(Разбор.РангВажности("Значительная")).Равно(2);
	Ожидаем.Что(Разбор.РангВажности("Незначительная")).Равно(1);
	Ожидаем.Что(Разбор.РангВажности("Неизвестная"), "неизвестная - значительная").Равно(2);

КонецПроцедуры

#КонецОбласти

#Область ПорогУровня

&Тест
Процедура ТестДолжен_ОпределитьПорог_ПоУровню() Экспорт

	Ожидаем.Что(Разбор.ПорогУровня("critical")).Равно(3);
	Ожидаем.Что(Разбор.ПорогУровня("major")).Равно(2);
	Ожидаем.Что(Разбор.ПорогУровня("minor")).Равно(1);
	Ожидаем.Что(Разбор.ПорогУровня("none"), "недостижимый порог").Равно(999);
	Ожидаем.Что(Разбор.ПорогУровня(""), "по умолчанию - major").Равно(2);

КонецПроцедуры

#КонецОбласти

#Область ОтобратьПоПорогу

&Тест
Процедура ТестДолжен_ОтобратьЗамечания_НеНижеПорога() Экспорт

	// Дано
	Замечания = ТестовыеДанные.Массив(Замечание("Незначительная"), Замечание("Критическая"), Замечание("Значительная"));

	// Когда
	Критические = Разбор.ОтобратьПоПорогу(Замечания, Разбор.ПорогУровня("critical"));

	// Тогда
	Ожидаем.Что(Критические).ИмеетДлину(1);
	Ожидаем.Что(Критические[0].Важность).Равно("Критическая");
	Ожидаем.Что(Разбор.ОтобратьПоПорогу(Замечания, Разбор.ПорогУровня("major"))).ИмеетДлину(2);
	Ожидаем.Что(Разбор.ОтобратьПоПорогу(Замечания, Разбор.ПорогУровня("minor"))).ИмеетДлину(3);
	Ожидаем.Что(Разбор.ОтобратьПоПорогу(Замечания, Разбор.ПорогУровня("none"))).ИмеетДлину(0);

КонецПроцедуры

#КонецОбласти

#Область ВажностьAllure

&Тест
Процедура ТестДолжен_ОпределитьВажностьAllure_ПоРангу() Экспорт

	Ожидаем.Что(Разбор.ВажностьAllure(3)).Равно("critical");
	Ожидаем.Что(Разбор.ВажностьAllure(2)).Равно("normal");
	Ожидаем.Что(Разбор.ВажностьAllure(1)).Равно("minor");
	Ожидаем.Что(Разбор.ВажностьAllure(999), "ранг вне 1..3 - normal").Равно("normal");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Замечание(Знач Важность)
	Возврат Новый Структура("Важность", Важность);
КонецФункции

#КонецОбласти
