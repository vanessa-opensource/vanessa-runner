// BSLLS-off
// Юнит-тесты СтекОсвобождения: обратный порядок освобождения, метод отмены по умолчанию,
// ошибки освобождения при Завершить и Отменить, повторный вызов. Владельцы ресурсов - моки стенда.

#Использовать asserts
#Использовать logos
#Использовать moskito
#Использовать "../utils"

Перем Стенд;
Перем Ресурсы;
Перем База; // мок СервисВременнойБазы
Перем EDT;  // мок СервисEDT
Перем Любое;

&ПередКаждым
Процедура ПередКаждым() Экспорт
	Стенд = Новый Стенд;
	Ресурсы = Новый СтекОсвобождения(Логирование.ПолучитьЛог("test"));
	База = Стенд.Мок("СервисВременнойБазы");
	EDT = Стенд.Мок("СервисEDT");
	Любое = Матчеры.ЛюбоеЗначение();
КонецПроцедуры

#Область Завершить

&Тест
Процедура ТестДолжен_ЗавершитьВОбратномПорядке() Экспорт

	// Дано
	Ресурсы.Добавить(База, "первая", "Очистить");
	Ресурсы.Добавить(База, "вторая", "Очистить");

	// Когда
	Ресурсы.Завершить();

	// Тогда
	Ожидаем.Что(ОчищенныеБазы()).Равно("вторая, первая");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗавершитьМетодомЗавершения_ЕслиМетодОтменыЗадан() Экспорт

	// Дано
	Ресурсы.Добавить(EDT, "выгрузка", "ЗавершитьВыгрузку", "ПрерватьВыгрузку");

	// Когда
	Ресурсы.Завершить();

	// Тогда
	EDT.ПроверитьЧтоВызывалсяМетод().ЗавершитьВыгрузку("выгрузка");
	Стенд.ПроверитьЧтоНеВызывался("СервисEDT", "ПрерватьВыгрузку");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтменитьОстальныеИПробросить_ПриОшибкеЗавершения() Экспорт

	// Дано - очистка базы падает, прерывание выгрузки тоже
	Ресурсы.Добавить(EDT, "выгрузка", "ЗавершитьВыгрузку", "ПрерватьВыгрузку");
	Ресурсы.Добавить(База, "база", "Очистить");
	База.Когда().Очистить(Любое).ТогдаВыбрасываетИсключение("Ошибка очистки");
	EDT.Когда().ПрерватьВыгрузку(Любое).ТогдаВыбрасываетИсключение("Ошибка прерывания");

	// Когда / Тогда - проброшена исходная ошибка, выгрузка прервана, а не завершена
	Ожидаем.Что(Ресурсы).Метод("Завершить").ВыбрасываетИсключение("Ошибка очистки");
	EDT.ПроверитьЧтоВызывалсяМетод().ПрерватьВыгрузку("выгрузка");
	Стенд.ПроверитьЧтоНеВызывался("СервисEDT", "ЗавершитьВыгрузку");
	Ожидаем.Что(Стенд.Вызовы("СервисВременнойБазы", "Очистить"), "упавший ресурс не освобождается повторно").ИмеетДлину(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВызватьМетодБезПараметров_ЕслиКонтекстНеЗадан() Экспорт

	// Дано
	АС = Стенд.Мок("СервисАвтономногоСервера");
	Ресурсы.Добавить(АС, Неопределено, "ОстановитьСервер");

	// Когда
	Ресурсы.Завершить();

	// Тогда
	АС.ПроверитьЧтоВызывалсяМетод().ОстановитьСервер();

КонецПроцедуры

#КонецОбласти

#Область Отменить

&Тест
Процедура ТестДолжен_ОтменитьВОбратномПорядке() Экспорт

	// Дано
	Ресурсы.Добавить(База, "первая", "Очистить");
	Ресурсы.Добавить(База, "вторая", "Очистить");

	// Когда
	Ресурсы.Отменить();

	// Тогда
	Ожидаем.Что(ОчищенныеБазы()).Равно("вторая, первая");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтменитьМетодомЗавершения_ЕслиМетодОтменыНеЗадан() Экспорт

	// Дано
	Ресурсы.Добавить(EDT, "xml", "ЗавершитьXML");

	// Когда
	Ресурсы.Отменить();

	// Тогда
	EDT.ПроверитьЧтоВызывалсяМетод().ЗавершитьXML("xml");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОсвободитьОстальные_ПриОшибкеОтмены() Экспорт

	// Дано
	Лог = Мок.Следить(Логирование.ПолучитьЛог("test"));
	Ресурсы = Новый СтекОсвобождения(Лог);
	Ресурсы.Добавить(EDT, "выгрузка", "ЗавершитьВыгрузку", "ПрерватьВыгрузку");
	Ресурсы.Добавить(База, "база", "Очистить");
	База.Когда().Очистить(Любое).ТогдаВыбрасываетИсключение("Ошибка очистки");

	// Когда
	Ресурсы.Отменить();

	// Тогда - ошибка в лог предупреждением, выгрузка прервана
	Лог.ПроверитьЧтоВызывалсяМетод().Предупреждение("Не удалось освободить ресурс (%1.%2): %3", Любое, "Очистить", Любое);
	EDT.ПроверитьЧтоВызывалсяМетод().ПрерватьВыгрузку("выгрузка");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НичегоНеВызывать_ПриПовторномОсвобождении() Экспорт

	// Дано
	Ресурсы.Добавить(База, "база", "Очистить");
	Ресурсы.Завершить();

	// Когда
	Ресурсы.Завершить();
	Ресурсы.Отменить();

	// Тогда
	Ожидаем.Что(ОчищенныеБазы()).Равно("база");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОчищенныеБазы()

	Результат = Новый Массив;
	Для Каждого Вызов Из Стенд.Вызовы("СервисВременнойБазы", "Очистить") Цикл
		Результат.Добавить(Вызов.КонтекстБазы);
	КонецЦикла;
	Возврат СтрСоединить(Результат, ", ");

КонецФункции

#КонецОбласти
