// BSLLS-off
// Юнит-тесты РазборЗамечанийСинтаксиса: разбор строк лога /CheckConfig
// и группировка замечаний по объектам метаданных (--groupbymetadata).

#Использовать asserts

#Использовать "../../../src/core/Сервисы"

Перем Разбор;

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	Разбор = Новый РазборЗамечанийСинтаксиса("Синтаксическая проверка конфигурации");
КонецПроцедуры

#Область РазборСтроки

&Тест
Процедура ТестДолжен_ИзвлечьОбъектМетаданныхИПозицию() Экспорт

	Замечание = Разбор.Разобрать(
		"{Обработка.Обработка1.Форма.Форма.Форма(12,3)}: Переменная не определена (Ы)");

	Ожидаем.Что(Замечание.ИмяГруппы).Равно("Обработка.Обработка1.Форма.Форма.Форма");
	Ожидаем.Что(Замечание.Позиция).Равно("12,3");
	Ожидаем.Что(Замечание.Текст).Равно("Переменная не определена (Ы)");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИзвлечьОбъектМетаданных_БезПозиции() Экспорт

	Замечание = Разбор.Разобрать("{Справочник.Справочник1.МодульОбъекта}: Пустой обработчик");

	Ожидаем.Что(Замечание.ИмяГруппы).Равно("Справочник.Справочник1.МодульОбъекта");
	Ожидаем.Что(Замечание.Позиция).Равно("");
	Ожидаем.Что(Замечание.Текст).Равно("Пустой обработчик");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтнестиСтрокуБезОбъектаКГруппеПоУмолчанию() Экспорт

	Замечание = Разбор.Разобрать("Проверка конфигурации: обнаружены ошибки");

	Ожидаем.Что(Замечание.ИмяГруппы).Равно("Синтаксическая проверка конфигурации");
	Ожидаем.Что(Замечание.Текст).Равно("Проверка конфигурации: обнаружены ошибки");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтнестиСтрокуСПустымиСкобкамиКГруппеПоУмолчанию() Экспорт

	Замечание = Разбор.Разобрать("{}: непонятная строка");

	Ожидаем.Что(Замечание.ИмяГруппы).Равно("Синтаксическая проверка конфигурации");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьИсходнуюСтроку() Экспорт

	Исходная = "{Обработка.Обработка1.Форма.Форма.Форма(1,1)}: Ошибка";
	Замечание = Разбор.Разобрать(Исходная);

	Ожидаем.Что(Замечание.Исходный).Равно(Исходная);

КонецПроцедуры

#КонецОбласти

#Область СклейкаПродолжений

// Конфигуратор печатает одно замечание двумя строками: заголовок с объектом
// и фрагмент кода с режимом проверки. Дальше по конвейеру это должно быть одной строкой.
&Тест
Процедура ТестДолжен_СклеитьЗаголовокЗамечанияСФрагментомКода() Экспорт

	Строки = Новый Массив;
	Строки.Добавить("{Справочник.Справочник1.МодульОбъекта(4,1)}: Определения процедур должны идти перед телом модуля");
	Строки.Добавить("<<?>>Процедура ПлохаяПроцедура() Экспорт (Проверка: Сервер)");

	Склеенные = Разбор.СклеитьПродолжения(Строки);

	Ожидаем.Что(Склеенные.Количество()).Равно(1);
	Ожидаем.Что(Склеенные[0]).Равно(
		"{Справочник.Справочник1.МодульОбъекта(4,1)}: Определения процедур должны идти перед телом модуля"
		+ " #> <<?>>Процедура ПлохаяПроцедура() Экспорт (Проверка: Сервер)");

КонецПроцедуры

// Склеенное замечание - один тест-кейс своего объекта, а не два разных.
&Тест
Процедура ТестДолжен_СгруппироватьСклеенноеЗамечаниеПоОбъекту() Экспорт

	Строки = Новый Массив;
	Строки.Добавить("{Справочник.Справочник1.МодульОбъекта(4,1)}: Определения процедур должны идти перед телом модуля");
	Строки.Добавить("<<?>>Процедура ПлохаяПроцедура() Экспорт (Проверка: Сервер)");

	Группы = Разбор.Сгруппировать(Разбор.СклеитьПродолжения(Строки));

	Ожидаем.Что(Группы.Количество()).Равно(1);
	Ожидаем.Что(Группы[0].ИмяГруппы).Равно("Справочник.Справочник1.МодульОбъекта");
	Ожидаем.Что(Группы[0].Замечания.Количество()).Равно(1);

КонецПроцедуры

// Строку без маркера режима проверки трогать нельзя - это самостоятельное сообщение.
&Тест
Процедура ТестДолжен_НеСклеиватьСамостоятельныеСтроки() Экспорт

	Строки = Новый Массив;
	Строки.Добавить("{Справочник.Справочник1.МодульОбъекта(4,1)}: Первая ошибка");
	Строки.Добавить("{Справочник.Справочник1.МодульОбъекта(9,1)}: Вторая ошибка");
	Строки.Добавить("Ошибок не обнаружено");

	Ожидаем.Что(Разбор.СклеитьПродолжения(Строки).Количество()).Равно(3);

КонецПроцедуры

// Заголовок без продолжения в конце лога не должен выходить за границы массива.
&Тест
Процедура ТестДолжен_НеУпастьНаЗаголовкеБезПродолженияВКонце() Экспорт

	Строки = Новый Массив;
	Строки.Добавить("{Справочник.Справочник1.МодульОбъекта(4,1)}: Одинокая ошибка");

	Ожидаем.Что(Разбор.СклеитьПродолжения(Строки).Количество()).Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьПустойСписок_ЕслиЛогПуст() Экспорт

	Ожидаем.Что(Разбор.СклеитьПродолжения(Новый Массив).Количество()).Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Группировка

&Тест
Процедура ТестДолжен_СобратьЗамечанияОдногоОбъектаВОднуГруппу() Экспорт

	Строки = Новый Массив;
	Строки.Добавить("{Обработка.Обработка1.Форма.Форма.Форма(1,1)}: Первая ошибка");
	Строки.Добавить("{Обработка.Обработка1.Форма.Форма.Форма(5,2)}: Вторая ошибка");
	Строки.Добавить("{Справочник.Справочник1.МодульОбъекта(3,1)}: Третья ошибка");

	Группы = Разбор.Сгруппировать(Строки);

	Ожидаем.Что(Группы.Количество()).Равно(2);
	Ожидаем.Что(Группы[0].ИмяГруппы).Равно("Обработка.Обработка1.Форма.Форма.Форма");
	Ожидаем.Что(Группы[0].Замечания.Количество()).Равно(2);
	Ожидаем.Что(Группы[1].ИмяГруппы).Равно("Справочник.Справочник1.МодульОбъекта");
	Ожидаем.Что(Группы[1].Замечания.Количество()).Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьПорядокПервогоПоявленияОбъекта() Экспорт

	Строки = Новый Массив;
	Строки.Добавить("{Б.Модуль(1,1)}: Раз");
	Строки.Добавить("{А.Модуль(1,1)}: Два");
	Строки.Добавить("{Б.Модуль(2,1)}: Три");

	Группы = Разбор.Сгруппировать(Строки);

	Ожидаем.Что(Группы[0].ИмяГруппы).Равно("Б.Модуль");
	Ожидаем.Что(Группы[1].ИмяГруппы).Равно("А.Модуль");

КонецПроцедуры

// Строки без объекта остаются в группе по умолчанию.
&Тест
Процедура ТестДолжен_ОставитьСтрокиБезОбъектаВГруппеПоУмолчанию() Экспорт

	Строки = Новый Массив;
	Строки.Добавить("Проверка конфигурации: начало");
	Строки.Добавить("{Справочник.Справочник1.МодульОбъекта(4,1)}: Ошибка");

	Группы = Разбор.Сгруппировать(Строки);

	Ожидаем.Что(Группы.Количество()).Равно(2);
	Ожидаем.Что(Группы[0].ИмяГруппы).Равно("Синтаксическая проверка конфигурации");
	Ожидаем.Что(Группы[1].ИмяГруппы).Равно("Справочник.Справочник1.МодульОбъекта");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьПустойСписокГрупп_ЕслиЗамечанийНет() Экспорт

	Ожидаем.Что(Разбор.Сгруппировать(Новый Массив).Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СобратьТекстЗамечанийГруппыСПозициями() Экспорт

	Строки = Новый Массив;
	Строки.Добавить("{Обработка.Обработка1.Форма.Форма.Форма(1,1)}: Первая ошибка");
	Строки.Добавить("{Обработка.Обработка1.Форма.Форма.Форма(5,2)}: Вторая ошибка");

	Группы = Разбор.Сгруппировать(Строки);
	Текст = Разбор.ТекстЗамечанийГруппы(Группы[0]);

	Ожидаем.Что(Текст).Равно("(1,1): Первая ошибка" + Символы.ПС + "(5,2): Вторая ошибка");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СобратьТекстЗамечанийГруппыБезПозиций() Экспорт

	Строки = Новый Массив;
	Строки.Добавить("Просто сообщение");

	Группы = Разбор.Сгруппировать(Строки);

	Ожидаем.Что(Разбор.ТекстЗамечанийГруппы(Группы[0])).Равно("Просто сообщение");

КонецПроцедуры

#КонецОбласти
