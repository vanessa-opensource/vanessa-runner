// BSLLS-off
// Юнит-тесты СервисIbcmdRs: поиск уже установленного файла, имя ассета, URL загрузки,
// разбор URL и выбор режима --ibcmd-rs. Сеть и сам бинарник не используются.

#Использовать asserts
#Использовать tempfiles
#Использовать "../utils"

Перем Стенд;

&ПередКаждым
Процедура ПередКаждым() Экспорт
	Стенд = Новый Стенд;
КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт
	ВременныеФайлы.Удалить();
КонецПроцедуры

#Область Установлена

&Тест
Процедура ТестДолжен_СчитатьНеУстановленной_ЕслиHomeНеСуществует() Экспорт

	Дом = ТестовыеФайлы.НесуществующийПуть("нет-ibcmd-rs");

	Ожидаем.Что(СервисСДомом(Дом).Установлена(), "не установлена без файла").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_СчитатьУстановленной_ЕслиHomeУказываетНаФайл() Экспорт

	Файл = ТестовыеФайлы.Файл(ВременныеФайлы.СоздатьКаталог(), "ibcmd-rs.exe");

	Ожидаем.Что(СервисСДомом(Файл).Установлена(), "файл home").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиИсполняемыйФайл_ВоВложенномКаталогеHome() Экспорт

	Корень = ВременныеФайлы.СоздатьКаталог();
	Имя = Стенд.Мок("СервисОкружения").ИмяИсполняемогоФайла("ibcmd-rs");
	Ожидаемый = ТестовыеФайлы.Файл(Корень, "ibcmd-rs-0.4.0-x86_64/" + Имя);

	Сервис = СервисСДомом(Корень);

	Ожидаем.Что(Сервис.Установлена(), "каталог home").ЭтоИстина();
	Ожидаем.Что(Сервис.ОбеспечитьУстановку(), "путь к файлу внутри home").Равно(Ожидаемый);

КонецПроцедуры

&Тест
Процедура ТестДолжен_БроситьИсключение_ЕслиHomeЗаданИФайлаНет() Экспорт

	Дом = ТестовыеФайлы.НесуществующийПуть("нет-каталога");

	Ожидаем.Что(СервисСДомом(Дом)).Метод("ОбеспечитьУстановку", Новый Массив)
		.ВыбрасываетИсключение("ibcmd-rs.home");

КонецПроцедуры

#КонецОбласти

#Область ЦельСборки

&Тест
Процедура ТестДолжен_ВернутьЦельСборки_ПоПлатформе() Экспорт

	Сервис = СервисСДомом();

	Ожидаем.Что(Сервис.ЦельСборки("Windows_x86_64"), "windows").Равно("x86_64-pc-windows-msvc");
	Ожидаем.Что(Сервис.ЦельСборки("Linux_x86_64"), "linux").Равно("x86_64-unknown-linux-gnu");

КонецПроцедуры

&Тест
Процедура ТестДолжен_БроситьИсключение_НаНеподдерживаемойПлатформе() Экспорт

	Ожидаем.Что(СервисСДомом()).Метод("ЦельСборки", ТестовыеДанные.Массив("MacOS_ARM64"))
		.ВыбрасываетИсключение("не публикует сборку");

	Ожидаем.Что(СервисСДомом()).Метод("ЦельСборки", ТестовыеДанные.Массив("Windows_x86"))
		.ВыбрасываетИсключение("только для x86_64");

КонецПроцедуры

#КонецОбласти

#Область URLЗагрузки

&Тест
Процедура ТестДолжен_СобратьURLЗагрузки_ИзВерсииИАссетаТекущейОС() Экспорт

	Сервис = СервисСДомом();
	URL = Сервис.URLЗагрузки();

	Ожидаем.Что(URL, "тег версии").Содержит("/download/v0.4.0/");
	Ожидаем.Что(URL, "архив").Содержит(Сервис.ИмяАрхиваДляПлатформы(Стенд.Мок("СервисОкружения").ТипПлатформы()));

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтрезатьПрефиксV_УВерсииВURL() Экспорт

	Сервис = Сервис("v0.4.0", "", "");
	URL = Сервис.URLЗагрузки();

	Ожидаем.Что(URL, "один префикс v").Содержит("/download/v0.4.0/ibcmd-rs-0.4.0-");
	Ожидаем.Что(URL, "без двойного v").Не_().Содержит("/download/vv");

КонецПроцедуры

#КонецОбласти

#Область РазобратьURL

&Тест
Процедура ТестДолжен_РазобратьURL_HttpsСПортомПоУмолчанию() Экспорт

	Разбор = Новый ЗагрузкаHTTP().РазобратьАдрес(
		"https://github.com/Untru/ibcmd-rs/releases/download/v0.4.0/a.zip");

	Ожидаем.Что(Разбор.СХостом, "хост со схемой").Равно("https://github.com");
	Ожидаем.Что(Разбор.Порт, "порт https по умолчанию").Равно(443);
	Ожидаем.Что(Разбор.Ресурс, "ресурс").Равно("/Untru/ibcmd-rs/releases/download/v0.4.0/a.zip");

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазобратьURL_HttpСЯвнымПортом() Экспорт

	Разбор = Новый ЗагрузкаHTTP().РазобратьАдрес("http://build-agent:8080/x/y");

	Ожидаем.Что(Разбор.СХостом, "хост со схемой").Равно("http://build-agent");
	Ожидаем.Что(Разбор.Порт, "явный порт").Равно(8080);
	Ожидаем.Что(Разбор.Ресурс, "ресурс").Равно("/x/y");

КонецПроцедуры

#КонецОбласти

#Область ПрименитьРежим

&Тест
Процедура ТестДолжен_СброситьПодмену_БезФлагаIbcmdRs() Экспорт

	Движок = Стенд.Мок("ДвижокIbcmd");

	Режим = СервисСДомом().ПрименитьРежим(Движок, Ложь, Ложь);

	Ожидаем.Что(Режим, "остаётся конфигуратор").ЭтоЛожь();
	Движок.ПроверитьЧтоВызывалсяМетод().ИспользоватьПриложение("");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВключитьIbcmd_ИПодставитьФайлHome() Экспорт

	Файл = ТестовыеФайлы.Файл(ВременныеФайлы.СоздатьКаталог(), "ibcmd-rs.exe");
	Движок = Стенд.Мок("ДвижокIbcmd");

	Режим = СервисСДомом(Файл).ПрименитьРежим(Движок, Ложь, Истина);

	Ожидаем.Что(Режим, "команда идёт через ibcmd").ЭтоИстина();
	Движок.ПроверитьЧтоВызывалсяМетод().ИспользоватьПриложение(Новый Файл(Файл).ПолноеИмя);

КонецПроцедуры

&Тест
Процедура ТестДолжен_Отказать_ЕслиЗаданыОбаФлага() Экспорт

	Движок = Стенд.Мок("ДвижокIbcmd");
	Сервис = СервисСДомом();

	Ожидаем.Что(Сервис).Метод("ПрименитьРежим", ТестовыеДанные.Массив(Движок, Истина, Истина))
		.ВыбрасываетИсключение("вместе не используются");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СервисСДомом(Знач Дом = "")
	Возврат Сервис("0.4.0", Дом, "");
КонецФункции

Функция Сервис(Знач Версия, Знач Дом, Знач КаталогУтилит)
	Возврат Стенд.Сервис("СервисIbcmdRs", ТестовыеДанные.Массив(
		Версия, "https://github.com/Untru/ibcmd-rs/releases/download", Дом, КаталогУтилит));
КонецФункции

#КонецОбласти
