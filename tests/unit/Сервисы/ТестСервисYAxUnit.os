// BSLLS-off
// Юнит-тесты СервисYAxUnit.
// Покрытие: формирование ключа запуска RunUnitTests, настроек (filter/reportFormat/exitCode/
// флаги закрытия и показа), сериализация в JSON-файл, использование готового конфига,
// делегирование запуска в СервисПлатформы.

#Использовать asserts
#Использовать moskito
#Использовать tempfiles

#Использовать "../../../src/core/Сервисы"
#Использовать "../utils"

Перем Любое;

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	Любое = Матчеры.ЛюбоеЗначение();
КонецПроцедуры

#Область КлючЗапуска

&Тест
Процедура ТестДолжен_СформироватьКлючЗапускаRunUnitTests() Экспорт

	Сервис = Новый БилдерСервисаYAxUnit().Собрать();

	Ключ = Сервис.СформироватьКлючЗапуска("C:\tmp\yaxunit.json");

	Ожидаем.Что(Ключ).Равно("RunUnitTests=C:\tmp\yaxunit.json");

КонецПроцедуры

#КонецОбласти

#Область СформироватьНастройки

&Тест
Процедура ТестДолжен_ВключитьФильтрРасширенийИМодулей() Экспорт

	Сервис = Новый БилдерСервисаYAxUnit().Собрать();
	ПараметрыТестов = Новый Структура("Расширения, Модули", "tests, extra", "МодульТестов");

	Настройки = Сервис.СформироватьНастройки(ПараметрыТестов);

	Фильтр = Настройки.Получить("filter");
	Ожидаем.Что(Фильтр).Заполнено();

	Расширения = Фильтр.Получить("extensions");
	Ожидаем.Что(Расширения.Количество()).Равно(2);
	Ожидаем.Что(Расширения[0]).Равно("tests");
	Ожидаем.Что(Расширения[1]).Равно("extra");

	Модули = Фильтр.Получить("modules");
	Ожидаем.Что(Модули.Количество()).Равно(1);
	Ожидаем.Что(Модули[0]).Равно("МодульТестов");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОпуститьФильтрЕслиНеЗадан() Экспорт

	Сервис = Новый БилдерСервисаYAxUnit().Собрать();

	Настройки = Сервис.СформироватьНастройки(Новый Структура);

	Ожидаем.Что(Настройки.Получить("filter")).Не_().Заполнено();
	Ожидаем.Что(Настройки.Получить("reportFormat")).Равно("jUnit");
	Ожидаем.Что(Настройки.Получить("closeAfterTests")).ЭтоИстина();
	Ожидаем.Что(Настройки.Получить("showReport")).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_УстановитьФлагиЗакрытияИПоказаОтчета() Экспорт

	Сервис = Новый БилдерСервисаYAxUnit().Собрать();
	ПараметрыТестов = Новый Структура("ЗакрыватьПослеТестов, ПоказыватьОтчет", Ложь, Истина);

	Настройки = Сервис.СформироватьНастройки(ПараметрыТестов);

	Ожидаем.Что(Настройки.Получить("closeAfterTests")).ЭтоЛожь();
	Ожидаем.Что(Настройки.Получить("showReport")).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВключитьПутьОтчетаИКодВозврата() Экспорт

	Сервис = Новый БилдерСервисаYAxUnit().Собрать();
	ПараметрыТестов = Новый Структура("ПутьОтчета, ПутьСтатуса", "build\junit.xml", "build\exit.txt");

	Настройки = Сервис.СформироватьНастройки(ПараметрыТестов);

	// пути абсолютизируются
	Ожидаем.Что(Настройки.Получить("reportPath")).Содержит("junit.xml");
	Ожидаем.Что(Настройки.Получить("exitCode")).Содержит("exit.txt");

КонецПроцедуры

#КонецОбласти

#Область ПодготовитьФайлНастроек

&Тест
Процедура ТестДолжен_ЗаписатьКонфигурационныйФайлJSON() Экспорт

	Сервис = Новый БилдерСервисаYAxUnit().Собрать();
	ПараметрыТестов = Новый Структура("Расширения, ЗакрыватьПослеТестов", "tests", Истина);

	ПутьФайла = Сервис.ПодготовитьФайлНастроек(ПараметрыТестов);

	Ожидаем.Что(Новый Файл(ПутьФайла).Существует(), "Конфиг YAxUnit должен быть записан").ЭтоИстина();

	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(ПутьФайла);
	Данные = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();

	Ожидаем.Что(Данные.Получить("closeAfterTests")).ЭтоИстина();
	Ожидаем.Что(Данные.Получить("filter").Получить("extensions")[0]).Равно("tests");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИспользоватьГотовыйКонфигКакЕсть() Экспорт

	КаталогТест = ВременныеФайлы.СоздатьКаталог();
	ПутьГотового = ОбъединитьПути(КаталогТест, "ready.json");
	Запись = Новый ЗаписьТекста(ПутьГотового);
	Запись.ЗаписатьСтроку("{""reportFormat"":""jUnit""}");
	Запись.Закрыть();

	Сервис = Новый БилдерСервисаYAxUnit().Собрать();
	ПараметрыТестов = Новый Структура("ПутьКонфигу", ПутьГотового);

	Результат = Сервис.ПодготовитьФайлНастроек(ПараметрыТестов);

	Ожидаем.Что(Результат).Равно(Новый Файл(ПутьГотового).ПолноеИмя);

КонецПроцедуры

&Тест
Процедура ТестДолжен_БроситьЕслиГотовыйКонфигНеНайден() Экспорт

	Сервис = Новый БилдерСервисаYAxUnit().Собрать();
	ПараметрыТестов = Новый Структура("ПутьКонфигу", "C:\нет\такого\yaxunit.json");

	Попытка
		Сервис.ПодготовитьФайлНастроек(ПараметрыТестов);
		ВызватьИсключение "Должно было упасть";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("не найден");
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область ЗапуститьТесты

&Тест
Процедура ТестДолжен_ЗапуститьТесты_ДелегироватьВСервисПлатформы() Экспорт

	МокПлатформы = Мок.Получить(Новый СервисПлатформы);

	Сервис = Новый БилдерСервисаYAxUnit().СПлатформой(МокПлатформы).Собрать();

	ПараметрыПодключения = Новый Структура("СтрокаПодключения", "/F""C:\b""");
	ПараметрыТестов = Новый Структура("Расширения", "tests");
	ПараметрыЗапуска = Новый Структура("РежимЗапуска", "");

	Сервис.ЗапуститьТесты(ПараметрыПодключения, ПараметрыТестов, ПараметрыЗапуска);

	// делегировано в платформу, ключ запуска сформирован
	МокПлатформы.ПроверитьЧтоВызывалсяМетод().ЗапуститьПредприятие(Любое, Любое, Любое);
	Ожидаем.Что(ПараметрыЗапуска.КомандаЗапуска).Содержит("RunUnitTests=");

КонецПроцедуры

#КонецОбласти
