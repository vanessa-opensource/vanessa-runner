// BSLLS-off
// Юнит-тесты СервисYAxUnit.
// Покрытие: формирование ключа запуска RunUnitTests, настроек (filter/reportFormat/exitCode/
// флаги закрытия и показа), сериализация в JSON-файл, использование готового конфига,
// делегирование запуска в СервисПлатформы.

#Использовать asserts
#Использовать moskito
#Использовать tempfiles

#Использовать "../../../src/core/Сервисы"
#Использовать "../utils"

Перем Любое;

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	Любое = Матчеры.ЛюбоеЗначение();
КонецПроцедуры

#Область КлючЗапуска

&Тест
Процедура ТестДолжен_СформироватьКлючЗапускаRunUnitTests() Экспорт

	Сервис = Новый БилдерСервисаYAxUnit().Собрать();

	Ключ = Сервис.СформироватьКлючЗапуска("C:\tmp\yaxunit.json");

	Ожидаем.Что(Ключ).Равно("RunUnitTests=C:\tmp\yaxunit.json");

КонецПроцедуры

#КонецОбласти

#Область СформироватьНастройки

&Тест
Процедура ТестДолжен_ВключитьФильтрРасширенийИМодулей() Экспорт

	Сервис = Новый БилдерСервисаYAxUnit().Собрать();
	ПараметрыТестов = Новый Структура("Расширения, Модули", "tests, extra", "МодульТестов");

	Настройки = Сервис.СформироватьНастройки(ПараметрыТестов);

	Фильтр = Настройки.Получить("filter");
	Ожидаем.Что(Фильтр).Заполнено();

	Расширения = Фильтр.Получить("extensions");
	Ожидаем.Что(Расширения.Количество()).Равно(2);
	Ожидаем.Что(Расширения[0]).Равно("tests");
	Ожидаем.Что(Расширения[1]).Равно("extra");

	Модули = Фильтр.Получить("modules");
	Ожидаем.Что(Модули.Количество()).Равно(1);
	Ожидаем.Что(Модули[0]).Равно("МодульТестов");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОпуститьФильтрЕслиНеЗадан() Экспорт

	Сервис = Новый БилдерСервисаYAxUnit().Собрать();

	Настройки = Сервис.СформироватьНастройки(Новый Структура);

	Ожидаем.Что(Настройки.Получить("filter")).Не_().Заполнено();
	Ожидаем.Что(Настройки.Получить("reportFormat")).Равно("jUnit");
	Ожидаем.Что(Настройки.Получить("closeAfterTests")).ЭтоИстина();
	Ожидаем.Что(Настройки.Получить("showReport")).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_УстановитьФлагиЗакрытияИПоказаОтчета() Экспорт

	Сервис = Новый БилдерСервисаYAxUnit().Собрать();
	ПараметрыТестов = Новый Структура("ЗакрыватьПослеТестов, ПоказыватьОтчет", Ложь, Истина);

	Настройки = Сервис.СформироватьНастройки(ПараметрыТестов);

	Ожидаем.Что(Настройки.Получить("closeAfterTests")).ЭтоЛожь();
	Ожидаем.Что(Настройки.Получить("showReport")).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВключитьПутьОтчетаИКодВозврата() Экспорт

	Сервис = Новый БилдерСервисаYAxUnit().Собрать();
	ПараметрыТестов = Новый Структура("ПутьОтчета, ПутьСтатуса", "build\junit.xml", "build\exit.txt");

	Настройки = Сервис.СформироватьНастройки(ПараметрыТестов);

	// пути абсолютизируются
	Ожидаем.Что(Настройки.Получить("reportPath")).Содержит("junit.xml");
	Ожидаем.Что(Настройки.Получить("exitCode")).Содержит("exit.txt");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВключитьProjectPathЕслиЗадан() Экспорт

	Сервис = Новый БилдерСервисаYAxUnit().Собрать();
	ПараметрыТестов = Новый Структура("КаталогПроекта", ТекущийКаталог());

	Настройки = Сервис.СформироватьНастройки(ПараметрыТестов);

	Ожидаем.Что(Настройки.Получить("projectPath")).Заполнено();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВключитьWorkspacePathЕслиЗадан() Экспорт

	Сервис = Новый БилдерСервисаYAxUnit().Собрать();
	ПараметрыТестов = Новый Структура("КаталогWorkspace", ТекущийКаталог());

	Настройки = Сервис.СформироватьНастройки(ПараметрыТестов);

	Ожидаем.Что(Настройки.Получить("workspacePath")).Заполнено();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОпуститьПутиЕслиНеЗаданы() Экспорт

	Сервис = Новый БилдерСервисаYAxUnit().Собрать();

	Настройки = Сервис.СформироватьНастройки(Новый Структура);

	Ожидаем.Что(Настройки.Получить("projectPath")).Не_().Заполнено();
	Ожидаем.Что(Настройки.Получить("workspacePath")).Не_().Заполнено();

КонецПроцедуры

#КонецОбласти

#Область ПодготовитьФайлНастроек

&Тест
Процедура ТестДолжен_ЗаписатьКонфигурационныйФайлJSON() Экспорт

	Сервис = Новый БилдерСервисаYAxUnit().Собрать();
	ПараметрыТестов = Новый Структура("Расширения, ЗакрыватьПослеТестов", "tests", Истина);

	ПутьФайла = Сервис.ПодготовитьФайлНастроек(ПараметрыТестов);

	Ожидаем.Что(Новый Файл(ПутьФайла).Существует(), "Конфиг YAxUnit должен быть записан").ЭтоИстина();

	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(ПутьФайла);
	Данные = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();

	Ожидаем.Что(Данные.Получить("closeAfterTests")).ЭтоИстина();
	Ожидаем.Что(Данные.Получить("filter").Получить("extensions")[0]).Равно("tests");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИспользоватьГотовыйКонфигКакЕсть() Экспорт

	КаталогТест = ВременныеФайлы.СоздатьКаталог();
	ПутьГотового = ОбъединитьПути(КаталогТест, "ready.json");
	Запись = Новый ЗаписьТекста(ПутьГотового);
	Запись.ЗаписатьСтроку("{""reportFormat"":""jUnit""}");
	Запись.Закрыть();

	Сервис = Новый БилдерСервисаYAxUnit().Собрать();
	ПараметрыТестов = Новый Структура("ПутьКонфигу", ПутьГотового);

	Результат = Сервис.ПодготовитьФайлНастроек(ПараметрыТестов);

	Ожидаем.Что(Результат).Равно(Новый Файл(ПутьГотового).ПолноеИмя);

КонецПроцедуры

&Тест
Процедура ТестДолжен_БроситьЕслиГотовыйКонфигНеНайден() Экспорт

	Сервис = Новый БилдерСервисаYAxUnit().Собрать();
	ПараметрыТестов = Новый Структура("ПутьКонфигу", "C:\нет\такого\yaxunit.json");

	Попытка
		Сервис.ПодготовитьФайлНастроек(ПараметрыТестов);
		ВызватьИсключение "Должно было упасть";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("не найден");
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область ЗапуститьТесты

&Тест
Процедура ТестДолжен_ЗапуститьТесты_ДелегироватьВСервисПлатформы() Экспорт

	МокПлатформы = Мок.Получить(Новый СервисПлатформы);

	Сервис = Новый БилдерСервисаYAxUnit().СПлатформой(МокПлатформы).Собрать();

	ПараметрыПодключения = Новый Структура("СтрокаПодключения", "/F""C:\b""");
	ПараметрыТестов = Новый Структура("Расширения", "tests");
	ПараметрыЗапуска = Новый Структура("РежимЗапуска", "");

	Сервис.ЗапуститьТесты(ПараметрыПодключения, ПараметрыТестов, ПараметрыЗапуска);

	// делегировано в платформу, ключ запуска сформирован
	МокПлатформы.ПроверитьЧтоВызывалсяМетод().ЗапуститьПредприятие(Любое, Любое, Любое);
	Ожидаем.Что(ПараметрыЗапуска.КомандаЗапуска).Содержит("RunUnitTests=");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПодставитьВременныйОтчетВРежимеZeroConfig() Экспорт

	МокПлатформы = Мок.Получить(Новый СервисПлатформы);
	Сервис = Новый БилдерСервисаYAxUnit().СПлатформой(МокПлатформы).Собрать();

	ПараметрыПодключения = Новый Структура("СтрокаПодключения", "/F""C:\b""");
	ПараметрыТестов = Новый Структура("Расширения", "tests"); // путь отчёта НЕ задан
	ПараметрыЗапуска = Новый Структура("РежимЗапуска", "");

	Результат = Сервис.ЗапуститьТесты(ПараметрыПодключения, ПараметрыТестов, ПараметрыЗапуска);

	// путь отчёта подставлен во временный jUnit-файл и проброшен в параметры
	Ожидаем.Что(ПараметрыТестов.Свойство("ПутьОтчета")).ЭтоИстина();
	Ожидаем.Что(ПараметрыТестов.ПутьОтчета).Содержит(".xml");
	Ожидаем.Что(Результат.ПутьОтчета).Равно(ПараметрыТестов.ПутьОтчета);
	Ожидаем.Что(Результат.ФорматJUnit).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область РазборОтчетаJUnit

&Тест
Процедура ТестДолжен_РазобратьУспешныйОтчетJUnit() Экспорт

	Сервис = Новый БилдерСервисаYAxUnit().Собрать();
	ПутьОтчета = ЗаписатьОтчет(
		"<?xml version=""1.0"" encoding=""UTF-8""?>
		|<testsuites>
		|	<testsuite name=""М [Сервер]"" tests=""2"" failures=""0"" errors=""0"" skipped=""0"">
		|		<testcase name=""А"" classname=""М.А"" context=""Сервер""/>
		|		<testcase name=""Б"" classname=""М.Б"" context=""Сервер""/>
		|	</testsuite>
		|</testsuites>");

	Результат = Сервис.РазобратьОтчетJUnit(ПутьОтчета);

	Ожидаем.Что(Результат.ЕстьОтчет).ЭтоИстина();
	Ожидаем.Что(Результат.Всего).Равно(2);
	Ожидаем.Что(Результат.Успешно).Равно(2);
	Ожидаем.Что(Результат.Провалено).Равно(0);
	Ожидаем.Что(Результат.Ошибок).Равно(0);
	Ожидаем.Что(Результат.Успех).ЭтоИстина();
	Ожидаем.Что(Результат.Провалившиеся.Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазобратьОтчетСПровалами() Экспорт

	Сервис = Новый БилдерСервисаYAxUnit().Собрать();
	ПутьОтчета = ЗаписатьОтчет(
		"<?xml version=""1.0"" encoding=""UTF-8""?>
		|<testsuites>
		|	<testsuite name=""М [Сервер]"" tests=""2"" failures=""1"" errors=""0"" skipped=""0"">
		|		<testcase name=""ОК"" classname=""М.ОК"" context=""Сервер""/>
		|		<testcase name=""Плохой"" classname=""М.Плохой"" context=""Сервер"">
		|			<failure message=""ожидали 4, получили 5"" type=""assert""/>
		|		</testcase>
		|	</testsuite>
		|</testsuites>");

	Результат = Сервис.РазобратьОтчетJUnit(ПутьОтчета);

	Ожидаем.Что(Результат.Всего).Равно(2);
	Ожидаем.Что(Результат.Провалено).Равно(1);
	Ожидаем.Что(Результат.Успешно).Равно(1);
	Ожидаем.Что(Результат.Успех).ЭтоЛожь();
	Ожидаем.Что(Результат.Провалившиеся.Количество()).Равно(1);
	Ожидаем.Что(Результат.Провалившиеся[0].Имя).Равно("М.Плохой [Сервер]");
	Ожидаем.Что(Результат.Провалившиеся[0].Сообщение).Содержит("ожидали 4");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьРезультатБезОтчетаЕслиФайлаНет() Экспорт

	Сервис = Новый БилдерСервисаYAxUnit().Собрать();

	Результат = Сервис.РазобратьОтчетJUnit("C:\нет\такого\junit.xml");

	Ожидаем.Что(Результат.ЕстьОтчет).ЭтоЛожь();
	Ожидаем.Что(Результат.Успех).ЭтоЛожь();
	Ожидаем.Что(Результат.Всего).Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Саммари

&Тест
Процедура ТестДолжен_СформироватьСаммариСПровалами() Экспорт

	Сервис = Новый БилдерСервисаYAxUnit().Собрать();
	Результат = Сервис.НовыйРезультатТестов();
	Результат.ЕстьОтчет = Истина;
	Результат.Всего = 3;
	Результат.Успешно = 2;
	Результат.Провалено = 1;
	Результат.Провалившиеся.Добавить(Новый Структура("Имя, Тип, Сообщение", "М.Плохой", "failure", "не равно"));

	Текст = Сервис.СформироватьСаммари(Результат);

	Ожидаем.Что(Текст).Содержит("всего 3");
	Ожидаем.Что(Текст).Содержит("провалено 1");
	Ожидаем.Что(Текст).Содержит("М.Плохой");
	Ожидаем.Что(Текст).Содержит("не равно");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СообщитьОбОтсутствииТестовВСаммари() Экспорт

	Сервис = Новый БилдерСервисаYAxUnit().Собрать();
	Результат = Сервис.НовыйРезультатТестов();
	Результат.ЕстьОтчет = Истина;

	Текст = Сервис.СформироватьСаммари(Результат);

	Ожидаем.Что(Текст).Содержит("всего 0");
	Ожидаем.Что(Текст).Содержит("Не найдено ни одного теста");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗаписатьОтчет(Знач Содержимое)
	Каталог = ВременныеФайлы.СоздатьКаталог();
	ПутьОтчета = ОбъединитьПути(Каталог, "junit.xml");
	Запись = Новый ЗаписьТекста(ПутьОтчета, "UTF-8");
	Запись.Записать(Содержимое);
	Запись.Закрыть();
	Возврат ПутьОтчета;
КонецФункции

#КонецОбласти
