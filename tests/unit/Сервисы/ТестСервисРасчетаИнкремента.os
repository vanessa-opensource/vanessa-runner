// BSLLS-off
// Юнит-тесты СервисРасчетаИнкремента.
// Покрытие: подготовка/фиксация инкремента, расчёт инкремента для конфигурации и расширения,
// чистые функции анализа изменений (удаления, ConfigDumpInfo, представление, список файлов).

#Использовать asserts
#Использовать moskito
#Использовать tempfiles
#Использовать change-indexer

#Использовать "../../../src/core/Сервисы"
#Использовать "../utils"

Перем Подключения;
Перем Любое;

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	Подключения = Новый ДанныеПодключений;
	Любое = Матчеры.ЛюбоеЗначение();
КонецПроцедуры

Функция СоздатьКаталогСФайлами(Файлы)
	Каталог = ВременныеФайлы.СоздатьКаталог();
	Для Каждого ИмяФайла Из Файлы Цикл
		ПолныйПуть = ОбъединитьПути(Каталог, ИмяФайла);
		КаталогФайла = Новый Файл(ПолныйПуть).Путь;
		Если НЕ Новый Файл(КаталогФайла).Существует() Тогда
			СоздатьКаталог(КаталогФайла);
		КонецЕсли;
		Запись = Новый ЗаписьТекста(ПолныйПуть, "UTF-8");
		Запись.Записать("содержимое " + ИмяФайла);
		Запись.Закрыть();
	КонецЦикла;
	Возврат Каталог;
КонецФункции

Процедура ИзменитьФайл(Каталог, ОтносительныйПуть, НовыйТекст)
	ПолныйПуть = ОбъединитьПути(Каталог, ОтносительныйПуть);
	Запись = Новый ЗаписьТекста(ПолныйПуть, "UTF-8");
	Запись.Записать(НовыйТекст);
	Запись.Закрыть();
КонецПроцедуры

#Область ПодготовитьИнкремент

&Тест
Процедура ТестДолжен_ПодготовитьИнкремент_ВПервыйРаз_БезБазовогоИндекса() Экспорт

	// Дано
	КаталогИсточников = СоздатьКаталогСФайлами(СтрРазделить("a.txt,b.txt", ","));
	Сервис = Новый БилдерСервисаРасчетаИнкремента().Собрать();

	// Когда
	Контекст = Сервис.ПодготовитьИнкремент(КаталогИсточников, Подключения.Файловая("C:\b"));

	// Тогда
	Ожидаем.Что(Контекст.ЕстьБазовыйИндекс).ЭтоЛожь();
	Ожидаем.Что(Контекст.Результат).Заполнено();
	Ожидаем.Что(Новый Файл(Контекст.ПутьТекущегоConfigDumpInfo).Имя).Равно("ConfigDumpInfo.xml");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПодготовитьИнкремент_ПовторныйЗапуск_СБазовымИндексом() Экспорт

	// Дано
	КаталогИсточников = СоздатьКаталогСФайлами(СтрРазделить("a.txt", ","));
	Сервис = Новый БилдерСервисаРасчетаИнкремента().Собрать();
	Сервис.ПодготовитьИнкремент(КаталогИсточников, Подключения.Файловая("C:\b"));

	// Когда - повторный запуск
	Контекст = Сервис.ПодготовитьИнкремент(КаталогИсточников, Подключения.Файловая("C:\b"));

	// Тогда
	Ожидаем.Что(Контекст.ЕстьБазовыйИндекс).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ЗафиксироватьИнкремент

&Тест
Процедура ТестДолжен_ЗафиксироватьИнкремент_СкопироватьConfigDumpInfo() Экспорт

	// Дано
	КаталогИсточников = СоздатьКаталогСФайлами(СтрРазделить("a.txt", ","));
	Запись = Новый ЗаписьТекста(ОбъединитьПути(КаталогИсточников, "ConfigDumpInfo.xml"), "UTF-8");
	Запись.Записать("<dump/>");
	Запись.Закрыть();
	Сервис = Новый БилдерСервисаРасчетаИнкремента().Собрать();
	Контекст = Сервис.ПодготовитьИнкремент(КаталогИсточников, Подключения.Файловая("C:\b"));

	// Когда
	Сервис.ЗафиксироватьИнкремент(Контекст);

	// Тогда
	Ожидаем.Что(Новый Файл(Контекст.ПутьКешаConfigDumpInfo).Существует()).ЭтоИстина();

КонецПроцедуры

