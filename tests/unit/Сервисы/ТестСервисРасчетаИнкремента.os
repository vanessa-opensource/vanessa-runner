// BSLLS-off
// Юнит-тесты СервисРасчетаИнкремента: инкремент по индексу change-indexer для конфигурации и расширения (XML и EDT),
// чистые функции анализа. Индекс, кеш и исходники настоящие во временных каталогах; СервисПлатформы замокан.

#Использовать asserts
#Использовать moskito
#Использовать tempfiles
#Использовать change-indexer
#Использовать "../utils"

Перем Стенд;
Перем Сервис;
Перем КаталогКеша;
Перем База;
Перем Любое;

&ПередКаждым
Процедура ПередКаждым() Экспорт
	Стенд = Новый Стенд;
	Стенд.Реальный("ФайловыеОперации"); // каталог кеша создаётся на диске
	КаталогКеша = ВременныеФайлы.СоздатьКаталог();
	Сервис = Стенд.Сервис("СервисРасчетаИнкремента", ТестовыеДанные.Массив(КаталогКеша));
	База = ТестовыеДанные.Файловая("base");
	Любое = Матчеры.ЛюбоеЗначение();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт
	ВременныеФайлы.Удалить();
КонецПроцедуры

#Область ПодготовитьИнкремент

&Тест
Процедура ТестДолжен_ПодготовитьИнкремент_ВПервыйРаз_БезБазовогоИндекса() Экспорт

	// Дано
	Исходники = КаталогИсходников("a.txt,b.txt");

	// Когда
	Контекст = Сервис.ПодготовитьИнкремент(Исходники, База);

	// Тогда
	Ожидаем.Что(Контекст.ЕстьБазовыйИндекс).ЭтоЛожь();
	Ожидаем.Что(Контекст.Результат).Заполнено();
	Ожидаем.Что(Новый Файл(Контекст.ПутьТекущегоConfigDumpInfo).Имя).Равно("ConfigDumpInfo.xml");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПодготовитьИнкремент_ПовторныйЗапуск_СБазовымИндексом() Экспорт

	// Дано
	Исходники = КаталогИсходников();
	Сервис.ПодготовитьИнкремент(Исходники, База);

	// Когда - повторный запуск
	Контекст = Сервис.ПодготовитьИнкремент(Исходники, База);

	// Тогда
	Ожидаем.Что(Контекст.ЕстьБазовыйИндекс).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ЗафиксироватьИнкремент

&Тест
Процедура ТестДолжен_СкопироватьConfigDumpInfoВКеш_ПриФиксацииИнкремента() Экспорт

	// Дано
	Исходники = КаталогИсходников();
	ТестовыеФайлы.Файл(Исходники, "ConfigDumpInfo.xml", "<dump/>");
	Контекст = Сервис.ПодготовитьИнкремент(Исходники, База);

	// Когда
	Сервис.ЗафиксироватьИнкремент(Контекст);

	// Тогда
	Ожидаем.Что(ТестовыеФайлы.Существует(Контекст.ПутьКешаConfigDumpInfo)).ЭтоИстина();
	Ожидаем.Что(ТестовыеФайлы.ПрочитатьФайл(Контекст.ПутьКешаConfigDumpInfo)).Равно("<dump/>");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеУпасть_ЕслиТекущийConfigDumpInfoНеСуществует() Экспорт

	// Дано
	Контекст = Сервис.ПодготовитьИнкремент(КаталогИсходников(), База);

	// Когда
	Сервис.ЗафиксироватьИнкремент(Контекст);

	// Тогда
	Ожидаем.Что(ТестовыеФайлы.Существует(Контекст.ПутьКешаConfigDumpInfo)).ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область ПересоздатьИндекс

&Тест
Процедура ТестДолжен_ОбновитьКеш_ПриПересозданииИндекса() Экспорт

	// Дано
	Исходники = КаталогИсходников();

	// Когда
	Сервис.ПересоздатьИндекс(Исходники, База);
	Контекст = Сервис.ПодготовитьИнкремент(Исходники, База);

	// Тогда - после пересоздания индекс уже есть
	Ожидаем.Что(Контекст.ЕстьБазовыйИндекс).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область РассчитатьИнкрементДляЗагрузкиКонфигурации

&Тест
Процедура ТестДолжен_СпроситьИзмененияКонфигурации_УПлатформы() Экспорт

	// Дано - базовый индекс есть, файл изменён
	Исходники = КаталогИсходников();
	Платформа = Стенд.Мок("СервисПлатформы");
	Платформа.Когда().ПолучитьИзмененияКонфигурации(Любое, Любое, Любое, Любое, Любое, Любое)
		.ТогдаВозвращает(ИзмененийПоConfigDumpInfoНет());
	Сервис.ПересоздатьИндекс(Исходники, База);
	ТестовыеФайлы.Файл(Исходники, "a.txt", "X");

	// Когда
	Результат = Сервис.РассчитатьИнкрементДляЗагрузкиКонфигурации(Исходники, База);

	// Тогда
	Платформа.ПроверитьЧтоВызывалсяМетод().ПолучитьИзмененияКонфигурации(База, Исходники, Ложь, Неопределено, Любое, "");
	Ожидаем.Что(Результат.ПропуститьЗагрузку).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеСпрашиватьПлатформу_БезБазовогоИндекса() Экспорт

	// Когда - первый запуск, индекса ещё нет
	Результат = Сервис.РассчитатьИнкрементДляЗагрузкиКонфигурации(КаталогИсходников(), База);

	// Тогда - полная загрузка, платформа не зовётся
	Ожидаем.Что(Результат.ПропуститьЗагрузку).ЭтоЛожь();
	Ожидаем.Что(Результат.СписокФайловДляЗагрузки).Равно("");
	Стенд.ПроверитьЧтоНеВызывался("СервисПлатформы", "ПолучитьИзмененияКонфигурации");

КонецПроцедуры

#КонецОбласти

#Область РассчитатьИнкрементДляЗагрузкиРасширения

&Тест
Процедура ТестДолжен_ПередатьИмяРасширения_ВПлатформу() Экспорт

	// Дано
	Исходники = КаталогИсходников();
	Платформа = Стенд.Мок("СервисПлатформы");
	Платформа.Когда().ПолучитьИзмененияКонфигурации(Любое, Любое, Любое, Любое, Любое, Любое)
		.ТогдаВозвращает(ИзмененийПоConfigDumpInfoНет());
	// Базовый индекс расширения строится первым расчётом (ключ кеша включает имя расширения).
	Сервис.РассчитатьИнкрементДляЗагрузкиРасширения(Исходники, База, "МоёРасш");
	ТестовыеФайлы.Файл(Исходники, "a.txt", "Y");

	// Когда
	Сервис.РассчитатьИнкрементДляЗагрузкиРасширения(Исходники, База, "МоёРасш");

	// Тогда
	Платформа.ПроверитьЧтоВызывалсяМетод()
		.ПолучитьИзмененияКонфигурации(База, Исходники, Ложь, Неопределено, Любое, "МоёРасш");

КонецПроцедуры

#КонецОбласти

#Область РассчитатьИнкрементEDTДляЗагрузкиКонфигурации

&Тест
Процедура ТестДолжен_EDT_ПолнаяЗагрузка_ВПервыйРаз() Экспорт

	// Когда - первый запуск, индекса ещё нет
	Результат = Сервис.РассчитатьИнкрементEDTДляЗагрузкиКонфигурации(ПроектEDT(), ДампXML(), База);

	// Тогда - полная загрузка (пустой список, без пропуска)
	Ожидаем.Что(Результат.ПропуститьЗагрузку).ЭтоЛожь();
	Ожидаем.Что(Результат.СписокФайловДляЗагрузки).Равно("");

КонецПроцедуры

&Тест
Процедура ТестДолжен_EDT_ВыборочнаяЗагрузка_ПриИзмененииМодуля() Экспорт

	// Дано - индекс уже построен
	КаталогEDT = ПроектEDT();
	КаталогXML = ДампXML();
	Сервис.РассчитатьИнкрементEDTДляЗагрузкиКонфигурации(КаталогEDT, КаталогXML, База);

	// Когда - изменён модуль объекта (размер меняется => изменение детектируется)
	ТестовыеФайлы.Файл(КаталогEDT, "src/Catalogs/Справочник1/ObjectModule.bsl",
		"Процедура Новая() КонецПроцедуры // существенно более длинное содержимое модуля");
	Результат = Сервис.РассчитатьИнкрементEDTДляЗагрузкиКонфигурации(КаталогEDT, КаталогXML, База);

	// Тогда - выборочная загрузка XML-файлов изменённого объекта
	Ожидаем.Что(Результат.ПропуститьЗагрузку).ЭтоЛожь();
	Файлы = ПрочитатьСписок(Результат.СписокФайловДляЗагрузки);
	Ожидаем.Что(Файлы).Содержит("Catalogs/Справочник1.xml");
	Ожидаем.Что(Файлы).Содержит("Catalogs/Справочник1/Ext/ObjectModule.bsl");

КонецПроцедуры

&Тест
Процедура ТестДолжен_EDT_ПропуститьЗагрузку_ЕслиИзмененийНет() Экспорт

	// Дано
	КаталогEDT = ПроектEDT();
	КаталогXML = ДампXML();
	Сервис.РассчитатьИнкрементEDTДляЗагрузкиКонфигурации(КаталогEDT, КаталогXML, База);

	// Когда - повторный запуск без изменений
	Результат = Сервис.РассчитатьИнкрементEDTДляЗагрузкиКонфигурации(КаталогEDT, КаталогXML, База);

	// Тогда
	Ожидаем.Что(Результат.ПропуститьЗагрузку).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_EDT_ПолнаяЗагрузка_ПриИзмененииКорняКонфигурации() Экспорт

	// Дано
	КаталогEDT = ПроектEDT();
	КаталогXML = ДампXML();
	Сервис.РассчитатьИнкрементEDTДляЗагрузкиКонфигурации(КаталогEDT, КаталогXML, База);

	// Когда - изменён корень конфигурации
	ТестовыеФайлы.Файл(КаталогEDT, "src/Configuration/Configuration.mdo",
		"<mdo>изменённый состав метаданных конфигурации, требующий полной загрузки</mdo>");
	Результат = Сервис.РассчитатьИнкрементEDTДляЗагрузкиКонфигурации(КаталогEDT, КаталогXML, База);

	// Тогда - полная загрузка
	Ожидаем.Что(Результат.ПропуститьЗагрузку).ЭтоЛожь();
	Ожидаем.Что(Результат.СписокФайловДляЗагрузки).Равно("");

КонецПроцедуры

&Тест
Процедура ТестДолжен_EDT_ПолнаяЗагрузка_ПриДобавленииОбъекта() Экспорт

	// Дано
	КаталогEDT = ПроектEDT();
	КаталогXML = ДампXML();
	Сервис.РассчитатьИнкрементEDTДляЗагрузкиКонфигурации(КаталогEDT, КаталогXML, База);

	// Когда - добавлен новый объект
	ТестовыеФайлы.Файл(КаталогEDT, "src/Documents/Документ1/Документ1.mdo", "<mdo/>");
	Результат = Сервис.РассчитатьИнкрементEDTДляЗагрузкиКонфигурации(КаталогEDT, КаталогXML, База);

	// Тогда - полная загрузка (добавление объекта не поддерживается выборочной загрузкой v1)
	Ожидаем.Что(Результат.ПропуститьЗагрузку).ЭтоЛожь();
	Ожидаем.Что(Результат.СписокФайловДляЗагрузки).Равно("");

КонецПроцедуры

#КонецОбласти

#Область РассчитатьИнкрементEDTДляЗагрузкиРасширения

&Тест
Процедура ТестДолжен_EDTРасширение_ВестиИндексОтдельноОтКонфигурации() Экспорт

	// Дано - индекс конфигурации по тому же каталогу и той же базе уже построен
	КаталогEDT = ПроектEDT(Истина);
	КаталогXML = ДампXML();
	Сервис.РассчитатьИнкрементEDTДляЗагрузкиКонфигурации(КаталогEDT, КаталогXML, База);

	// Когда - первый расчёт для расширения
	Результат = Сервис.РассчитатьИнкрементEDTДляЗагрузкиРасширения(КаталогEDT, КаталогXML, База, "МоёРасш");

	// Тогда - индекс конфигурации не переиспользован: полная загрузка и отдельный ключ в кеше
	Ожидаем.Что(Результат.ПропуститьЗагрузку).ЭтоЛожь();
	Ожидаем.Что(Результат.СписокФайловДляЗагрузки).Равно("");
	Ожидаем.Что(НайтиФайлы(КаталогКеша, "*", Ложь), "ключей в кеше").ИмеетДлину(2);

КонецПроцедуры

&Тест
Процедура ТестДолжен_EDTРасширение_ПропуститьЗагрузку_ЕслиИзмененийНет() Экспорт

	// Дано
	КаталогEDT = ПроектEDT(Истина);
	КаталогXML = ДампXML();
	Сервис.РассчитатьИнкрементEDTДляЗагрузкиРасширения(КаталогEDT, КаталогXML, База, "МоёРасш");

	// Когда - повторный запуск без изменений
	Результат = Сервис.РассчитатьИнкрементEDTДляЗагрузкиРасширения(КаталогEDT, КаталогXML, База, "МоёРасш");

	// Тогда
	Ожидаем.Что(Результат.ПропуститьЗагрузку).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_EDTРасширение_ВыборочнаяЗагрузка_ПриИзмененииМодуляОбъекта() Экспорт

	// Дано - индекс расширения уже построен
	КаталогEDT = ПроектEDT(Истина);
	КаталогXML = ДампXML();
	Сервис.РассчитатьИнкрементEDTДляЗагрузкиРасширения(КаталогEDT, КаталогXML, База, "МоёРасш");

	// Когда - изменён модуль заимствованного объекта
	ТестовыеФайлы.Файл(КаталогEDT, "src/Catalogs/Справочник1/ObjectModule.bsl",
		"&После(""ПередЗаписью"") Процедура Ext_ПередЗаписью(Отказ) КонецПроцедуры // длиннее исходного");
	Результат = Сервис.РассчитатьИнкрементEDTДляЗагрузкиРасширения(КаталогEDT, КаталогXML, База, "МоёРасш");

	// Тогда - выборочная загрузка XML-файлов изменённого объекта
	Ожидаем.Что(Результат.ПропуститьЗагрузку).ЭтоЛожь();
	Файлы = ПрочитатьСписок(Результат.СписокФайловДляЗагрузки);
	Ожидаем.Что(Файлы).Содержит("Catalogs/Справочник1.xml");
	Ожидаем.Что(Файлы).Содержит("Catalogs/Справочник1/Ext/ObjectModule.bsl");

КонецПроцедуры

&Тест
Процедура ТестДолжен_EDTРасширение_ПолнаяЗагрузка_ПриИзмененииКорня() Экспорт

	// Дано
	КаталогEDT = ПроектEDT(Истина);
	КаталогXML = ДампXML();
	Сервис.РассчитатьИнкрементEDTДляЗагрузкиРасширения(КаталогEDT, КаталогXML, База, "МоёРасш");

	// Когда - изменён модуль управляемого приложения (лежит в корне src/Configuration)
	ТестовыеФайлы.Файл(КаталогEDT, "src/Configuration/ManagedApplicationModule.bsl",
		"&Перед(""ПриНачалеРаботыСистемы"") Процедура Ext_ПриНачалеРаботыСистемы() КонецПроцедуры");
	Результат = Сервис.РассчитатьИнкрементEDTДляЗагрузкиРасширения(КаталогEDT, КаталогXML, База, "МоёРасш");

	// Тогда - полная загрузка (политика v1: любое изменение корня)
	Ожидаем.Что(Результат.ПропуститьЗагрузку).ЭтоЛожь();
	Ожидаем.Что(Результат.СписокФайловДляЗагрузки).Равно("");

КонецПроцедуры

#КонецОбласти

#Область РассчитатьИнкрементКонфигурации

&Тест
Процедура ТестДолжен_ВернутьИсходныйСписок_ЕслиКонтекстаНет() Экспорт

	Результат = Сервис.РассчитатьИнкрементКонфигурации("src", Неопределено, Неопределено, "list.txt");

	Ожидаем.Что(Результат.СписокФайловДляЗагрузки).Равно("list.txt");
	Ожидаем.Что(Результат.ПропуститьЗагрузку).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыполнитьПолнуюЗагрузку_ЕслиИндексОтсутствует() Экспорт

	// Дано
	Исходники = КаталогИсходников();
	Контекст = Сервис.ПодготовитьИнкремент(Исходники, База);

	// Когда
	Результат = Сервис.РассчитатьИнкрементКонфигурации(Исходники, Контекст);

	// Тогда - индекс ещё не базовый, значит полная загрузка
	Ожидаем.Что(Результат.ПропуститьЗагрузку).ЭтоЛожь();
	Ожидаем.Что(Результат.СписокФайловДляЗагрузки).Равно("");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПропуститьЗагрузку_ЕслиИзмененийНет() Экспорт

	// Дано
	Исходники = КаталогИсходников();
	Сервис.ПересоздатьИндекс(Исходники, База);
	Контекст = Сервис.ПодготовитьИнкремент(Исходники, База);

	// Когда
	Результат = Сервис.РассчитатьИнкрементКонфигурации(Исходники, Контекст);

	// Тогда
	Ожидаем.Что(Результат.ПропуститьЗагрузку).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыполнитьПолнуюЗагрузку_ПриУдаленииФайлов() Экспорт

	// Дано
	Исходники = КаталогИсходников("a.txt,b.txt");
	Сервис.ПересоздатьИндекс(Исходники, База);
	УдалитьФайлы(ТестовыеФайлы.Путь(Исходники, "b.txt"));
	Контекст = Сервис.ПодготовитьИнкремент(Исходники, База);

	// Когда
	Результат = Сервис.РассчитатьИнкрементКонфигурации(Исходники, Контекст);

	// Тогда
	Ожидаем.Что(Результат.ПропуститьЗагрузку).ЭтоЛожь();
	Ожидаем.Что(Результат.СписокФайловДляЗагрузки).Равно("");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьСписокФайлов_ПриИзменениях() Экспорт

	// Дано
	Исходники = КаталогИсходников();
	Сервис.ПересоздатьИндекс(Исходники, База);
	ТестовыеФайлы.Файл(Исходники, "a.txt", "новое содержимое");
	Контекст = Сервис.ПодготовитьИнкремент(Исходники, База);

	// Когда
	Результат = Сервис.РассчитатьИнкрементКонфигурации(Исходники, Контекст);

	// Тогда
	Ожидаем.Что(Результат.ПропуститьЗагрузку).ЭтоЛожь();
	Ожидаем.Что(ТестовыеФайлы.Существует(Результат.СписокФайловДляЗагрузки)).ЭтоИстина();
	Ожидаем.Что(ПрочитатьСписок(Результат.СписокФайловДляЗагрузки)).Содержит("a.txt");

КонецПроцедуры

#КонецОбласти

#Область ЧистыеФункцииАнализа

&Тест
Процедура ТестДолжен_ПотребоватьПолнуюЗагрузку_ЕслиЕстьУдаления() Экспорт

	Результат = Новый РезультатСравнения;
	Результат.ДобавитьУдаленный("a.txt");

	Ожидаем.Что(Сервис.ТребуетсяПолнаяЗагрузкаИзЗаУдалений(Результат)).ЭтоИстина();

КонецПроцедуры

