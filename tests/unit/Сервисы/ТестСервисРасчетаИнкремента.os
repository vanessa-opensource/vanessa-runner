КонецПроцедуры

&Тест
Процедура ТестДолжен_ПолнаяЗагрузка_ПриУдаленииФайлов() Экспорт

	// Дано
	КаталогИсточников = СоздатьКаталогСФайлами(СтрРазделить("a.txt,b.txt", ","));
	Сервис = Новый БилдерСервисаРасчетаИнкремента().Собрать();
	Сервис.ПересоздатьИндекс(КаталогИсточников, Подключения.Файловая("C:\b"));
	УдалитьФайлы(ОбъединитьПути(КаталогИсточников, "b.txt"));
	Контекст = Сервис.ПодготовитьИнкремент(КаталогИсточников, Подключения.Файловая("C:\b"));

	// Когда
	Результат = Сервис.РассчитатьИнкрементКонфигурации(КаталогИсточников, Контекст);

	// Тогда
	Ожидаем.Что(Результат.ПропуститьЗагрузку).ЭтоЛожь();
	Ожидаем.Что(Результат.СписокФайловДляЗагрузки).Равно("");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьСписокФайлов_ПриИзменениях() Экспорт

	// Дано
	КаталогИсточников = СоздатьКаталогСФайлами(СтрРазделить("a.txt", ","));
	Сервис = Новый БилдерСервисаРасчетаИнкремента().Собрать();
	Сервис.ПересоздатьИндекс(КаталогИсточников, Подключения.Файловая("C:\b"));
	ИзменитьФайл(КаталогИсточников, "a.txt", "новое содержимое");
	Контекст = Сервис.ПодготовитьИнкремент(КаталогИсточников, Подключения.Файловая("C:\b"));

	// Когда
	Результат = Сервис.РассчитатьИнкрементКонфигурации(КаталогИсточников, Контекст);

	// Тогда
	Ожидаем.Что(Результат.ПропуститьЗагрузку).ЭтоЛожь();
	Ожидаем.Что(Новый Файл(Результат.СписокФайловДляЗагрузки).Существует()).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область РассчитатьИнкрементДляЗагрузкиКонфигурации

&Тест
Процедура ТестДолжен_СпроситьИзмененияКонфигурации_УПлатформы() Экспорт

	// Дано
	КаталогИсточников = СоздатьКаталогСФайлами(СтрРазделить("a.txt", ","));
	МокПлатформы = Мок.Получить(Тип("СервисПлатформы"));
	МокПлатформы.Когда().ПолучитьИзмененияКонфигурации(Любое, Любое, Любое, Любое, Любое)
		.ТогдаВозвращает(Новый Структура("ТребуетсяПолнаяЗагрузка, ИзмененныеФайлы", Ложь, Новый Массив));

	Сервис = Новый БилдерСервисаРасчетаИнкремента().СПлатформой(МокПлатформы).Собрать();
	Сервис.ПересоздатьИндекс(КаталогИсточников, Подключения.Файловая("C:\b"));
	ИзменитьФайл(КаталогИсточников, "a.txt", "X");

	// Когда
	Результат = Сервис.РассчитатьИнкрементДляЗагрузкиКонфигурации(КаталогИсточников, Подключения.Файловая("C:\b"));

	// Тогда
	МокПлатформы.ПроверитьЧтоВызывалсяМетод().ПолучитьИзмененияКонфигурации(Любое, КаталогИсточников, Любое, Любое, Любое);
	Ожидаем.Что(Результат.ПропуститьЗагрузку).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеСпрашиватьПлатформу_БезБазовогоИндекса() Экспорт

	// Дано
	КаталогИсточников = СоздатьКаталогСФайлами(СтрРазделить("a.txt", ","));
	МокПлатформы = Мок.Получить(Тип("СервисПлатформы"));

	Сервис = Новый БилдерСервисаРасчетаИнкремента().СПлатформой(МокПлатформы).Собрать();

	// Когда
	Результат = Сервис.РассчитатьИнкрементДляЗагрузкиКонфигурации(КаталогИсточников, Подключения.Файловая("C:\b"));

	// Тогда - без базового индекса возвращается полная загрузка, но платформа не зовётся
	Ожидаем.Что(Результат.ПропуститьЗагрузку).ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область РассчитатьИнкрементДляЗагрузкиРасширения

&Тест
Процедура ТестДолжен_ПередатьИмяРасширения_ВПлатформу() Экспорт

	// Дано
	КаталогИсточников = СоздатьКаталогСФайлами(СтрРазделить("a.txt", ","));
	МокПлатформы = Мок.Получить(Тип("СервисПлатформы"));
	МокПлатформы.Когда().ПолучитьИзмененияКонфигурации(Любое, Любое, Любое, Любое, Любое, Любое)
		.ТогдаВозвращает(Новый Структура("ТребуетсяПолнаяЗагрузка, ИзмененныеФайлы", Ложь, Новый Массив));

	Сервис = Новый БилдерСервисаРасчетаИнкремента().СПлатформой(МокПлатформы).Собрать();
	Сервис.ПересоздатьИндекс(КаталогИсточников, Подключения.Файловая("C:\b"));
	ИзменитьФайл(КаталогИсточников, "a.txt", "Y");

	// Когда
	Сервис.РассчитатьИнкрементДляЗагрузкиРасширения(КаталогИсточников, Подключения.Файловая("C:\b"), "МоёРасш");

	// Тогда
	МокПлатформы.ПроверитьЧтоВызывалсяМетод().ПолучитьИзмененияКонфигурации(Любое, Любое, Любое, Любое, Любое, "МоёРасш");

КонецПроцедуры

