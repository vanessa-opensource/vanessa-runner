&Тест
Процедура ТестДолжен_ВернутьПусто_ДляПустогоПредставления() Экспорт
	Ожидаем.Что(Сервис.ПредставитьФайлыДляЛога(Новый Массив)).Равно("(пусто)");
КонецПроцедуры

&Тест
Процедура ТестДолжен_ОграничитьПредставление_МаксимумомФайлов() Экспорт

	// Дано
	Файлы = Новый Массив;
	Для Ч = 1 По 25 Цикл
		Файлы.Добавить("f" + Ч);
	КонецЦикла;

	// Когда
	Представление = Сервис.ПредставитьФайлыДляЛога(Файлы);

	// Тогда
	Ожидаем.Что(Представление).Содержит("f20");
	Ожидаем.Что(Представление).Не_().Содержит("f21");
	Ожидаем.Что(Представление).Содержит("(+5)");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СчитатьСписокПустым_ЕслиФайлаНет() Экспорт
	Ожидаем.Что(Сервис.СписокФайловПуст(ТестовыеФайлы.Путь(ВременныеФайлы.СоздатьКаталог(), "no.txt"))).ЭтоИстина();
КонецПроцедуры

&Тест
Процедура ТестДолжен_НеСчитатьСписокПустым_ЕслиВНемЕстьСтроки() Экспорт

	Путь = ТестовыеФайлы.ЗаписатьФайл(ВременныеФайлы.НовоеИмяФайла("txt"), "a");

	Ожидаем.Что(Сервис.СписокФайловПуст(Путь)).ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область ДобавитьИзмененныеФайлы

&Тест
Процедура ТестДолжен_ДополнитьСписокИзменений_БезДубликатов() Экспорт

	// Дано
	Результат = Новый РезультатСравнения;
	Результат.ДобавитьИзмененный("a.xml");

	// Когда - a.xml уже есть и не должен попасть повторно
	Сервис.ДобавитьИзмененныеФайлы(Результат, ТестовыеДанные.Массив("a.xml", "b.xml"));

	// Тогда
	Ожидаем.Что(Результат.Измененные()).ИмеетДлину(2);
	Ожидаем.Что(Результат.Измененные()).Содержит("b.xml");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НичегоНеДелать_ЕслиИзмененныеФайлыНеопределены() Экспорт

	// Дано
	Результат = Новый РезультатСравнения;
	Результат.ДобавитьИзмененный("a.xml");

	// Когда
	Сервис.ДобавитьИзмененныеФайлы(Результат, Неопределено);

	// Тогда
	Ожидаем.Что(Результат.Измененные()).ИмеетДлину(1);

КонецПроцедуры

#КонецОбласти

