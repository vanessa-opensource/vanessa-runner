	Ожидаем.Что(Сервис.ИзменилсяConfigDumpInfo(Контекст)).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_СчитатьConfigDumpInfoИзменённым_ЕслиСодержимоеОтличается() Экспорт

	// Дано
	Каталог = ВременныеФайлы.СоздатьКаталог();
	Контекст = Новый Структура("ПутьКешаConfigDumpInfo, ПутьТекущегоConfigDumpInfo",
		ТестовыеФайлы.Файл(Каталог, "cache.xml", "<a/>"), ТестовыеФайлы.Файл(Каталог, "current.xml", "<b/>"));

	// Когда / Тогда
	Ожидаем.Что(Сервис.ИзменилсяConfigDumpInfo(Контекст)).ЭтоИстина();

