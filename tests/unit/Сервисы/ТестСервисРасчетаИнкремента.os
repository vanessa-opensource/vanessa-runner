#КонецОбласти

#Область ФункцииПутейEDT

&Тест
Процедура ТестДолжен_EDT_ВычислитьПутьВнутриSrc() Экспорт

	Ожидаем.Что(Сервис.ПутьВнутриSrcEDT("src/Catalogs/Справочник1/a.bsl")).Равно("Catalogs/Справочник1/a.bsl");
	Ожидаем.Что(Сервис.ПутьВнутриSrcEDT("src\Catalogs\Справочник1\a.bsl")).Равно("Catalogs/Справочник1/a.bsl");
	Ожидаем.Что(Сервис.ПутьВнутриSrcEDT("DT-INF/PROJECT.PMF")).Равно("");
	Ожидаем.Что(Сервис.ПутьВнутриSrcEDT(".project")).Равно("");

КонецПроцедуры

&Тест
Процедура ТестДолжен_EDT_ВычислитьКлючОбъекта() Экспорт

	Ожидаем.Что(Сервис.КлючОбъектаEDT("Catalogs/Справочник1/ObjectModule.bsl")).Равно("Catalogs/Справочник1");
	Ожидаем.Что(Сервис.КлючОбъектаEDT("Catalogs/Справочник1/Forms/Ф/Module.bsl")).Равно("Catalogs/Справочник1");
	Ожидаем.Что(Сервис.КлючОбъектаEDT("Configuration/Configuration.mdo")).Равно("Configuration");
	Ожидаем.Что(Сервис.КлючОбъектаEDT("")).Равно("");

КонецПроцедуры

&Тест
Процедура ТестДолжен_EDT_СобратьXMLФайлыОбъекта() Экспорт

	// Когда - XML-дамп с объектом Catalogs/Справочник1
	Файлы = НормализоватьПути(Сервис.СобратьXMLФайлыОбъектов(ДампXML(), ТестовыеДанные.Массив("Catalogs/Справочник1")));

	// Тогда - основной файл объекта и весь его подкаталог
	Ожидаем.Что(Файлы).ИмеетДлину(2);
	Ожидаем.Что(Файлы).Содержит("Catalogs/Справочник1.xml");
	Ожидаем.Что(Файлы).Содержит("Catalogs/Справочник1/Ext/ObjectModule.bsl");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Временный каталог исходников с файлами из списка через запятую.
Функция КаталогИсходников(Знач ИменаФайлов = "a.txt")

	Каталог = ВременныеФайлы.СоздатьКаталог();
	Для Каждого Имя Из СтрРазделить(ИменаФайлов, ",") Цикл
		ТестовыеФайлы.Файл(Каталог, Имя, "содержимое " + Имя);
	КонецЦикла;

	Возврат Каталог;

КонецФункции

// Минимальный EDT-проект: объект Справочник1 с модулем, корень и волатильный служебный файл;
// для расширения - ещё модуль управляемого приложения в корне.
Функция ПроектEDT(Знач Расширение = Ложь)

	Каталог = ТестовыеФайлы.КаталогEDT();
	ТестовыеФайлы.Файл(Каталог, "src/Catalogs/Справочник1/Справочник1.mdo", "<mdo/>");
	ТестовыеФайлы.Файл(Каталог, "src/Catalogs/Справочник1/ObjectModule.bsl", "// модуль");
	ТестовыеФайлы.Файл(Каталог, "DT-INF/PROJECT.PMF", "volatile");
	Если Расширение Тогда
		ТестовыеФайлы.Файл(Каталог, "src/Configuration/ManagedApplicationModule.bsl", "// модуль приложения");
	КонецЕсли;

	Возврат Каталог;

КонецФункции

// Минимальный XML-дамп Конфигуратора, соответствующий ПроектEDT.
Функция ДампXML()

	Каталог = ТестовыеФайлы.КаталогXML();
	ТестовыеФайлы.Файл(Каталог, "ConfigDumpInfo.xml", "<dump/>");
	ТестовыеФайлы.Файл(Каталог, "Catalogs/Справочник1.xml", "<Catalog/>");
	ТестовыеФайлы.Файл(Каталог, "Catalogs/Справочник1/Ext/ObjectModule.bsl", "// модуль");

	Возврат Каталог;

КонецФункции

// Ответ СервисПлатформы.ПолучитьИзмененияКонфигурации: по ConfigDumpInfo изменений нет.
Функция ИзмененийПоConfigDumpInfoНет()
	Возврат Новый Структура("ТребуетсяПолнаяЗагрузка, ИзмененныеФайлы", Ложь, Новый Массив);
КонецФункции

Функция НормализоватьПути(Знач Файлы)

	Результат = Новый Массив;
	Для Каждого Путь Из Файлы Цикл
		Результат.Добавить(СтрЗаменить(СокрЛП(Путь), "\", "/"));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Файл-список в массив относительных путей с прямыми слешами.
Функция ПрочитатьСписок(Знач ПутьСписка)
	Возврат НормализоватьПути(СтрРазделить(ТестовыеФайлы.ПрочитатьФайл(ПутьСписка), Символы.ПС, Ложь));
КонецФункции

#КонецОбласти
