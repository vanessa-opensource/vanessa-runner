#Область РассчитатьИнкрементКонфигурации

&Тест
Процедура ТестДолжен_ВернутьИсходныйСписок_ЕслиКонтекстаНет() Экспорт

	// Дано
	Сервис = Новый БилдерСервисаРасчетаИнкремента().Собрать();

	// Когда
	Результат = Сервис.РассчитатьИнкрементКонфигурации("C:\src", Неопределено, Неопределено, "list.txt");

	// Тогда
	Ожидаем.Что(Результат.СписокФайловДляЗагрузки).Равно("list.txt");
	Ожидаем.Что(Результат.ПропуститьЗагрузку).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыполнитьПолнуюЗагрузку_ЕслиИндексОтсутствует() Экспорт

	// Дано
	КаталогИсточников = СоздатьКаталогСФайлами(СтрРазделить("a.txt", ","));
	Сервис = Новый БилдерСервисаРасчетаИнкремента().Собрать();
	Контекст = Сервис.ПодготовитьИнкремент(КаталогИсточников, Подключения.Файловая("C:\b"));

	// Когда
	Результат = Сервис.РассчитатьИнкрементКонфигурации(КаталогИсточников, Контекст);

	// Тогда - индекс ещё не базовый, значит полная загрузка
	Ожидаем.Что(Результат.ПропуститьЗагрузку).ЭтоЛожь();
	Ожидаем.Что(Результат.СписокФайловДляЗагрузки).Равно("");

КонецПроцедуры

