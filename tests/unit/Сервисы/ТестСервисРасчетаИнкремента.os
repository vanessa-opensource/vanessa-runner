КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьИстину_ЕслиСодержимоеОтличается() Экспорт

	// Дано
	Каталог = ВременныеФайлы.СоздатьКаталог();
	ПутьКеш = ОбъединитьПути(Каталог, "cache.xml");
	ПутьТекущий = ОбъединитьПути(Каталог, "current.xml");
	Запись = Новый ЗаписьТекста(ПутьКеш, "UTF-8");
	Запись.Записать("<a/>");
	Запись.Закрыть();
	Запись = Новый ЗаписьТекста(ПутьТекущий, "UTF-8");
	Запись.Записать("<b/>");
	Запись.Закрыть();

	Контекст = Новый Структура(
		"ПутьКешаConfigDumpInfo, ПутьТекущегоConfigDumpInfo",
		ПутьКеш, ПутьТекущий);
	Сервис = Новый БилдерСервисаРасчетаИнкремента().Собрать();

	// Когда / Тогда
	Ожидаем.Что(Сервис.ИзменилсяConfigDumpInfo(Контекст)).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ДобавитьИзмененныеФайлы

&Тест
Процедура ТестДолжен_ДополнитьСписокИзменений_БезДубликатов() Экспорт

	// Дано
	Сервис = Новый БилдерСервисаРасчетаИнкремента().Собрать();
	Результат = Новый РезультатСравнения;
	Результат.ДобавитьИзмененный("a.xml");
	Дополнительные = Новый Массив;
	Дополнительные.Добавить("a.xml");   // дубликат, не должен попасть
	Дополнительные.Добавить("b.xml");

	// Когда
	Сервис.ДобавитьИзмененныеФайлы(Результат, Дополнительные);

	// Тогда
	Ожидаем.Что(Результат.Измененные().Количество()).Равно(2);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НичегоНеДелать_ЕслиИзмененныеФайлыНеопределены() Экспорт

	// Дано
	Сервис = Новый БилдерСервисаРасчетаИнкремента().Собрать();
	Результат = Новый РезультатСравнения;
	Результат.ДобавитьИзмененный("a.xml");

	// Когда
	Сервис.ДобавитьИзмененныеФайлы(Результат, Неопределено);

	// Тогда
	Ожидаем.Что(Результат.Измененные().Количество()).Равно(1);

КонецПроцедуры

#КонецОбласти
