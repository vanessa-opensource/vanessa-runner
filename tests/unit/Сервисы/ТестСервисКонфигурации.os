// BSLLS:NumberOfValuesInStructureConstructor-off
// BSLLS-off
// Юнит-тесты СервисКонфигурации.
// Реальные движки (v8runner, ibcmd) не вызываются - все взаимодействия с движками замоканы.
// Покрытие: оркестрация пайплайнов (создание/очистка временной базы, выбор движка,
// делегирование вызовов, обработка инкрементальной загрузки).

#Использовать asserts
#Использовать moskito

#Использовать "../../../src/core/Движки"
#Использовать "../../../src/core/Сервисы"
#Использовать "../utils"

Перем Подключения;
Перем Любое;

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	Подключения = Новый ДанныеПодключений;
	Любое = Матчеры.ЛюбоеЗначение();
КонецПроцедуры

#Область СобратьВФайлCf

&Тест
Процедура ТестДолжен_СобратьCfЧерезДвижокКонфигуратор() Экспорт

	// Дано
	МокДвижок = Мок.Получить(Новый ДвижокКонфигуратор);
	МокДвижок.Когда().СоздатьВременнуюБазу(Любое)
		.ТогдаВозвращает(Подключения.Файловая("C:\tmp\fake"));

	Сервис = Новый БилдерСервисаКонфигурации()
		.СОдинаковымДвижком(МокДвижок)
		.Собрать();

	// Когда
	Сервис.СобратьВФайлCf("C:\src", "C:\out\config.cf");

	// Тогда
	МокДвижок.ПроверитьЧтоВызывалсяМетод().СоздатьВременнуюБазу(Любое);
	МокДвижок.ПроверитьЧтоВызывалсяМетод().ЗагрузитьКонфигурациюИзФайлов(Любое, "C:\src", Любое, Любое);
	МокДвижок.ПроверитьЧтоВызывалсяМетод().ВыгрузитьКонфигурациюВФайл(Любое, "C:\out\config.cf", Любое);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СобратьCfЧерезДвижокIbcmdПриФлаге() Экспорт

	// Дано
	МокКонфигуратор = Мок.Получить(Новый ДвижокКонфигуратор);
	МокIbcmd = Мок.Получить(Новый ДвижокКонфигуратор);
	МокIbcmd.Когда().СоздатьВременнуюБазу(Любое)
		.ТогдаВозвращает(Подключения.Файловая("C:\tmp\fake"));

	Сервис = Новый БилдерСервисаКонфигурации()
		.СДвижкомКонфигуратор(МокКонфигуратор)
		.СДвижкомIbcmd(МокIbcmd)
		.Собрать();

	// Когда
	Сервис.СобратьВФайлCf("C:\src", "C:\out\config.cf", Истина);

	// Тогда
	МокIbcmd.ПроверитьЧтоВызывалсяМетод().СоздатьВременнуюБазу(Любое);
	МокIbcmd.ПроверитьЧтоВызывалсяМетод().ЗагрузитьКонфигурациюИзФайлов(Любое, "C:\src", Любое, Любое);
	МокIbcmd.ПроверитьЧтоВызывалсяМетод().ВыгрузитьКонфигурациюВФайл(Любое, "C:\out\config.cf", Любое);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИспользоватьВнешнююБазу_БезСозданияВременной() Экспорт

	// Дано
	МокДвижок = Мок.Получить(Новый ДвижокКонфигуратор);
	ВнешниеПараметры = Подключения.Файловая("C:\external\base");

	Сервис = Новый БилдерСервисаКонфигурации()
		.СОдинаковымДвижком(МокДвижок)
		.Собрать();

	// Когда
	Сервис.СобратьВФайлCf("C:\src", "C:\out.cf", Ложь, Неопределено, "", ВнешниеПараметры);

	// Тогда - внешняя база используется напрямую (движок не вызывал
	// СоздатьВременнуюБазу - иначе вернул бы Неопределено и СтрокаПодключения = ...
	// выбросило бы ошибку при попытке обращения).
	МокДвижок.ПроверитьЧтоВызывалсяМетод().ЗагрузитьКонфигурациюИзФайлов(Любое, "C:\src", Любое, Любое);
	МокДвижок.ПроверитьЧтоВызывалсяМетод().ВыгрузитьКонфигурациюВФайл(Любое, "C:\out.cf", Любое);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОчиститьВременнуюБазуПриОшибкеЗагрузки() Экспорт

	// Дано
	МокДвижок = Мок.Получить(Новый ДвижокКонфигуратор);
	ПараметрыПодключения = Подключения.ВременнаяФайловая();
	КаталогВременнойБазы = ПараметрыПодключения.КаталогБазы;

	МокДвижок.Когда().СоздатьВременнуюБазу(Любое).ТогдаВозвращает(ПараметрыПодключения);
	МокДвижок.Когда().ЗагрузитьКонфигурациюИзФайлов(Любое, Любое, Любое, Любое)
		.ТогдаВыбрасываетИсключение(Новый ИнформацияОбОшибке("Ошибка загрузки", Новый Структура));

	Сервис = Новый БилдерСервисаКонфигурации()
		.СОдинаковымДвижком(МокДвижок)
		.Собрать();

	// Когда
	БылоИсключение = Ложь;
	Попытка
		Сервис.СобратьВФайлCf("C:\src", "C:\out.cf");
	Исключение
		БылоИсключение = Истина;
	КонецПопытки;

	// Тогда
	Ожидаем.Что(БылоИсключение).ЭтоИстина();
	Ожидаем.Что(Новый Файл(КаталогВременнойБазы).Существует()).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОчиститьВременнуюБазуПриОшибкеВыгрузки() Экспорт

	// Дано
	МокДвижок = Мок.Получить(Новый ДвижокКонфигуратор);
	ПараметрыПодключения = Подключения.ВременнаяФайловая();
	КаталогВременнойБазы = ПараметрыПодключения.КаталогБазы;

	МокДвижок.Когда().СоздатьВременнуюБазу(Любое).ТогдаВозвращает(ПараметрыПодключения);
	МокДвижок.Когда().ВыгрузитьКонфигурациюВФайл(Любое, Любое, Любое)
		.ТогдаВыбрасываетИсключение(Новый ИнформацияОбОшибке("Ошибка выгрузки", Новый Структура));

	Сервис = Новый БилдерСервисаКонфигурации()
		.СОдинаковымДвижком(МокДвижок)
		.Собрать();

	// Когда
	БылоИсключение = Ложь;
	Попытка
		Сервис.СобратьВФайлCf("C:\src", "C:\out.cf");
	Исключение
		БылоИсключение = Истина;
	КонецПопытки;

	// Тогда
	Ожидаем.Что(БылоИсключение).ЭтоИстина();
	Ожидаем.Что(Новый Файл(КаталогВременнойБазы).Существует()).ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область РазобратьКонфигурациюВИсходники

&Тест
Процедура ТестДолжен_РазобратьCfЧерезДвижокКонфигуратор() Экспорт

	// Дано
	МокДвижок = Мок.Получить(Новый ДвижокКонфигуратор);
	МокДвижок.Когда().СоздатьВременнуюБазу(Любое)
		.ТогдаВозвращает(Подключения.Файловая("C:\tmp\fake"));

	Сервис = Новый БилдерСервисаКонфигурации()
		.СОдинаковымДвижком(МокДвижок)
		.Собрать();

	// Когда
	Сервис.РазобратьКонфигурациюВИсходники("C:\in.cf", "C:\out\src");

	// Тогда
	МокДвижок.ПроверитьЧтоВызывалсяМетод().СоздатьВременнуюБазу(Любое);
	МокДвижок.ПроверитьЧтоВызывалсяМетод().ЗагрузитьКонфигурациюИзФайла(Любое, "C:\in.cf", Любое);
	МокДвижок.ПроверитьЧтоВызывалсяМетод().ВыгрузитьКонфигурациюВФайлы(Любое, "C:\out\src", Любое);

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазобратьИзБазы_БезЗагрузкиCf() Экспорт

	// Дано - переданная база; загрузка из файла и временная база при вызове кидают исключение,
	// что доказывает их пропуск (moskito не умеет проверять отсутствие вызова напрямую).
	МокДвижок = Мок.Получить(Новый ДвижокКонфигуратор);
	ВнешниеПараметры = Подключения.Файловая("C:\external\base");
	МокДвижок.Когда().ЗагрузитьКонфигурациюИзФайла(Любое, Любое, Любое)
		.ТогдаВыбрасываетИсключение(Новый ИнформацияОбОшибке("Загрузка не должна вызываться", Новый Структура));
	МокДвижок.Когда().СоздатьВременнуюБазу(Любое)
		.ТогдаВыбрасываетИсключение(Новый ИнформацияОбОшибке("Временная база не должна создаваться", Новый Структура));

	Сервис = Новый БилдерСервисаКонфигурации()
		.СОдинаковымДвижком(МокДвижок)
		.Собрать();

	// Когда - cf не задан, выгрузка из переданной базы
	Сервис.РазобратьКонфигурациюВИсходники("", "C:\out\src", Ложь, Неопределено, ВнешниеПараметры);

	// Тогда - выгрузка выполнена (а пропуск загрузки/создания базы гарантирован отсутствием исключения)
	МокДвижок.ПроверитьЧтоВызывалсяМетод().ВыгрузитьКонфигурациюВФайлы(Любое, "C:\out\src", Любое);

КонецПроцедуры

&Тест
Процедура ТестДолжен_БроситьИсключение_ЕслиНетCfИНетБазы() Экспорт

	// Дано
	МокДвижок = Мок.Получить(Новый ДвижокКонфигуратор);
	Сервис = Новый БилдерСервисаКонфигурации()
		.СОдинаковымДвижком(МокДвижок)
		.Собрать();

	// Когда - ни cf, ни базы (потребовалась бы временная)
	БылоИсключение = Ложь;
	ТекстИсключения = "";
	Попытка
		Сервис.РазобратьКонфигурациюВИсходники("", "C:\out\src");
	Исключение
		БылоИсключение = Истина;
		ТекстИсключения = ОписаниеОшибки();
	КонецПопытки;

	// Тогда - сработала именно проверка параметров (до любых вызовов движка)
	Ожидаем.Что(БылоИсключение).ЭтоИстина();
	Ожидаем.Что(ТекстИсключения).Содержит("не передана информационная база");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОчиститьВременнуюБазуПриОшибкеРазборки() Экспорт

	// Дано
	МокДвижок = Мок.Получить(Новый ДвижокКонфигуратор);
	ПараметрыПодключения = Подключения.ВременнаяФайловая();
	КаталогВременнойБазы = ПараметрыПодключения.КаталогБазы;

	МокДвижок.Когда().СоздатьВременнуюБазу(Любое).ТогдаВозвращает(ПараметрыПодключения);
	МокДвижок.Когда().ВыгрузитьКонфигурациюВФайлы(Любое, Любое, Любое)
		.ТогдаВыбрасываетИсключение(Новый ИнформацияОбОшибке("Ошибка разборки", Новый Структура));

	Сервис = Новый БилдерСервисаКонфигурации()
		.СОдинаковымДвижком(МокДвижок)
		.Собрать();

	// Когда
	БылоИсключение = Ложь;
	Попытка
		Сервис.РазобратьКонфигурациюВИсходники("C:\in.cf", "C:\out\src");
	Исключение
		БылоИсключение = Истина;
	КонецПопытки;

	// Тогда
	Ожидаем.Что(БылоИсключение).ЭтоИстина();
	Ожидаем.Что(Новый Файл(КаталогВременнойБазы).Существует()).ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область ЗагрузитьКонфигурациюИзФайла

&Тест
Процедура ТестДолжен_ЗагрузитьКонфигурациюИзФайла_Делегат() Экспорт

	// Дано
	МокДвижок = Мок.Получить(Новый ДвижокКонфигуратор);
	Сервис = Новый БилдерСервисаКонфигурации()
		.СОдинаковымДвижком(МокДвижок)
		.Собрать();

	// Когда
	Сервис.ЗагрузитьКонфигурациюИзФайла(Подключения.Файловая("C:\base"), "C:\in.cf");

	// Тогда - без создания/очистки временной базы (делегат напрямую в движок)
	МокДвижок.ПроверитьЧтоВызывалсяМетод().ЗагрузитьКонфигурациюИзФайла(Любое, "C:\in.cf", Любое);

КонецПроцедуры

