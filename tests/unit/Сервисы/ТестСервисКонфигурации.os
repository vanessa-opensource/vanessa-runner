КонецПроцедуры

#КонецОбласти

#Область СоздатьФайлПоставки

&Тест
Процедура ТестДолжен_СоздатьФайлПоставкиЧерезДвижокКонфигуратор() Экспорт

	// Дано
	МокКонфигуратор = Мок.Получить(Новый ДвижокКонфигуратор);
	Сервис = Новый БилдерСервисаКонфигурации()
		.СДвижкомКонфигуратор(МокКонфигуратор)
		.Собрать();
	ПараметрыПлатформы = Новый Структура("ВерсияПлатформы, КодРазрешения, Язык, Локаль",
		"8.3.24", "code", "ru", "ru_RU");

	// Когда
	Сервис.СоздатьФайлПоставки(
		Подключения.Файловая("C:\base"), "C:\out\1Cv8.cf", ПараметрыПлатформы);

	// Тогда
	МокКонфигуратор.ПроверитьЧтоВызывалсяМетод().СоздатьФайлыПоставки(
		Любое, "C:\out\1Cv8.cf", ПараметрыПлатформы);

КонецПроцедуры

#КонецОбласти

#Область ЗагрузитьКонфигурациюИзФайлов

&Тест
Процедура ТестДолжен_ЗагрузитьКонфигурациюИзФайлов_БезИнкремента() Экспорт

	// Дано
	МокДвижок = Мок.Получить(Новый ДвижокКонфигуратор);
	Сервис = Новый БилдерСервисаКонфигурации()
		.СОдинаковымДвижком(МокДвижок)
		.Собрать();

	// Когда
	Сервис.ЗагрузитьКонфигурациюИзФайлов(Подключения.Файловая("C:\base"), "C:\src");

	// Тогда
	МокДвижок.ПроверитьЧтоВызывалсяМетод().ЗагрузитьКонфигурациюИзФайлов(Любое, "C:\src", Любое, Любое);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПропуститьЗагрузку_ЕслиИнкрементПусто() Экспорт

	// Дано
	МокДвижок = Мок.Получить(Новый ДвижокКонфигуратор);
	МокИнкремент = Мок.Получить(Тип("СервисРасчетаИнкремента"));
	РезультатИнкремента = Новый Структура("ПропуститьЗагрузку, СписокФайловДляЗагрузки, КонтекстИнкремента",
		Истина, "", Новый Структура);
	МокИнкремент.Когда().РассчитатьИнкрементДляЗагрузкиКонфигурации(Любое, Любое, Любое, Любое, Любое)
		.ТогдаВозвращает(РезультатИнкремента);

	Сервис = Новый БилдерСервисаКонфигурации()
		.СОдинаковымДвижком(МокДвижок)
		.СРасчетомИнкремента(МокИнкремент)
		.Собрать();

	// Когда
	Сервис.ЗагрузитьКонфигурациюИзФайлов(Подключения.Файловая("C:\base"), "C:\src", Ложь, Неопределено, "", Истина);

	// Тогда
	МокИнкремент.ПроверитьЧтоВызывалсяМетод().РассчитатьИнкрементДляЗагрузкиКонфигурации(Любое, Любое, Любое, Любое, Любое);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗафиксироватьИнкрементПослеЗагрузки() Экспорт

	// Дано
	МокДвижок = Мок.Получить(Новый ДвижокКонфигуратор);
	МокИнкремент = Мок.Получить(Тип("СервисРасчетаИнкремента"));
	КонтекстИнкремента = Новый Структура("Идентификатор", "abc");
	РезультатИнкремента = Новый Структура("ПропуститьЗагрузку, СписокФайловДляЗагрузки, КонтекстИнкремента",
		Ложь, "C:\file1.xml,C:\file2.xml", КонтекстИнкремента);
	МокИнкремент.Когда().РассчитатьИнкрементДляЗагрузкиКонфигурации(Любое, Любое, Любое, Любое, Любое)
		.ТогдаВозвращает(РезультатИнкремента);

	Сервис = Новый БилдерСервисаКонфигурации()
		.СОдинаковымДвижком(МокДвижок)
		.СРасчетомИнкремента(МокИнкремент)
		.Собрать();

	// Когда
	Сервис.ЗагрузитьКонфигурациюИзФайлов(Подключения.Файловая("C:\base"), "C:\src", Ложь, Неопределено, "", Истина);

	// Тогда
	МокДвижок.ПроверитьЧтоВызывалсяМетод().ЗагрузитьКонфигурациюИзФайлов(Любое, "C:\src", Любое, "C:\file1.xml,C:\file2.xml");
	МокИнкремент.ПроверитьЧтоВызывалсяМетод().ЗафиксироватьИнкремент(КонтекстИнкремента);

КонецПроцедуры

#КонецОбласти

#Область ОбъединитьКонфигурациюСФайлом

&Тест
Процедура ТестДолжен_ОбъединитьКонфигурациюСФайлом_Делегат() Экспорт

	// Дано
	МокКонфигуратор = Мок.Получить(Новый ДвижокКонфигуратор);
	МокIbcmd = Мок.Получить(Новый ДвижокКонфигуратор);

	Сервис = Новый БилдерСервисаКонфигурации()
		.СДвижкомКонфигуратор(МокКонфигуратор)
		.СДвижкомIbcmd(МокIbcmd)
		.Собрать();

	// Когда
	Сервис.ОбъединитьКонфигурациюСФайлом(
		Подключения.Файловая("C:\base"), "C:\merge.cf", "C:\settings.xml");

	// Тогда - объединение идёт всегда через конфигуратор
	МокКонфигуратор.ПроверитьЧтоВызывалсяМетод().ОбъединитьКонфигурациюСФайлом(
		Любое, "C:\merge.cf", "C:\settings.xml", Любое, Любое, Любое, Любое);

КонецПроцедуры

#КонецОбласти

#Область СравнитьКонфигурации

&Тест
Процедура ТестДолжен_СравнитьКонфигурации_ВернутьПутьКОтчёту() Экспорт

	// Дано
	МокДвижок = Мок.Получить(Новый ДвижокКонфигуратор);
	МокДвижок.Когда().СоздатьВременнуюБазу(Любое)
		.ТогдаВозвращает(Подключения.Файловая("C:\tmp\fake"));

	Сервис = Новый БилдерСервисаКонфигурации()
		.СОдинаковымДвижком(МокДвижок)
		.Собрать();

	// Когда
	ПутьКОтчёту = Сервис.СравнитьКонфигурации(
		Неопределено, "C:\second.cf", "C:\reports", "FullChanges", "txt");

	// Тогда
	МокДвижок.ПроверитьЧтоВызывалсяМетод().СравнитьКонфигурации(
		Любое, "C:\second.cf", Любое, "FullChanges", "txt", Любое, Любое);
	Ожидаем.Что(ПутьКОтчёту).Содержит("compare_report_fullchanges_");
	Ожидаем.Что(ПутьКОтчёту).Содержит(".txt");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОчиститьВременнуюБазуПриОшибкеСравнения() Экспорт

	// Дано
	МокДвижок = Мок.Получить(Новый ДвижокКонфигуратор);
	ПараметрыПодключения = Подключения.ВременнаяФайловая();
	КаталогВременнойБазы = ПараметрыПодключения.КаталогБазы;

	МокДвижок.Когда().СоздатьВременнуюБазу(Любое).ТогдаВозвращает(ПараметрыПодключения);
	МокДвижок.Когда().СравнитьКонфигурации(Любое, Любое, Любое, Любое, Любое, Любое, Любое)
		.ТогдаВыбрасываетИсключение(Новый ИнформацияОбОшибке("Ошибка сравнения", Новый Структура));

	Сервис = Новый БилдерСервисаКонфигурации()
		.СОдинаковымДвижком(МокДвижок)
		.Собрать();

	// Когда
	БылоИсключение = Ложь;
	Попытка
		Сервис.СравнитьКонфигурации(Неопределено, "C:\second.cf", "C:\reports", "FullChanges", "txt");
	Исключение
		БылоИсключение = Истина;
	КонецПопытки;

	// Тогда
	Ожидаем.Что(БылоИсключение).ЭтоИстина();
	Ожидаем.Что(Новый Файл(КаталогВременнойБазы).Существует()).ЭтоЛожь();

КонецПроцедуры

#КонецОбласти
