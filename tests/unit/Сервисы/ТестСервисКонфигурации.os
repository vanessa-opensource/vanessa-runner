// BSLLS-off
// Юнит-тесты СервисКонфигурации: выбор движка, оркестрация временной базы в пайплайнах сборки/разборки/
// сравнения, делегаты, инкрементальная загрузка. Движки, СервисEDT и расчёт инкремента замоканы.

#Использовать asserts
#Использовать moskito
#Использовать tempfiles
#Использовать "../utils"

Перем Стенд;
Перем Сервис;
Перем Конфигуратор; // мок ДвижокКонфигуратор
Перем База;
Перем Любое;

&ПередКаждым
Процедура ПередКаждым() Экспорт
	Стенд = Новый Стенд;
	Стенд.Реальный("СервисВременнойБазы");    // выбор движка и жизненный цикл временной ИБ настоящие, движки - моки
	Стенд.Реальный("СервисПоискаИсточников"); // тип источника определяется по маркерам на диске
	Сервис = Стенд.Сервис("СервисКонфигурации");
	Конфигуратор = Стенд.Мок("ДвижокКонфигуратор");
	База = ТестовыеДанные.Файловая("base");
	Любое = Матчеры.ЛюбоеЗначение();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт
	ВременныеФайлы.Удалить();
КонецПроцедуры

#Область ЗагрузитьКонфигурациюИзФайлов

&Тест
Процедура ТестДолжен_ЗагрузитьКонфигурациюИзФайлов_БезИнкремента() Экспорт

	// Когда
	Сервис.ЗагрузитьКонфигурациюИзФайлов(База, "src");

	// Тогда - загрузка без списка файлов, инкремент не считался, XML-контекст закрыт
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().ЗагрузитьКонфигурациюИзФайлов(База, "src", Неопределено, "");
	Стенд.ПроверитьЧтоНеВызывался("СервисРасчетаИнкремента", "РассчитатьИнкрементДляЗагрузкиКонфигурации");
	Стенд.Мок("СервисEDT").ПроверитьЧтоВызывалсяМетод().ЗавершитьXML(Любое);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПропуститьЗагрузку_ЕслиИнкрементПуст() Экспорт

	// Дано
	Инкремент = Стенд.Мок("СервисРасчетаИнкремента");
	Инкремент.Когда().РассчитатьИнкрементДляЗагрузкиКонфигурации(Любое, Любое, Любое, Любое)
		.ТогдаВозвращает(ТестовыеДанные.РезультатИнкремента("", Истина));

	// Когда - ИнкрементальнаяЗагрузка = Истина
	Сервис.ЗагрузитьКонфигурациюИзФайлов(База, "src", Неопределено, "", Истина);

	// Тогда - инкремент рассчитан, загрузки и фиксации нет
	Инкремент.ПроверитьЧтоВызывалсяМетод().РассчитатьИнкрементДляЗагрузкиКонфигурации("src", База, Неопределено, "");
	Стенд.ПроверитьЧтоНеВызывался("ДвижокКонфигуратор", "ЗагрузитьКонфигурациюИзФайлов");
	Стенд.ПроверитьЧтоНеВызывался("СервисРасчетаИнкремента", "ЗафиксироватьИнкремент");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗафиксироватьИнкремент_ПослеЗагрузки() Экспорт

	// Дано
	КонтекстИнкремента = Новый Структура("Идентификатор", "abc");
	Инкремент = Стенд.Мок("СервисРасчетаИнкремента");
	Инкремент.Когда().РассчитатьИнкрементДляЗагрузкиКонфигурации(Любое, Любое, Любое, Любое)
		.ТогдаВозвращает(ТестовыеДанные.РезультатИнкремента("file1.xml,file2.xml", Ложь, КонтекстИнкремента));

	// Когда
	Сервис.ЗагрузитьКонфигурациюИзФайлов(База, "src", Неопределено, "", Истина);

	// Тогда - выборочная загрузка и фиксация инкремента
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().ЗагрузитьКонфигурациюИзФайлов(База, "src", Неопределено, "file1.xml,file2.xml");
	Инкремент.ПроверитьЧтоВызывалсяМетод().ЗафиксироватьИнкремент(КонтекстИнкремента);

КонецПроцедуры

#КонецОбласти

#Область ЗагрузитьКонфигурациюИзФайла_ВыгрузитьКонфигурациюВФайл

&Тест
Процедура ТестДолжен_ЗагрузитьКонфигурациюИзФайла_Делегат() Экспорт

	// Когда
	Сервис.ЗагрузитьКонфигурациюИзФайла(База, "in.cf");

	// Тогда - напрямую в движок, без временной базы
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().ЗагрузитьКонфигурациюИзФайла(База, "in.cf", Неопределено);
	Стенд.ПроверитьЧтоНеВызывался("ДвижокКонфигуратор", "СоздатьВременнуюБазу");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыгрузитьКонфигурациюВФайл_Делегат() Экспорт

	// Когда
	Сервис.ВыгрузитьКонфигурациюВФайл(База, "out.cf");

	// Тогда
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().ВыгрузитьКонфигурациюВФайл(База, "out.cf", Неопределено);
	Стенд.ПроверитьЧтоНеВызывался("ДвижокКонфигуратор", "СоздатьВременнуюБазу");

КонецПроцедуры

#КонецОбласти

#Область ЗагрузитьИсточник

&Тест
Процедура ТестДолжен_ЗагрузитьИзФайлаCf_ЕслиИсточникCf() Экспорт

	// Дано
	ФайлCf = ТестовыеФайлы.ВременныйФайл("cf");

	// Когда
	Вид = Сервис.ЗагрузитьИсточник(База, ФайлCf);

	// Тогда
	Ожидаем.Что(Вид).Равно("cf");
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().ЗагрузитьКонфигурациюИзФайла(База, ФайлCf, Неопределено);
	Стенд.ПроверитьЧтоНеВызывался("ДвижокКонфигуратор", "ЗагрузитьКонфигурациюИзФайлов");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗагрузитьИзИсходниковСИнкрементом_ЕслиИсточникКаталог() Экспорт

	// Дано
	Исходники = ТестовыеФайлы.КаталогXML();
	Инкремент = Стенд.Мок("СервисРасчетаИнкремента");
	Инкремент.Когда().РассчитатьИнкрементДляЗагрузкиКонфигурации(Любое, Любое, Любое, Любое)
		.ТогдаВозвращает(ТестовыеДанные.РезультатИнкремента("file1.xml"));

	// Когда - ИнкрементальнаяЗагрузка = Истина
	Вид = Сервис.ЗагрузитьИсточник(База, Исходники, Неопределено, Неопределено, Истина);

	// Тогда
	Ожидаем.Что(Вид).Равно("xml");
	Инкремент.ПроверитьЧтоВызывалсяМетод().РассчитатьИнкрементДляЗагрузкиКонфигурации(Исходники, База, Неопределено, "");
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().ЗагрузитьКонфигурациюИзФайлов(База, Исходники, Неопределено, "file1.xml");
	Стенд.ПроверитьЧтоНеВызывался("ДвижокКонфигуратор", "ЗагрузитьКонфигурациюИзФайла");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПередатьСписокФайловДвижку_БезРасчетаИнкремента() Экспорт

	// Дано
	Исходники = ТестовыеФайлы.КаталогXML();

	// Когда - список файлов задан явно
	Сервис.ЗагрузитьИсточник(База, Исходники, Неопределено, Неопределено, Истина, "list.txt");

	// Тогда
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().ЗагрузитьКонфигурациюИзФайлов(База, Исходники, Неопределено, "list.txt");
	Стенд.ПроверитьЧтоНеВызывался("СервисРасчетаИнкремента", "РассчитатьИнкрементДляЗагрузкиКонфигурации");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПередатьПараметрыИсходниковВСервисEDT() Экспорт

	// Дано
	Исходники = ТестовыеФайлы.КаталогXML();
	ПараметрыИсходников = ТестовыеДанные.ПараметрыИсходников("edt");

	// Когда
	Сервис.ЗагрузитьИсточник(База, Исходники, Неопределено, ПараметрыИсходников);

	// Тогда
	Подготовка = Стенд.Вызовы("СервисEDT", "ПодготовитьXML")[0];
	Ожидаем.Что(Подготовка.ПутьИсточника).Равно(Исходники);
	Ожидаем.Что(Подготовка.ПараметрыИсходников).Равно(ПараметрыИсходников);

КонецПроцедуры

#КонецОбласти

#Область СоздатьФайлПоставки

&Тест
Процедура ТестДолжен_СоздатьФайлПоставки_ЧерезДвижокКонфигуратор() Экспорт

	// Дано
	ПараметрыПлатформы = Новый Структура("ВерсияПлатформы, КодРазрешения, Язык, Локаль", "8.3.24", "code", "ru", "ru_RU");

	// Когда
	Сервис.СоздатьФайлПоставки(База, "out/1Cv8.cf", ПараметрыПлатформы);

	// Тогда
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().СоздатьФайлыПоставки(База, "out/1Cv8.cf", ПараметрыПлатформы);

КонецПроцедуры

#КонецОбласти

#Область СобратьВФайлCf

&Тест
Процедура ТестДолжен_СобратьCf_ЧерезДвижокКонфигуратор() Экспорт

	// Когда
	Сервис.СобратьВФайлCf("src", "out/config.cf");

	// Тогда - временная база создана, загрузка исходников и выгрузка cf в ней
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().СоздатьВременнуюБазу(Неопределено);
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().ЗагрузитьКонфигурациюИзФайлов(Любое, "src", Неопределено, "");
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().ВыгрузитьКонфигурациюВФайл(Любое, "out/config.cf", Неопределено);
	Стенд.ПроверитьЧтоНеВызывался("ДвижокIbcmd", "СоздатьВременнуюБазу");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СобратьCf_ЧерезДвижокIbcmd_ПриФлаге() Экспорт

	// Дано
	ПараметрыПлатформы = ТестовыеДанные.ПараметрыПлатформы(Истина);

	// Когда
	Сервис.СобратьВФайлCf("src", "out/config.cf", ПараметрыПлатформы);

	// Тогда
	Ibcmd = Стенд.Мок("ДвижокIbcmd");
	Ibcmd.ПроверитьЧтоВызывалсяМетод().СоздатьВременнуюБазу(ПараметрыПлатформы);
	Ibcmd.ПроверитьЧтоВызывалсяМетод().ЗагрузитьКонфигурациюИзФайлов(Любое, "src", ПараметрыПлатформы, "");
	Ibcmd.ПроверитьЧтоВызывалсяМетод().ВыгрузитьКонфигурациюВФайл(Любое, "out/config.cf", ПараметрыПлатформы);
	Стенд.ПроверитьЧтоНеВызывался("ДвижокКонфигуратор", "СоздатьВременнуюБазу");
	Стенд.ПроверитьЧтоНеВызывался("ДвижокКонфигуратор", "ЗагрузитьКонфигурациюИзФайлов");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИспользоватьВнешнююБазу_БезСозданияВременной() Экспорт

	// Дано
	ВнешняяБаза = ТестовыеДанные.Файловая("external/base");

	// Когда
	Сервис.СобратьВФайлCf("src", "out.cf", Неопределено, "", ВнешняяБаза);

	// Тогда - переданная база используется напрямую
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().ЗагрузитьКонфигурациюИзФайлов(ВнешняяБаза, "src", Неопределено, "");
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().ВыгрузитьКонфигурациюВФайл(ВнешняяБаза, "out.cf", Неопределено);
	Стенд.ПроверитьЧтоНеВызывался("ДвижокКонфигуратор", "СоздатьВременнуюБазу");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОчиститьВременнуюБазу_ПриОшибкеЗагрузки() Экспорт

	// Дано
	КаталогВременной = ВременныеФайлы.СоздатьКаталог();
	Конфигуратор.Когда().СоздатьВременнуюБазу(Любое).ТогдаВозвращает(ТестовыеДанные.Файловая(КаталогВременной));
	Конфигуратор.Когда().ЗагрузитьКонфигурациюИзФайлов(Любое, Любое, Любое, Любое).ТогдаВыбрасываетИсключение("Ошибка загрузки");

	// Когда / Тогда
	Ожидаем.Что(Сервис).Метод("СобратьВФайлCf", ТестовыеДанные.Массив("src", "out.cf")).ВыбрасываетИсключение("Ошибка загрузки");
	Ожидаем.Что(ТестовыеФайлы.Существует(КаталогВременной), "временная база удалена").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОчиститьВременнуюБазу_ПриОшибкеВыгрузки() Экспорт

	// Дано
	КаталогВременной = ВременныеФайлы.СоздатьКаталог();
	Конфигуратор.Когда().СоздатьВременнуюБазу(Любое).ТогдаВозвращает(ТестовыеДанные.Файловая(КаталогВременной));
	Конфигуратор.Когда().ВыгрузитьКонфигурациюВФайл(Любое, Любое, Любое).ТогдаВыбрасываетИсключение("Ошибка выгрузки");

	// Когда / Тогда
	Ожидаем.Что(Сервис).Метод("СобратьВФайлCf", ТестовыеДанные.Массив("src", "out.cf")).ВыбрасываетИсключение("Ошибка выгрузки");
	Ожидаем.Что(ТестовыеФайлы.Существует(КаталогВременной), "временная база удалена").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область РазобратьКонфигурациюВИсходники

&Тест
Процедура ТестДолжен_РазобратьCf_ЧерезДвижокКонфигуратор() Экспорт

	// Когда
	Сервис.РазобратьКонфигурациюВИсходники("in.cf", "out/src");

	// Тогда - временная база создана, загрузка cf и выгрузка в исходники в ней
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().СоздатьВременнуюБазу(Неопределено);
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().ЗагрузитьКонфигурациюИзФайла(Любое, "in.cf", Неопределено);
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().ВыгрузитьКонфигурациюВФайлы(Любое, "out/src", Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазобратьИзБазы_БезЗагрузкиCf() Экспорт

	// Дано
	ВнешняяБаза = ТестовыеДанные.Файловая("external/base");

	// Когда - cf не задан, выгрузка из переданной базы
	Сервис.РазобратьКонфигурациюВИсходники("", "out/src", Неопределено, ВнешняяБаза);

	// Тогда - без загрузки из файла и без временной базы
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().ВыгрузитьКонфигурациюВФайлы(ВнешняяБаза, "out/src", Неопределено);
	Стенд.ПроверитьЧтоНеВызывался("ДвижокКонфигуратор", "ЗагрузитьКонфигурациюИзФайла");
	Стенд.ПроверитьЧтоНеВызывался("ДвижокКонфигуратор", "СоздатьВременнуюБазу");

КонецПроцедуры

&Тест
Процедура ТестДолжен_БроситьИсключение_ЕслиНетCfИНетБазы() Экспорт

	// Проверка параметров срабатывает до любых вызовов движка
	Ожидаем.Что(Сервис).Метод("РазобратьКонфигурациюВИсходники", ТестовыеДанные.Массив("", "out/src"))
		.ВыбрасываетИсключение("не передана информационная база");
	Стенд.ПроверитьЧтоНеВызывался("ДвижокКонфигуратор", "СоздатьВременнуюБазу");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОчиститьВременнуюБазу_ПриОшибкеРазборки() Экспорт

	// Дано
	КаталогВременной = ВременныеФайлы.СоздатьКаталог();
	Конфигуратор.Когда().СоздатьВременнуюБазу(Любое).ТогдаВозвращает(ТестовыеДанные.Файловая(КаталогВременной));
	Конфигуратор.Когда().ВыгрузитьКонфигурациюВФайлы(Любое, Любое, Любое).ТогдаВыбрасываетИсключение("Ошибка разборки");

	// Когда / Тогда - временная база удалена, выгрузка прервана, а не завершена
	Ожидаем.Что(Сервис).Метод("РазобратьКонфигурациюВИсходники", ТестовыеДанные.Массив("in.cf", "out/src"))
		.ВыбрасываетИсключение("Ошибка разборки");
	Ожидаем.Что(ТестовыеФайлы.Существует(КаталогВременной), "временная база удалена").ЭтоЛожь();
	Стенд.Мок("СервисEDT").ПроверитьЧтоВызывалсяМетод().ПрерватьВыгрузку(Любое);
	Стенд.ПроверитьЧтоНеВызывался("СервисEDT", "ЗавершитьВыгрузку");

КонецПроцедуры

#КонецОбласти

#Область ОбъединитьКонфигурациюСФайлом

&Тест
Процедура ТестДолжен_ОбъединитьКонфигурациюСФайлом_Делегат() Экспорт

	// Когда
	Сервис.ОбъединитьКонфигурациюСФайлом(База, "merge.cf", "settings.xml");

	// Тогда - объединение идёт всегда через конфигуратор, флаги по умолчанию
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().ОбъединитьКонфигурациюСФайлом(
		База, "merge.cf", "settings.xml", Неопределено, Неопределено, Ложь, Неопределено);

КонецПроцедуры

#КонецОбласти

#Область СравнитьКонфигурации

&Тест
Процедура ТестДолжен_ВернутьПутьКОтчету_ПриСравненииКонфигураций() Экспорт

	// Когда - база не передана: сравнение во временной базе
	ПутьКОтчету = Сервис.СравнитьКонфигурации(Неопределено, "second.cf", "reports", "FullChanges", "txt");

	// Тогда - движку передан тот же путь отчёта, что возвращён вызывающему
	Ожидаем.Что(ПутьКОтчету).Содержит("compare_report_fullchanges_");
	Ожидаем.Что(ПутьКОтчету).Содержит(".txt");
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().СоздатьВременнуюБазу(Неопределено);
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().СравнитьКонфигурации(
		Любое, "second.cf", ПутьКОтчету, "FullChanges", "txt", Неопределено, Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОчиститьВременнуюБазу_ПриОшибкеСравнения() Экспорт

	// Дано
	КаталогВременной = ВременныеФайлы.СоздатьКаталог();
	Конфигуратор.Когда().СоздатьВременнуюБазу(Любое).ТогдаВозвращает(ТестовыеДанные.Файловая(КаталогВременной));
	Конфигуратор.Когда().СравнитьКонфигурации(Любое, Любое, Любое, Любое, Любое, Любое, Любое)
		.ТогдаВыбрасываетИсключение("Ошибка сравнения");

	// Когда / Тогда
	Ожидаем.Что(Сервис).Метод("СравнитьКонфигурации",
		ТестовыеДанные.Массив(Неопределено, "second.cf", "reports", "FullChanges", "txt"))
		.ВыбрасываетИсключение("Ошибка сравнения");
	Ожидаем.Что(ТестовыеФайлы.Существует(КаталогВременной), "временная база удалена").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область ПутьКОтчетуСравнения

&Тест
Процедура ТестДолжен_СобратьПутьКОтчетуСравнения_ВКаталогеОтчета() Экспорт

	Путь = Сервис.ПутьКОтчетуСравнения("reports", "Brief", "MXL");

	Ожидаем.Что(СтрНачинаетсяС(Путь, ОбъединитьПути("reports", "compare_report_brief_")), Путь).ЭтоИстина();
	Ожидаем.Что(СтрЗаканчиваетсяНа(Путь, ".mxl"), "формат в нижнем регистре как расширение").ЭтоИстина();

КонецПроцедуры

#КонецОбласти
