КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОжидатьОписание(Знач Описание, Знач Вид, Знач Содержимое)
	Ожидаем.Что(Описание.Вид, "вид источника").Равно(Вид);
	Ожидаем.Что(Описание.Содержимое, "содержимое источника").Равно(Содержимое);
КонецПроцедуры

// XML-дамп Конфигуратора в каталоге; ЭтоРасширение добавляет в Configuration.xml маркер ConfigurationExtensionPurpose.
Процедура СоздатьКонфигурациюXML(Знач Каталог, Знач ЭтоРасширение)
	Маркер = ?(ЭтоРасширение, "<ConfigurationExtensionPurpose>Customization</ConfigurationExtensionPurpose>", "");
	ТестовыеФайлы.Файл(Каталог, "Configuration.xml",
		"<MetaDataObject><Configuration><Properties><Name>Test</Name>" + Маркер + "</Properties></Configuration></MetaDataObject>");
КонецПроцедуры

// EDT-проект в каталоге: .project, DT-INF и дескриптор src/Configuration/Configuration.mdo.
// Расширение - по структурным маркерам mdclassExtension:ConfigurationExtension и objectBelonging, без
// configurationExtensionPurpose (EDT опускает его при назначении по умолчанию). Дескриптор конфигурации
// содержит configurationExtensionCompatibilityMode: эта подстрока не должна считаться маркером расширения.
Процедура СоздатьEDTПроект(Знач Каталог, Знач ЭтоРасширение)

	ТестовыеФайлы.Файл(Каталог, ".project");
	ТестовыеФайлы.Файл(Каталог, "DT-INF/PROJECT.PMF");

	Строки = Новый Массив;
	Строки.Добавить("<mdclass:Configuration xmlns:mdclass=""http://g5.1c.ru/v8/dt/metadata/mdclass"" uuid=""1"">");
	Если ЭтоРасширение Тогда
		Строки.Добавить("  <objectBelonging>Adopted</objectBelonging>");
		Строки.Добавить("  <extension xsi:type=""mdclassExtension:ConfigurationExtension""/>");
	КонецЕсли;
	Строки.Добавить("  <configurationExtensionCompatibilityMode>8.3.14</configurationExtensionCompatibilityMode>");
	Строки.Добавить("</mdclass:Configuration>");

	ТестовыеФайлы.Файл(Каталог, "src/Configuration/Configuration.mdo", СтрСоединить(Строки, Символы.ПС));

КонецПроцедуры

#КонецОбласти
