	Результат = Сервис.НайтиКонфигурацию(Корень);

	Ожидаем.Что(Результат.Количество(), "должен найти .dt в подкаталоге").Равно(1);
	Ожидаем.Что(Результат[0]).Содержит("backup.dt");

КонецПроцедуры

