КонецПроцедуры

&Тест
Процедура ТестНеДолжен_СчитатьCfИDtРасширениями() Экспорт

	ТестовыеФайлы.Файл(Корень, "1Cv8.cf");
	ТестовыеФайлы.Файл(Корень, "backup.dt");

	Результат = Сервис.НайтиРасширения(Корень);

	Ожидаем.Что(Результат.Количество(), ".cf и .dt не должны быть расширениями").Равно(0);

КонецПроцедуры

&Тест
Процедура ТестНеДолжен_СчитатьXMLКонфигурациюРасширением() Экспорт

	СоздатьКонфигурациюXML(ОбъединитьПути(Корень, "src"), Ложь);

	Расширения = Сервис.НайтиРасширения(Корень);

	Ожидаем.Что(Расширения.Количество(), "конфигурация не считается расширением").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ПроверитьОдинИсточникКонфигурации

&Тест
Процедура ТестНеДолжен_БроситьИсключение_ЕслиНайденОдинИсточник() Экспорт
	Сервис.ПроверитьОдинИсточникКонфигурации(ТестовыеДанные.Массив("some/path/1Cv8.cf"), "some");
КонецПроцедуры

&Тест
Процедура ТестНеДолжен_БроситьИсключение_ЕслиНайденоНольИсточников() Экспорт
	// Ноль источников допустимо: загрузка будет пропущена.
	Сервис.ПроверитьОдинИсточникКонфигурации(Новый Массив, "some");
КонецПроцедуры

&Тест
Процедура ТестДолжен_БроситьИсключение_ЕслиНайденоНесколькоИсточников() Экспорт

	Источники = ТестовыеДанные.Массив("root/conf1/Configuration.xml", "root/conf2/Configuration.xml");

	Ожидаем.Что(Сервис).Метод("ПроверитьОдинИсточникКонфигурации", ТестовыеДанные.Массив(Источники, "root"))
		.ВыбрасываетИсключение("2").ВыбрасываетИсключение("conf1").ВыбрасываетИсключение("conf2");

КонецПроцедуры

#КонецОбласти

