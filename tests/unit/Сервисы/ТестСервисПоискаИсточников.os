#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СоздатьКаталогиПоПути(Знач Путь)
	Файл = Новый Файл(Путь);
	Если Файл.Существует() Тогда
		Возврат;
	КонецЕсли;
	СоздатьКаталогиПоПути(Файл.Путь);
	СоздатьКаталог(Путь);
КонецПроцедуры

Процедура СоздатьФайл(Знач ПолныйПуть, Знач Текст = "")
	СоздатьКаталогиПоПути(Новый Файл(ПолныйПуть).Путь);
	Запись = Новый ЗаписьТекста(ПолныйПуть, КодировкаТекста.UTF8);
	Запись.Записать(Текст);
	Запись.Закрыть();
КонецПроцедуры

Процедура ОжидатьОписание(Знач Описание, Знач Вид, Знач Содержимое)
	Ожидаем.Что(Описание.Вид, "вид источника").Равно(Вид);
	Ожидаем.Что(Описание.Содержимое, "содержимое источника").Равно(Содержимое);
КонецПроцедуры

// Создать минимальный XML-дамп: каталог с Configuration.xml.
// ЭтоРасширение=Истина добавляет маркер ConfigurationExtensionPurpose (XML-дамп расширения).
Процедура СоздатьКонфигурациюXML(Знач Каталог, Знач ЭтоРасширение)
	СоздатьКаталогиПоПути(Каталог);
	Строки = Новый Массив;
	Строки.Добавить("<?xml version=""1.0"" encoding=""UTF-8""?>");
	Строки.Добавить("<MetaDataObject><Configuration><Properties>");
	Строки.Добавить("<Name>Test</Name>");
	Если ЭтоРасширение Тогда
		Строки.Добавить("<ConfigurationExtensionPurpose>Customization</ConfigurationExtensionPurpose>");
	КонецЕсли;
	Строки.Добавить("</Properties></Configuration></MetaDataObject>");
	Запись = Новый ЗаписьТекста(ОбъединитьПути(Каталог, "Configuration.xml"), КодировкаТекста.UTF8);
	Запись.ЗаписатьСтроку(СтрСоединить(Строки, Символы.ПС));
	Запись.Закрыть();
КонецПроцедуры

// Создать минимальный EDT-проект: .project + DT-INF + src/Configuration/Configuration.mdo.
// ЭтоРасширение=Истина создаёт дескриптор расширения со структурным маркером
// mdclassExtension:ConfigurationExtension и objectBelonging.
// СМаркеромНазначения управляет наличием элемента configurationExtensionPurpose —
// в реальных EDT-расширениях он опускается, когда назначение равно значению по умолчанию.
// Дескриптор конфигурации намеренно содержит configurationExtensionCompatibilityMode:
// эта подстрока не должна ошибочно распознаваться как маркер расширения.
Процедура СоздатьEDTПроект(Знач Каталог, Знач ЭтоРасширение, Знач СМаркеромНазначения = Ложь)

	СоздатьФайл(ОбъединитьПути(Каталог, ".project"));
	СоздатьФайл(ОбъединитьПути(Каталог, "DT-INF", "PROJECT.PMF"));

	Строки = Новый Массив;
	Строки.Добавить("<?xml version=""1.0"" encoding=""UTF-8""?>");
	Если ЭтоРасширение Тогда
		Строки.Добавить("<mdclass:Configuration xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance""");
		Строки.Добавить("    xmlns:mdclass=""http://g5.1c.ru/v8/dt/metadata/mdclass""");
		Строки.Добавить("    xmlns:mdclassExtension=""http://g5.1c.ru/v8/dt/metadata/mdclass/extension"" uuid=""2"">");
		Строки.Добавить("  <name>МоёРасширение</name>");
		Строки.Добавить("  <objectBelonging>Adopted</objectBelonging>");
		Строки.Добавить("  <extension xsi:type=""mdclassExtension:ConfigurationExtension"">");
		Строки.Добавить("    <defaultRunMode>Checked</defaultRunMode>");
		Строки.Добавить("  </extension>");
		Если СМаркеромНазначения Тогда
			Строки.Добавить("  <configurationExtensionPurpose>Customization</configurationExtensionPurpose>");
		КонецЕсли;
		Строки.Добавить("  <configurationExtensionCompatibilityMode>8.3.10</configurationExtensionCompatibilityMode>");
	Иначе
		Строки.Добавить("<mdclass:Configuration xmlns:mdclass=""http://g5.1c.ru/v8/dt/metadata/mdclass"" uuid=""1"">");
		Строки.Добавить("  <name>БазоваяКонфигурация</name>");
		Строки.Добавить("  <configurationExtensionCompatibilityMode>8.3.14</configurationExtensionCompatibilityMode>");
	КонецЕсли;
	Строки.Добавить("</mdclass:Configuration>");

	ПутьMdo = ОбъединитьПути(Каталог, "src", "Configuration", "Configuration.mdo");
	СоздатьФайл(ПутьMdo);
	Запись = Новый ЗаписьТекста(ПутьMdo, КодировкаТекста.UTF8);
	Запись.ЗаписатьСтроку(СтрСоединить(Строки, Символы.ПС));
	Запись.Закрыть();

КонецПроцедуры

#КонецОбласти
