	Расширения.Добавить("/ext/МоёРасш"); // каталог с тем же именем

	ПойманоИсключение = Ложь;
	Попытка
		Сервис.ПроверитьУникальностьИменРасширений(Расширения);
	Исключение
		ПойманоИсключение = Истина;
		Ожидаем.Что(ОписаниеОшибки()).Содержит("МоёРасш");
	КонецПопытки;

	Ожидаем.Что(ПойманоИсключение, "должно быть брошено исключение при дублировании имени").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_БроситьПриДвухCfeСОдинаковымИменем() Экспорт

	Расширения = Новый Массив;
	Расширения.Добавить("/ext1/ДублЯ.cfe");
	Расширения.Добавить("/ext2/ДублЯ.cfe");

	ПойманоИсключение = Ложь;
	Попытка
		Сервис.ПроверитьУникальностьИменРасширений(Расширения);
	Исключение
		ПойманоИсключение = Истина;
		Ожидаем.Что(ОписаниеОшибки()).Содержит("ДублЯ");
	КонецПопытки;

	Ожидаем.Что(ПойманоИсключение, "два .cfe с одним именем — ошибка").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_СравниватьИменаБезУчётаРегистра() Экспорт

	Расширения = Новый Массив;
	Расширения.Добавить("/ext/myext.cfe");
	Расширения.Добавить("/ext/MYEXT"); // то же имя в другом регистре

	ПойманоИсключение = Ложь;
	Попытка
		Сервис.ПроверитьУникальностьИменРасширений(Расширения);
	Исключение
		ПойманоИсключение = Истина;
	КонецПопытки;

	Ожидаем.Что(ПойманоИсключение, "имена расширений сравниваются без учёта регистра").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеБроситьПриПустомСписке() Экспорт

	ПустойМассив = Новый Массив;

	// Пустой список — ничего не загружается, не ошибка
	Сервис.ПроверитьУникальностьИменРасширений(ПустойМассив);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СоздатьКаталогиПоПути(Знач Путь)
	Файл = Новый Файл(Путь);
	Если Файл.Существует() Тогда
		Возврат;
	КонецЕсли;
	СоздатьКаталогиПоПути(Файл.Путь);
	СоздатьКаталог(Путь);
КонецПроцедуры

Процедура СоздатьФайл(Знач ПолныйПуть)
	СоздатьКаталогиПоПути(Новый Файл(ПолныйПуть).Путь);
	Запись = Новый ЗаписьТекста(ПолныйПуть, КодировкаТекста.UTF8);
	Запись.Закрыть();
КонецПроцедуры

// Создать минимальный XML-дамп: каталог с Configuration.xml.
// ЭтоРасширение=Истина добавляет маркер ConfigurationExtensionPurpose (XML-дамп расширения).
Процедура СоздатьКонфигурациюXML(Знач Каталог, Знач ЭтоРасширение)
	СоздатьКаталогиПоПути(Каталог);
	Строки = Новый Массив;
	Строки.Добавить("<?xml version=""1.0"" encoding=""UTF-8""?>");
	Строки.Добавить("<MetaDataObject><Configuration><Properties>");
	Строки.Добавить("<Name>Test</Name>");
	Если ЭтоРасширение Тогда
		Строки.Добавить("<ConfigurationExtensionPurpose>Customization</ConfigurationExtensionPurpose>");
	КонецЕсли;
	Строки.Добавить("</Properties></Configuration></MetaDataObject>");
	Запись = Новый ЗаписьТекста(ОбъединитьПути(Каталог, "Configuration.xml"), КодировкаТекста.UTF8);
	Запись.ЗаписатьСтроку(СтрСоединить(Строки, Символы.ПС));
	Запись.Закрыть();
КонецПроцедуры

#КонецОбласти
