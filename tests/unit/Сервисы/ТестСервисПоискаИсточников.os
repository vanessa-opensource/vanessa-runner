&Тест
Процедура ТестДолжен_НайтиXMLКаталог_ПоConfigDumpInfo() Экспорт

	ТестовыеФайлы.Файл(Корень, "conf/ConfigDumpInfo.xml");

	Результат = Сервис.НайтиКонфигурацию(Корень);

	Ожидаем.Что(Результат.Количество(), "должен найти XML-каталог по ConfigDumpInfo.xml").Равно(1);

КонецПроцедуры

&Тест
Процедура ТестНеДолжен_РекурсироватьВнутрьКаталогаИсточника() Экспорт

	// Каталог с Configuration.xml сам источник: вложенный .cf отдельным источником не считается.
	ТестовыеФайлы.Файл(Корень, "src/Configuration.xml");
	ТестовыеФайлы.Файл(Корень, "src/deep.cf");

	Результат = Сервис.НайтиКонфигурацию(Корень);

	Ожидаем.Что(Результат.Количество(), "вложенный cf внутри источника не должен считаться отдельным").Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиНесколькоИсточниковКонфигурации() Экспорт

	ТестовыеФайлы.Файл(Корень, "1Cv8.cf");
	ТестовыеФайлы.Файл(Корень, "src/Configuration.xml");

	Результат = Сервис.НайтиКонфигурацию(Корень);

	Ожидаем.Что(Результат.Количество(), "должны найтись оба источника").Равно(2);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьПустойМассив_ЕслиВКорнеНичегоНет() Экспорт
	Ожидаем.Что(Сервис.НайтиКонфигурацию(Корень).Количество(), "пустой каталог - нет источников").Равно(0);
КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиКонфигурацию_ЕслиПереданПутьКCfФайлу() Экспорт

	ПутьCf = ТестовыеФайлы.Файл(Корень, "1Cv8.cf");

	Результат = Сервис.НайтиКонфигурацию(ПутьCf);

