// BSLLS-off
// Юнит-тесты СервисПоискаИсточников: описание источника по пути, рекурсивный поиск конфигурации и расширений,
// проверки единственности конфигурации и уникальности имён расширений. Файловая система настоящая (временные каталоги).

#Использовать asserts
#Использовать tempfiles
#Использовать "../utils"

Перем Сервис;
Перем Корень;

&ПередКаждым
Процедура ПередКаждым() Экспорт
	Сервис = Новый Стенд().Сервис("СервисПоискаИсточников");
	Корень = ВременныеФайлы.СоздатьКаталог();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт
	ВременныеФайлы.Удалить();
КонецПроцедуры

#Область Описать

&Тест
Процедура ТестДолжен_ОписатьКонфигурацию_ПоФайлуCf() Экспорт

	ПутьCf = ТестовыеФайлы.Файл(Корень, "1Cv8.cf");

	Описание = Сервис.Описать(ПутьCf);

	ОжидатьОписание(Описание, "cf", "Конфигурация");
	Ожидаем.Что(Описание.Имя, "имя файла без расширения").Равно("1Cv8");
	Ожидаем.Что(Описание.КорневойКаталог).Равно(ПутьCf);
	Ожидаем.Что(Описание.Дескриптор).Равно("");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОписатьРасширение_ПоФайлуCfe() Экспорт

	Описание = Сервис.Описать(ТестовыеФайлы.Файл(Корень, "МоёРасширение.CFE"));

	ОжидатьОписание(Описание, "cfe", "Расширение");
	Ожидаем.Что(Описание.Имя, "регистр расширения файла не важен").Равно("МоёРасширение");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОписатьКонфигурацию_ПоФайлуDt() Экспорт
	ОжидатьОписание(Сервис.Описать(ТестовыеФайлы.Файл(Корень, "backup.dt")), "dt", "Конфигурация");
КонецПроцедуры

&Тест
Процедура ТестДолжен_ОписатьXMLКонфигурацию_ПоConfigurationXml() Экспорт

	Каталог = ТестовыеФайлы.КаталогXML("cf");

	Описание = Сервис.Описать(Каталог);

	ОжидатьОписание(Описание, "xml", "Конфигурация");
	Ожидаем.Что(Описание.КорневойКаталог).Равно(Каталог);
	Ожидаем.Что(Описание.Дескриптор).Равно(ОбъединитьПути(Каталог, "Configuration.xml"));
	Ожидаем.Что(Описание.Имя).Равно("cf");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОписатьXMLКонфигурацию_ПоConfigDumpInfo() Экспорт

	Каталог = ОбъединитьПути(Корень, "conf");
	ТестовыеФайлы.Файл(Каталог, "ConfigDumpInfo.xml");

	Описание = Сервис.Описать(Каталог);

	ОжидатьОписание(Описание, "xml", "Конфигурация");
	Ожидаем.Что(Описание.Дескриптор, "Configuration.xml отсутствует").Равно("");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОписатьXMLРасширение_ПоМаркеруНазначения() Экспорт

	Каталог = ОбъединитьПути(Корень, "Ext1");
	СоздатьКонфигурациюXML(Каталог, Истина);

	ОжидатьОписание(Сервис.Описать(Каталог), "xml", "Расширение");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОписатьXMLРасширение_ЕслиДескрипторОткрытДругимЧитателем() Экспорт

	Каталог = ОбъединитьПути(Корень, "Ext1");
	СоздатьКонфигурациюXML(Каталог, Истина);

	Поток = Новый ФайловыйПоток(ОбъединитьПути(Каталог, "Configuration.xml"),
		РежимОткрытияФайла.Открыть, ДоступКФайлу.Чтение);
	Описание = Сервис.Описать(Каталог);
	Поток.Закрыть();

	ОжидатьОписание(Описание, "xml", "Расширение");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОписатьEDTКонфигурацию_ПоConfigurationMdo() Экспорт

	Каталог = ТестовыеФайлы.КаталогEDT("cfg");

	Описание = Сервис.Описать(Каталог);

	ОжидатьОписание(Описание, "edt", "Конфигурация");
	Ожидаем.Что(Описание.Дескриптор).Равно(ТестовыеФайлы.Путь(Каталог, "src/Configuration/Configuration.mdo"));

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОписатьEDTРасширение_БезМаркераНазначения() Экспорт

	// Без элемента configurationExtensionPurpose - по структурному маркеру дескриптора.
	Каталог = ОбъединитьПути(Корень, "МоёРасширение");
	СоздатьEDTПроект(Каталог, Истина);

	ОжидатьОписание(Сервис.Описать(Каталог), "edt", "Расширение");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОписатьВложенныйEDTПроект_ЕслиОнЕдинственный() Экспорт

	Родитель = ОбъединитьПути(Корень, "exts");
	Проект = ОбъединитьПути(Родитель, "МоёРасширение");
	СоздатьEDTПроект(Проект, Истина);

	Описание = Сервис.Описать(Родитель);

	ОжидатьОписание(Описание, "edt", "Расширение");
	Ожидаем.Что(Описание.КорневойКаталог, "корень - вложенный проект").Равно(Проект);
	Ожидаем.Что(Описание.Имя, "имя - указанного каталога").Равно("exts");

КонецПроцедуры

&Тест
Процедура ТестДолжен_БроситьИсключение_ЕслиНесколькоВложенныхEDTПроектов() Экспорт

	СоздатьEDTПроект(ОбъединитьПути(Корень, "Проект1"), Ложь);
	СоздатьEDTПроект(ОбъединитьПути(Корень, "Проект2"), Ложь);

	Ожидаем.Что(Сервис).Метод("Описать", ТестовыеДанные.Массив(Корень)).ВыбрасываетИсключение("несколько EDT-проектов");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОписатьПустойКаталог_КакНеИсточник() Экспорт

	Описание = Сервис.Описать(Корень);

	ОжидатьОписание(Описание, "", "");
	Ожидаем.Что(Описание.КорневойКаталог).Равно(Корень);
	Ожидаем.Что(Описание.Имя).Равно(Новый Файл(Корень).Имя);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОписатьНесуществующийПуть_ПоРасширениюФайла() Экспорт

	// Существование не проверяется: файловый источник - по расширению, прочее - не источник.
	Каталог = ОбъединитьПути(Корень, "нет");

	ОжидатьОписание(Сервис.Описать(Каталог), "", "");
	ОжидатьОписание(Сервис.Описать(ОбъединитьПути(Каталог, "x.cf")), "cf", "Конфигурация");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОписатьXMLВнешнихОбработок_КакНеИсточник() Экспорт

	Каталог = ОбъединитьПути(Корень, "epf");
	ТестовыеФайлы.Файл(Каталог, "Обработка.xml", "<ExternalDataProcessor uuid=""1""/>");

	ОжидатьОписание(Сервис.Описать(Каталог), "", "");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОписатьEDTВнешнихОбработок_БезДескриптора() Экспорт

	// Проект внешних обработок: .project и DT-INF есть, Configuration.mdo нет.
	Каталог = ОбъединитьПути(Корень, "epf-edt");
	ТестовыеФайлы.Файл(Каталог, ".project");
	ТестовыеФайлы.Файл(Каталог, "DT-INF/PROJECT.PMF");

	Описание = Сервис.Описать(Каталог);

	ОжидатьОписание(Описание, "edt", "Конфигурация");
	Ожидаем.Что(Описание.Дескриптор).Равно("");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОписатьКаталогТолькоСProject_КакНеИсточник() Экспорт

	Каталог = ОбъединитьПути(Корень, "eclipse");
	ТестовыеФайлы.Файл(Каталог, ".project");

	ОжидатьОписание(Сервис.Описать(Каталог), "", "");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПредпочестьXML_ВложенномуEDT() Экспорт

	СоздатьКонфигурациюXML(Корень, Ложь);
	СоздатьEDTПроект(ОбъединитьПути(Корень, "Проект"), Ложь);

	Описание = Сервис.Описать(Корень);

	ОжидатьОписание(Описание, "xml", "Конфигурация");
	Ожидаем.Что(Описание.КорневойКаталог).Равно(Корень);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОписатьКаталог_СХвостовымРазделителем() Экспорт

	Каталог = ТестовыеФайлы.КаталогXML("cf");

	Описание = Сервис.Описать(Каталог + ПолучитьРазделительПути());

	ОжидатьОписание(Описание, "xml", "Конфигурация");
	Ожидаем.Что(Описание.Имя).Равно("cf");

КонецПроцедуры

#КонецОбласти

#Область НайтиИсточники

&Тест
Процедура ТестДолжен_РазделитьКонфигурациюИРасширение_ВОдномДереве() Экспорт

	// У обоих Configuration.xml; различаются маркером ConfigurationExtensionPurpose.
	СоздатьКонфигурациюXML(ОбъединитьПути(Корень, "cf"), Ложь);
	СоздатьКонфигурациюXML(ТестовыеФайлы.Путь(Корень, "cfe/YAXUnit"), Истина);

	Найдено = Сервис.НайтиИсточники(Корень);

	Ожидаем.Что(Найдено.Конфигурации.Количество(), "ровно одна конфигурация").Равно(1);
	Ожидаем.Что(Найдено.Конфигурации[0]).Содержит("cf");
	Ожидаем.Что(Найдено.Расширения.Количество(), "ровно одно расширение").Равно(1);
	Ожидаем.Что(Найдено.Расширения[0]).Содержит("YAXUnit");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиEDTРасширение_БезМаркераНазначения() Экспорт

	// Регрессия: без configurationExtensionPurpose расширение считалось конфигурацией.
	СоздатьEDTПроект(ТестовыеФайлы.Путь(Корень, "exts/МоёРасширение"), Истина);

	Найдено = Сервис.НайтиИсточники(Корень);

	Ожидаем.Что(Найдено.Расширения.Количество(), "EDT-расширение без маркера назначения - это расширение").Равно(1);
	Ожидаем.Что(Найдено.Конфигурации.Количество(), "и не должно попадать в конфигурации").Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазделитьEDTКонфигурациюИРасширение_БезМаркераНазначения() Экспорт

	СоздатьEDTПроект(ОбъединитьПути(Корень, "cfg"), Ложь);
	СоздатьEDTПроект(ТестовыеФайлы.Путь(Корень, "exts/мирИсправлениеОшибокВендора"), Истина);

	Найдено = Сервис.НайтиИсточники(Корень);

	Ожидаем.Что(Найдено.Конфигурации.Количество(), "ровно одна конфигурация").Равно(1);
	Ожидаем.Что(Найдено.Конфигурации[0]).Содержит("cfg");
	Ожидаем.Что(Найдено.Расширения.Количество(), "ровно одно расширение").Равно(1);
	Ожидаем.Что(Найдено.Расширения[0]).Содержит("мирИсправлениеОшибокВендора");

КонецПроцедуры

&Тест
Процедура ТестНеДолжен_СчитатьEDTКонфигурациюРасширением_ПоCompatibilityMode() Экспорт

	// Гард: configurationExtensionCompatibilityMode в дескрипторе конфигурации - не маркер расширения.
	СоздатьEDTПроект(ОбъединитьПути(Корень, "cfg"), Ложь);

	Найдено = Сервис.НайтиИсточники(Корень);

	Ожидаем.Что(Найдено.Конфигурации.Количество(), "EDT-конфигурация - это конфигурация").Равно(1);
	Ожидаем.Что(Найдено.Расширения.Количество(), "и не должна попадать в расширения").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область НайтиКонфигурацию

&Тест
Процедура ТестДолжен_НайтиКонфигурацию_ПоCfВКорне() Экспорт

	ТестовыеФайлы.Файл(Корень, "1Cv8.cf");

	Результат = Сервис.НайтиКонфигурацию(Корень);

	Ожидаем.Что(Результат.Количество(), "должен найти один .cf в корне").Равно(1);
	Ожидаем.Что(Результат[0]).Содержит("1Cv8.cf");

КонецПроцедуры

