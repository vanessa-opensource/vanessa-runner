// BSLLS-off
// Юнит-тесты СервисПоискаИсточников.
// Покрытие: описание источника по пути (Описать), рекурсивный поиск конфигурации
// (.cf/.dt/XML-каталоги), рекурсивный поиск расширений (.cfe/XML-каталоги),
// валидация единственного источника конфигурации,
// валидация уникальности имён расширений.
//
// Тесты используют реальную файловую систему через временные каталоги.

#Использовать asserts
#Использовать tempfiles

#Использовать "../../../src/core/Сервисы"
#Использовать "../utils"

Перем Сервис;
Перем Корень;
Перем НакопленныеВременныеФайлы;

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
	Сервис = Новый БилдерСервисаПоискаИсточников().Собрать();
	Корень = ВременныеФайлы.СоздатьКаталог();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#Область Описать

&Тест
Процедура ТестДолжен_ОписатьФайлCf() Экспорт

	ПутьCf = ОбъединитьПути(Корень, "1Cv8.cf");
	СоздатьФайл(ПутьCf);

	Описание = Сервис.Описать(ПутьCf);

	ОжидатьОписание(Описание, "cf", "Конфигурация");
	Ожидаем.Что(Описание.Имя, "имя файла без расширения").Равно("1Cv8");
	Ожидаем.Что(Описание.КорневойКаталог).Равно(ПутьCf);
	Ожидаем.Что(Описание.Дескриптор).Равно("");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОписатьФайлCfe() Экспорт

	ПутьCfe = ОбъединитьПути(Корень, "МоёРасширение.CFE");
	СоздатьФайл(ПутьCfe);

	Описание = Сервис.Описать(ПутьCfe);

	ОжидатьОписание(Описание, "cfe", "Расширение");
	Ожидаем.Что(Описание.Имя, "регистр расширения файла не важен").Равно("МоёРасширение");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОписатьФайлDt() Экспорт

	ПутьDt = ОбъединитьПути(Корень, "backup.dt");
	СоздатьФайл(ПутьDt);

	ОжидатьОписание(Сервис.Описать(ПутьDt), "dt", "Конфигурация");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОписатьXMLКонфигурацию() Экспорт

	Каталог = ОбъединитьПути(Корень, "cf");
	СоздатьКонфигурациюXML(Каталог, Ложь);

	Описание = Сервис.Описать(Каталог);

	ОжидатьОписание(Описание, "xml", "Конфигурация");
	Ожидаем.Что(Описание.КорневойКаталог).Равно(Каталог);
	Ожидаем.Что(Описание.Дескриптор).Равно(ОбъединитьПути(Каталог, "Configuration.xml"));
	Ожидаем.Что(Описание.Имя).Равно("cf");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОписатьXMLПоConfigDumpInfo() Экспорт

	Каталог = ОбъединитьПути(Корень, "conf");
	СоздатьФайл(ОбъединитьПути(Каталог, "ConfigDumpInfo.xml"));

	Описание = Сервис.Описать(Каталог);

	ОжидатьОписание(Описание, "xml", "Конфигурация");
	Ожидаем.Что(Описание.Дескриптор, "Configuration.xml отсутствует").Равно("");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОписатьXMLРасширение() Экспорт

	Каталог = ОбъединитьПути(Корень, "Ext1");
	СоздатьКонфигурациюXML(Каталог, Истина);

	ОжидатьОписание(Сервис.Описать(Каталог), "xml", "Расширение");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОписатьEDTКонфигурацию() Экспорт

	Каталог = ОбъединитьПути(Корень, "cfg");
	СоздатьEDTПроект(Каталог, Ложь);

	Описание = Сервис.Описать(Каталог);

	ОжидатьОписание(Описание, "edt", "Конфигурация");
	Ожидаем.Что(Описание.Дескриптор).Равно(ОбъединитьПути(Каталог, "src", "Configuration", "Configuration.mdo"));

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОписатьEDTРасширение() Экспорт

	// Без элемента configurationExtensionPurpose - по структурному маркеру дескриптора.
	Каталог = ОбъединитьПути(Корень, "МоёРасширение");
	СоздатьEDTПроект(Каталог, Истина, Ложь);

	ОжидатьОписание(Сервис.Описать(Каталог), "edt", "Расширение");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОписатьЕдинственныйВложенныйEDTПроект() Экспорт

	Родитель = ОбъединитьПути(Корень, "exts");
	Проект = ОбъединитьПути(Родитель, "МоёРасширение");
	СоздатьEDTПроект(Проект, Истина);

	Описание = Сервис.Описать(Родитель);

	ОжидатьОписание(Описание, "edt", "Расширение");
	Ожидаем.Что(Описание.КорневойКаталог, "корень - вложенный проект").Равно(Проект);
	Ожидаем.Что(Описание.Имя, "имя - указанного каталога").Равно("exts");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыброситьОшибку_ЕслиНесколькоВложенныхEDTПроектов() Экспорт

	СоздатьEDTПроект(ОбъединитьПути(Корень, "Проект1"), Ложь);
	СоздатьEDTПроект(ОбъединитьПути(Корень, "Проект2"), Ложь);

	Попытка
		Сервис.Описать(Корень);
		ВызватьИсключение "Должно было выброситься исключение";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("несколько EDT-проектов");
	КонецПопытки;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОписатьПустойКаталог_КакНеИсточник() Экспорт

	Описание = Сервис.Описать(Корень);

	ОжидатьОписание(Описание, "", "");
	Ожидаем.Что(Описание.КорневойКаталог).Равно(Корень);
	Ожидаем.Что(Описание.Имя).Равно(Новый Файл(Корень).Имя);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОписатьНесуществующийПуть() Экспорт

	// Существование не проверяется: файловый источник - по расширению, прочее - не источник.
	Каталог = ОбъединитьПути(Корень, "нет");

	ОжидатьОписание(Сервис.Описать(Каталог), "", "");
	ОжидатьОписание(Сервис.Описать(ОбъединитьПути(Каталог, "x.cf")), "cf", "Конфигурация");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОписатьXMLВнешнихОбработок_КакНеИсточник() Экспорт

	Каталог = ОбъединитьПути(Корень, "epf");
	СоздатьФайл(ОбъединитьПути(Каталог, "Обработка.xml"), "<ExternalDataProcessor uuid=""1""/>");

	ОжидатьОписание(Сервис.Описать(Каталог), "", "");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОписатьEDTВнешнихОбработок() Экспорт

	// Проект внешних обработок: .project и DT-INF есть, Configuration.mdo нет.
	Каталог = ОбъединитьПути(Корень, "epf-edt");
	СоздатьФайл(ОбъединитьПути(Каталог, ".project"));
	СоздатьФайл(ОбъединитьПути(Каталог, "DT-INF", "PROJECT.PMF"));

	Описание = Сервис.Описать(Каталог);

	ОжидатьОписание(Описание, "edt", "Конфигурация");
	Ожидаем.Что(Описание.Дескриптор).Равно("");

КонецПроцедуры

&Тест
Процедура ТестНеДолжен_СчитатьEDT_КаталогТолькоСProject() Экспорт

	Каталог = ОбъединитьПути(Корень, "eclipse");
	СоздатьФайл(ОбъединитьПути(Каталог, ".project"));

	ОжидатьОписание(Сервис.Описать(Каталог), "", "");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПредпочестьXML_ВложенномуEDT() Экспорт

	СоздатьКонфигурациюXML(Корень, Ложь);
	СоздатьEDTПроект(ОбъединитьПути(Корень, "Проект"), Ложь);

	Описание = Сервис.Описать(Корень);

	ОжидатьОписание(Описание, "xml", "Конфигурация");
	Ожидаем.Что(Описание.КорневойКаталог).Равно(Корень);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОписатьКаталогСХвостовымРазделителем() Экспорт

	Каталог = ОбъединитьПути(Корень, "cf");
	СоздатьКонфигурациюXML(Каталог, Ложь);

	Описание = Сервис.Описать(Каталог + ПолучитьРазделительПути());

	ОжидатьОписание(Описание, "xml", "Конфигурация");
	Ожидаем.Что(Описание.Имя).Равно("cf");

КонецПроцедуры

#КонецОбласти

#Область НайтиКонфигурацию

&Тест
Процедура ТестДолжен_НайтиCfФайлВКорне() Экспорт

	СоздатьФайл(ОбъединитьПути(Корень, "1Cv8.cf"));

	Результат = Сервис.НайтиКонфигурацию(Корень);

	Ожидаем.Что(Результат.Количество(), "должен найти один .cf в корне").Равно(1);
	Ожидаем.Что(Результат[0]).Содержит("1Cv8.cf");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиCfФайлВПодкаталоге() Экспорт

	Подкаталог = ОбъединитьПути(Корень, "releases", "v1");
	СоздатьКаталогиПоПути(Подкаталог);
	СоздатьФайл(ОбъединитьПути(Подкаталог, "1Cv8.cf"));

	Результат = Сервис.НайтиКонфигурацию(Корень);

	Ожидаем.Что(Результат.Количество(), "должен найти .cf в глубоком подкаталоге").Равно(1);
	Ожидаем.Что(Результат[0]).Содержит("1Cv8.cf");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиDtФайлВПодкаталоге() Экспорт

	Подкаталог = ОбъединитьПути(Корень, "dumps");
	СоздатьКаталогиПоПути(Подкаталог);
	СоздатьФайл(ОбъединитьПути(Подкаталог, "backup.dt"));

	Результат = Сервис.НайтиКонфигурацию(Корень);

	Ожидаем.Что(Результат.Количество(), "должен найти .dt в подкаталоге").Равно(1);
	Ожидаем.Что(Результат[0]).Содержит("backup.dt");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиXMLКаталогИсходниковПоConfigurationXml() Экспорт

	КаталогИсходников = ОбъединитьПути(Корень, "project", "src");
	СоздатьКаталогиПоПути(КаталогИсходников);
	СоздатьФайл(ОбъединитьПути(КаталогИсходников, "Configuration.xml"));

	Результат = Сервис.НайтиКонфигурацию(Корень);

	Ожидаем.Что(Результат.Количество(), "должен найти XML-каталог по Configuration.xml").Равно(1);
	Ожидаем.Что(Результат[0]).Содержит("src");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиXMLКаталогИсточниковПоConfigDumpInfo() Экспорт

	КаталогИсходников = ОбъединитьПути(Корень, "conf");
	СоздатьКаталогиПоПути(КаталогИсходников);
	СоздатьФайл(ОбъединитьПути(КаталогИсходников, "ConfigDumpInfo.xml"));

	Результат = Сервис.НайтиКонфигурацию(Корень);

	Ожидаем.Что(Результат.Количество(), "должен найти XML-каталог по ConfigDumpInfo.xml").Равно(1);

КонецПроцедуры

&Тест
Процедура ТестНеДолжен_РекурсироватьВнутрьКаталогаИсточников() Экспорт

	// Каталог с Configuration.xml — сам является источником, его содержимое не должно добавляться
	КаталогИсходников = ОбъединитьПути(Корень, "src");
	СоздатьКаталогиПоПути(КаталогИсходников);
	СоздатьФайл(ОбъединитьПути(КаталогИсходников, "Configuration.xml"));
	// Вложенный .cf (в реальной конфигурации такого нет, но проверяем что не подхватится)
	СоздатьФайл(ОбъединитьПути(КаталогИсходников, "deep.cf"));

	Результат = Сервис.НайтиКонфигурацию(Корень);

	Ожидаем.Что(Результат.Количество(), "вложенный cf внутри источника не должен считаться отдельным").Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиНесколькоИсточниковКонфигурации() Экспорт

	СоздатьФайл(ОбъединитьПути(Корень, "1Cv8.cf"));
	КаталогСрц = ОбъединитьПути(Корень, "src");
	СоздатьКаталогиПоПути(КаталогСрц);
	СоздатьФайл(ОбъединитьПути(КаталогСрц, "Configuration.xml"));

	Результат = Сервис.НайтиКонфигурацию(Корень);

	Ожидаем.Что(Результат.Количество(), "должны найтись оба источника").Равно(2);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьПустойМассивЕслиНичегоНетВКорне() Экспорт

	Результат = Сервис.НайтиКонфигурацию(Корень);

	Ожидаем.Что(Результат.Количество(), "пустой каталог — нет источников").Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиKонфигурациюЕслиПерданПутьКCfФайлу() Экспорт

	ПутьКCf = ОбъединитьПути(Корень, "1Cv8.cf");
	СоздатьФайл(ПутьКCf);

	Результат = Сервис.НайтиКонфигурацию(ПутьКCf);

	Ожидаем.Что(Результат.Количество(), "путь прямо к .cf-файлу — один источник").Равно(1);

КонецПроцедуры

#КонецОбласти

#Область НайтиРасширения

&Тест
Процедура ТестДолжен_НайтиCfeФайлВПодкаталоге() Экспорт

	Подкаталог = ОбъединитьПути(Корень, "ext");
	СоздатьКаталогиПоПути(Подкаталог);
	СоздатьФайл(ОбъединитьПути(Подкаталог, "МоёРасширение.cfe"));

	Результат = Сервис.НайтиРасширения(Корень);

	Ожидаем.Что(Результат.Количество(), "должен найти .cfe в подкаталоге").Равно(1);
	Ожидаем.Что(Результат[0]).Содержит(".cfe");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиXMLКаталогРасширенияВПодкаталоге() Экспорт

	КаталогРасш = ОбъединитьПути(Корень, "extensions", "Ext1");
	СоздатьКонфигурациюXML(КаталогРасш, Истина);

	Результат = Сервис.НайтиРасширения(Корень);

	Ожидаем.Что(Результат.Количество(), "должен найти XML-каталог расширения").Равно(1);
	Ожидаем.Что(Результат[0]).Содержит("Ext1");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиНесколькоРасширений() Экспорт

	КаталогExt = ОбъединитьПути(Корень, "extensions");
	СоздатьКаталогиПоПути(КаталогExt);
	// Первое расширение — .cfe-файл
	СоздатьФайл(ОбъединитьПути(КаталогExt, "Ext1.cfe"));
	// Второе расширение — XML-каталог расширения (с маркером)
	КаталогExt2 = ОбъединитьПути(КаталогExt, "Ext2");
	СоздатьКонфигурациюXML(КаталогExt2, Истина);

	Результат = Сервис.НайтиРасширения(Корень);

	Ожидаем.Что(Результат.Количество(), "должны найтись оба расширения").Равно(2);

КонецПроцедуры

&Тест
Процедура ТестНеДолжен_НайтиCfКакРасширение() Экспорт

	СоздатьФайл(ОбъединитьПути(Корень, "1Cv8.cf"));
	СоздатьФайл(ОбъединитьПути(Корень, "backup.dt"));

	Результат = Сервис.НайтиРасширения(Корень);

	Ожидаем.Что(Результат.Количество(), ".cf и .dt не должны быть расширениями").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область НайтиИсточники

&Тест
Процедура ТестДолжен_РазделитьКонфигурациюИРасширениеВОдномДереве() Экспорт

	// Сценарий пользователя: src/cf - конфигурация, src/cfe/YAXUnit - расширение
	// (у обоих есть Configuration.xml; различаются по маркеру ConfigurationExtensionPurpose)
	СоздатьКонфигурациюXML(ОбъединитьПути(Корень, "cf"), Ложь);
	СоздатьКонфигурациюXML(ОбъединитьПути(Корень, "cfe", "YAXUnit"), Истина);

	Найдено = Сервис.НайтиИсточники(Корень);

	Ожидаем.Что(Найдено.Конфигурации.Количество(), "ровно одна конфигурация").Равно(1);
	Ожидаем.Что(Найдено.Конфигурации[0]).Содержит("cf");
	Ожидаем.Что(Найдено.Расширения.Количество(), "ровно одно расширение").Равно(1);
	Ожидаем.Что(Найдено.Расширения[0]).Содержит("YAXUnit");

КонецПроцедуры

&Тест
Процедура ТестНеДолжен_СчитатьРасширениеКонфигурацией() Экспорт

	// XML-дамп расширения не должен попадать в список конфигураций
	СоздатьКонфигурациюXML(ОбъединитьПути(Корень, "ext", "Ext1"), Истина);

	Конфигурации = Сервис.НайтиКонфигурацию(Корень);

	Ожидаем.Что(Конфигурации.Количество(), "расширение не считается конфигурацией").Равно(0);

КонецПроцедуры

&Тест
Процедура ТестНеДолжен_СчитатьКонфигурациюРасширением() Экспорт

	// Обычный XML-дамп конфигурации не должен попадать в список расширений
	СоздатьКонфигурациюXML(ОбъединитьПути(Корень, "src"), Ложь);

	Расширения = Сервис.НайтиРасширения(Корень);

	Ожидаем.Что(Расширения.Количество(), "конфигурация не считается расширением").Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиEDTРасширениеБезМаркераНазначения() Экспорт

	// Регрессия: EDT-расширение без элемента configurationExtensionPurpose
	// (в EDT он опускается, когда назначение = значению по умолчанию).
	// Должно распознаваться по структурному маркеру mdclassExtension:ConfigurationExtension.
	СоздатьEDTПроект(ОбъединитьПути(Корень, "exts", "МоёРасширение"), Истина, Ложь);

	Найдено = Сервис.НайтиИсточники(Корень);

	Ожидаем.Что(Найдено.Расширения.Количество(), "EDT-расширение без маркера назначения — это расширение").Равно(1);
	Ожидаем.Что(Найдено.Конфигурации.Количество(), "и не должно попадать в конфигурации").Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазделитьEDTКонфигурациюИРасширениеБезМаркераНазначения() Экспорт

	// Сценарий пользователя: cfg — EDT-конфигурация, exts/<имя> — EDT-расширение без
	// элемента configurationExtensionPurpose. Раньше оба ошибочно считались конфигурациями.
	СоздатьEDTПроект(ОбъединитьПути(Корень, "cfg"), Ложь, Ложь);
	СоздатьEDTПроект(ОбъединитьПути(Корень, "exts", "мирИсправлениеОшибокВендора"), Истина, Ложь);

	Найдено = Сервис.НайтиИсточники(Корень);

	Ожидаем.Что(Найдено.Конфигурации.Количество(), "ровно одна конфигурация").Равно(1);
	Ожидаем.Что(Найдено.Конфигурации[0]).Содержит("cfg");
	Ожидаем.Что(Найдено.Расширения.Количество(), "ровно одно расширение").Равно(1);
	Ожидаем.Что(Найдено.Расширения[0]).Содержит("мирИсправлениеОшибокВендора");

КонецПроцедуры

&Тест
Процедура ТестНеДолжен_СчитатьEDTКонфигурациюРасширением() Экспорт

	// Гард от ложного срабатывания новых маркеров: EDT-конфигурация с элементом
	// configurationExtensionCompatibilityMode не должна считаться расширением.
	СоздатьEDTПроект(ОбъединитьПути(Корень, "cfg"), Ложь, Ложь);

	Найдено = Сервис.НайтиИсточники(Корень);

	Ожидаем.Что(Найдено.Конфигурации.Количество(), "EDT-конфигурация — это конфигурация").Равно(1);
	Ожидаем.Что(Найдено.Расширения.Количество(), "и не должна попадать в расширения").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ПроверитьОдинИсточникКонфигурации

&Тест
Процедура ТестДолжен_НеБроситьЕслиНайденноОдинИсточник() Экспорт

	ОдинИсточник = Новый Массив;
	ОдинИсточник.Добавить("/some/path/1Cv8.cf");

	// Не должно быть исключения
	Сервис.ПроверитьОдинИсточникКонфигурации(ОдинИсточник, "/some/root");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеБроситьЕслиНайденоНольИсточников() Экспорт

	ПустойМассив = Новый Массив;

	// Ноль источников допустимо (загрузка будет пропущена)
	Сервис.ПроверитьОдинИсточникКонфигурации(ПустойМассив, "/some/root");

КонецПроцедуры

&Тест
Процедура ТестДолжен_БроситьИсключениеЕслиНайденоНесколькоИсточников() Экспорт

	НесколькоИсточников = Новый Массив;
	НесколькоИсточников.Добавить("/root/conf1/Configuration.xml");
	НесколькоИсточников.Добавить("/root/conf2/Configuration.xml");

	ПойманоИсключение = Ложь;
	Попытка
		Сервис.ПроверитьОдинИсточникКонфигурации(НесколькоИсточников, "/root");
	Исключение
		ПойманоИсключение = Истина;
		Ожидаем.Что(ОписаниеОшибки()).Содержит("2");
		Ожидаем.Что(ОписаниеОшибки()).Содержит("conf1");
		Ожидаем.Что(ОписаниеОшибки()).Содержит("conf2");
	КонецПопытки;

	Ожидаем.Что(ПойманоИсключение, "должно быть брошено исключение при >1 источниках").ЭтоИстина();

КонецПроцедуры

