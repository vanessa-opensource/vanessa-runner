// BSLLS-off
// Юнит-тесты СервисСинтаксическойПроверки: режимы и цели проверки, прогон по целям,
// фильтрация замечаний по исключениям и раскладка по кейсам отчёта.
// СервисПлатформы - мок: ПроверитьКонфигурацию отдаёт выводом ключи проверки.

#Использовать asserts
#Использовать moskito
#Использовать tempfiles
#Использовать "../utils"

Перем Стенд;
Перем Сервис;
Перем Любое;

&ПередКаждым
Процедура ПередКаждым() Экспорт
	Стенд = Новый Стенд;
	Сервис = Стенд.Сервис("СервисСинтаксическойПроверки");
	Любое = Матчеры.ЛюбоеЗначение();
	Стенд.Мок("СервисПлатформы").Когда().ПроверитьКонфигурацию(Любое, Любое, Любое, Любое)
		.ТогдаОтвечает(Новый Ответ(ЭтотОбъект, "ВыводПоКлючам"));
КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт
	ВременныеФайлы.Удалить();
КонецПроцедуры

#Область РежимыПроверки

&Тест
Процедура ТестДолжен_ВернутьРежимыПоУмолчанию_БезОпции() Экспорт

	Режимы = Сервис.РежимыПроверки(Неопределено);

	Ожидаем.Что(Режимы).ИмеетДлину(5);
	Ожидаем.Что(Режимы[0]).Равно("-ThinClient");
	Ожидаем.Что(Режимы[2]).Равно("-Server");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ДобавитьДефисКРежимам() Экспорт

	Режимы = Сервис.РежимыПроверки(ТестовыеДанные.Массив("Server", "-WebClient"));

	Ожидаем.Что(Режимы).ИмеетДлину(2);
	Ожидаем.Что(Режимы[0]).Равно("-Server");
	Ожидаем.Что(Режимы[1]).Равно("-WebClient");

КонецПроцедуры

&Тест
Процедура ТестДолжен_УбратьAllExtensionsИзРежимов() Экспорт

	Ожидаем.Что(Сервис.РежимыПроверки(ТестовыеДанные.Массив("AllExtensions", "Server")), "остался только Server").ИмеетДлину(1);
	Ожидаем.Что(Сервис.РежимыПроверки(ТестовыеДанные.Массив("-AllExtensions")), "один AllExtensions - режимы по умолчанию")
		.ИмеетДлину(5);

КонецПроцедуры

#КонецОбласти

#Область ЦелиПроверки

&Тест
Процедура ТестДолжен_ПроверятьВсё_БезЦелей() Экспорт

	Цели = Сервис.ЦелиПроверки(Неопределено, Неопределено);

	Ожидаем.Что(Цели).ИмеетДлину(2);
	Ожидаем.Что(Цели[0]).Равно("main");
	Ожидаем.Что(Цели[1]).Равно("AllExtensions");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВзятьЦелиИзОпции_БезПустыхИПробелов() Экспорт

	Цели = Сервис.ЦелиПроверки(ТестовыеДанные.Массив(" Ext1 ", "", "main"), Неопределено);

	Ожидаем.Что(Цели).ИмеетДлину(2);
	Ожидаем.Что(Цели[0]).Равно("Ext1");
	Ожидаем.Что(Цели[1]).Равно("main");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СузитьЦелиДоРасширений_ПоУстаревшемуРежиму() Экспорт

	Цели = Сервис.ЦелиПроверки(Неопределено, ТестовыеДанные.Массив("Server", "AllExtensions"));

	Ожидаем.Что(Цели).ИмеетДлину(1);
	Ожидаем.Что(Цели[0]).Равно("AllExtensions");

КонецПроцедуры

#КонецОбласти

#Область Проверить

&Тест
Процедура ТестДолжен_ПрогнатьКонфигурациюИВсеРасширения_ОтдельнымиЗапусками() Экспорт

	Вывод = Сервис.Проверить(ТестовыеДанные.Массив("-Server"), ТестовыеДанные.Массив("main", "AllExtensions"),
		Неопределено, Неопределено, Неопределено);

	Вызовы = Стенд.Вызовы("СервисПлатформы", "ПроверитьКонфигурацию");
	Ожидаем.Что(Вызовы, "запусков конфигуратора").ИмеетДлину(2);
	Ожидаем.Что(Ключи(Вызовы[0]), "ключи основной конфигурации").Равно("-Server");
	Ожидаем.Что(Ключи(Вызовы[1]), "ключи всех расширений").Равно("-Server -AllExtensions");
	Ожидаем.Что(Вывод, "выводы целей склеены по порядку").Равно("-Server" + Символы.ПС + "-Server -AllExtensions");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПрогнатьРасширенияПоимённо() Экспорт

	Сервис.Проверить(ТестовыеДанные.Массив("-Server"), ТестовыеДанные.Массив("main", "Ext1", "Ext2"),
		Неопределено, Неопределено, Неопределено);

	Вызовы = Стенд.Вызовы("СервисПлатформы", "ПроверитьКонфигурацию");
	Ожидаем.Что(Вызовы).ИмеетДлину(3);
	Ожидаем.Что(Ключи(Вызовы[1])).Равно("-Server -Extension ""Ext1""");
	Ожидаем.Что(Ключи(Вызовы[2])).Равно("-Server -Extension ""Ext2""");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеГонятьИменованныеРасширения_ПослеВсехРасширений() Экспорт

	Сервис.Проверить(ТестовыеДанные.Массив("-Server"), ТестовыеДанные.Массив("AllExtensions", "Ext1"),
		Неопределено, Неопределено, Неопределено);

	Вызовы = Стенд.Вызовы("СервисПлатформы", "ПроверитьКонфигурацию");
	Ожидаем.Что(Вызовы).ИмеетДлину(1);
	Ожидаем.Что(Ключи(Вызовы[0])).Равно("-Server -AllExtensions");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПередатьПараметрыПодключенияВПлатформу() Экспорт

	Подключение = ТестовыеДанные.Подключение("/Fbase");
	ПараметрыПлатформы = Новый Структура("ВерсияПлатформы", "8.3.25");

	Сервис.Проверить(ТестовыеДанные.Массив("-Server"), ТестовыеДанные.Массив("main"), Подключение, Неопределено, ПараметрыПлатформы);

	Вызовы = Стенд.Вызовы("СервисПлатформы", "ПроверитьКонфигурацию");
	Ожидаем.Что(Вызовы).ИмеетДлину(1);
	Ожидаем.Что(Вызовы[0].ПараметрыПодключения).Равно(Подключение);
	Ожидаем.Что(Вызовы[0].ПараметрыПлатформы).Равно(ПараметрыПлатформы);

КонецПроцедуры

#КонецОбласти

#Область ОтфильтроватьЗамечания

&Тест
Процедура ТестДолжен_Отбросить_ТиповыеИсключения() Экспорт

	Вывод = "Не обнаружено ссылок на процедуру: ""Подключаемый_Обработчик""" + Символы.ПС
		+ "Ошибок не обнаружено" + Символы.ПС
		+ "No errors found";

	Ожидаем.Что(Сервис.ОтфильтроватьЗамечания(Вывод)).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОставитьРеальныеЗамечания() Экспорт

	Вывод = "{Справочник.Справочник1.МодульОбъекта(4,1)}: Ошибка один" + Символы.ПС
		+ "Ошибок не обнаружено" + Символы.ПС
		+ "{Справочник.Справочник1.МодульОбъекта(9,1)}: Ошибка два";

	Замечания = Сервис.ОтфильтроватьЗамечания(Вывод);

	Ожидаем.Что(Замечания).ИмеетДлину(2);
	Ожидаем.Что(Замечания[1]).Содержит("Ошибка два");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтброситьЗамечания_ИзФайлаИсключений_БезУчётаРегистра() Экспорт

	// Файл исключений с пустой строкой - она пропускается.
	ФайлИсключений = ТестовыеФайлы.ЗаписатьФайл(ВременныеФайлы.НовоеИмяФайла("txt"), "ИЗВЕСТНАЯ ПРОБЛЕМА" + Символы.ПС + Символы.ПС);
	Вывод = "{Обработка.А.МодульОбъекта(1,1)}: известная проблема тут" + Символы.ПС
		+ "{Обработка.Б.МодульОбъекта(2,2)}: настоящая ошибка";

	Замечания = Сервис.ОтфильтроватьЗамечания(Вывод, ФайлИсключений);

	Ожидаем.Что(Замечания).ИмеетДлину(1);
	Ожидаем.Что(Замечания[0]).Содержит("настоящая ошибка");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПрочитатьФайлИсключений_ОткрытыйДругимЧитателем() Экспорт

	ФайлИсключений = ТестовыеФайлы.ЗаписатьФайл(ВременныеФайлы.НовоеИмяФайла("txt"), "известная проблема");

	Поток = Новый ФайловыйПоток(ФайлИсключений, РежимОткрытияФайла.Открыть, ДоступКФайлу.Чтение);
	Замечания = Сервис.ОтфильтроватьЗамечания("{Обработка.А.МодульОбъекта(1,1)}: известная проблема", ФайлИсключений);
	Поток.Закрыть();

	Ожидаем.Что(Замечания).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеУпасть_ЕслиФайлаИсключенийНет() Экспорт

	Замечания = Сервис.ОтфильтроватьЗамечания("{Обработка.А.МодульОбъекта(1,1)}: ошибка",
		ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "нет-такого.txt"));

	Ожидаем.Что(Замечания).ИмеетДлину(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СклеитьЗамечаниеСФрагментомКода() Экспорт

	Вывод = "{Справочник.Справочник1.МодульОбъекта(4,1)}: Определения процедур должны идти после текста модуля" + Символы.ПС
		+ "<<?>>Процедура ПлохаяПроцедура() Экспорт (Проверка: Сервер)";

	Замечания = Сервис.ОтфильтроватьЗамечания(Вывод);

	Ожидаем.Что(Замечания, "одно замечание из двух строк").ИмеетДлину(1);
	Ожидаем.Что(Замечания[0]).Содержит("ПлохаяПроцедура");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьПустойСписок_ДляПустогоВывода() Экспорт
	Ожидаем.Что(Сервис.ОтфильтроватьЗамечания("")).ИмеетДлину(0);
КонецПроцедуры

#КонецОбласти

#Область СлучаиОтчета

&Тест
Процедура ТестДолжен_РазложитьПоКейсу_НаКаждоеЗамечание() Экспорт

	Замечания = ТестовыеДанные.Массив(
		"{Справочник.Справочник1.МодульОбъекта(4,1)}: Ошибка один",
		"{Справочник.Справочник1.МодульОбъекта(9,1)}: Ошибка два");

	Случаи = Сервис.СлучаиОтчета(Замечания);

	Ожидаем.Что(Случаи).ИмеетДлину(2);
	Ожидаем.Что(Случаи[0].Имя).Равно(Замечания[0]);
	Ожидаем.Что(Случаи[0].Сообщение).Равно(Замечания[0]);
	Ожидаем.Что(Случаи[0].Пакет, "объект метаданных").Равно("Справочник.Справочник1.МодульОбъекта");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СгруппироватьКейсыПоОбъектуМетаданных() Экспорт

	Замечания = ТестовыеДанные.Массив(
		"{Справочник.Справочник1.МодульОбъекта(4,1)}: Ошибка один",
		"{Справочник.Справочник1.МодульОбъекта(9,1)}: Ошибка два");

	Случаи = Сервис.СлучаиОтчета(Замечания, Истина);

	Ожидаем.Что(Случаи, "один кейс на объект").ИмеетДлину(1);
	Ожидаем.Что(Случаи[0].Имя).Равно("Справочник.Справочник1.МодульОбъекта");
	Ожидаем.Что(Случаи[0].Сообщение).Содержит("Ошибка один");
	Ожидаем.Что(Случаи[0].Сообщение).Содержит("Ошибка два");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Ответ мока СервисПлатформы: выводом конфигуратора служат ключи проверки этого вызова.
Функция ВыводПоКлючам(Знач Вызов) Экспорт
	Возврат Новый Структура("Успешно, ВыводКоманды", Истина, СтрСоединить(Вызов.Параметры()[1], " "));
КонецФункции

// Ключи /CheckConfig зафиксированного вызова одной строкой.
Функция Ключи(Знач Вызов)
	Возврат СтрСоединить(Вызов.РежимыПроверки, " ");
КонецФункции

#КонецОбласти
