// BSLLS-off
// Юнит-тесты СервисСинтаксическойПроверки: режимы и цели проверки, прогон по целям
// (СервисПлатформы подменён стабом), фильтрация замечаний по исключениям и раскладка по кейсам.

#Использовать asserts
#Использовать tempfiles
#Использовать reflector
#Использовать logos

#Использовать "../../../src/core/Сервисы"
#Использовать "../utils"

Перем Сервис;
Перем Платформа;

#Область СлужебныйПрограммныйИнтерфейс

// ---------- режимы ----------

&Тест
Процедура ТестДолжен_ВернутьРежимыПоУмолчанию_БезОпции() Экспорт

	Режимы = Сервис.РежимыПроверки(Неопределено);

	Ожидаем.Что(Режимы.Количество()).Равно(5);
	Ожидаем.Что(Режимы[0]).Равно("-ThinClient");
	Ожидаем.Что(Режимы[2]).Равно("-Server");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ДобавитьДефисКРежимам() Экспорт

	Режимы = Сервис.РежимыПроверки(Массив("Server", "-WebClient"));

	Ожидаем.Что(Режимы.Количество()).Равно(2);
	Ожидаем.Что(Режимы[0]).Равно("-Server");
	Ожидаем.Что(Режимы[1]).Равно("-WebClient");

КонецПроцедуры

&Тест
Процедура ТестДолжен_УбратьAllExtensionsИзРежимов() Экспорт

	Ожидаем.Что(Сервис.РежимыПроверки(Массив("AllExtensions", "Server")).Количество(), "остался только Server").Равно(1);
	Ожидаем.Что(Сервис.РежимыПроверки(Массив("-AllExtensions")).Количество(), "один AllExtensions - режимы по умолчанию").Равно(5);

КонецПроцедуры

// ---------- цели ----------

&Тест
Процедура ТестДолжен_ПроверятьВсё_БезЦелей() Экспорт

	Цели = Сервис.ЦелиПроверки(Неопределено, Неопределено);

	Ожидаем.Что(Цели.Количество()).Равно(2);
	Ожидаем.Что(Цели[0]).Равно("main");
	Ожидаем.Что(Цели[1]).Равно("AllExtensions");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВзятьЦелиИзОпции_БезПустыхИПробелов() Экспорт

	Цели = Сервис.ЦелиПроверки(Массив(" Ext1 ", "", "main"), Неопределено);

	Ожидаем.Что(Цели.Количество()).Равно(2);
	Ожидаем.Что(Цели[0]).Равно("Ext1");
	Ожидаем.Что(Цели[1]).Равно("main");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СузитьЦелиДоРасширений_ПоУстаревшемуРежиму() Экспорт

	Цели = Сервис.ЦелиПроверки(Неопределено, Массив("Server", "AllExtensions"));

	Ожидаем.Что(Цели.Количество()).Равно(1);
	Ожидаем.Что(Цели[0]).Равно("AllExtensions");

КонецПроцедуры

// ---------- прогон по целям ----------

&Тест
Процедура ТестДолжен_ПрогнатьКонфигурациюИВсеРасширения_ОтдельнымиЗапусками() Экспорт

	Платформа.СВыводом("вывод main").СВыводом("вывод ext");

	Вывод = Сервис.Проверить(Массив("-Server"), Массив("main", "AllExtensions"), Неопределено, Неопределено, Неопределено);

	Ожидаем.Что(Платформа.Вызовы.Количество(), "запусков конфигуратора").Равно(2);
	Ожидаем.Что(СтрСоединить(Платформа.Вызовы[0].Ключи, " "), "ключи основной конфигурации").Равно("-Server");
	Ожидаем.Что(СтрСоединить(Платформа.Вызовы[1].Ключи, " "), "ключи всех расширений").Равно("-Server -AllExtensions");
	Ожидаем.Что(Вывод).Равно("вывод main" + Символы.ПС + "вывод ext");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПрогнатьРасширенияПоимённо() Экспорт

	Сервис.Проверить(Массив("-Server"), Массив("main", "Ext1", "Ext2"), Неопределено, Неопределено, Неопределено);

	Ожидаем.Что(Платформа.Вызовы.Количество()).Равно(3);
	Ожидаем.Что(СтрСоединить(Платформа.Вызовы[1].Ключи, " ")).Равно("-Server -Extension ""Ext1""");
	Ожидаем.Что(СтрСоединить(Платформа.Вызовы[2].Ключи, " ")).Равно("-Server -Extension ""Ext2""");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеГонятьИменованныеРасширения_ПослеВсехРасширений() Экспорт

	Сервис.Проверить(Массив("-Server"), Массив("AllExtensions", "Ext1"), Неопределено, Неопределено, Неопределено);

	Ожидаем.Что(Платформа.Вызовы.Количество()).Равно(1);
	Ожидаем.Что(СтрСоединить(Платформа.Вызовы[0].Ключи, " ")).Равно("-Server -AllExtensions");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПередатьПараметрыПодключенияВПлатформу() Экспорт

	Подключение = Новый Структура("СтрокаПодключения", "/Fbase");
	Платформа1 = Новый Структура("ВерсияПлатформы", "8.3.25");

	Сервис.Проверить(Массив("-Server"), Массив("main"), Подключение, Неопределено, Платформа1);

	Ожидаем.Что(Платформа.Вызовы.Количество()).Равно(1);
	Ожидаем.Что(Платформа.Вызовы[0].ПараметрыПодключения).Равно(Подключение);
	Ожидаем.Что(Платформа.Вызовы[0].ПараметрыПлатформы).Равно(Платформа1);

КонецПроцедуры

// ---------- фильтрация ----------

&Тест
Процедура ТестДолжен_Отбросить_ТиповыеИсключения() Экспорт

	Вывод = "Не обнаружено ссылок на процедуру: ""Подключаемый_Обработчик""" + Символы.ПС
		+ "Ошибок не обнаружено" + Символы.ПС
		+ "No errors found";

	Ожидаем.Что(Сервис.ОтфильтроватьЗамечания(Вывод).Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОставитьРеальныеЗамечания() Экспорт

	Вывод = "{Справочник.Справочник1.МодульОбъекта(4,1)}: Ошибка один" + Символы.ПС
		+ "Ошибок не обнаружено" + Символы.ПС
		+ "{Справочник.Справочник1.МодульОбъекта(9,1)}: Ошибка два";

	Замечания = Сервис.ОтфильтроватьЗамечания(Вывод);

	Ожидаем.Что(Замечания.Количество()).Равно(2);
	Ожидаем.Что(Замечания[1]).Содержит("Ошибка два");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтброситьЗамечания_ИзФайлаИсключений_БезУчётаРегистра() Экспорт

	ФайлИсключений = ВременныеФайлы.НовоеИмяФайла("txt");
	Запись = Новый ЗаписьТекста(ФайлИсключений, КодировкаТекста.UTF8);
	Запись.ЗаписатьСтроку("ИЗВЕСТНАЯ ПРОБЛЕМА");
	Запись.ЗаписатьСтроку("");
	Запись.Закрыть();

	Вывод = "{Обработка.А.МодульОбъекта(1,1)}: известная проблема тут" + Символы.ПС
		+ "{Обработка.Б.МодульОбъекта(2,2)}: настоящая ошибка";

	Замечания = Сервис.ОтфильтроватьЗамечания(Вывод, ФайлИсключений);

	Ожидаем.Что(Замечания.Количество()).Равно(1);
	Ожидаем.Что(Замечания[0]).Содержит("настоящая ошибка");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеУпасть_ЕслиФайлаИсключенийНет() Экспорт

	Замечания = Сервис.ОтфильтроватьЗамечания("{Обработка.А.МодульОбъекта(1,1)}: ошибка",
		ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "нет-такого.txt"));

	Ожидаем.Что(Замечания.Количество()).Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СклеитьЗамечаниеСФрагментомКода() Экспорт

	Вывод = "{Справочник.Справочник1.МодульОбъекта(4,1)}: Определения процедур должны идти после текста модуля" + Символы.ПС
		+ "<<?>>Процедура ПлохаяПроцедура() Экспорт (Проверка: Сервер)";

	Замечания = Сервис.ОтфильтроватьЗамечания(Вывод);

	Ожидаем.Что(Замечания.Количество(), "одно замечание из двух строк").Равно(1);
	Ожидаем.Что(Замечания[0]).Содержит("ПлохаяПроцедура");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьПустойСписок_ДляПустогоВывода() Экспорт
	Ожидаем.Что(Сервис.ОтфильтроватьЗамечания("").Количество()).Равно(0);
КонецПроцедуры

// ---------- кейсы отчёта ----------

&Тест
Процедура ТестДолжен_РазложитьПоКейсу_НаКаждоеЗамечание() Экспорт

	Замечания = Массив(
		"{Справочник.Справочник1.МодульОбъекта(4,1)}: Ошибка один",
		"{Справочник.Справочник1.МодульОбъекта(9,1)}: Ошибка два");

	Случаи = Сервис.СлучаиОтчета(Замечания);

	Ожидаем.Что(Случаи.Количество()).Равно(2);
	Ожидаем.Что(Случаи[0].Имя).Равно(Замечания[0]);
	Ожидаем.Что(Случаи[0].Сообщение).Равно(Замечания[0]);
	Ожидаем.Что(Случаи[0].Пакет, "объект метаданных").Равно("Справочник.Справочник1.МодульОбъекта");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СгруппироватьКейсыПоОбъектуМетаданных() Экспорт

	Замечания = Массив(
		"{Справочник.Справочник1.МодульОбъекта(4,1)}: Ошибка один",
		"{Справочник.Справочник1.МодульОбъекта(9,1)}: Ошибка два");

	Случаи = Сервис.СлучаиОтчета(Замечания, Истина);

	Ожидаем.Что(Случаи.Количество(), "один кейс на объект").Равно(1);
	Ожидаем.Что(Случаи[0].Имя).Равно("Справочник.Справочник1.МодульОбъекта");
	Ожидаем.Что(Случаи[0].Сообщение).Содержит("Ошибка один");
	Ожидаем.Что(Случаи[0].Сообщение).Содержит("Ошибка два");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт

	Платформа = Новый ПроверкаКонфигурацииСтаб;
	Сервис = Новый СервисСинтаксическойПроверки;

	Рефлектор = Новый Рефлектор;
	Рефлектор.УстановитьСвойство(Сервис, "Лог", Логирование.ПолучитьЛог("vrunner"));
	Рефлектор.УстановитьСвойство(Сервис, "СервисПлатформы", Платформа);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Массив(Знач Э1, Знач Э2 = Неопределено, Знач Э3 = Неопределено)
	Результат = Новый Массив;
	Результат.Добавить(Э1);
	Если Э2 <> Неопределено Тогда
		Результат.Добавить(Э2);
	КонецЕсли;
	Если Э3 <> Неопределено Тогда
		Результат.Добавить(Э3);
	КонецЕсли;
	Возврат Результат;
КонецФункции

#КонецОбласти
