	ИБВКластере();
	СеансИБ();
	НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();

	// Когда
	Сервис.ЗавершитьСеансы(Параметры, "test", Ложь, Неопределено, Новый Структура("ПаузаМс", 10000));

	// Тогда - команда не ждёт паузу целиком
	Ожидаем.Что(ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс < 5000).ЭтоИстина();

