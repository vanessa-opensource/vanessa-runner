	Ожидаем.Что(Сеанс.ВызововЗавершения).Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_РетраитьПоТаймауту_ИгнорируяПопытки() Экспорт

	// Дано - при заданном таймауте лимит попыток не действует
	Сеанс = Новый СеансСтаб().Зависший(99);
	Сеансы = Новый Массив;
	Сеансы.Добавить(Сеанс);
	ИБ = Новый ИнформационнаяБазаСтаб().ССеансами(Сеансы);
	Кластер = Новый КластерСтаб().СИБ("test", ИБ);
	Контекст = СобратьСервисСКластером(Кластер);

	Повтор = Новый Структура("ТаймаутСек, Попыток, ПаузаМс", 1, 1, 300);

	// Когда / Тогда
	Попытка
		Контекст.Сервис.ЗавершитьСеансы(Параметры, "test", Ложь, Неопределено, Повтор);
		ВызватьИсключение "должно было упасть";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("Не удалось завершить сеансы");
	КонецПопытки;

	// попыток больше одной - лимит Попыток=1 проигнорирован в пользу таймаута
	Ожидаем.Что(Сеанс.ВызововЗавершения > 1).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область СписокСеансов

&Тест
Процедура ТестДолжен_ВернутьВсеСеансы_БезОтбора() Экспорт

	// Дано
	Сеансы = Новый Массив;
	Сеансы.Добавить(Новый СеансСтаб());
	Сеансы.Добавить(Новый СеансСтаб());
	ИБ = Новый ИнформационнаяБазаСтаб().ССеансами(Сеансы);
	Кластер = Новый КластерСтаб().СИБ("test", ИБ);
	Контекст = СобратьСервисСКластером(Кластер);

	// Когда
	Результат = Контекст.Сервис.СписокСеансов(Параметры, "test");

	// Тогда
	Ожидаем.Что(Результат.Количество()).Равно(2);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьСеансыПоОтбору_СИнверсией() Экспорт

	// Дано
	СеансДизайнера = Новый СеансСтаб().СоСвойством("app-id", "Designer");
	СеансКлиента = Новый СеансСтаб().СоСвойством("app-id", "1CV8");
	Сеансы = Новый Массив;
	Сеансы.Добавить(СеансДизайнера);
	Сеансы.Добавить(СеансКлиента);
	ИБ = Новый ИнформационнаяБазаСтаб().ССеансами(Сеансы);
	Кластер = Новый КластерСтаб().СИБ("test", ИБ);
	Контекст = СобратьСервисСКластером(Кластер);

	Отбор = Новый ОтборСеансов().ДобавитьУсловиеПоПриложению("Designer").Инвертировать();

	// Когда
	Результат = Контекст.Сервис.СписокСеансов(Параметры, "test", Отбор);

	// Тогда - все, кроме Designer
	Ожидаем.Что(Результат.Количество()).Равно(1);
	Ожидаем.Что(Результат[0].Получить("app-id")).Равно("1CV8");

КонецПроцедуры

#КонецОбласти

#Область ОжиданиеОтсутствияСеансов

&Тест
Процедура ТестДолжен_ВернутьПусто_ЕслиСеансовНет() Экспорт

	// Дано
	ИБ = Новый ИнформационнаяБазаСтаб();
	Кластер = Новый КластерСтаб().СИБ("test", ИБ);
	Контекст = СобратьСервисСКластером(Кластер);

	// Когда
	Остались = Контекст.Сервис.ДождатьсяОтсутствияСеансов(Параметры, "test");

	// Тогда
	Ожидаем.Что(Остались.Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьСеансыСразу_ПриНулевомТаймауте() Экспорт

	// Дано
	Сеансы = Новый Массив;
	Сеансы.Добавить(Новый СеансСтаб());
	ИБ = Новый ИнформационнаяБазаСтаб().ССеансами(Сеансы);
	Кластер = Новый КластерСтаб().СИБ("test", ИБ);
	Контекст = СобратьСервисСКластером(Кластер);

	// Когда - таймаут 0: одна проверка без ожидания
	Остались = Контекст.Сервис.ДождатьсяОтсутствияСеансов(Параметры, "test", Неопределено, 0, 0);

	// Тогда
	Ожидаем.Что(Остались.Количество()).Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ДождатьсяЗавершенияСеансов() Экспорт

	// Дано - на третьей проверке сеансов не остаётся
	СписокССеансом = Новый Массив;
	СписокССеансом.Добавить(Новый СеансСтаб());

	Очередь = Новый Массив;
	Очередь.Добавить(СписокССеансом);
	Очередь.Добавить(СписокССеансом);
	Очередь.Добавить(Новый Массив);

	ИБ = Новый ИнформационнаяБазаСтаб().ССеансамиПоВызовам(Очередь);
	Кластер = Новый КластерСтаб().СИБ("test", ИБ);
	Контекст = СобратьСервисСКластером(Кластер);

	// Когда
	Остались = Контекст.Сервис.ДождатьсяОтсутствияСеансов(Параметры, "test", Неопределено, 60, 0);

	// Тогда
	Ожидаем.Что(Остались.Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьСеансыПоТаймаутуОжидания() Экспорт

	// Дано - сеанс не завершается
	Сеансы = Новый Массив;
	Сеансы.Добавить(Новый СеансСтаб());
	ИБ = Новый ИнформационнаяБазаСтаб().ССеансами(Сеансы);
	Кластер = Новый КластерСтаб().СИБ("test", ИБ);
	Контекст = СобратьСервисСКластером(Кластер);

	// Когда
	Остались = Контекст.Сервис.ДождатьсяОтсутствияСеансов(Параметры, "test", Неопределено, 1, 300);

	// Тогда
	Ожидаем.Что(Остались.Количество()).Равно(1);

КонецПроцедуры

#КонецОбласти

#Область СписокСоединений

&Тест
Процедура ТестДолжен_ВернутьСоединенияИБ() Экспорт

	// Дано
	Соединения = Новый Массив;
	Соединения.Добавить(Новый СеансСтаб().СоСвойством("conn-id", "c1"));
	Соединения.Добавить(Новый СеансСтаб().СоСвойством("conn-id", "c2"));
	ИБ = Новый ИнформационнаяБазаСтаб().ССоединениями(Соединения);
	Кластер = Новый КластерСтаб().СИБ("test", ИБ);
	Контекст = СобратьСервисСКластером(Кластер);

	// Когда
	Результат = Контекст.Сервис.СписокСоединений(Параметры, "test");

	// Тогда
	Ожидаем.Что(Результат.Количество()).Равно(2);
	Ожидаем.Что(Результат[0].Получить("conn-id")).Равно("c1");

КонецПроцедуры

#КонецОбласти

#Область РегламентныеЗадания

&Тест
Процедура ТестДолжен_ЗаблокироватьРегламентныеЗадания() Экспорт

