КонецПроцедуры

#КонецОбласти

#Область ЗавершитьСеансы

&Тест
Процедура ТестДолжен_ЗавершитьВсеСеансыИЗаблокироватьНовые() Экспорт

	// Дано
	Сеансы = Новый Массив;
	Сеансы.Добавить(Новый СеансСтаб());
	Сеансы.Добавить(Новый СеансСтаб());
	ИБ = Новый ИнформационнаяБазаСтаб().ССеансами(Сеансы);
	Кластер = Новый КластерСтаб().СИБ("test", ИБ);
	Контекст = СобратьСервисСКластером(Кластер);

	// Когда
	Контекст.Сервис.ЗавершитьСеансы(Параметры, "test", Истина, Неопределено, БыстрыйПовтор());

	// Тогда
	Ожидаем.Что(Сеансы[0].Завершен).ЭтоИстина();
	Ожидаем.Что(Сеансы[1].Завершен).ЭтоИстина();
	// плюс одна установка БлокировкаСеансовВключена
	Ожидаем.Что(ИБ.ИзмененияВсего.Количество()).Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗавершитьТолькоСеансыПоОтбору() Экспорт

	// Дано
	СеансДизайнера = Новый СеансСтаб().СоСвойством("app-id", "Designer");
	СеансКлиента = Новый СеансСтаб().СоСвойством("app-id", "1CV8");
	Сеансы = Новый Массив;
	Сеансы.Добавить(СеансДизайнера);
	Сеансы.Добавить(СеансКлиента);
	ИБ = Новый ИнформационнаяБазаСтаб().ССеансами(Сеансы);
	Кластер = Новый КластерСтаб().СИБ("test", ИБ);
	Контекст = СобратьСервисСКластером(Кластер);

	Отбор = Новый ОтборСеансов().ДобавитьУсловиеПоПриложению("Designer");

	// Когда
	Контекст.Сервис.ЗавершитьСеансы(Параметры, "test", Ложь, Отбор, БыстрыйПовтор());

	// Тогда
	Ожидаем.Что(СеансДизайнера.Завершен).ЭтоИстина();
	Ожидаем.Что(СеансКлиента.Завершен).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗавершитьОстальныеСеансы_НесмотряНаОшибкуОдного() Экспорт

	// Дано
	Сеанс1 = Новый СеансСтаб();
	Сеанс1.БроситьПриЗавершении = Истина;
	Сеанс2 = Новый СеансСтаб();
	Сеансы = Новый Массив;
	Сеансы.Добавить(Сеанс1);
	Сеансы.Добавить(Сеанс2);
	ИБ = Новый ИнформационнаяБазаСтаб().ССеансами(Сеансы);
	Кластер = Новый КластерСтаб().СИБ("test", ИБ);
	Контекст = СобратьСервисСКластером(Кластер);

	// Когда - незавершаемый сеанс приводит к исключению после исчерпания попыток
	Попытка
		Контекст.Сервис.ЗавершитьСеансы(Параметры, "test", Ложь, Неопределено, БыстрыйПовтор());
		ВызватьИсключение "должно было упасть";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("Не удалось завершить сеансы");
	КонецПопытки;

	// Тогда - второй сеанс завершён, несмотря на ошибку первого
	Ожидаем.Что(Сеанс2.Завершен).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ДобитьЗависшийСеанс_ПовторнойПопыткой() Экспорт

	// Дано - сеанс "зависает" и завершается только со второй попытки
	Сеанс = Новый СеансСтаб().Зависший(2);
	Сеансы = Новый Массив;
	Сеансы.Добавить(Сеанс);
	ИБ = Новый ИнформационнаяБазаСтаб().ССеансами(Сеансы);
	Кластер = Новый КластерСтаб().СИБ("test", ИБ);
	Контекст = СобратьСервисСКластером(Кластер);

	// Когда
	Контекст.Сервис.ЗавершитьСеансы(Параметры, "test", Ложь, Неопределено, БыстрыйПовтор());

	// Тогда
	Ожидаем.Что(Сеанс.Завершен).ЭтоИстина();
	Ожидаем.Что(Сеанс.ВызововЗавершения).Равно(2);

КонецПроцедуры

&Тест
Процедура ТестДолжен_БроситьИсключение_ПослеИсчерпанияПопыток() Экспорт

	// Дано - сеанс не завершается никогда
	Сеанс = Новый СеансСтаб().Зависший(99);
	Сеансы = Новый Массив;
	Сеансы.Добавить(Сеанс);
	ИБ = Новый ИнформационнаяБазаСтаб().ССеансами(Сеансы);
	Кластер = Новый КластерСтаб().СИБ("test", ИБ);
	Контекст = СобратьСервисСКластером(Кластер);

	// Когда / Тогда
	Попытка
		Контекст.Сервис.ЗавершитьСеансы(Параметры, "test", Ложь, Неопределено, БыстрыйПовтор());
		ВызватьИсключение "должно было упасть";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("Не удалось завершить сеансы");
	КонецПопытки;

	// 3 попытки по умолчанию
	Ожидаем.Что(Сеанс.ВызововЗавершения).Равно(3);

КонецПроцедуры

&Тест
Процедура ТестДолжен_УчестьЗаданноеКоличествоПопыток() Экспорт

	// Дано
	Сеанс = Новый СеансСтаб().Зависший(99);
	Сеансы = Новый Массив;
	Сеансы.Добавить(Сеанс);
