// BSLLS:NumberOfValuesInStructureConstructor-off
// BSLLS-off
// Юнит-тесты СервисКластера.
// Покрытие всех публичных методов через стабы УправлениеКластером1С / Кластер / ИБ / Сеансы.

#Использовать asserts

#Использовать "../../../src/core/Сервисы"
#Использовать "../utils"

Перем Параметры;

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	Параметры = Новый Структура;
	Параметры.Вставить("ВерсияПлатформы", "8.3.20");
	Параметры.Вставить("АдресRAS", "localhost:1545");
	Параметры.Вставить("АдминистраторКластера", "admin");
	Параметры.Вставить("ПарольКластера", "secret");
КонецПроцедуры

Функция СобратьСервисСКластером(Кластер)
	Управление = Новый УправлениеКластеромСтаб();
	Управление.ДобавитьКластер(Кластер);
	Возврат Новый Структура("Сервис, Управление, Кластер",
		Новый БилдерСервисаКластера().СФабрикойУправления(Управление).Собрать(),
		Управление, Кластер);
КонецФункции

// Параметры повтора без пауз - чтобы тесты не ждали реальные 3 секунды между попытками.
Функция БыстрыйПовтор(Попыток = 3)
	Возврат Новый Структура("Попыток, ПаузаМс", Попыток, 0);
КонецФункции

#Область Подключение

&Тест
Процедура ТестДолжен_БроситьИсключение_ЕслиКластеровНет() Экспорт

	// Дано
	Управление = Новый УправлениеКластеромСтаб();
	Сервис = Новый БилдерСервисаКластера().СФабрикойУправления(Управление).Собрать();
	ПарИБ = Новый Структура("ИмяИБ", "test");

	// Когда / Тогда
	Попытка
		Сервис.СоздатьИБ(Параметры, ПарИБ);
		ВызватьИсключение "должно было упасть";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("Кластер серверов не найден");
	КонецПопытки;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыбратьКластер_ПоИмени() Экспорт

	// Дано
	Кластер1 = Новый КластерСтаб().СИменемИИд("A", "id-a");
	Кластер2 = Новый КластерСтаб().СИменемИИд("B", "id-b");
	Управление = Новый УправлениеКластеромСтаб()
		.ДобавитьКластер(Кластер1)
		.ДобавитьКластер(Кластер2);
	Сервис = Новый БилдерСервисаКластера().СФабрикойУправления(Управление).Собрать();

	Параметры.Вставить("ИмяКластера", "B");
	ПарИБ = Новый Структура("ИмяИБ", "test");

	// Когда
	Сервис.СоздатьИБ(Параметры, ПарИБ);

	// Тогда - ИБ добавлена именно в кластер B
	Ожидаем.Что(Кластер2.ДобавленныеИБ.Количество()).Равно(1);
	Ожидаем.Что(Кластер1.ДобавленныеИБ.Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_БроситьИсключение_ЕслиКластерПоИдНеНайден() Экспорт

	// Дано
	Управление = Новый УправлениеКластеромСтаб().ДобавитьКластер(Новый КластерСтаб());
	Сервис = Новый БилдерСервисаКластера().СФабрикойУправления(Управление).Собрать();
	Параметры.Вставить("ИдентификаторКластера", "не-существует");

	// Когда / Тогда
	Попытка
		Сервис.СоздатьИБ(Параметры, Новый Структура("ИмяИБ", "test"));
		ВызватьИсключение "должно было упасть";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("Кластер серверов не найден");
	КонецПопытки;

КонецПроцедуры

&Тест
Процедура ТестДолжен_УстановитьАдминистратораКластера_ИзПараметров() Экспорт

	// Дано
	Кластер = Новый КластерСтаб();
	Контекст = СобратьСервисСКластером(Кластер);

	// Когда
	Контекст.Сервис.СоздатьИБ(Параметры, Новый Структура("ИмяИБ", "test"));

	// Тогда
	Ожидаем.Что(Кластер.АдминистраторКластера).Равно("admin");
	Ожидаем.Что(Кластер.ПарольКластера).Равно("secret");

КонецПроцедуры

#КонецОбласти

#Область СоздатьИБ

&Тест
Процедура ТестДолжен_СоздатьИБ_СПараметрамиСУБД() Экспорт

	// Дано
	Кластер = Новый КластерСтаб();
	Контекст = СобратьСервисСКластером(Кластер);

	ПарИБ = Новый Структура;
	ПарИБ.Вставить("ИмяИБ", "test_db");
	ПарИБ.Вставить("ТипСУБД", "PostgreSQL");
	ПарИБ.Вставить("АдресСервераСУБД", "localhost");
	ПарИБ.Вставить("ИмяБазыСУБД", "test_db");
	ПарИБ.Вставить("ИмяПользователяБазыСУБД", "postgres");
	ПарИБ.Вставить("ПарольПользователяБазыСУБД", "pwd");
	ПарИБ.Вставить("Локализация", "en_US");
	ПарИБ.Вставить("СоздаватьБДСУБД", Ложь);

	// Когда
	Контекст.Сервис.СоздатьИБ(Параметры, ПарИБ);

	// Тогда
	Ожидаем.Что(Кластер.ДобавленныеИБ.Количество()).Равно(1);
	Запись = Кластер.ДобавленныеИБ[0];
	Ожидаем.Что(Запись.Имя).Равно("test_db");
	Ожидаем.Что(Запись.Локализация).Равно("en_US");
	Ожидаем.Что(Запись.СоздаватьБД).ЭтоЛожь();
	Ожидаем.Что(Запись.Параметры.ТипСУБД).Равно("PostgreSQL");
	Ожидаем.Что(Запись.Параметры.АдресСервераСУБД).Равно("localhost");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьИБ_СоЗначениямиПоУмолчанию() Экспорт

	// Дано
	Кластер = Новый КластерСтаб();
	Контекст = СобратьСервисСКластером(Кластер);

	// Когда
	Контекст.Сервис.СоздатьИБ(Параметры, Новый Структура("ИмяИБ", "test"));

	// Тогда
	Запись = Кластер.ДобавленныеИБ[0];
	Ожидаем.Что(Запись.Локализация).Равно("ru_RU");
	Ожидаем.Что(Запись.СоздаватьБД).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВключитьБлокировкуРЗ_ПриФлаге() Экспорт

