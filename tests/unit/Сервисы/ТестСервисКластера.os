// BSLLS-off
// Юнит-тесты СервисКластера: подключение к RAS и выбор кластера, создание и удаление ИБ, сведения об ИБ,
// блокировки, завершение и ожидание сеансов, списки, регламентные задания. v8ras подменён КлиентRASСтаб.

#Использовать asserts
#Использовать logos
#Использовать moskito
#Использовать "../utils"

Перем Стенд;
Перем Сервис;
Перем Клиент;    // КлиентRASСтаб
Перем Фабрика;   // ФабрикаСтаб: параметры каждого Создать(Хост, Порт)
Перем Параметры; // параметры подключения к кластеру

&ПередКаждым
Процедура ПередКаждым() Экспорт
	Стенд = Новый Стенд;
	Клиент = Новый КлиентRASСтаб;
	Фабрика = Стенд.Подменить("_ФабрикаКлиентаRAS", Новый ФабрикаСтаб(Клиент));
	Сервис = Стенд.Сервис("СервисКластера");
	Параметры = Новый Структура("АдресRAS, АдминистраторКластера, ПарольКластера", "localhost:1545", "admin", "secret");
КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт
	Ожидаем.Что(Клиент.Отключений, "каждое соединение с RAS закрыто").Равно(Клиент.Подключений);
КонецПроцедуры

#Область ПодключениеККластеру

&Тест
Процедура ТестДолжен_БроситьИсключение_ЕслиКластеровНет() Экспорт

	Ожидаем.Что(Сервис).Метод("СоздатьИБ", ТестовыеДанные.Массив(Параметры, ПараметрыИБ()))
		.ВыбрасываетИсключение("Кластер серверов не найден");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыбратьКластер_ПоИмени() Экспорт

	// Дано
	Клиент.СКластером("A", "id-a").СКластером("B", "id-b");
	Параметры.Вставить("ИмяКластера", "B");

	// Когда
	Сервис.СоздатьИБ(Параметры, ПараметрыИБ());

	// Тогда - ИБ создана именно в кластере B
	Ожидаем.Что(Клиент.СозданныеБазы[0].ИдКластера).Равно("id-b");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыбратьКластер_ПоИдБезУчетаРегистра() Экспорт

	// Дано
	Клиент.СКластером("A", "a0000000-0000-0000-0000-00000000000a").СКластером("B", "b0000000-0000-0000-0000-00000000000b");
	Параметры.Вставить("ИдентификаторКластера", "B0000000-0000-0000-0000-00000000000B");

	// Когда
	Сервис.СоздатьИБ(Параметры, ПараметрыИБ());

	// Тогда
	Ожидаем.Что(Клиент.СозданныеБазы[0].ИдКластера).Равно("b0000000-0000-0000-0000-00000000000b");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыбратьПервыйКластер_ПоУмолчанию() Экспорт

	Клиент.СКластером("A", "id-a").СКластером("B", "id-b");

	Сервис.СоздатьИБ(Параметры, ПараметрыИБ());

	Ожидаем.Что(Клиент.СозданныеБазы[0].ИдКластера).Равно("id-a");

КонецПроцедуры

&Тест
Процедура ТестДолжен_БроситьИсключение_ЕслиКластерПоИдНеНайден() Экспорт

	Клиент.СКластером("A", "id-a");
	Параметры.Вставить("ИдентификаторКластера", "не-существует");

	Ожидаем.Что(Сервис).Метод("СоздатьИБ", ТестовыеДанные.Массив(Параметры, ПараметрыИБ()))
		.ВыбрасываетИсключение("Кластер серверов не найден");

КонецПроцедуры

&Тест
Процедура ТестДолжен_АутентифицироватьсяВКластере_ИзПараметров() Экспорт

	// Дано
	Клиент.СКластером("A", "id-a");

	// Когда
	Сервис.СоздатьИБ(Параметры, ПараметрыИБ());

	// Тогда
	Ожидаем.Что(Клиент.Аутентификации).ИмеетДлину(1);
	Ожидаем.Что(Клиент.Аутентификации[0].Кому).Равно("Кластер");
	Ожидаем.Что(Клиент.Аутентификации[0].ИдКластера).Равно("id-a");
	Ожидаем.Что(Клиент.Аутентификации[0].Пользователь).Равно("admin");
	Ожидаем.Что(Клиент.Аутентификации[0].Пароль).Равно("secret");

КонецПроцедуры

&Тест
Процедура ТестДолжен_АутентифицироватьсяВКластере_БезАдминистратора() Экспорт

	// Дано - администратор не задан (CLI отдаёт Неопределено): кластер без администраторов требует входа с пустыми
	Клиент.СКластером("A", "id-a");
	Параметры = Новый Структура("АдминистраторКластера", Неопределено);

	// Когда
	Сервис.СоздатьИБ(Параметры, ПараметрыИБ());

	// Тогда
	Ожидаем.Что(Клиент.Аутентификации).ИмеетДлину(1);
	Ожидаем.Что(Клиент.Аутентификации[0].Пользователь).Равно("");
	Ожидаем.Что(Клиент.Аутентификации[0].Пароль).Равно("");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПодключитьсяКRAS_ПоАдресуСПортом() Экспорт

	Клиент.СКластером("A", "id-a");
	Параметры.АдресRAS = "srv:1546";

	Сервис.СоздатьИБ(Параметры, ПараметрыИБ());

	Ожидаем.Что(Фабрика.Вызовы[0][0]).Равно("srv");
	Ожидаем.Что(Фабрика.Вызовы[0][1]).Равно(1546);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПодставитьПортRAS_ПоУмолчанию() Экспорт

	Клиент.СКластером("A", "id-a");
	Параметры.АдресRAS = "srv";

	Сервис.СоздатьИБ(Параметры, ПараметрыИБ());

	Ожидаем.Что(Фабрика.Вызовы[0][0]).Равно("srv");
	Ожидаем.Что(Фабрика.Вызовы[0][1]).Равно(1545);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПодключитьсяКLocalhost_БезАдресаRAS() Экспорт

	Клиент.СКластером("A", "id-a");
	Параметры.АдресRAS = "";

	Сервис.СоздатьИБ(Параметры, ПараметрыИБ());

	Ожидаем.Что(Фабрика.Вызовы[0][0]).Равно("localhost");
	Ожидаем.Что(Фабрика.Вызовы[0][1]).Равно(1545);

КонецПроцедуры

&Тест
Процедура ТестДолжен_БроситьИсключение_ПриНеверномАдресеRAS() Экспорт

	Параметры.АдресRAS = "srv:abc";
	Ожидаем.Что(Сервис).Метод("СоздатьИБ", ТестовыеДанные.Массив(Параметры, ПараметрыИБ()))
		.ВыбрасываетИсключение("Неверный адрес RAS ""srv:abc"": ожидается host[:port]");

	Параметры.АдресRAS = "srv:1545:1";
	Ожидаем.Что(Сервис).Метод("СоздатьИБ", ТестовыеДанные.Массив(Параметры, ПараметрыИБ()))
		.ВыбрасываетИсключение("Неверный адрес RAS");

	Ожидаем.Что(Фабрика.Вызовы).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПредупредитьОбУстаревшейОпцииRac() Экспорт

	// Дано
	Лог = Стенд.Подменить("Лог", Мок.Следить(Логирование.ПолучитьЛог("vrunner")));
	Клиент.СКластером("A", "id-a");
	Параметры.Вставить("ПутьRac", "bin/rac");

	// Когда
	Сервис.СоздатьИБ(Параметры, ПараметрыИБ());

	// Тогда - путь к rac игнорируется, операция выполнена через RAS
	Лог.ПроверитьЧтоВызывалсяМетод().Предупреждение("Опция --rac устарела и игнорируется: rac не используется");
	Ожидаем.Что(Клиент.СозданныеБазы).ИмеетДлину(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗакрытьСоединение_ПриОтказеСервера() Экспорт

	// Дано - сервер отклоняет вход в кластер со второго раза
	ИБВКластере();
	СеансИБ();
	Клиент.ОтказатьВоВходеС = 2;

	// Когда - сеансы прочитаны, отказ при их завершении; затем при удалении ИБ
	Ожидаем.Что(Сервис).Метод("ЗавершитьСеансы", ПараметрыЗавершения(БыстрыйПовтор()))
		.ВыбрасываетИсключение("Доступ запрещен");
	Ожидаем.Что(Сервис).Метод("УдалитьИБ", ТестовыеДанные.Массив(Параметры, "test"))
		.ВыбрасываетИсключение("Доступ запрещен");

	// Тогда - все три соединения закрыты (ПослеКаждого)
	Ожидаем.Что(Клиент.Подключений).Равно(3);

КонецПроцедуры

#КонецОбласти

#Область СоздатьИБ

&Тест
Процедура ТестДолжен_СоздатьИБ_СПараметрамиСУБД() Экспорт

	// Дано
	Клиент.СКластером("A", "id-a");
	ПарИБ = ПараметрыИБ("test_db");
	ПарИБ.Вставить("ТипСУБД", "PostgreSQL");
	ПарИБ.Вставить("АдресСервераСУБД", "localhost");
	ПарИБ.Вставить("ИмяБазыСУБД", "test_db_dbms");
	ПарИБ.Вставить("ИмяПользователяБазыСУБД", "postgres");
	ПарИБ.Вставить("ПарольПользователяБазыСУБД", "pwd");
	ПарИБ.Вставить("Локализация", "en_US");
	ПарИБ.Вставить("СоздаватьБДСУБД", Ложь);

	// Когда
	Сервис.СоздатьИБ(Параметры, ПарИБ);

	// Тогда
	Ожидаем.Что(Клиент.СозданныеБазы).ИмеетДлину(1);
	Создание = Клиент.СозданныеБазы[0];
	Ожидаем.Что(Создание.Режим, "без создания БД в СУБД").Равно(0);
	Ожидаем.Что(Создание.Инфо.Имя).Равно("test_db");
	Ожидаем.Что(Создание.Инфо.СУБД).Равно("PostgreSQL");
	Ожидаем.Что(Создание.Инфо.СерверБД).Равно("localhost");
	Ожидаем.Что(Создание.Инфо.ИмяБД).Равно("test_db_dbms");
	Ожидаем.Что(Создание.Инфо.ПользовательБД).Равно("postgres");
	Ожидаем.Что(Создание.Инфо.ПарольБД).Равно("pwd");
	Ожидаем.Что(Создание.Инфо.Локаль).Равно("en_US");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьИБ_СоЗначениямиПоУмолчанию() Экспорт

	// Дано
	Клиент.СКластером("A", "id-a");

	// Когда
	Сервис.СоздатьИБ(Параметры, ПараметрыИБ());

	// Тогда - умолчания rac create, а не v8ras
	Создание = Клиент.СозданныеБазы[0];
	Ожидаем.Что(Создание.Режим, "с созданием БД в СУБД").Равно(1);
	Ожидаем.Что(Создание.Инфо.Локаль).Равно("ru_RU");
	Ожидаем.Что(Создание.Инфо.СУБД).Равно("MSSQLServer");
	Ожидаем.Что(Создание.Инфо.СмещениеДат).Равно(2000);
	Ожидаем.Что(Создание.Инфо.ВыдачаЛицензийСервером).Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВключитьБлокировкуРегламентныхЗаданий_ПриФлаге() Экспорт

	// Дано
	Клиент.СКластером("A", "id-a");
	ПарИБ = ПараметрыИБ("x");
	ПарИБ.Вставить("БлокироватьРегламентныеЗадания", Истина);

	// Когда
	Сервис.СоздатьИБ(Параметры, ПарИБ);

	// Тогда
	Ожидаем.Что(Клиент.СозданныеБазы[0].Инфо.БлокировкаРегламентных).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область УдалитьИБ

&Тест
Процедура ТестДолжен_УдалитьИБ_СУдалениемБД() Экспорт

	// Дано
	ИБВКластере();
	Параметры.Вставить("Пользователь", "u");
	Параметры.Вставить("Пароль", "p");

	// Когда
	Сервис.УдалитьИБ(Параметры, "test", "drop");

	// Тогда
	Ожидаем.Что(Клиент.УдаленныеБазы).ИмеетДлину(1);
	Ожидаем.Что(Клиент.УдаленныеБазы[0].ИдБазы).Равно(ИдБазы());
	Ожидаем.Что(Клиент.УдаленныеБазы[0].Режим).Равно(1);
	ПроверитьВходВИБ("u", "p");

КонецПроцедуры

&Тест
Процедура ТестДолжен_УдалитьИБ_СОчисткойБД() Экспорт

	ИБВКластере();

	Сервис.УдалитьИБ(Параметры, "test", "clear");

	Ожидаем.Что(Клиент.УдаленныеБазы[0].Режим).Равно(2);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СнятьИБСРегистрации_БезДействийСБД() Экспорт

	// Дано
	ИБВКластере();

	// Когда
	Сервис.УдалитьИБ(Параметры, "test");

	// Тогда - база данных не тронута; без пользователя ИБ вход только в кластер
	Ожидаем.Что(Клиент.УдаленныеБазы[0].Режим).Равно(0);
	Ожидаем.Что(Клиент.Аутентификации).ИмеетДлину(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПропуститьУдаление_ЕслиИБНеНайдена() Экспорт

	ИБВКластере();

	Сервис.УдалитьИБ(Параметры, "missing", "drop");

	Ожидаем.Что(Клиент.УдаленныеБазы).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_БроситьИсключение_ПриНеизвестномДействииСБД() Экспорт

	Ожидаем.Что(Сервис).Метод("УдалитьИБ", ТестовыеДанные.Массив(Параметры, "test", "DROP"))
		.ВыбрасываетИсключение("Неизвестное действие с базой данных СУБД: DROP");

	Ожидаем.Что(Фабрика.Вызовы).ИмеетДлину(0);

КонецПроцедуры

#КонецОбласти

#Область ИнформацияОбИБ

&Тест
Процедура ТестДолжен_ВернутьПредставлениеИБ_СПолямиRac() Экспорт

	// Дано
	ИБВКластере(Новый Структура("БлокировкаСеансов, ВыдачаЛицензийСервером", Истина, 0));

	// Когда
	ИБ = Сервис.ИнформацияОбИБ(Параметры, "test");

	// Тогда - поля и значения как в выводе rac infobase info; ИБ не изменяется
	Ожидаем.Что(ИБ.Получить("infobase")).Равно(ИдБазы());
	Ожидаем.Что(ИБ.Получить("name")).Равно("test");
	Ожидаем.Что(ИБ.Получить("dbms")).Равно("PostgreSQL");
	Ожидаем.Что(ИБ.Получить("db-server")).Равно("pg");
	Ожидаем.Что(ИБ.Получить("db-name")).Равно("test");
	Ожидаем.Что(ИБ.Получить("sessions-deny")).Равно("on");
	Ожидаем.Что(ИБ.Получить("scheduled-jobs-deny")).Равно("off");
	Ожидаем.Что(ИБ.Получить("license-distribution")).Равно("deny");
	Ожидаем.Что(Клиент.ОбновленияБаз).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПредставитьБлокировкиИЛицензии_ЗначениямиRac() Экспорт

	ИБВКластере(Новый Структура("БлокировкаРегламентных", Истина));

	ИБ = Сервис.ИнформацияОбИБ(Параметры, "test");

	Ожидаем.Что(ИБ.Получить("sessions-deny")).Равно("off");
	Ожидаем.Что(ИБ.Получить("scheduled-jobs-deny")).Равно("on");
	Ожидаем.Что(ИБ.Получить("license-distribution")).Равно("allow");

КонецПроцедуры

&Тест
Процедура ТестДолжен_БроситьИсключение_ЕслиИБНеНайдена() Экспорт

	ИБВКластере();

	Для Каждого Операция Из ТестовыеДанные.Массив("ИнформацияОбИБ", "СписокСеансов", "СписокСоединений") Цикл
		Ожидаем.Что(Сервис).Метод(Операция, ТестовыеДанные.Массив(Параметры, "missing"))
			.ВыбрасываетИсключение("ИБ ""missing"" не найдена в кластере");
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиИБ_ПоUUID() Экспорт

	ИБВКластере();

	ИБ = Сервис.ИнформацияОбИБ(Параметры, ВРег(ИдБазы()));

	Ожидаем.Что(ИБ.Получить("name")).Равно("test");

КонецПроцедуры

&Тест
Процедура ТестДолжен_АутентифицироватьсяВИБ_ПриЗаданномПользователе() Экспорт

	ИБВКластере();
	Параметры.Вставить("Пользователь", "Администратор");
	Параметры.Вставить("Пароль", "pwd");

	Сервис.ИнформацияОбИБ(Параметры, "test");

	ПроверитьВходВИБ("Администратор", "pwd");

КонецПроцедуры

#КонецОбласти

#Область БлокировкаСеансов

&Тест
Процедура ТестДолжен_ЗаблокироватьСеансы_СПараметрамиБлокировки() Экспорт

	// Дано
	ИБВКластере();
	ПарБлок = Новый Структура("КодРазрешения, СообщениеБлокировки", "code123", "обслуживание");

	// Когда
	Сервис.ЗаблокироватьСеансы(Параметры, "test", ПарБлок);

	// Тогда
	Ожидаем.Что(Клиент.ОбновленияБаз).ИмеетДлину(1);
	Ожидаем.Что(Клиент.ОбновленияБаз[0].БлокировкаСеансов).ЭтоИстина();
	Ожидаем.Что(Клиент.ОбновленияБаз[0].КодРазрешения).Равно("code123");
	Ожидаем.Что(Клиент.ОбновленияБаз[0].СообщениеБлокировки).Равно("обслуживание");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьПрежниеНастройкиИБ_ПриБлокировкеБезПараметров() Экспорт

	// Дано
	ИБВКластере(Новый Структура("СообщениеБлокировки, КодРазрешения, ПользовательБД", "прежнее", "old", "pguser"));

	// Когда
	Сервис.ЗаблокироватьСеансы(Параметры, "test");

	// Тогда - в ИБ записано полное описание: заданное ранее не затёрто
	Обновление = Клиент.ОбновленияБаз[0];
	Ожидаем.Что(Обновление.БлокировкаСеансов).ЭтоИстина();
	Ожидаем.Что(Обновление.СообщениеБлокировки).Равно("прежнее");
	Ожидаем.Что(Обновление.КодРазрешения).Равно("old");
	Ожидаем.Что(Обновление.ПользовательБД).Равно("pguser");

КонецПроцедуры

