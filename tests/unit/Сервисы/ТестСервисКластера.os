	// Когда
	Факт = Контекст.Сервис.ИнформацияОбИБ(Параметры, "test");

	// Тогда
	Ожидаем.Что(Факт).Равно(ИБ);
	Ожидаем.Что(ИБ.КоличествоОбновлений).Равно(1);

КонецПроцедуры

