	ИБВКластере();
	Сеанс = ЗависшийСеанс();
	Повтор = Новый Структура("ТаймаутСек, Попыток, ПаузаМс", 1, 1, 300);

	// Когда
	Ожидаем.Что(Сервис).Метод("ЗавершитьСеансы", ПараметрыЗавершения(Повтор))
		.ВыбрасываетИсключение("Не удалось завершить сеансы");

	// Тогда - попыток больше одной: лимит Попыток=1 проигнорирован в пользу таймаута
	Ожидаем.Что(Сеанс.ВызововЗавершения > 1).ЭтоИстина();

