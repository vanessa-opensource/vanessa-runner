&Тест
Процедура ТестДолжен_ЗавершитьСеансПоявившийсяПослеВыключенияПроцесса() Экспорт

	// Дано - после замены процесса появляется сеанс (например, системное фоновое задание)
	ИБВКластере();
	ПовисшееСоединение();
	Сеанс = СеансИБ("SystemBackgroundJob");
	Сеанс.ПоявитсяПослеВыключения = Истина;

	// Когда
	Сервис.ЗавершитьСеансы(Параметры, "test", Ложь, Неопределено, ПовторСПерезапуском());

	// Тогда
	Ожидаем.Что(Сеанс.Завершен).ЭтоИстина();
	Ожидаем.Что(Сеанс.ВызововЗавершения).Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеВыключатьПроцессы_ПриНулевомПериодеПринудительногоЗавершения() Экспорт

	// Дано - кластер не останавливает выключенные процессы принудительно
	ИБВКластере();
	Клиент.Кластеры()[0].ПериодПринудительногоЗавершения = 0;
	ПовисшееСоединение();

	// Когда
	Ожидаем.Что(Сервис).Метод("ЗавершитьСеансы", ПараметрыЗавершения(ПовторСПерезапуском()))
		.ВыбрасываетИсключение("expiration-timeout");

	// Тогда
	Ожидаем.Что(Клиент.ВыключенныеПроцессы).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеВыключатьПроцессы_ПокаОстаютсяСеансы() Экспорт

	// Дано
	ИБВКластере();
	ЗависшийСеанс();
	ПовисшееСоединение();

	// Когда
	Ожидаем.Что(Сервис).Метод("ЗавершитьСеансы", ПараметрыЗавершения(ПовторСПерезапуском()))
		.ВыбрасываетИсключение("Не удалось завершить сеансы");

	// Тогда
	Ожидаем.Что(Клиент.ВыключенныеПроцессы).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_БроситьИсключение_ЕслиСоединениеПережилоВыключение() Экспорт

	// Дано - процесс не остановился за период принудительного завершения
	ИБВКластере();
	Клиент.Кластеры()[0].ПериодПринудительногоЗавершения = 1;
	ПовисшееСоединение().ПереживетВыключение = Истина;
	Повтор = ПовторСПерезапуском();
	Повтор.Вставить("ЗапасВыключенияСек", 0);

	// Когда
	Ожидаем.Что(Сервис).Метод("ЗавершитьСеансы", ПараметрыЗавершения(Повтор))
		.ВыбрасываетИсключение("остались соединения без сеанса");

	// Тогда - ни выключение, ни разрыв не повторялись
	Ожидаем.Что(Клиент.ВыключенныеПроцессы).ИмеетДлину(1);
	Ожидаем.Что(Клиент.РазорванныеСоединения).ИмеетДлину(1);

КонецПроцедуры

#КонецОбласти

#Область ВыключитьРабочийПроцесс

&Тест
Процедура ТестДолжен_ВыключитьРабочийПроцесс_ПоPid() Экспорт

	// Дано
	Лог = Стенд.Подменить("Лог", Мок.Следить(Логирование.ПолучитьЛог("vrunner")));
	ИБВКластере();
	Клиент.ДобавитьПроцесс("1");
	Процесс = Клиент.ДобавитьПроцесс("2");

	// Когда
	Сервис.ВыключитьРабочийПроцесс(Параметры, " 2 ");

	// Тогда - выключен только он, срок остановки назван
	Ожидаем.Что(Клиент.ВыключенныеПроцессы).ИмеетДлину(1);
	Ожидаем.Что(Клиент.ВыключенныеПроцессы[0]).Равно(Процесс.Ид);
	Лог.ПроверитьЧтоВызывалсяМетод().Информация(
		"Кластер остановит выключенный процесс по истечении %1 с (expiration-timeout)", 60);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыключитьРабочийПроцесс_ПоUUIDБезУчетаРегистра() Экспорт

	// Дано
	ИБВКластере();
	Процесс = Клиент.ДобавитьПроцесс();

	// Когда
	Сервис.ВыключитьРабочийПроцесс(Параметры, ВРег(Процесс.Ид));

	// Тогда
	Ожидаем.Что(Клиент.ВыключенныеПроцессы[0]).Равно(Процесс.Ид);

КонецПроцедуры

&Тест
Процедура ТестДолжен_БроситьИсключение_ЕслиРабочийПроцессНеНайден() Экспорт

	// Дано
	ИБВКластере();
	Клиент.ДобавитьПроцесс("1");

	// Когда
	Ожидаем.Что(Сервис).Метод("ВыключитьРабочийПроцесс", ТестовыеДанные.Массив(Параметры, "999"))
		.ВыбрасываетИсключение("Рабочий процесс ""999"" не найден в кластере");

	// Тогда
	Ожидаем.Что(Клиент.ВыключенныеПроцессы).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_БроситьИсключение_ЕслиPidСовпалНаРазныхСерверах() Экспорт

	// Дано
	ИБВКластере();
	Первый = Клиент.ДобавитьПроцесс("7", "srv1");
	Второй = Клиент.ДобавитьПроцесс("7", "srv2");

	// Когда
	Текст = "";
	Попытка
		Сервис.ВыключитьРабочийПроцесс(Параметры, "7");
	Исключение
		Текст = ОписаниеОшибки();
	КонецПопытки;

	// Тогда - названы оба процесса, ничего не выключено
	Ожидаем.Что(Текст).Содержит(СтрШаблон("%1 (srv1)", Первый.Ид));
	Ожидаем.Что(Текст).Содержит(СтрШаблон("%1 (srv2)", Второй.Ид));
	Ожидаем.Что(Клиент.ВыключенныеПроцессы).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПредупредитьОНулевомПериодеПринудительногоЗавершения() Экспорт

	// Дано
	Лог = Стенд.Подменить("Лог", Мок.Следить(Логирование.ПолучитьЛог("vrunner")));
	ИБВКластере();
	Клиент.Кластеры()[0].ПериодПринудительногоЗавершения = 0;
	Клиент.ДобавитьПроцесс();

	// Когда
	Сервис.ВыключитьРабочийПроцесс(Параметры, "4242");

	// Тогда - процесс выключен, но остановки не будет
	Ожидаем.Что(Клиент.ВыключенныеПроцессы).ИмеетДлину(1);
	Лог.ПроверитьЧтоВызывалсяМетод().Предупреждение("Период принудительного завершения кластера (expiration-timeout) "
		+ "равен 0: выключенный процесс не будет остановлен, пока не вернутся его вызовы");

КонецПроцедуры

#КонецОбласти

