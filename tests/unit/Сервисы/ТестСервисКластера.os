// BSLLS-off
// Юнит-тесты СервисКластера: выбор кластера, создание и удаление ИБ, блокировки, завершение и ожидание
// сеансов, регламентные задания. irac подменён стабами УправлениеКластеромСтаб / КластерСтаб / ИнформационнаяБазаСтаб / СеансСтаб.

#Использовать asserts
#Использовать "../utils"

Перем Стенд;
Перем Сервис;
Перем Управление; // УправлениеКластеромСтаб: фабрика irac и список кластеров
Перем Параметры;  // параметры подключения к кластеру

&ПередКаждым
Процедура ПередКаждым() Экспорт
	Стенд = Новый Стенд;
	Управление = Стенд.Подменить("_ФабрикаУправленияКластером", Новый УправлениеКластеромСтаб);
	Сервис = Стенд.Сервис("СервисКластера");
	Параметры = Новый Структура("ВерсияПлатформы, АдресRAS, АдминистраторКластера, ПарольКластера",
		"8.3.20", "localhost:1545", "admin", "secret");
КонецПроцедуры

#Область ПодключениеККластеру

&Тест
Процедура ТестДолжен_БроситьИсключение_ЕслиКластеровНет() Экспорт

	Ожидаем.Что(Сервис).Метод("СоздатьИБ", ТестовыеДанные.Массив(Параметры, ПараметрыИБ()))
		.ВыбрасываетИсключение("Кластер серверов не найден");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыбратьКластер_ПоИмени() Экспорт

	// Дано
	Кластер1 = Новый КластерСтаб().СИменемИИд("A", "id-a");
	Кластер2 = Новый КластерСтаб().СИменемИИд("B", "id-b");
	Управление.ДобавитьКластер(Кластер1).ДобавитьКластер(Кластер2);
	Параметры.Вставить("ИмяКластера", "B");

	// Когда
	Сервис.СоздатьИБ(Параметры, ПараметрыИБ());

	// Тогда - ИБ добавлена именно в кластер B
	Ожидаем.Что(Кластер2.ДобавленныеИБ).ИмеетДлину(1);
	Ожидаем.Что(Кластер1.ДобавленныеИБ).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПередатьПутьRac_ВместоВерсии() Экспорт

	// Дано
	Управление.ДобавитьКластер(Новый КластерСтаб());
	Параметры.Вставить("ПутьRac", "bin/rac");

	// Когда
	Сервис.СоздатьИБ(Параметры, ПараметрыИБ());

	// Тогда - irac получает путь к rac, а не версию платформы
	Ожидаем.Что(Управление.ВерсияПлатформы).Равно("bin/rac");
	Ожидаем.Что(Управление.АдресRAS).Равно("localhost:1545");

КонецПроцедуры

&Тест
Процедура ТестДолжен_БроситьИсключение_ЕслиКластерПоИдНеНайден() Экспорт

	Управление.ДобавитьКластер(Новый КластерСтаб());
	Параметры.Вставить("ИдентификаторКластера", "не-существует");

	Ожидаем.Что(Сервис).Метод("СоздатьИБ", ТестовыеДанные.Массив(Параметры, ПараметрыИБ()))
		.ВыбрасываетИсключение("Кластер серверов не найден");

КонецПроцедуры

&Тест
Процедура ТестДолжен_УстановитьАдминистратораКластера_ИзПараметров() Экспорт

	// Дано
	Кластер = Новый КластерСтаб();
	Управление.ДобавитьКластер(Кластер);

	// Когда
	Сервис.СоздатьИБ(Параметры, ПараметрыИБ());

	// Тогда
	Ожидаем.Что(Кластер.АдминистраторКластера).Равно("admin");
	Ожидаем.Что(Кластер.ПарольКластера).Равно("secret");

КонецПроцедуры

#КонецОбласти

#Область СоздатьИБ

&Тест
Процедура ТестДолжен_СоздатьИБ_СПараметрамиСУБД() Экспорт

	// Дано
	Кластер = Новый КластерСтаб();
	Управление.ДобавитьКластер(Кластер);
	ПарИБ = ПараметрыИБ("test_db");
	ПарИБ.Вставить("ТипСУБД", "PostgreSQL");
	ПарИБ.Вставить("АдресСервераСУБД", "localhost");
	ПарИБ.Вставить("ИмяБазыСУБД", "test_db");
	ПарИБ.Вставить("ИмяПользователяБазыСУБД", "postgres");
	ПарИБ.Вставить("ПарольПользователяБазыСУБД", "pwd");
	ПарИБ.Вставить("Локализация", "en_US");
	ПарИБ.Вставить("СоздаватьБДСУБД", Ложь);

	// Когда
	Сервис.СоздатьИБ(Параметры, ПарИБ);

	// Тогда
	Ожидаем.Что(Кластер.ДобавленныеИБ).ИмеетДлину(1);
	Запись = Кластер.ДобавленныеИБ[0];
	Ожидаем.Что(Запись.Имя).Равно("test_db");
	Ожидаем.Что(Запись.Локализация).Равно("en_US");
	Ожидаем.Что(Запись.СоздаватьБД).ЭтоЛожь();
	Ожидаем.Что(Запись.Параметры.ТипСУБД).Равно("PostgreSQL");
	Ожидаем.Что(Запись.Параметры.АдресСервераСУБД).Равно("localhost");
	Ожидаем.Что(Запись.Параметры.ИмяПользователяБазыСУБД).Равно("postgres");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьИБ_СоЗначениямиПоУмолчанию() Экспорт

	// Дано
	Кластер = Новый КластерСтаб();
	Управление.ДобавитьКластер(Кластер);

	// Когда
	Сервис.СоздатьИБ(Параметры, ПараметрыИБ());

	// Тогда
	Запись = Кластер.ДобавленныеИБ[0];
	Ожидаем.Что(Запись.Локализация).Равно("ru_RU");
	Ожидаем.Что(Запись.СоздаватьБД).ЭтоИстина();
	Ожидаем.Что(Запись.Параметры.Свойство("БлокировкаРегламентныхЗаданийВключена")).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВключитьБлокировкуРегламентныхЗаданий_ПриФлаге() Экспорт

	// Дано
	Кластер = Новый КластерСтаб();
	Управление.ДобавитьКластер(Кластер);
	ПарИБ = ПараметрыИБ("x");
	ПарИБ.Вставить("БлокироватьРегламентныеЗадания", Истина);

	// Когда
	Сервис.СоздатьИБ(Параметры, ПарИБ);

	// Тогда
	Ожидаем.Что(Кластер.ДобавленныеИБ[0].Параметры.Свойство("БлокировкаРегламентныхЗаданийВключена")).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область УдалитьИБ

&Тест
Процедура ТестДолжен_УдалитьИБ_СДействиямиСБД() Экспорт

	// Дано
	ИБ = Новый ИнформационнаяБазаСтаб();
	Кластер = Новый КластерСтаб().СИБ("test", ИБ);
	Управление.ДобавитьКластер(Кластер);
	Параметры.Вставить("Пользователь", "u");
	Параметры.Вставить("Пароль", "p");

	// Когда
	Сервис.УдалитьИБ(Параметры, "test", "drop");

	// Тогда
	Ожидаем.Что(Кластер.УдаленныеИБ).ИмеетДлину(1);
	Ожидаем.Что(Кластер.УдаленныеИБ[0].Имя).Равно("test");
	Ожидаем.Что(Кластер.УдаленныеИБ[0].Действия).Равно("drop");
	Ожидаем.Что(ИБ.АдминистраторИБ).Равно("u");
	Ожидаем.Что(ИБ.ПарольИБ).Равно("p");

КонецПроцедуры

#КонецОбласти

#Область ИнформацияОбИБ

&Тест
Процедура ТестДолжен_ВернутьИБ_ИОбновитьЕё() Экспорт

	// Дано
	ИБ = ИБВКластере(Новый ИнформационнаяБазаСтаб());

	// Когда
	Факт = Сервис.ИнформацияОбИБ(Параметры, "test");

	// Тогда
	Ожидаем.Что(Факт).Равно(ИБ);
	Ожидаем.Что(ИБ.КоличествоОбновлений).Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_БроситьИсключение_ЕслиИБНеНайдена() Экспорт

	ИБВКластере(Новый ИнформационнаяБазаСтаб());

	Ожидаем.Что(Сервис).Метод("ИнформацияОбИБ", ТестовыеДанные.Массив(Параметры, "missing"))
		.ВыбрасываетИсключение("не найдена");

КонецПроцедуры

#КонецОбласти

#Область БлокировкаСеансов

&Тест
Процедура ТестДолжен_ЗаблокироватьСеансы_СПараметрамиБлокировки() Экспорт

	// Дано
	ИБ = ИБВКластере(Новый ИнформационнаяБазаСтаб());
	ПарБлок = Новый Структура("КодРазрешения, СообщениеБлокировки", "code123", "обслуживание");

	// Когда
	Сервис.ЗаблокироватьСеансы(Параметры, "test", ПарБлок);

	// Тогда
	Ожидаем.Что(ИБ.ПоследниеИзменения.БлокировкаСеансовВключена).Равно(Перечисления.СостоянияВыключателя.Включено);
	Ожидаем.Что(ИБ.ПоследниеИзменения.КодРазрешения).Равно("code123");
	Ожидаем.Что(ИБ.ПоследниеИзменения.СообщениеБлокировкиСеансов).Равно("обслуживание");

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазблокироватьСеансы() Экспорт

	// Дано
	ИБ = ИБВКластере(Новый ИнформационнаяБазаСтаб());

	// Когда
	Сервис.РазблокироватьСеансы(Параметры, "test");

	// Тогда
	Ожидаем.Что(ИБ.ПоследниеИзменения.БлокировкаСеансовВключена).Равно(Перечисления.СостоянияВыключателя.Выключено);

КонецПроцедуры

#КонецОбласти

#Область ЗавершитьСеансы

&Тест
Процедура ТестДолжен_ЗавершитьВсеСеансыИЗаблокироватьНовые() Экспорт

	// Дано
	Сеанс1 = Новый СеансСтаб();
	Сеанс2 = Новый СеансСтаб();
	ИБ = ИБСоСеансами(Сеанс1, Сеанс2);

	// Когда
	Сервис.ЗавершитьСеансы(Параметры, "test", Истина, Неопределено, БыстрыйПовтор());

	// Тогда - оба сеанса завершены, одна установка блокировки новых сеансов
	Ожидаем.Что(Сеанс1.Завершен).ЭтоИстина();
	Ожидаем.Что(Сеанс2.Завершен).ЭтоИстина();
	Ожидаем.Что(ИБ.ИзмененияВсего).ИмеетДлину(1);
	Ожидаем.Что(ИБ.ПоследниеИзменения.БлокировкаСеансовВключена).Равно(Перечисления.СостоянияВыключателя.Включено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗавершитьТолькоСеансыПоОтбору() Экспорт

	// Дано
	СеансДизайнера = Новый СеансСтаб().СоСвойством("app-id", "Designer");
	СеансКлиента = Новый СеансСтаб().СоСвойством("app-id", "1CV8");
	ИБСоСеансами(СеансДизайнера, СеансКлиента);
	Отбор = Новый ОтборСеансов().ДобавитьУсловиеПоПриложению("Designer");

	// Когда
	Сервис.ЗавершитьСеансы(Параметры, "test", Ложь, Отбор, БыстрыйПовтор());

	// Тогда
	Ожидаем.Что(СеансДизайнера.Завершен).ЭтоИстина();
	Ожидаем.Что(СеансКлиента.Завершен).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗавершитьОстальныеСеансы_НесмотряНаОшибкуОдного() Экспорт

	// Дано
	Сеанс1 = Новый СеансСтаб();
	Сеанс1.БроситьПриЗавершении = Истина;
	Сеанс2 = Новый СеансСтаб();
	ИБСоСеансами(Сеанс1, Сеанс2);

	// Когда - незавершаемый сеанс приводит к исключению после исчерпания попыток
	Ожидаем.Что(Сервис).Метод("ЗавершитьСеансы", ПараметрыЗавершения(БыстрыйПовтор()))
		.ВыбрасываетИсключение("Не удалось завершить сеансы");

	// Тогда - второй сеанс завершён, несмотря на ошибку первого
	Ожидаем.Что(Сеанс2.Завершен).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ДобитьЗависшийСеанс_ПовторнойПопыткой() Экспорт

	// Дано - сеанс "зависает" и завершается только со второй попытки
	Сеанс = Новый СеансСтаб().Зависший(2);
	ИБСоСеансами(Сеанс);

	// Когда
	Сервис.ЗавершитьСеансы(Параметры, "test", Ложь, Неопределено, БыстрыйПовтор());

	// Тогда
	Ожидаем.Что(Сеанс.Завершен).ЭтоИстина();
	Ожидаем.Что(Сеанс.ВызововЗавершения).Равно(2);

КонецПроцедуры

&Тест
Процедура ТестДолжен_БроситьИсключение_ПослеИсчерпанияПопыток() Экспорт

	// Дано - сеанс не завершается никогда
	Сеанс = Новый СеансСтаб().Зависший(99);
	ИБСоСеансами(Сеанс);

	// Когда
	Ожидаем.Что(Сервис).Метод("ЗавершитьСеансы", ПараметрыЗавершения(БыстрыйПовтор()))
		.ВыбрасываетИсключение("Не удалось завершить сеансы");

	// Тогда - 3 попытки по умолчанию
	Ожидаем.Что(Сеанс.ВызововЗавершения).Равно(3);

КонецПроцедуры

&Тест
Процедура ТестДолжен_УчестьЗаданноеКоличествоПопыток() Экспорт

	// Дано
	Сеанс = Новый СеансСтаб().Зависший(99);
	ИБСоСеансами(Сеанс);

	// Когда
	Ожидаем.Что(Сервис).Метод("ЗавершитьСеансы", ПараметрыЗавершения(БыстрыйПовтор(1)))
		.ВыбрасываетИсключение("Не удалось завершить сеансы");

	// Тогда
	Ожидаем.Что(Сеанс.ВызововЗавершения).Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПовторятьПоТаймауту_ИгнорируяЛимитПопыток() Экспорт

	// Дано - при заданном таймауте лимит попыток не действует
	Сеанс = Новый СеансСтаб().Зависший(99);
	ИБСоСеансами(Сеанс);
	Повтор = Новый Структура("ТаймаутСек, Попыток, ПаузаМс", 1, 1, 300);

	// Когда
	Ожидаем.Что(Сервис).Метод("ЗавершитьСеансы", ПараметрыЗавершения(Повтор))
		.ВыбрасываетИсключение("Не удалось завершить сеансы");

	// Тогда - попыток больше одной: лимит Попыток=1 проигнорирован в пользу таймаута
	Ожидаем.Что(Сеанс.ВызововЗавершения > 1).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ДождатьсяОтсутствияСеансов

&Тест
Процедура ТестДолжен_ВернутьПусто_ЕслиСеансовНет() Экспорт

	ИБВКластере(Новый ИнформационнаяБазаСтаб());

	Остались = Сервис.ДождатьсяОтсутствияСеансов(Параметры, "test");

	Ожидаем.Что(Остались).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьСеансыСразу_ПриНулевомТаймауте() Экспорт

	// Дано
	ИБСоСеансами(Новый СеансСтаб());

	// Когда - таймаут 0: одна проверка без ожидания
	Остались = Сервис.ДождатьсяОтсутствияСеансов(Параметры, "test", Неопределено, 0, 0);

	// Тогда
	Ожидаем.Что(Остались).ИмеетДлину(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ДождатьсяЗавершенияСеансов() Экспорт

	// Дано - на третьей проверке сеансов не остаётся
	СписокССеансом = ТестовыеДанные.Массив(Новый СеансСтаб());
	Очередь = ТестовыеДанные.Массив(СписокССеансом, СписокССеансом, Новый Массив);
	ИБВКластере(Новый ИнформационнаяБазаСтаб().ССеансамиПоВызовам(Очередь));

	// Когда
	Остались = Сервис.ДождатьсяОтсутствияСеансов(Параметры, "test", Неопределено, 60, 0);

	// Тогда
	Ожидаем.Что(Остались).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьСеансы_ПоТаймаутуОжидания() Экспорт

	// Дано - сеанс не завершается
	ИБСоСеансами(Новый СеансСтаб());

	// Когда
	Остались = Сервис.ДождатьсяОтсутствияСеансов(Параметры, "test", Неопределено, 1, 300);

	// Тогда
	Ожидаем.Что(Остались).ИмеетДлину(1);

КонецПроцедуры

#КонецОбласти

#Область СписокСоединений

&Тест
Процедура ТестДолжен_ВернутьСоединенияИБ() Экспорт

	// Дано
	Соединения = ТестовыеДанные.Массив(
		Новый СеансСтаб().СоСвойством("conn-id", "c1"),
		Новый СеансСтаб().СоСвойством("conn-id", "c2"));
	ИБВКластере(Новый ИнформационнаяБазаСтаб().ССоединениями(Соединения));

	// Когда
	Результат = Сервис.СписокСоединений(Параметры, "test");

	// Тогда
	Ожидаем.Что(Результат).ИмеетДлину(2);
	Ожидаем.Что(Результат[0].Получить("conn-id")).Равно("c1");

КонецПроцедуры

#КонецОбласти

#Область СписокСеансов

&Тест
Процедура ТестДолжен_ВернутьВсеСеансы_БезОтбора() Экспорт

	ИБСоСеансами(Новый СеансСтаб(), Новый СеансСтаб());

	Результат = Сервис.СписокСеансов(Параметры, "test");

	Ожидаем.Что(Результат).ИмеетДлину(2);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьСеансыПоОтбору_СИнверсией() Экспорт

	// Дано
	ИБСоСеансами(
		Новый СеансСтаб().СоСвойством("app-id", "Designer"),
		Новый СеансСтаб().СоСвойством("app-id", "1CV8"));
	Отбор = Новый ОтборСеансов().ДобавитьУсловиеПоПриложению("Designer").Инвертировать();

	// Когда
	Результат = Сервис.СписокСеансов(Параметры, "test", Отбор);

	// Тогда - все, кроме Designer
	Ожидаем.Что(Результат).ИмеетДлину(1);
	Ожидаем.Что(Результат[0].Получить("app-id")).Равно("1CV8");

КонецПроцедуры

#КонецОбласти

#Область РегламентныеЗадания

&Тест
Процедура ТестДолжен_ЗаблокироватьРегламентныеЗадания() Экспорт

	ИБ = ИБВКластере(Новый ИнформационнаяБазаСтаб());

	Сервис.ЗаблокироватьРегламентныеЗадания(Параметры, "test");

	Ожидаем.Что(ИБ.ПоследниеИзменения.БлокировкаРегламентныхЗаданийВключена)
		.Равно(Перечисления.СостоянияВыключателя.Включено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазблокироватьРегламентныеЗадания() Экспорт

	ИБ = ИБВКластере(Новый ИнформационнаяБазаСтаб());

	Сервис.РазблокироватьРегламентныеЗадания(Параметры, "test");

	Ожидаем.Что(ИБ.ПоследниеИзменения.БлокировкаРегламентныхЗаданийВключена)
		.Равно(Перечисления.СостоянияВыключателя.Выключено);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПараметрыИБ(Знач Имя = "test")
	Возврат Новый Структура("ИмяИБ", Имя);
КонецФункции

// ИБ "test" в единственном кластере стаба управления.
Функция ИБВКластере(Знач ИБ)
	Управление.ДобавитьКластер(Новый КластерСтаб().СИБ("test", ИБ));
	Возврат ИБ;
КонецФункции

Функция ИБСоСеансами(Знач Сеанс1, Знач Сеанс2 = Неопределено)
	Возврат ИБВКластере(Новый ИнформационнаяБазаСтаб().ССеансами(ТестовыеДанные.Массив(Сеанс1, Сеанс2)));
КонецФункции

// Параметры повтора без пауз - чтобы тесты не ждали реальные 3 секунды между попытками.
Функция БыстрыйПовтор(Знач Попыток = 3)
	Возврат Новый Структура("Попыток, ПаузаМс", Попыток, 0);
КонецФункции

// Аргументы ЗавершитьСеансы без блокировки новых сеансов и без отбора.
Функция ПараметрыЗавершения(Знач Повтор)
	Возврат ТестовыеДанные.Массив(Параметры, "test", Ложь, Неопределено, Повтор);
КонецФункции

#КонецОбласти
