	ИБВКластере();
	СеансИБ();

	// Когда
	Остались = Сервис.ДождатьсяОтсутствияСеансов(Параметры, "test", Неопределено, 1, 300);

	// Тогда
	Ожидаем.Что(Остались).ИмеетДлину(1);

КонецПроцедуры

#КонецОбласти

#Область СписокСоединений

&Тест
Процедура ТестДолжен_ВернутьСоединенияИБ_СПолямиRac() Экспорт

	// Дано
	ИБВКластере();
	Соединение = Клиент.ДобавитьСоединение(ИдБазы(), 5);
	Клиент.ДобавитьСоединение(ИдБазы());
	Клиент.ДобавитьСоединение("33333333-3333-3333-3333-333333333333");

	// Когда
	Результат = Сервис.СписокСоединений(Параметры, "test");

	// Тогда - соединения другой ИБ не попадают
	Ожидаем.Что(Результат).ИмеетДлину(2);
	Ожидаем.Что(Результат[0].Получить("connection")).Равно(Соединение.Ид);
	Ожидаем.Что(Результат[0].Получить("conn-id")).Равно(1);
	Ожидаем.Что(Результат[0].Получить("application")).Равно("1CV8C");
	Ожидаем.Что(Результат[0].Получить("host")).Равно("host1");
	Ожидаем.Что(Результат[0].Получить("session-number")).Равно(5);
	Ожидаем.Что(Результат[0].Получить("connected-at")).Равно(Соединение.Подключено);

КонецПроцедуры

#КонецОбласти

