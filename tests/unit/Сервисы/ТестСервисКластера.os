&Тест
Процедура ТестДолжен_РазорватьСоединениеКлиента_СЗавершённымСеансом() Экспорт

	// Дано - клиент жив, его соединение остаётся после завершения сеанса
	ИБВКластере();
	СеансИБ();
	Соединение = Клиент.ДобавитьСоединение(ИдБазы());
	Соединение.ИдПроцесса = Клиент.ДобавитьПроцесс().Ид;

	// Когда
	Сервис.ЗавершитьСеансы(Параметры, "test", Ложь, Неопределено, БыстрыйПовтор());

	// Тогда - соединение разорвано, процессы не выключались
	Ожидаем.Что(Клиент.РазорванныеСоединения).ИмеетДлину(1);
	Ожидаем.Что(Клиент.РазорванныеСоединения[0]).Равно(Соединение.Ид);
	Ожидаем.Что(Клиент.ВыключенныеПроцессы).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ДождатьсяРазорванногоСоединения_ПослеИсчезновенияСеансаВКонцеПаузы() Экспорт

	// Дано - сеанс исчезает к концу паузы, соединение его клиента разрывается уже на её границе
	ИБВКластере();
	Сеанс = ЗависшийСеанс();
	Сеанс.ИсчезнетПослеЧтений = 3;
	Клиент.ДобавитьСоединение(ИдБазы()).ИдПроцесса = Клиент.ДобавитьПроцесс().Ид;

	// Когда - единственная попытка
	Сервис.ЗавершитьСеансы(Параметры, "test", Ложь, Неопределено, Новый Структура("Попыток, ПаузаМс", 1, 1000));

	// Тогда - после разрыва ожидание продлено, соединение исчезло в той же попытке
	Ожидаем.Что(Клиент.РазорванныеСоединения).ИмеетДлину(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВойтиВИБ_ПередРазрывомСоединения() Экспорт

	// Дано
	ИБВКластере();
	Клиент.ДобавитьСоединение(ИдБазы()).ИдПроцесса = Клиент.ДобавитьПроцесс().Ид;
	Параметры.Вставить("Пользователь", "Администратор");
	Параметры.Вставить("Пароль", "secret");

	// Когда
	Сервис.ЗавершитьСеансы(Параметры, "test", Ложь, Неопределено, БыстрыйПовтор());

	// Тогда - разрыв выполнен от имени администратора ИБ
	Ожидаем.Что(Клиент.РазорванныеСоединения).ИмеетДлину(1);
	ВходыВИБ = Новый Массив;
	Для Каждого Запись Из Клиент.Аутентификации Цикл
		Если Запись.Кому = "База" Тогда
			ВходыВИБ.Добавить(Запись.Пользователь + "/" + Запись.Пароль);
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(ВходыВИБ).Содержит("Администратор/secret");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеВыключатьПроцессы_ЕслиРазрывНеУдался() Экспорт

	// Дано - сервер отказал в разрыве: соединение не признак зависшего вызова
	ИБВКластере();
	ПовисшееСоединение().БроситьПриРазрыве = Истина;

	// Когда
	Текст = ТекстИсключенияЗавершения(ПовторСПерезапуском());

	// Тогда - названа ошибка разрыва и что сделать, процессы не выключались
	Ожидаем.Что(Текст).Содержит("разрыв не удался: Недостаточно прав");
	Ожидаем.Что(Текст).Содержит("--db-user/--db-pwd");
	Ожидаем.Что(Клиент.ВыключенныеПроцессы).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеТрогатьСоединения_ПокаОстаютсяСеансы() Экспорт

	// Дано - у живого сеанса между вызовами соединение тоже без номера сеанса
	ИБВКластере();
	ЗависшийСеанс();
	ПовисшееСоединение();

	// Когда
	Текст = ТекстИсключенияЗавершения(БыстрыйПовтор());

	// Тогда - причина в сеансе, соединения не разрывались и не названы
	Ожидаем.Что(Текст).Содержит("осталось сеансов 1");
	Ожидаем.Что(Текст).Не_().Содержит("соединения без сеанса");
	Ожидаем.Что(Клиент.РазорванныеСоединения).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_БроситьИсключение_ЕслиОсталосьСоединениеБезСеанса() Экспорт

	// Дано
	ИБВКластере();
	Соединение = ПовисшееСоединение();

	// Когда
	Текст = ТекстИсключенияЗавершения(БыстрыйПовтор());

	// Тогда - соединение пробовали разорвать; оно и его рабочий процесс названы, процессы не выключались
	Ожидаем.Что(Текст).Содержит("Не удалось завершить сеансы");
	Ожидаем.Что(Текст).Содержит(СтрШаблон("%1 [1CV8C] %2, рабочий процесс pid 4242 (srv)", Соединение.Номер, Соединение.Хост));
	Ожидаем.Что(Текст).Содержит("--allow-rphost-restart");
	Ожидаем.Что(Текст).Содержит("vrunner cluster process turn-off --pid <pid>");
	Ожидаем.Что(Текст).Не_().Содержит("--db-user");
	Ожидаем.Что(Клиент.РазорванныеСоединения).ИмеетДлину(1);
	Ожидаем.Что(Клиент.ВыключенныеПроцессы).ИмеетДлину(0);

КонецПроцедуры

