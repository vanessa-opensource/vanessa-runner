Процедура ТестДолжен_ВернутьСеансыПоОтбору_СИнверсией() Экспорт

	// Дано
	ИБВКластере();
	СеансИБ("Designer");
	СеансИБ("1CV8");
	Отбор = Новый ОтборСеансов().ДобавитьУсловиеПоПриложению("Designer").Инвертировать();

	// Когда
	Результат = Сервис.СписокСеансов(Параметры, "test", Отбор);

	// Тогда - все, кроме Designer
	Ожидаем.Что(Результат).ИмеетДлину(1);
	Ожидаем.Что(Результат[0].Получить("app-id")).Равно("1CV8");

КонецПроцедуры

