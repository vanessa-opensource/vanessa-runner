#КонецОбласти

#Область БлокировкаСеансов

&Тест
Процедура ТестДолжен_ЗаблокироватьСеансы_СПараметрамиБлокировки() Экспорт

	// Дано
	ИБ = Новый ИнформационнаяБазаСтаб();
	Кластер = Новый КластерСтаб().СИБ("test", ИБ);
	Контекст = СобратьСервисСКластером(Кластер);

	ПарБлок = Новый Структура;
	ПарБлок.Вставить("КодРазрешения", "code123");
	ПарБлок.Вставить("СообщениеБлокировки", "обслуживание");

	// Когда
	Контекст.Сервис.ЗаблокироватьСеансы(Параметры, "test", ПарБлок);

	// Тогда
	Ожидаем.Что(ИБ.ПоследниеИзменения.КодРазрешения).Равно("code123");
	Ожидаем.Что(ИБ.ПоследниеИзменения.СообщениеБлокировкиСеансов).Равно("обслуживание");

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазблокироватьСеансы() Экспорт

	// Дано
	ИБ = Новый ИнформационнаяБазаСтаб();
	Кластер = Новый КластерСтаб().СИБ("test", ИБ);
	Контекст = СобратьСервисСКластером(Кластер);

	// Когда
	Контекст.Сервис.РазблокироватьСеансы(Параметры, "test");

	// Тогда
