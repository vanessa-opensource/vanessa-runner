	Ожидаем.Что(Результат).ИмеетДлину(2);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьСеанс_СПолямиRac() Экспорт

	// Дано
	ИБВКластере();
	Сеанс = СеансИБ("Designer", "Администратор");

	// Когда
	Результат = Сервис.СписокСеансов(Параметры, "test");

	// Тогда - session - UUID для завершения, session-id - номер
	Ожидаем.Что(Результат[0].Получить("session")).Равно(Сеанс.Ид);
	Ожидаем.Что(Результат[0].Получить("session-id")).Равно(1);
	Ожидаем.Что(Результат[0].Получить("app-id")).Равно("Designer");
	Ожидаем.Что(Результат[0].Получить("user-name")).Равно("Администратор");
	Ожидаем.Что(Результат[0].Получить("host")).Равно("host1");
	Ожидаем.Что(Результат[0].Получить("started-at")).Равно(Сеанс.Начало);
	Ожидаем.Что(Результат[0].Получить("last-active-at")).Равно(Сеанс.ПоследняяАктивность);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьСеансыПоОтбору_СИнверсией() Экспорт

	// Дано
	ИБВКластере();
	СеансИБ("Designer");
	СеансИБ("1CV8");
	Отбор = Новый ОтборСеансов().ДобавитьУсловиеПоПриложению("Designer").Инвертировать();

	// Когда
	Результат = Сервис.СписокСеансов(Параметры, "test", Отбор);

	// Тогда - все, кроме Designer
	Ожидаем.Что(Результат).ИмеетДлину(1);
	Ожидаем.Что(Результат[0].Получить("app-id")).Равно("1CV8");

КонецПроцедуры

#КонецОбласти

