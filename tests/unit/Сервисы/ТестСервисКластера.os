	ПарИБ.Вставить("ИмяИБ", "x");
	ПарИБ.Вставить("БлокироватьРегламентныеЗадания", Истина);

	// Когда
	Контекст.Сервис.СоздатьИБ(Параметры, ПарИБ);

	// Тогда
