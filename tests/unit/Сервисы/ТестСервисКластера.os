Процедура ТестДолжен_ВернутьСеансыСразу_ПриНулевомТаймауте() Экспорт

	// Дано
	ИБВКластере();
	СеансИБ();

	// Когда - таймаут 0: одна проверка без ожидания
	Остались = Сервис.ДождатьсяОтсутствияСеансов(Параметры, "test", Неопределено, 0, 0);

	// Тогда
	Ожидаем.Что(Остались).ИмеетДлину(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ДождатьсяЗавершенияСеансов() Экспорт

	// Дано - на третьей проверке сеансов не остаётся
	ИБВКластере();
	СеансИБ().ИсчезнетПослеЧтений = 2;

	// Когда
	Остались = Сервис.ДождатьсяОтсутствияСеансов(Параметры, "test", Неопределено, 60, 0);

	// Тогда
	Ожидаем.Что(Остались).ИмеетДлину(0);

КонецПроцедуры

