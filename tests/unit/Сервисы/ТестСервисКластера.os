	ИБВКластере();
	СеансДизайнера = СеансИБ("Designer");
	СеансКлиента = СеансИБ("1CV8");
	Отбор = Новый ОтборСеансов().ДобавитьУсловиеПоПриложению("Designer");

	// Когда
