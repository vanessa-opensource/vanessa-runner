КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПараметрыИБ(Знач Имя = "test")
	Возврат Новый Структура("ИмяИБ", Имя);
КонецФункции

Функция ИдБазы()
	Возврат "2222aaaa-2222-2222-2222-222222222222";
КонецФункции

// ИБ "test" в единственном кластере стаба; Инфо - поля поверх умолчаний стаба.
Процедура ИБВКластере(Знач Инфо = Неопределено)
	Клиент.СКластером("main", "11111111-1111-1111-1111-111111111111").СБазой("test", ИдБазы(), Инфо);
КонецПроцедуры

Функция СеансИБ(Знач Приложение = "1CV8C", Знач Пользователь = "")
	Возврат Клиент.ДобавитьСеанс(ИдБазы(), Приложение, Пользователь);
КонецФункции

Функция ЗависшийСеанс()
	Сеанс = СеансИБ();
	Сеанс.ЗавершитсяСПопытки = 99;
	Возврат Сеанс;
КонецФункции

Процедура ПроверитьВходВИБ(Знач Пользователь, Знач Пароль)
	Ожидаем.Что(Клиент.Аутентификации).ИмеетДлину(2);
	Ожидаем.Что(Клиент.Аутентификации[1].Кому).Равно("База");
	Ожидаем.Что(Клиент.Аутентификации[1].Пользователь).Равно(Пользователь);
	Ожидаем.Что(Клиент.Аутентификации[1].Пароль).Равно(Пароль);
КонецПроцедуры

// Параметры повтора без пауз - чтобы тесты не ждали реальные 3 секунды между попытками.
Функция БыстрыйПовтор(Знач Попыток = 3)
	Возврат Новый Структура("Попыток, ПаузаМс", Попыток, 0);
КонецФункции

// Соединение зависшего вызова: без сеанса и не разрывается; без Процесса - на новом процессе pid 4242 (srv).
Функция ПовисшееСоединение(Знач Процесс = Неопределено)
	Если Процесс = Неопределено Тогда
		Процесс = Клиент.ДобавитьПроцесс();
	КонецЕсли;
	Соединение = Клиент.ДобавитьСоединение(ИдБазы());
	Соединение.ИдПроцесса = Процесс.Ид;
	Соединение.Зависло = Истина;
	Возврат Соединение;
КонецФункции

Функция ПовторСПерезапуском()
	Возврат Новый Структура("Попыток, ПаузаМс, ПерезапускатьРабочиеПроцессы", 1, 0, Истина);
КонецФункции

// Текст исключения ЗавершитьСеансы без блокировки и отбора.
Функция ТекстИсключенияЗавершения(Знач Повтор)
	Попытка
		Сервис.ЗавершитьСеансы(Параметры, "test", Ложь, Неопределено, Повтор);
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
	ВызватьИсключение "ЗавершитьСеансы не выбросил исключение";
КонецФункции

// Аргументы ЗавершитьСеансы без блокировки новых сеансов и без отбора.
Функция ПараметрыЗавершения(Знач Повтор)
	Возврат ТестовыеДанные.Массив(Параметры, "test", Ложь, Неопределено, Повтор);
КонецФункции

#КонецОбласти
