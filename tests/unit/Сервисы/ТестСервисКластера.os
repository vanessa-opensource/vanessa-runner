// BSLLS-off
// Юнит-тесты СервисКластера.
// Покрытие всех публичных методов через стабы УправлениеКластером1С / Кластер / ИБ / Сеансы.

#Использовать asserts

#Использовать "../../../src/core/Сервисы"
#Использовать "../utils"

Перем Параметры;

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	Параметры = Новый Структура;
	Параметры.Вставить("ВерсияПлатформы", "8.3.20");
	Параметры.Вставить("АдресRAS", "localhost:1545");
	Параметры.Вставить("АдминистраторКластера", "admin");
	Параметры.Вставить("ПарольКластера", "secret");
КонецПроцедуры

Функция СобратьСервисСКластером(Кластер)
	Управление = Новый УправлениеКластеромСтаб();
	Управление.ДобавитьКластер(Кластер);
	Возврат Новый Структура("Сервис, Управление, Кластер",
		Новый БилдерСервисаКластера().СФабрикойУправления(Управление).Собрать(),
		Управление, Кластер);
КонецФункции

#Область Подключение

&Тест
Процедура ТестДолжен_БроситьИсключение_ЕслиКластеровНет() Экспорт

	// Дано
	Управление = Новый УправлениеКластеромСтаб();
	Сервис = Новый БилдерСервисаКластера().СФабрикойУправления(Управление).Собрать();
	ПарИБ = Новый Структура("ИмяИБ", "test");

	// Когда / Тогда
	Попытка
		Сервис.СоздатьИБ(Параметры, ПарИБ);
		ВызватьИсключение "должно было упасть";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("Кластер серверов не найден");
	КонецПопытки;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыбратьКластер_ПоИмени() Экспорт

	// Дано
	Кластер1 = Новый КластерСтаб().СИменемИИд("A", "id-a");
	Кластер2 = Новый КластерСтаб().СИменемИИд("B", "id-b");
	Управление = Новый УправлениеКластеромСтаб()
		.ДобавитьКластер(Кластер1)
		.ДобавитьКластер(Кластер2);
	Сервис = Новый БилдерСервисаКластера().СФабрикойУправления(Управление).Собрать();

	Параметры.Вставить("ИмяКластера", "B");
	ПарИБ = Новый Структура("ИмяИБ", "test");

	// Когда
	Сервис.СоздатьИБ(Параметры, ПарИБ);

	// Тогда — ИБ добавлена именно в кластер B
	Ожидаем.Что(Кластер2.ДобавленыеИБ.Количество()).Равно(1);
	Ожидаем.Что(Кластер1.ДобавленыеИБ.Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_БроситьИсключение_ЕслиКластерПоИдНеНайден() Экспорт

	// Дано
	Управление = Новый УправлениеКластеромСтаб().ДобавитьКластер(Новый КластерСтаб());
	Сервис = Новый БилдерСервисаКластера().СФабрикойУправления(Управление).Собрать();
	Параметры.Вставить("ИдентификаторКластера", "не-существует");

	// Когда / Тогда
	Попытка
		Сервис.СоздатьИБ(Параметры, Новый Структура("ИмяИБ", "test"));
		ВызватьИсключение "должно было упасть";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("Кластер серверов не найден");
	КонецПопытки;

КонецПроцедуры

&Тест
Процедура ТестДолжен_УстановитьАдминистратораКластера_ИзПараметров() Экспорт

	// Дано
	Кластер = Новый КластерСтаб();
	Контекст = СобратьСервисСКластером(Кластер);

	// Когда
	Контекст.Сервис.СоздатьИБ(Параметры, Новый Структура("ИмяИБ", "test"));

	// Тогда
	Ожидаем.Что(Кластер.АдминистраторКластера).Равно("admin");
	Ожидаем.Что(Кластер.ПарольКластера).Равно("secret");

КонецПроцедуры

#КонецОбласти

#Область СоздатьИБ

&Тест
Процедура ТестДолжен_СоздатьИБ_СПараметрамиСУБД() Экспорт

	// Дано
	Кластер = Новый КластерСтаб();
	Контекст = СобратьСервисСКластером(Кластер);

	ПарИБ = Новый Структура;
	ПарИБ.Вставить("ИмяИБ", "test_db");
	ПарИБ.Вставить("ТипСУБД", "PostgreSQL");
	ПарИБ.Вставить("АдресСервераСУБД", "localhost");
	ПарИБ.Вставить("ИмяБазыСУБД", "test_db");
	ПарИБ.Вставить("ИмяПользователяБазыСУБД", "postgres");
	ПарИБ.Вставить("ПарольПользователяБазыСУБД", "pwd");
	ПарИБ.Вставить("Локализация", "en_US");
	ПарИБ.Вставить("СоздаватьБДСУБД", Ложь);

	// Когда
	Контекст.Сервис.СоздатьИБ(Параметры, ПарИБ);

	// Тогда
	Ожидаем.Что(Кластер.ДобавленыеИБ.Количество()).Равно(1);
	Запись = Кластер.ДобавленыеИБ[0];
	Ожидаем.Что(Запись.Имя).Равно("test_db");
	Ожидаем.Что(Запись.Локализация).Равно("en_US");
	Ожидаем.Что(Запись.СоздаватьБД).ЭтоЛожь();
	Ожидаем.Что(Запись.Параметры.ТипСУБД).Равно("PostgreSQL");
	Ожидаем.Что(Запись.Параметры.АдресСервераСУБД).Равно("localhost");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьИБ_СоЗначениямиПоУмолчанию() Экспорт

	// Дано
	Кластер = Новый КластерСтаб();
	Контекст = СобратьСервисСКластером(Кластер);

	// Когда
	Контекст.Сервис.СоздатьИБ(Параметры, Новый Структура("ИмяИБ", "test"));

	// Тогда
	Запись = Кластер.ДобавленыеИБ[0];
	Ожидаем.Что(Запись.Локализация).Равно("ru_RU");
	Ожидаем.Что(Запись.СоздаватьБД).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВключитьБлокировкуРЗ_ПриФлаге() Экспорт

	// Дано
	Кластер = Новый КластерСтаб();
	Контекст = СобратьСервисСКластером(Кластер);

	ПарИБ = Новый Структура;
	ПарИБ.Вставить("ИмяИБ", "x");
	ПарИБ.Вставить("БлокироватьРегламентныеЗадания", Истина);

	// Когда
	Контекст.Сервис.СоздатьИБ(Параметры, ПарИБ);

	// Тогда
	Запись = Кластер.ДобавленыеИБ[0];
	Ожидаем.Что(Запись.Параметры.Свойство("БлокировкаРегламентныхЗаданийВключена")).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область УдалитьИБ

&Тест
Процедура ТестДолжен_УдалитьИБ_СДействиямиСБД() Экспорт

	// Дано
	ИБ = Новый ИнформационнаяБазаСтаб();
	Кластер = Новый КластерСтаб().СИБ("test", ИБ);
	Контекст = СобратьСервисСКластером(Кластер);
	Параметры.Вставить("Пользователь", "u");
	Параметры.Вставить("Пароль", "p");

	// Когда
	Контекст.Сервис.УдалитьИБ(Параметры, "test", "drop");

	// Тогда
	Ожидаем.Что(Кластер.УдаленныеИБ.Количество()).Равно(1);
	Ожидаем.Что(Кластер.УдаленныеИБ[0].Имя).Равно("test");
	Ожидаем.Что(Кластер.УдаленныеИБ[0].Действия).Равно("drop");
	Ожидаем.Что(ИБ.АдминистраторИБ).Равно("u");

КонецПроцедуры

#КонецОбласти

#Область ИнформацияОбИБ

&Тест
Процедура ТестДолжен_ВернутьИБ_ИОбновитьЕё() Экспорт

	// Дано
	ИБ = Новый ИнформационнаяБазаСтаб();
	Кластер = Новый КластерСтаб().СИБ("test", ИБ);
	Контекст = СобратьСервисСКластером(Кластер);

	// Когда
	Факт = Контекст.Сервис.ИнформацияОбИБ(Параметры, "test");

	// Тогда
	Ожидаем.Что(Факт).Равно(ИБ);
	Ожидаем.Что(ИБ.КоличествоОбновлений).Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_БроситьИсключение_ЕслиИБНеНайдена() Экспорт

	// Дано
	Кластер = Новый КластерСтаб();
	Контекст = СобратьСервисСКластером(Кластер);

	// Когда / Тогда
	Попытка
		Контекст.Сервис.ИнформацияОбИБ(Параметры, "missing");
		ВызватьИсключение "должно было упасть";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("не найдена");
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область БлокировкаСеансов

&Тест
Процедура ТестДолжен_ЗаблокироватьСеансы_СПараметрамиБлокировки() Экспорт

	// Дано
	ИБ = Новый ИнформационнаяБазаСтаб();
	Кластер = Новый КластерСтаб().СИБ("test", ИБ);
	Контекст = СобратьСервисСКластером(Кластер);

	ПарБлок = Новый Структура;
	ПарБлок.Вставить("КодРазрешения", "code123");
	ПарБлок.Вставить("СообщениеБлокировки", "обслуживание");

	// Когда
	Контекст.Сервис.ЗаблокироватьСеансы(Параметры, "test", ПарБлок);

	// Тогда
	Ожидаем.Что(ИБ.ПоследниеИзменения.КодРазрешения).Равно("code123");
	Ожидаем.Что(ИБ.ПоследниеИзменения.СообщениеБлокировкиСеансов).Равно("обслуживание");

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазблокироватьСеансы() Экспорт

	// Дано
	ИБ = Новый ИнформационнаяБазаСтаб();
	Кластер = Новый КластерСтаб().СИБ("test", ИБ);
	Контекст = СобратьСервисСКластером(Кластер);

	// Когда
	Контекст.Сервис.РазблокироватьСеансы(Параметры, "test");

	// Тогда
	Ожидаем.Что(ИБ.ПоследниеИзменения.Свойство("БлокировкаСеансовВключена")).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ЗавершитьСеансы

&Тест
Процедура ТестДолжен_ЗавершитьВсеСеансыИЗаблокироватьНовые() Экспорт

	// Дано
	Сеансы = Новый Массив;
	Сеансы.Добавить(Новый СеансСтаб());
	Сеансы.Добавить(Новый СеансСтаб());
	ИБ = Новый ИнформационнаяБазаСтаб().ССеансами(Сеансы);
	Кластер = Новый КластерСтаб().СИБ("test", ИБ);
	Контекст = СобратьСервисСКластером(Кластер);

	// Когда
	Контекст.Сервис.ЗавершитьСеансы(Параметры, "test");

	// Тогда
	Ожидаем.Что(Сеансы[0].Завершен).ЭтоИстина();
	Ожидаем.Что(Сеансы[1].Завершен).ЭтоИстина();
	// плюс одна установка БлокировкаСеансовВключена
	Ожидаем.Что(ИБ.ИзмененияВсего.Количество()).Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПропуститьОшибкуЗавершенияОдногоСеанса() Экспорт

	// Дано
	Сеанс1 = Новый СеансСтаб();
	Сеанс1.БроситьПриЗавершении = Истина;
	Сеанс2 = Новый СеансСтаб();
	Сеансы = Новый Массив;
	Сеансы.Добавить(Сеанс1);
	Сеансы.Добавить(Сеанс2);
	ИБ = Новый ИнформационнаяБазаСтаб().ССеансами(Сеансы);
	Кластер = Новый КластерСтаб().СИБ("test", ИБ);
	Контекст = СобратьСервисСКластером(Кластер);

	// Когда
	Контекст.Сервис.ЗавершитьСеансы(Параметры, "test", Ложь);

	// Тогда — второй сеанс должен завершиться, несмотря на ошибку первого
	Ожидаем.Что(Сеанс2.Завершен).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

