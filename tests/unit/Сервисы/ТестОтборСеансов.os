// BSLLS-off
// Юнит-тесты ОтборСеансов: условия по приложению/пользователю и проверка сеансов.

#Использовать asserts

#Использовать "../../../src/core/Сервисы"
#Использовать "../utils"

Функция Сеанс(Знач Приложение, Знач Пользователь = "")
	Возврат Новый СеансСтаб()
		.СоСвойством("app-id", Приложение)
		.СоСвойством("user-name", Пользователь);
КонецФункции

#Область ПустойОтбор

&Тест
Процедура ТестДолжен_ПропуститьЛюбойСеанс_ПриПустомОтборе() Экспорт

	Отбор = Новый ОтборСеансов;

	Ожидаем.Что(Отбор.Пустой()).ЭтоИстина();
	Ожидаем.Что(Отбор.СеансПодходит(Сеанс("Designer"))).ЭтоИстина();
	Ожидаем.Что(Отбор.СеансПодходит(Сеанс("1CV8", "Администратор"))).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область УсловияОтбора

&Тест
Процедура ТестДолжен_ОтобратьПоПриложению() Экспорт

	Отбор = Новый ОтборСеансов().ДобавитьУсловиеПоПриложению("Designer");

	Ожидаем.Что(Отбор.Пустой()).ЭтоЛожь();
	Ожидаем.Что(Отбор.СеансПодходит(Сеанс("Designer"))).ЭтоИстина();
	Ожидаем.Что(Отбор.СеансПодходит(Сеанс("1CV8"))).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_СравниватьБезУчетаРегистра() Экспорт

	Отбор = Новый ОтборСеансов().ДобавитьУсловиеПоПриложению("designer");

	Ожидаем.Что(Отбор.СеансПодходит(Сеанс("Designer"))).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазобратьНесколькоЗначенийЧерезТочкуСЗапятой() Экспорт

	Отбор = Новый ОтборСеансов().ДобавитьУсловиеПоПользователю("регламент;администратор");

	Ожидаем.Что(Отбор.СеансПодходит(Сеанс("1CV8", "регламент"))).ЭтоИстина();
	Ожидаем.Что(Отбор.СеансПодходит(Сеанс("1CV8", "администратор"))).ЭтоИстина();
	Ожидаем.Что(Отбор.СеансПодходит(Сеанс("1CV8", "оператор"))).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПринятьМассивЗначений() Экспорт

	Приложения = Новый Массив;
	Приложения.Добавить("1CV8");
	Приложения.Добавить("1CV8C");

	Отбор = Новый ОтборСеансов().ДобавитьУсловиеПоПриложению(Приложения);

	Ожидаем.Что(Отбор.СеансПодходит(Сеанс("1CV8C"))).ЭтоИстина();
	Ожидаем.Что(Отбор.СеансПодходит(Сеанс("WebClient"))).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОбъединитьУсловияПоИЛИ() Экспорт

	// --filter-app Designer --filter-name регламент
	Отбор = Новый ОтборСеансов()
		.ДобавитьУсловиеПоПриложению("Designer")
		.ДобавитьУсловиеПоПользователю("регламент");

	Ожидаем.Что(Отбор.СеансПодходит(Сеанс("Designer", "любой"))).ЭтоИстина();
	Ожидаем.Что(Отбор.СеансПодходит(Сеанс("1CV8", "регламент"))).ЭтоИстина();
	Ожидаем.Что(Отбор.СеансПодходит(Сеанс("1CV8", "оператор"))).ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область Инвертирование

&Тест
Процедура ТестДолжен_ИнвертироватьОтбор() Экспорт

	Отбор = Новый ОтборСеансов().ДобавитьУсловиеПоПриложению("Designer").Инвертировать();

	Ожидаем.Что(Отбор.СеансПодходит(Сеанс("Designer"))).ЭтоЛожь();
	Ожидаем.Что(Отбор.СеансПодходит(Сеанс("1CV8"))).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ОшибкиРазбора

&Тест
Процедура ТестДолжен_БроситьИсключение_ПриНедопустимомПриложении() Экспорт

	Попытка
		Отбор = Новый ОтборСеансов().ДобавитьУсловиеПоПриложению("NotAnApp");
		ВызватьИсключение "должно было упасть";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("Недопустимое значение --filter-app");
		Ожидаем.Что(ОписаниеОшибки()).Содержит("Designer");
	КонецПопытки;

КонецПроцедуры

&Тест
Процедура ТестДолжен_БроситьИсключение_ПриНедопустимомЗначенииВСписке() Экспорт

	Попытка
		Отбор = Новый ОтборСеансов().ДобавитьУсловиеПоПриложению("Designer;NotAnApp");
		ВызватьИсключение "должно было упасть";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("Недопустимое значение --filter-app");
	КонецПопытки;

КонецПроцедуры

&Тест
Процедура ТестДолжен_БроситьИсключение_ПриПустыхЗначениях() Экспорт

	Попытка
		Отбор = Новый ОтборСеансов().ДобавитьУсловиеПоПользователю("");
		ВызватьИсключение "должно было упасть";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("Не заданы значения");
	КонецПопытки;

КонецПроцедуры

#КонецОбласти
