// BSLLS-off
// Юнит-тесты СервисАвтономногоСервера: старт ibsrv (явный порт, подбор свободного, подключение к чужому),
// остановка, строка подключения, живость, чистые функции. ibcmdrunner.УправлениеАС - стаб УправлениеАССтаб или мок.

#Использовать asserts
#Использовать tempfiles
#Использовать "../utils"

Перем Стенд;
Перем Сервис;
Перем База; // параметры подключения к файловой ИБ

&ПередКаждым
Процедура ПередКаждым() Экспорт
	Стенд = Новый Стенд;
	Сервис = Стенд.Сервис("СервисАвтономногоСервера");
	Сервис.УстановитьТаймаутПодтвержденияЗапуска(0); // реального процесса нет - окно подтверждения старта не нужно
	База = ТестовыеДанные.Файловая("base");
КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт
	ВременныеФайлы.Удалить();
КонецПроцедуры

#Область ЗапуститьСервер_ПодборПорта

&Тест
Процедура ТестДолжен_ПодобратьСвободныйПорт_ПриЗанятыхКандидатах() Экспорт

	// Дано - первые два старта падают "порт занят", третий успешен
	Стаб = Стенд.Подменить("_МенеджерАС", Новый УправлениеАССтаб().СНеудачнымиСтартами(2));

	// Когда - порт не задан, режим авто-подбора
	Контекст = Сервис.ЗапуститьСервер(База);

	// Тогда - сделано 3 попытки старта, сервер в итоге поднят
	Ожидаем.Что(Стаб.КоличествоВызововЗапустить).Равно(3);
	Ожидаем.Что(Контекст.СтрокаПодключения).Содержит("/WS");

КонецПроцедуры

&Тест
Процедура ТестДолжен_УпастьПослеИсчерпанияПопыток_ЕслиВсеПортыЗаняты() Экспорт

	Стенд.Подменить("_МенеджерАС", Новый УправлениеАССтаб().СНеудачнымиСтартами(999));

	Ожидаем.Что(Сервис).Метод("ЗапуститьСервер", ТестовыеДанные.Массив(База))
		.ВыбрасываетИсключение("кандидаты-порты заняты");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПроброситьНеПортовуюОшибку_БезПовтора() Экспорт

	// Дано - менеджер падает с ошибкой, не связанной с портом
	Стаб = Стенд.Подменить("_МенеджерАС", Новый УправлениеАССтаб);
	Стаб.БроситьИсключениеПриСтарте_ = "Прочая ошибка";

	// Когда / Тогда - ошибка проброшена сразу, повторов нет
	Ожидаем.Что(Сервис).Метод("ЗапуститьСервер", ТестовыеДанные.Массив(База)).ВыбрасываетИсключение("Прочая ошибка");
	Ожидаем.Что(Стаб.КоличествоВызововЗапустить).Равно(1);

КонецПроцедуры

#КонецОбласти

#Область ЗапуститьСервер_ЯвныйПорт

&Тест
Процедура ТестДолжен_СтартоватьНаЯвномПорту_БезПеребора() Экспорт

	// Дано - старт успешен, явно задан порт
	Стаб = Стенд.Подменить("_МенеджерАС", Новый УправлениеАССтаб);
	ПараметрыАС = Сервис.НовыеПараметрыАС();
	ПараметрыАС.Порт = 9999;

	// Когда
	Контекст = Сервис.ЗапуститьСервер(База, Неопределено, ПараметрыАС);

	// Тогда - ровно одна попытка старта на заданном порту
	Ожидаем.Что(Стаб.КоличествоВызововЗапустить).Равно(1);
	Ожидаем.Что(Контекст.ПортHttp).Равно(9999);
	Ожидаем.Что(Контекст.СтрокаПодключения).Содержит("9999");

КонецПроцедуры

&Тест
Процедура ТестДолжен_БроситьИсключение_ЕслиЯвныйПортЗанят_БезПеребора() Экспорт

	// Дано - старт на явном порту падает "порт занят"
	Стаб = Стенд.Подменить("_МенеджерАС", Новый УправлениеАССтаб().СНеудачнымиСтартами(999));
	ПараметрыАС = Сервис.НовыеПараметрыАС();
	ПараметрыАС.Порт = 9999;

	// Когда / Тогда - исключение, перебора нет (ровно одна попытка)
	Ожидаем.Что(Сервис).Метод("ЗапуститьСервер", ТестовыеДанные.Массив(База, Неопределено, ПараметрыАС))
		.ВыбрасываетИсключение("порт 9999 занят");
	Ожидаем.Что(Стаб.КоличествоВызововЗапустить).Равно(1);

КонецПроцедуры

#КонецОбласти

#Область ЗапуститьСервер_Подключение

&Тест
Процедура ТестДолжен_ПодключитьсяКУжеЗапущенному_БезСтартаПроцесса() Экспорт

	// Дано - режим attach с явным портом
	Стаб = Стенд.Подменить("_МенеджерАС", Новый УправлениеАССтаб);

	// Когда - подключение не требует параметров подключения к файловой ИБ
	Контекст = Сервис.ЗапуститьСервер(Неопределено, Неопределено, ПараметрыПодключенияКСуществующему(8400));

	// Тогда - процесс не стартовал, строка подключения построена из порта
	Ожидаем.Что(Стаб.КоличествоВызововЗапустить).Равно(0);
	Ожидаем.Что(Контекст.ПортHttp).Равно(8400);
	Ожидаем.Что(Контекст.СтрокаПодключения).Равно("/WS http://localhost:8400/");

	// И - ОстановитьСервер не трогает чужой процесс
	Сервис.ОстановитьСервер();
	Ожидаем.Что(Стаб.Остановлен).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПостроитьПрямуюСтрокуПодключения_ВРежимеПодключения() Экспорт

	// Дано - режим attach с прямым соединением
	ПараметрыАС = ПараметрыПодключенияКСуществующему(8400);
	ПараметрыАС.ИспользоватьПрямоеСоединение = Истина;

	// Когда
	Контекст = Сервис.ЗапуститьСервер(Неопределено, Неопределено, ПараметрыАС);

	// Тогда
	Ожидаем.Что(Контекст.СтрокаПодключения).Равно("/S localhost:8400\DefAlias");

КонецПроцедуры

&Тест
Процедура ТестДолжен_БроситьИсключение_ЕслиПодключениеБезПорта() Экспорт

	Ожидаем.Что(Сервис)
		.Метод("ЗапуститьСервер", ТестовыеДанные.Массив(Неопределено, Неопределено, ПараметрыПодключенияКСуществующему(0)))
		.ВыбрасываетИсключение("обязателен порт");

КонецПроцедуры

#КонецОбласти

#Область ЗапуститьСервер_Валидации

&Тест
Процедура ТестДолжен_БроситьИсключение_ЕслиСерверУжеЗапущен() Экспорт

	Стенд.Подменить("_Запущен", Истина);

	Ожидаем.Что(Сервис).Метод("ЗапуститьСервер", ТестовыеДанные.Массив(База)).ВыбрасываетИсключение("уже запущен");

КонецПроцедуры

#КонецОбласти

#Область ОстановитьСервер

&Тест
Процедура ТестДолжен_ОстановитьМенеджерАС_ИУдалитьКаталогДанных() Экспорт

	// Дано - запущенный сервер с менеджером и каталогом данных
	КаталогДанных = Стенд.Подменить("_КаталогДанныхСервера", ВременныеФайлы.СоздатьКаталог());
	Менеджер = Стенд.Подменить("_МенеджерАС", Стенд.Мок("УправлениеАС"));
	Стенд.Подменить("_Запущен", Истина);

	// Когда
	Сервис.ОстановитьСервер();

	// Тогда
	Менеджер.ПроверитьЧтоВызывалсяМетод().Остановить();
	Ожидаем.Что(ТестовыеФайлы.Существует(КаталогДанных)).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеУпасть_ЕслиМенеджерБросаетПриОстановке() Экспорт

	// Дано
	Менеджер = Стенд.Подменить("_МенеджерАС", Стенд.Мок("УправлениеАС"));
	Менеджер.Когда().Остановить().ТогдаВыбрасываетИсключение("Сервер уже мёртв");
	Стенд.Подменить("_Запущен", Истина);

	// Когда - исключение менеджера не пробрасывается
	Сервис.ОстановитьСервер();

	// Тогда
	Менеджер.ПроверитьЧтоВызывалсяМетод().Остановить();

КонецПроцедуры

&Тест
Процедура ТестДолжен_БытьИдемпотентным_БезМенеджера() Экспорт

	// Когда / Тогда - повторная остановка незапущенного сервера не падает
	Сервис.ОстановитьСервер();
	Сервис.ОстановитьСервер();

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеОстанавливатьЧужойСервер_ВРежимеПодключения() Экспорт

	// Дано - сервис подключился к запущенному снаружи серверу (attach). Менеджер внедрён намеренно:
	// флаг-гард должен сработать раньше, чем остановка дойдёт до _МенеджерАС.
	Стаб = Стенд.Подменить("_МенеджерАС", Новый УправлениеАССтаб);
	Сервис.ЗапуститьСервер(Неопределено, Неопределено, ПараметрыПодключенияКСуществующему(8400));

	// Когда
	Сервис.ОстановитьСервер();

	// Тогда - чужой процесс ibsrv не остановлен (мы им не владеем)
	Ожидаем.Что(Стаб.Остановлен).ЭтоЛожь();

	// И - повторная остановка безопасна, чужой сервер по-прежнему не тронут
	Сервис.ОстановитьСервер();
	Ожидаем.Что(Стаб.Остановлен).ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область СтрокаПодключения

&Тест
Процедура ТестДолжен_ВернутьWS_ДляHttpРежима() Экспорт

	// Порты по умолчанию: http 8314
	Ожидаем.Что(Сервис.СтрокаПодключения()).Равно("/WS http://localhost:8314/");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьS_ДляПрямогоСоединения() Экспорт

	// Порты по умолчанию: прямое соединение 8341
	Стенд.Подменить("_ИспользоватьПрямоеСоединение", Истина);

	Ожидаем.Что(Сервис.СтрокаПодключения()).Равно("/S localhost:8341\DefAlias");

КонецПроцедуры

#КонецОбласти

#Область СерверЖив

&Тест
Процедура ТестДолжен_ВернутьЛожь_ЕслиСерверНеОтвечает_HttpРежим() Экспорт

	// Дано - на http-порту висит сокет, принимающий TCP, но не отвечающий по http
	// (имитация зависшего сервера: порт занят, но запрос не обслуживается).
	Порт = 8765;
	TCPСервер = Новый TCPСервер(Порт);
	TCPСервер.Запустить();

	Попытка
		Стенд.Подменить("_Сервер", Новый ЛокальныйСервер("localhost", Порт));

		// Когда / Тогда - http-запрос не получает ответа => таймаут => сервер мёртв
		Ожидаем.Что(Сервис.СерверЖив(1)).ЭтоЛожь();
	Исключение
		TCPСервер.Остановить();
		ВызватьИсключение;
	КонецПопытки;

	TCPСервер.Остановить();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьЛожь_ЕслиПортСвободен_HttpРежим() Экспорт

	// Дано - на http-порту никто не слушает
	Стенд.Подменить("_Сервер", Новый ЛокальныйСервер("localhost", 8766));

	// Когда / Тогда - http-запрос не доходит (порт свободен) => сервер мёртв
	Ожидаем.Что(Сервис.СерверЖив(1)).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПроверятьПрямойПорт_ВРежимеПрямогоСоединения() Экспорт

	// Дано - прямое соединение, слушаем именно прямой порт
	ПрямойПорт = 8767;
	TCPСервер = Новый TCPСервер(ПрямойПорт);
	TCPСервер.Запустить();

	Попытка
		Стенд.Подменить("_Сервер", Новый ЛокальныйСервер("localhost", 8768));
		Стенд.Подменить("_ПортПрямогоСоединения", ПрямойПорт);
		Стенд.Подменить("_ИспользоватьПрямоеСоединение", Истина);

		// Когда / Тогда - в прямом режиме значимый порт - прямой, он занят => жив
		Ожидаем.Что(Сервис.СерверЖив()).ЭтоИстина();
	Исключение
		TCPСервер.Остановить();
		ВызватьИсключение;
	КонецПопытки;

	TCPСервер.Остановить();

КонецПроцедуры

#КонецОбласти

#Область НовыеПараметрыАС

&Тест
Процедура ТестДолжен_ВернутьШаблонПараметровАС_СоВсемиВыключеннымиФлагами() Экспорт

	Параметры = Сервис.НовыеПараметрыАС();

	Ожидаем.Что(Параметры.ИспользоватьПрямоеСоединение).ЭтоЛожь();
	Ожидаем.Что(Параметры.ИспользоватьОтладку).ЭтоЛожь();
	Ожидаем.Что(Параметры.ПодключитьсяКСуществующему).ЭтоЛожь();
	Ожидаем.Что(Параметры.Порт).Равно(0);
	Ожидаем.Что(Параметры.АдресВнешнегоСервераОтладки).Равно("");

КонецПроцедуры

#КонецОбласти

#Область ЭтоФайловаяИБ

&Тест
Процедура ТестДолжен_ОпределитьФайловуюИБ_ПоПрефиксуF() Экспорт
	Ожидаем.Что(Сервис.ЭтоФайловаяИБ("/F""C:\base""")).ЭтоИстина();
	Ожидаем.Что(Сервис.ЭтоФайловаяИБ("  /f""C:\base"""), "регистр и пробелы").ЭтоИстина();
КонецПроцедуры

&Тест
Процедура ТестДолжен_НеСчитатьСервернуюИБ_Файловой() Экспорт
	Ожидаем.Что(Сервис.ЭтоФайловаяИБ("/S srv/base")).ЭтоЛожь();
КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьЛожь_ДляПустойСтроки() Экспорт
	Ожидаем.Что(Сервис.ЭтоФайловаяИБ("")).ЭтоЛожь();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Параметры АС для подключения к уже запущенному снаружи ibsrv на порту.
Функция ПараметрыПодключенияКСуществующему(Знач Порт)

	ПараметрыАС = Сервис.НовыеПараметрыАС();
	ПараметрыАС.ПодключитьсяКСуществующему = Истина;
	ПараметрыАС.Порт = Порт;

	Возврат ПараметрыАС;

КонецФункции

#КонецОбласти
