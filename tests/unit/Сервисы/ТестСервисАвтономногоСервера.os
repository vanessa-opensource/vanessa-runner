// BSLLS-off
// Юнит-тесты СервисАвтономногоСервера.
// Покрытие: чистые функции (НовыеПараметрыАС, ЭтоФайловаяИБ),
// СтрокаПодключения для http/прямого режима, ОстановитьСервер с моком _МенеджерАС,
// валидация ЗапуститьСервер при повторном запуске.

#Использовать asserts
#Использовать moskito
#Использовать tempfiles
#Использовать ibcmdrunner

#Использовать "../../../src/core/Сервисы"
#Использовать "../utils"

Перем Любое;

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	Любое = Матчеры.ЛюбоеЗначение();
КонецПроцедуры

#Область НовыеПараметрыАС

&Тест
Процедура ТестДолжен_ВернутьШаблонПараметровАС_СоВсемиВыключеннымиФлагами() Экспорт

	// Дано
	Сервис = Новый БилдерСервисаАвтономногоСервера().Собрать();

	// Когда
	Параметры = Сервис.НовыеПараметрыАС();

	// Тогда
	Ожидаем.Что(Параметры.ИспользоватьПрямоеСоединение).ЭтоЛожь();
	Ожидаем.Что(Параметры.ИспользоватьОтладку).ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область ЭтоФайловаяИБ

&Тест
Процедура ТестДолжен_ОпределитьФайловуюИБ_ПоПрефиксу_F() Экспорт
	Сервис = Новый БилдерСервисаАвтономногоСервера().Собрать();
	Ожидаем.Что(Сервис.ЭтоФайловаяИБ("/F""C:\base""")).ЭтоИстина();
	Ожидаем.Что(Сервис.ЭтоФайловаяИБ("  /f""C:\base""")).ЭтоИстина();
КонецПроцедуры

&Тест
Процедура ТестДолжен_НеСчитатьСервернуюИБ_Файловой() Экспорт
	Сервис = Новый БилдерСервисаАвтономногоСервера().Собрать();
	Ожидаем.Что(Сервис.ЭтоФайловаяИБ("/S srv/base")).ЭтоЛожь();
КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьЛожь_ДляПустойСтроки() Экспорт
	Сервис = Новый БилдерСервисаАвтономногоСервера().Собрать();
	Ожидаем.Что(Сервис.ЭтоФайловаяИБ("")).ЭтоЛожь();
КонецПроцедуры

#КонецОбласти

#Область СтрокаПодключения

&Тест
Процедура ТестДолжен_ВернутьWS_ДляHttpРежима() Экспорт

	// Дано
	Сервис = Новый БилдерСервисаАвтономногоСервера()
		.СПортами(8314, 8341)
		.Собрать();

	// Когда / Тогда
	Ожидаем.Что(Сервис.СтрокаПодключения()).Равно("/WS http://localhost:8314/");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьS_ДляПрямогоСоединения() Экспорт

	// Дано
	Сервис = Новый БилдерСервисаАвтономногоСервера()
		.СПортами(8314, 8341)
		.СПрямымСоединением()
		.Собрать();

	// Когда / Тогда
	Ожидаем.Что(Сервис.СтрокаПодключения()).Равно("/S localhost:8341\DefAlias");

КонецПроцедуры

#КонецОбласти

#Область ОстановитьСервер

&Тест
Процедура ТестДолжен_ОстановитьМенеджерАС_ИУдалитьКаталогДанных() Экспорт

	// Дано
	КаталогДанных = ВременныеФайлы.СоздатьКаталог();
	МокМенеджер = Мок.Получить(Новый УправлениеАС);

	Сервис = Новый БилдерСервисаАвтономногоСервера()
		.СМенеджеромАС(МокМенеджер)
		.СКаталогомДанных(КаталогДанных)
		.Запущенным()
		.Собрать();

	// Когда
	Сервис.ОстановитьСервер();

	// Тогда
	МокМенеджер.ПроверитьЧтоВызывалсяМетод().Остановить();
	Ожидаем.Что(Новый Файл(КаталогДанных).Существует()).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеУпасть_ЕслиМенеджерБросаетПриОстановке() Экспорт

	// Дано
	МокМенеджер = Мок.Получить(Новый УправлениеАС);
	МокМенеджер.Когда().Остановить().ТогдаВыбрасываетИсключение("Сервер уже мёртв");

	Сервис = Новый БилдерСервисаАвтономногоСервера()
		.СМенеджеромАС(МокМенеджер)
		.Запущенным()
		.Собрать();

	// Когда / Тогда — не должно выбрасывать
	Сервис.ОстановитьСервер();

КонецПроцедуры

&Тест
Процедура ТестДолжен_БытьИдемпотентным_БезМенеджера() Экспорт

	// Дано
	Сервис = Новый БилдерСервисаАвтономногоСервера().Собрать();

	// Когда / Тогда — не должно падать
	Сервис.ОстановитьСервер();

КонецПроцедуры

#КонецОбласти

#Область ЗапуститьСервер_Валидации

&Тест
Процедура ТестДолжен_БроситьИсключение_ЕслиСерверУжеЗапущен() Экспорт

	// Дано
	Сервис = Новый БилдерСервисаАвтономногоСервера().Запущенным().Собрать();

	// Когда / Тогда
	Попытка
		Сервис.ЗапуститьСервер(Новый Структура("КаталогБазы", "C:\b"));
		ВызватьИсключение "Должно было упасть";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("уже запущен");
	КонецПопытки;

КонецПроцедуры

#КонецОбласти
