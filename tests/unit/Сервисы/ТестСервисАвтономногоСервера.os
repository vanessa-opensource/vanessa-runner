#Область СерверЖив

&Тест
Процедура ТестДолжен_ВернутьЛожь_ЕслиСерверНеОтвечает_HttpРежим() Экспорт

	// Дано - на http-порту висит сокет, принимающий TCP, но НЕ отвечающий по http
	// (имитация зависшего сервера: порт занят, но запрос не обслуживается).
	Порт = 8765;
	TCPСервер = Новый TCPСервер(Порт);
	TCPСервер.Запустить();

	Попытка
		Сервис = Новый БилдерСервисаАвтономногоСервера()
			.СПортами(Порт, 8341)
			.Собрать();

		// Когда / Тогда - http-запрос не получает ответа => таймаут => сервер мёртв
		Ожидаем.Что(Сервис.СерверЖив(1)).ЭтоЛожь();
	Исключение
		TCPСервер.Остановить();
		ВызватьИсключение;
	КонецПопытки;

	TCPСервер.Остановить();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьЛожь_ЕслиПортСвободен_HttpРежим() Экспорт

	// Дано - на http-порту никто не слушает
	Сервис = Новый БилдерСервисаАвтономногоСервера()
		.СПортами(8766, 8341)
		.Собрать();

	// Когда / Тогда - http-запрос не доходит (порт свободен) => сервер мёртв
	Ожидаем.Что(Сервис.СерверЖив(1)).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПроверятьПрямойПорт_ВРежимеПрямогоСоединения() Экспорт

	// Дано - прямое соединение, слушаем именно прямой порт
	ПрямойПорт = 8767;
	TCPСервер = Новый TCPСервер(ПрямойПорт);
	TCPСервер.Запустить();

	Попытка
		Сервис = Новый БилдерСервисаАвтономногоСервера()
			.СПортами(8768, ПрямойПорт)
			.СПрямымСоединением()
			.Собрать();

		// Когда / Тогда - в прямом режиме значимый порт - прямой, он занят => жив
		Ожидаем.Что(Сервис.СерверЖив()).ЭтоИстина();
	Исключение
		TCPСервер.Остановить();
		ВызватьИсключение;
	КонецПопытки;

	TCPСервер.Остановить();

КонецПроцедуры

