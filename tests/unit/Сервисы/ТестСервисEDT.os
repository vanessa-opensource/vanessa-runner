#Область СоответствиеФормата

&Тест
Процедура ТестДолжен_ВыброситьОсмысленнуюОшибку_ФорматEdtНаКаталогеXML() Экспорт

	// --src-format edt на чистом XML-дампе - явная ошибка пользователя.
	Каталог = СоздатьКаталогXML();
	Сервис = СобратьСервис();

	Попытка
		Сервис.ПодготовитьXML(Каталог, ПараметрыИсходников("edt"));
		ВызватьИсключение "Должно было выброситься исключение";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("Указан формат исходников ""edt""");
	КонецПопытки;

	Ожидаем.Что(ФабрикаКоманды.СозданныеКоманды.Количество(), "1cedtcli не должен вызываться").Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ТрактоватьФорматXmlНаEDTКаталоге_КакPassthrough() Экспорт

	// Явный --src-format xml - осознанный override: EDT-конвертация не выполняется (passthrough).
	Каталог = СоздатьКаталогEDT();
	Сервис = СобратьСервис();

	Контекст = Сервис.ПодготовитьXML(Каталог, ПараметрыИсходников("xml"));

	Ожидаем.Что(Контекст.Путь).Равно(Каталог);
	Ожидаем.Что(Контекст.Временный).ЭтоЛожь();
	Ожидаем.Что(ФабрикаКоманды.СозданныеКоманды.Количество(), "1cedtcli не должен вызываться").Равно(0);

