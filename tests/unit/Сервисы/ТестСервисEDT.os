&Тест
Процедура ТестДолжен_ИспользоватьЯвныйПутьКCli_БезПоискаEDT() Экспорт

	// Дано - --edt-path задан; edtfind и PATH дали бы другие ответы
	ПоискEDT.Когда().НайтиИнформациюОEDT(Любое).ТогдаВыбрасываетИсключение("Не найдено ни одной установленной версии EDT");
	Окружение.Когда().НайтиВPATH(Любое).ТогдаВозвращает(ФайлCli());
	ЯвныйПуть = ФайлCli();
	Параметры = ТестовыеДанные.ПараметрыИсходников("edt");
	Параметры.ПутьКCli = ЯвныйПуть;

	// Когда
	Сервис.ПодготовитьXML(ТестовыеФайлы.КаталогEDT(), Параметры);

	// Тогда - путь взят как есть, ни edtfind, ни PATH не опрашивались
	Ожидаем.Что(ФабрикаКоманды.Последняя().ИмяКоманды, "запущен 1cedtcli по явному пути").Равно(ЯвныйПуть);
	Стенд.ПроверитьЧтоНеВызывался("ПоискEDT", "НайтиИнформациюОEDT");
	Стенд.ПроверитьЧтоНеВызывался("СервисОкружения", "НайтиВPATH");

КонецПроцедуры

