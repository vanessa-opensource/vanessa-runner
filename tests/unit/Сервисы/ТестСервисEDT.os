// BSLLS-off
// Юнит-тесты СервисEDT: формат каталога, XML как есть, экспорт/импорт EDT и внешних объектов,
// командная строка 1cedtcli, проверка validate, приоритет резолва пути к 1cedtcli.
// 1cedtcli подменена ФабрикаКомандыEDTСтаб, edtfind.ПоискEDT - мок, СервисОкружения - шпион (PATH пуст).

#Использовать asserts
#Использовать moskito
#Использовать tempfiles
#Использовать "../utils"

Перем Стенд;
Перем Сервис;
Перем ФабрикаКоманды; // ФабрикаКомандыEDTСтаб: пишет маркеры результата вместо запуска 1cedtcli
Перем ПоискEDT;       // мок edtfind.ПоискEDT, который сервис получает из фабрики
Перем Окружение;      // шпион СервисОкружения: НайтиВPATH по пресету пуст
Перем ПутьКCli;       // 1cedtcli, который «находит» edtfind
Перем Любое;

&ПередКаждым
Процедура ПередКаждым() Экспорт
	Стенд = Новый Стенд;
	Стенд.Реальный("ФайловыеОперации");
	Стенд.Реальный("СервисПоискаИсточников");
	ФабрикаКоманды = Стенд.Подменить("_ФабрикаКоманды", Новый ФабрикаКомандыEDTСтаб);
	ПоискEDT = Стенд.Мок("ПоискEDT");
	Стенд.Подменить("_ФабрикаПоискаEDT", Новый ФабрикаСтаб(ПоискEDT));
	Окружение = Стенд.Мок("СервисОкружения");
	Сервис = Стенд.Сервис("СервисEDT");
	Любое = Матчеры.ЛюбоеЗначение();
	// По умолчанию edtfind «находит» 1cedtcli по фиктивному пути - чтобы EDT-операции работали.
	ПутьКCli = ФайлCli();
	ПоискEDT.Когда().НайтиИнформациюОEDT(Любое).ТогдаВозвращает(Новый Структура("ПутьКcli", ПутьКCli));
КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт
	ВременныеФайлы.Удалить();
КонецПроцедуры

#Область ОпределитьФорматИсточника

&Тест
Процедура ТестДолжен_ОпределитьФормат_EDT_ПоProjectИMdo() Экспорт
	Ожидаем.Что(Сервис.ОпределитьФорматИсточника(ТестовыеФайлы.КаталогEDT())).Равно("edt");
КонецПроцедуры

&Тест
Процедура ТестДолжен_ОпределитьФормат_XML_ПоConfigurationXml() Экспорт
	Ожидаем.Что(Сервис.ОпределитьФорматИсточника(ТестовыеФайлы.КаталогXML())).Равно("xml");
КонецПроцедуры

&Тест
Процедура ТестДолжен_ОпределитьФормат_EDT_ВложенныйПроект() Экспорт

	Родитель = ВременныеФайлы.СоздатьКаталог();
	ПроектEDT(Родитель, "MyProject");

	Ожидаем.Что(Сервис.ОпределитьФорматИсточника(Родитель)).Равно("edt");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыброситьОшибку_ЕслиНесколькоEDTПроектов() Экспорт

	Родитель = ВременныеФайлы.СоздатьКаталог();
	ПроектEDT(Родитель, "Проект1");
	ПроектEDT(Родитель, "Проект2");

	Ожидаем.Что(Сервис).Метод("ОпределитьФорматИсточника", ТестовыеДанные.Массив(Родитель))
		.ВыбрасываетИсключение("несколько EDT-проектов");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОпределитьФормат_XML_ПоУмолчанию() Экспорт
	// Каталог без маркеров EDT и без Configuration.xml трактуется как XML.
	Ожидаем.Что(Сервис.ОпределитьФорматИсточника(ВременныеФайлы.СоздатьКаталог())).Равно("xml");
КонецПроцедуры

#КонецОбласти

#Область ТипВнешнегоОбъекта

&Тест
Процедура ТестДолжен_ОпределитьТипВнешнегоОбъекта_ПоКорневомуТегу() Экспорт

	Каталог = ВременныеФайлы.СоздатьКаталог();
	ФайлEpf = ТестовыеФайлы.Файл(Каталог, "Обработка.xml", "<ExternalDataProcessor uuid=""1""/>");
	ФайлErf = ТестовыеФайлы.Файл(Каталог, "Отчет.xml", "<externalReport UUID=""2""/>");
	ФайлПрочий = ТестовыеФайлы.Файл(Каталог, "Форма.xml", "<Form uuid=""3""/>");

	Ожидаем.Что(Сервис.ТипВнешнегоОбъекта(ФайлEpf)).Равно("epf");
	Ожидаем.Что(Сервис.ТипВнешнегоОбъекта(ФайлErf), "регистр тега не важен").Равно("erf");
	Ожидаем.Что(Сервис.ТипВнешнегоОбъекта(ФайлПрочий), "не внешний объект").Равно("");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОпределитьТипВнешнегоОбъекта_ФайлОткрытДругимЧитателем() Экспорт

	ФайлEpf = ТестовыеФайлы.Файл(ВременныеФайлы.СоздатьКаталог(), "Обработка.xml", "<ExternalDataProcessor uuid=""1""/>");

	Поток = Новый ФайловыйПоток(ФайлEpf, РежимОткрытияФайла.Открыть, ДоступКФайлу.Чтение);
	ТипОбъекта = Сервис.ТипВнешнегоОбъекта(ФайлEpf);
	Поток.Закрыть();

	Ожидаем.Что(ТипОбъекта).Равно("epf");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОпределитьТипВыгруженногоОбъекта_ПоКаталогуРаскладки() Экспорт

	// Тег без uuid не распознаётся - тип берётся из имени каталога раскладки export.
	Каталог = ВременныеФайлы.СоздатьКаталог();
	ФайлОтчета = ТестовыеФайлы.Файл(Каталог, "ExternalReports/Отчет.xml", "<ExternalReport/>");
	ФайлОбработки = ТестовыеФайлы.Файл(Каталог, "ExternalDataProcessors/Обработка.xml", "<ExternalDataProcessor/>");

	Ожидаем.Что(Сервис.ТипВыгруженногоВнешнегоОбъекта(ФайлОтчета)).Равно("erf");
	Ожидаем.Что(Сервис.ТипВыгруженногоВнешнегоОбъекта(ФайлОбработки)).Равно("epf");

КонецПроцедуры

#КонецОбласти

#Область Конвертировать

&Тест
Процедура ТестДолжен_ВыброситьОшибку_ЕслиКаталогИсточникаНеНайден() Экспорт

	Каталог = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "несуществующий");
	Назначение = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "out");

	Ожидаем.Что(Сервис).Метод("Конвертировать", ТестовыеДанные.Массив(Каталог, Назначение))
		.ВыбрасываетИсключение("не найден");

КонецПроцедуры

&Тест
Процедура ТестДолжен_Конвертировать_EDT_ВXML() Экспорт

	КаталогEDT = ТестовыеФайлы.КаталогEDT();
	Назначение = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "xml-out");

	Результат = Сервис.Конвертировать(КаталогEDT, Назначение);

	Ожидаем.Что(Результат.ИсходныйФормат).Равно("edt");
	Ожидаем.Что(Результат.ЦелевойФормат).Равно("xml");
	Ожидаем.Что(ФабрикаКоманды.Последняя().ЗначениеПослеКлюча("-command")).Равно("export");
	Ожидаем.Что(ТестовыеФайлы.Существует(ОбъединитьПути(Назначение, "Configuration.xml")),
		"в каталоге назначения создан Configuration.xml").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_Конвертировать_XML_ВEDT() Экспорт

	КаталогXML = ТестовыеФайлы.КаталогXML();
	Назначение = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "edt-out");

	Результат = Сервис.Конвертировать(КаталогXML, Назначение);

	Ожидаем.Что(Результат.ИсходныйФормат).Равно("xml");
	Ожидаем.Что(Результат.ЦелевойФормат).Равно("edt");
	Ожидаем.Что(ФабрикаКоманды.Последняя().ЗначениеПослеКлюча("-command")).Равно("import");
	Ожидаем.Что(ТестовыеФайлы.Существует(ОбъединитьПути(Назначение, ".project")),
		"в каталоге назначения создан .project").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыброситьОшибку_ЕслиКонвертацияНеОпределилаТип() Экспорт

	Каталог = ВременныеФайлы.СоздатьКаталог();
	Назначение = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "out");

	Ожидаем.Что(Сервис).Метод("Конвертировать", ТестовыеДанные.Массив(Каталог, Назначение))
		.ВыбрасываетИсключение("Не удалось определить тип исходников");
	ПроверитьЧто1cedtcliНеЗапускалась();

КонецПроцедуры

#КонецОбласти

#Область ПодготовитьИсходники

&Тест
Процедура ТестДолжен_ВернутьEDTКакЕсть_ПриЦелевомФорматеEdt() Экспорт

	Каталог = ТестовыеФайлы.КаталогEDT();

	Контекст = Сервис.ПодготовитьИсходники(Каталог, "edt", ТестовыеДанные.ПараметрыИсходников("auto"));

	Ожидаем.Что(Контекст.Путь).Равно(Каталог);
	Ожидаем.Что(Контекст.Временный).ЭтоЛожь();
	ПроверитьЧто1cedtcliНеЗапускалась();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИмпортироватьXMLВоВременныйEDT() Экспорт

	Каталог = ТестовыеФайлы.КаталогXML();

	Контекст = Сервис.ПодготовитьИсходники(Каталог, "edt", ТестовыеДанные.ПараметрыИсходников("auto"));

	Ожидаем.Что(Контекст.Временный, "результат импорта - временный проект").ЭтоИстина();
	Ожидаем.Что(Контекст.ЭтоEDT).ЭтоЛожь();
	Ожидаем.Что(Контекст.КаталогEDT).Равно("");
	Ожидаем.Что(ТестовыеФайлы.Существует(ОбъединитьПути(Контекст.Путь, ".project")),
		"во временном каталоге создан .project").ЭтоИстина();
	Ожидаем.Что(Новый Файл(Контекст.Путь).Имя, "проект назван как каталог исходников")
		.Равно(Новый Файл(Каталог).Имя);
	Команда = ФабрикаКоманды.Последняя();
	Ожидаем.Что(Команда.ЗначениеПослеКлюча("-command")).Равно("import");
	Ожидаем.Что(Команда.ЗначениеПослеКлюча("--configuration-files")).Равно(Каталог);
	Ожидаем.Что(Команда.ЗначениеПослеКлюча("--project")).Равно(Контекст.Путь);

	Сервис.ЗавершитьИсходники(Контекст);
	Ожидаем.Что(ТестовыеФайлы.Существует(Контекст.ВременныйКаталог), "временный каталог удалён").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_УдалитьВременныйКаталог_ЕслиИмпортНеСоздалПроект() Экспорт

	ФабрикаКоманды.ЭмулироватьУспех = Ложь;
	Параметры = ТестовыеДанные.Массив(ТестовыеФайлы.КаталогXML(), "edt", ТестовыеДанные.ПараметрыИсходников("auto"));

	Ожидаем.Что(Сервис).Метод("ПодготовитьИсходники", Параметры).ВыбрасываетИсключение("не создал проект");

	ПутьПроекта = ФабрикаКоманды.Последняя().ЗначениеПослеКлюча("--project");
	Ожидаем.Что(ТестовыеФайлы.Существует(Новый Файл(ПутьПроекта).Путь), "временный каталог удалён").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыброситьОшибку_ЕслиНетXMLВыгрузкиДляКонвертацииВEDT() Экспорт

	Параметры = ТестовыеДанные.Массив(ВременныеФайлы.СоздатьКаталог(), "edt", ТестовыеДанные.ПараметрыИсходников("auto"));

	Ожидаем.Что(Сервис).Метод("ПодготовитьИсходники", Параметры).ВыбрасываетИсключение("нет XML-выгрузки Конфигуратора");
	ПроверитьЧто1cedtcliНеЗапускалась();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыброситьОшибку_ФорматXmlНаEDTКаталоге_ПриЦелевомEdt() Экспорт

	Параметры = ТестовыеДанные.Массив(ТестовыеФайлы.КаталогEDT(), "edt", ТестовыеДанные.ПараметрыИсходников("xml"));

	Ожидаем.Что(Сервис).Метод("ПодготовитьИсходники", Параметры).ВыбрасываетИсключение("нет XML-выгрузки Конфигуратора");
	ПроверитьЧто1cedtcliНеЗапускалась();

КонецПроцедуры

&Тест
Процедура ТестДолжен_СчитатьИсходникиГотовыми_БезПараметров() Экспорт

	Каталог = ТестовыеФайлы.КаталогXML();

	Контекст = Сервис.ПодготовитьИсходники(Каталог, "edt", Неопределено);

	Ожидаем.Что(Контекст.Путь).Равно(Каталог);
	Ожидаем.Что(Контекст.Временный).ЭтоЛожь();
	ПроверитьЧто1cedtcliНеЗапускалась();

