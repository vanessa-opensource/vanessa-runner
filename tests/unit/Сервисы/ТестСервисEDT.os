КонецПроцедуры

#КонецОбласти

#Область КоманднаяСтрока1cedtcli

&Тест
Процедура ТестДолжен_ПроброситьТаймаутВ1cedtcli_ДоКлючаCommand() Экспорт

	Параметры = ТестовыеДанные.ПараметрыИсходников("edt");
	Параметры.Таймаут = 5400;

	Сервис.ПодготовитьXML(ТестовыеФайлы.КаталогEDT(), Параметры);

	Команда = ФабрикаКоманды.Последняя();
	Ожидаем.Что(Команда.ЗначениеПослеКлюча("-timeout"), "значение таймаута без разделителя групп").Равно("5400");
	Ожидаем.Что(Раньше(Команда, "-timeout", "-command"), "-timeout предшествует -command").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеДобавлятьТаймаут_ЕслиНеЗадан() Экспорт

	Сервис.ПодготовитьXML(ТестовыеФайлы.КаталогEDT(), ТестовыеДанные.ПараметрыИсходников("edt"));

	Ожидаем.Что(ФабрикаКоманды.Последняя().СодержитАргумент("-timeout"), "без опции таймаут не пробрасывается").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПроброситьТаймаутВПроверкуEDT() Экспорт

	Параметры = ТестовыеДанные.ПараметрыИсходников("edt");
	Параметры.Таймаут = 120;

	Сервис.Проверить(ТестовыеФайлы.КаталогEDT(), Параметры);

	Команда = ФабрикаКоманды.Последняя();
	Ожидаем.Что(Команда.ЗначениеПослеКлюча("-timeout")).Равно("120");
	Ожидаем.Что(Раньше(Команда, "-timeout", "-command"), "-timeout предшествует -command").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПроброситьVmargsВ1cedtcli_ПередКомандой() Экспорт

	// По документации 1C:EDT CLI -vmargs должен идти перед -command.
	Параметры = ТестовыеДанные.ПараметрыИсходников("edt");
	Параметры.VmАргументы = ТестовыеДанные.Массив("-Xmx8g", "-XX:+UseG1GC");

	Сервис.ПодготовитьXML(ТестовыеФайлы.КаталогEDT(), Параметры);

	Команда = ФабрикаКоманды.Последняя();
	Ожидаем.Что(Команда.СодержитАргумент("-vmargs")).ЭтоИстина();
	Ожидаем.Что(Команда.СодержитАргумент("-Xmx8g")).ЭтоИстина();
	Ожидаем.Что(Команда.СодержитАргумент("-XX:+UseG1GC")).ЭтоИстина();
	Ожидаем.Что(Раньше(Команда, "-vmargs", "-command"), "-vmargs идёт перед -command").ЭтоИстина();
	Ожидаем.Что(Раньше(Команда, "-Xmx8g", "-command"), "JVM-аргументы идут до -command").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеДобавлятьVmargs_ЕслиНеЗаданы() Экспорт

	Сервис.ПодготовитьXML(ТестовыеФайлы.КаталогEDT(), ТестовыеДанные.ПараметрыИсходников("edt"));

	Ожидаем.Что(ФабрикаКоманды.Последняя().СодержитАргумент("-vmargs"), "без опции vmargs не пробрасывается").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_РаздробитьVmargsПоПробелу_ВнутриЭлемента() Экспорт

	Параметры = ТестовыеДанные.ПараметрыИсходников("edt");
	Параметры.VmАргументы = ТестовыеДанные.Массив("-Xmx8g -Xms512m");

	Сервис.ПодготовитьXML(ТестовыеФайлы.КаталогEDT(), Параметры);

	Команда = ФабрикаКоманды.Последняя();
	Ожидаем.Что(Команда.СодержитАргумент("-Xmx8g"), "первый токен из элемента с пробелом").ЭтоИстина();
	Ожидаем.Что(Команда.СодержитАргумент("-Xms512m"), "второй токен из элемента с пробелом").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПроброситьVmargsВПроверкуEDT_ПередКомандой() Экспорт

	Параметры = ТестовыеДанные.ПараметрыИсходников("edt");
	Параметры.VmАргументы = ТестовыеДанные.Массив("-Xmx2g");

	Сервис.Проверить(ТестовыеФайлы.КаталогEDT(), Параметры);

	Команда = ФабрикаКоманды.Последняя();
	Ожидаем.Что(Команда.СодержитАргумент("-Xmx2g"), "vmargs пробрасываются и в команду validate").ЭтоИстина();
	Ожидаем.Что(Раньше(Команда, "-vmargs", "-command"), "-vmargs перед -command и в validate").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Фиктивный исполняемый файл 1cedtcli в новом временном каталоге.
Функция ФайлCli(Знач ИмяФайла = "1cedtcli.exe")
	Возврат ТестовыеФайлы.Файл(ВременныеФайлы.СоздатьКаталог(), ИмяФайла, "stub");
КонецФункции

// Маркеры EDT-проекта во вложенном каталоге родителя.
Процедура ПроектEDT(Знач Родитель, Знач Имя)
	ТестовыеФайлы.Файл(Родитель, Имя + "/.project");
	ТестовыеФайлы.Файл(Родитель, Имя + "/src/Configuration/Configuration.mdo");
КонецПроцедуры

// Истина, если в аргументах команды Ключ стоит раньше ДругогоКлюча.
Функция Раньше(Знач Команда, Знач Ключ, Знач ДругойКлюч)
	Возврат Команда.Параметры.Найти(Ключ) < Команда.Параметры.Найти(ДругойКлюч);
КонецФункции

Процедура ПроверитьЧто1cedtcliНеЗапускалась()
	Ожидаем.Что(ФабрикаКоманды.СозданныеКоманды, "1cedtcli не должна вызываться").ИмеетДлину(0);
КонецПроцедуры

#КонецОбласти
