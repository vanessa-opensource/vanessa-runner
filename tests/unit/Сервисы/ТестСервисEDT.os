// BSLLS-off
// Юнит-тесты СервисEDT.
// Реальная 1cedtcli и edtfind не вызываются - запуск процесса и поиск EDT замоканы стабами.
// Покрытие: определение формата каталога, XML-passthrough, экспорт/импорт EDT,
// формирование командной строки 1cedtcli, проверка результата при тихом сбое,
// приоритет резолва пути (явный путь / edtfind / отсутствие).

#Использовать asserts
#Использовать tempfiles

#Использовать "../../../src/core/Сервисы"
#Использовать "../utils"

Перем ФабрикаКоманды;
Перем ФабрикаПоиска;

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	ФабрикаКоманды = Новый ФабрикаКомандыEDTСтаб;
	ФабрикаПоиска = Новый ФабрикаПоискаEDTСтаб;
	// По умолчанию edtfind «находит» 1cedtcli по фиктивному пути - чтобы EDT-операции работали.
	ФабрикаПоиска.Поиск.ПутьКcli = СоздатьФайлCli();
КонецПроцедуры

#Область ОпределениеФормата

&Тест
Процедура ТестДолжен_ОпределитьФормат_EDT_ПоProjectИMdo() Экспорт

	Каталог = СоздатьКаталогEDT();
	Сервис = СобратьСервис();

	Ожидаем.Что(Сервис.ОпределитьФорматИсточника(Каталог)).Равно("edt");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОпределитьФормат_XML_ПоConfigurationXml() Экспорт

	Каталог = СоздатьКаталогXML();
	Сервис = СобратьСервис();

	Ожидаем.Что(Сервис.ОпределитьФорматИсточника(Каталог)).Равно("xml");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОпределитьФормат_EDT_ВложенныйПроект() Экспорт

	Родитель = ВременныеФайлы.СоздатьКаталог();
	СоздатьСтруктуруEDT(ОбъединитьПути(Родитель, "MyProject"));
	Сервис = СобратьСервис();

	Ожидаем.Что(Сервис.ОпределитьФорматИсточника(Родитель)).Равно("edt");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыброситьОшибку_ЕслиНесколькоEDTПроектов() Экспорт

	Родитель = ВременныеФайлы.СоздатьКаталог();
	СоздатьСтруктуруEDT(ОбъединитьПути(Родитель, "Проект1"));
	СоздатьСтруктуруEDT(ОбъединитьПути(Родитель, "Проект2"));
	Сервис = СобратьСервис();

	Попытка
		Сервис.ОпределитьФорматИсточника(Родитель);
		ВызватьИсключение "Должно было выброситься исключение";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("несколько EDT-проектов");
	КонецПопытки;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОпределитьФормат_XML_ПоУмолчанию() Экспорт

	// Каталог без маркеров EDT и без Configuration.xml -> трактуется как XML.
	Каталог = ВременныеФайлы.СоздатьКаталог();
	Сервис = СобратьСервис();

	Ожидаем.Что(Сервис.ОпределитьФорматИсточника(Каталог)).Равно("xml");

КонецПроцедуры

#КонецОбласти

#Область ПодготовитьXML

&Тест
Процедура ТестДолжен_ВернутьИсходныйПуть_ПриПараметрахНеопределено() Экспорт

	Каталог = СоздатьКаталогEDT();
	Сервис = СобратьСервис();

	Контекст = Сервис.ПодготовитьXML(Каталог, Неопределено);

	Ожидаем.Что(Контекст.Путь).Равно(Каталог);
	Ожидаем.Что(Контекст.Временный).ЭтоЛожь();
	Ожидаем.Что(ФабрикаКоманды.СозданныеКоманды.Количество(), "1cedtcli не должен вызываться").Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьИсходныйПуть_ПриФорматеXML() Экспорт

	Каталог = СоздатьКаталогEDT();
	Сервис = СобратьСервис();

	Контекст = Сервис.ПодготовитьXML(Каталог, ПараметрыИсходников("xml"));

	Ожидаем.Что(Контекст.Путь).Равно(Каталог);
	Ожидаем.Что(Контекст.Временный).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЭкспортироватьEDT_ПриФорматеEdt() Экспорт

	Каталог = СоздатьКаталогEDT();
	Сервис = СобратьСервис();

	Контекст = Сервис.ПодготовитьXML(Каталог, ПараметрыИсходников("edt"));

	Ожидаем.Что(Контекст.Временный, "результат экспорта - временный каталог").ЭтоИстина();
	Ожидаем.Что(Новый Файл(ОбъединитьПути(Контекст.Путь, "Configuration.xml")).Существует(),
		"в выходном каталоге создан Configuration.xml").ЭтоИстина();
	// Путь к 1cedtcli получен через edtfind
	Ожидаем.Что(ФабрикаКоманды.Последняя().ИмяКоманды).Равно(ФабрикаПоиска.Поиск.ПутьКcli);

	Сервис.ЗавершитьXML(Контекст);
	Ожидаем.Что(Новый Файл(Контекст.Путь).Существует(), "временный каталог удалён").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_СформироватьКоманднуюСтрокуЭкспорта() Экспорт

	КаталогEDT = СоздатьКаталогEDT();
	Сервис = СобратьСервис();
	Параметры = ПараметрыИсходников("edt");
	Параметры.Версия = "2024.1";

	Контекст = Сервис.ПодготовитьXML(КаталогEDT, Параметры);

	Ожидаем.Что(ФабрикаПоиска.Поиск.ЗапрошеннаяВерсия, "версия передана в edtfind").Равно("2024.1");

	Команда = ФабрикаКоманды.Последняя();
	Ожидаем.Что(Команда.СодержитАргумент("-data"), "указана рабочая область").ЭтоИстина();
	Ожидаем.Что(Команда.ЗначениеПослеКлюча("-command")).Равно("export");
	Ожидаем.Что(Команда.ЗначениеПослеКлюча("--project")).Равно(КаталогEDT);
	Ожидаем.Что(Команда.ЗначениеПослеКлюча("--configuration-files")).Равно(Контекст.Путь);
	// Версия служит только для выбора установки EDT через edtfind и НЕ передаётся команде
	// 1cedtcli: у export/import/validate нет параметра --version (иначе код возврата 204).
	Ожидаем.Что(Команда.СодержитАргумент("--version"),
		"--version не передаётся в 1cedtcli").ЭтоЛожь();
	// -command идёт раньше своих подаргументов
	Ожидаем.Что(ИндексАргумента(Команда, "-command") < ИндексАргумента(Команда, "--project"),
		"-command предшествует --project").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыброситьОшибку_ЕслиЭкспортНеСоздалИсходники() Экспорт

	// 1cedtcli может вернуть 0, ничего не создав - проверяем по факту наличия исходников.
	ФабрикаКоманды.ЭмулироватьУспех = Ложь;
	ФабрикаКоманды.КодВозврата = 0;
	Каталог = СоздатьКаталогEDT();
	Сервис = СобратьСервис();

	Попытка
		Сервис.ПодготовитьXML(Каталог, ПараметрыИсходников("edt"));
		ВызватьИсключение "Должно было выброситься исключение";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("не создал XML-исходники");
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область РезолвПутиКCli

&Тест
Процедура ТестДолжен_ВыброситьОшибку_ЕслиEDTНеНайдена() Экспорт

	// edtfind не нашёл EDT и в PATH 1cedtcli нет -> явная ошибка.
	ФабрикаПоиска.Поиск.ВыброситьИсключение = Истина;
	Каталог = СоздатьКаталогEDT();
	Сервис = СобратьСервис();

	Попытка
		Сервис.ПодготовитьXML(Каталог, ПараметрыИсходников("edt"));
		ВызватьИсключение "Должно было выброситься исключение";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("Не удалось найти 1cedtcli");
	КонецПопытки;

КонецПроцедуры

