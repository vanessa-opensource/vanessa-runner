#Область ПодготовитьXML

&Тест
Процедура ТестДолжен_ВернутьИсходныйПуть_ПриПараметрахНеопределено() Экспорт

	Каталог = ТестовыеФайлы.КаталогEDT();

	Контекст = Сервис.ПодготовитьXML(Каталог, Неопределено);

	Ожидаем.Что(Контекст.Путь).Равно(Каталог);
	Ожидаем.Что(Контекст.Временный).ЭтоЛожь();
	ПроверитьЧто1cedtcliНеЗапускалась();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьИсходныйПуть_ПриФорматеXML() Экспорт

	Каталог = ТестовыеФайлы.КаталогEDT();

	Контекст = Сервис.ПодготовитьXML(Каталог, ТестовыеДанные.ПараметрыИсходников("xml"));

	Ожидаем.Что(Контекст.Путь).Равно(Каталог);
	Ожидаем.Что(Контекст.Временный).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЭкспортироватьEDT_ПриФорматеEdt() Экспорт

	Каталог = ТестовыеФайлы.КаталогEDT();

	Контекст = Сервис.ПодготовитьXML(Каталог, ТестовыеДанные.ПараметрыИсходников("edt"));

	Ожидаем.Что(Контекст.Временный, "результат экспорта - временный каталог").ЭтоИстина();
	Ожидаем.Что(Контекст.КаталогEDT).Равно(Каталог);
	Ожидаем.Что(Контекст.ВременныйКаталог).Равно(Контекст.Путь);
	Ожидаем.Что(ТестовыеФайлы.Существует(ОбъединитьПути(Контекст.Путь, "Configuration.xml")),
		"в выходном каталоге создан Configuration.xml").ЭтоИстина();
	Ожидаем.Что(ФабрикаКоманды.Последняя().ИмяКоманды, "путь к 1cedtcli получен через edtfind").Равно(ПутьКCli);

	Сервис.ЗавершитьXML(Контекст);
	Ожидаем.Что(ТестовыеФайлы.Существует(Контекст.Путь), "временный каталог удалён").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_СформироватьКоманднуюСтрокуЭкспорта() Экспорт

	КаталогEDT = ТестовыеФайлы.КаталогEDT();

	Контекст = Сервис.ПодготовитьXML(КаталогEDT, ТестовыеДанные.ПараметрыИсходников("edt", "2024.1"));

	ПоискEDT.ПроверитьЧтоВызывалсяМетод().НайтиИнформациюОEDT("2024.1");
	Команда = ФабрикаКоманды.Последняя();
	Ожидаем.Что(Команда.СодержитАргумент("-data"), "указана рабочая область").ЭтоИстина();
	Ожидаем.Что(Команда.ЗначениеПослеКлюча("-command")).Равно("export");
	Ожидаем.Что(Команда.ЗначениеПослеКлюча("--project")).Равно(КаталогEDT);
	Ожидаем.Что(Команда.ЗначениеПослеКлюча("--configuration-files")).Равно(Контекст.Путь);
	// Версия выбирает установку EDT через edtfind и не передаётся 1cedtcli:
	// у export/import/validate нет параметра --version (иначе код возврата 204).
	Ожидаем.Что(Команда.СодержитАргумент("--version"), "--version не передаётся в 1cedtcli").ЭтоЛожь();
	Ожидаем.Что(Раньше(Команда, "-command", "--project"), "-command предшествует --project").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыброситьОшибку_ЕслиЭкспортНеСоздалИсходники() Экспорт

	// 1cedtcli может вернуть 0, ничего не создав - проверяется факт наличия исходников.
	ФабрикаКоманды.ЭмулироватьУспех = Ложь;
	ФабрикаКоманды.КодВозврата = 0;
	Параметры = ТестовыеДанные.Массив(ТестовыеФайлы.КаталогEDT(), ТестовыеДанные.ПараметрыИсходников("edt"));

	Ожидаем.Что(Сервис).Метод("ПодготовитьXML", Параметры).ВыбрасываетИсключение("не создал XML-исходники");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыброситьОсмысленнуюОшибку_ФорматEdtНаКаталогеXML() Экспорт

	// --src-format edt на чистом XML-дампе - явная ошибка пользователя.
	Параметры = ТестовыеДанные.Массив(ТестовыеФайлы.КаталогXML(), ТестовыеДанные.ПараметрыИсходников("edt"));

	Ожидаем.Что(Сервис).Метод("ПодготовитьXML", Параметры).ВыбрасываетИсключение("Указан формат исходников ""edt""");
	ПроверитьЧто1cedtcliНеЗапускалась();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ТрактоватьФорматXmlНаEDTКаталоге_КакPassthrough() Экспорт

	// Явный --src-format xml - осознанный override: EDT-конвертация не выполняется.
	Каталог = ТестовыеФайлы.КаталогEDT();

	Контекст = Сервис.ПодготовитьXML(Каталог, ТестовыеДанные.ПараметрыИсходников("xml"));

	Ожидаем.Что(Контекст.Путь).Равно(Каталог);
	Ожидаем.Что(Контекст.Временный).ЭтоЛожь();
	ПроверитьЧто1cedtcliНеЗапускалась();

КонецПроцедуры

