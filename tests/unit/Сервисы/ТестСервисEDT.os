&Тест
Процедура ТестДолжен_ИмпортироватьВнешниеВEDT_ПриЗавершенииВыгрузки() Экспорт

	Цель = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "edt-проект");
	Сервис = СобратьСервис();

	Контекст = Сервис.НачатьВыгрузкуВнешнихОбъектов(Цель, ПараметрыИсходников("edt"));
	Ожидаем.Что(Контекст.Временный, "выгрузка идёт во временный XML-каталог").ЭтоИстина();

	// Эмулируем разборку движком: <Имя>/<Имя>.xml во временном каталоге.
	КаталогОбъекта = ОбъединитьПути(Контекст.Путь, "Обработка");
	СоздатьКаталог(КаталогОбъекта);
	ЗаписатьФайл(ОбъединитьПути(КаталогОбъекта, "Обработка.xml"), "<ExternalDataProcessor uuid=""1""/>");

	Сервис.ЗавершитьВыгрузкуВнешнихОбъектов(Контекст);

	Команда = ФабрикаКоманды.Последняя();
	Ожидаем.Что(Команда.ЗначениеПослеКлюча("-command")).Равно("import");
	// --configuration-files подаётся на каталог с корневым <Имя>.xml (раскладка разборки)
	Ожидаем.Что(Команда.ЗначениеПослеКлюча("--configuration-files")).Равно(КаталогОбъекта);
	Ожидаем.Что(Команда.ЗначениеПослеКлюча("--project")).Равно(Цель);
	Ожидаем.Что(Новый Файл(ОбъединитьПути(Цель, ".project")).Существует(),
		"в целевом каталоге создан .project").ЭтоИстина();
	Ожидаем.Что(Новый Файл(Контекст.Путь).Существует(), "временный XML-каталог удалён").ЭтоЛожь();

КонецПроцедуры

