КонецПроцедуры

&Тест
Процедура ТестДолжен_ИмпортироватьВнешниеВEDT_ПриЗавершенииВыгрузки() Экспорт

	Цель = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "edt-проект");

	Контекст = Сервис.НачатьВыгрузкуВнешнихОбъектов(Цель, ТестовыеДанные.ПараметрыИсходников("edt"));
	Ожидаем.Что(Контекст.Временный, "выгрузка идёт во временный XML-каталог").ЭтоИстина();

	// Разборка движком эмулируется раскладкой <Имя>/<Имя>.xml во временном каталоге.
	КаталогОбъекта = ОбъединитьПути(Контекст.Путь, "Обработка");
	ТестовыеФайлы.Файл(КаталогОбъекта, "Обработка.xml", "<ExternalDataProcessor uuid=""1""/>");

	Сервис.ЗавершитьВыгрузкуВнешнихОбъектов(Контекст);

	Команда = ФабрикаКоманды.Последняя();
	Ожидаем.Что(Команда.ЗначениеПослеКлюча("-command")).Равно("import");
	// --configuration-files подаётся на каталог с корневым <Имя>.xml (раскладка разборки).
	Ожидаем.Что(Команда.ЗначениеПослеКлюча("--configuration-files")).Равно(КаталогОбъекта);
	Ожидаем.Что(Команда.ЗначениеПослеКлюча("--project")).Равно(Цель);
	Ожидаем.Что(ТестовыеФайлы.Существует(ОбъединитьПути(Цель, ".project")), "в целевом каталоге создан .project").ЭтоИстина();
	Ожидаем.Что(ТестовыеФайлы.Существует(Контекст.Путь), "временный XML-каталог удалён").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область Проверить

&Тест
Процедура ТестДолжен_ПроверитьEDT_ИРазобратьЗамечанияTSV() Экспорт

	Замечания = Сервис.Проверить(ТестовыеФайлы.КаталогEDT(), ТестовыеДанные.ПараметрыИсходников("edt"));

	Ожидаем.Что(Замечания, "разобрано 2 замечания из TSV").ИмеетДлину(2);
	Ожидаем.Что(Замечания[0].Важность).Равно("Значительная");
	Ожидаем.Что(Замечания[0].Категория).Равно("Безопасность");
	Ожидаем.Что(Замечания[0].Объект).Равно("Роль.ПолныеПрава");
	Ожидаем.Что(Замечания[1].Важность).Равно("Незначительная");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СформироватьКоманднуюСтрокуПроверки() Экспорт

	Каталог = ТестовыеФайлы.КаталогEDT();

	Сервис.Проверить(Каталог, ТестовыеДанные.ПараметрыИсходников("edt"));

	Команда = ФабрикаКоманды.Последняя();
	Ожидаем.Что(Команда.ЗначениеПослеКлюча("-command")).Равно("validate");
	Ожидаем.Что(Команда.СодержитАргумент("--file"), "указан файл результата").ЭтоИстина();
	Ожидаем.Что(Команда.ЗначениеПослеКлюча("--project-list")).Равно(Каталог);
	Ожидаем.Что(Команда.ИмяКоманды, "запущен 1cedtcli через edtfind").Равно(ПутьКCli);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыброситьОшибку_ЕслиПроверкаНеСоздалаФайл() Экспорт

	// 1cedtcli может вернуть 0, не создав .tsv - проверяется факт наличия файла.
	ФабрикаКоманды.ЭмулироватьУспех = Ложь;
	ФабрикаКоманды.КодВозврата = 0;
	Параметры = ТестовыеДанные.Массив(ТестовыеФайлы.КаталогEDT(), ТестовыеДанные.ПараметрыИсходников("edt"));

	Ожидаем.Что(Сервис).Метод("Проверить", Параметры).ВыбрасываетИсключение("не создала файл результатов");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьИсходныйОтчетEDT_ПоУказанномуПути() Экспорт

	// Файл результатов 1cedtcli validate --file сохраняется как есть по пути ФайлОтчета
	// (для edt-ripper/SonarQube), каталог назначения создаётся, замечания разбираются.
	ФайлОтчета = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "reports", "edt-validate.tsv");

	Замечания = Сервис.Проверить(ТестовыеФайлы.КаталогEDT(), ТестовыеДанные.ПараметрыИсходников("edt"), ФайлОтчета);

	Ожидаем.Что(Замечания, "замечания разобраны из сохранённого отчёта").ИмеетДлину(2);
	Ожидаем.Что(ТестовыеФайлы.Существует(ФайлОтчета), "исходный отчёт EDT сохранён").ЭтоИстина();
	Ожидаем.Что(ФабрикаКоманды.Последняя().ЗначениеПослеКлюча("--file"), "1cedtcli пишет прямо в файл отчёта")
		.Равно(Новый Файл(ФайлОтчета).ПолноеИмя);
	Ожидаем.Что(ТестовыеФайлы.ПрочитатьФайл(ФайлОтчета), "содержимое отчёта - как выгрузила 1cedtcli")
		.Содержит("Роль.ПолныеПрава" + Символы.Таб + "Права роли");

КонецПроцедуры

&Тест
Процедура ТестДолжен_УдалитьУстаревшийОтчетEDT_ПередПроверкой() Экспорт

	// Отчёт прошлого запуска не должен приниматься за результат текущей проверки:
	// файл удаляется до вызова 1cedtcli, и если проверка его не создала - это ошибка.
	ФабрикаКоманды.ЭмулироватьУспех = Ложь;
	ФайлОтчета = ТестовыеФайлы.ЗаписатьФайл(ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "edt-validate.tsv"), "устаревший отчёт");
	Параметры = ТестовыеДанные.Массив(ТестовыеФайлы.КаталогEDT(), ТестовыеДанные.ПараметрыИсходников("edt"), ФайлОтчета);

	Ожидаем.Что(Сервис).Метод("Проверить", Параметры).ВыбрасываетИсключение("не создала файл результатов");
	Ожидаем.Что(ТестовыеФайлы.Существует(ФайлОтчета), "устаревший отчёт удалён").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПроверитьXMLВыгрузку_ЧерезВременныйEDTПроект() Экспорт

	Замечания = Сервис.Проверить(ТестовыеФайлы.КаталогXML(), ТестовыеДанные.ПараметрыИсходников("xml"));

	Ожидаем.Что(Замечания, "разобрано 2 замечания из TSV").ИмеетДлину(2);
	Команды = ФабрикаКоманды.СозданныеКоманды;
	Ожидаем.Что(Команды, "import и validate").ИмеетДлину(2);
	ПутьПроекта = Команды[0].ЗначениеПослеКлюча("--project");
	Ожидаем.Что(Команды[1].ЗначениеПослеКлюча("--project-list"), "проверяется временный проект").Равно(ПутьПроекта);
	Ожидаем.Что(ТестовыеФайлы.Существует(ПутьПроекта), "временный проект удалён").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_УдалитьВременныйEDTПроект_ЕслиПроверкаУпала() Экспорт

	ФабрикаКоманды.СбойнаяКоманда = "validate";
	Параметры = ТестовыеДанные.Массив(ТестовыеФайлы.КаталогXML(), ТестовыеДанные.ПараметрыИсходников("auto"));

	Ожидаем.Что(Сервис).Метод("Проверить", Параметры).ВыбрасываетИсключение("не создала файл результатов");

	ПутьПроекта = ФабрикаКоманды.СозданныеКоманды[0].ЗначениеПослеКлюча("--project");
	Ожидаем.Что(ТестовыеФайлы.Существует(ПутьПроекта), "временный проект удалён").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПроверитьФайлОтчета_ДоКонвертации() Экспорт

	Параметры = ТестовыеДанные.Массив(ТестовыеФайлы.КаталогXML(), ТестовыеДанные.ПараметрыИсходников("auto"),
		ВременныеФайлы.СоздатьКаталог());

	Ожидаем.Что(Сервис).Метод("Проверить", Параметры).ВыбрасываетИсключение("указывает на каталог");
