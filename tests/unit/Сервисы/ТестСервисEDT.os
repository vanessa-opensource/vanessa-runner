#Область VmАргументы

&Тест
Процедура ТестДолжен_ПроброситьVmargsВ1cedtcli_ПередКомандой() Экспорт

	// По документации 1C:EDT CLI -vmargs должен идти перед -command.
	КаталогEDT = СоздатьКаталогEDT();
	Сервис = СобратьСервис();
	Параметры = ПараметрыИсходников("edt");
	Параметры.Вставить("VmАргументы", МассивСтрок("-Xmx8g", "-XX:+UseG1GC"));

	Сервис.ПодготовитьXML(КаталогEDT, Параметры);

	Команда = ФабрикаКоманды.Последняя();
	Ожидаем.Что(Команда.СодержитАргумент("-vmargs")).ЭтоИстина();
	Ожидаем.Что(Команда.СодержитАргумент("-Xmx8g")).ЭтоИстина();
	Ожидаем.Что(Команда.СодержитАргумент("-XX:+UseG1GC")).ЭтоИстина();
	Ожидаем.Что(ИндексАргумента(Команда, "-vmargs") < ИндексАргумента(Команда, "-command"),
		"-vmargs идёт перед -command").ЭтоИстина();
	Ожидаем.Что(ИндексАргумента(Команда, "-Xmx8g") < ИндексАргумента(Команда, "-command"),
		"JVM-аргументы идут до -command").ЭтоИстина();

