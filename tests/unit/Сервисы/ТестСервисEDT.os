КонецПроцедуры

#КонецОбласти

#Область Выгрузка

&Тест
Процедура ТестДолжен_ПисатьНапрямую_ПриВыгрузкеВXML() Экспорт

	Цель = ВременныеФайлы.СоздатьКаталог();
	Сервис = СобратьСервис();

	Контекст = Сервис.НачатьВыгрузку(Цель, ПараметрыИсходников("xml"));

	Ожидаем.Что(Контекст.Путь).Равно(Цель);
	Ожидаем.Что(Контекст.Временный).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИмпортироватьВEDT_ПриЗавершенииВыгрузки() Экспорт

	Цель = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "edt-проект");
	Сервис = СобратьСервис();

	Контекст = Сервис.НачатьВыгрузку(Цель, ПараметрыИсходников("edt"));
	Ожидаем.Что(Контекст.Временный, "выгрузка идёт во временный XML-каталог").ЭтоИстина();

	// Эмулируем выгрузку XML движком и завершаем (импорт в EDT).
	Сервис.ЗавершитьВыгрузку(Контекст);

	Команда = ФабрикаКоманды.Последняя();
	Ожидаем.Что(Команда.ЗначениеПослеКлюча("-command")).Равно("import");
	Ожидаем.Что(Команда.ЗначениеПослеКлюча("--project")).Равно(Цель);
	Ожидаем.Что(Новый Файл(ОбъединитьПути(Цель, ".project")).Существует(),
		"в целевом каталоге создан .project").ЭтоИстина();
	Ожидаем.Что(Новый Файл(Контекст.Путь).Существует(), "временный XML-каталог удалён").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область Проверка

&Тест
Процедура ТестДолжен_ПроверитьEDT_ИРазобратьЗамечанияTSV() Экспорт

	Каталог = СоздатьКаталогEDT();
	Сервис = СобратьСервис();

	Замечания = Сервис.Проверить(Каталог, ПараметрыИсходников("edt"));

	Ожидаем.Что(Замечания.Количество(), "разобрано 2 замечания из TSV").Равно(2);
	Ожидаем.Что(Замечания[0].Важность).Равно("Значительная");
	Ожидаем.Что(Замечания[0].Категория).Равно("Безопасность");
	Ожидаем.Что(Замечания[0].Объект).Равно("Роль.ПолныеПрава");
	Ожидаем.Что(Замечания[1].Важность).Равно("Незначительная");

КонецПроцедуры

