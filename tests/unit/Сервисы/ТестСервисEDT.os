	Ожидаем.Что(Результат.ЦелевойФормат).Равно("edt");
	Ожидаем.Что(Результат.Количество).Равно(1);
	Команда = ФабрикаКоманды.Последняя();
	Ожидаем.Что(Команда.ЗначениеПослеКлюча("-command")).Равно("import");
	// --configuration-files подаётся на подкаталог типа (в его корне лежат <Имя>.xml)
	Ожидаем.Что(Команда.ЗначениеПослеКлюча("--configuration-files")).Равно(КаталогТипа);
	Ожидаем.Что(Команда.ЗначениеПослеКлюча("--project")).Равно(Назначение);
	Ожидаем.Что(Новый Файл(ОбъединитьПути(Назначение, ".project")).Существует(),
		"в целевом каталоге создан .project").ЭтоИстина();

