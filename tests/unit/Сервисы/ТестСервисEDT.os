	Исполняемый = ФайлCli(Окружение.ИмяИсполняемогоФайла("1cedtcli"));
	Параметры = ТестовыеДанные.ПараметрыИсходников("edt");
	Параметры.ПутьКCli = Новый Файл(Исполняемый).Путь;

	// Когда
