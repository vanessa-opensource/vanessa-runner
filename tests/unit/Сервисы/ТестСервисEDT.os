&Тест
Процедура ТестДолжен_ВыгрузитьВнешниеОбъекты_ЧерезExport() Экспорт

	КаталогEDT = ТестовыеФайлы.КаталогEDT();
	КаталогВыгрузки = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "xml");
	ФабрикаКоманды.МаркерыЭкспорта = ТестовыеДанные.Массив("ExternalDataProcessors/Обработка.xml", "ExternalReports/Отчёт.xml");

	Файлы = Сервис.ЭкспортироватьВнешниеОбъекты(КаталогEDT, КаталогВыгрузки, ТестовыеДанные.ПараметрыИсходников("edt"));

	Ожидаем.Что(Файлы, "найдены корневые XML из ExternalDataProcessors/ExternalReports").ИмеетДлину(2);
	Команда = ФабрикаКоманды.Последняя();
	Ожидаем.Что(Команда.ЗначениеПослеКлюча("-command")).Равно("export");
	Ожидаем.Что(Команда.ЗначениеПослеКлюча("--project")).Равно(КаталогEDT);
	Ожидаем.Что(Команда.ЗначениеПослеКлюча("--configuration-files")).Равно(КаталогВыгрузки);
	Ожидаем.Что(Команда.СодержитАргумент("--build"), "экспорт не собирает .epf (без --build)").ЭтоЛожь();
	Ожидаем.Что(ТестовыеФайлы.Существует(Команда.ЗначениеПослеКлюча("-data")), "временная рабочая область удалена").ЭтоЛожь();

