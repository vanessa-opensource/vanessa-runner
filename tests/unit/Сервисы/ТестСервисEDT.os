	// Тогда
	Ожидаем.Что(Стенд.Вызовы("СервисОкружения", "НайтиВPATH"), "PATH опрошен").ИмеетДлину(1);
	Ожидаем.Что(ФабрикаКоманды.Последняя().ИмяКоманды, "запущен 1cedtcli через edtfind").Равно(ПутьКCli);
	ПоискEDT.ПроверитьЧтоВызывалсяМетод().НайтиИнформациюОEDT(""); // без версии - максимальная

