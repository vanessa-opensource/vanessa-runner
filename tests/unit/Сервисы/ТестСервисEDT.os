&Тест
Процедура ТестДолжен_ПредпочестьPATH_АвтопоискуEDT_БезВерсии() Экспорт

	// Дано - без --edt-version 1cedtcli из PATH важнее автопоиска установленной EDT: раньше edtfind
	// опрашивался первым и на CI с 1cedtcli в PATH (без EDT в стандартных каталогах)
	// сыпал ложное предупреждение «маркеры EDT не найдены».
	ПутьВPATH = ФайлCli();
	Окружение.Когда().НайтиВPATH(Любое).ТогдаВозвращает(ПутьВPATH);

	// Когда
	Сервис.ПодготовитьXML(ТестовыеФайлы.КаталогEDT(), ТестовыеДанные.ПараметрыИсходников("edt"));

	// Тогда
	Ожидаем.Что(ФабрикаКоманды.Последняя().ИмяКоманды, "запущен 1cedtcli из PATH").Равно(ПутьВPATH);
	Стенд.ПроверитьЧтоНеВызывался("ПоискEDT", "НайтиИнформациюОEDT");

КонецПроцедуры

