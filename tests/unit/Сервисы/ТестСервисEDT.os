#Область СоответствиеФормата

&Тест
Процедура ТестДолжен_ВыброситьОсмысленнуюОшибку_ФорматEdtНаКаталогеXML() Экспорт

	// --src-format edt на чистом XML-дампе - явная ошибка пользователя.
	Каталог = СоздатьКаталогXML();
	Сервис = СобратьСервис();

	Попытка
		Сервис.ПодготовитьXML(Каталог, ПараметрыИсходников("edt"));
		ВызватьИсключение "Должно было выброситься исключение";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("Указан формат исходников ""edt""");
	КонецПопытки;

	Ожидаем.Что(ФабрикаКоманды.СозданныеКоманды.Количество(), "1cedtcli не должен вызываться").Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ТрактоватьФорматXmlНаEDTКаталоге_КакPassthrough() Экспорт

	// Явный --src-format xml - осознанный override: EDT-конвертация не выполняется (passthrough).
	Каталог = СоздатьКаталогEDT();
	Сервис = СобратьСервис();

	Контекст = Сервис.ПодготовитьXML(Каталог, ПараметрыИсходников("xml"));

	Ожидаем.Что(Контекст.Путь).Равно(Каталог);
	Ожидаем.Что(Контекст.Временный).ЭтоЛожь();
	Ожидаем.Что(ФабрикаКоманды.СозданныеКоманды.Количество(), "1cedtcli не должен вызываться").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Вспомогательные

Функция СобратьСервис()
	Возврат Новый БилдерСервисаEDT()
		.СФабрикойКоманды(ФабрикаКоманды)
		.СФабрикойПоискаEDT(ФабрикаПоиска)
		.Собрать();
КонецФункции

Функция СоздатьКаталогEDT()
	Каталог = ВременныеФайлы.СоздатьКаталог();
	СоздатьСтруктуруEDT(Каталог);
	Возврат Каталог;
КонецФункции

Процедура СоздатьСтруктуруEDT(Знач Каталог)
	Если НЕ Новый Файл(Каталог).Существует() Тогда
		СоздатьКаталог(Каталог);
	КонецЕсли;
	ЗаписатьФайл(ОбъединитьПути(Каталог, ".project"), "<projectDescription/>");
	КаталогКонфигурации = ОбъединитьПути(Каталог, "src", "Configuration");
	СоздатьКаталог(КаталогКонфигурации);
	ЗаписатьФайл(ОбъединитьПути(КаталогКонфигурации, "Configuration.mdo"), "<mdo/>");
КонецПроцедуры

Функция СоздатьКаталогXML()
	Каталог = ВременныеФайлы.СоздатьКаталог();
	ЗаписатьФайл(ОбъединитьПути(Каталог, "Configuration.xml"), "<MetaDataObject/>");
	Возврат Каталог;
КонецФункции

Функция СоздатьФайлCli()
	Путь = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "1cedtcli.exe");
	ЗаписатьФайл(Путь, "stub");
	Возврат Путь;
КонецФункции

Функция ПараметрыИсходников(Знач Формат)
	Возврат Новый Структура("Формат, Версия, Workspace", Формат, "", "");
КонецФункции

Функция ИндексАргумента(Знач Команда, Знач Значение)
	Для Индекс = 0 По Команда.Параметры.ВГраница() Цикл
		Если Команда.Параметры[Индекс] = Значение Тогда
			Возврат Индекс;
		КонецЕсли;
	КонецЦикла;
	Возврат -1;
КонецФункции

Процедура ЗаписатьФайл(Знач Путь, Знач Текст)
	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Запись.Записать(Текст);
	Запись.Закрыть();
КонецПроцедуры

#КонецОбласти
