#КонецОбласти

#Область Конвертация

&Тест
Процедура ТестДолжен_Конвертировать_EDT_ВXML() Экспорт

	КаталогEDT = СоздатьКаталогEDT();
	Назначение = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "xml-out");
	Сервис = СобратьСервис();

	Результат = Сервис.Конвертировать(КаталогEDT, Назначение, Неопределено);

	Ожидаем.Что(Результат.ИсходныйФормат).Равно("edt");
	Ожидаем.Что(Результат.ЦелевойФормат).Равно("xml");
	Ожидаем.Что(ФабрикаКоманды.Последняя().ЗначениеПослеКлюча("-command")).Равно("export");
	Ожидаем.Что(Новый Файл(ОбъединитьПути(Назначение, "Configuration.xml")).Существует(),
		"в каталоге назначения создан Configuration.xml").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_Конвертировать_XML_ВEDT() Экспорт

	КаталогXML = СоздатьКаталогXML();
	Назначение = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "edt-out");
	Сервис = СобратьСервис();

	Результат = Сервис.Конвертировать(КаталогXML, Назначение, Неопределено);

	Ожидаем.Что(Результат.ИсходныйФормат).Равно("xml");
	Ожидаем.Что(Результат.ЦелевойФормат).Равно("edt");
	Ожидаем.Что(ФабрикаКоманды.Последняя().ЗначениеПослеКлюча("-command")).Равно("import");
	Ожидаем.Что(Новый Файл(ОбъединитьПути(Назначение, ".project")).Существует(),
		"в каталоге назначения создан .project").ЭтоИстина();

