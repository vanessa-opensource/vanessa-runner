&Тест
Процедура ТестДолжен_Конвертировать_ВнешниеEDTвXML() Экспорт

	КаталогВыгрузки = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "xml");
	ФабрикаКоманды.МаркерыЭкспорта = ТестовыеДанные.Массив("ExternalDataProcessors/Обработка.xml");

	Результат = Сервис.КонвертироватьВнешниеОбъекты(ТестовыеФайлы.КаталогEDT(), КаталогВыгрузки,
		ТестовыеДанные.ПараметрыИсходников("edt"));

	Ожидаем.Что(Результат.ИсходныйФормат).Равно("edt");
	Ожидаем.Что(Результат.ЦелевойФормат).Равно("xml");
	Ожидаем.Что(Результат.Количество).Равно(1);
	Ожидаем.Что(ФабрикаКоманды.Последняя().ЗначениеПослеКлюча("-command")).Равно("export");

КонецПроцедуры

&Тест
Процедура ТестДолжен_Конвертировать_ВнешниеXMLвEDT() Экспорт

	КаталогXml = ВременныеФайлы.СоздатьКаталог();
	КаталогТипа = ОбъединитьПути(КаталогXml, "ExternalDataProcessors");
	ТестовыеФайлы.Файл(КаталогТипа, "Обработка.xml", "<ExternalDataProcessor uuid=""1""/>");
	Назначение = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "edt-out");

	Результат = Сервис.КонвертироватьВнешниеОбъекты(КаталогXml, Назначение, ТестовыеДанные.ПараметрыИсходников("edt"));

	Ожидаем.Что(Результат.ИсходныйФормат).Равно("xml");
	Ожидаем.Что(Результат.ЦелевойФормат).Равно("edt");
	Ожидаем.Что(Результат.Количество).Равно(1);
	Команда = ФабрикаКоманды.Последняя();
	Ожидаем.Что(Команда.ЗначениеПослеКлюча("-command")).Равно("import");
	// --configuration-files подаётся на подкаталог типа: в его корне лежат <Имя>.xml.
	Ожидаем.Что(Команда.ЗначениеПослеКлюча("--configuration-files")).Равно(КаталогТипа);
	Ожидаем.Что(Команда.ЗначениеПослеКлюча("--project")).Равно(Назначение);
	Ожидаем.Что(ТестовыеФайлы.Существует(ОбъединитьПути(Назначение, ".project")), "в целевом каталоге создан .project").ЭтоИстина();

