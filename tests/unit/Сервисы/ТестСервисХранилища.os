// BSLLS-off
// Юнит-тесты СервисХранилища: делегирование всех операций менеджеру хранилища v8storage, его настройка
// и временная база для операций без подключения. Менеджер и движки замоканы, менеджер подставлен через фабрику.

#Использовать asserts
#Использовать moskito
#Использовать tempfiles
#Использовать "../utils"

Перем Стенд;
Перем Сервис;
Перем Менеджер;     // мок v8storage.МенеджерХранилищаКонфигурации, который сервис получает из фабрики
Перем Конфигуратор; // мок ДвижокКонфигуратор: отдаёт УправлениеКонфигуратором для менеджера
Перем База;
Перем Хранилище;
Перем Любое;

&ПередКаждым
Процедура ПередКаждым() Экспорт
	Стенд = Новый Стенд;
	Стенд.Реальный("СервисВременнойБазы"); // жизненный цикл временной ИБ настоящий, движки - моки
	Менеджер = Стенд.Мок("МенеджерХранилищаКонфигурации");
	Стенд.Подменить("_ФабрикаМенеджераХранилища", Новый ФабрикаСтаб(Менеджер));
	Сервис = Стенд.Сервис("СервисХранилища");
	Любое = Матчеры.ЛюбоеЗначение();
	Конфигуратор = Стенд.Мок("ДвижокКонфигуратор");
	Конфигуратор.Когда().НовыйКонфигуратор(Любое, Любое).ТогдаВозвращает("конфигуратор");
	База = ТестовыеДанные.Подключение("File=base");
	Хранилище = Новый Структура("АдресХранилища, Пользователь, Пароль, Версия", "tcp://localhost/repo", "u", "p", 42);
КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт
	ВременныеФайлы.Удалить();
КонецПроцедуры

#Область ОбновитьИзХранилища

&Тест
Процедура ТестДолжен_ОбновитьИзХранилища_СВерсией() Экспорт

	// Когда
	Сервис.ОбновитьИзХранилища(База, Хранилище);

	// Тогда - менеджер настроен конфигуратором переданной базы, адресом и авторизацией хранилища
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().НовыйКонфигуратор(Неопределено, База);
	Менеджер.ПроверитьЧтоВызывалсяМетод().УстановитьУправлениеКонфигуратором("конфигуратор");
	Менеджер.ПроверитьЧтоВызывалсяМетод().УстановитьПутьКХранилищу("tcp://localhost/repo");
	Менеджер.ПроверитьЧтоВызывалсяМетод().УстановитьПараметрыАвторизации("u", "p");
	Менеджер.ПроверитьЧтоВызывалсяМетод().ОбновитьКонфигурациюНаВерсию(42);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПробросИсключения_ПриОшибкеОбновления() Экспорт

	// Дано
	Менеджер.Когда().ОбновитьКонфигурациюНаВерсию(Любое).ТогдаВыбрасываетИсключение("стаб: ОбновитьКонфигурациюНаВерсию упал");

	// Когда / Тогда
	Ожидаем.Что(Сервис).Метод("ОбновитьИзХранилища", ТестовыеДанные.Массив(База, Хранилище))
		.ВыбрасываетИсключение("ОбновитьКонфигурациюНаВерсию");

КонецПроцедуры

#КонецОбласти

#Область СоздатьХранилище

&Тест
Процедура ТестДолжен_СоздатьХранилище_СВременнойБазой_ЕслиПодключенияНет() Экспорт

	// Когда
	Сервис.СоздатьХранилище(Хранилище);

	// Тогда - одна временная база, менеджер работает в ней, база удалена после операции
	Ожидаем.Что(Стенд.Вызовы("ДвижокКонфигуратор", "СоздатьВременнуюБазу")).ИмеетДлину(1);
	Временная = Стенд.Вызовы("ДвижокКонфигуратор", "НовыйКонфигуратор")[0].ПараметрыПодключения;
	Ожидаем.Что(Временная.КаталогБазы).Заполнено();
	Ожидаем.Что(ТестовыеФайлы.Существует(Временная.КаталогБазы), "временная база удалена").ЭтоЛожь();
	Менеджер.ПроверитьЧтоВызывалсяМетод().СоздатьХранилищеКонфигурации();

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьХранилище_БезВременнойБазы_ПриЯвномПодключении() Экспорт

	// Когда
	Сервис.СоздатьХранилище(Хранилище, Неопределено, База);

	// Тогда
	Стенд.ПроверитьЧтоНеВызывался("ДвижокКонфигуратор", "СоздатьВременнуюБазу");
	Конфигуратор.ПроверитьЧтоВызывалсяМетод().НовыйКонфигуратор(Неопределено, База);
	Менеджер.ПроверитьЧтоВызывалсяМетод().СоздатьХранилищеКонфигурации();

КонецПроцедуры

#КонецОбласти

#Область ПодключитьсяКХранилищу_ОтключитьсяОтХранилища

&Тест
Процедура ТестДолжен_ПодключитьсяКХранилищу() Экспорт

	// Когда
	Сервис.ПодключитьсяКХранилищу(База, Хранилище, Истина, Ложь);

	// Тогда
	Менеджер.ПроверитьЧтоВызывалсяМетод().ПодключитьсяКХранилищу(Истина, Ложь);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтключитьсяОтХранилища() Экспорт

	// Когда
	Сервис.ОтключитьсяОтХранилища(База);

	// Тогда - параметры хранилища не нужны, менеджер без адреса
	Менеджер.ПроверитьЧтоВызывалсяМетод().ОтключитьсяОтХранилища();
	Стенд.ПроверитьЧтоНеВызывался("МенеджерХранилищаКонфигурации", "УстановитьПутьКХранилищу");

КонецПроцедуры

#КонецОбласти

#Область СоздатьПользователяХранилища_КопироватьПользователейИзХранилища

&Тест
Процедура ТестДолжен_СоздатьПользователяХранилища() Экспорт

	// Когда
	Сервис.СоздатьПользователяХранилища(Хранилище, "user1", "pwd", "Администратор");

	// Тогда
	Менеджер.ПроверитьЧтоВызывалсяМетод().ДобавитьПользователяВХранилище("user1", "pwd", "Администратор");

КонецПроцедуры

&Тест
Процедура ТестДолжен_КопироватьПользователейИзХранилища() Экспорт

	// Когда
	Сервис.КопироватьПользователейИзХранилища(Хранилище, "tcp://other/repo", "src", "srcpwd", Истина);

	// Тогда
	Менеджер.ПроверитьЧтоВызывалсяМетод().КопироватьПользователейИзХранилища("tcp://other/repo", "src", "srcpwd", Истина);

КонецПроцедуры

#КонецОбласти

#Область СохранитьВерсиюХранилищаВФайл

&Тест
Процедура ТестДолжен_СохранитьВерсиюХранилищаВФайл() Экспорт

	// Когда
	Сервис.СохранитьВерсиюХранилищаВФайл(Хранилище, "out.cf");

	// Тогда
	Менеджер.ПроверитьЧтоВызывалсяМетод().СохранитьВерсиюКонфигурацииВФайл(42, "out.cf");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОчиститьВременнуюБазу_ПриОшибкеСохраненияВФайл() Экспорт

	// Дано
	КаталогВременной = ВременныеФайлы.СоздатьКаталог();
	Конфигуратор.Когда().СоздатьВременнуюБазу(Любое).ТогдаВозвращает(ТестовыеДанные.Файловая(КаталогВременной));
	Менеджер.Когда().СохранитьВерсиюКонфигурацииВФайл(Любое, Любое)
		.ТогдаВыбрасываетИсключение("стаб: СохранитьВерсиюКонфигурацииВФайл упал");

	// Когда / Тогда
	Ожидаем.Что(Сервис).Метод("СохранитьВерсиюХранилищаВФайл", ТестовыеДанные.Массив(Хранилище, "out.cf"))
		.ВыбрасываетИсключение("СохранитьВерсиюКонфигурацииВФайл");
	Ожидаем.Что(ТестовыеФайлы.Существует(КаталогВременной), "временная база удалена").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область ЗахватитьОбъектыВХранилище_ОтпуститьОбъектыВХранилище_ПоместитьИзмененияВХранилище

&Тест
Процедура ТестДолжен_ЗахватитьОбъектыВХранилище() Экспорт

	// Когда
	Сервис.ЗахватитьОбъектыВХранилище(База, Хранилище, "list.txt", Истина);

	// Тогда
	Менеджер.ПроверитьЧтоВызывалсяМетод().ЗахватитьОбъектыВХранилище("list.txt", Истина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтпуститьОбъектыВХранилище() Экспорт

	// Когда
	Сервис.ОтпуститьОбъектыВХранилище(База, Хранилище, "list.txt", Истина);

	// Тогда
	Менеджер.ПроверитьЧтоВызывалсяМетод().ОтменитьЗахватОбъектовВХранилище("list.txt", Истина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПоместитьИзмененияВХранилище() Экспорт

	// Когда
	Сервис.ПоместитьИзмененияВХранилище(База, Хранилище, "list.txt", "fix bug", Ложь, Истина);

	// Тогда
	Менеджер.ПроверитьЧтоВызывалсяМетод().ПоместитьИзмененияОбъектовВХранилище("list.txt", "fix bug", Ложь, Истина);

КонецПроцедуры

#КонецОбласти
