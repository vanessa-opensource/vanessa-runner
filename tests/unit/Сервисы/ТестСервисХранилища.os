// BSLLS-off
// Юнит-тесты СервисХранилища - все 9 публичных методов.

#Использовать asserts

#Использовать "../../../src/core/Сервисы"
#Использовать "../utils"

Перем ПарПодключения;
Перем ПарХранилища;
Перем Менеджер;
Перем Движок;
Перем Сервис;

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт

	ПарПодключения = Новый Структура("СтрокаПодключения", "File=base");
	ПарХранилища = Новый Структура;
	ПарХранилища.Вставить("АдресХранилища", "tcp://localhost/repo");
	ПарХранилища.Вставить("Пользователь", "u");
	ПарХранилища.Вставить("Пароль", "p");
	ПарХранилища.Вставить("Версия", 42);

	Движок = Новый ДвижокПлатформыСтаб();
	Менеджер = Новый МенеджерХранилищаСтаб();
	Сервис = Новый БилдерСервисаХранилища()
		.СДвижком(Движок)
		.СМенеджером(Менеджер)
		.Собрать();

КонецПроцедуры

Функция ВызывалсяМетод(Имя)
	Для Каждого Вызов Из Менеджер.Вызовы Цикл
		Если Вызов.Метод = Имя Тогда
			Возврат Вызов;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

#Область ОбновитьИзХранилища

&Тест
Процедура ТестДолжен_ОбновитьИзХранилища_СВерсией() Экспорт
	Сервис.ОбновитьИзХранилища(ПарПодключения, ПарХранилища);

	Вызов = ВызывалсяМетод("ОбновитьКонфигурациюНаВерсию");
	Ожидаем.Что(Вызов).Заполнено();
	Ожидаем.Что(Вызов.Параметры).Равно(42);
	Ожидаем.Что(Менеджер.АдресХранилища_).Равно("tcp://localhost/repo");
	Ожидаем.Что(Менеджер.Пользователь_).Равно("u");
КонецПроцедуры

&Тест
Процедура ТестДолжен_ПробросИсключения_ПриОшибкеОбновления() Экспорт
	Менеджер.СБрасыванием("ОбновитьКонфигурациюНаВерсию");
	Попытка
		Сервис.ОбновитьИзХранилища(ПарПодключения, ПарХранилища);
		ВызватьИсключение "должно было упасть";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("ОбновитьКонфигурациюНаВерсию");
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

#Область СоздатьХранилище

&Тест
Процедура ТестДолжен_СоздатьХранилище_СВременнойБазой_ЕслиПодключенияНет() Экспорт
	Сервис.СоздатьХранилище(ПарХранилища);
	Ожидаем.Что(Движок.ВызовыСоздатьБазу).Равно(1);
	Ожидаем.Что(ВызывалсяМетод("СоздатьХранилищеКонфигурации")).Заполнено();
КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьХранилище_БезВременнойБазы_ПриЯвномПодключении() Экспорт
	Сервис.СоздатьХранилище(ПарХранилища, Неопределено, ПарПодключения);
	Ожидаем.Что(Движок.ВызовыСоздатьБазу).Равно(0);
КонецПроцедуры

#КонецОбласти

#Область ПодключитьсяОтключиться

&Тест
Процедура ТестДолжен_ПодключитьсяКХранилищу() Экспорт
	Сервис.ПодключитьсяКХранилищу(ПарПодключения, ПарХранилища, Истина, Ложь);
	Вызов = ВызывалсяМетод("ПодключитьсяКХранилищу");
	Ожидаем.Что(Вызов.Параметры.Игнор).ЭтоИстина();
	Ожидаем.Что(Вызов.Параметры.Заменить).ЭтоЛожь();
КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтключитьсяОтХранилища() Экспорт
	Сервис.ОтключитьсяОтХранилища(ПарПодключения);
	Ожидаем.Что(ВызывалсяМетод("ОтключитьсяОтХранилища")).Заполнено();
КонецПроцедуры

#КонецОбласти

#Область ПользователиХранилища

&Тест
Процедура ТестДолжен_СоздатьПользователяХранилища() Экспорт
	Сервис.СоздатьПользователяХранилища(ПарХранилища, "user1", "pwd", "Администратор");
	Вызов = ВызывалсяМетод("ДобавитьПользователяВХранилище");
	Ожидаем.Что(Вызов.Параметры.Логин).Равно("user1");
	Ожидаем.Что(Вызов.Параметры.Роль).Равно("Администратор");
КонецПроцедуры

&Тест
Процедура ТестДолжен_КопироватьПользователейИзХранилища() Экспорт
	Сервис.КопироватьПользователейИзХранилища(ПарХранилища,
		"tcp://other/repo", "src", "srcpwd", Истина);
	Вызов = ВызывалсяМетод("КопироватьПользователейИзХранилища");
	Ожидаем.Что(Вызов.Параметры.Адрес).Равно("tcp://other/repo");
	Ожидаем.Что(Вызов.Параметры.Восст).ЭтоИстина();
КонецПроцедуры

#КонецОбласти

#Область ВерсияВФайл

&Тест
Процедура ТестДолжен_СохранитьВерсиюХранилищаВФайл() Экспорт
	Сервис.СохранитьВерсиюХранилищаВФайл(ПарХранилища, "C:\\out.cf");
	Вызов = ВызывалсяМетод("СохранитьВерсиюКонфигурацииВФайл");
	Ожидаем.Что(Вызов.Параметры.Версия).Равно(42);
	Ожидаем.Что(Вызов.Параметры.Путь).Равно("C:\\out.cf");
КонецПроцедуры

&Тест
Процедура ТестДолжен_ОчиститьВременнуюБазу_ПриОшибкеСохраненияВФайл() Экспорт
	Менеджер.СБрасыванием("СохранитьВерсиюКонфигурацииВФайл");
	Попытка
		Сервис.СохранитьВерсиюХранилищаВФайл(ПарХранилища, "C:\\out.cf");
		ВызватьИсключение "должно было упасть";
	Исключение
		// Ок: исключение проброшено, временная база создавалась
		Ожидаем.Что(Движок.ВызовыСоздатьБазу).Равно(1);
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

#Область ЗахватИОтпуск

&Тест
Процедура ТестДолжен_ЗахватитьОбъектыВХранилище() Экспорт
	Сервис.ЗахватитьОбъектыВХранилище(ПарПодключения, ПарХранилища, "list.txt", Истина);
	Вызов = ВызывалсяМетод("ЗахватитьОбъектыВХранилище");
	Ожидаем.Что(Вызов.Параметры.Путь).Равно("list.txt");
	Ожидаем.Что(Вызов.Параметры.Получать).ЭтоИстина();
КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтпуститьОбъектыВХранилище() Экспорт
	Сервис.ОтпуститьОбъектыВХранилище(ПарПодключения, ПарХранилища, "list.txt", Истина);
	Вызов = ВызывалсяМетод("ОтменитьЗахватОбъектовВХранилище");
	Ожидаем.Что(Вызов.Параметры.Путь).Равно("list.txt");
	Ожидаем.Что(Вызов.Параметры.Игнорировать).ЭтоИстина();
КонецПроцедуры

&Тест
Процедура ТестДолжен_ПоместитьИзмененияВХранилище() Экспорт
	Сервис.ПоместитьИзмененияВХранилище(ПарПодключения, ПарХранилища, "list.txt", "fix bug", Ложь, Истина);
	Вызов = ВызывалсяМетод("ПоместитьИзмененияОбъектовВХранилище");
	Ожидаем.Что(Вызов.Параметры.Путь).Равно("list.txt");
	Ожидаем.Что(Вызов.Параметры.Коммент).Равно("fix bug");
	Ожидаем.Что(Вызов.Параметры.Удал).ЭтоИстина();
КонецПроцедуры

#КонецОбласти
