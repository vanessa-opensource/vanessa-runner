// BSLLS-off
// Юнит-тесты СервисСервераОтладки (жизненный цикл сервера отладки dbgs).
// Реальный dbgs не запускается: процесс подменяется стаб-фабрикой (ФабрикаПроцессаОтладкиСтаб),
// путь к dbgs подменяется временным файлом. Проверяется командная строка, готовность,
// подключение к существующему серверу, остановка и валидации.

#Использовать asserts
#Использовать tempfiles
#Использовать "../utils"

Перем ПутьDBGS;

#Область СлужебныйПрограммныйИнтерфейс

&Тест
Процедура ТестДолжен_ВернутьПараметрыСервераПоУмолчанию() Экспорт

	Сервис = Новый БилдерСервисаСервераОтладки().Собрать();

	Параметры = Сервис.НовыеПараметрыСервера();

	Ожидаем.Что(Параметры.Хост, "хост по умолчанию").Равно("127.0.0.1");
	Ожидаем.Что(Параметры.Порт, "порт по умолчанию (не задан)").Равно(0);
	Ожидаем.Что(Параметры.ПодключитьсяКСуществующему, "режим подключения").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПодключитьсяКСуществующему_БезЗапускаПроцесса() Экспорт

	// Дано - режим подключения к чужому серверу
	Фабрика = Новый ФабрикаПроцессаОтладкиСтаб();
	Сервис = Новый БилдерСервисаСервераОтладки().СФабрикойПроцесса(Фабрика).Собрать();

	Параметры = Сервис.НовыеПараметрыСервера();
	Параметры.ПодключитьсяКСуществующему = Истина;
	Параметры.Порт = 8400;

	// Когда
	Контекст = Сервис.ЗапуститьСервер(Параметры);

	// Тогда - процесс не запускался, адрес построен из порта
	Ожидаем.Что(Фабрика.КоличествоЗапусков, "запусков процесса").Равно(0);
	Ожидаем.Что(Контекст.Адрес, "адрес сервера").Равно("http://127.0.0.1:8400");

	// И - остановка не трогает чужой процесс
	Сервис.ОстановитьСервер();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗапуститьПроцессDBGS_СКоманднойСтрокой() Экспорт

	// Дано - стаб-фабрика создаёт файл готовности, путь к dbgs существует
	Фабрика = Новый ФабрикаПроцессаОтладкиСтаб();
	Сервис = Новый БилдерСервисаСервераОтладки().СФабрикойПроцесса(Фабрика).Собрать();

	Параметры = Сервис.НовыеПараметрыСервера();
	Параметры.ПутьКDBGS = ПутьDBGS;
	Параметры.Порт = 9999;

	// Когда
	Контекст = Сервис.ЗапуститьСервер(Параметры);

	// Тогда - процесс запущен ровно один раз, строка содержит путь и ключи
	Ожидаем.Что(Фабрика.КоличествоЗапусков, "запусков процесса").Равно(1);
	Ожидаем.Что(Контекст.Порт, "порт").Равно(9999);
	Ожидаем.Что(Фабрика.ПоследняяСтрокаЗапуска, "командная строка").Содержит(ПутьDBGS);
	Ожидаем.Что(Фабрика.ПоследняяСтрокаЗапуска, "ключ порта").Содержит("--port=9999");
	Ожидаем.Что(Фабрика.ПоследняяСтрокаЗапуска, "ключ адреса").Содержит("--addr=127.0.0.1");
	Ожидаем.Что(Фабрика.ПоследняяСтрокаЗапуска, "ключ оповещения").Содержит("--notify=");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОстановитьЗапущенныйПроцесс() Экспорт

	// Дано
	Фабрика = Новый ФабрикаПроцессаОтладкиСтаб();
	Сервис = Новый БилдерСервисаСервераОтладки().СФабрикойПроцесса(Фабрика).Собрать();

	Параметры = Сервис.НовыеПараметрыСервера();
	Параметры.ПутьКDBGS = ПутьDBGS;
	Сервис.ЗапуститьСервер(Параметры);

	// Когда
	Сервис.ОстановитьСервер();

	// Тогда - процесс завершён
	Ожидаем.Что(Фабрика.СозданныйПроцесс.КоличествоВызововЗавершить, "вызовов Завершить").Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_УпастьЕслиСерверУжеЗапущен() Экспорт

	Фабрика = Новый ФабрикаПроцессаОтладкиСтаб();
	Сервис = Новый БилдерСервисаСервераОтладки().СФабрикойПроцесса(Фабрика).Собрать();

	Параметры = Сервис.НовыеПараметрыСервера();
	Параметры.ПутьКDBGS = ПутьDBGS;
	Сервис.ЗапуститьСервер(Параметры);

	Попытка
		Сервис.ЗапуститьСервер(Параметры);
		ВызватьИсключение "Должно было упасть";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("уже запущен");
	КонецПопытки;

КонецПроцедуры

&Тест
Процедура ТестДолжен_УпастьЕслиDBGSНеНайден() Экспорт

	Фабрика = Новый ФабрикаПроцессаОтладкиСтаб();
	Сервис = Новый БилдерСервисаСервераОтладки().СФабрикойПроцесса(Фабрика).Собрать();

	Параметры = Сервис.НовыеПараметрыСервера();
	Параметры.ПутьКDBGS = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "нет-такого-dbgs.exe");

	Попытка
		Сервис.ЗапуститьСервер(Параметры);
		ВызватьИсключение "Должно было упасть";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("dbgs");
	КонецПопытки;

КонецПроцедуры

&Тест
Процедура ТестДолжен_УпастьЕслиСерверНеГотов() Экспорт

	// Дано - фабрика НЕ создаёт файл готовности, малый таймаут
	Фабрика = Новый ФабрикаПроцессаОтладкиСтаб().БезФайлаОповещения();
	Сервис = Новый БилдерСервисаСервераОтладки()
		.СФабрикойПроцесса(Фабрика)
		.СТаймаутомГотовности(200)
		.Собрать();

	Параметры = Сервис.НовыеПараметрыСервера();
	Параметры.ПутьКDBGS = ПутьDBGS;
	Параметры.Порт = 9999; // явный порт => строгий режим (без перебора), готовность не пришла

	// Когда / Тогда
	Попытка
		Сервис.ЗапуститьСервер(Параметры);
		ВызватьИсключение "Должно было упасть";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("не готов");
	КонецПопытки;

КонецПроцедуры

&Тест
Процедура ТестДолжен_УпастьЕслиЗаданныйПортЗанят_БезПеребора() Экспорт

	// Дано - явный порт, dbgs "падает" (порт занят)
	Фабрика = Новый ФабрикаПроцессаОтладкиСтаб().ПадатьНаПервыхЗапусках(1);
	Сервис = Новый БилдерСервисаСервераОтладки().СФабрикойПроцесса(Фабрика).Собрать();

	Параметры = Сервис.НовыеПараметрыСервера();
	Параметры.ПутьКDBGS = ПутьDBGS;
	Параметры.Порт = 9999;

	// Когда / Тогда - ровно одна попытка, ошибка про занятый порт
	Попытка
		Сервис.ЗапуститьСервер(Параметры);
		ВызватьИсключение "Должно было упасть";
	Исключение
		Ожидаем.Что(ОписаниеОшибки(), "ошибка занятого порта").Содержит("занят");
	КонецПопытки;

	Ожидаем.Что(Фабрика.КоличествоЗапусков, "без перебора - одна попытка").Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПодобратьСвободныйПорт_ЕслиПервыйЗанят() Экспорт

	// Дано - порт НЕ задан (авто-подбор), первый кандидат занят
	Фабрика = Новый ФабрикаПроцессаОтладкиСтаб().ПадатьНаПервыхЗапусках(1);
	Сервис = Новый БилдерСервисаСервераОтладки().СФабрикойПроцесса(Фабрика).Собрать();

	Параметры = Сервис.НовыеПараметрыСервера();
	Параметры.ПутьКDBGS = ПутьDBGS;
	// Порт = 0 (по умолчанию) => перебор

	// Когда
	Контекст = Сервис.ЗапуститьСервер(Параметры);

	// Тогда - две попытки (первый порт занят, второй свободен), сервер поднялся
	Ожидаем.Что(Фабрика.КоличествоЗапусков, "перебор: две попытки").Равно(2);
	Ожидаем.Что(Контекст.Адрес, "адрес поднятого сервера").Содержит("http://127.0.0.1:");

	Сервис.ОстановитьСервер();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	ПутьDBGS = ВременныеФайлы.НовоеИмяФайла("exe");
	Запись = Новый ЗаписьТекста(ПутьDBGS, КодировкаТекста.UTF8);
	Запись.ЗаписатьСтроку("fake dbgs");
	Запись.Закрыть();
КонецПроцедуры

#КонецОбласти
