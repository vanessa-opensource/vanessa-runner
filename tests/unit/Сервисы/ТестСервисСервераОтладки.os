// BSLLS-off
// Юнит-тесты СервисСервераОтладки: жизненный цикл сервера отладки dbgs - командная строка,
// готовность, подключение к чужому серверу, подбор порта, остановка, валидации.
// Реальный dbgs не запускается: процесс подменяется ФабрикаПроцессаОтладкиСтаб, путь к dbgs - временным файлом.

#Использовать asserts
#Использовать tempfiles
#Использовать "../utils"

Перем Стенд;
Перем Сервис;
Перем Фабрика; // ФабрикаПроцессаОтладкиСтаб: имитирует запуск dbgs и файл оповещения о готовности
Перем Параметры;

&ПередКаждым
Процедура ПередКаждым() Экспорт
	Стенд = Новый Стенд;
	Стенд.Реальный("СервисПроцессов"); // ожидание файла готовности и завершение процесса настоящие
	Фабрика = Стенд.Подменить("_ФабрикаПроцесса", Новый ФабрикаПроцессаОтладкиСтаб);
	Сервис = Стенд.Сервис("СервисСервераОтладки");
	Параметры = Сервис.НовыеПараметрыСервера();
	Параметры.ПутьКDBGS = ТестовыеФайлы.ВременныйФайл("exe", "fake dbgs");
КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт
	ВременныеФайлы.Удалить();
КонецПроцедуры

#Область НовыеПараметрыСервера

&Тест
Процедура ТестДолжен_ВернутьПараметрыСервераПоУмолчанию() Экспорт

	Параметры = Сервис.НовыеПараметрыСервера();

	Ожидаем.Что(Параметры.Хост, "хост по умолчанию").Равно("127.0.0.1");
	Ожидаем.Что(Параметры.Порт, "порт по умолчанию (не задан)").Равно(0);
	Ожидаем.Что(Параметры.ПодключитьсяКСуществующему, "режим подключения").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область ЗапуститьСервер

&Тест
Процедура ТестДолжен_ПодключитьсяКСуществующему_БезЗапускаПроцесса() Экспорт

	// Дано - режим подключения к чужому серверу
	Параметры.ПодключитьсяКСуществующему = Истина;
	Параметры.Порт = 8400;

	// Когда
	Контекст = Сервис.ЗапуститьСервер(Параметры);

	// Тогда - процесс не запускался, адрес построен из порта
	Ожидаем.Что(Фабрика.КоличествоЗапусков, "запусков процесса").Равно(0);
	Ожидаем.Что(Контекст.Адрес, "адрес сервера").Равно("http://127.0.0.1:8400");

	// И - остановка не трогает чужой процесс
	Сервис.ОстановитьСервер();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗапуститьПроцессDBGS_СКоманднойСтрокой() Экспорт

	// Дано
	Параметры.Порт = 9999;

	// Когда
	Контекст = Сервис.ЗапуститьСервер(Параметры);

	// Тогда - процесс запущен ровно один раз, строка содержит путь и ключи
	Ожидаем.Что(Фабрика.КоличествоЗапусков, "запусков процесса").Равно(1);
	Ожидаем.Что(Контекст.Порт, "порт").Равно(9999);
	Ожидаем.Что(Фабрика.ПоследняяСтрокаЗапуска, "командная строка").Содержит(Параметры.ПутьКDBGS);
	Ожидаем.Что(Фабрика.ПоследняяСтрокаЗапуска, "ключ порта").Содержит("--port=9999");
	Ожидаем.Что(Фабрика.ПоследняяСтрокаЗапуска, "ключ адреса").Содержит("--addr=127.0.0.1");
	Ожидаем.Что(Фабрика.ПоследняяСтрокаЗапуска, "ключ оповещения").Содержит("--notify=");

КонецПроцедуры

&Тест
Процедура ТестДолжен_БроситьИсключение_ЕслиСерверУжеЗапущен() Экспорт

	Сервис.ЗапуститьСервер(Параметры);

	Ожидаем.Что(Сервис).Метод("ЗапуститьСервер", ТестовыеДанные.Массив(Параметры)).ВыбрасываетИсключение("уже запущен");

КонецПроцедуры

&Тест
Процедура ТестДолжен_БроситьИсключение_ЕслиDBGSНеНайден() Экспорт

	Параметры.ПутьКDBGS = ТестовыеФайлы.НесуществующийПуть("dbgs.exe");

	Ожидаем.Что(Сервис).Метод("ЗапуститьСервер", ТестовыеДанные.Массив(Параметры)).ВыбрасываетИсключение("dbgs");
	Ожидаем.Что(Фабрика.КоличествоЗапусков, "запусков процесса").Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_БроситьИсключение_ЕслиСерверНеГотов() Экспорт

	// Дано - фабрика не создаёт файл оповещения, малый таймаут, явный порт => строгий режим без перебора
	Фабрика.БезФайлаОповещения();
	Сервис.УстановитьТаймаутГотовности(200);
	Параметры.Порт = 9999;

	// Когда / Тогда
	Ожидаем.Что(Сервис).Метод("ЗапуститьСервер", ТестовыеДанные.Массив(Параметры)).ВыбрасываетИсключение("не готов");

КонецПроцедуры

&Тест
Процедура ТестДолжен_БроситьИсключениеБезПеребора_ЕслиЗаданныйПортЗанят() Экспорт

	// Дано - явный порт, dbgs «падает» (порт занят)
	Фабрика.ПадатьНаПервыхЗапусках(1);
	Параметры.Порт = 9999;

	// Когда / Тогда - ровно одна попытка, ошибка про занятый порт
	Ожидаем.Что(Сервис).Метод("ЗапуститьСервер", ТестовыеДанные.Массив(Параметры)).ВыбрасываетИсключение("занят");
	Ожидаем.Что(Фабрика.КоличествоЗапусков, "без перебора - одна попытка").Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПодобратьСвободныйПорт_ЕслиПервыйЗанят() Экспорт

	// Дано - порт не задан (авто-подбор), первый кандидат занят
	Фабрика.ПадатьНаПервыхЗапусках(1);

	// Когда
	Контекст = Сервис.ЗапуститьСервер(Параметры);

	// Тогда - две попытки (первый порт занят, второй свободен), сервер поднялся
	Ожидаем.Что(Фабрика.КоличествоЗапусков, "перебор: две попытки").Равно(2);
	Ожидаем.Что(Контекст.Адрес, "адрес поднятого сервера").Содержит("http://127.0.0.1:");

	Сервис.ОстановитьСервер();

КонецПроцедуры

#КонецОбласти

#Область ОстановитьСервер

&Тест
Процедура ТестДолжен_ЗавершитьПроцесс_ПриОстановкеЗапущенногоСервера() Экспорт

	// Дано
	Сервис.ЗапуститьСервер(Параметры);

	// Когда
	Сервис.ОстановитьСервер();

	// Тогда
	Ожидаем.Что(Фабрика.СозданныйПроцесс.КоличествоВызововЗавершить, "вызовов Завершить").Равно(1);

КонецПроцедуры

#КонецОбласти
