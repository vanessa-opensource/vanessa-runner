// BSLLS:NumberOfValuesInStructureConstructor-off
// BSLLS-off
// Юнит-тесты СервисЗапускаОбработок.
// Движок и СервисОкружения замоканы/застаблены.
// Покрытие: формирование строки параметров, разрешение пути EPF, разбор JSON-результата,
// обработка ошибок (код возврата, ошибка), очистка временного файла результата.

#Использовать asserts
#Использовать moskito
#Использовать tempfiles

#Использовать "../../../src/core/Сервисы"
#Использовать "../../../src/core/Приложение"
#Использовать "../utils"

Перем Подключения;

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	Подключения = Новый ДанныеПодключений;
КонецПроцедуры

#Область СформироватьСтрокуПараметров

&Тест
Процедура ТестДолжен_СформироватьСтрокуПараметров_СФлагамиИЗначениями() Экспорт

	// Дано
	Сервис = СоздатьСервисСЗаглушкой().Собрать();
	Параметры = Новый Структура;
	Параметры.Вставить("Имя", "Иванов");
	Параметры.Вставить("СоздатьАдминистратора", Истина);
	Параметры.Вставить("Пропустить", Ложь);

	// Когда
	Строка = Сервис.СформироватьСтрокуПараметров(Параметры, "C:\res.json");

	// Тогда
	Ожидаем.Что(Строка).Содержит("Имя=Иванов");
	Ожидаем.Что(Строка).Содержит("СоздатьАдминистратора");
	Ожидаем.Что(СтрНайти(Строка, "Пропустить") = 0).ЭтоИстина();
	Ожидаем.Что(Строка).Содержит("ФайлРезультата=C:\res.json");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СформироватьСтрокуПараметров_БезПараметров() Экспорт

	// Дано
	Сервис = СоздатьСервисСЗаглушкой().Собрать();

	// Когда
	Строка = Сервис.СформироватьСтрокуПараметров(Неопределено, "C:\res.json");

	// Тогда
	Ожидаем.Что(Строка).Равно("ФайлРезультата=C:\res.json");

КонецПроцедуры

#КонецОбласти

#Область ВыполнитьОбработку

&Тест
Процедура ТестДолжен_ВызватьИсключение_ЕслиОбработкаНеНайдена() Экспорт

	// Дано
	МокОкружения = Мок.Получить(Новый СервисОкружения);
	МокОкружения.Когда().КорневойКаталогПакета().ТогдаВозвращает(ВременныеФайлы.СоздатьКаталог());
	Сервис = Новый БилдерСервисаЗапускаОбработок()
		.СДвижкомКонфигуратор(Новый ДвижокОбработокСтаб)
		.СОкружением(МокОкружения)
		.Собрать();

	// Когда / Тогда
	Попытка
		Сервис.ВыполнитьОбработку("НесуществующаяОбработка", Подключения.Файловая("C:\base"));
		ВызватьИсключение "должно было упасть";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("не найдена");
	КонецПопытки;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыполнитьОбработку_УспешныйРезультат() Экспорт

	// Дано
	Стаб = Новый ДвижокОбработокСтаб;
	Стаб.СодержимоеРезультата = "{""КодВозврата"": 0, ""Сообщения"": [""Готово""], ""Ошибка"": """"}";
	Сервис = СоздатьСервисСЗаглушкой(Стаб, "ТестоваяОбработка").Собрать();

	// Когда
	Результат = Сервис.ВыполнитьОбработку("ТестоваяОбработка", Подключения.Файловая("C:\base"));

	// Тогда
	Ожидаем.Что(Результат.КодВозврата).Равно(0);
	Ожидаем.Что(Результат.Сообщения.Количество()).Равно(1);
	Ожидаем.Что(Результат.Сообщения[0]).Равно("Готово");
	Ожидаем.Что(Стаб.КоличествоЗапусков).Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПередатьПутьОбработки_ВДвижок() Экспорт

	// Дано
	Стаб = Новый ДвижокОбработокСтаб;
	Сервис = СоздатьСервисСЗаглушкой(Стаб, "ТестоваяОбработка").Собрать();

	// Когда
	Сервис.ВыполнитьОбработку("ТестоваяОбработка", Подключения.Файловая("C:\base"));

	// Тогда
	Ожидаем.Что(Стаб.ПоследнийПутьОбработки).Содержит("ТестоваяОбработка.epf");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВызватьИсключение_ПриКодеВозвратаНеНоль() Экспорт

	// Дано
	Стаб = Новый ДвижокОбработокСтаб;
	Стаб.СодержимоеРезультата = "{""КодВозврата"": 1, ""Сообщения"": [], ""Ошибка"": """"}";
	Сервис = СоздатьСервисСЗаглушкой(Стаб, "ТестоваяОбработка").Собрать();

	// Когда / Тогда
	Попытка
		Сервис.ВыполнитьОбработку("ТестоваяОбработка", Подключения.Файловая("C:\base"));
		ВызватьИсключение "должно было упасть";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("кодом возврата");
	КонецПопытки;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВызватьИсключение_ПриОшибкеВРезультате() Экспорт

	// Дано
	Стаб = Новый ДвижокОбработокСтаб;
	Стаб.СодержимоеРезультата = "{""КодВозврата"": 0, ""Сообщения"": [], ""Ошибка"": ""Что-то пошло не так""}";
	Сервис = СоздатьСервисСЗаглушкой(Стаб, "ТестоваяОбработка").Собрать();

	// Когда / Тогда
	Попытка
		Сервис.ВыполнитьОбработку("ТестоваяОбработка", Подключения.Файловая("C:\base"));
		ВызватьИсключение "должно было упасть";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("Что-то пошло не так");
	КонецПопытки;

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеУпасть_ЕслиОбработкаНеЗаписалаРезультат() Экспорт

	// Дано
	Стаб = Новый ДвижокОбработокСтаб;
	Стаб.ЗаписыватьРезультат = Ложь;
	Сервис = СоздатьСервисСЗаглушкой(Стаб, "ТестоваяОбработка").Собрать();
	Сервис.УстановитьТаймаутОжиданияРезультата(0);

	// Когда
	Результат = Сервис.ВыполнитьОбработку("ТестоваяОбработка", Подключения.Файловая("C:\base"));

	// Тогда - отсутствие файла результата трактуется как успех
	Ожидаем.Что(Результат.КодВозврата).Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВызватьИсключение_ПриАварийномЗавершенииПлатформы() Экспорт

	// Дано - платформа завершилась с кодом 1 и обработка не записала результат
	// (например, не удалось подключиться к ИБ или стартовать платформу)
	Стаб = Новый ДвижокОбработокСтаб;
	Стаб.ЗаписыватьРезультат = Ложь;
	Стаб.КодВозвратаПлатформы = 1;
	Сервис = СоздатьСервисСЗаглушкой(Стаб, "ТестоваяОбработка").Собрать();
	Сервис.УстановитьТаймаутОжиданияРезультата(0);

	// Когда / Тогда - ложного успеха быть не должно
	Попытка
		Сервис.ВыполнитьОбработку("ТестоваяОбработка", Подключения.Файловая("C:\base"));
		ВызватьИсключение "должно было упасть";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("кодом возврата");
	КонецПопытки;

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеУпасть_ЕслиОбработкаУспешнаНоПлатформаВернулаКодВозврата() Экспорт

	// Дано - обработка отработала успешно и записала файл результата (КодВозврата=0),
	// но процесс платформы завершился с кодом 1 (например, неудача в штатных
	// процедурах закрытия приложения). Это не должно трактоваться как ошибка.
	Стаб = Новый ДвижокОбработокСтаб;
	Стаб.СодержимоеРезультата = "{""КодВозврата"": 0, ""Сообщения"": [""Пользователь создан!""], ""Ошибка"": """"}";
	Стаб.КодВозвратаПлатформы = 1;
	Сервис = СоздатьСервисСЗаглушкой(Стаб, "ТестоваяОбработка").Собрать();

	// Когда
	Результат = Сервис.ВыполнитьОбработку("ТестоваяОбработка", Подключения.Файловая("C:\base"));

	// Тогда - файл результата авторитетнее кода возврата платформы
	Ожидаем.Что(Результат.КодВозврата).Равно(0);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Создаёт билдер сервиса с замоканным окружением, указывающим на временный корень
// с заглушкой epf/<ИмяОбработки>.epf.
Функция СоздатьСервисСЗаглушкой(Знач Движок = Неопределено, Знач ИмяОбработки = "ТестоваяОбработка")

	Если Движок = Неопределено Тогда
		Движок = Новый ДвижокОбработокСтаб;
	КонецЕсли;

	МокОкружения = Мок.Получить(Новый СервисОкружения);
	МокОкружения.Когда().КорневойКаталогПакета().ТогдаВозвращает(СоздатьКорневойКаталогСЗаглушкойEpf(ИмяОбработки));

	Возврат Новый БилдерСервисаЗапускаОбработок()
		.СДвижкомКонфигуратор(Движок)
		.СОкружением(МокОкружения);

КонецФункции

// Создаёт временный каталог со структурой epf/<ИмяОбработки>.epf -
// пустой заглушки достаточно: продакшен-код только проверяет существование файла.
Функция СоздатьКорневойКаталогСЗаглушкойEpf(Знач ИмяОбработки)
	КорневойКаталог = ВременныеФайлы.СоздатьКаталог();
	КаталогEpf = ОбъединитьПути(КорневойКаталог, "epf");
	СоздатьКаталог(КаталогEpf);
	ПутьКЗаглушке = ОбъединитьПути(КаталогEpf, ИмяОбработки + ".epf");
	Запись = Новый ЗаписьТекста(ПутьКЗаглушке, "UTF-8");
	Запись.Закрыть();
	Возврат КорневойКаталог;
КонецФункции

#КонецОбласти
