// BSLLS-off
// Юнит-тесты СервисЗапускаОбработок: строка параметров, путь к EPF, разбор JSON-результата,
// ошибки по коду возврата и файлу результата. Запуск платформы имитирует ДвижокОбработокСтаб,
// корень пакета подменён временным каталогом с заглушкой epf/<Имя>.epf.

#Использовать asserts
#Использовать moskito
#Использовать tempfiles
#Использовать "../utils"

Перем Стенд;
Перем Сервис;
Перем Движок; // ДвижокОбработокСтаб: пишет JSON результата по пути из КомандаЗапуска
Перем База;

&ПередКаждым
Процедура ПередКаждым() Экспорт
	Стенд = Новый Стенд;
	Стенд.Реальный("ФайловыеОперации");    // временный файл результата удаляется по-настоящему
	Стенд.Реальный("СервисВременнойБазы"); // движок конфигуратора берётся из соответствия движков
	Движок = Стенд.Подменить("ДвижокКонфигуратор", Новый ДвижокОбработокСтаб);
	Сервис = Стенд.Сервис("СервисЗапускаОбработок");
	База = ТестовыеДанные.Файловая("base");

	// Пустой заглушки достаточно: сервис только проверяет существование файла.
	Корень = ВременныеФайлы.СоздатьКаталог();
	ТестовыеФайлы.Файл(Корень, "epf/ТестоваяОбработка.epf");
	Стенд.Мок("СервисОкружения").Когда().КорневойКаталогПакета().ТогдаВозвращает(Корень);
КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт
	ВременныеФайлы.Удалить();
КонецПроцедуры

#Область ВыполнитьОбработку

&Тест
Процедура ТестДолжен_ВызватьИсключение_ЕслиОбработкаНеНайдена() Экспорт

	Ожидаем.Что(Сервис).Метод("ВыполнитьОбработку", ТестовыеДанные.Массив("НесуществующаяОбработка", База))
		.ВыбрасываетИсключение("не найдена");
	Ожидаем.Что(Движок.КоличествоЗапусков, "платформа не запускалась").Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыполнитьОбработку_УспешныйРезультат() Экспорт

	// Дано
	Движок.СодержимоеРезультата = "{""КодВозврата"": 0, ""Сообщения"": [""Готово""], ""Ошибка"": """"}";

	// Когда
	Результат = Сервис.ВыполнитьОбработку("ТестоваяОбработка", База);

	// Тогда
	Ожидаем.Что(Результат.КодВозврата).Равно(0);
	Ожидаем.Что(Результат.Сообщения).ИмеетДлину(1);
	Ожидаем.Что(Результат.Сообщения[0]).Равно("Готово");
	Ожидаем.Что(Движок.КоличествоЗапусков).Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПередатьПутьОбработки_ВДвижок() Экспорт

	// Когда
	Сервис.ВыполнитьОбработку("ТестоваяОбработка", База);

	// Тогда
	Ожидаем.Что(Движок.ПоследнийПутьОбработки).Содержит("ТестоваяОбработка.epf");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВызватьИсключение_ПриКодеВозвратаНеНоль() Экспорт

	// Дано
	Движок.СодержимоеРезультата = "{""КодВозврата"": 1, ""Сообщения"": [], ""Ошибка"": """"}";

	// Когда / Тогда
	Ожидаем.Что(Сервис).Метод("ВыполнитьОбработку", ТестовыеДанные.Массив("ТестоваяОбработка", База))
		.ВыбрасываетИсключение("кодом возврата");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВызватьИсключение_ПриОшибкеВРезультате() Экспорт

	// Дано
	Движок.СодержимоеРезультата = "{""КодВозврата"": 0, ""Сообщения"": [], ""Ошибка"": ""Что-то пошло не так""}";

	// Когда / Тогда
	Ожидаем.Что(Сервис).Метод("ВыполнитьОбработку", ТестовыеДанные.Массив("ТестоваяОбработка", База))
		.ВыбрасываетИсключение("Что-то пошло не так");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеУпасть_ЕслиОбработкаНеЗаписалаРезультат() Экспорт

	// Дано
	Движок.ЗаписыватьРезультат = Ложь;
	Сервис.УстановитьТаймаутОжиданияРезультата(0);

	// Когда
	Результат = Сервис.ВыполнитьОбработку("ТестоваяОбработка", База);

	// Тогда - отсутствие файла результата при коде платформы 0 трактуется как успех
	Ожидаем.Что(Результат.КодВозврата).Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВызватьИсключение_ПриАварийномЗавершенииПлатформы() Экспорт

	// Дано - платформа завершилась с кодом 1 и обработка не записала результат
	Движок.ЗаписыватьРезультат = Ложь;
	Движок.КодВозвратаПлатформы = 1;
	Сервис.УстановитьТаймаутОжиданияРезультата(0);

	// Когда / Тогда - ложного успеха быть не должно
	Ожидаем.Что(Сервис).Метод("ВыполнитьОбработку", ТестовыеДанные.Массив("ТестоваяОбработка", База))
		.ВыбрасываетИсключение("кодом возврата");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеУпасть_ЕслиОбработкаУспешнаНоПлатформаВернулаКодВозврата() Экспорт

	// Дано - обработка записала успешный результат, но лаунчер платформы завершился с кодом 1
	Движок.СодержимоеРезультата = "{""КодВозврата"": 0, ""Сообщения"": [""Пользователь создан!""], ""Ошибка"": """"}";
	Движок.КодВозвратаПлатформы = 1;

	// Когда
	Результат = Сервис.ВыполнитьОбработку("ТестоваяОбработка", База);

	// Тогда - файл результата авторитетнее кода возврата платформы
	Ожидаем.Что(Результат.КодВозврата).Равно(0);

КонецПроцедуры

#КонецОбласти

#Область СформироватьСтрокуПараметров

&Тест
Процедура ТестДолжен_СформироватьСтрокуПараметров_СФлагамиИЗначениями() Экспорт

	// Дано
	Параметры = Новый Структура("Имя, СоздатьАдминистратора, Пропустить", "Иванов", Истина, Ложь);

	// Когда
	Строка = Сервис.СформироватьСтрокуПараметров(Параметры, "res.json");

	// Тогда - Истина = голый флаг, Ложь пропускается
	Ожидаем.Что(Строка).Содержит("Имя=Иванов");
	Ожидаем.Что(Строка).Содержит("СоздатьАдминистратора");
	Ожидаем.Что(Строка).Не_().Содержит("Пропустить");
	Ожидаем.Что(Строка).Содержит("ФайлРезультата=res.json");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СформироватьСтрокуПараметров_БезПараметров() Экспорт

	// Когда
	Строка = Сервис.СформироватьСтрокуПараметров(Неопределено, "res.json");

	// Тогда
	Ожидаем.Что(Строка).Равно("ФайлРезультата=res.json");

КонецПроцедуры

#КонецОбласти
