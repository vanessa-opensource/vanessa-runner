// BSLLS-off
// Юнит-тесты ГенераторОтчетаAllure: запись результатов проверки в каталог allure-results.
//
// Проверяется контракт формата Allure 2: по файлу <uuid>-result.json на тест-кейс,
// обязательные поля кейса, метки для группировки и раскладка времени прогона.

#Использовать asserts
#Использовать tempfiles

#Использовать "../../../src/core/Сервисы"

Перем Генератор;
Перем Каталоги;

#Область СлужебныйПрограммныйИнтерфейс

&Тест
Процедура ТестДолжен_ЗаписатьПоФайлуНаКаждыйСлучай() Экспорт

	// Дано
	Каталог = НовыйКаталог();
	Случаи = Новый Массив;
	Случаи.Добавить(Генератор.НовыйСлучай("Замечание 1"));
	Случаи.Добавить(Генератор.НовыйСлучай("Замечание 2"));

	// Когда
	Записано = Генератор.Записать(Каталог, Случаи, Дата(2026, 8, 27, 10, 0, 0), 4);

	// Тогда
	Ожидаем.Что(Записано, "записано файлов").Равно(2);
	Ожидаем.Что(НайтиРезультаты(Каталог).Количество(), "файлов в каталоге").Равно(2);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗаписатьОбязательныеПоляКейса() Экспорт

	// Дано
	Каталог = НовыйКаталог();
	Случай = Генератор.НовыйСлучай("Справочник.Справочник1.МодульОбъекта");
	Случай.Сообщение = "(4,1): Определения процедур должны идти после текста модуля";
	Случай.Пакет = "Справочник.Справочник1.МодульОбъекта";
	Случай.Важность = "critical";

	Случаи = Новый Массив;
	Случаи.Добавить(Случай);

	// Когда
	Генератор.Записать(Каталог, Случаи, Дата(2026, 8, 27, 10, 0, 0), 2);

	// Тогда
	Результат = ПрочитатьЕдинственныйРезультат(Каталог);
	Ожидаем.Что(Результат.Получить("name"), "имя кейса").Равно("Справочник.Справочник1.МодульОбъекта");
	Ожидаем.Что(Результат.Получить("fullName"), "полное имя с набором")
		.Равно("syntax-check.Справочник.Справочник1.МодульОбъекта");
	// historyId связывает кейс с историей между прогонами, поэтому это имя, а не uuid
	Ожидаем.Что(Результат.Получить("historyId"), "historyId").Равно(Результат.Получить("fullName"));
	Ожидаем.Что(Результат.Получить("status"), "статус").Равно("failed");
	Ожидаем.Что(Результат.Получить("stage"), "стадия").Равно("finished");
	Ожидаем.Что(Результат.Получить("uuid"), "uuid").Заполнено();
	Ожидаем.Что(Результат.Получить("statusDetails").Получить("message"), "текст замечания")
		.Равно("(4,1): Определения процедур должны идти после текста модуля");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗаписатьМеткиДляГруппировки() Экспорт

	// Дано
	Каталог = НовыйКаталог();
	Случай = Генератор.НовыйСлучай("Замечание");
	Случай.Пакет = "ОбщийМодуль.ОбщегоНазначения.Модуль";
	Случай.Важность = "minor";

	Случаи = Новый Массив;
	Случаи.Добавить(Случай);

	// Когда
	Генератор.Записать(Каталог, Случаи, Дата(2026, 8, 27, 10, 0, 0), 1);

	// Тогда
	Метки = МеткиРезультата(ПрочитатьЕдинственныйРезультат(Каталог));
	Ожидаем.Что(Метки.Получить("suite"), "метка suite").Равно("syntax-check");
	Ожидаем.Что(Метки.Получить("package"), "метка package").Равно("ОбщийМодуль.ОбщегоНазначения.Модуль");
	Ожидаем.Что(Метки.Получить("severity"), "метка severity").Равно("minor");
	Ожидаем.Что(Метки.Получить("framework"), "метка framework").Равно("vanessa-runner");

КонецПроцедуры

// Пакет у замечания есть не всегда (строка лога без объекта метаданных): пустую метку
// в отчёт писать нельзя, Allure покажет её пустым узлом дерева.
&Тест
Процедура ТестДолжен_ПропуститьПустуюМетку() Экспорт

	// Дано
	Каталог = НовыйКаталог();
	Случаи = Новый Массив;
	Случаи.Добавить(Генератор.НовыйСлучай("Замечание без объекта"));

	// Когда
	Генератор.Записать(Каталог, Случаи, Дата(2026, 8, 27, 10, 0, 0), 1);

	// Тогда
	Метки = МеткиРезультата(ПрочитатьЕдинственныйРезультат(Каталог));
	Ожидаем.Что(Метки.Получить("package") = Неопределено, "метка package не записана").ЭтоИстина();

КонецПроцедуры

// У успешного кейса нечего показывать в карточке - statusDetails не пишем.
&Тест
Процедура ТестДолжен_ЗаписатьУспешныйКейсБезДеталей() Экспорт

	// Дано
	Каталог = НовыйКаталог();
	Случаи = Новый Массив;
	Случаи.Добавить(Генератор.НовыйСлучай("Синтаксическая проверка конфигурации", "passed"));

	// Когда
	Генератор.Записать(Каталог, Случаи, Дата(2026, 8, 27, 10, 0, 0), 1);

	// Тогда
	Результат = ПрочитатьЕдинственныйРезультат(Каталог);
	Ожидаем.Что(Результат.Получить("status"), "статус").Равно("passed");
	Ожидаем.Что(Результат.Получить("statusDetails") = Неопределено, "деталей нет").ЭтоИстина();

КонецПроцедуры

// Время прогона делится между кейсами: одинаковые start/stop у всех кейсов превращают
// в отчёте длительность прогона в сумму длительностей всех кейсов.
&Тест
Процедура ТестДолжен_РазложитьВремяПрогонаПоКейсамПоследовательно() Экспорт

	// Дано
	Каталог = НовыйКаталог();
	ДатаНачала = Дата(2026, 8, 27, 10, 0, 0);
	НачалоМс = (ДатаНачала - Дата(1970, 1, 1)) * 1000;

	Случаи = Новый Массив;
	Случаи.Добавить(Генератор.НовыйСлучай("Замечание 1"));
	Случаи.Добавить(Генератор.НовыйСлучай("Замечание 2"));
	Случаи.Добавить(Генератор.НовыйСлучай("Замечание 3"));

	// Когда
	Генератор.Записать(Каталог, Случаи, ДатаНачала, 3);

	// Тогда - кейсы идут встык, весь прогон укладывается в заданную длительность
	Отрезки = ОтрезкиВремени(Каталог);
	Ожидаем.Что(Отрезки.Количество(), "кейсов").Равно(3);
	Ожидаем.Что(Отрезки[0].start, "начало первого кейса").Равно(НачалоМс);
	Ожидаем.Что(Отрезки[0].stop, "окончание первого кейса").Равно(НачалоМс + 1000);
	Ожидаем.Что(Отрезки[1].start, "начало второго кейса").Равно(Отрезки[0].stop);
	Ожидаем.Что(Отрезки[2].stop, "окончание последнего кейса").Равно(НачалоМс + 3000);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьКаталогРезультатов_ЕслиЕгоНет() Экспорт

	// Дано - вложенный каталог, которого нет (build/ в репозиториях не хранят)
	Каталог = ОбъединитьПути(НовыйКаталог(), "build", "allure-results");
	Случаи = Новый Массив;
	Случаи.Добавить(Генератор.НовыйСлучай("Замечание"));

	// Когда
	Генератор.Записать(Каталог, Случаи, Дата(2026, 8, 27, 10, 0, 0), 1);

	// Тогда
	Ожидаем.Что(Новый Файл(Каталог).Существует(), "каталог создан").ЭтоИстина();
	Ожидаем.Что(НайтиРезультаты(Каталог).Количество(), "файлов в каталоге").Равно(1);

КонецПроцедуры

// Каталог результатов не очищается: allure собирает отчёт из нескольких прогонов,
// и очистка затирала бы результаты соседних проверок той же сборки.
&Тест
Процедура ТестДолжен_ДополнитьКаталогРезультатовПовторнымПрогоном() Экспорт

	// Дано
	Каталог = НовыйКаталог();
	Случаи = Новый Массив;
	Случаи.Добавить(Генератор.НовыйСлучай("Замечание"));

	// Когда
	Генератор.Записать(Каталог, Случаи, Дата(2026, 8, 27, 10, 0, 0), 1);
	Генератор.Записать(Каталог, Случаи, Дата(2026, 8, 27, 10, 1, 0), 1);

	// Тогда
	Ожидаем.Что(НайтиРезультаты(Каталог).Количество(), "файлов после двух прогонов").Равно(2);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НичегоНеЗаписать_БезСлучаев() Экспорт

	// Дано
	Каталог = НовыйКаталог();

	// Когда
	Записано = Генератор.Записать(Каталог, Новый Массив, Дата(2026, 8, 27, 10, 0, 0), 1);

	// Тогда
	Ожидаем.Что(Записано, "записано файлов").Равно(0);
	Ожидаем.Что(НайтиРезультаты(Каталог).Количество(), "файлов в каталоге").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	Генератор = Новый ГенераторОтчетаAllure("syntax-check");
	Каталоги = Новый Массив;
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	Для Каждого Каталог Из Каталоги Цикл
		Попытка
			УдалитьФайлы(Каталог);
		Исключение
			// не критично для теста
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыйКаталог()
	Каталог = ВременныеФайлы.СоздатьКаталог();
	Каталоги.Добавить(Каталог);
	Возврат Каталог;
КонецФункции

Функция НайтиРезультаты(Знач Каталог)
	Если НЕ Новый Файл(Каталог).Существует() Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Возврат НайтиФайлы(Каталог, "*-result.json");
КонецФункции

Функция ПрочитатьРезультат(Знач ПутьФайла)
	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(ПутьФайла);
	Данные = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Данные;
КонецФункции

Функция ПрочитатьЕдинственныйРезультат(Знач Каталог)
	Файлы = НайтиРезультаты(Каталог);
	Ожидаем.Что(Файлы.Количество(), "файлов результата").Равно(1);
	Возврат ПрочитатьРезультат(Файлы[0].ПолноеИмя);
КонецФункции

// Метки кейса в виде соответствия "имя метки -> значение".
Функция МеткиРезультата(Знач Результат)
	Метки = Новый Соответствие;
	Для Каждого Метка Из Результат.Получить("labels") Цикл
		Метки.Вставить(Метка.Получить("name"), Метка.Получить("value"));
	КонецЦикла;
	Возврат Метки;
КонецФункции

// Отрезки времени всех кейсов каталога, упорядоченные по началу: имя файла - uuid,
// поэтому порядок обхода каталога о порядке кейсов ничего не говорит.
Функция ОтрезкиВремени(Знач Каталог)

	Отрезки = Новый Массив;
	Для Каждого Файл Из НайтиРезультаты(Каталог) Цикл
		Результат = ПрочитатьРезультат(Файл.ПолноеИмя);
		Отрезки.Добавить(Новый Структура("start, stop",
			Результат.Получить("start"), Результат.Получить("stop")));
	КонецЦикла;

	Для Внешний = 0 По Отрезки.ВГраница() Цикл
		Для Внутренний = 0 По Отрезки.ВГраница() - Внешний - 1 Цикл
			Если Отрезки[Внутренний].start > Отрезки[Внутренний + 1].start Тогда
				Буфер = Отрезки[Внутренний];
				Отрезки[Внутренний] = Отрезки[Внутренний + 1];
				Отрезки[Внутренний + 1] = Буфер;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Отрезки;

КонецФункции

#КонецОбласти
