// BSLLS-off
// Юнит-тесты СервисИсточников: исходники в целевом формате из файла *.cf/*.cfe или каталога.
// Разборка файлов и подготовка каталогов замоканы; проверяются маршрутизация по виду источника,
// параметры разборки и освобождение временного каталога.

#Использовать asserts
#Использовать moskito
#Использовать tempfiles

#Использовать "../../../src/core/Сервисы"
#Использовать "../utils"

Перем Любое;
Перем ПараметрыВызова;

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	Любое = Матчеры.ЛюбоеЗначение();
	ПараметрыВызова = Неопределено;
КонецПроцедуры

#Область Обеспечить

// Файл *.cf разбирается в <временный каталог>/<имя файла> сразу в целевом формате;
// входные параметры исходников не меняются, СервисEDT не участвует.
&ПараметризованныйТест
&ИсточникЗначение("xml")
&ИсточникЗначение("edt")
Процедура ТестДолжен_РазобратьCf_ВоВременныйКаталогВЦелевомФормате(ЦелевойФормат) Экспорт

	// Дано
	ПутьCf = СоздатьФайлИсточника("1cv8.cf");
	ПараметрыИсходников = Новый Структура("Формат, Версия", "auto", "2024.1");
	ПараметрыПлатформы = Новый Структура("Версия", "8.3.25");

	МокКонфигурации = Мок.Получить(Тип("СервисКонфигурации"));
	МокКонфигурации.Когда().РазобратьКонфигурациюВИсходники(Любое, Любое, Любое, Любое, Любое, Любое)
		.ТогдаОтвечает(Новый Ответ(ЭтотОбъект, "ЗапомнитьПараметры"));
	Сервис = Новый БилдерСервисаИсточников()
		.СКонфигурацией(МокКонфигурации)
		.СEDT(МокEDTБезПодготовки())
		.Собрать();

	// Когда
	Контекст = Сервис.Обеспечить(ПутьCf, ЦелевойФормат, ПараметрыИсходников, Истина, ПараметрыПлатформы);

	// Тогда
	Ожидаем.Что(Контекст.Временный, "временный").ЭтоИстина();
	Ожидаем.Что(Контекст.ЭтоEDT, "на входе не EDT-проект").ЭтоЛожь();
	Ожидаем.Что(Контекст.КаталогEDT).Равно("");
	Ожидаем.Что(Новый Файл(Контекст.ВременныйКаталог).ЭтоКаталог(), "временный каталог создан").ЭтоИстина();
	Ожидаем.Что(Контекст.Путь, "каталог по имени файла").Равно(ОбъединитьПути(Контекст.ВременныйКаталог, "1cv8"));
	Ожидаем.Что(Контекст.ПараметрыИсходников.Формат, "формат контекста").Равно(ЦелевойФормат);

	МокКонфигурации.ПроверитьЧтоВызывалсяМетод().РазобратьКонфигурациюВИсходники(
		ПутьCf, Контекст.Путь, Истина, ПараметрыПлатформы, Неопределено, Любое);
	Ожидаем.Что(ПараметрыВызова[5].Формат, "формат разборки").Равно(ЦелевойФормат);
	Ожидаем.Что(ПараметрыВызова[5].Версия, "остальные параметры сохранены").Равно("2024.1");
	Ожидаем.Что(ПараметрыИсходников.Формат, "входная структура не изменена").Равно("auto");

КонецПроцедуры

// Имя расширения - имя файла *.cfe без расширения; конфигурация не разбирается.
&Тест
Процедура ТестДолжен_РазобратьCfe_СИменемРасширенияИзФайла() Экспорт

	// Дано
	ПутьCfe = СоздатьФайлИсточника("my_ext.cfe");
	МокРасширений = Мок.Получить(Тип("СервисРасширений"));
	Сервис = Новый БилдерСервисаИсточников()
		.СКонфигурацией(МокКонфигурацииБезРазборки())
		.СРасширениями(МокРасширений)
		.Собрать();

	// Когда
	Контекст = Сервис.Обеспечить(ПутьCfe, "xml");

	// Тогда
	Ожидаем.Что(Контекст.Путь).Равно(ОбъединитьПути(Контекст.ВременныйКаталог, "my_ext"));
	МокРасширений.ПроверитьЧтоВызывалсяМетод().ПроверитьИмяРасширения("my_ext");
	МокРасширений.ПроверитьЧтоВызывалсяМетод().РазобратьРасширениеВИсходники(
		ПутьCfe, Контекст.Путь, "my_ext", Ложь, Неопределено, Неопределено, Любое);

КонецПроцедуры

// Каталог исходников готовит СервисEDT с параметрами пользователя как есть; в контекст добавляются
// параметры в целевом формате. Сервисы разборки собраны без зависимостей - их вызов уронил бы тест.
&ПараметризованныйТест
&ИсточникЗначение("xml")
&ИсточникЗначение("edt")
Процедура ТестДолжен_ДелегироватьКаталог_СервисуEDT(ЦелевойФормат) Экспорт

	// Дано
	Каталог = ВременныеФайлы.СоздатьКаталог();
	СоздатьФайл(Каталог, "Configuration.xml");
	ПараметрыИсходников = Новый Структура("Формат", "auto");
	КонтекстEDT = Новый Структура("Путь, Временный, ЭтоEDT, КаталогEDT, ВременныйКаталог",
		Каталог, Ложь, Ложь, "", "");

	МокEDT = Мок.Получить(Тип("СервисEDT"));
	МокEDT.Когда().ПодготовитьИсходники(Любое, Любое, Любое).ТогдаВозвращает(КонтекстEDT);
	Сервис = Новый БилдерСервисаИсточников().СEDT(МокEDT).Собрать();

	// Когда
	Контекст = Сервис.Обеспечить(Каталог, ЦелевойФормат, ПараметрыИсходников);

	// Тогда
	Ожидаем.Что(Контекст.Путь).Равно(Каталог);
	Ожидаем.Что(Контекст.Временный).ЭтоЛожь();
	Ожидаем.Что(Контекст.ПараметрыИсходников.Формат, "формат контекста").Равно(ЦелевойФормат);
	МокEDT.ПроверитьЧтоВызывалсяМетод().ПодготовитьИсходники(Каталог, ЦелевойФормат, ПараметрыИсходников);

КонецПроцедуры

// Каталог без маркеров (вид "") - тоже каталог: делегируется СервисEDT.
&Тест
Процедура ТестДолжен_ДелегироватьКаталогБезМаркеров_СервисуEDT() Экспорт

	// Дано
	Каталог = ВременныеФайлы.СоздатьКаталог();
	МокEDT = Мок.Получить(Тип("СервисEDT"));
	МокEDT.Когда().ПодготовитьИсходники(Любое, Любое, Любое).ТогдаВозвращает(Новый Структура("Путь", Каталог));
	Сервис = Новый БилдерСервисаИсточников().СEDT(МокEDT).Собрать();

	// Когда
	Контекст = Сервис.Обеспечить(Каталог, "edt");

	// Тогда
	Ожидаем.Что(Контекст.Путь).Равно(Каталог);
	МокEDT.ПроверитьЧтоВызывалсяМетод().ПодготовитьИсходники(Каталог, "edt", Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыброситьОшибку_ДляВыгрузкиDt() Экспорт

	Сервис = Новый БилдерСервисаИсточников().СEDT(МокEDTБезПодготовки()).Собрать();

	Ошибка = ОшибкаОбеспечения(Сервис, СоздатьФайлИсточника("base.dt"));

	Ожидаем.Что(Ошибка).Содержит("не поддерживается как источник исходников");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыброситьОшибку_ЕслиФайлНеНайден() Экспорт

	Сервис = Новый БилдерСервисаИсточников().СКонфигурацией(МокКонфигурацииБезРазборки()).Собрать();

	Ошибка = ОшибкаОбеспечения(Сервис, ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "x.cf"));

	Ожидаем.Что(Ошибка).Содержит("Файл источника не найден");

КонецПроцедуры

// Ошибка разборки: созданный временный каталог освобождается, исключение пробрасывается.
&Тест
Процедура ТестДолжен_ОсвободитьВременныйКаталог_ПриОшибкеРазборки() Экспорт

	// Дано
	МокКонфигурации = Мок.Получить(Тип("СервисКонфигурации"));
	МокКонфигурации.Когда().РазобратьКонфигурациюВИсходники(Любое, Любое, Любое, Любое, Любое, Любое)
		.ТогдаВыбрасываетИсключение("Ошибка загрузки cf");
	МокEDT = Мок.Получить(Тип("СервисEDT"));
	МокEDT.Когда().ЗавершитьИсходники(Любое).ТогдаОтвечает(Новый Ответ(ЭтотОбъект, "ЗапомнитьПараметры"));
	Сервис = Новый БилдерСервисаИсточников().СКонфигурацией(МокКонфигурации).СEDT(МокEDT).Собрать();

	// Когда
	Ошибка = ОшибкаОбеспечения(Сервис, СоздатьФайлИсточника("1cv8.cf"));

	// Тогда
	Ожидаем.Что(Ошибка, "исходное исключение").Содержит("Ошибка загрузки cf");
	Контекст = ПараметрыВызова[0];
	Ожидаем.Что(Контекст.Временный, "освобождается временный контекст").ЭтоИстина();
	Ожидаем.Что(Новый Файл(Контекст.ВременныйКаталог).ЭтоКаталог(), "созданный каталог").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Освободить

// Освобождение через СервисEDT удаляет временный каталог разборки.
&Тест
Процедура ТестДолжен_УдалитьВременныйКаталог_ПриОсвобождении() Экспорт

	// Дано - разборка замокана пустышкой, СервисEDT настоящий
	Сервис = Новый БилдерСервисаИсточников().СКонфигурацией(Мок.Получить(Тип("СервисКонфигурации"))).Собрать();
	Контекст = Сервис.Обеспечить(СоздатьФайлИсточника("1cv8.cf"), "xml");

	// Когда
	Сервис.Освободить(Контекст);

	// Тогда
	Ожидаем.Что(Новый Файл(Контекст.ВременныйКаталог).Существует(), "временный каталог удалён").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Обработчик ответа мока: запоминает фактические параметры вызова.
Функция ЗапомнитьПараметры(ИнформацияОВызове) Экспорт
	ПараметрыВызова = ИнформацияОВызове.Параметры();
	Возврат Неопределено;
КонецФункции

// Текст исключения Обеспечить(Путь, "xml"); отсутствие исключения - провал.
Функция ОшибкаОбеспечения(Знач Сервис, Знач Путь)
	Попытка
		Сервис.Обеспечить(Путь, "xml");
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
	ВызватьИсключение "Ожидалось исключение для " + Путь;
КонецФункции

// Моки, падающие при вызове: так проверяется, что метод не вызывался.
Функция МокEDTБезПодготовки()
	МокEDT = Мок.Получить(Тип("СервисEDT"));
	МокEDT.Когда().ПодготовитьИсходники(Любое, Любое, Любое)
		.ТогдаВыбрасываетИсключение("ПодготовитьИсходники не должен вызываться");
	Возврат МокEDT;
КонецФункции

Функция МокКонфигурацииБезРазборки()
	МокКонфигурации = Мок.Получить(Тип("СервисКонфигурации"));
	МокКонфигурации.Когда().РазобратьКонфигурациюВИсходники(Любое, Любое, Любое, Любое, Любое, Любое)
		.ТогдаВыбрасываетИсключение("РазобратьКонфигурациюВИсходники не должен вызываться");
	Возврат МокКонфигурации;
КонецФункции

Функция СоздатьФайлИсточника(Знач Имя)
	Возврат СоздатьФайл(ВременныеФайлы.СоздатьКаталог(), Имя);
КонецФункции

Функция СоздатьФайл(Знач Каталог, Знач Имя)
	Путь = ОбъединитьПути(Каталог, Имя);
	Запись = Новый ЗаписьТекста(Путь);
	Запись.Закрыть();
	Возврат Путь;
КонецФункции

#КонецОбласти
