// BSLLS-off
// Юнит-тесты СервисИсточников: исходники в целевом формате из файла *.cf/*.cfe или каталога -
// маршрутизация по виду источника, параметры разборки, освобождение временного каталога.
// Разборка (СервисКонфигурации, СервисРасширений) и подготовка каталогов (СервисEDT) замоканы.

#Использовать asserts
#Использовать moskito
#Использовать tempfiles
#Использовать "../utils"

Перем Стенд;
Перем Сервис;
Перем Любое;

&ПередКаждым
Процедура ПередКаждым() Экспорт
	Стенд = Новый Стенд;
	Стенд.Реальный("ФайловыеОперации");       // проверка существования файла источника
	Стенд.Реальный("СервисПоискаИсточников"); // вид источника определяется по расширению и маркерам на диске
	Сервис = Стенд.Сервис("СервисИсточников");
	Любое = Матчеры.ЛюбоеЗначение();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт
	ВременныеФайлы.Удалить();
КонецПроцедуры

#Область Обеспечить

// Файл *.cf разбирается в <временный каталог>/<имя файла> сразу в целевом формате;
// входные параметры исходников не меняются, СервисEDT не участвует.
&ПараметризованныйТест
&ИсточникЗначение("xml")
&ИсточникЗначение("edt")
Процедура ТестДолжен_РазобратьCf_ВоВременныйКаталогВЦелевомФормате(ЦелевойФормат) Экспорт

	// Дано
	ПутьCf = ТестовыеФайлы.ВременныйФайл("cf");
	ПараметрыИсходников = ТестовыеДанные.ПараметрыИсходников("auto", "2024.1");
	ПараметрыПлатформы = Новый Структура("Версия", "8.3.25");

	// Когда
	Контекст = Сервис.Обеспечить(ПутьCf, ЦелевойФормат, ПараметрыИсходников, Истина, ПараметрыПлатформы);

	// Тогда
	Ожидаем.Что(Контекст.Временный, "временный").ЭтоИстина();
	Ожидаем.Что(Контекст.ЭтоEDT, "на входе не EDT-проект").ЭтоЛожь();
	Ожидаем.Что(Контекст.КаталогEDT).Равно("");
	Ожидаем.Что(ТестовыеФайлы.Существует(Контекст.ВременныйКаталог), "временный каталог создан").ЭтоИстина();
	Ожидаем.Что(Контекст.Путь, "каталог по имени файла")
		.Равно(ОбъединитьПути(Контекст.ВременныйКаталог, Новый Файл(ПутьCf).ИмяБезРасширения));
	Ожидаем.Что(Контекст.ПараметрыИсходников.Формат, "формат контекста").Равно(ЦелевойФормат);

	Стенд.Мок("СервисКонфигурации").ПроверитьЧтоВызывалсяМетод().РазобратьКонфигурациюВИсходники(
		ПутьCf, Контекст.Путь, Истина, ПараметрыПлатформы, Неопределено, Любое);
	ПараметрыРазборки = Стенд.Вызовы("СервисКонфигурации", "РазобратьКонфигурациюВИсходники")[0].ПараметрыИсходников;
	Ожидаем.Что(ПараметрыРазборки.Формат, "формат разборки").Равно(ЦелевойФормат);
	Ожидаем.Что(ПараметрыРазборки.Версия, "остальные параметры сохранены").Равно("2024.1");
	Ожидаем.Что(ПараметрыИсходников.Формат, "входная структура не изменена").Равно("auto");
	Стенд.ПроверитьЧтоНеВызывался("СервисEDT", "ПодготовитьИсходники");

КонецПроцедуры

// Имя расширения - имя файла *.cfe без расширения; конфигурация не разбирается.
&Тест
Процедура ТестДолжен_РазобратьCfe_СИменемРасширенияИзФайла() Экспорт

	// Дано
	ПутьCfe = ТестовыеФайлы.ВременныйФайл("cfe");
	ИмяРасширения = Новый Файл(ПутьCfe).ИмяБезРасширения;

	// Когда
	Контекст = Сервис.Обеспечить(ПутьCfe, "xml");

	// Тогда
	Ожидаем.Что(Контекст.Путь).Равно(ОбъединитьПути(Контекст.ВременныйКаталог, ИмяРасширения));
	Расширения = Стенд.Мок("СервисРасширений");
	Расширения.ПроверитьЧтоВызывалсяМетод().ПроверитьИмяРасширения(ИмяРасширения);
	Расширения.ПроверитьЧтоВызывалсяМетод().РазобратьРасширениеВИсходники(
		ПутьCfe, Контекст.Путь, ИмяРасширения, Ложь, Неопределено, Неопределено, Любое);
	Стенд.ПроверитьЧтоНеВызывался("СервисКонфигурации", "РазобратьКонфигурациюВИсходники");

КонецПроцедуры

// Каталог исходников готовит СервисEDT с параметрами пользователя как есть; в контекст добавляются
// параметры в целевом формате. Сервисы разборки не вызываются.
&ПараметризованныйТест
&ИсточникЗначение("xml")
&ИсточникЗначение("edt")
Процедура ТестДолжен_ДелегироватьКаталог_СервисуEDT(ЦелевойФормат) Экспорт

	// Дано
	Каталог = ТестовыеФайлы.КаталогXML();
	ПараметрыИсходников = ТестовыеДанные.ПараметрыИсходников();
	Стенд.Мок("СервисEDT").Когда().ПодготовитьИсходники(Любое, Любое, Любое)
		.ТогдаВозвращает(ТестовыеДанные.КонтекстXML(Каталог));

	// Когда
	Контекст = Сервис.Обеспечить(Каталог, ЦелевойФормат, ПараметрыИсходников);

	// Тогда
	Ожидаем.Что(Контекст.Путь).Равно(Каталог);
	Ожидаем.Что(Контекст.Временный).ЭтоЛожь();
	Ожидаем.Что(Контекст.ПараметрыИсходников.Формат, "формат контекста").Равно(ЦелевойФормат);
	Стенд.Мок("СервисEDT").ПроверитьЧтоВызывалсяМетод().ПодготовитьИсходники(Каталог, ЦелевойФормат, ПараметрыИсходников);
	Стенд.ПроверитьЧтоНеВызывался("СервисКонфигурации", "РазобратьКонфигурациюВИсходники");
	Стенд.ПроверитьЧтоНеВызывался("СервисРасширений", "РазобратьРасширениеВИсходники");

КонецПроцедуры

// Каталог без маркеров (вид "") - тоже каталог: делегируется СервисEDT.
&Тест
Процедура ТестДолжен_ДелегироватьКаталогБезМаркеров_СервисуEDT() Экспорт

	// Дано
	Каталог = ВременныеФайлы.СоздатьКаталог();
	Стенд.Мок("СервисEDT").Когда().ПодготовитьИсходники(Любое, Любое, Любое).ТогдаВозвращает(Новый Структура("Путь", Каталог));

	// Когда
	Контекст = Сервис.Обеспечить(Каталог, "edt");

	// Тогда
	Ожидаем.Что(Контекст.Путь).Равно(Каталог);
	Стенд.Мок("СервисEDT").ПроверитьЧтоВызывалсяМетод().ПодготовитьИсходники(Каталог, "edt", Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыброситьОшибку_ДляВыгрузкиDt() Экспорт

	Ожидаем.Что(Сервис).Метод("Обеспечить", ТестовыеДанные.Массив(ТестовыеФайлы.ВременныйФайл("dt"), "xml"))
		.ВыбрасываетИсключение("не поддерживается как источник исходников");
	Стенд.ПроверитьЧтоНеВызывался("СервисEDT", "ПодготовитьИсходники");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыброситьОшибку_ЕслиФайлНеНайден() Экспорт

	Ожидаем.Что(Сервис).Метод("Обеспечить", ТестовыеДанные.Массив(ТестовыеФайлы.НесуществующийПуть("x.cf"), "xml"))
		.ВыбрасываетИсключение("Файл источника не найден");
	Стенд.ПроверитьЧтоНеВызывался("СервисКонфигурации", "РазобратьКонфигурациюВИсходники");

КонецПроцедуры

// Ошибка разборки: созданный временный каталог освобождается, исключение пробрасывается.
&Тест
Процедура ТестДолжен_ОсвободитьВременныйКаталог_ПриОшибкеРазборки() Экспорт

	// Дано
	Стенд.Мок("СервисКонфигурации").Когда().РазобратьКонфигурациюВИсходники(Любое, Любое, Любое, Любое, Любое, Любое)
		.ТогдаВыбрасываетИсключение("Ошибка загрузки cf");

	// Когда / Тогда
	Ожидаем.Что(Сервис).Метод("Обеспечить", ТестовыеДанные.Массив(ТестовыеФайлы.ВременныйФайл("cf"), "xml"))
		.ВыбрасываетИсключение("Ошибка загрузки cf");
	Контекст = Стенд.Вызовы("СервисEDT", "ЗавершитьИсходники")[0].Контекст;
	Ожидаем.Что(Контекст.Временный, "освобождается временный контекст").ЭтоИстина();
	Ожидаем.Что(ТестовыеФайлы.Существует(Контекст.ВременныйКаталог), "созданный каталог").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Освободить

// Освобождение через СервисEDT удаляет временный каталог разборки.
&Тест
Процедура ТестДолжен_УдалитьВременныйКаталог_ПриОсвобождении() Экспорт

	// Дано - разборка замокана пустышкой, временный каталог удаляет настоящий СервисEDT
	Стенд.Реальный("СервисEDT");
	Контекст = Сервис.Обеспечить(ТестовыеФайлы.ВременныйФайл("cf"), "xml");

	// Когда
	Сервис.Освободить(Контекст);

	// Тогда
	Ожидаем.Что(ТестовыеФайлы.Существует(Контекст.ВременныйКаталог), "временный каталог удалён").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти
