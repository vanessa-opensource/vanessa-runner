// BSLLS-off
// Юнит-тесты маппинга покрытия (КонвертерПокрытия + КонвертерИсходников + ЗаписьStatJson).
// Фикстуры EDT/XML создаются во временном каталоге прямо в тесте (без реальной 1С).
//
// Проверяется сопоставление "вид модуля + ObjectID -> файл исходника" для конфигурации
// и расширения в форматах EDT и XML-дампа, а также запись в формат stat.json.

#Использовать asserts
#Использовать tempfiles

#Использовать "../../../src/core/Покрытие"

Перем ОбщийМодуль;
Перем МодульОбъекта;
Перем МодульМенеджера;

Перем Корни;

#Область СлужебныйПрограммныйИнтерфейс

&Тест
Процедура ТестДолжен_СопоставитьМодулиКонфигурацииEDT() Экспорт

	// Дано - EDT-проект с общим модулем и справочником
	Проект = НовыйКаталог();
	СоздатьМдо(Проект, "src/CommonModules/ОМ1", "ОМ1.mdo", "u-om");
	ЗаписатьФайл(Проект, "src/CommonModules/ОМ1/Module.bsl", "А = 1;");
	СоздатьМдо(Проект, "src/Catalogs/Спр1", "Спр1.mdo", "u-cat");
	ЗаписатьФайл(Проект, "src/Catalogs/Спр1/ObjectModule.bsl", "Б = 2;");
	ЗаписатьФайл(Проект, "src/Catalogs/Спр1/ManagerModule.bsl", "В = 3;");

	СырыеДанные = НовыеСырыеДанные();
	ДобавитьЗамерКонфигурации(СырыеДанные, ОбщийМодуль, "u-om", 1, 2);
	ДобавитьЗамерКонфигурации(СырыеДанные, МодульОбъекта, "u-cat", 1, 1);
	ДобавитьЗамерКонфигурации(СырыеДанные, МодульМенеджера, "u-cat", 1, 5);
	ФайлСырых = ЗаписатьСырыеДанные(СырыеДанные);

	Конвертер = Новый КонвертерПокрытия();
	Конвертер.УстановитьКонфигурацию(Проект, "EDT");

	// Когда
	Покрытие = Конвертер.Конвертировать(ФайлСырых);

	// Тогда - три модуля сопоставлены
	Ожидаем.Что(Покрытие.Количество(), "сопоставлено файлов").Равно(3);
	ПроверитьЕстьФайл(Покрытие, Проект, "src/CommonModules/ОМ1/Module.bsl");
	ПроверитьЕстьФайл(Покрытие, Проект, "src/Catalogs/Спр1/ObjectModule.bsl");
	ПроверитьЕстьФайл(Покрытие, Проект, "src/Catalogs/Спр1/ManagerModule.bsl");

КонецПроцедуры

&Тест
Процедура ТестДолжен_УчестьЧастотуКакCount() Экспорт

	// Дано
	Проект = НовыйКаталог();
	СоздатьМдо(Проект, "src/CommonModules/ОМ1", "ОМ1.mdo", "u-om");
	ЗаписатьФайл(Проект, "src/CommonModules/ОМ1/Module.bsl", "А = 1;");

	СырыеДанные = НовыеСырыеДанные();
	ДобавитьЗамерКонфигурации(СырыеДанные, ОбщийМодуль, "u-om", 7, 42);
	ФайлСырых = ЗаписатьСырыеДанные(СырыеДанные);

	Конвертер = Новый КонвертерПокрытия();
	Конвертер.УстановитьКонфигурацию(Проект, "EDT");

	// Когда
	Покрытие = Конвертер.Конвертировать(ФайлСырых);

	// Тогда - строка 7 с count = 42
	Файл = ПутьФайла(Проект, "src/CommonModules/ОМ1/Module.bsl");
	Строки = Покрытие.Получить(Файл);
	Ожидаем.Что(Строки, "строки файла").Заполнено();
	Ожидаем.Что(Строки.Получить("7").count, "частота строки 7").Равно(42);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИгнорироватьНеизвестныйМодуль() Экспорт

	// Дано - замер ссылается на объект, которого нет в исходниках
	Проект = НовыйКаталог();
	СоздатьМдо(Проект, "src/CommonModules/ОМ1", "ОМ1.mdo", "u-om");
	ЗаписатьФайл(Проект, "src/CommonModules/ОМ1/Module.bsl", "А = 1;");

	СырыеДанные = НовыеСырыеДанные();
	ДобавитьЗамерКонфигурации(СырыеДанные, ОбщийМодуль, "u-НЕТ-ТАКОГО", 1, 1);
	ФайлСырых = ЗаписатьСырыеДанные(СырыеДанные);

	Конвертер = Новый КонвертерПокрытия();
	Конвертер.УстановитьКонфигурацию(Проект, "EDT");

	// Когда
	Покрытие = Конвертер.Конвертировать(ФайлСырых);

	// Тогда - ничего не сопоставлено
	Ожидаем.Что(Покрытие.Количество(), "несопоставленные модули пропускаются").Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СопоставитьМодулиКонфигурацииXML() Экспорт

	// Дано - XML-дамп с общим модулем и справочником
	Дамп = НовыйКаталог();
	ЗаписатьФайл(Дамп, "CommonModules/ОМ1.xml", ОбъектXML("CommonModule", "u-om", "ОМ1"));
	ЗаписатьФайл(Дамп, "CommonModules/ОМ1/Ext/Module.bsl", "А = 1;");
	ЗаписатьФайл(Дамп, "Catalogs/Спр1.xml", ОбъектXML("Catalog", "u-cat", "Спр1"));
	ЗаписатьФайл(Дамп, "Catalogs/Спр1/Ext/ObjectModule.bsl", "Б = 2;");

	СырыеДанные = НовыеСырыеДанные();
	ДобавитьЗамерКонфигурации(СырыеДанные, ОбщийМодуль, "u-om", 1, 1);
	ДобавитьЗамерКонфигурации(СырыеДанные, МодульОбъекта, "u-cat", 1, 1);
	ФайлСырых = ЗаписатьСырыеДанные(СырыеДанные);

	Конвертер = Новый КонвертерПокрытия();
	Конвертер.УстановитьКонфигурацию(Дамп, "XML");

	// Когда
	Покрытие = Конвертер.Конвертировать(ФайлСырых);

	// Тогда
	Ожидаем.Что(Покрытие.Количество(), "сопоставлено файлов XML").Равно(2);
	ПроверитьЕстьФайл(Покрытие, Дамп, "CommonModules/ОМ1/Ext/Module.bsl");
	ПроверитьЕстьФайл(Покрытие, Дамп, "Catalogs/Спр1/Ext/ObjectModule.bsl");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СопоставитьМодулиРасширенияПоИмени() Экспорт

	// Дано - основная конфигурация и расширение с общими модулями
	Проект = НовыйКаталог();
	СоздатьМдо(Проект, "src/CommonModules/ОМ1", "ОМ1.mdo", "u-om");
	ЗаписатьФайл(Проект, "src/CommonModules/ОМ1/Module.bsl", "А = 1;");

	Расш = НовыйКаталог();
	СоздатьМдо(Расш, "src/CommonModules/ОМР", "ОМР.mdo", "u-ext");
	ЗаписатьФайл(Расш, "src/CommonModules/ОМР/Module.bsl", "Р = 1;");

	СырыеДанные = НовыеСырыеДанные();
	ДобавитьЗамерКонфигурации(СырыеДанные, ОбщийМодуль, "u-om", 1, 1);
	ДобавитьЗамерРасширения(СырыеДанные, "МоёРасш", ОбщийМодуль, "u-ext", 2, 1);
	ФайлСырых = ЗаписатьСырыеДанные(СырыеДанные);

	Конвертер = Новый КонвертерПокрытия();
	Конвертер.УстановитьКонфигурацию(Проект, "EDT");
	Конвертер.ДобавитьРасширение("МоёРасш", Расш, "EDT");

	// Когда
	Покрытие = Конвертер.Конвертировать(ФайлСырых);

	// Тогда - и конфигурация, и расширение сопоставлены
	Ожидаем.Что(Покрытие.Количество(), "конфигурация + расширение").Равно(2);
	ПроверитьЕстьФайл(Покрытие, Проект, "src/CommonModules/ОМ1/Module.bsl");
	ПроверитьЕстьФайл(Покрытие, Расш, "src/CommonModules/ОМР/Module.bsl");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗаписатьФорматStatJson() Экспорт

	// Дано - карта покрытия из одного файла
	Путь = ОбъединитьПути(НовыйКаталог(), "Module.bsl");
	Строки = Новый Соответствие;
	Строки.Вставить("5", Новый Структура("count, time", 3, 0));
	Покрытие = Новый Соответствие;
	Покрытие.Вставить(Путь, Строки);

	ФайлСтат = ОбъединитьПути(НовыйКаталог(), "stat.json");
	Запись = Новый ЗаписьStatJson();

	// Когда
	Количество = Запись.Записать(Покрытие, ФайлСтат);

	// Тогда - файл читается и содержит #path и метод Module со строкой 5
	Ожидаем.Что(Количество, "записано файлов").Равно(1);
	Данные = ПрочитатьФайлJSON(ФайлСтат);
	ДанныеФайла = Данные[Путь];
	Ожидаем.Что(ДанныеФайла["#path"], "#path").Равно(Путь);
	Ожидаем.Что(ДанныеФайла["Module"]["5"]["count"], "count строки 5").Равно(3);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	ОбщийМодуль    = "d5963243-262e-4398-b4d7-fb16d06484f6";
	МодульОбъекта  = "a637f77f-3840-441d-a1c3-699c8c5cb7e0";
	МодульМенеджера = "d1b64a2c-8078-4982-8190-8f81aefda192";
	Корни = Новый Массив;
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	Для Каждого Корень Из Корни Цикл
		Попытка
			УдалитьФайлы(Корень);
		Исключение
			// не критично для теста
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыйКаталог()
	Каталог = ВременныеФайлы.СоздатьКаталог();
	Корни.Добавить(Каталог);
	Возврат Каталог;
КонецФункции

Функция ПутьФайла(Знач Корень, Знач ОтносительныйПуть)
	Возврат Новый Файл(ОбъединитьПути(Корень, СтрЗаменить(ОтносительныйПуть, "/", ПолучитьРазделительПути()))).ПолноеИмя;
КонецФункции

Процедура ЗаписатьФайл(Знач Корень, Знач ОтносительныйПуть, Знач Содержимое)
	ПолныйПуть = ПутьФайла(Корень, ОтносительныйПуть);
	КаталогФайла = Новый Файл(ПолныйПуть).Путь;
	Если НЕ Новый Файл(КаталогФайла).Существует() Тогда
		СоздатьКаталог(КаталогФайла);
	КонецЕсли;
	Запись = Новый ЗаписьТекста(ПолныйПуть, КодировкаТекста.UTF8);
	Запись.Записать(Содержимое);
	Запись.Закрыть();
КонецПроцедуры

Процедура СоздатьМдо(Знач Корень, Знач ОтносительныйКаталог, Знач ИмяФайла, Знач Uuid)
	Содержимое = СтрШаблон(
		"<?xml version=""1.0"" encoding=""UTF-8""?>
		|<mdclass:CommonModule xmlns:mdclass=""http://g5.1c.ru/v8/dt/metadata/mdclass"" uuid=""%1"">
		|  <name>Объект</name>
		|</mdclass:CommonModule>", Uuid);
	ЗаписатьФайл(Корень, ОтносительныйКаталог + "/" + ИмяФайла, Содержимое);
КонецПроцедуры

Функция ОбъектXML(Знач ТипОбъекта, Знач Uuid, Знач Имя)
	Возврат СтрШаблон(
		"<?xml version=""1.0"" encoding=""UTF-8""?>
		|<MetaDataObject xmlns=""http://v8.1c.ru/8.3/MDClasses"">
		|  <%1 uuid=""%2"">
		|    <Properties><Name>%3</Name></Properties>
		|  </%1>
		|</MetaDataObject>", ТипОбъекта, Uuid, Имя);
КонецФункции

Функция НовыеСырыеДанные()
	Возврат Новый Структура("TotalDurability, Data", 0, Новый Массив);
КонецФункции

Процедура ДобавитьЗамерКонфигурации(СырыеДанные, Знач ВидМодуля, Знач ИДОбъекта, Знач НомерСтроки, Знач Частота)
	ДобавитьЗамер(СырыеДанные, "ConfigModule", "", ВидМодуля, ИДОбъекта, НомерСтроки, Частота);
КонецПроцедуры

Процедура ДобавитьЗамерРасширения(СырыеДанные, Знач ИмяРасширения, Знач ВидМодуля, Знач ИДОбъекта, Знач НомерСтроки, Знач Частота)
	ДобавитьЗамер(СырыеДанные, "ExtensionModule", ИмяРасширения, ВидМодуля, ИДОбъекта, НомерСтроки, Частота);
КонецПроцедуры

Процедура ДобавитьЗамер(СырыеДанные, Знач ТипМодуля, Знач ИмяРасширения, Знач ВидМодуля, Знач ИДОбъекта, Знач НомерСтроки, Знач Частота)

	МодульИД = Новый Структура;
	МодульИД.Вставить("ModuleType", ТипМодуля);
	МодульИД.Вставить("URL", "");
	МодульИД.Вставить("ExtensionName", ИмяРасширения);
	МодульИД.Вставить("ObjectID", ИДОбъекта);
	МодульИД.Вставить("PropertyID", ВидМодуля);

	Строка = Новый Структура("LineNo, Frequency, Durability, PureDurability", НомерСтроки, Частота, 0, 0);
	LineInfo = Новый Массив;
	LineInfo.Добавить(Строка);

	Замер = Новый Структура("ModuleId, LineInfo", МодульИД, LineInfo);
	СырыеДанные.Data.Добавить(Замер);

КонецПроцедуры

Функция ЗаписатьСырыеДанные(Знач СырыеДанные)
	Путь = ВременныеФайлы.НовоеИмяФайла("json");
	Запись = Новый ЗаписьJSON;
	Запись.ОткрытьФайл(Путь, "UTF-8");
	ЗаписатьJSON(Запись, СырыеДанные);
	Запись.Закрыть();
	Возврат Путь;
КонецФункции

Процедура ПроверитьЕстьФайл(Знач Покрытие, Знач Корень, Знач ОтносительныйПуть)
	Ожидаемый = ПутьФайла(Корень, ОтносительныйПуть);
	Ожидаем.Что(Покрытие.Получить(Ожидаемый), СтрШаблон("файл сопоставлен: %1", ОтносительныйПуть)).Заполнено();
КонецПроцедуры

Функция ПрочитатьФайлJSON(Знач ФайлJSON)
	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(ФайлJSON, "UTF-8");
	Данные = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Данные;
КонецФункции

#КонецОбласти
