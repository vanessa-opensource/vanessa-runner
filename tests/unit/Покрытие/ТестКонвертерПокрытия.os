// BSLLS-off
// Юнит-тесты маппинга покрытия (КонвертерПокрытия + КонвертерИсходников + ЗаписьStatJson): сопоставление
// «вид модуля + ObjectID -> файл исходника» для конфигурации и расширения в EDT и XML-дампе, запись stat.json.
// Исходники и сырые замеры - фикстуры во временных каталогах, реальная 1С не нужна.

#Использовать asserts
#Использовать tempfiles
#Использовать "../../../src/core/Покрытие"
#Использовать "../../../src/core/Файлы"
#Использовать "../utils"

Перем ОбщийМодуль;
Перем МодульОбъекта;
Перем МодульМенеджера;
Перем МодульФормы;
Перем МодульКоманды;

Перем Проект; // корень исходников конфигурации (EDT или XML-дамп)
Перем СырыеДанные;

&ПередКаждым
Процедура ПередКаждым() Экспорт
	ОбщийМодуль    = "d5963243-262e-4398-b4d7-fb16d06484f6";
	МодульОбъекта  = "a637f77f-3840-441d-a1c3-699c8c5cb7e0";
	МодульМенеджера = "d1b64a2c-8078-4982-8190-8f81aefda192";
	МодульФормы    = "32e087ab-1491-49b6-aba7-43571b41ac2b";
	МодульКоманды  = "078a6af8-d22c-4248-9c33-7e90075a3d2c";
	Проект = ВременныеФайлы.СоздатьКаталог();
	СырыеДанные = Новый Структура("TotalDurability, Data", 0, Новый Массив);
КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт
	ВременныеФайлы.Удалить();
КонецПроцедуры

#Область Конвертировать

&Тест
Процедура ТестДолжен_СопоставитьМодулиКонфигурацииEDT() Экспорт

	// Дано - EDT-проект с общим модулем и справочником
	СоздатьМдо("src/CommonModules/ОМ1/ОМ1.mdo", "u-om");
	ТестовыеФайлы.Файл(Проект, "src/CommonModules/ОМ1/Module.bsl", "А = 1;");
	СоздатьМдо("src/Catalogs/Спр1/Спр1.mdo", "u-cat");
	ТестовыеФайлы.Файл(Проект, "src/Catalogs/Спр1/ObjectModule.bsl", "Б = 2;");
	ТестовыеФайлы.Файл(Проект, "src/Catalogs/Спр1/ManagerModule.bsl", "В = 3;");

	ДобавитьЗамерКонфигурации(ОбщийМодуль, "u-om", 1, 2);
	ДобавитьЗамерКонфигурации(МодульОбъекта, "u-cat", 1, 1);
	ДобавитьЗамерКонфигурации(МодульМенеджера, "u-cat", 1, 5);

	// Когда
	Покрытие = Конвертер("EDT").Конвертировать(ФайлСырыхДанных());

	// Тогда - три модуля сопоставлены
	Ожидаем.Что(Покрытие.Количество(), "сопоставлено файлов").Равно(3);
	ПроверитьЕстьФайл(Покрытие, Проект, "src/CommonModules/ОМ1/Module.bsl");
	ПроверитьЕстьФайл(Покрытие, Проект, "src/Catalogs/Спр1/ObjectModule.bsl");
	ПроверитьЕстьФайл(Покрытие, Проект, "src/Catalogs/Спр1/ManagerModule.bsl");

КонецПроцедуры

&Тест
Процедура ТестДолжен_УчестьЧастотуКакCount() Экспорт

	// Дано
	СоздатьМдо("src/CommonModules/ОМ1/ОМ1.mdo", "u-om");
	ТестовыеФайлы.Файл(Проект, "src/CommonModules/ОМ1/Module.bsl", "А = 1;");
	ДобавитьЗамерКонфигурации(ОбщийМодуль, "u-om", 7, 42);

	// Когда
	Покрытие = Конвертер("EDT").Конвертировать(ФайлСырыхДанных());

	// Тогда - строка 7 с count = 42
	Строки = Покрытие.Получить(ТестовыеФайлы.Путь(Проект, "src/CommonModules/ОМ1/Module.bsl"));
	Ожидаем.Что(Строки, "строки файла").Заполнено();
	Ожидаем.Что(Строки.Получить("7").count, "частота строки 7").Равно(42);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИгнорироватьНеизвестныйМодуль() Экспорт

	// Дано - замер ссылается на объект, которого нет в исходниках
	СоздатьМдо("src/CommonModules/ОМ1/ОМ1.mdo", "u-om");
	ТестовыеФайлы.Файл(Проект, "src/CommonModules/ОМ1/Module.bsl", "А = 1;");
	ДобавитьЗамерКонфигурации(ОбщийМодуль, "u-НЕТ-ТАКОГО", 1, 1);

	// Когда
	Покрытие = Конвертер("EDT").Конвертировать(ФайлСырыхДанных());

	// Тогда - ничего не сопоставлено
	Ожидаем.Что(Покрытие.Количество(), "несопоставленные модули пропускаются").Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СопоставитьМодулиКонфигурацииXML() Экспорт

	// Дано - XML-дамп с общим модулем и справочником
	ТестовыеФайлы.Файл(Проект, "CommonModules/ОМ1.xml", ОбъектXML("CommonModule", "u-om", "ОМ1"));
	ТестовыеФайлы.Файл(Проект, "CommonModules/ОМ1/Ext/Module.bsl", "А = 1;");
	ТестовыеФайлы.Файл(Проект, "Catalogs/Спр1.xml", ОбъектXML("Catalog", "u-cat", "Спр1"));
	ТестовыеФайлы.Файл(Проект, "Catalogs/Спр1/Ext/ObjectModule.bsl", "Б = 2;");

	ДобавитьЗамерКонфигурации(ОбщийМодуль, "u-om", 1, 1);
	ДобавитьЗамерКонфигурации(МодульОбъекта, "u-cat", 1, 1);

	// Когда
	Покрытие = Конвертер("XML").Конвертировать(ФайлСырыхДанных());

	// Тогда
	Ожидаем.Что(Покрытие.Количество(), "сопоставлено файлов XML").Равно(2);
	ПроверитьЕстьФайл(Покрытие, Проект, "CommonModules/ОМ1/Ext/Module.bsl");
	ПроверитьЕстьФайл(Покрытие, Проект, "Catalogs/Спр1/Ext/ObjectModule.bsl");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СопоставитьМодулиРасширенияПоИмени() Экспорт

	// Дано - основная конфигурация и расширение с общими модулями
	СоздатьМдо("src/CommonModules/ОМ1/ОМ1.mdo", "u-om");
	ТестовыеФайлы.Файл(Проект, "src/CommonModules/ОМ1/Module.bsl", "А = 1;");

	Расш = ВременныеФайлы.СоздатьКаталог();
	ТестовыеФайлы.Файл(Расш, "src/CommonModules/ОМР/ОМР.mdo", ТекстМдо("u-ext"));
	ТестовыеФайлы.Файл(Расш, "src/CommonModules/ОМР/Module.bsl", "Р = 1;");

	ДобавитьЗамерКонфигурации(ОбщийМодуль, "u-om", 1, 1);
	ДобавитьЗамер("ExtensionModule", "МоёРасш", ОбщийМодуль, "u-ext", 2, 1);

	КонвертерПокрытия = Конвертер("EDT");
	КонвертерПокрытия.ДобавитьРасширение("МоёРасш", Расш, "EDT");

	// Когда
	Покрытие = КонвертерПокрытия.Конвертировать(ФайлСырыхДанных());

	// Тогда - и конфигурация, и расширение сопоставлены
	Ожидаем.Что(Покрытие.Количество(), "конфигурация + расширение").Равно(2);
	ПроверитьЕстьФайл(Покрытие, Проект, "src/CommonModules/ОМ1/Module.bsl");
	ПроверитьЕстьФайл(Покрытие, Расш, "src/CommonModules/ОМР/Module.bsl");

КонецПроцедуры

// Подчинённые объекты читаются из .mdo родителя; у элемента формы/команды после <name>
// идут другие дочерние элементы (<synonym>, <usePurposes>), и обход не должен обрываться
// на первом найденном объекте.
&Тест
Процедура ТестДолжен_СопоставитьФормыИКомандыEDT() Экспорт

	// Дано - справочник с двумя формами и командой
	ТестовыеФайлы.Файл(Проект, "src/Catalogs/Спр1/Спр1.mdo",
		"<?xml version=""1.0"" encoding=""UTF-8""?>
		|<mdclass:Catalog xmlns:mdclass=""http://g5.1c.ru/v8/dt/metadata/mdclass"" uuid=""u-cat"">
		|  <name>Спр1</name>
		|  <synonym><key>ru</key><value>Спр</value></synonym>
		|  <forms uuid=""u-form1"">
		|    <name>ФормаЭлемента</name>
		|    <synonym><key>ru</key><value>Ф1</value></synonym>
		|    <usePurposes>PlatformApplication</usePurposes>
		|  </forms>
		|  <forms uuid=""u-form2"">
		|    <name>ФормаСписка</name>
		|    <synonym><key>ru</key><value>Ф2</value></synonym>
		|  </forms>
		|  <commands uuid=""u-cmd1"">
		|    <name>Команда1</name>
		|  </commands>
		|</mdclass:Catalog>");
	ТестовыеФайлы.Файл(Проект, "src/Catalogs/Спр1/Forms/ФормаЭлемента/Module.bsl", "А = 1;");
	ТестовыеФайлы.Файл(Проект, "src/Catalogs/Спр1/Forms/ФормаСписка/Module.bsl", "А = 2;");
	ТестовыеФайлы.Файл(Проект, "src/Catalogs/Спр1/Commands/Команда1/CommandModule.bsl", "А = 3;");

	ДобавитьЗамерКонфигурации(МодульФормы, "u-form1", 1, 1);
	ДобавитьЗамерКонфигурации(МодульФормы, "u-form2", 1, 1);
	ДобавитьЗамерКонфигурации(МодульКоманды, "u-cmd1", 1, 1);

	// Когда
	Покрытие = Конвертер("EDT").Конвертировать(ФайлСырыхДанных());

	// Тогда
	Ожидаем.Что(Покрытие.Количество(), "сопоставлено форм и команд").Равно(3);
	ПроверитьЕстьФайл(Покрытие, Проект, "src/Catalogs/Спр1/Forms/ФормаЭлемента/Module.bsl");
	ПроверитьЕстьФайл(Покрытие, Проект, "src/Catalogs/Спр1/Forms/ФормаСписка/Module.bsl");
	ПроверитьЕстьФайл(Покрытие, Проект, "src/Catalogs/Спр1/Commands/Команда1/CommandModule.bsl");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СопоставитьФормыИКомандыXML() Экспорт

	// Дано - XML-дамп справочника с формой и двумя командами (у первой после Name есть Synonym)
	ТестовыеФайлы.Файл(Проект, "Catalogs/Спр1.xml",
		"<?xml version=""1.0"" encoding=""UTF-8""?>
		|<MetaDataObject xmlns=""http://v8.1c.ru/8.3/MDClasses"" version=""2.17"">
		|  <Catalog uuid=""x-cat"">
		|    <Properties><Name>Спр1</Name></Properties>
		|    <ChildObjects>
		|      <Attribute uuid=""x-attr""><Properties><Name>Реквизит1</Name></Properties></Attribute>
		|      <Form>ФормаЭлемента</Form>
		|      <Command uuid=""x-cmd1"">
		|        <Properties><Name>Команда1</Name><Synonym/></Properties>
		|      </Command>
		|      <Command uuid=""x-cmd2"">
		|        <Properties><Name>Команда2</Name></Properties>
		|      </Command>
		|    </ChildObjects>
		|  </Catalog>
		|</MetaDataObject>");
	ТестовыеФайлы.Файл(Проект, "Catalogs/Спр1/Forms/ФормаЭлемента.xml", ОбъектXML("Form", "x-form1", "ФормаЭлемента"));
	ТестовыеФайлы.Файл(Проект, "Catalogs/Спр1/Forms/ФормаЭлемента/Ext/Form/Module.bsl", "А = 1;");
	ТестовыеФайлы.Файл(Проект, "Catalogs/Спр1/Commands/Команда1/Ext/CommandModule.bsl", "А = 2;");
	ТестовыеФайлы.Файл(Проект, "Catalogs/Спр1/Commands/Команда2/Ext/CommandModule.bsl", "А = 3;");

	ДобавитьЗамерКонфигурации(МодульФормы, "x-form1", 1, 1);
	ДобавитьЗамерКонфигурации(МодульКоманды, "x-cmd1", 1, 1);
	ДобавитьЗамерКонфигурации(МодульКоманды, "x-cmd2", 1, 1);

	// Когда
	Покрытие = Конвертер("XML").Конвертировать(ФайлСырыхДанных());

	// Тогда
	Ожидаем.Что(Покрытие.Количество(), "сопоставлено форм и команд XML").Равно(3);
	ПроверитьЕстьФайл(Покрытие, Проект, "Catalogs/Спр1/Forms/ФормаЭлемента/Ext/Form/Module.bsl");
	ПроверитьЕстьФайл(Покрытие, Проект, "Catalogs/Спр1/Commands/Команда1/Ext/CommandModule.bsl");
	ПроверитьЕстьФайл(Покрытие, Проект, "Catalogs/Спр1/Commands/Команда2/Ext/CommandModule.bsl");

КонецПроцедуры

#КонецОбласти

#Область ЗаписьStatJson

&Тест
Процедура ТестДолжен_ЗаписатьФорматStatJson() Экспорт

	// Дано - карта покрытия из одного файла
	Путь = ОбъединитьПути(Проект, "Module.bsl");
	Строки = Новый Соответствие;
	Строки.Вставить("5", Новый Структура("count, time", 3, 0));
	Покрытие = Новый Соответствие;
	Покрытие.Вставить(Путь, Строки);
	ФайлСтат = ВременныеФайлы.НовоеИмяФайла("json");

	// Когда
	Количество = Новый ЗаписьStatJson().Записать(Покрытие, ФайлСтат);

	// Тогда - файл читается и содержит #path и метод Module со строкой 5
	Ожидаем.Что(Количество, "записано файлов").Равно(1);
	ДанныеФайла = ТестовыеФайлы.ПрочитатьJSON(ФайлСтат)[Путь];
	Ожидаем.Что(ДанныеФайла["#path"], "#path").Равно(Путь);
	Ожидаем.Что(ДанныеФайла["Module"]["5"]["count"], "count строки 5").Равно(3);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Конвертер(Знач Формат)
	Результат = Новый КонвертерПокрытия;
	Результат.УстановитьКонфигурацию(Проект, Формат);
	Возврат Результат;
КонецФункции

Функция ТекстМдо(Знач Uuid)
	Возврат СтрШаблон(
		"<?xml version=""1.0"" encoding=""UTF-8""?>
		|<mdclass:CommonModule xmlns:mdclass=""http://g5.1c.ru/v8/dt/metadata/mdclass"" uuid=""%1"">
		|  <name>Объект</name>
		|</mdclass:CommonModule>", Uuid);
КонецФункции

Процедура СоздатьМдо(Знач ОтносительныйПуть, Знач Uuid)
	ТестовыеФайлы.Файл(Проект, ОтносительныйПуть, ТекстМдо(Uuid));
КонецПроцедуры

Функция ОбъектXML(Знач ТипОбъекта, Знач Uuid, Знач Имя)
	Возврат СтрШаблон(
		"<?xml version=""1.0"" encoding=""UTF-8""?>
		|<MetaDataObject xmlns=""http://v8.1c.ru/8.3/MDClasses"">
		|  <%1 uuid=""%2"">
		|    <Properties><Name>%3</Name></Properties>
		|  </%1>
		|</MetaDataObject>", ТипОбъекта, Uuid, Имя);
КонецФункции

Процедура ДобавитьЗамерКонфигурации(Знач ВидМодуля, Знач ИДОбъекта, Знач НомерСтроки, Знач Частота)
	ДобавитьЗамер("ConfigModule", "", ВидМодуля, ИДОбъекта, НомерСтроки, Частота);
КонецПроцедуры

// Замер coveragebsl: один модуль, одна строка.
Процедура ДобавитьЗамер(Знач ТипМодуля, Знач ИмяРасширения, Знач ВидМодуля, Знач ИДОбъекта, Знач НомерСтроки, Знач Частота)

	МодульИД = Новый Структура;
	МодульИД.Вставить("ModuleType", ТипМодуля);
	МодульИД.Вставить("URL", "");
	МодульИД.Вставить("ExtensionName", ИмяРасширения);
	МодульИД.Вставить("ObjectID", ИДОбъекта);
	МодульИД.Вставить("PropertyID", ВидМодуля);

	Строка = Новый Структура("LineNo, Frequency, Durability, PureDurability", НомерСтроки, Частота, 0, 0);

	СырыеДанные.Data.Добавить(Новый Структура("ModuleId, LineInfo", МодульИД, ТестовыеДанные.Массив(Строка)));

КонецПроцедуры

Функция ФайлСырыхДанных()
	Возврат ТестовыеФайлы.ЗаписатьJSON(ВременныеФайлы.НовоеИмяФайла("json"), СырыеДанные);
КонецФункции

Процедура ПроверитьЕстьФайл(Знач Покрытие, Знач Корень, Знач ОтносительныйПуть)
	Ожидаем.Что(Покрытие.Получить(ТестовыеФайлы.Путь(Корень, ОтносительныйПуть)),
		СтрШаблон("файл сопоставлен: %1", ОтносительныйПуть)).Заполнено();
КонецПроцедуры

#КонецОбласти
