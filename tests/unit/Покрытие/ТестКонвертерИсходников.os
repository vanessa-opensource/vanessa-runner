// BSLLS-off
// Юнит-тесты КонвертерИсходников: «вид модуля + uuid объекта -> файл модуля» для каждого вида
// программного модуля в исходниках EDT и XML-дампа. Исходники - фикстуры во временном каталоге.

#Использовать asserts
#Использовать tempfiles
#Использовать "../../../src/core/Покрытие"
#Использовать "../utils"

Перем Виды; // Структура - PropertyID видов модулей
Перем Корень;

&ПередКаждым
Процедура ПередКаждым() Экспорт

	Корень = ВременныеФайлы.СоздатьКаталог();

	Виды = Новый Структура;
	Виды.Вставить("ОбщийМодуль", "d5963243-262e-4398-b4d7-fb16d06484f6");
	Виды.Вставить("МодульОбъекта", "a637f77f-3840-441d-a1c3-699c8c5cb7e0");
	Виды.Вставить("МодульМенеджера", "d1b64a2c-8078-4982-8190-8f81aefda192");
	Виды.Вставить("МодульНабораЗаписей", "9f36fd70-4bf4-47f6-b235-935f73aab43f");
	Виды.Вставить("МодульОбычногоПриложения", "a78d9ce3-4e0c-48d5-9863-ae7342eedf94");
	Виды.Вставить("МодульУправляемогоПриложения", "d22e852a-cf8a-4f77-8ccb-3548e7792bea");
	Виды.Вставить("МодульВнешнегоСоединения", "a4a9c1e2-1e54-4c7f-af06-4ca341198fac");
	Виды.Вставить("МодульСеанса", "9b7bbbae-9771-46f2-9e4d-2489e0ffc702");
	Виды.Вставить("МодульМенеджераЗначения", "3e58c91f-9aaa-4f42-8999-4baf33907b75");
	Виды.Вставить("МодульМенеджераНастроек", "0c8cad23-bf8c-468e-b49e-12f1927c048b");
	Виды.Вставить("МодульФормы", "32e087ab-1491-49b6-aba7-43571b41ac2b");
	Виды.Вставить("МодульКоманды", "078a6af8-d22c-4248-9c33-7e90075a3d2c");

КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт
	ВременныеФайлы.Удалить();
КонецПроцедуры

#Область НайтиФайлМодуля

&Тест
Процедура ТестДолжен_НайтиМодулиКонфигурацииEDT() Экспорт

	Для Каждого Файл Из ФайлыМодулейКонфигурации() Цикл
		ТестовыеФайлы.Файл(Корень, "src/Configuration/" + Файл.Значение);
	КонецЦикла;

	Конвертер = Новый КонвертерИсходников(Корень, "EDT");

	Для Каждого Файл Из ФайлыМодулейКонфигурации() Цикл
		ПроверитьПуть(Конвертер.НайтиФайлМодуля(Виды[Файл.Ключ], "любой-uuid"), "src/Configuration/" + Файл.Значение);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиМодулиКонфигурацииXML() Экспорт

	Для Каждого Файл Из ФайлыМодулейКонфигурации() Цикл
		ТестовыеФайлы.Файл(Корень, "Ext/" + Файл.Значение);
	КонецЦикла;

	Конвертер = Новый КонвертерИсходников(Корень, "XML");

	Для Каждого Файл Из ФайлыМодулейКонфигурации() Цикл
		ПроверитьПуть(Конвертер.НайтиФайлМодуля(Виды[Файл.Ключ], "любой-uuid"), "Ext/" + Файл.Значение);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиМодулиОбъектовEDT() Экспорт

	СоздатьМдо("HTTPServices/Сервис", "u-http");
	ТестовыеФайлы.Файл(Корень, "src/HTTPServices/Сервис/Module.bsl");
	СоздатьМдо("Constants/Конст", "u-const");
	ТестовыеФайлы.Файл(Корень, "src/Constants/Конст/ValueManagerModule.bsl");
	СоздатьМдо("SettingsStorages/Хранилище", "u-ss");
	ТестовыеФайлы.Файл(Корень, "src/SettingsStorages/Хранилище/ManagerModule.bsl");
	СоздатьМдо("Documents/Док", "u-doc");
	ТестовыеФайлы.Файл(Корень, "src/Documents/Док/ObjectModule.bsl");
	ТестовыеФайлы.Файл(Корень, "src/Documents/Док/ManagerModule.bsl");
	СоздатьМдо("InformationRegisters/Рег", "u-reg");
	ТестовыеФайлы.Файл(Корень, "src/InformationRegisters/Рег/RecordSetModule.bsl");
	СоздатьМдо("Sequences/Посл", "u-seq");
	ТестовыеФайлы.Файл(Корень, "src/Sequences/Посл/RecordSetModule.bsl");
	СоздатьМдо("CommonForms/Форма", "u-cf");
	ТестовыеФайлы.Файл(Корень, "src/CommonForms/Форма/Module.bsl");
	СоздатьМдо("CommonCommands/Команда", "u-cc");
	ТестовыеФайлы.Файл(Корень, "src/CommonCommands/Команда/CommandModule.bsl");

	Конвертер = Новый КонвертерИсходников(Корень, "EDT");

	ПроверитьПуть(Конвертер.НайтиФайлМодуля(Виды.ОбщийМодуль, "u-http"), "src/HTTPServices/Сервис/Module.bsl");
	ПроверитьПуть(Конвертер.НайтиФайлМодуля(Виды.МодульМенеджераЗначения, "u-const"), "src/Constants/Конст/ValueManagerModule.bsl");
	ПроверитьПуть(Конвертер.НайтиФайлМодуля(Виды.МодульМенеджераНастроек, "u-ss"), "src/SettingsStorages/Хранилище/ManagerModule.bsl");
	ПроверитьПуть(Конвертер.НайтиФайлМодуля(Виды.МодульОбъекта, "u-doc"), "src/Documents/Док/ObjectModule.bsl");
	ПроверитьПуть(Конвертер.НайтиФайлМодуля(Виды.МодульМенеджера, "u-doc"), "src/Documents/Док/ManagerModule.bsl");
	ПроверитьПуть(Конвертер.НайтиФайлМодуля(Виды.МодульНабораЗаписей, "u-reg"), "src/InformationRegisters/Рег/RecordSetModule.bsl");
	ПроверитьПуть(Конвертер.НайтиФайлМодуля(Виды.МодульНабораЗаписей, "u-seq"), "src/Sequences/Посл/RecordSetModule.bsl");
	ПроверитьПуть(Конвертер.НайтиФайлМодуля(Виды.МодульФормы, "u-cf"), "src/CommonForms/Форма/Module.bsl");
	ПроверитьПуть(Конвертер.НайтиФайлМодуля(Виды.МодульКоманды, "u-cc"), "src/CommonCommands/Команда/CommandModule.bsl");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиМодулиОбъектовXML() Экспорт

	СоздатьОбъектXML("WebServices", "Сервис", "x-ws");
	ТестовыеФайлы.Файл(Корень, "WebServices/Сервис/Ext/Module.bsl");
	СоздатьОбъектXML("Constants", "Конст", "x-const");
	ТестовыеФайлы.Файл(Корень, "Constants/Конст/Ext/ValueManagerModule.bsl");
	СоздатьОбъектXML("SettingsStorages", "Хранилище", "x-ss");
	ТестовыеФайлы.Файл(Корень, "SettingsStorages/Хранилище/Ext/ManagerModule.bsl");
	СоздатьОбъектXML("Catalogs", "Спр", "x-cat");
	ТестовыеФайлы.Файл(Корень, "Catalogs/Спр/Ext/ObjectModule.bsl");
	ТестовыеФайлы.Файл(Корень, "Catalogs/Спр/Ext/ManagerModule.bsl");
	СоздатьОбъектXML("AccumulationRegisters", "Рег", "x-reg");
	ТестовыеФайлы.Файл(Корень, "AccumulationRegisters/Рег/Ext/RecordSetModule.bsl");
	СоздатьОбъектXML("CommonForms", "Форма", "x-cf");
	ТестовыеФайлы.Файл(Корень, "CommonForms/Форма/Ext/Form/Module.bsl");
	СоздатьОбъектXML("CommonCommands", "Команда", "x-cc");
	ТестовыеФайлы.Файл(Корень, "CommonCommands/Команда/Ext/CommandModule.bsl");

	Конвертер = Новый КонвертерИсходников(Корень, "XML");

	ПроверитьПуть(Конвертер.НайтиФайлМодуля(Виды.ОбщийМодуль, "x-ws"), "WebServices/Сервис/Ext/Module.bsl");
	ПроверитьПуть(Конвертер.НайтиФайлМодуля(Виды.МодульМенеджераЗначения, "x-const"), "Constants/Конст/Ext/ValueManagerModule.bsl");
	ПроверитьПуть(Конвертер.НайтиФайлМодуля(Виды.МодульМенеджераНастроек, "x-ss"), "SettingsStorages/Хранилище/Ext/ManagerModule.bsl");
	ПроверитьПуть(Конвертер.НайтиФайлМодуля(Виды.МодульОбъекта, "x-cat"), "Catalogs/Спр/Ext/ObjectModule.bsl");
	ПроверитьПуть(Конвертер.НайтиФайлМодуля(Виды.МодульМенеджера, "x-cat"), "Catalogs/Спр/Ext/ManagerModule.bsl");
	ПроверитьПуть(Конвертер.НайтиФайлМодуля(Виды.МодульНабораЗаписей, "x-reg"), "AccumulationRegisters/Рег/Ext/RecordSetModule.bsl");
	ПроверитьПуть(Конвертер.НайтиФайлМодуля(Виды.МодульФормы, "x-cf"), "CommonForms/Форма/Ext/Form/Module.bsl");
	ПроверитьПуть(Конвертер.НайтиФайлМодуля(Виды.МодульКоманды, "x-cc"), "CommonCommands/Команда/Ext/CommandModule.bsl");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиМодульПерерасчетаEDT() Экспорт

	ТестовыеФайлы.Файл(Корень, "src/CalculationRegisters/Рег/Рег.mdo",
		"<?xml version=""1.0"" encoding=""UTF-8""?>
		|<mdclass:CalculationRegister xmlns:mdclass=""http://g5.1c.ru/v8/dt/metadata/mdclass"" uuid=""u-calc"">
		|  <name>Рег</name>
		|  <recalculations uuid=""u-recalc"">
		|    <name>Перерасчет</name>
		|  </recalculations>
		|</mdclass:CalculationRegister>");
	ТестовыеФайлы.Файл(Корень, "src/CalculationRegisters/Рег/RecordSetModule.bsl");
	ТестовыеФайлы.Файл(Корень, "src/CalculationRegisters/Рег/Recalculations/Перерасчет/RecordSetModule.bsl");

	Конвертер = Новый КонвертерИсходников(Корень, "EDT");

	ПроверитьПуть(Конвертер.НайтиФайлМодуля(Виды.МодульНабораЗаписей, "u-calc"), "src/CalculationRegisters/Рег/RecordSetModule.bsl");
	ПроверитьПуть(Конвертер.НайтиФайлМодуля(Виды.МодульНабораЗаписей, "u-recalc"),
		"src/CalculationRegisters/Рег/Recalculations/Перерасчет/RecordSetModule.bsl");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиМодульПерерасчетаXML() Экспорт

	СоздатьОбъектXML("CalculationRegisters", "Рег", "x-calc");
	СоздатьОбъектXML("CalculationRegisters/Рег/Recalculations", "Перерасчет", "x-recalc");
	ТестовыеФайлы.Файл(Корень, "CalculationRegisters/Рег/Ext/RecordSetModule.bsl");
	ТестовыеФайлы.Файл(Корень, "CalculationRegisters/Рег/Recalculations/Перерасчет/Ext/RecordSetModule.bsl");

	Конвертер = Новый КонвертерИсходников(Корень, "XML");

	ПроверитьПуть(Конвертер.НайтиФайлМодуля(Виды.МодульНабораЗаписей, "x-calc"), "CalculationRegisters/Рег/Ext/RecordSetModule.bsl");
	ПроверитьПуть(Конвертер.НайтиФайлМодуля(Виды.МодульНабораЗаписей, "x-recalc"),
		"CalculationRegisters/Рег/Recalculations/Перерасчет/Ext/RecordSetModule.bsl");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьНеопределеноБезОбъектаИлиФайла() Экспорт

	СоздатьМдо("Catalogs/Спр", "u-cat"); // ObjectModule.bsl не создан

	Конвертер = Новый КонвертерИсходников(Корень, "EDT");

	Ожидаем.Что(Конвертер.НайтиФайлМодуля(Виды.МодульОбъекта, "u-cat"), "объект есть, файла модуля нет").ЭтоНеопределено();
	Ожидаем.Что(Конвертер.НайтиФайлМодуля(Виды.МодульОбъекта, "u-нет"), "объекта нет").ЭтоНеопределено();
	Ожидаем.Что(Конвертер.НайтиФайлМодуля("00000000-0000-0000-0000-000000000000", "u-cat"), "неизвестный вид").ЭтоНеопределено();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПриниматьВидМодуляВЛюбомРегистре() Экспорт

	СоздатьМдо("Catalogs/Спр", "u-cat");
	ТестовыеФайлы.Файл(Корень, "src/Catalogs/Спр/ObjectModule.bsl");

	Конвертер = Новый КонвертерИсходников(Корень, "EDT");

	ПроверитьПуть(Конвертер.НайтиФайлМодуля(ВРег(Виды.МодульОбъекта), "u-cat"), "src/Catalogs/Спр/ObjectModule.bsl");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ФайлыМодулейКонфигурации()
	Файлы = Новый Структура;
	Файлы.Вставить("МодульУправляемогоПриложения", "ManagedApplicationModule.bsl");
	Файлы.Вставить("МодульОбычногоПриложения", "OrdinaryApplicationModule.bsl");
	Файлы.Вставить("МодульСеанса", "SessionModule.bsl");
	Файлы.Вставить("МодульВнешнегоСоединения", "ExternalConnectionModule.bsl");
	Возврат Файлы;
КонецФункции

// Объект EDT: src/<Группа>/<Имя>/<Имя>.mdo с uuid в корневом элементе.
Процедура СоздатьМдо(Знач ГруппаИИмя, Знач Uuid)
	Имя = СтрРазделить(ГруппаИИмя, "/")[1];
	Содержимое = СтрШаблон(
		"<?xml version=""1.0"" encoding=""UTF-8""?>
		|<mdclass:Object xmlns:mdclass=""http://g5.1c.ru/v8/dt/metadata/mdclass"" uuid=""%1"">
		|  <name>%2</name>
		|</mdclass:Object>", Uuid, Имя);
	ТестовыеФайлы.Файл(Корень, СтрШаблон("src/%1/%2.mdo", ГруппаИИмя, Имя), Содержимое);
КонецПроцедуры

// Объект XML-дампа: <Группа>/<Имя>.xml с uuid в элементе объекта под корнем MetaDataObject.
Процедура СоздатьОбъектXML(Знач Группа, Знач Имя, Знач Uuid)
	Содержимое = СтрШаблон(
		"<?xml version=""1.0"" encoding=""UTF-8""?>
		|<MetaDataObject xmlns=""http://v8.1c.ru/8.3/MDClasses"">
		|  <Object uuid=""%1"">
		|    <Properties><Name>%2</Name></Properties>
		|  </Object>
		|</MetaDataObject>", Uuid, Имя);
	ТестовыеФайлы.Файл(Корень, СтрШаблон("%1/%2.xml", Группа, Имя), Содержимое);
КонецПроцедуры

Процедура ПроверитьПуть(Знач Найденный, Знач ОтносительныйПуть)
	Ожидаем.Что(Найденный, ОтносительныйПуть).Равно(ТестовыеФайлы.Путь(Корень, ОтносительныйПуть));
КонецПроцедуры

#КонецОбласти
