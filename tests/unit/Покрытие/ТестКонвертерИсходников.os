	Корни = Новый Массив;

КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	Для Каждого Корень Из Корни Цикл
		Попытка
			УдалитьФайлы(Корень);
		Исключение
			// не критично для теста
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ФайлыМодулейКонфигурации()
	Файлы = Новый Структура;
	Файлы.Вставить("МодульУправляемогоПриложения", "ManagedApplicationModule.bsl");
	Файлы.Вставить("МодульОбычногоПриложения", "OrdinaryApplicationModule.bsl");
	Файлы.Вставить("МодульСеанса", "SessionModule.bsl");
	Файлы.Вставить("МодульВнешнегоСоединения", "ExternalConnectionModule.bsl");
	Возврат Файлы;
КонецФункции

Функция НовыйКаталог()
	Каталог = ВременныеФайлы.СоздатьКаталог();
	Корни.Добавить(Каталог);
	Возврат Каталог;
КонецФункции

Функция ПутьФайла(Знач Корень, Знач ОтносительныйПуть)
	Возврат Новый Файл(ОбъединитьПути(Корень, СтрЗаменить(ОтносительныйПуть, "/", ПолучитьРазделительПути()))).ПолноеИмя;
КонецФункции

Процедура ЗаписатьФайл(Знач Корень, Знач ОтносительныйПуть, Знач Содержимое)
	ПолныйПуть = ПутьФайла(Корень, ОтносительныйПуть);
	КаталогФайла = Новый Файл(ПолныйПуть).Путь;
	Если НЕ Новый Файл(КаталогФайла).Существует() Тогда
		СоздатьКаталог(КаталогФайла);
	КонецЕсли;
	Запись = Новый ЗаписьТекста(ПолныйПуть, КодировкаТекста.UTF8);
	Запись.Записать(Содержимое);
	Запись.Закрыть();
КонецПроцедуры

// Объект EDT: src/<Группа>/<Имя>/<Имя>.mdo с uuid в корневом элементе.
Процедура СоздатьМдо(Знач Корень, Знач ГруппаИИмя, Знач Uuid)
	Имя = СтрРазделить(ГруппаИИмя, "/")[1];
	Содержимое = СтрШаблон(
		"<?xml version=""1.0"" encoding=""UTF-8""?>
		|<mdclass:Object xmlns:mdclass=""http://g5.1c.ru/v8/dt/metadata/mdclass"" uuid=""%1"">
		|  <name>%2</name>
		|</mdclass:Object>", Uuid, Имя);
	ЗаписатьФайл(Корень, СтрШаблон("src/%1/%2.mdo", ГруппаИИмя, Имя), Содержимое);
КонецПроцедуры

// Объект XML-дампа: <Группа>/<Имя>.xml с uuid в элементе объекта под корнем MetaDataObject.
Процедура СоздатьОбъектXML(Знач Корень, Знач Группа, Знач Имя, Знач Uuid)
	Содержимое = СтрШаблон(
		"<?xml version=""1.0"" encoding=""UTF-8""?>
		|<MetaDataObject xmlns=""http://v8.1c.ru/8.3/MDClasses"">
		|  <Object uuid=""%1"">
		|    <Properties><Name>%2</Name></Properties>
		|  </Object>
		|</MetaDataObject>", Uuid, Имя);
	ЗаписатьФайл(Корень, СтрШаблон("%1/%2.xml", Группа, Имя), Содержимое);
КонецПроцедуры

Процедура ПроверитьПуть(Знач Найденный, Знач Корень, Знач ОтносительныйПуть)
	Ожидаем.Что(Найденный, ОтносительныйПуть).Равно(ПутьФайла(Корень, ОтносительныйПуть));
КонецПроцедуры

#КонецОбласти
