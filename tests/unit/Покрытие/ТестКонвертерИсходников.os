// BSLLS-off
// Юнит-тесты КонвертерИсходников: «вид модуля + uuid объекта -> файл модуля» для каждого вида
// программного модуля в исходниках EDT и XML-дампа. Фикстуры создаются во временном каталоге.

#Использовать asserts
#Использовать tempfiles

#Использовать "../../../src/core/Покрытие"

Перем Виды; // Структура - PropertyID видов модулей
Перем Корни;

#Область СлужебныйПрограммныйИнтерфейс

&Тест
Процедура ТестДолжен_НайтиМодулиКонфигурацииEDT() Экспорт

	Проект = НовыйКаталог();
	Для Каждого Файл Из ФайлыМодулейКонфигурации() Цикл
		ЗаписатьФайл(Проект, "src/Configuration/" + Файл.Значение, "");
	КонецЦикла;

	Конвертер = Новый КонвертерИсходников(Проект, "EDT");

	Для Каждого Файл Из ФайлыМодулейКонфигурации() Цикл
		ПроверитьПуть(Конвертер.НайтиФайлМодуля(Виды[Файл.Ключ], "любой-uuid"),
			Проект, "src/Configuration/" + Файл.Значение);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиМодулиКонфигурацииXML() Экспорт

	Дамп = НовыйКаталог();
	Для Каждого Файл Из ФайлыМодулейКонфигурации() Цикл
		ЗаписатьФайл(Дамп, "Ext/" + Файл.Значение, "");
	КонецЦикла;

	Конвертер = Новый КонвертерИсходников(Дамп, "XML");

	Для Каждого Файл Из ФайлыМодулейКонфигурации() Цикл
		ПроверитьПуть(Конвертер.НайтиФайлМодуля(Виды[Файл.Ключ], "любой-uuid"), Дамп, "Ext/" + Файл.Значение);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиМодулиОбъектовEDT() Экспорт

	Проект = НовыйКаталог();
	СоздатьМдо(Проект, "HTTPServices/Сервис", "u-http");
	ЗаписатьФайл(Проект, "src/HTTPServices/Сервис/Module.bsl", "");
	СоздатьМдо(Проект, "Constants/Конст", "u-const");
	ЗаписатьФайл(Проект, "src/Constants/Конст/ValueManagerModule.bsl", "");
	СоздатьМдо(Проект, "SettingsStorages/Хранилище", "u-ss");
	ЗаписатьФайл(Проект, "src/SettingsStorages/Хранилище/ManagerModule.bsl", "");
	СоздатьМдо(Проект, "Documents/Док", "u-doc");
	ЗаписатьФайл(Проект, "src/Documents/Док/ObjectModule.bsl", "");
	ЗаписатьФайл(Проект, "src/Documents/Док/ManagerModule.bsl", "");
	СоздатьМдо(Проект, "InformationRegisters/Рег", "u-reg");
	ЗаписатьФайл(Проект, "src/InformationRegisters/Рег/RecordSetModule.bsl", "");
	СоздатьМдо(Проект, "Sequences/Посл", "u-seq");
	ЗаписатьФайл(Проект, "src/Sequences/Посл/RecordSetModule.bsl", "");
	СоздатьМдо(Проект, "CommonForms/Форма", "u-cf");
	ЗаписатьФайл(Проект, "src/CommonForms/Форма/Module.bsl", "");
	СоздатьМдо(Проект, "CommonCommands/Команда", "u-cc");
	ЗаписатьФайл(Проект, "src/CommonCommands/Команда/CommandModule.bsl", "");

	Конвертер = Новый КонвертерИсходников(Проект, "EDT");

	ПроверитьПуть(Конвертер.НайтиФайлМодуля(Виды.ОбщийМодуль, "u-http"), Проект, "src/HTTPServices/Сервис/Module.bsl");
	ПроверитьПуть(Конвертер.НайтиФайлМодуля(Виды.МодульМенеджераЗначения, "u-const"),
		Проект, "src/Constants/Конст/ValueManagerModule.bsl");
	ПроверитьПуть(Конвертер.НайтиФайлМодуля(Виды.МодульМенеджераНастроек, "u-ss"),
		Проект, "src/SettingsStorages/Хранилище/ManagerModule.bsl");
	ПроверитьПуть(Конвертер.НайтиФайлМодуля(Виды.МодульОбъекта, "u-doc"), Проект, "src/Documents/Док/ObjectModule.bsl");
	ПроверитьПуть(Конвертер.НайтиФайлМодуля(Виды.МодульМенеджера, "u-doc"), Проект, "src/Documents/Док/ManagerModule.bsl");
	ПроверитьПуть(Конвертер.НайтиФайлМодуля(Виды.МодульНабораЗаписей, "u-reg"),
		Проект, "src/InformationRegisters/Рег/RecordSetModule.bsl");
	ПроверитьПуть(Конвертер.НайтиФайлМодуля(Виды.МодульНабораЗаписей, "u-seq"), Проект, "src/Sequences/Посл/RecordSetModule.bsl");
	ПроверитьПуть(Конвертер.НайтиФайлМодуля(Виды.МодульФормы, "u-cf"), Проект, "src/CommonForms/Форма/Module.bsl");
	ПроверитьПуть(Конвертер.НайтиФайлМодуля(Виды.МодульКоманды, "u-cc"), Проект, "src/CommonCommands/Команда/CommandModule.bsl");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиМодулиОбъектовXML() Экспорт

	Дамп = НовыйКаталог();
	СоздатьОбъектXML(Дамп, "WebServices", "Сервис", "x-ws");
	ЗаписатьФайл(Дамп, "WebServices/Сервис/Ext/Module.bsl", "");
	СоздатьОбъектXML(Дамп, "Constants", "Конст", "x-const");
	ЗаписатьФайл(Дамп, "Constants/Конст/Ext/ValueManagerModule.bsl", "");
	СоздатьОбъектXML(Дамп, "SettingsStorages", "Хранилище", "x-ss");
	ЗаписатьФайл(Дамп, "SettingsStorages/Хранилище/Ext/ManagerModule.bsl", "");
	СоздатьОбъектXML(Дамп, "Catalogs", "Спр", "x-cat");
	ЗаписатьФайл(Дамп, "Catalogs/Спр/Ext/ObjectModule.bsl", "");
	ЗаписатьФайл(Дамп, "Catalogs/Спр/Ext/ManagerModule.bsl", "");
	СоздатьОбъектXML(Дамп, "AccumulationRegisters", "Рег", "x-reg");
	ЗаписатьФайл(Дамп, "AccumulationRegisters/Рег/Ext/RecordSetModule.bsl", "");
	СоздатьОбъектXML(Дамп, "CommonForms", "Форма", "x-cf");
	ЗаписатьФайл(Дамп, "CommonForms/Форма/Ext/Form/Module.bsl", "");
	СоздатьОбъектXML(Дамп, "CommonCommands", "Команда", "x-cc");
	ЗаписатьФайл(Дамп, "CommonCommands/Команда/Ext/CommandModule.bsl", "");

	Конвертер = Новый КонвертерИсходников(Дамп, "XML");

	ПроверитьПуть(Конвертер.НайтиФайлМодуля(Виды.ОбщийМодуль, "x-ws"), Дамп, "WebServices/Сервис/Ext/Module.bsl");
	ПроверитьПуть(Конвертер.НайтиФайлМодуля(Виды.МодульМенеджераЗначения, "x-const"),
		Дамп, "Constants/Конст/Ext/ValueManagerModule.bsl");
	ПроверитьПуть(Конвертер.НайтиФайлМодуля(Виды.МодульМенеджераНастроек, "x-ss"),
		Дамп, "SettingsStorages/Хранилище/Ext/ManagerModule.bsl");
	ПроверитьПуть(Конвертер.НайтиФайлМодуля(Виды.МодульОбъекта, "x-cat"), Дамп, "Catalogs/Спр/Ext/ObjectModule.bsl");
	ПроверитьПуть(Конвертер.НайтиФайлМодуля(Виды.МодульМенеджера, "x-cat"), Дамп, "Catalogs/Спр/Ext/ManagerModule.bsl");
	ПроверитьПуть(Конвертер.НайтиФайлМодуля(Виды.МодульНабораЗаписей, "x-reg"),
		Дамп, "AccumulationRegisters/Рег/Ext/RecordSetModule.bsl");
	ПроверитьПуть(Конвертер.НайтиФайлМодуля(Виды.МодульФормы, "x-cf"), Дамп, "CommonForms/Форма/Ext/Form/Module.bsl");
	ПроверитьПуть(Конвертер.НайтиФайлМодуля(Виды.МодульКоманды, "x-cc"), Дамп, "CommonCommands/Команда/Ext/CommandModule.bsl");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиМодульПерерасчетаEDT() Экспорт

	Проект = НовыйКаталог();
	ЗаписатьФайл(Проект, "src/CalculationRegisters/Рег/Рег.mdo",
		"<?xml version=""1.0"" encoding=""UTF-8""?>
		|<mdclass:CalculationRegister xmlns:mdclass=""http://g5.1c.ru/v8/dt/metadata/mdclass"" uuid=""u-calc"">
		|  <name>Рег</name>
		|  <recalculations uuid=""u-recalc"">
		|    <name>Перерасчет</name>
		|  </recalculations>
		|</mdclass:CalculationRegister>");
	ЗаписатьФайл(Проект, "src/CalculationRegisters/Рег/RecordSetModule.bsl", "");
	ЗаписатьФайл(Проект, "src/CalculationRegisters/Рег/Recalculations/Перерасчет/RecordSetModule.bsl", "");

	Конвертер = Новый КонвертерИсходников(Проект, "EDT");

	ПроверитьПуть(Конвертер.НайтиФайлМодуля(Виды.МодульНабораЗаписей, "u-calc"),
		Проект, "src/CalculationRegisters/Рег/RecordSetModule.bsl");
	ПроверитьПуть(Конвертер.НайтиФайлМодуля(Виды.МодульНабораЗаписей, "u-recalc"),
		Проект, "src/CalculationRegisters/Рег/Recalculations/Перерасчет/RecordSetModule.bsl");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиМодульПерерасчетаXML() Экспорт

	Дамп = НовыйКаталог();
	СоздатьОбъектXML(Дамп, "CalculationRegisters", "Рег", "x-calc");
	СоздатьОбъектXML(Дамп, "CalculationRegisters/Рег/Recalculations", "Перерасчет", "x-recalc");
