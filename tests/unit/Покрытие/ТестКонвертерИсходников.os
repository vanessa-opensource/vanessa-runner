	ПроверитьПуть(Конвертер.НайтиФайлМодуля(Виды.МодульНабораЗаписей, "x-calc"),
		Дамп, "CalculationRegisters/Рег/Ext/RecordSetModule.bsl");
	ПроверитьПуть(Конвертер.НайтиФайлМодуля(Виды.МодульНабораЗаписей, "x-recalc"),
		Дамп, "CalculationRegisters/Рег/Recalculations/Перерасчет/Ext/RecordSetModule.bsl");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьНеопределеноБезОбъектаИлиФайла() Экспорт

	Проект = НовыйКаталог();
	СоздатьМдо(Проект, "Catalogs/Спр", "u-cat");
	// ObjectModule.bsl не создан

	Конвертер = Новый КонвертерИсходников(Проект, "EDT");

	Ожидаем.Что(Конвертер.НайтиФайлМодуля(Виды.МодульОбъекта, "u-cat"), "объект есть, файла модуля нет").ЭтоНеопределено();
	Ожидаем.Что(Конвертер.НайтиФайлМодуля(Виды.МодульОбъекта, "u-нет"), "объекта нет").ЭтоНеопределено();
	Ожидаем.Что(Конвертер.НайтиФайлМодуля("00000000-0000-0000-0000-000000000000", "u-cat"), "неизвестный вид").ЭтоНеопределено();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПриниматьВидМодуляВЛюбомРегистре() Экспорт

	Проект = НовыйКаталог();
	СоздатьМдо(Проект, "Catalogs/Спр", "u-cat");
	ЗаписатьФайл(Проект, "src/Catalogs/Спр/ObjectModule.bsl", "");

	Конвертер = Новый КонвертерИсходников(Проект, "EDT");

	ПроверитьПуть(Конвертер.НайтиФайлМодуля(ВРег(Виды.МодульОбъекта), "u-cat"), Проект, "src/Catalogs/Спр/ObjectModule.bsl");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт

	Виды = Новый Структура;
	Виды.Вставить("ОбщийМодуль", "d5963243-262e-4398-b4d7-fb16d06484f6");
	Виды.Вставить("МодульОбъекта", "a637f77f-3840-441d-a1c3-699c8c5cb7e0");
	Виды.Вставить("МодульМенеджера", "d1b64a2c-8078-4982-8190-8f81aefda192");
	Виды.Вставить("МодульНабораЗаписей", "9f36fd70-4bf4-47f6-b235-935f73aab43f");
	Виды.Вставить("МодульОбычногоПриложения", "a78d9ce3-4e0c-48d5-9863-ae7342eedf94");
	Виды.Вставить("МодульУправляемогоПриложения", "d22e852a-cf8a-4f77-8ccb-3548e7792bea");
	Виды.Вставить("МодульВнешнегоСоединения", "a4a9c1e2-1e54-4c7f-af06-4ca341198fac");
	Виды.Вставить("МодульСеанса", "9b7bbbae-9771-46f2-9e4d-2489e0ffc702");
	Виды.Вставить("МодульМенеджераЗначения", "3e58c91f-9aaa-4f42-8999-4baf33907b75");
	Виды.Вставить("МодульМенеджераНастроек", "0c8cad23-bf8c-468e-b49e-12f1927c048b");
