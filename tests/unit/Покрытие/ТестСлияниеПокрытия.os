// BSLLS-off
// Юнит-тесты СлияниеПокрытия: объединение исполненных строк с покрываемыми (знаменатель),
// подсчет процента и нормализация ключей путей ("\" vs "/", регистр).

#Использовать asserts
#Использовать "../../../src/core/Покрытие"

Перем Слияние;

#Область СлужебныйПрограммныйИнтерфейс

&Тест
Процедура ТестСлить_ОбъединяетСтрокиИСохраняетСчетчики() Экспорт

	ПутьA = Новый Файл("modA.bsl").ПолноеИмя;
	ПутьB = Новый Файл("modB.bsl").ПолноеИмя;

	Исполненное = Новый Соответствие;
	СтрокиA = Новый Соответствие;
	СтрокиA.Вставить("5", Новый Структура("count, time", 3, 10));
	Исполненное.Вставить(ПутьA, СтрокиA);

	Покрываемые = Новый Соответствие;
	Покрываемые.Вставить(ПутьA, Массив(5, 7, 9));
	Покрываемые.Вставить(ПутьB, Массив(1, 2));

	Результат = Слияние.Слить(Исполненное, Покрываемые);

	Ожидаем.Что(Результат.Количество(), "файлов").Равно(2);
	Ожидаем.Что(Результат.Получить(ПутьA).Количество(), "строк в A").Равно(3);
	Ожидаем.Что(Результат.Получить(ПутьA).Получить("5").count, "исполненная строка сохранена").Равно(3);
	Ожидаем.Что(Результат.Получить(ПутьA).Получить("7").count, "покрываемая, но не исполненная").Равно(0);
	Ожидаем.Что(Результат.Получить(ПутьB).Количество(), "строк в B").Равно(2);
	Ожидаем.Что(Результат.Получить(ПутьB).Получить("1").count, "B не исполнялся").Равно(0);

КонецПроцедуры

&Тест
Процедура ТестСлить_БезПокрываемых_ВозвращаетИсходное() Экспорт
	Исполненное = Новый Соответствие;
	Исполненное.Вставить("x", Новый Соответствие);
	Ожидаем.Что(Слияние.Слить(Исполненное, Неопределено).Количество(), "без знаменателя").Равно(1);
КонецПроцедуры

&Тест
Процедура ТестСтатистика_СчитаетПроцент() Экспорт

	Покрытие = Новый Соответствие;
	Строки = Новый Соответствие;
	Строки.Вставить("1", Новый Структура("count, time", 4, 0));
	Строки.Вставить("2", Новый Структура("count, time", 0, 0));
	Строки.Вставить("3", Новый Структура("count, time", 0, 0));
	Строки.Вставить("4", Новый Структура("count, time", 1, 0));
	Покрытие.Вставить("f", Строки);

	Стат = Слияние.Статистика(Покрытие);

	Ожидаем.Что(Стат.Всего, "всего строк").Равно(4);
	Ожидаем.Что(Стат.Покрыто, "покрыто строк").Равно(2);
	Ожидаем.Что(Стат.Процент, "процент").Равно(50);

КонецПроцедуры

&Тест
Процедура ТестКлючПути_НормализуетРазделителиИРегистр() Экспорт
	Ключ1 = Слияние.КлючПути("C:\Proj\Src\Module.BSL");
	Ключ2 = Слияние.КлючПути("c:/proj/src/module.bsl");
	Ожидаем.Что(Ключ1, "нормализованный ключ").Равно(Ключ2);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	Слияние = Новый СлияниеПокрытия;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Массив(Знач А, Знач Б, Знач В = Неопределено)
	Результат = Новый Массив;
	Результат.Добавить(А);
	Результат.Добавить(Б);
	Если В <> Неопределено Тогда
		Результат.Добавить(В);
	КонецЕсли;
	Возврат Результат;
КонецФункции

#КонецОбласти
