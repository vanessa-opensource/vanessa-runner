// BSLLS:MissingVariablesDescription-off
// Кеш моков moskito на процесс и доступ к их состоянию: сброс между тестами и чтение вызовов.
// Единственное место, знающее внутреннее устройство мока (поле Мок_Состояние).

Перем _Кеш;
Перем _Рефлектор;

// Мок из кеша процесса.
//
// Параметры:
//   ИмяТипа - Строка - имя мокируемого типа
//
// Возвращаемое значение:
//   Произвольный, Неопределено - мок либо Неопределено, если ещё не создавался
//
Функция Получить(Знач ИмяТипа) Экспорт
	Возврат _Кеш[ИмяТипа];
КонецФункции

// Запомнить мок в кеше процесса.
//
// Параметры:
//   ИмяТипа - Строка - имя мокируемого типа
//   Мок - Произвольный - мок moskito
//
Процедура Сохранить(Знач ИмяТипа, Знач Мок) Экспорт
	_Кеш.Вставить(ИмяТипа, Мок);
КонецПроцедуры

// Очистить записанные вызовы и стабы мока. Делегирование шпиона в реальный объект сохраняется.
//
// Параметры:
//   Мок - Произвольный - мок moskito
//
Процедура Сбросить(Знач Мок) Экспорт
	Данные = Состояние(Мок);
	Данные.Вызовы.Очистить();
	Данные.Стабы.Очистить();
КонецПроцедуры

// Параметры зафиксированных вызовов метода мока.
//
// Параметры:
//   Мок - Произвольный - мок moskito
//   ИмяМетода - Строка - имя метода (без учёта регистра)
//
// Возвращаемое значение:
//   Массив из Структура - параметры каждого вызова по именам из сигнатуры, включая умолчания
//
Функция Вызовы(Знач Мок, Знач ИмяМетода) Экспорт

	Имена = ИменаПараметров(Мок, ИмяМетода);
	Результат = Новый Массив;
	Для Каждого Вызов Из Состояние(Мок).Вызовы Цикл
		Если ВРег(Вызов.ИмяМетода) = ВРег(ИмяМетода) Тогда
			Результат.Добавить(ПараметрыВызова(Имена, Вызов.Параметры));
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция Состояние(Знач Мок)
	Возврат _Рефлектор.ПолучитьСвойство(Мок, "Мок_Состояние");
КонецФункции

Функция ИменаПараметров(Знач Мок, Знач ИмяМетода)

	Для Каждого Метод Из _Рефлектор.ПолучитьТаблицуМетодов(Мок) Цикл
		Если ВРег(Метод.Имя) = ВРег(ИмяМетода) Тогда
			Возврат Метод.Параметры.ВыгрузитьКолонку("Имя");
		КонецЕсли;
	КонецЦикла;

	// Опечатка в имени не должна давать ложный «не вызывался».
	ВызватьИсключение СтрШаблон("Метод %1 не объявлен у типа", ИмяМетода);

КонецФункции

Функция ПараметрыВызова(Знач Имена, Знач Значения)

	Параметры = Новый Структура;
	Для Индекс = 0 По Имена.ВГраница() Цикл
		Параметры.Вставить(Имена[Индекс], Значения[Индекс]);
	КонецЦикла;

	Возврат Параметры;

КонецФункции

_Кеш = Новый Соответствие;
_Рефлектор = Новый Рефлектор;
