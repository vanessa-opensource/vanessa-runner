// Как создаётся и как ведёт себя по умолчанию мок каждого типа - единое место описания моков.
// Пресет добавляется, когда одинаковый Когда() повторяется в 3+ тестах разных файлов.
// Таблица пресетов продублирована в tests/unit/README.md - править вместе.
// BSLLS:IfElseIfEndsWithElse-off Цепочка пресетов по имени типа: тип без пресета ветви не требует.
// BSLLS:UnusedParameters-off Коллбеки Ответа получают ИнформацияОВызове по контракту moskito.

#Использовать moskito
#Использовать v8runner
#Использовать ibcmdrunner
#Использовать edtfind
#Использовать v8storage
#Использовать "../../../../src/core/Приложение"

// Мок типа по имени. По умолчанию - мок из типа (методы возвращают NULL, вызовы записываются).
//
// Параметры:
//   ИмяТипа - Строка - имя класса src/core или внешней библиотеки
//
// Возвращаемое значение:
//   Произвольный - мок moskito
//
Функция Создать(Знач ИмяТипа) Экспорт

	Если Это(ИмяТипа, "СервисОкружения") Тогда
		// Шпион: определение ОС и каталогов настоящее, внешние поиски (PATH, Vanessa-ADD) застаблены ниже.
		Возврат Мок.Следить(Новый СервисОкружения);
	КонецЕсли;

	Попытка
		Возврат Мок.Получить(Тип(ИмяТипа));
	Исключение
		Ошибка = ОписаниеОшибки();
		ВызватьИсключение СтрШаблон("Тип %1 не загружен: для src/core его подключает Стенд,"
			+ " для внешней библиотеки добавьте #Использовать в ПоведениеМоков.os. %2", ИмяТипа, Ошибка);
	КонецПопытки;

КонецФункции

// Поведение мока по умолчанию (пресет). Когда() в тесте на тот же метод заменяет пресет целиком.
//
// Параметры:
//   ИмяТипа - Строка - имя мокируемого типа
//   МокТипа - Произвольный - мок, только что сброшенный стендом
//
Процедура Применить(Знач ИмяТипа, Знач МокТипа) Экспорт

	Любое = Матчеры.ЛюбоеЗначение();

	Если Это(ИмяТипа, "УправлениеКонфигуратором") Тогда
		МокТипа.Когда().ПолучитьПараметрыЗапуска().ТогдаОтвечает(Новый Ответ(ЭтотОбъект, "ПараметрыЗапускаКонфигуратора"));
		МокТипа.Когда().ВыводКоманды().ТогдаВозвращает("");
		МокТипа.Когда().ПутьКПлатформе1С(Любое).ТогдаВозвращает("1cv8.exe");
		МокТипа.Когда().ПутьКТонкомуКлиенту1С(Любое).ТогдаВозвращает("1cv8c.exe");
	ИначеЕсли Это(ИмяТипа, "УправлениеИБ") Тогда
		МокТипа.Когда().ОписанияРасширений().ТогдаВозвращает(Новый Массив);
	ИначеЕсли Это(ИмяТипа, "СервисОкружения") Тогда
		МокТипа.Когда().НайтиВPATH(Любое).ТогдаВозвращает("");
		МокТипа.Когда().КаталогVanessaADD().ТогдаВозвращает("");
	ИначеЕсли Это(ИмяТипа, "ДвижокКонфигуратор") ИЛИ Это(ИмяТипа, "ДвижокIbcmd") Тогда
		МокТипа.Когда().СоздатьВременнуюБазу(Любое).ТогдаОтвечает(Новый Ответ(ЭтотОбъект, "ВременнаяБаза"));
	ИначеЕсли Это(ИмяТипа, "СервисЗапускаОбработок") Тогда
		МокТипа.Когда().ВыполнитьОбработку(Любое, Любое, Любое, Любое, Любое)
			.ТогдаВозвращает(ТестовыеДанные.РезультатОбработки());
	ИначеЕсли Это(ИмяТипа, "СервисEDT") Тогда
		МокТипа.Когда().ПодготовитьXML(Любое, Любое).ТогдаОтвечает(Новый Ответ(ЭтотОбъект, "XMLКакЕсть"));
		МокТипа.Когда().НачатьВыгрузку(Любое, Любое).ТогдаОтвечает(Новый Ответ(ЭтотОбъект, "ВыгрузкаВЦелевойКаталог"));
	КонецЕсли;

КонецПроцедуры

Функция Это(Знач ИмяТипа, Знач Ожидаемое)
	Возврат ВРег(ИмяТипа) = ВРег(Ожидаемое);
КонецФункции

#Область КоллбекиОтветов

// Свежая копия стандартных параметров запуска v8runner: режим, строка подключения, /Out в рабочий каталог.
//
// Параметры:
//   Вызов - ИнформацияОВызове - вызов застабленного метода
//
// Возвращаемое значение:
//   Массив из Строка - параметры запуска
//
Функция ПараметрыЗапускаКонфигуратора(Знач Вызов) Экспорт
	Возврат ТестовыеДанные.Массив("DESIGNER", "/IBConnectionString""File=stub""", "/Out ""default-out""");
КонецФункции

// Новый временный каталог файловой ИБ на каждый вызов СоздатьВременнуюБазу.
//
// Параметры:
//   Вызов - ИнформацияОВызове - вызов застабленного метода
//
// Возвращаемое значение:
//   Структура - см. ТестовыеДанные.Файловая
//
Функция ВременнаяБаза(Знач Вызов) Экспорт
	Возврат ТестовыеДанные.ВременнаяФайловая();
КонецФункции

// ПодготовитьXML: исходники считаются готовым XML по переданному пути.
//
// Параметры:
//   Вызов - ИнформацияОВызове - вызов застабленного метода
//
// Возвращаемое значение:
//   Структура - см. ТестовыеДанные.КонтекстXML
//
Функция XMLКакЕсть(Знач Вызов) Экспорт
	Возврат ТестовыеДанные.КонтекстXML(Вызов.Параметры()[0]);
КонецФункции

// НачатьВыгрузку: XML пишется прямо в целевой каталог, без конвертации в EDT.
//
// Параметры:
//   Вызов - ИнформацияОВызове - вызов застабленного метода
//
// Возвращаемое значение:
//   Структура - см. ТестовыеДанные.КонтекстВыгрузки
//
Функция ВыгрузкаВЦелевойКаталог(Знач Вызов) Экспорт
	Возврат ТестовыеДанные.КонтекстВыгрузки(Вызов.Параметры()[0]);
КонецФункции

#КонецОбласти
