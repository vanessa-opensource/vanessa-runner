// Файлы и каталоги для юнит-тестов: всё создаётся во временных каталогах tempfiles;
// тест убирает их в &ПослеКаждого через ВременныеФайлы.Удалить(). Пути возвращаются полные.

#Использовать tempfiles
#Использовать moskito

// Записать текст в файл (UTF-8 без BOM, как файлы EDT и настроек), создав недостающие каталоги.
//
// Параметры:
//   Путь - Строка - путь к файлу
//   Текст - Строка - содержимое
//
// Возвращаемое значение:
//   Строка - тот же путь
//
Функция ЗаписатьФайл(Знач Путь, Знач Текст = "") Экспорт

	СоздатьКаталог(Новый Файл(Путь).Путь);
	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8NoBOM);
	Запись.Записать(Текст);
	Запись.Закрыть();

	Возврат Путь;

КонецФункции

// Прочитать текст файла (UTF-8). Файл открывается немонопольно: параллельные процессы CI не сталкиваются.
//
// Параметры:
//   Путь - Строка - путь к файлу
//
// Возвращаемое значение:
//   Строка - содержимое; пустая строка для пустого файла
//
Функция ПрочитатьФайл(Знач Путь) Экспорт

	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8, , , Ложь);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();

	Возврат ?(Текст = Неопределено, "", Текст);

КонецФункции

// Прочитать JSON-файл; объекты - в Соответствие.
//
// Параметры:
//   Путь - Строка - путь к файлу
//
// Возвращаемое значение:
//   Соответствие, Массив, Строка, Число, Булево, Неопределено - данные файла
//
Функция ПрочитатьJSON(Знач Путь) Экспорт

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ПрочитатьФайл(Путь));
	Данные = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();

	Возврат Данные;

КонецФункции

// Записать данные в JSON-файл, создав недостающие каталоги.
//
// Параметры:
//   Путь - Строка - путь к файлу
//   Данные - Структура, Соответствие, Массив - содержимое
//
// Возвращаемое значение:
//   Строка - тот же путь
//
Функция ЗаписатьJSON(Знач Путь, Знач Данные) Экспорт

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);

	Возврат ЗаписатьФайл(Путь, Запись.Закрыть());

КонецФункции

// Полный путь внутри каталога по относительному пути с разделителем "/" (без создания файла).
//
// Параметры:
//   Каталог - Строка - корневой каталог
//   ОтносительныйПуть - Строка - путь от корня, например "src/Configuration/Configuration.mdo"
//
// Возвращаемое значение:
//   Строка - полный путь
//
Функция Путь(Знач Каталог, Знач ОтносительныйПуть) Экспорт

	Результат = Каталог;
	Для Каждого Часть Из СтрРазделить(ОтносительныйПуть, "/") Цикл
		Результат = ОбъединитьПути(Результат, Часть);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Файл внутри каталога по относительному пути с разделителем "/"; подкаталоги создаются.
//
// Параметры:
//   Каталог - Строка - корневой каталог
//   ОтносительныйПуть - Строка - путь от корня, например "src/Configuration/Configuration.mdo"
//   Текст - Строка - содержимое
//
// Возвращаемое значение:
//   Строка - полный путь к файлу
//
Функция Файл(Знач Каталог, Знач ОтносительныйПуть, Знач Текст = "") Экспорт
	Возврат ЗаписатьФайл(Путь(Каталог, ОтносительныйПуть), Текст);
КонецФункции

// Временный каталог с маркерами проекта 1С:EDT (.project и src/Configuration/Configuration.mdo).
//
// Параметры:
//   ИмяПодкаталога - Строка - имя каталога проекта; пусто - сам временный каталог
//
// Возвращаемое значение:
//   Строка - полный путь к каталогу проекта
//
Функция КаталогEDT(Знач ИмяПодкаталога = "") Экспорт

	Каталог = НовыйКаталог(ИмяПодкаталога);
	МаркерыEDT(Каталог);

	Возврат Каталог;

КонецФункции

// Временный каталог с маркером XML-выгрузки Конфигуратора (Configuration.xml).
//
// Параметры:
//   ИмяПодкаталога - Строка - имя каталога выгрузки; пусто - сам временный каталог
//
// Возвращаемое значение:
//   Строка - полный путь к каталогу выгрузки
//
Функция КаталогXML(Знач ИмяПодкаталога = "") Экспорт

	Каталог = НовыйКаталог(ИмяПодкаталога);
	Файл(Каталог, "Configuration.xml");

	Возврат Каталог;

КонецФункции

// Пустой файл расширения <Имя>.cfe во временном каталоге.
//
// Параметры:
//   ИмяБезРасширения - Строка - имя файла (оно же имя расширения)
//
// Возвращаемое значение:
//   Строка - полный путь к файлу
//
Функция ФайлCfe(Знач ИмяБезРасширения) Экспорт
	Возврат ЗаписатьФайл(ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), ИмяБезРасширения + ".cfe"));
КонецФункции

// Существует ли файл или каталог.
//
// Параметры:
//   Путь - Строка - путь
//
// Возвращаемое значение:
//   Булево - Истина, если существует
//
Функция Существует(Знач Путь) Экспорт
	Возврат Новый Файл(Путь).Существует();
КонецФункции

// Ответ moskito для ТогдаОтвечает: при вызове мока записать текст в файл из N-го параметра.
//
// Параметры:
//   ИндексПараметраПути - Число - индекс параметра метода с путём к файлу (с нуля, по сигнатуре)
//   Текст - Строка - содержимое файла
//
// Возвращаемое значение:
//   Ответ - обработчик для Когда().Метод(...).ТогдаОтвечает(...)
//
Функция ЗаписатьПриВызове(Знач ИндексПараметраПути, Знач Текст) Экспорт
	Возврат Новый Ответ(Новый ОтветЗаписьФайла(ИндексПараметраПути, Текст), "Ответить");
КонецФункции

// Временный файл с текстом; имя случайное.
//
// Параметры:
//   Расширение - Строка - расширение файла без точки
//   Текст - Строка - содержимое
//
// Возвращаемое значение:
//   Строка - полный путь к файлу
//
Функция ВременныйФайл(Знач Расширение = "tmp", Знач Текст = "") Экспорт
	Возврат ЗаписатьФайл(ВременныеФайлы.НовоеИмяФайла(Расширение), Текст);
КонецФункции

// Путь внутри нового временного каталога, по которому ничего нет.
//
// Параметры:
//   Имя - Строка - имя файла или каталога
//
// Возвращаемое значение:
//   Строка - полный путь
//
Функция НесуществующийПуть(Знач Имя = "нет") Экспорт
	Возврат ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), Имя);
КонецФункции

// Маркеры проекта 1С:EDT (.project и src/Configuration/Configuration.mdo) в каталоге.
//
// Параметры:
//   Каталог - Строка - каталог проекта
//
Процедура МаркерыEDT(Знач Каталог) Экспорт
	Файл(Каталог, ".project");
	Файл(Каталог, "src/Configuration/Configuration.mdo");
КонецПроцедуры

// Временный файл кеша ConfigDumpInfo с минимальным XML.
//
// Возвращаемое значение:
//   Строка - полный путь к файлу
//
Функция ФайлКешаDumpInfo() Экспорт
	Возврат ВременныйФайл("xml", "<some/>");
КонецФункции

// Открыть файл на чтение как посторонний читатель: проверка немонопольного чтения в SUT.
// Поток закрывает тест в &ПослеКаждого до ВременныеФайлы.Удалить().
//
// Параметры:
//   Путь - Строка - путь к файлу
//
// Возвращаемое значение:
//   ФайловыйПоток - открытый поток
//
Функция ОткрытьНаЧтение(Знач Путь) Экспорт
	Возврат Новый ФайловыйПоток(Путь, РежимОткрытияФайла.Открыть, ДоступКФайлу.Чтение);
КонецФункции

Функция НовыйКаталог(Знач ИмяПодкаталога)

	Каталог = ВременныеФайлы.СоздатьКаталог();
	Если ЗначениеЗаполнено(ИмяПодкаталога) Тогда
		Каталог = ОбъединитьПути(Каталог, ИмяПодкаталога);
		СоздатьКаталог(Каталог);
	КонецЕсли;

	Возврат Каталог;

КонецФункции
