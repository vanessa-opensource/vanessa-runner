// BSLLS:NumberOfValuesInStructureConstructor-off
// BSLLS:NumberOfOptionalParams-off
// BSLLS:NumberOfParams-off
// Тестовые данные: параметры подключения и структуры-результаты зависимостей в том виде,
// в каком их отдают сервисы src/core. Только данные, без обращения к моку и стенду.

#Использовать tempfiles

// Параметры подключения к фиктивной файловой ИБ по указанному каталогу.
//
// Параметры:
//   Каталог - Строка - каталог базы (может не существовать)
//
// Возвращаемое значение:
//   Структура - СтрокаПодключения, Пользователь, Пароль, КаталогБазы
//
Функция Файловая(Знач Каталог) Экспорт
	Возврат Новый Структура("СтрокаПодключения, Пользователь, Пароль, КаталогБазы",
		"/F""" + Каталог + """", "", "", Каталог);
КонецФункции

// Параметры подключения к реально созданному временному каталогу файловой ИБ.
// Каталог можно проверить на удаление в утверждениях теста.
//
// Возвращаемое значение:
//   Структура - см. Файловая
//
Функция ВременнаяФайловая() Экспорт
	Возврат Файловая(ВременныеФайлы.СоздатьКаталог());
КонецФункции

// Параметры подключения с произвольной строкой подключения.
//
// Параметры:
//   СтрокаПодключения - Строка - строка подключения (/F..., /S..., File=...)
//   Пользователь - Строка - имя пользователя ИБ
//   Пароль - Строка - пароль пользователя ИБ
//
// Возвращаемое значение:
//   Структура - СтрокаПодключения, Пользователь, Пароль
//
Функция Подключение(Знач СтрокаПодключения, Знач Пользователь = "", Знач Пароль = "") Экспорт
	Возврат Новый Структура("СтрокаПодключения, Пользователь, Пароль", СтрокаПодключения, Пользователь, Пароль);
КонецФункции

// Параметры подготовки исходников (СервисEDT).
//
// Параметры:
//   Формат - Строка - auto, xml или edt
//   Версия - Строка - версия 1С:EDT
//   Workspace - Строка - каталог workspace 1С:EDT
//
// Возвращаемое значение:
//   Структура - Формат, Версия, Workspace
//
Функция ПараметрыИсходников(Знач Формат = "auto", Знач Версия = "", Знач Workspace = "") Экспорт
	Возврат Новый Структура("Формат, Версия, Workspace", Формат, Версия, Workspace);
КонецФункции

// Результат СервисEDT.ПодготовитьXML: XML-исходники по указанному пути.
//
// Параметры:
//   Путь - Строка - каталог XML-исходников
//   КаталогEDT - Строка - корень EDT-проекта, если исходники экспортированы из EDT
//   Временный - Булево - Истина, если каталог XML временный (подлежит удалению)
//
// Возвращаемое значение:
//   Структура - Путь, Временный, ЭтоEDT, КаталогEDT, ВременныйКаталог
//
Функция КонтекстXML(Знач Путь, Знач КаталогEDT = "", Знач Временный = Ложь) Экспорт
	Возврат Новый Структура("Путь, Временный, ЭтоEDT, КаталогEDT, ВременныйКаталог",
		Путь, Временный, ЗначениеЗаполнено(КаталогEDT), КаталогEDT, ?(Временный, Путь, ""));
КонецФункции

// Результат СервисEDT.НачатьВыгрузку: выгрузка XML прямо в целевой каталог, без конвертации в EDT.
//
// Параметры:
//   ЦелевойКаталог - Строка - каталог выгрузки
//
// Возвращаемое значение:
//   Структура - Путь, ЦелевойКаталог, Временный, ПараметрыИсходников
//
Функция КонтекстВыгрузки(Знач ЦелевойКаталог) Экспорт
	Возврат Новый Структура("Путь, ЦелевойКаталог, Временный, ПараметрыИсходников",
		ЦелевойКаталог, ЦелевойКаталог, Ложь, Неопределено);
КонецФункции

// Результат СервисРасчетаИнкремента.Рассчитать*.
//
// Параметры:
//   СписокФайлов - Строка - путь к файлу со списком файлов для загрузки
//   Пропустить - Булево - Истина: изменений нет, загрузку пропустить
//   Контекст - Структура, Неопределено - контекст для ЗафиксироватьИнкремент
//
// Возвращаемое значение:
//   Структура - ПропуститьЗагрузку, СписокФайловДляЗагрузки, КонтекстИнкремента
//
Функция РезультатИнкремента(Знач СписокФайлов = "", Знач Пропустить = Ложь, Знач Контекст = Неопределено) Экспорт
	Возврат Новый Структура("ПропуститьЗагрузку, СписокФайловДляЗагрузки, КонтекстИнкремента",
		Пропустить, СписокФайлов, ?(Контекст = Неопределено, Новый Структура, Контекст));
КонецФункции

// Результат СервисЗапускаОбработок.ВыполнитьОбработку.
//
// Параметры:
//   Сообщения - Массив из Строка, Неопределено - сообщения обработки
//   КодВозврата - Число - код возврата обработки
//
// Возвращаемое значение:
//   Структура - КодВозврата, Сообщения, Ошибка, ФайлНайден
//
Функция РезультатОбработки(Знач Сообщения = Неопределено, Знач КодВозврата = 0) Экспорт
	Возврат Новый Структура("КодВозврата, Сообщения, Ошибка, ФайлНайден",
		КодВозврата, ?(Сообщения = Неопределено, Новый Массив, Сообщения), "", Истина);
КонецФункции

// Массив из перечисленных значений; хвостовые Неопределено отбрасываются.
//
// Параметры:
//   Э1 - Произвольный - первый элемент
//   Э2 - Произвольный - второй элемент
//   Э3 - Произвольный - третий элемент
//   Э4 - Произвольный - четвёртый элемент
//   Э5 - Произвольный - пятый элемент
//   Э6 - Произвольный - шестой элемент
//   Э7 - Произвольный - седьмой элемент
//   Э8 - Произвольный - восьмой элемент
//
// Возвращаемое значение:
//   Массив - элементы до последнего заданного включительно
//
Функция Массив(Знач Э1, Знач Э2 = Неопределено, Знач Э3 = Неопределено, Знач Э4 = Неопределено,
	Знач Э5 = Неопределено, Знач Э6 = Неопределено, Знач Э7 = Неопределено, Знач Э8 = Неопределено) Экспорт

	Все = Новый Массив;
	Все.Добавить(Э1);
	Все.Добавить(Э2);
	Все.Добавить(Э3);
	Все.Добавить(Э4);
	Все.Добавить(Э5);
	Все.Добавить(Э6);
	Все.Добавить(Э7);
	Все.Добавить(Э8);

	Длина = Все.Количество();
	Пока Длина > 1 И Все[Длина - 1] = Неопределено Цикл
		Длина = Длина - 1;
	КонецЦикла;

	Результат = Новый Массив;
	Для Индекс = 0 По Длина - 1 Цикл
		Результат.Добавить(Все[Индекс]);
	КонецЦикла;

	Возврат Результат;

КонецФункции
