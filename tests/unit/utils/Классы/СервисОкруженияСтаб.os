// BSLLS:ExportVariables-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:LatinAndCyrillicSymbolInWord-off
// Стаб СервисОкружения для юнит-тестов: каталоги задаются явно, без поиска движка и пакетов;
// поиск в PATH отдаёт заданный путь и запоминает запросы. Свойства ОС - от реального сервиса.

#Использовать "../../../../src/core/Приложение"

Перем КаталогADD Экспорт;
Перем РабочийКаталог_ Экспорт;
Перем КорневойКаталог_ Экспорт;
Перем ПутьВPATH Экспорт;    // Что «находит» НайтиВPATH (пустая строка - в PATH нет).
Перем ЗапросыВPATH Экспорт; // Имена файлов, которые искали в PATH.
Перем Реальный;

Процедура ПриСозданииОбъекта()
	КаталогADD = "";
	РабочийКаталог_ = ТекущийКаталог();
	КорневойКаталог_ = ТекущийКаталог();
	ПутьВPATH = "";
	ЗапросыВPATH = Новый Массив;
	Реальный = Новый СервисОкружения;
КонецПроцедуры

// Задать каталог установки vanessa-add.
//
// Параметры:
//   Путь - Строка - каталог add; пусто - пакет не установлен
//
// Возвращаемое значение:
//   СервисОкруженияСтаб - этот объект
//
Функция СКаталогомADD(Знач Путь) Экспорт
	КаталогADD = Путь;
	Возврат ЭтотОбъект;
КонецФункции

Функция КаталогVanessaADD() Экспорт
	Возврат КаталогADD;
КонецФункции

Функция РабочийКаталог() Экспорт
	Возврат РабочийКаталог_;
КонецФункции

Функция КорневойКаталогПакета() Экспорт
	Возврат КорневойКаталог_;
КонецФункции

Функция ПутьИлиРабочийКаталог(Знач Путь) Экспорт
	Возврат ?(ЗначениеЗаполнено(Путь), Путь, РабочийКаталог_);
КонецФункции

Функция НайтиВPATH(Знач ИмяФайла) Экспорт
	ЗапросыВPATH.Добавить(ИмяФайла);
	Возврат ПутьВPATH;
КонецФункции

Функция ТипПлатформы() Экспорт
	Возврат Реальный.ТипПлатформы();
КонецФункции

Функция ВерсияOneScript() Экспорт
	Возврат Реальный.ВерсияOneScript();
КонецФункции

Функция ЭтоWindows() Экспорт
	Возврат Реальный.ЭтоWindows();
КонецФункции

Функция ЭтоMacOS() Экспорт
	Возврат Реальный.ЭтоMacOS();
КонецФункции

Функция ИмяИсполняемогоФайла(Знач Имя) Экспорт
	Возврат Реальный.ИмяИсполняемогоФайла(Имя);
КонецФункции
