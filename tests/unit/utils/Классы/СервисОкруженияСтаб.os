// BSLLS:ExportVariables-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:LatinAndCyrillicSymbolInWord-off
// Стаб СервисОкружения для юнит-тестов: каталоги задаются явно, без поиска движка и пакетов.

Перем КаталогADD Экспорт;
Перем РабочийКаталог_ Экспорт;
Перем КорневойКаталог_ Экспорт;

Процедура ПриСозданииОбъекта()
	КаталогADD = "";
	РабочийКаталог_ = ТекущийКаталог();
	КорневойКаталог_ = ТекущийКаталог();
КонецПроцедуры

// Задать каталог установки vanessa-add.
//
// Параметры:
//   Путь - Строка - каталог add; пусто - пакет не установлен
//
// Возвращаемое значение:
//   СервисОкруженияСтаб - этот объект
//
Функция СКаталогомADD(Знач Путь) Экспорт
	КаталогADD = Путь;
	Возврат ЭтотОбъект;
КонецФункции

Функция КаталогVanessaADD() Экспорт
	Возврат КаталогADD;
КонецФункции

Функция РабочийКаталог() Экспорт
	Возврат РабочийКаталог_;
КонецФункции

Функция КорневойКаталогПакета() Экспорт
	Возврат КорневойКаталог_;
КонецФункции
