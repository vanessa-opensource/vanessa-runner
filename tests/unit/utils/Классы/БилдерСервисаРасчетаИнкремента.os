// BSLLS:MissingVariablesDescription-off
// Билдер СервисРасчетаИнкремента для юнит-тестов.
// Создаёт сервис с временным каталогом кеша и (опционально) мокнутым СервисПлатформы.

#Использовать reflector
#Использовать tempfiles
#Использовать logos
#Использовать "../../../../src/core/Файлы"
#Использовать "../../../../src/core/Сервисы"

Перем _КаталогКеша;
Перем _СервисПлатформы;

Процедура ПриСозданииОбъекта()
	_КаталогКеша = ВременныеФайлы.СоздатьКаталог();
	_СервисПлатформы = Неопределено;
КонецПроцедуры

Функция СКаталогомКеша(Каталог) Экспорт
	_КаталогКеша = Каталог;
	Возврат ЭтотОбъект;
КонецФункции

Функция СПлатформой(Сервис) Экспорт
	_СервисПлатформы = Сервис;
	Возврат ЭтотОбъект;
КонецФункции

Функция КаталогКеша() Экспорт
	Возврат _КаталогКеша;
КонецФункции

Функция Собрать() Экспорт

	Сервис = Новый СервисРасчетаИнкремента(_КаталогКеша);

	Рефлектор = Новый Рефлектор;
	Рефлектор.УстановитьСвойство(Сервис, "Лог", Логирование.ПолучитьЛог("vrunner"));
	Рефлектор.УстановитьСвойство(Сервис, "ФайловыеОперации", Новый ФайловыеОперации);
	Рефлектор.УстановитьСвойство(Сервис, "СервисПлатформы", _СервисПлатформы);

	Возврат Сервис;

КонецФункции
