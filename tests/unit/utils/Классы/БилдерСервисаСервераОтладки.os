// BSLLS:MissingVariablesDescription-off
// BSLLS:LatinAndCyrillicSymbolInWord-off
// Билдер СервисСервераОтладки для юнит-тестов.
// Через Рефлектор внедряет Лог и фабрику процесса-стаб, отключает ожидание готовности.

#Использовать reflector
#Использовать logos
#Использовать "../../../../src/core/Сервисы"

Перем _Фабрика;
Перем _ТаймаутГотовности;

Процедура ПриСозданииОбъекта()
	_Фабрика = Неопределено;
	_ТаймаутГотовности = 2000;
КонецПроцедуры

Функция СФабрикойПроцесса(Фабрика) Экспорт
	_Фабрика = Фабрика;
	Возврат ЭтотОбъект;
КонецФункции

Функция СТаймаутомГотовности(Мс) Экспорт
	_ТаймаутГотовности = Мс;
	Возврат ЭтотОбъект;
КонецФункции

Функция Собрать() Экспорт

	Сервис = Новый СервисСервераОтладки;

	Рефлектор = Новый Рефлектор;
	Рефлектор.УстановитьСвойство(Сервис, "Лог", Логирование.ПолучитьЛог("vrunner"));
	Если _Фабрика <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Сервис, "_ФабрикаПроцесса", _Фабрика);
	КонецЕсли;

	Сервис.УстановитьТаймаутГотовности(_ТаймаутГотовности);

	Возврат Сервис;

КонецФункции
