// BSLLS:ExportVariables-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:NumberOfValuesInStructureConstructor-off
// Стаб v8runner.УправлениеКонфигуратором для юнит-тестов.
// Записывает все вызовы для последующей проверки в тесте.

Перем СтрокаПодключения_ Экспорт;
Перем ПользовательИБ_ Экспорт;
Перем ПарольИБ_ Экспорт;
Перем ВерсияПлатформы_ Экспорт;
Перем КодРазрешения_ Экспорт;
Перем Язык_ Экспорт;
Перем Локаль_ Экспорт;
Перем Вызовы Экспорт;
Перем БроситьВ Экспорт;
Перем ВыводКоманды_ Экспорт;
Перем ФайлСообщенийПлатформы_ Экспорт;

// Эмуляция v8runner: ПолучитьПараметрыЗапуска возвращает массив [DESIGNER, /IBConn, /Out, /N, /P]
Перем ШаблонПараметровЗапуска Экспорт;

Процедура ПриСозданииОбъекта()
	СтрокаПодключения_ = "";
	ПользовательИБ_ = "";
	ПарольИБ_ = "";
	ВерсияПлатформы_ = "";
	КодРазрешения_ = "";
	Язык_ = "";
	Локаль_ = "";
	Вызовы = Новый Массив;
	БроситьВ = "";
	ВыводКоманды_ = "STDOUT-stub";
	ФайлСообщенийПлатформы_ = "";
	ШаблонПараметровЗапуска = Новый Массив;
	ШаблонПараметровЗапуска.Добавить("DESIGNER");
	ШаблонПараметровЗапуска.Добавить("/IBConnectionString""File=stub""");
	ШаблонПараметровЗапуска.Добавить("/Out ""default-out""");
КонецПроцедуры

Функция СБросанием(ИмяМетода) Экспорт
	БроситьВ = ИмяМетода;
	Возврат ЭтотОбъект;
КонецФункции

Функция Создать() Экспорт
	Возврат ЭтотОбъект;
КонецФункции

Процедура ЗаписатьВызов(Знач Метод, Знач Параметры = Неопределено)
	Вызовы.Добавить(Новый Структура("Метод, Параметры", Метод, Параметры));
	Если Метод = БроситьВ Тогда
		ВызватьИсключение СтрШаблон("стаб: %1 упал", Метод); // BSLLS:Typo-off
	КонецЕсли;
КонецПроцедуры

// === Платформа ===

Процедура ИспользоватьВерсиюПлатформы(Версия) Экспорт
	ВерсияПлатформы_ = Версия;
	ЗаписатьВызов("ИспользоватьВерсиюПлатформы", Версия);
КонецПроцедуры

Процедура УстановитьКлючРазрешенияЗапуска(Ключ) Экспорт
	КодРазрешения_ = Ключ;
	ЗаписатьВызов("УстановитьКлючРазрешенияЗапуска", Ключ);
КонецПроцедуры

Процедура УстановитьКодЯзыка(Язык) Экспорт
	Язык_ = Язык;
КонецПроцедуры

Процедура УстановитьКодЯзыкаСеанса(Локаль) Экспорт
	Локаль_ = Локаль;
КонецПроцедуры

Процедура УстановитьИмяФайлаСообщенийПлатформы(Знач ПолныйПутьКФайлу, Знач ОчищатьФайл = Истина) Экспорт
	ФайлСообщенийПлатформы_ = ПолныйПутьКФайлу;
	ЗаписатьВызов("УстановитьИмяФайлаСообщенийПлатформы", ПолныйПутьКФайлу);
КонецПроцедуры

Процедура УстановитьКонтекст(СтрокаПодключения, Пользователь, Пароль) Экспорт
	СтрокаПодключения_ = СтрокаПодключения;
	ПользовательИБ_ = Пользователь;
	ПарольИБ_ = Пароль;
	ЗаписатьВызов("УстановитьКонтекст",
		Новый Структура("СтрокаПодключения, Пользователь, Пароль", СтрокаПодключения, Пользователь, Пароль));
КонецПроцедуры

// === Базовые операции ===

Процедура СоздатьФайловуюБазу(Каталог) Экспорт
	ЗаписатьВызов("СоздатьФайловуюБазу", Каталог);
КонецПроцедуры

Процедура ЗагрузитьИнформационнуюБазу(Путь) Экспорт
	ЗаписатьВызов("ЗагрузитьИнформационнуюБазу", Путь);
КонецПроцедуры

Процедура ВыгрузитьИнформационнуюБазу(Путь) Экспорт
	ЗаписатьВызов("ВыгрузитьИнформационнуюБазу", Путь);
КонецПроцедуры

Процедура ЗагрузитьКонфигурациюИзФайла(Путь) Экспорт
	ЗаписатьВызов("ЗагрузитьКонфигурациюИзФайла", Путь);
КонецПроцедуры

Процедура ЗагрузитьКонфигурациюИзФайлов(Каталог, СписокФайлов) Экспорт
	ЗаписатьВызов("ЗагрузитьКонфигурациюИзФайлов",
		Новый Структура("Каталог, Список", Каталог, СписокФайлов));
КонецПроцедуры

Процедура ВыгрузитьКонфигурациюВФайл(Путь) Экспорт
	ЗаписатьВызов("ВыгрузитьКонфигурациюВФайл", Путь);
КонецПроцедуры

Процедура ВыгрузитьКонфигурациюВФайлы(Каталог) Экспорт
	ЗаписатьВызов("ВыгрузитьКонфигурациюВФайлы", Каталог);
КонецПроцедуры

Процедура ОбновитьКонфигурациюБазыДанных(А1, А2, А3, А4, А5) Экспорт
	ЗаписатьВызов("ОбновитьКонфигурациюБазыДанных",
		Новый Структура("А1, А2, А3, А4, А5", А1, А2, А3, А4, А5));
КонецПроцедуры

Процедура ОбновитьКонфигурациюБазыДанныхНаСервере(А1, А2, А3, А4, А5) Экспорт
	ЗаписатьВызов("ОбновитьКонфигурациюБазыДанныхНаСервере",
		Новый Структура("А1, А2, А3, А4, А5", А1, А2, А3, А4, А5));
КонецПроцедуры

Процедура ОбъединитьКонфигурациюСФайлом(А1, А2, А3, А4, А5) Экспорт
	ЗаписатьВызов("ОбъединитьКонфигурациюСФайлом",
		Новый Структура("А1, А2, А3, А4, А5", А1, А2, А3, А4, А5));
КонецПроцедуры

Процедура ПолучитьОтчетОСравненииКонфигурацииСФайлом(А1, А2, А3, А4, А5 = "", А6 = Неопределено) Экспорт
	ЗаписатьВызов("ПолучитьОтчетОСравненииКонфигурацииСФайлом",
		Новый Структура("А1, А2, А3, А4, А5, А6", А1, А2, А3, А4, А5, А6));
КонецПроцедуры

Процедура ВыгрузитьИзмененияКонфигурацииВФайл(А1, А2, А3, А4, А5) Экспорт
	ЗаписатьВызов("ВыгрузитьИзмененияКонфигурацииВФайл",
		Новый Структура("А1, А2, А3, А4, А5", А1, А2, А3, А4, А5));
КонецПроцедуры

Процедура ПодключитьсяКХранилищуКонфигурации(Адрес, Пользователь, Пароль) Экспорт
	ЗаписатьВызов("ПодключитьсяКХранилищуКонфигурации",
		Новый Структура("Адрес, Пользователь, Пароль", Адрес, Пользователь, Пароль));
КонецПроцедуры

Процедура ВыполнитьРасширеннуюПроверкуКонфигуратора(Ключи) Экспорт
	ЗаписатьВызов("ВыполнитьРасширеннуюПроверкуКонфигуратора", Ключи);
КонецПроцедуры

Процедура ВыполнитьКоманду(Параметры) Экспорт
	ЗаписатьВызов("ВыполнитьКоманду", Параметры);
КонецПроцедуры

// === Расширения / Внешние обработки ===

Процедура ЗагрузитьРасширениеИзФайла(Путь, Имя) Экспорт
	ЗаписатьВызов("ЗагрузитьРасширениеИзФайла",
		Новый Структура("Путь, Имя", Путь, Имя));
КонецПроцедуры

Процедура ВыгрузитьРасширениеВФайл(Путь, Имя) Экспорт
	ЗаписатьВызов("ВыгрузитьРасширениеВФайл",
		Новый Структура("Путь, Имя", Путь, Имя));
КонецПроцедуры

Процедура ЗагрузитьРасширениеИзФайлов(Каталог, Имя, Список) Экспорт
	ЗаписатьВызов("ЗагрузитьРасширениеИзФайлов",
		Новый Структура("Каталог, Имя, Список", Каталог, Имя, Список));
КонецПроцедуры

Процедура ВыгрузитьРасширениеВФайлы(Каталог, Имя) Экспорт
	ЗаписатьВызов("ВыгрузитьРасширениеВФайлы",
		Новый Структура("Каталог, Имя", Каталог, Имя));
КонецПроцедуры

Процедура ВыгрузитьВнешниеОтчетыИлиОбработкиВФайлы(Каталог, Файл) Экспорт
	ЗаписатьВызов("ВыгрузитьВнешниеОтчетыИлиОбработкиВФайлы",
		Новый Структура("Каталог, Файл", Каталог, Файл));
КонецПроцедуры

// === Команды/вывод ===

Функция ПолучитьПараметрыЗапуска() Экспорт
	// Возвращаем КОПИЮ массива, чтобы тесты не мутировали шаблон.
	Параметры = Новый Массив;
	Для Каждого Эл Из ШаблонПараметровЗапуска Цикл
		Параметры.Добавить(Эл);
	КонецЦикла;
	Возврат Параметры;
КонецФункции

Функция ВыводКоманды() Экспорт
	Возврат ВыводКоманды_;
КонецФункции

Функция ПутьКПлатформе1С() Экспорт
	Возврат "C:\\1cv8\\1cv8.exe";
КонецФункции

Функция ПутьКТонкомуКлиенту1С() Экспорт
	Возврат "C:\\1cv8\\1cv8c.exe";
КонецФункции
