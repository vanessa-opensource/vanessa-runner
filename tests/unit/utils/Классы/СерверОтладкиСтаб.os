// BSLLS-off
// Стаб СервисаСервераОтладки для тестов СервисПокрытия.

Перем Вызовы Экспорт;
Перем Адрес Экспорт;
Перем ПараметрыЗапуска Экспорт; // параметры, с которыми звали ЗапуститьСервер

Процедура ПриСозданииОбъекта()
	Вызовы = Новый Массив;
	Адрес = "http://127.0.0.1:1550";
	ПараметрыЗапуска = Неопределено;
КонецПроцедуры

Функция НовыеПараметрыСервера() Экспорт
	Возврат Новый Структура(
		"Хост, Порт, ПодключитьсяКСуществующему, ПутьКDBGS, Пароль, ВерсияПлатформы",
		"", 0, Ложь, "", "", "");
КонецФункции

Функция ЗапуститьСервер(Знач Параметры) Экспорт
	ПараметрыЗапуска = Параметры;
	Вызовы.Добавить("ЗапуститьСервер");
	Возврат Новый Структура("Адрес", Адрес);
КонецФункции

Процедура ОстановитьСервер() Экспорт
	Вызовы.Добавить("ОстановитьСервер");
КонецПроцедуры

Функция СерверОстановлен() Экспорт
	Возврат Вызовы.Найти("ОстановитьСервер") <> Неопределено;
КонецФункции
