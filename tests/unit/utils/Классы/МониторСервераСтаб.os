// BSLLS:ExportVariables-off
// BSLLS:MissingVariablesDescription-off
// Фейковый монитор автономного сервера для юнит-тестов healthcheck-watchdog.
// Duck-typed под контракт МониторСервера: метод СерверЖив() возвращает заданное значение.

Перем Живой_ Экспорт;

Процедура ПриСозданииОбъекта()
	Живой_ = Истина;
КонецПроцедуры

// Задать, что сервер мёртв (СерверЖив() вернёт Ложь).
//
// Возвращаемое значение:
//   МониторСервераСтаб - этот объект
//
Функция Мертвым() Экспорт
	Живой_ = Ложь;
	Возврат ЭтотОбъект;
КонецФункции

Функция СерверЖив() Экспорт
	Возврат Живой_;
КонецФункции
