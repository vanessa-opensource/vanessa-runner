// BSLLS:ExportVariables-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:LatinAndCyrillicSymbolInWord-off
// Стаб ibcmdrunner.УправлениеАС для юнит-тестов СервисАвтономногоСервера.
// Позволяет смоделировать неудачный старт ibsrv (занятый порт) заданное число раз,
// чтобы проверить надёжный подбор порта (issue #707).

Перем КаталогДанных_ Экспорт;
Перем КонфигурационныйФайл_ Экспорт;
Перем ВерсияПлатформы_ Экспорт;
Перем КоличествоВызововЗапустить Экспорт;
Перем НеудачныхСтартовПодряд Экспорт;
Перем БроситьИсключениеПриСтарте_ Экспорт;
Перем Остановлен Экспорт;
Перем _Живой;

Процедура ПриСозданииОбъекта()
	КаталогДанных_ = "";
	КонфигурационныйФайл_ = "";
	ВерсияПлатформы_ = "8.3.99";
	КоличествоВызововЗапустить = 0;
	НеудачныхСтартовПодряд = 0;
	БроситьИсключениеПриСтарте_ = "";
	Остановлен = Ложь;
	_Живой = Ложь;
КонецПроцедуры

// Сконфигурировать, сколько первых вызовов Запустить должны упасть "по порту".
//
// Параметры:
//   Количество - Число - число подряд идущих неудачных стартов
//
// Возвращаемое значение:
//   УправлениеАССтаб - этот объект
//
Функция СНеудачнымиСтартами(Знач Количество) Экспорт
	НеудачныхСтартовПодряд = Количество;
	Возврат ЭтотОбъект;
КонецФункции

Процедура УстановитьКаталогДанных(Знач Каталог) Экспорт
	КаталогДанных_ = Каталог;
КонецПроцедуры

// Установить версию платформы (Разрядность игнорируется стабом, сохранена для совместимости
// с сигнатурой реального УправлениеАС).
//
// Параметры:
//   Версия     - Строка               - версия платформы
//   Разрядность - Число, Неопределено  - разрядность (не используется стабом)
//
Процедура УстановитьВерсиюПлатформы(Знач Версия, Знач Разрядность = Неопределено) Экспорт // BSLLS:UnusedParameters-off
	ВерсияПлатформы_ = Версия;
КонецПроцедуры

Функция Версия() Экспорт
	Возврат ВерсияПлатформы_;
КонецФункции

Процедура УстановитьПараметрыФайловойИБ(Знач Каталог) Экспорт
	// no-op
КонецПроцедуры

Процедура УстановитьКонфигурационныйФайл(Знач Путь) Экспорт
	КонфигурационныйФайл_ = Путь;
КонецПроцедуры

// Имитация реального УправлениеАС.Запустить():
//   - непустой БроситьИсключениеПриСтарте_ => Запустить бросает (моделирует НЕпортовую ошибку);
//   - НеудачныхСтартовПодряд > 0 => Запустить отрабатывает БЕЗ исключения, но процесс не
//     удержался (последующий Запущен() = Ложь) - так ведёт себя ibsrv при занятом порте:
//     lock.pid появился, Запустить() вернулся успешно, но процесс упал на бинде http-порта;
//   - иначе процесс жив.
Процедура Запустить() Экспорт
	КоличествоВызововЗапустить = КоличествоВызововЗапустить + 1;
	Если ЗначениеЗаполнено(БроситьИсключениеПриСтарте_) Тогда
		ВызватьИсключение БроситьИсключениеПриСтарте_;
	КонецЕсли;
	Если НеудачныхСтартовПодряд > 0 Тогда
		НеудачныхСтартовПодряд = НеудачныхСтартовПодряд - 1;
		_Живой = Ложь;
	Иначе
		_Живой = Истина;
	КонецЕсли;
КонецПроцедуры

Процедура Остановить() Экспорт
	Остановлен = Истина;
	_Живой = Ложь;
КонецПроцедуры

// Жив ли процесс. НЕ зависит от Остановлен: retry-логика зовёт Остановить между попытками,
// после чего следующий Запустить() снова поднимает процесс.
Функция Запущен() Экспорт
	Возврат _Живой;
КонецФункции

// Распознаёт исключение неудачного старта АС (как УправлениеАС.ЭтоИсключенияЗапускаАС).
// Важно: распознаётся только ФИКСИРОВАННЫЙ текст неудачного старта ibsrv (как у реального
// УправлениеАС), а не произвольный текст исключения. Это позволяет тестам смоделировать
// НЕпортовую ошибку (другой текст), которая должна пробрасываться без повторов.
//
// Параметры:
//   ИнформацияОбОшибке - ИнформацияОбОшибке - описание проверяемого исключения
//
// Возвращаемое значение:
//   Булево - Истина, если это исключение неудачного старта автономного сервера
//
Функция ЭтоИсключенияЗапускаАС(Знач ИнформацияОбОшибке) Экспорт
	Возврат СтрНайти(КраткоеПредставлениеОшибки(ИнформацияОбОшибке), ТекстПортовойОшибки()) > 0;
КонецФункции

// Фиксированный текст исключения «порт занят / сервер не запустился» (как у реального УправлениеАС).
//
// Возвращаемое значение:
//   Строка - текст, по которому распознаётся неудачный старт ibsrv
//
Функция ТекстПортовойОшибки()
	Возврат "Процесс ibsrv не запустился!";
КонецФункции
