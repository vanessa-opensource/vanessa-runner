// BSLLS:ExportVariables-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:UnusedLocalMethod-off ПриСозданииОбъекта вызывается рантаймом при Новый.
// Стаб фабрики "_Фабрика*.Создать(...) -> объект": всегда отдаёт заданный объект (обычно мок),
// параметры каждого вызова Создать копит в Вызовы. Подключается через Стенд.Подменить("_Фабрика...", ...).

Перем Вызовы Экспорт;
Перем _Объект;

Процедура ПриСозданииОбъекта(Знач Объект)
	_Объект = Объект;
	Вызовы = Новый Массив;
КонецПроцедуры

// Контракт фабрики: вернуть объект, запомнив параметры вызова.
//
// Параметры:
//   П1 - Произвольный - первый параметр фабрики
//   П2 - Произвольный - второй параметр фабрики
//
// Возвращаемое значение:
//   Произвольный - объект, переданный в конструктор стаба
//
Функция Создать(Знач П1 = Неопределено, Знач П2 = Неопределено) Экспорт

	Параметры = ТестовыеДанные.Массив(П1, П2);
	Если П1 = Неопределено И П2 = Неопределено Тогда
		Параметры.Очистить();
	КонецЕсли;
	Вызовы.Добавить(Параметры);

	Возврат _Объект;

КонецФункции
