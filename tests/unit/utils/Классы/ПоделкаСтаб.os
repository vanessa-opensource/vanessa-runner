// BSLLS-off
// Стаб autumn-Поделки для юнит-тестов: детальки и реестр желудей.

Перем Детальки Экспорт;
Перем Желуди Экспорт; // массив структур {Имя, Желудь, ОпределениеЖелудя}

Процедура ПриСозданииОбъекта()
	Детальки = Новый Соответствие;
	Желуди = Новый Массив;
КонецПроцедуры

Функция СДеталькой(Знач Ключ, Знач Значение) Экспорт
	Детальки.Вставить(Ключ, Значение);
	Возврат ЭтотОбъект;
КонецФункции

Функция СЖелудем(Знач Имя, Знач Желудь, Знач ОпределениеЖелудя) Экспорт
	Желуди.Добавить(Новый Структура("Имя, Желудь, ОпределениеЖелудя", Имя, Желудь, ОпределениеЖелудя));
	Возврат ЭтотОбъект;
КонецФункции

Функция НайтиДетальку(Знач Ключ) Экспорт
	Возврат Детальки[Ключ];
КонецФункции

Функция НайтиЖелуди(Знач ИмяИлиПрозвище, Знач Тип = Неопределено, Знач Формат = "") Экспорт

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Желудь");
	Таблица.Колонки.Добавить("ОпределениеЖелудя");

	Для Каждого Запись Из Желуди Цикл
		Если НРег(Запись.Имя) = НРег(ИмяИлиПрозвище) Тогда
			Строка = Таблица.Добавить();
			Строка.Желудь = Запись.Желудь;
			Строка.ОпределениеЖелудя = Запись.ОпределениеЖелудя;
		КонецЕсли;
	КонецЦикла;

	Возврат Таблица;

КонецФункции
