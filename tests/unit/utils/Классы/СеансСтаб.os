// BSLLS:ExportVariables-off
// BSLLS:MissingVariablesDescription-off
// Стаб сеанса для СервисКластера-тестов.

Перем Свойства_ Экспорт;
Перем Завершен Экспорт;
Перем БроситьПриЗавершении Экспорт;

Процедура ПриСозданииОбъекта()
	Свойства_ = Новый Соответствие;
	Свойства_.Вставить("session-id", "1");
	Свойства_.Вставить("app-id", "Designer");
	Завершен = Ложь;
	БроситьПриЗавершении = Ложь;
КонецПроцедуры

Функция СоСвойством(Ключ, Значение) Экспорт
	Свойства_.Вставить(Ключ, Значение);
	Возврат ЭтотОбъект;
КонецФункции

Функция Получить(Ключ) Экспорт
	Возврат Свойства_[Ключ];
КонецФункции

Процедура Завершить() Экспорт
	Если БроситьПриЗавершении Тогда
		ВызватьИсключение "сеанс невозможно завершить";
	КонецЕсли;
	Завершен = Истина;
КонецПроцедуры
