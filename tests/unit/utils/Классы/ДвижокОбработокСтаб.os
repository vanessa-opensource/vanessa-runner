// BSLLS:ExportVariables-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:UnusedParameters-off
// Стаб движка для юнит-тестов СервисЗапускаОбработок.
// Имитирует ЗапуститьПредприятие: разбирает КомандаЗапуска, находит ключ ФайлРезультата=
// и пишет в него предопределённый JSON (как это делает реальная обработка).

Перем СодержимоеРезультата Экспорт;   // Строка JSON для записи в файл результата (или Неопределено)
Перем ЗаписыватьРезультат Экспорт;     // Булево - писать ли файл результата
Перем ПоследняяКомандаЗапуска Экспорт; // Строка - последняя переданная КомандаЗапуска
Перем ПоследнийПутьОбработки Экспорт;  // Строка - последний переданный ПутьОбработки
Перем КоличествоЗапусков Экспорт;      // Число
Перем КодВозвратаПлатформы Экспорт;    // Число - имитируемый код возврата процесса платформы

Процедура ПриСозданииОбъекта()
	СодержимоеРезультата = "{""КодВозврата"": 0, ""Сообщения"": [], ""Ошибка"": """"}";
	ЗаписыватьРезультат = Истина;
	ПоследняяКомандаЗапуска = "";
	ПоследнийПутьОбработки = "";
	КоличествоЗапусков = 0;
	КодВозвратаПлатформы = 0;
КонецПроцедуры

Процедура ЗапуститьПредприятие(Знач ПараметрыПодключения, Знач ПараметрыЗапуска,
	Знач ПараметрыПлатформы = Неопределено) Экспорт

	КоличествоЗапусков = КоличествоЗапусков + 1;
	ПоследняяКомандаЗапуска = ПараметрыЗапуска.КомандаЗапуска;
	ПоследнийПутьОбработки = ПараметрыЗапуска.ПутьОбработки;

	Если ЗаписыватьРезультат <> Истина Тогда
		Возврат;
	КонецЕсли;

	ПутьРезультата = ИзвлечьПутьРезультата(ПараметрыЗапуска.КомандаЗапуска);
	Если НЕ ЗначениеЗаполнено(ПутьРезультата) Тогда
		Возврат;
	КонецЕсли;

	Запись = Новый ЗаписьТекста(ПутьРезультата, "UTF-8");
	Запись.Записать(СодержимоеРезультата);
	Запись.Закрыть();

КонецПроцедуры

Функция КодВозвратаПоследнегоЗапуска() Экспорт
	Возврат КодВозвратаПлатформы;
КонецФункции

Функция ИзвлечьПутьРезультата(Знач КомандаЗапуска)
	Для Каждого Часть Из СтрРазделить(КомандаЗапуска, ";", Ложь) Цикл
		Если СтрНачинаетсяС(Часть, "ФайлРезультата=") Тогда
			Возврат Сред(Часть, СтрДлина("ФайлРезультата=") + 1);
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции
