// BSLLS:ExportVariables-off
// BSLLS:MissingVariablesDescription-off
// Фабрика стаб-команд для тестов СервисEDT.
// Создаёт КомандаEDTСтаб и запоминает все созданные экземпляры (для проверки argv).

Перем СозданныеКоманды Экспорт;
Перем ЭмулироватьУспех Экспорт;
Перем КодВозврата Экспорт;
Перем Вывод Экспорт;
Перем МаркерыЭкспорта Экспорт; // Относительные пути XML, которые export «создаёт» (по умолчанию Configuration.xml).
Перем СбойнаяКоманда Экспорт; // Команда 1cedtcli (export/import/validate), результат которой не создаётся.

Процедура ПриСозданииОбъекта()
	СозданныеКоманды = Новый Массив;
	ЭмулироватьУспех = Истина;
	КодВозврата = 0;
	Вывод = "";
	МаркерыЭкспорта = Новый Массив;
	СбойнаяКоманда = "";
КонецПроцедуры

Функция Создать() Экспорт
	Команда = Новый КомандаEDTСтаб;
	Команда.ЭмулироватьУспех = ЭмулироватьУспех;
	Команда.КодВозврата = КодВозврата;
	Команда.Вывод = Вывод;
	Команда.МаркерыЭкспорта = МаркерыЭкспорта;
	Команда.СбойнаяКоманда = СбойнаяКоманда;
	СозданныеКоманды.Добавить(Команда);
	Возврат Команда;
КонецФункции

// Последняя созданная команда (или Неопределено).
Функция Последняя() Экспорт
	Если СозданныеКоманды.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат СозданныеКоманды[СозданныеКоманды.ВГраница()];
КонецФункции
