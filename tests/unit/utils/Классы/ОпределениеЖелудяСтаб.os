// BSLLS-off
// Стаб autumn-ОпределенияЖелудя: свойства с аннотациями и аннотации конструктора.
// Аннотация - Структура("Имя, Параметры"), Параметр - Структура("Имя, Значение"),
// как их читает РаботаСАннотациями.

Перем _Свойства;
Перем _АннотацииКонструктора;

Процедура ПриСозданииОбъекта()
	_Свойства = Новый Массив;
	_АннотацииКонструктора = Неопределено;
КонецПроцедуры

// Аннотации - Массив из Структура("Имя, Параметры")
Функция СоСвойством(Знач Имя, Знач Аннотации) Экспорт
	_Свойства.Добавить(Новый Структура("Имя, Аннотации", Имя, Аннотации));
	Возврат ЭтотОбъект;
КонецФункции

// Аннотации - Массив из Структура("Имя, Параметры") конструктора желудя
Функция СКонструктором(Знач Аннотации) Экспорт
	_АннотацииКонструктора = Аннотации;
	Возврат ЭтотОбъект;
КонецФункции

Функция Свойства() Экспорт
	Возврат _Свойства;
КонецФункции

Функция Завязь() Экспорт
	Возврат ЭтотОбъект;
КонецФункции

Функция ДанныеМетода() Экспорт
	Если _АннотацииКонструктора = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("Аннотации", _АннотацииКонструктора);
КонецФункции
