// BSLLS:MissingVariablesDescription-off
// BSLLS:UnusedLocalMethod-off ПриСозданииОбъекта вызывается рантаймом при Новый.
// Билдер СервисВременнойБазы для юнит-тестов: собирает сервис на переданном Соответствии движков.
// Используется билдерами сервисов, которым нужна временная база и выбор движка.

#Использовать reflector
#Использовать logos
#Использовать "../../../../src/core/Сервисы"

Перем _Движки;

Процедура ПриСозданииОбъекта()
	_Движки = Новый Соответствие;
КонецПроцедуры

Функция СДвижками(Движки) Экспорт
	_Движки = Движки;
	Возврат ЭтотОбъект;
КонецФункции

Функция Собрать() Экспорт

	Сервис = Новый СервисВременнойБазы;

	Рефлектор = Новый Рефлектор;
	Рефлектор.УстановитьСвойство(Сервис, "Движки", _Движки);
	Рефлектор.УстановитьСвойство(Сервис, "Лог", Логирование.ПолучитьЛог("vrunner"));

	Возврат Сервис;

КонецФункции
