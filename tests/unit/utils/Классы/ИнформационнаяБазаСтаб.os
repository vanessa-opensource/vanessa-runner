// BSLLS:ExportVariables-off
// BSLLS:MissingVariablesDescription-off
// Стаб ИБ для СервисКластера-тестов.

Перем АдминистраторИБ Экспорт;
Перем ПарольИБ Экспорт;
Перем КоличествоОбновлений Экспорт;
Перем ПоследниеИзменения Экспорт; // Структура
Перем ИзмененияВсего Экспорт;     // Массив всех вызовов Изменить
Перем СеансыСписок_ Экспорт;       // массив СеансСтаб
Перем ОчередьСписковСеансов_ Экспорт; // массив массивов: ответы Сеансы() по порядку вызовов
Перем СоединенияСписок_ Экспорт;   // массив соединений

Процедура ПриСозданииОбъекта()
	АдминистраторИБ = "";
	ПарольИБ = "";
	КоличествоОбновлений = 0;
	ПоследниеИзменения = Неопределено;
	ИзмененияВсего = Новый Массив;
	СеансыСписок_ = Новый Массив;
	ОчередьСписковСеансов_ = Новый Массив;
	СоединенияСписок_ = Новый Массив;
КонецПроцедуры

Функция ССеансами(Сеансы) Экспорт
	СеансыСписок_ = Сеансы;
	Возврат ЭтотОбъект;
КонецФункции

// Задать очередь ответов Сеансы(): каждый вызов снимает очередной список,
// последний элемент очереди становится постоянным ответом.
Функция ССеансамиПоВызовам(СпискиСеансов) Экспорт
	ОчередьСписковСеансов_ = СпискиСеансов;
	Возврат ЭтотОбъект;
КонецФункции

Функция ССоединениями(Соединения) Экспорт
	СоединенияСписок_ = Соединения;
	Возврат ЭтотОбъект;
КонецФункции

// === irac-интерфейс ИБ ===

Процедура УстановитьАдминистратора(Логин, Пароль) Экспорт
	АдминистраторИБ = Логин;
	ПарольИБ = Пароль;
КонецПроцедуры

Процедура ОбновитьДанные() Экспорт
	КоличествоОбновлений = КоличествоОбновлений + 1;
КонецПроцедуры

Процедура Изменить(Параметры) Экспорт
	ПоследниеИзменения = Параметры;
	ИзмененияВсего.Добавить(Параметры);
КонецПроцедуры

// Сеансы ИБ: завершённые сеансы из списка исчезают (как в rac).
Функция Сеансы() Экспорт

	Если ОчередьСписковСеансов_.Количество() > 0 Тогда
		СеансыСписок_ = ОчередьСписковСеансов_[0];
		Если ОчередьСписковСеансов_.Количество() > 1 Тогда
			ОчередьСписковСеансов_.Удалить(0);
		КонецЕсли;
	КонецЕсли;

	Живые = Новый Массив;
	Для Каждого Сеанс Из СеансыСписок_ Цикл
		Если НЕ Сеанс.Завершен Тогда
			Живые.Добавить(Сеанс);
		КонецЕсли;
	КонецЦикла;

	Возврат Новый КоллекцияКластераСтаб(Живые);

КонецФункции

Функция Соединения() Экспорт
	Возврат Новый КоллекцияКластераСтаб(СоединенияСписок_);
КонецФункции
