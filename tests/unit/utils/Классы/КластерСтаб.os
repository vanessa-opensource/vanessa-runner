// BSLLS:ExportVariables-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:NumberOfValuesInStructureConstructor-off
// Стаб Кластера для СервисКластера-тестов.

Перем Имя_ Экспорт;
Перем Ид_ Экспорт;
Перем АдминистраторКластера Экспорт;
Перем ПарольКластера Экспорт;
Перем ИБ_ Экспорт; // имя -> ИнформационнаяБазаСтаб
Перем ДобавленыеИБ Экспорт; // массив структур
Перем УдаленныеИБ Экспорт; // массив структур

Процедура ПриСозданииОбъекта()
	Имя_ = "DefCluster";
	Ид_ = "00000000-0000-0000-0000-000000000001";
	АдминистраторКластера = "";
	ПарольКластера = "";
	ИБ_ = Новый Соответствие;
	ДобавленыеИБ = Новый Массив;
	УдаленныеИБ = Новый Массив;
КонецПроцедуры

Функция СИменемИИд(Имя, Ид) Экспорт
	Имя_ = Имя;
	Ид_ = Ид;
	Возврат ЭтотОбъект;
КонецФункции

Функция СИБ(ИмяИБ, ИБ) Экспорт
	ИБ_.Вставить(ИмяИБ, ИБ);
	Возврат ЭтотОбъект;
КонецФункции

// === irac-интерфейс кластера ===

Функция Имя() Экспорт
	Возврат Имя_;
КонецФункции

Функция Ид() Экспорт
	Возврат Ид_;
КонецФункции

Процедура УстановитьАдминистратора(Логин, Пароль) Экспорт
	АдминистраторКластера = Логин;
	ПарольКластера = Пароль;
КонецПроцедуры

Функция ИнформационныеБазы() Экспорт
	Возврат ЭтотОбъект;
КонецФункции

// === irac-интерфейс ИнформационныеБазы (через тот же объект) ===

Процедура Добавить(ИмяИБ, Локализация, СоздаватьБД, ПараметрыСоздания) Экспорт
	ЗаписьИБ = Новый Структура("Имя, Локализация, СоздаватьБД, Параметры",
		ИмяИБ, Локализация, СоздаватьБД, ПараметрыСоздания);
	ДобавленыеИБ.Добавить(ЗаписьИБ);
КонецПроцедуры

Процедура Удалить(ИмяИБ, ДействияСБД) Экспорт
	УдаленныеИБ.Добавить(Новый Структура("Имя, Действия", ИмяИБ, ДействияСБД));
КонецПроцедуры

Функция Получить(ИмяИБ) Экспорт
	Возврат ИБ_[ИмяИБ];
КонецФункции
