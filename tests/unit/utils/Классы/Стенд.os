// BSLLS:MissingVariablesDescription-off
// BSLLS:UnusedLocalMethod-off ПриСозданииОбъекта вызывается рантаймом при Новый.
// Стенд юнит-теста: собирает желудь src/core так, как его собрало бы приложение, но каждая
// &Пластилин-зависимость - мок. Три фразы: Сервис("X") - тестируемый объект, Мок("Имя") - его
// зависимость-мок, Реальный("Имя") / Подменить("_поле", Значение) - настоящая зависимость или
// значение любого поля. Один стенд на тест: моки общие на процесс и сбрасываются при первом
// обращении из стенда.

#Использовать asserts
#Использовать logos
#Использовать annotations // нужна пакету Настройки на компиляции
#Использовать "../../../../src/core/Движки"
#Использовать "../../../../src/core/Настройки"
#Использовать "../../../../src/core/Покрытие"
#Использовать "../../../../src/core/Приложение"
#Использовать "../../../../src/core/Процессы"
#Использовать "../../../../src/core/Сервисы"
#Использовать "../../../../src/core/Файлы"

Перем _Значения;      // Соответствие: имя в верхнем регистре -> реальный объект или подмена
Перем _МокПоТипу;     // Соответствие: имя типа в верхнем регистре -> мок, сброшенный в этом стенде
Перем _Собранные;     // Массив собранных объектов
Перем _Соответствия;  // Массив структур: Соответствие моков по прозвищу и само прозвище
Перем _Прозвища;      // Соответствие: прозвище -> имена классов
Перем _БезПодмены;    // Массив имён полей, которые остаются Неопределено до Подменить
Перем _Рефлектор;

Процедура ПриСозданииОбъекта()

	_Значения = Новый Соответствие;
	_МокПоТипу = Новый Соответствие;
	_Собранные = Новый Массив;
	_Соответствия = Новый Массив;
	_Рефлектор = Новый Рефлектор;

	_Прозвища = Новый Соответствие; // синхронизировать с &Прозвище в классах src/core
	_Прозвища.Вставить("ДвижокПлатформы", ТестовыеДанные.Массив("ДвижокКонфигуратор", "ДвижокIbcmd"));

	_БезПодмены = ТестовыеДанные.Массив("Поделка");

КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Реальный экземпляр класса src/core с внедрёнными зависимостями. Повторный вызов с тем же
// именем возвращает тот же объект.
//
// Параметры:
//   ИмяКласса - Строка - имя класса
//   ПараметрыКонструктора - Массив, Неопределено - параметры конструктора
//
// Возвращаемое значение:
//   Произвольный - экземпляр класса
//
Функция Сервис(Знач ИмяКласса, Знач ПараметрыКонструктора = Неопределено) Экспорт

	Объект = _Значения[ВРег(ИмяКласса)];
	Если Объект = Неопределено Тогда
		Объект = Собрать(ИмяКласса, ПараметрыКонструктора);
	КонецЕсли;

	Возврат Объект;

КонецФункции

// То же, что Сервис, но для зависимости: читателю видно, что она настоящая.
// Подставляется во все уже собранные объекты стенда с полем такого имени.
//
// Параметры:
//   ИмяКласса - Строка - имя класса
//   ПараметрыКонструктора - Массив, Неопределено - параметры конструктора
//
// Возвращаемое значение:
//   Произвольный - экземпляр класса
//
Функция Реальный(Знач ИмяКласса, Знач ПараметрыКонструктора = Неопределено) Экспорт
	Возврат Сервис(ИмяКласса, ПараметрыКонструктора);
КонецФункции

// Мок типа с поведением по умолчанию из ПоведениеМоков. Это тот же экземпляр, что внедрён
// в собранные объекты стенда.
//
// Параметры:
//   ИмяТипа - Строка - имя класса src/core или внешней библиотеки
//
// Возвращаемое значение:
//   Произвольный - мок moskito
//
Функция Мок(Знач ИмяТипа) Экспорт

	Ключ = ВРег(ИмяТипа);
	Если _Значения[Ключ] <> Неопределено Тогда
		ВызватьИсключение СтрШаблон("%1 в этом стенде объявлен реальным или подменён - обращайтесь к нему напрямую", ИмяТипа);
	КонецЕсли;

	Результат = _МокПоТипу[Ключ];
	Если Результат = Неопределено Тогда
		Результат = СостояниеМоков.Получить(Ключ);
		Если Результат = Неопределено Тогда
			Результат = ПоведениеМоков.Создать(ИмяТипа);
			СостояниеМоков.Сохранить(Ключ, Результат);
		КонецЕсли;
		СостояниеМоков.Сбросить(Результат);
		ПоведениеМоков.Применить(ИмяТипа, Результат);
		_МокПоТипу.Вставить(Ключ, Результат);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Значение поля с таким именем во всех объектах стенда - уже собранных и будущих:
// приватные швы _Фабрика*, состояние вроде _Запущен, Поделка, любой фейк.
//
// Параметры:
//   ИмяПоля - Строка - имя поля
//   Значение - Произвольный - подставляемое значение
//
// Возвращаемое значение:
//   Произвольный - то же значение
//
Функция Подменить(Знач ИмяПоля, Знач Значение) Экспорт

	_Значения.Вставить(ВРег(ИмяПоля), Значение);
	УстановитьВСобранные(ИмяПоля, Значение);

	Возврат Значение;

КонецФункции

// Параметры зафиксированных вызовов метода мока.
//
// Параметры:
//   ИмяТипа - Строка - имя мокируемого типа
//   ИмяМетода - Строка - имя метода
//
// Возвращаемое значение:
//   Массив из Массив - параметры каждого вызова в порядке сигнатуры, включая умолчания
//
Функция Вызовы(Знач ИмяТипа, Знач ИмяМетода) Экспорт
	Возврат СостояниеМоков.Вызовы(Мок(ИмяТипа), ИмяМетода);
КонецФункции

// Утверждение: метод мока не вызывался.
//
// Параметры:
//   ИмяТипа - Строка - имя мокируемого типа
//   ИмяМетода - Строка - имя метода
//
Процедура ПроверитьЧтоНеВызывался(Знач ИмяТипа, Знач ИмяМетода) Экспорт
	Ожидаем.Что(Вызовы(ИмяТипа, ИмяМетода).Количество(),
		СтрШаблон("%1.%2 не должен вызываться", ИмяТипа, ИмяМетода)).Равно(0);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Собрать(Знач ИмяКласса, Знач ПараметрыКонструктора)

	Если ПараметрыКонструктора = Неопределено Тогда
		Объект = Новый(ИмяКласса);
	Иначе
		Объект = Новый(ИмяКласса, ПараметрыКонструктора);
	КонецЕсли;
	_Значения.Вставить(ВРег(ИмяКласса), Объект); // до внедрения: разрывает циклы зависимостей

	Для Каждого Свойство Из _Рефлектор.ПолучитьТаблицуСвойств(Объект, Истина) Цикл
		Значение = ЗначениеПоля(Свойство);
		Если Значение <> Неопределено Тогда
			_Рефлектор.УстановитьСвойство(Объект, Свойство.Имя, Значение);
		КонецЕсли;
	КонецЦикла;

	УстановитьВСобранные(ИмяКласса, Объект);
	_Собранные.Добавить(Объект);

	Возврат Объект;

КонецФункции

Функция ЗначениеПоля(Знач Свойство)

	// Подмена или реальный объект по имени поля, иначе лог по &Лог, мок по &Пластилин.
	Если _Значения[ВРег(Свойство.Имя)] <> Неопределено Тогда
		Возврат _Значения[ВРег(Свойство.Имя)];
	КонецЕсли;

	Для Каждого Аннотация Из Свойство.Аннотации Цикл
		Если Аннотация.Имя = "Лог" Тогда
			Возврат Логирование.ПолучитьЛог(ПараметрАннотации(Аннотация, "vrunner"));
		КонецЕсли;
		Если Аннотация.Имя = "Пластилин" Тогда
			Возврат Зависимость(Свойство.Имя, Аннотация);
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция Зависимость(Знач ИмяПоля, Знач Аннотация)

	Если ПараметрАннотации(Аннотация, "", "Тип") = "Соответствие" Тогда
		Возврат СоответствиеМоков(ПараметрАннотации(Аннотация, ИмяПоля));
	КонецЕсли;

	Если _БезПодмены.Найти(ИмяПоля) <> Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Имя типа из &Пластилин("Тип") может отличаться от имени поля.
	ИмяТипа = ПараметрАннотации(Аннотация, ИмяПоля);
	Если _Значения[ВРег(ИмяТипа)] <> Неопределено Тогда
		Возврат _Значения[ВРег(ИмяТипа)];
	КонецЕсли;

	Возврат Мок(ИмяТипа);

КонецФункции

Функция ПараметрАннотации(Знач Аннотация, Знач Умолчание, Знач ИмяПараметра = "Значение")

	// Позиционный параметр (без имени) считается параметром "Значение".
	Для Каждого Параметр Из Аннотация.Параметры Цикл
		Если Параметр.Имя = ИмяПараметра ИЛИ (Параметр.Имя = "" И ИмяПараметра = "Значение") Тогда
			Возврат Параметр.Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат Умолчание;

КонецФункции

Функция СоответствиеМоков(Знач Прозвище)

	// Для &Пластилин(Тип = "Соответствие"): имя класса -> объект стенда по прозвищу.
	Соответствие = Новый Соответствие;
	Для Каждого ИмяКласса Из _Прозвища[Прозвище] Цикл
		Объект = _Значения[ВРег(ИмяКласса)];
		Если Объект = Неопределено Тогда
			Объект = Мок(ИмяКласса);
		КонецЕсли;
		Соответствие.Вставить(ИмяКласса, Объект);
	КонецЦикла;
	_Соответствия.Добавить(Новый Структура("Соответствие, Прозвище", Соответствие, Прозвище));

	Возврат Соответствие;

КонецФункции

Процедура УстановитьВСобранные(Знач Имя, Знач Значение)

	// Во все собранные объекты с полем такого имени и в соответствия по прозвищу.
	Для Каждого Объект Из _Собранные Цикл
		Если ЕстьПоле(Объект, Имя) Тогда
			_Рефлектор.УстановитьСвойство(Объект, Имя, Значение);
		КонецЕсли;
	КонецЦикла;

	Для Каждого Запись Из _Соответствия Цикл
		Для Каждого ИмяКласса Из _Прозвища[Запись.Прозвище] Цикл
			Если ВРег(ИмяКласса) = ВРег(Имя) Тогда
				Запись.Соответствие.Вставить(ИмяКласса, Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Функция ЕстьПоле(Знач Объект, Знач Имя)

	Для Каждого Свойство Из _Рефлектор.ПолучитьТаблицуСвойств(Объект, Истина) Цикл
		Если ВРег(Свойство.Имя) = ВРег(Имя) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

#КонецОбласти
