// BSLLS:MissingVariablesDescription-off
// Билдер для сборки СервисКонфигурации в юнит-тестах с моками движков.
// Скрывает работу с Рефлектором и Соответствием Движки.
//
// Использование:
// BSLLS:CommentedCode-off
//   Сервис = Новый БилдерСервисаКонфигурации()
//       .СОдинаковымДвижком(МокДвижок)
//       .Собрать();
// BSLLS:CommentedCode-on

#Использовать reflector
#Использовать logos
#Использовать "../../../../src/core/Сервисы"

Перем _Движки;
Перем _СервисРасчетаИнкремента;
Перем _СервисEDT;

Процедура ПриСозданииОбъекта()
	_Движки = Новый Соответствие;
	_СервисРасчетаИнкремента = Неопределено;
	_СервисEDT = Неопределено;
КонецПроцедуры

Функция СДвижкомКонфигуратор(Движок) Экспорт
	_Движки.Вставить("ДвижокКонфигуратор", Движок);
	Возврат ЭтотОбъект;
КонецФункции

Функция СДвижкомIbcmd(Движок) Экспорт
	_Движки.Вставить("ДвижокIbcmd", Движок);
	Возврат ЭтотОбъект;
КонецФункции

Функция СОдинаковымДвижком(Движок) Экспорт
	СДвижкомКонфигуратор(Движок);
	СДвижкомIbcmd(Движок);
	Возврат ЭтотОбъект;
КонецФункции

Функция СРасчетомИнкремента(СервисРасчетаИнкремента) Экспорт
	_СервисРасчетаИнкремента = СервисРасчетаИнкремента;
	Возврат ЭтотОбъект;
КонецФункции

Функция СEDT(СервисEDT) Экспорт
	_СервисEDT = СервисEDT;
	Возврат ЭтотОбъект;
КонецФункции

Функция Собрать() Экспорт

	Сервис = Новый СервисКонфигурации;

	Рефлектор = Новый Рефлектор;
	Рефлектор.УстановитьСвойство(Сервис, "Движки", _Движки);
	Рефлектор.УстановитьСвойство(Сервис, "Лог", Логирование.ПолучитьЛог("vrunner"));
	Рефлектор.УстановитьСвойство(Сервис, "СервисРасчетаИнкремента", _СервисРасчетаИнкремента);
	Рефлектор.УстановитьСвойство(Сервис, "СервисEDT", ?(_СервисEDT = Неопределено, СервисEDTПоУмолчанию(), _СервисEDT));

	Возврат Сервис;

КонецФункции

// СервисEDT в режиме XML-passthrough: при ПараметрыИсходников = Неопределено не вызывает
// внешних инструментов, поэтому подходит для тестов, не связанных с EDT.
Функция СервисEDTПоУмолчанию()
	Сервис = Новый СервисEDT;
	Рефлектор = Новый Рефлектор;
	Рефлектор.УстановитьСвойство(Сервис, "Лог", Логирование.ПолучитьЛог("vrunner"));
	Возврат Сервис;
КонецФункции
