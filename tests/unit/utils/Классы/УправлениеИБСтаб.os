// BSLLS:ExportVariables-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:NumberOfValuesInStructureConstructor-off
// Стаб ibcmdrunner.УправлениеИБ для юнит-тестов.

Перем ВерсияПлатформы_ Экспорт;
Перем КаталогДанныхАвтономногоСервера_ Экспорт;
Перем Вызовы Экспорт;
Перем БроситьВ Экспорт;
Перем СписокОписанийРасширений Экспорт;

Процедура ПриСозданииОбъекта(Знач ВерсияПлатформы = "")
	ВерсияПлатформы_ = ВерсияПлатформы;
	КаталогДанныхАвтономногоСервера_ = "";
	Вызовы = Новый Массив;
	БроситьВ = "";
	СписокОписанийРасширений = Новый Массив;
КонецПроцедуры

Функция СБросанием(ИмяМетода) Экспорт
	БроситьВ = ИмяМетода;
	Возврат ЭтотОбъект;
КонецФункции

Функция Создать(ВерсияПлатформы) Экспорт
	ВерсияПлатформы_ = ВерсияПлатформы;
	Возврат ЭтотОбъект;
КонецФункции

Процедура ЗаписатьВызов(Знач Метод, Знач Параметры = Неопределено)
	Вызовы.Добавить(Новый Структура("Метод, Параметры", Метод, Параметры));
	Если Метод = БроситьВ Тогда
		ВызватьИсключение СтрШаблон("стаб ibcmd: %1 упал", Метод); // BSLLS:Typo-off
	КонецЕсли;
КонецПроцедуры

// === Параметры ИБ ===

Процедура УстановитьПараметрыФайловойИБ(Каталог) Экспорт
	ЗаписатьВызов("УстановитьПараметрыФайловойИБ", Каталог);
КонецПроцедуры

Процедура УстановитьПараметрыСервернойИБ(Тип, Сервер, БД, Пользователь, Пароль) Экспорт
	ЗаписатьВызов("УстановитьПараметрыСервернойИБ",
		Новый Структура("Тип, Сервер, БД, Пользователь, Пароль", Тип, Сервер, БД, Пользователь, Пароль));
КонецПроцедуры

Процедура УстановитьПараметрыАвторизацииИБ(Пользователь, Пароль) Экспорт
	ЗаписатьВызов("УстановитьПараметрыАвторизацииИБ",
		Новый Структура("Пользователь, Пароль", Пользователь, Пароль));
КонецПроцедуры

Процедура УстановитьПараметрыАвтономногоСервера(Каталог) Экспорт
	КаталогДанныхАвтономногоСервера_ = Каталог;
	ЗаписатьВызов("УстановитьПараметрыАвтономногоСервера", Каталог);
КонецПроцедуры

// === Базовые операции ===

Процедура СоздатьИБ() Экспорт
	ЗаписатьВызов("СоздатьИБ");
КонецПроцедуры

Процедура ЗагрузитьКонфигурациюИзФайлов(Каталог, Имя = "") Экспорт
	ЗаписатьВызов("ЗагрузитьКонфигурациюИзФайлов",
		Новый Структура("Каталог, Имя", Каталог, Имя));
КонецПроцедуры

Процедура ЗагрузитьВыбранныеФайлыКонфигурации(Каталог, Файлы, Имя) Экспорт
	ЗаписатьВызов("ЗагрузитьВыбранныеФайлыКонфигурации",
		Новый Структура("Каталог, Файлы, Имя", Каталог, Файлы, Имя));
КонецПроцедуры

Процедура ЗагрузитьКонфигурацию(Путь, Имя = "") Экспорт
	ЗаписатьВызов("ЗагрузитьКонфигурацию",
		Новый Структура("Путь, Имя", Путь, Имя));
КонецПроцедуры

Процедура ВыгрузитьКонфигурациюВФайл(Путь, Имя = "") Экспорт
	ЗаписатьВызов("ВыгрузитьКонфигурациюВФайл",
		Новый Структура("Путь, Имя", Путь, Имя));
КонецПроцедуры

Процедура ВыгрузитьКонфигурациюВФайлы(Каталог, А2, Имя, Флаг) Экспорт
	ЗаписатьВызов("ВыгрузитьКонфигурациюВФайлы",
		Новый Структура("Каталог, А2, Имя, Флаг", Каталог, А2, Имя, Флаг));
КонецПроцедуры

Процедура ВыгрузитьВФайлИзмененияКонфигурации(ПутьВых, ПутьКеша, А3, А4) Экспорт
	ЗаписатьВызов("ВыгрузитьВФайлИзмененияКонфигурации",
		Новый Структура("ПутьВых, ПутьКеша, А3, А4", ПутьВых, ПутьКеша, А3, А4));
КонецПроцедуры

Процедура ЗагрузитьДанныеИБ(Путь) Экспорт
	ЗаписатьВызов("ЗагрузитьДанныеИБ", Путь);
КонецПроцедуры

Процедура ВыгрузитьДанныеИБ(Путь) Экспорт
	ЗаписатьВызов("ВыгрузитьДанныеИБ", Путь);
КонецПроцедуры

Процедура ОбновитьКонфигурациюБазыДанных(ИмяРасширения = "") Экспорт
	ЗаписатьВызов("ОбновитьКонфигурациюБазыДанных", ИмяРасширения);
КонецПроцедуры

Функция ОписанияРасширений() Экспорт
	ЗаписатьВызов("ОписанияРасширений");
	Возврат СписокОписанийРасширений;
КонецФункции

Процедура ИзменитьСвойстваРасширения(Имя, А1, А2, А3, А4, А5, А6) Экспорт
	ЗаписатьВызов("ИзменитьСвойстваРасширения",
		Новый Структура("Имя, А1, А2, А3, А4, А5, А6", Имя, А1, А2, А3, А4, А5, А6));
КонецПроцедуры
