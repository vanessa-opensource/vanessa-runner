// BSLLS-off
// Стаб желудя КонсольноеПриложение для тестов напильников:
// сам себе корневая команда, записывает регистрируемые опции.

Перем Опции Экспорт; // массив структур {Имя, Умолчание, Описание}

Процедура ПриСозданииОбъекта()
	Опции = Новый Массив;
КонецПроцедуры

Функция ПолучитьКоманду() Экспорт
	Возврат ЭтотОбъект;
КонецФункции

Процедура Опция(Знач Имя, Знач Умолчание, Знач Описание) Экспорт
	Опции.Добавить(Новый Структура("Имя, Умолчание, Описание", Имя, Умолчание, Описание));
КонецПроцедуры
