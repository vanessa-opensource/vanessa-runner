// BSLLS:MissingVariablesDescription-off
// Стаб утилиты Команда (1commands) для тестов СервисEDT.
// Записывает переданные аргументы, возвращает заданный код возврата и вывод.
// При ЭмулироватьУспех создаёт ожидаемый маркер результата (Configuration.xml для export,
// .project для import), повторяя поведение реального 1cedtcli.

Перем ИмяКоманды Экспорт;
Перем Параметры Экспорт;
Перем КодВозврата Экспорт;
Перем Вывод Экспорт;
Перем ЭмулироватьУспех Экспорт;
Перем МаркерыЭкспорта Экспорт; // Относительные пути XML, которые export «создаёт» (по умолчанию Configuration.xml).

Процедура ПриСозданииОбъекта()
	Параметры = Новый Массив;
	КодВозврата = 0;
	Вывод = "";
	ЭмулироватьУспех = Истина;
	МаркерыЭкспорта = Новый Массив;
КонецПроцедуры

Процедура УстановитьКоманду(Знач Имя) Экспорт
	ИмяКоманды = Имя;
КонецПроцедуры

Процедура ДобавитьПараметр(Знач Значение) Экспорт
	Параметры.Добавить(Значение);
КонецПроцедуры

Функция Исполнить() Экспорт
	Если ЭмулироватьУспех Тогда
		ЭмулироватьРезультат();
	КонецЕсли;
	Возврат КодВозврата;
КонецФункции

Функция ПолучитьВывод() Экспорт
	Возврат Вывод;
КонецФункции

// Истина, если среди аргументов встречается значение.
Функция СодержитАргумент(Знач Значение) Экспорт
	Для Каждого Арг Из Параметры Цикл
		Если Арг = Значение Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Значение, идущее в аргументах сразу после ключа (или "" если ключа нет).
Функция ЗначениеПослеКлюча(Знач Ключ) Экспорт
	Для Индекс = 0 По Параметры.ВГраница() Цикл
		Если Параметры[Индекс] = Ключ И Индекс < Параметры.ВГраница() Тогда
			Возврат Параметры[Индекс + 1];
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Процедура ЭмулироватьРезультат()
	Команда = ЗначениеПослеКлюча("-command");
	Если Команда = "export" Тогда
		База = ЗначениеПослеКлюча("--configuration-files");
		Если МаркерыЭкспорта.Количество() = 0 Тогда
			ЗаписатьМаркер(База, "Configuration.xml");
		Иначе
			Для Каждого ОтносительныйПуть Из МаркерыЭкспорта Цикл
				ЗаписатьОтносительныйМаркер(База, ОтносительныйПуть);
			КонецЦикла;
		КонецЕсли;
	ИначеЕсли Команда = "import" Тогда
		ЗаписатьМаркер(ЗначениеПослеКлюча("--project"), ".project");
	ИначеЕсли Команда = "validate" Тогда
		ЗаписатьФайлРезультата(ЗначениеПослеКлюча("--file"));
	КонецЕсли;
КонецПроцедуры

// Записать XML-маркер по относительному пути (создав промежуточные подкаталоги).
Процедура ЗаписатьОтносительныйМаркер(Знач БазовыйКаталог, Знач ОтносительныйПуть)
	Если НЕ ЗначениеЗаполнено(БазовыйКаталог) Тогда
		Возврат;
	КонецЕсли;
	Части = СтрРазделить(ОтносительныйПуть, "/", Ложь);
	КаталогФайла = БазовыйКаталог;
	Для Индекс = 0 По Части.ВГраница() - 1 Цикл
		КаталогФайла = ОбъединитьПути(КаталогФайла, Части[Индекс]);
	КонецЦикла;
	ЗаписатьМаркер(КаталогФайла, Части[Части.ВГраница()]);
КонецПроцедуры

// Эмулировать .tsv-результат проверки EDT: две строки с замечаниями разного уровня.
Процедура ЗаписатьФайлРезультата(Знач ПутьФайла)
	Если НЕ ЗначениеЗаполнено(ПутьФайла) Тогда
		Возврат;
	КонецЕсли;
	Т = Символы.Таб;
	Строки = "2026-01-01T00:00:00+0300" + Т + "Значительная" + Т + "Безопасность" + Т + "Проект" + Т
		+ "right-admin" + Т + "Роль.ПолныеПрава" + Т + "Права роли" + Т + "Право Администрирование" + Символы.ПС
		+ "2026-01-01T00:00:00+0300" + Т + "Незначительная" + Т + "Стандарты кодирования" + Т + "Проект" + Т
		+ "use-non-recommended-method" + Т + "Модуль" + Т + "строка 3" + Т + "Не рекомендуемый метод";
	Запись = Новый ЗаписьТекста(ПутьФайла, КодировкаТекста.UTF8);
	Запись.Записать(Строки);
	Запись.Закрыть();
КонецПроцедуры

Процедура ЗаписатьМаркер(Знач Каталог, Знач ИмяМаркера)
	Если НЕ ЗначениеЗаполнено(Каталог) Тогда
		Возврат;
	КонецЕсли;
	Если НЕ Новый Файл(Каталог).Существует() Тогда
		СоздатьКаталог(Каталог);
	КонецЕсли;
	Запись = Новый ЗаписьТекста(ОбъединитьПути(Каталог, ИмяМаркера), КодировкаТекста.UTF8);
	Запись.Записать("<stub/>");
	Запись.Закрыть();
КонецПроцедуры
