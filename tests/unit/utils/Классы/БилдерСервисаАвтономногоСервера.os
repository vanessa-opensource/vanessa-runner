// Билдер СервисАвтономногоСервера для юнит-тестов.
// Позволяет внедрить состояние и мок _МенеджерАС через Рефлектор.

#Использовать reflector
#Использовать logos
#Использовать "../../../../src/core/Сервисы"

Перем _МенеджерАС;
Перем _КаталогДанных;
Перем _Запущен;
Перем _ПортHttp;
Перем _ПортПрямой;
Перем _ИспользоватьПрямое;

Процедура ПриСозданииОбъекта()
	_МенеджерАС = Неопределено;
	_КаталогДанных = "";
	_Запущен = Ложь;
	_ПортHttp = 8314;
	_ПортПрямой = 8341;
	_ИспользоватьПрямое = Ложь;
КонецПроцедуры

Функция СМенеджеромАС(Менеджер) Экспорт
	_МенеджерАС = Менеджер;
	Возврат ЭтотОбъект;
КонецФункции

Функция СКаталогомДанных(Каталог) Экспорт
	_КаталогДанных = Каталог;
	Возврат ЭтотОбъект;
КонецФункции

Функция Запущенным() Экспорт
	_Запущен = Истина;
	Возврат ЭтотОбъект;
КонецФункции

Функция СПортами(ПортHttp, ПортПрямой) Экспорт
	_ПортHttp = ПортHttp;
	_ПортПрямой = ПортПрямой;
	Возврат ЭтотОбъект;
КонецФункции

Функция СПрямымСоединением() Экспорт
	_ИспользоватьПрямое = Истина;
	Возврат ЭтотОбъект;
КонецФункции

Функция Собрать() Экспорт

	Сервис = Новый СервисАвтономногоСервера;

	Рефлектор = Новый Рефлектор;
	Рефлектор.УстановитьСвойство(Сервис, "Лог", Логирование.ПолучитьЛог("vrunner"));
	Рефлектор.УстановитьСвойство(Сервис, "_МенеджерАС", _МенеджерАС);
	Рефлектор.УстановитьСвойство(Сервис, "_КаталогДанныхСервера", _КаталогДанных);
	Рефлектор.УстановитьСвойство(Сервис, "_Запущен", _Запущен);
	Рефлектор.УстановитьСвойство(Сервис, "_ПортHttp", _ПортHttp);
	Рефлектор.УстановитьСвойство(Сервис, "_ПортПрямогоСоединения", _ПортПрямой);
	Рефлектор.УстановитьСвойство(Сервис, "_ИспользоватьПрямоеСоединение", _ИспользоватьПрямое);

	Возврат Сервис;

КонецФункции
