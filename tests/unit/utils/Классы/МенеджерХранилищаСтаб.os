// Стаб МенеджерХранилищаКонфигурации для юнит-тестов СервисХранилища.

Перем Конфигуратор_ Экспорт;
Перем АдресХранилища_ Экспорт;
Перем Пользователь_ Экспорт;
Перем Пароль_ Экспорт;
Перем ВыводКоманды_ Экспорт;
Перем Вызовы Экспорт; // массив структур: Метод, Параметры
Перем БроситьВ Экспорт; // имя метода, при вызове которого бросать исключение

Процедура ПриСозданииОбъекта()
	Конфигуратор_ = Неопределено;
	АдресХранилища_ = "";
	Пользователь_ = "";
	Пароль_ = "";
	ВыводКоманды_ = "stub-output";
	Вызовы = Новый Массив;
	БроситьВ = "";
КонецПроцедуры

// Builder-методы для теста.
Функция СБрасыванием(ИмяМетода) Экспорт
	БроситьВ = ИмяМетода;
	Возврат ЭтотОбъект;
КонецФункции

// Метод фабрики.
Функция Создать() Экспорт
	Возврат ЭтотОбъект;
КонецФункции

Процедура ЗаписатьВызов(Знач Метод, Знач Параметры = Неопределено)
	Вызовы.Добавить(Новый Структура("Метод, Параметры", Метод, Параметры));
	Если Метод = БроситьВ Тогда
		ВызватьИсключение СтрШаблон("стаб: %1 упал", Метод);
	КонецЕсли;
КонецПроцедуры

// === Интерфейс v8storage.МенеджерХранилищаКонфигурации ===

Процедура УстановитьУправлениеКонфигуратором(Конфигуратор) Экспорт
	Конфигуратор_ = Конфигуратор;
	ЗаписатьВызов("УстановитьУправлениеКонфигуратором");
КонецПроцедуры

Процедура УстановитьПутьКХранилищу(Адрес) Экспорт
	АдресХранилища_ = Адрес;
КонецПроцедуры

Процедура УстановитьПараметрыАвторизации(Логин, Пароль) Экспорт
	Пользователь_ = Логин;
	Пароль_ = Пароль;
КонецПроцедуры

Функция ПолучитьВыводКоманды() Экспорт
	Возврат ВыводКоманды_;
КонецФункции

Процедура ОбновитьКонфигурациюНаВерсию(Версия) Экспорт
	ЗаписатьВызов("ОбновитьКонфигурациюНаВерсию", Версия);
КонецПроцедуры

Процедура СоздатьХранилищеКонфигурации() Экспорт
	ЗаписатьВызов("СоздатьХранилищеКонфигурации");
КонецПроцедуры

Процедура ПодключитьсяКХранилищу(Игнор, Заменить) Экспорт
	ЗаписатьВызов("ПодключитьсяКХранилищу", Новый Структура("Игнор, Заменить", Игнор, Заменить));
КонецПроцедуры

Процедура ОтключитьсяОтХранилища() Экспорт
	ЗаписатьВызов("ОтключитьсяОтХранилища");
КонецПроцедуры

Процедура ДобавитьПользователяВХранилище(Логин, Пароль, Роль) Экспорт
	ЗаписатьВызов("ДобавитьПользователяВХранилище",
		Новый Структура("Логин, Пароль, Роль", Логин, Пароль, Роль));
КонецПроцедуры

Процедура КопироватьПользователейИзХранилища(Адрес, Польз, Парол, Восст) Экспорт
	ЗаписатьВызов("КопироватьПользователейИзХранилища",
		Новый Структура("Адрес, Польз, Парол, Восст", Адрес, Польз, Парол, Восст));
КонецПроцедуры

Процедура СохранитьВерсиюКонфигурацииВФайл(Версия, Путь) Экспорт
	ЗаписатьВызов("СохранитьВерсиюКонфигурацииВФайл",
		Новый Структура("Версия, Путь", Версия, Путь));
КонецПроцедуры

Процедура ЗахватитьОбъектыВХранилище(Путь, Получать) Экспорт
	ЗаписатьВызов("ЗахватитьОбъектыВХранилище",
		Новый Структура("Путь, Получать", Путь, Получать));
КонецПроцедуры

Процедура ОтменитьЗахватОбъектовВХранилище(Путь, Игнорировать) Экспорт
	ЗаписатьВызов("ОтменитьЗахватОбъектовВХранилище",
		Новый Структура("Путь, Игнорировать", Путь, Игнорировать));
КонецПроцедуры

Процедура ПоместитьИзмененияОбъектовВХранилище(Путь, Коммент, Оставить, Удал) Экспорт
	ЗаписатьВызов("ПоместитьИзмененияОбъектовВХранилище",
		Новый Структура("Путь, Коммент, Оставить, Удал", Путь, Коммент, Оставить, Удал));
КонецПроцедуры
