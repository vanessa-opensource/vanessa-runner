// BSLLS:ExportVariables-off
// BSLLS:MissingVariablesDescription-off
// Стаб СервисПлатформы для юнит-тестов СервисСинтаксическойПроверки: запоминает вызовы
// ПроверитьКонфигурацию и отдаёт заранее заданный вывод конфигуратора по очереди.

Перем Вызовы Экспорт;   // Массив из Структура: Ключи, ПараметрыПодключения, ПараметрыХранилища, ПараметрыПлатформы
Перем Выводы Экспорт;   // Массив из Строка - вывод конфигуратора на каждый вызов по порядку

Процедура ПриСозданииОбъекта()
	Вызовы = Новый Массив;
	Выводы = Новый Массив;
КонецПроцедуры

// Добавить вывод конфигуратора для очередного вызова.
//
// Параметры:
//   Текст - Строка - вывод конфигуратора
//
// Возвращаемое значение:
//   ПроверкаКонфигурацииСтаб - этот объект
//
Функция СВыводом(Знач Текст) Экспорт
	Выводы.Добавить(Текст);
	Возврат ЭтотОбъект;
КонецФункции

Функция ПроверитьКонфигурацию(Знач ПараметрыПодключения, Знач РежимыПроверки,
		Знач ПараметрыХранилища = Неопределено, Знач ПараметрыПлатформы = Неопределено) Экспорт

	Ключи = Новый Массив;
	Для Каждого Ключ Из РежимыПроверки Цикл
		Ключи.Добавить(Ключ);
	КонецЦикла;

	Вызов = Новый Структура;
	Вызов.Вставить("Ключи", Ключи);
	Вызов.Вставить("ПараметрыПодключения", ПараметрыПодключения);
	Вызов.Вставить("ПараметрыХранилища", ПараметрыХранилища);
	Вызов.Вставить("ПараметрыПлатформы", ПараметрыПлатформы);
	Вызовы.Добавить(Вызов);

	Вывод = ?(Выводы.Количество() >= Вызовы.Количество(), Выводы[Вызовы.Количество() - 1], "");
	Возврат Новый Структура("Успешно, ВыводКоманды", Истина, Вывод);

КонецФункции
