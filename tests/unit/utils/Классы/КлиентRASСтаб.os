// BSLLS:ExportVariables-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
// BSLLS:NumberOfValuesInStructureConstructor-off
// BSLLS:UnusedLocalMethod-off ПриСозданииОбъекта вызывается рантаймом при Новый.
// BSLLS:UnusedParameters-off Сигнатуры повторяют КлиентКластераRAS.
// Стаб КлиентКластераRAS (v8ras) для тестов СервисКластера: кластеры, базы, сеансы, соединения и рабочие
// процессы в памяти, вызовы записываются. Завершённые сеансы, как на сервере, из списка исчезают.

Перем Подключений Экспорт;
Перем Отключений Экспорт;
Перем Аутентификации Экспорт; // Массив структур Кому (Кластер|База), ИдКластера, Пользователь, Пароль
Перем СозданныеБазы Экспорт;  // Массив структур ИдКластера, Инфо, Режим
Перем ОбновленияБаз Экспорт;  // Массив Инфо, переданных в ОбновитьБазу
Перем УдаленныеБазы Экспорт;  // Массив структур ИдКластера, ИдБазы, Режим
Перем ОтказатьВоВходеС Экспорт; // номер аутентификации, с которой вход в кластер отклоняется; 0 - никогда
Перем ВыключенныеПроцессы Экспорт; // Массив UUID из ВыключитьРабочийПроцесс
Перем РазорванныеСоединения Экспорт; // Массив UUID из РазорватьСоединение
Перем _Кластеры;
Перем _Базы; // Массив Инфо
Перем _Сеансы;
Перем _Соединения;
Перем _Процессы;

Процедура ПриСозданииОбъекта()
	Подключений = 0;
	Отключений = 0;
	Аутентификации = Новый Массив;
	СозданныеБазы = Новый Массив;
	ОбновленияБаз = Новый Массив;
	УдаленныеБазы = Новый Массив;
	ОтказатьВоВходеС = 0;
	_Кластеры = Новый Массив;
	_Базы = Новый Массив;
	_Сеансы = Новый Массив;
	_Соединения = Новый Массив;
	_Процессы = Новый Массив;
	ВыключенныеПроцессы = Новый Массив;
	РазорванныеСоединения = Новый Массив;
КонецПроцедуры

#Область Настройка

Функция СКластером(Знач Имя, Знач Ид) Экспорт
	_Кластеры.Добавить(Новый Структура("Имя, Ид, ПериодПринудительногоЗавершения", Имя, Ид, 60));
	Возврат ЭтотОбъект;
КонецФункции

// Инфо - поля структуры База поверх умолчаний: незаблокированная база PostgreSQL с выдачей лицензий.
Функция СБазой(Знач Имя, Знач Ид, Знач Инфо = Неопределено) Экспорт

	База = Новый Структура("Ид, Имя, СУБД, СерверБД, ИмяБД, ПользовательБД",
		Ид, Имя, "PostgreSQL", "pg", Имя, "postgres");
	База.Вставить("БлокировкаСеансов", Ложь);
	База.Вставить("СообщениеБлокировки", "");
	База.Вставить("КодРазрешения", "");
	База.Вставить("БлокировкаРегламентных", Ложь);
	База.Вставить("ВыдачаЛицензийСервером", 1);
	Если Инфо <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(База, Инфо);
	КонецЕсли;
	_Базы.Добавить(База);

	Возврат ЭтотОбъект;

КонецФункции

// Сеанс - поля v8ras и состояние: Завершен, ВызововЗавершения, ЗавершитсяСПопытки (зависший сеанс),
// БроситьПриЗавершении, ИсчезнетПослеЧтений (сеанс завершается сам; 0 - никогда),
// ПоявитсяПослеВыключения (сеанс виден только после выключения рабочего процесса).
Функция ДобавитьСеанс(Знач ИдБазы, Знач Приложение = "1CV8C", Знач Пользователь = "") Экспорт

	Сеанс = Новый Структура("Ид, Номер, ИдБазы, Приложение, ИмяПользователя",
		Строка(Новый УникальныйИдентификатор), _Сеансы.Количество() + 1, ИдБазы, Приложение, Пользователь);
	Сеанс.Вставить("Хост", "host" + Сеанс.Номер);
	Сеанс.Вставить("Начало", '20260101100000');
	Сеанс.Вставить("ПоследняяАктивность", '20260101110000');
	Сеанс.Вставить("Завершен", Ложь);
	Сеанс.Вставить("ВызововЗавершения", 0);
	Сеанс.Вставить("ЗавершитсяСПопытки", 1);
	Сеанс.Вставить("БроситьПриЗавершении", Ложь);
	Сеанс.Вставить("ИсчезнетПослеЧтений", 0);
	Сеанс.Вставить("ПоявитсяПослеВыключения", Ложь);
	_Сеансы.Добавить(Сеанс);

	Возврат Сеанс;

КонецФункции

// Соединение - поля v8ras и состояние, как у сеанса: Завершен, ИсчезнетПослеЧтений; Зависло - разрыв
// не снимает соединение, БроситьПриРазрыве - падает; ПереживетВыключение - не снимает и выключение процесса.
Функция ДобавитьСоединение(Знач ИдБазы, Знач НомерСеанса = 0) Экспорт

	Соединение = Новый Структура("Ид, Номер, ИдБазы, НомерСеанса",
		Строка(Новый УникальныйИдентификатор), _Соединения.Количество() + 1, ИдБазы, НомерСеанса);
	Соединение.Вставить("Приложение", "1CV8C");
	Соединение.Вставить("Хост", "host" + Соединение.Номер);
	Соединение.Вставить("Подключено", '20260101100000');
	Соединение.Вставить("ИдПроцесса", "");
	Соединение.Вставить("Завершен", Ложь);
	Соединение.Вставить("ИсчезнетПослеЧтений", 0);
	Соединение.Вставить("ПоявитсяПослеВыключения", Ложь);
	Соединение.Вставить("Зависло", Ложь);
	Соединение.Вставить("БроситьПриРазрыве", Ложь);
	Соединение.Вставить("ПереживетВыключение", Ложь);
	_Соединения.Добавить(Соединение);

	Возврат Соединение;

КонецФункции

Функция ДобавитьПроцесс(Знач Pid = "4242", Знач Хост = "srv") Экспорт
	Процесс = Новый Структура("Ид, Pid, Хост", Строка(Новый УникальныйИдентификатор), Pid, Хост);
	_Процессы.Добавить(Процесс);
	Возврат Процесс;
КонецФункции

#КонецОбласти

#Область КлиентКластераRAS

Функция Подключить() Экспорт
	Подключений = Подключений + 1;
	Возврат ЭтотОбъект;
КонецФункции

Процедура Отключить() Экспорт
	Отключений = Отключений + 1;
КонецПроцедуры

Функция Кластеры() Экспорт
	Возврат _Кластеры;
КонецФункции

Процедура АутентифицироватьКластер(Знач ИдКластера, Знач Пользователь, Знач Пароль) Экспорт
	ДобавитьАутентификацию("Кластер", ИдКластера, Пользователь, Пароль);
	Если ОтказатьВоВходеС > 0 И Аутентификации.Количество() >= ОтказатьВоВходеС Тогда
		ВызватьИсключение "Доступ запрещен";
	КонецЕсли;
КонецПроцедуры

Процедура АутентифицироватьБазу(Знач ИдКластера, Знач Пользователь, Знач Пароль) Экспорт
	ДобавитьАутентификацию("База", ИдКластера, Пользователь, Пароль);
КонецПроцедуры

Функция Инфобазы(Знач ИдКластера) Экспорт // BSLLS:Typo-off Имя метода v8ras.

	Результат = Новый Массив;
	Для Каждого База Из _Базы Цикл
		Результат.Добавить(Новый Структура("Ид, Имя, Описание", База.Ид, База.Имя, ""));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Копия хранимой Инфо, как свежий ответ сервера.
Функция ИнформацияОБазе(Знач ИдКластера, Знач ИдБазы) Экспорт

	Инфо = Новый Структура;
	Для Каждого Поле Из _Базы[ИндексБазы(ИдБазы)] Цикл
		Инфо.Вставить(Поле.Ключ, Поле.Значение);
	КонецЦикла;

	Возврат Инфо;

КонецФункции

Процедура ОбновитьБазу(Знач ИдКластера, Знач Инфо) Экспорт
	ОбновленияБаз.Добавить(Инфо);
	_Базы[ИндексБазы(Инфо.Ид)] = Инфо;
КонецПроцедуры

Функция СоздатьБазу(Знач ИдКластера, Знач Инфо, Знач Режим = 1) Экспорт
	СозданныеБазы.Добавить(Новый Структура("ИдКластера, Инфо, Режим", ИдКластера, Инфо, Режим));
	Возврат Строка(Новый УникальныйИдентификатор);
КонецФункции

Процедура УдалитьБазу(Знач ИдКластера, Знач ИдБазы, Знач Режим = 0) Экспорт
	УдаленныеБазы.Добавить(Новый Структура("ИдКластера, ИдБазы, Режим", ИдКластера, ИдБазы, Режим));
КонецПроцедуры

Функция Сеансы(Знач ИдКластера) Экспорт
	Возврат Живые(_Сеансы);
КонецФункции

Функция Соединения(Знач ИдКластера) Экспорт
	Возврат Живые(_Соединения);
КонецФункции

Функция РабочиеПроцессы(Знач ИдКластера) Экспорт
	Возврат _Процессы;
КонецФункции

// Независшее соединение после разрыва исчезает.
Процедура РазорватьСоединение(Знач ИдКластера, Знач ИдПроцесса, Знач ИдСоединения) Экспорт
	РазорванныеСоединения.Добавить(ИдСоединения);
	Для Каждого Соединение Из _Соединения Цикл
		Если Соединение.Ид <> ИдСоединения Тогда
			Продолжить;
		КонецЕсли;
		Если Соединение.БроситьПриРазрыве Тогда
			ВызватьИсключение "Недостаточно прав пользователя на информационную базу";
		КонецЕсли;
		Соединение.Завершен = НЕ Соединение.Зависло;
	КонецЦикла;
КонецПроцедуры

// Соединения процесса, кроме переживающих выключение, исчезают, как на сервере после его остановки.
Процедура ВыключитьРабочийПроцесс(Знач ИдКластера, Знач ИдПроцесса) Экспорт
	ВыключенныеПроцессы.Добавить(ИдПроцесса);
	Для Каждого Соединение Из _Соединения Цикл
		Если Соединение.ИдПроцесса = ИдПроцесса И НЕ Соединение.ПереживетВыключение Тогда
			Соединение.Завершен = Истина;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Сеанс ищется по UUID, как на сервере; неизвестный - исключение.
Процедура ЗавершитьСеанс(Знач ИдКластера, Знач ИдСеанса, Знач Сообщение = "") Экспорт

	Для Каждого Сеанс Из _Сеансы Цикл
		Если Сеанс.Ид <> ИдСеанса Тогда
			Продолжить;
		КонецЕсли;
		Если Сеанс.БроситьПриЗавершении Тогда
			ВызватьИсключение "сеанс невозможно завершить";
		КонецЕсли;
		Сеанс.ВызововЗавершения = Сеанс.ВызововЗавершения + 1;
		Сеанс.Завершен = (Сеанс.ВызововЗавершения >= Сеанс.ЗавершитсяСПопытки);
		Возврат;
	КонецЦикла;

	ВызватьИсключение "Session not found: " + ИдСеанса;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Незавершённые сеансы или соединения; ИсчезнетПослеЧтений отсчитывается при каждом чтении.
Функция Живые(Знач Элементы)

	Результат = Новый Массив;
	Для Каждого Элемент Из Элементы Цикл
		Если Элемент.Завершен ИЛИ Элемент.ПоявитсяПослеВыключения И ВыключенныеПроцессы.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(Элемент);
		Если Элемент.ИсчезнетПослеЧтений > 0 Тогда
			Элемент.ИсчезнетПослеЧтений = Элемент.ИсчезнетПослеЧтений - 1;
			Элемент.Завершен = (Элемент.ИсчезнетПослеЧтений = 0);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ДобавитьАутентификацию(Знач Кому, Знач ИдКластера, Знач Пользователь, Знач Пароль)
	Запись = Новый Структура("Кому, ИдКластера, Пользователь, Пароль", Кому, ИдКластера, Пользователь, Пароль);
	Аутентификации.Добавить(Запись);
КонецПроцедуры

Функция ИндексБазы(Знач ИдБазы)

	Для Индекс = 0 По _Базы.ВГраница() Цикл
		Если _Базы[Индекс].Ид = ИдБазы Тогда
			Возврат Индекс;
		КонецЕсли;
	КонецЦикла;

	ВызватьИсключение "Infobase not found: " + ИдБазы;

КонецФункции

#КонецОбласти
