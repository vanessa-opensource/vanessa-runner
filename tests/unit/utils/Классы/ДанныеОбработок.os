// BSLLS:NumberOfValuesInStructureConstructor-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
// Тестовые данные: внешние обработки и отчёты 1С (XML-исходники, EPF/ERF-файлы).
// Используются в тестах СервисОбработок.

#Использовать tempfiles

#Область ПрограммныйИнтерфейс

// Создать временный каталог с одним XML-файлом обработки.
// Возвращает Структура: Каталог, ФайлXml, ИмяОбработки.
Функция КаталогСОбработкой(Знач ИмяОбработки = "ТестоваяОбработка") Экспорт

	Каталог = ВременныеФайлы.СоздатьКаталог();
	ПутьXml = ОбъединитьПути(Каталог, ИмяОбработки + ".xml");
	ЗаписатьСодержимоеXml(ПутьXml, ИмяОбработки, "ExternalDataProcessor");

	Возврат Новый Структура("Каталог, ФайлXml, ИмяОбработки",
		Каталог, ПутьXml, ИмяОбработки);

КонецФункции

// Создать временный каталог с одним XML-файлом внешнего отчёта.
// Возвращает Структура: Каталог, ФайлXml, ИмяОтчета.
Функция КаталогСОтчетом(Знач ИмяОтчета = "ТестовыйОтчет") Экспорт

	Каталог = ВременныеФайлы.СоздатьКаталог();
	ПутьXml = ОбъединитьПути(Каталог, ИмяОтчета + ".xml");
	ЗаписатьСодержимоеXml(ПутьXml, ИмяОтчета, "ExternalReport");

	Возврат Новый Структура("Каталог, ФайлXml, ИмяОтчета",
		Каталог, ПутьXml, ИмяОтчета);

КонецФункции

// Создать временный каталог с двумя подкаталогами: обработка и внешний отчёт.
// Возвращает Структура: Каталог, ФайлОбработки, ИмяОбработки, ФайлОтчета, ИмяОтчета.
Функция КаталогСОбработкойИОтчетом(Знач ИмяОбработки = "МояОбработка", Знач ИмяОтчета = "МойОтчет") Экспорт

	Корень = ВременныеФайлы.СоздатьКаталог();

	КаталогОбработки = ОбъединитьПути(Корень, ИмяОбработки);
	СоздатьКаталог(КаталогОбработки);
	ПутьОбработки = ОбъединитьПути(КаталогОбработки, ИмяОбработки + ".xml");
	ЗаписатьСодержимоеXml(ПутьОбработки, ИмяОбработки, "ExternalDataProcessor");

	КаталогОтчета = ОбъединитьПути(Корень, ИмяОтчета);
	СоздатьКаталог(КаталогОтчета);
	ПутьОтчета = ОбъединитьПути(КаталогОтчета, ИмяОтчета + ".xml");
	ЗаписатьСодержимоеXml(ПутьОтчета, ИмяОтчета, "ExternalReport");

	Возврат Новый Структура("Каталог, ФайлОбработки, ИмяОбработки, ФайлОтчета, ИмяОтчета",
		Корень, ПутьОбработки, ИмяОбработки, ПутьОтчета, ИмяОтчета);

КонецФункции

// Создать пустой временный каталог (без XML).
Функция ПустойКаталог() Экспорт
	Возврат ВременныеФайлы.СоздатьКаталог();
КонецФункции

// Создать временный каталог с N подкаталогами, в каждом - обработка.
// Возвращает Структура: Каталог, ПодКаталоги (Массив).
Функция КаталогСНесколькимиОбработками(Знач Количество = 2) Экспорт

	Корень = ВременныеФайлы.СоздатьКаталог();
	ПодКаталоги = Новый Массив;

	Для Сч = 1 По Количество Цикл
		ИмяОбработки = "Обработка" + Сч;
		Подкаталог = ОбъединитьПути(Корень, ИмяОбработки);
		СоздатьКаталог(Подкаталог);
		ПутьXml = ОбъединитьПути(Подкаталог, ИмяОбработки + ".xml");
		ЗаписатьСодержимоеXml(ПутьXml, ИмяОбработки, "ExternalDataProcessor");
		ПодКаталоги.Добавить(Подкаталог);
	КонецЦикла;

	Возврат Новый Структура("Каталог, ПодКаталоги", Корень, ПодКаталоги);

КонецФункции

// Создать временный EPF-файл (плейсхолдер, реальная EPF-структура не нужна для unit-тестов).
// Возвращает Структура: ПутьКФайлу, Каталог, ИмяБезРасширения.
Функция ВременныйEpf(Знач Имя = "ТестоваяОбработка") Экспорт
	Возврат ВременныйФайлВнешнегоОбъекта(Имя, "epf");
КонецФункции

// Создать временный ERF-файл внешнего отчёта (плейсхолдер).
// Возвращает Структура: ПутьКФайлу, Каталог, ИмяБезРасширения.
Функция ВременныйErf(Знач Имя = "ТестовыйОтчет") Экспорт
	Возврат ВременныйФайлВнешнегоОбъекта(Имя, "erf");
КонецФункции

// Создать временный каталог с N EPF-файлами.
Функция КаталогСНесколькимиEpf(Знач Количество = 2) Экспорт

	Корень = ВременныеФайлы.СоздатьКаталог();
	Файлы = Новый Массив;
	Для Сч = 1 По Количество Цикл
		Файлы.Добавить(ЗаписатьФайлЗаглушку(Корень, "Обработка" + Сч, "epf"));
	КонецЦикла;

	Возврат Новый Структура("Каталог, Файлы", Корень, Файлы);

КонецФункции

// Создать временный каталог с одним EPF-файлом обработки и одним ERF-файлом отчёта.
// Возвращает Структура: Каталог, ФайлОбработки, ИмяОбработки, ФайлОтчета, ИмяОтчета.
Функция КаталогСФайламиОбработкиИОтчета(Знач ИмяОбработки = "МояОбработка", Знач ИмяОтчета = "МойОтчет") Экспорт

	Корень = ВременныеФайлы.СоздатьКаталог();

	Возврат Новый Структура("Каталог, ФайлОбработки, ИмяОбработки, ФайлОтчета, ИмяОтчета",
		Корень,
		ЗаписатьФайлЗаглушку(Корень, ИмяОбработки, "epf"), ИмяОбработки,
		ЗаписатьФайлЗаглушку(Корень, ИмяОтчета, "erf"), ИмяОтчета);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВременныйФайлВнешнегоОбъекта(Знач Имя, Знач Расширение)

	Каталог = ВременныеФайлы.СоздатьКаталог();

	Возврат Новый Структура("ПутьКФайлу, Каталог, ИмяБезРасширения",
		ЗаписатьФайлЗаглушку(Каталог, Имя, Расширение), Каталог, Имя);

КонецФункции

Функция ЗаписатьФайлЗаглушку(Знач Каталог, Знач Имя, Знач Расширение)

	Путь = ОбъединитьПути(Каталог, Имя + "." + Расширение);
	ТД = Новый ТекстовыйДокумент;
	ТД.УстановитьТекст(Расширение + "-placeholder");
	ТД.Записать(Путь);

	Возврат Путь;

КонецФункции

Процедура ЗаписатьСодержимоеXml(Знач Путь, Знач ИмяОбъекта, Знач ТегОбъекта)
	Содержимое = СтрШаблон(
		"<?xml version=""1.0"" encoding=""UTF-8""?>"
		+ "<MetaDataObject xmlns=""http://v8.1c.ru/8.3/MDClasses"">"
		+ "<%2 uuid=""00000000-0000-0000-0000-000000000001"">"
		+ "<Properties><Name>%1</Name></Properties>"
		+ "</%2>"
		+ "</MetaDataObject>",
		ИмяОбъекта, ТегОбъекта);
	ТД = Новый ТекстовыйДокумент;
	ТД.УстановитьТекст(Содержимое);
	ТД.Записать(Путь, КодировкаТекста.UTF8);
КонецПроцедуры

#КонецОбласти
