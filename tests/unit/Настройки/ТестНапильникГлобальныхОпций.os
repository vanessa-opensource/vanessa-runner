// BSLLS-off
// Юнит-тесты НапильникГлобальныхОпций: регистрация глобальной опции --settings
// в корневой команде приложения.

#Использовать asserts
// annotations нужен пакету Настройки на компиляции (РаботаСАннотациями)
#Использовать annotations

#Использовать "../../../src/core/Настройки"
#Использовать "../utils"

#Область Тесты

&Тест
Процедура ТестДолжен_ЗарегистрироватьОпциюSettings_ВКорневойКоманде() Экспорт

	Желудь = Новый ЖелудьПриложенияСтаб;
	Напильник = Новый НапильникГлобальныхОпций;

	Результат = Напильник.ОбработатьЖелудь(Желудь, Неопределено);

	Ожидаем.Что(Результат, "напильник возвращает тот же желудь").Равно(Желудь);
	Ожидаем.Что(Желудь.Опции.Количество()).Равно(1);
	Ожидаем.Что(Желудь.Опции[0].Имя).Равно("settings");
	Ожидаем.Что(ЗначениеЗаполнено(Желудь.Опции[0].Описание), "у опции есть описание").ЭтоИстина();

КонецПроцедуры

#КонецОбласти
