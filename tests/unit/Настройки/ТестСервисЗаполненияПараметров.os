КонецПроцедуры

&Тест
Процедура ТестДолжен_ПропуститьПроверкиФайла_ЕслиЗначениеНеЗадано() Экспорт

	Аннотации = Расширение(".cf");
	Аннотации.Добавить(Аннотация("СуществующийФайл"));
	ЗарегистрироватьКоманду("unload", ОпределениеСОпцией("Каталог", "cf-file", , , Аннотации));

	Сервис.Заполнить(Команда);

	Ожидаем.Что(Команда.Каталог).Равно(Неопределено);

