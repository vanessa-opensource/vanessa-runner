// BSLLS-off
// Юнит-тесты СервисЗаполненияПараметров: заполнение пустых опций команды из настроек
// по аннотациям &Опция/&Аргумент/&Флаговый/&НаборОпций, путь команды по цепочке родителей,
// декларативные проверки полей после заполнения. Поделка и определения желудей - стабы.

#Использовать asserts
#Использовать "../utils"

Перем Стенд;
Перем Сервис;
Перем Поделка; // ПоделкаСтаб: детальки настроек и реестр желудей команд
Перем Команда; // КомандаОпцийСтаб: объект команды, который заполняет сервис

&ПередКаждым
Процедура ПередКаждым() Экспорт
	Стенд = Новый Стенд;
	Поделка = Стенд.Подменить("Поделка", Новый ПоделкаСтаб);
	Стенд.Реальный("СервисНастроек"); // каскадный поиск ключей настоящий, по той же Поделке
	Стенд.Реальный("ФайловыеОперации");
	Сервис = Стенд.Сервис("СервисЗаполненияПараметров");
	Команда = Новый КомандаОпцийСтаб;
КонецПроцедуры

#Область ЗаполнениеОпций

&Тест
Процедура ТестДолжен_ПропуститьНеопределенныйОбъектКоманды() Экспорт
	Сервис.Заполнить(Неопределено); // не падает
КонецПроцедуры

&Тест
Процедура ТестДолжен_ПропуститьЗаполнение_ЕслиОпределениеКомандыНеНайдено() Экспорт

	// Дано - Поделка пуста, желудь команды не зарегистрирован
	// Когда
	Сервис.Заполнить(Команда);

	// Тогда
	Ожидаем.Что(Команда.Подключение).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗаполнитьПустуюОпцию_ИзНастроек() Экспорт

	// Дано
	ЗарегистрироватьКоманду(ОпределениеСОпцией("Подключение", "ibcmd i"));
	Поделка.СДеталькой("vrunner.load.ibcmd", "/opt/1cv8/ibcmd");

	// Когда
	Сервис.Заполнить(Команда);

	// Тогда
	Ожидаем.Что(Команда.Подключение).Равно("/opt/1cv8/ibcmd");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОставитьЗаполненнуюОпцию_БезИзменений() Экспорт

	// Дано
	Команда.Подключение = "из-командной-строки";
	ЗарегистрироватьКоманду(ОпределениеСОпцией("Подключение", "ibcmd i"));
	Поделка.СДеталькой("vrunner.load.ibcmd", "из-настроек");

	// Когда
	Сервис.Заполнить(Команда);

	// Тогда
	Ожидаем.Что(Команда.Подключение).Равно("из-командной-строки");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗаполнитьАргумент_ИзНастроек() Экспорт

	// Дано
	ЗарегистрироватьКоманду(ОпределениеСАргументом("Каталог", "SRC", "decompile"));
	Поделка.СДеталькой("vrunner.decompile.SRC", "./src/cf");

	// Когда
	Сервис.Заполнить(Команда);

	// Тогда
	Ожидаем.Что(Команда.Каталог).Равно("./src/cf");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПропуститьОпциюБезИмени() Экспорт

	// Дано
	ЗарегистрироватьКоманду(Определение("load", "Подключение", ТестовыеДанные.Массив(Аннотация("Опция"))));

	// Когда
	Сервис.Заполнить(Команда);

	// Тогда
	Ожидаем.Что(Команда.Подключение).Равно(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область ДекларативныеПроверки

&Тест
Процедура ТестДолжен_ПринятьОбязательныйАргумент_ЗаданныйВКоманднойСтроке() Экспорт

	// Дано
	Команда.Каталог = "./build/1cv8.cf";
	ЗарегистрироватьКоманду(ОпределениеСАргументом("Каталог", "OUT", "compile", , , Обязательность()));

	// Когда
	Сервис.Заполнить(Команда);

	// Тогда
	Ожидаем.Что(Команда.Каталог).Равно("./build/1cv8.cf");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПринятьОбязательныйАргумент_ЗаполненныйИзНастроек() Экспорт

	// Дано
	ЗарегистрироватьКоманду(ОпределениеСАргументом("Каталог", "OUT", "compile", , , Обязательность()));
	Поделка.СДеталькой("vrunner.compile.OUT", "./build/1cv8.cf");

	// Когда
	Сервис.Заполнить(Команда);

	// Тогда
	Ожидаем.Что(Команда.Каталог).Равно("./build/1cv8.cf");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПодсказатьВсеСпособыЗадатьАргумент_ЕслиОнНеЗадан() Экспорт

	// Дано
	ЗарегистрироватьРодителя("КомандаCf", "cf");
	ЗарегистрироватьКоманду(
		ОпределениеСАргументом("Каталог", "OUT", "compile", "КомандаCf", "VRUNNER_CF_OUT", Обязательность()));

	// Когда / Тогда
	Ожидаем.Что(Сервис).Метод("Заполнить", ТестовыеДанные.Массив(Команда))
		.ВыбрасываетИсключение("Не задан обязательный аргумент OUT")
		.ВыбрасываетИсключение("в командной строке")
		.ВыбрасываетИсключение("переменной окружения VRUNNER_CF_OUT")
		.ВыбрасываетИсключение("ключом vrunner.cf.compile.out в файле настроек");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеУпоминатьПеременнуюОкружения_ЕслиОнаНеОбъявлена() Экспорт

	// Дано
	ЗарегистрироватьКоманду(ОпределениеСАргументом("Каталог", "OUT", "compile", , , Обязательность()));

	// Когда / Тогда - подсказка без переменной окружения
	Попытка
		Сервис.Заполнить(Команда);
		Ожидаем.Что(Ложь, "ожидали исключение").ЭтоИстина();
	Исключение
		Текст = ОписаниеОшибки();
		Ожидаем.Что(СтрНайти(Текст, "переменной окружения")).Равно(0);
		Ожидаем.Что(Текст).Содержит("Укажите его в командной строке или ключом vrunner.compile.out");
	КонецПопытки;

КонецПроцедуры

// Обращение пользователя: extension-name задан только в autumn-properties.json, а команда
// падала на разборе командной строки. Парсер опцию больше не требует, значение приходит из настроек.
&Тест
Процедура ТестДолжен_ПринятьОбязательнуюОпцию_ЗаполненнуюИзНастроек() Экспорт

	// Дано
	ЗарегистрироватьКоманду(ОпределениеСОпцией("Каталог", "extension-name", , , Обязательность()));
	Поделка.СДеталькой("vrunner.load.extension-name", "МоёРасширение");

	// Когда
	Сервис.Заполнить(Команда);

	// Тогда
	Ожидаем.Что(Команда.Каталог).Равно("МоёРасширение");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПодсказатьВсеСпособыЗадатьОпцию_ЕслиОнаНеЗадана() Экспорт

	// Дано
	ЗарегистрироватьРодителя("КомандаCfe", "cfe");
	ЗарегистрироватьКоманду(
		ОпределениеСОпцией("Каталог", "extension-name", "КомандаCfe", "VRUNNER_EXTENSION_NAME", Обязательность()));

	// Когда / Тогда
	Ожидаем.Что(Сервис).Метод("Заполнить", ТестовыеДанные.Массив(Команда))
		.ВыбрасываетИсключение("Не задана обязательная опция --extension-name")
		.ВыбрасываетИсключение("в командной строке")
		.ВыбрасываетИсключение("переменной окружения VRUNNER_EXTENSION_NAME")
		.ВыбрасываетИсключение("ключом vrunner.cfe.load.extension-name в файле настроек");

КонецПроцедуры

