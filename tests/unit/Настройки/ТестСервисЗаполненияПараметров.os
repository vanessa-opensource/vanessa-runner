#Область ФлаговыеОпции

&Тест
Процедура ТестДолжен_РаспознатьИстину_ВСтроковомЗначенииФлага() Экспорт

	Команда.Тихо = "";
	ЗарегистрироватьКоманду("load", ОпределениеСФлагом("Тихо", "quiet q"));
	Поделка.СДеталькой("vrunner.load.quiet", "да");

