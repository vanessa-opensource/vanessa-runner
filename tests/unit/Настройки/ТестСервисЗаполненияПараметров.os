#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Регистрирует объект Команда в Поделке под прозвищем КомандаПриложения.
Процедура ЗарегистрироватьКоманду(Знач Определение)
	Поделка.СЖелудем("КомандаПриложения", Команда, Определение);
КонецПроцедуры

// Регистрирует родительскую команду под именем желудя.
Процедура ЗарегистрироватьРодителя(Знач ИмяЖелудя, Знач ИмяКоманды)
	Определение = Новый ОпределениеЖелудяСтаб().СКонструктором(АннотацииКоманды(ИмяКоманды));
	Поделка.СЖелудем(ИмяЖелудя, Новый КомандаОпцийСтаб, Определение);
КонецПроцедуры

// Регистрирует команду load с единственным полем-набором опций и возвращает объект набора.
Функция ЗарегистрироватьКомандуСНабором(Знач ОпределениеНабора)
	НаборОпций = Новый КомандаОпцийСтаб;
	Команда.Набор = НаборОпций;

	АннотацииНабора = ТестовыеДанные.Массив(Аннотация("НаборОпций", Параметр(Неопределено, "НаборПодключения")));
	ЗарегистрироватьКоманду(Определение("load", "Набор", АннотацииНабора));
	Поделка.СЖелудем("НаборПодключения", НаборОпций, ОпределениеНабора);

	Возврат НаборОпций;
КонецФункции

// Определение команды с одним аннотированным свойством.
Функция Определение(Знач ИмяКоманды, Знач ИмяСвойства, Знач Аннотации, Знач ИмяРодителя = "")
	Возврат Новый ОпределениеЖелудяСтаб()
		.СоСвойством(ИмяСвойства, Аннотации)
		.СКонструктором(АннотацииКоманды(ИмяКоманды, ИмяРодителя));
КонецФункции

Функция ОпределениеСОпцией(Знач ИмяСвойства, Знач ИмяОпции, Знач ИмяРодителя = "", Знач ПеременнаяОкружения = "",
		Знач ДополнительныеАннотации = Неопределено)
	Аннотации = АннотацииПараметра("Опция", ИмяОпции, ПеременнаяОкружения, ДополнительныеАннотации);
	Возврат Определение("load", ИмяСвойства, Аннотации, ИмяРодителя);
КонецФункции

Функция ОпределениеСАргументом(Знач ИмяСвойства, Знач ИмяАргумента, Знач ИмяКоманды, Знач ИмяРодителя = "",
		Знач ПеременнаяОкружения = "", Знач ДополнительныеАннотации = Неопределено)
	Аннотации = АннотацииПараметра("Аргумент", ИмяАргумента, ПеременнаяОкружения, ДополнительныеАннотации);
	Возврат Определение(ИмяКоманды, ИмяСвойства, Аннотации, ИмяРодителя);
КонецФункции

Функция ОпределениеСФлагом(Знач ИмяСвойства, Знач ИмяОпции)
	Аннотации = ТестовыеДанные.Массив(Аннотация("Опция", Параметр("Имя", ИмяОпции)), Аннотация("Флаговый"));
	Возврат Определение("load", ИмяСвойства, Аннотации);
КонецФункции

// Аннотации свойства: &Опция/&Аргумент с именем, при необходимости &ВОкружении и дополнительные.
Функция АннотацииПараметра(Знач Вид, Знач Имя, Знач ПеременнаяОкружения, Знач Дополнительные)
	Аннотации = ТестовыеДанные.Массив(Аннотация(Вид, Параметр("Имя", Имя)));
	Если ЗначениеЗаполнено(ПеременнаяОкружения) Тогда
		Аннотации.Добавить(Аннотация("ВОкружении", Параметр(Неопределено, ПеременнаяОкружения)));
	КонецЕсли;
	ДополнитьАннотации(Аннотации, Дополнительные);
	Возврат Аннотации;
КонецФункции

Процедура ДополнитьАннотации(Аннотации, Знач Дополнительные)
	Если Дополнительные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого ТекущаяАннотация Из Дополнительные Цикл
		Аннотации.Добавить(ТекущаяАннотация);
	КонецЦикла;
КонецПроцедуры

// Композит &ОбязательныйПослеЗаполнения развёрнут: в таблице свойства лежат обе аннотации.
Функция Обязательность()
	Возврат ТестовыеДанные.Массив(
		Аннотация("ОбязательныйПослеЗаполнения"),
		Аннотация("Обязательный", Параметр(Неопределено, Ложь)));
КонецФункции

Функция Расширение(Знач ОжидаемоеРасширение)
	Возврат ТестовыеДанные.Массив(Аннотация("РасширениеФайла", Параметр(Неопределено, ОжидаемоеРасширение)));
КонецФункции

Функция СуществующийФайл(Знач ШаблонСообщения = "")
	Возврат ТестовыеДанные.Массив(Аннотация("СуществующийФайл",
		?(ЗначениеЗаполнено(ШаблонСообщения), Параметр(Неопределено, ШаблонСообщения), Неопределено)));
КонецФункции

Функция АннотацииКоманды(Знач ИмяКоманды, Знач ИмяРодителя = "")
	Параметры = ТестовыеДанные.Массив(Параметр("Имя", ИмяКоманды));
	Если ЗначениеЗаполнено(ИмяРодителя) Тогда
		Параметры.Добавить(Параметр("Родитель", ИмяРодителя));
	КонецЕсли;
	Возврат ТестовыеДанные.Массив(Новый Структура("Имя, Параметры", "КомандаПриложения", Параметры));
КонецФункции

Функция Аннотация(Знач Имя, Знач ЕдинственныйПараметр = Неопределено)
	Параметры = Новый Массив;
	Если ЕдинственныйПараметр <> Неопределено Тогда
		Параметры.Добавить(ЕдинственныйПараметр);
	КонецЕсли;
	Возврат Новый Структура("Имя, Параметры", Имя, Параметры);
КонецФункции

Функция Параметр(Знач Имя, Знач Значение)
	Возврат Новый Структура("Имя, Значение", Имя, Значение);
КонецФункции

#КонецОбласти
