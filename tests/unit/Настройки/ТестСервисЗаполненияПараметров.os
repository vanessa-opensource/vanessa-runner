// Порядок проверок одного поля: сначала обязательность, потом формат значения.
&Тест
Процедура ТестДолжен_СообщитьОбОбязательности_РаньшеЧемОРасширении() Экспорт

	Аннотации = Обязательность();
	Аннотации.Добавить(Аннотация("РасширениеФайла", Параметр(Неопределено, ".cf")));
	ЗарегистрироватьКоманду(ОпределениеСАргументом("Каталог", "OUT", "unload", , , Аннотации));

	Ожидаем.Что(Сервис).Метод("Заполнить", ТестовыеДанные.Массив(Команда))
		.ВыбрасываетИсключение("Не задан обязательный аргумент OUT");

КонецПроцедуры

// Обязательность проверяется по всем полям раньше значений: незаданный параметр важнее
// для пользователя, чем неверное значение соседнего поля, объявленного выше.
&Тест
Процедура ТестДолжен_СообщитьОбОбязательности_РаньшеЧемОФайлеСоседнегоПоля() Экспорт

	// Дано - поле с несуществующим файлом объявлено раньше незаполненного обязательного
	Команда.Подключение = "./нет-такого.cfe";
	АннотацииФайла = ТестовыеДанные.Массив(Аннотация("Опция", Параметр("Имя", "cfe-file")), Аннотация("СуществующийФайл"));
	АннотацииИмени = ТестовыеДанные.Массив(Аннотация("Опция", Параметр("Имя", "extension-name")));
	ДополнитьАннотации(АннотацииИмени, Обязательность());
	ЗарегистрироватьКоманду(Определение("decompile", "Подключение", АннотацииФайла).СоСвойством("Каталог", АннотацииИмени));

	// Когда / Тогда
	Ожидаем.Что(Сервис).Метод("Заполнить", ТестовыеДанные.Массив(Команда))
		.ВыбрасываетИсключение("Не задана обязательная опция --extension-name");

КонецПроцедуры

