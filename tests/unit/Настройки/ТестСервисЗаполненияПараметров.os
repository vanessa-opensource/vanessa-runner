// Порядок проверок одного поля: сначала обязательность, потом формат значения.
&Тест
Процедура ТестДолжен_СообщитьОбОбязательности_РаньшеЧемОРасширении() Экспорт

	Аннотации = Обязательность();
	Аннотации.Добавить(Аннотация("РасширениеФайла", Параметр(Неопределено, ".cf")));
	ЗарегистрироватьКоманду("unload", ОпределениеСАргументом("Каталог", "OUT", , , Аннотации));

	Попытка
		Сервис.Заполнить(Команда);
		Ожидаем.Что(Ложь, "ожидали исключение").ЭтоИстина();
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("Не задан обязательный аргумент OUT");
	КонецПопытки;

КонецПроцедуры

// Обязательность проверяется по всем полям раньше значений: незаданный параметр важнее
// для пользователя, чем неверное значение соседнего поля, объявленного выше.
&Тест
Процедура ТестДолжен_СообщитьОбОбязательности_РаньшеЧемОФайлеСоседнегоПоля() Экспорт

	Команда.Подключение = "./нет-такого.cfe";

	АннотацииФайла = Новый Массив;
	АннотацииФайла.Добавить(Аннотация("Опция", Параметр("Имя", "cfe-file")));
	АннотацииФайла.Добавить(Аннотация("СуществующийФайл"));
	АннотацииИмени = Новый Массив;
	АннотацииИмени.Добавить(Аннотация("Опция", Параметр("Имя", "extension-name")));
	ДополнитьАннотации(АннотацииИмени, Обязательность());

	ЗарегистрироватьКоманду("decompile", Новый ОпределениеЖелудяСтаб()
		.СоСвойством("Подключение", АннотацииФайла)
		.СоСвойством("Каталог", АннотацииИмени)
		.СКонструктором(АннотацииКоманды("decompile")));

	Попытка
		Сервис.Заполнить(Команда);
		Ожидаем.Что(Ложь, "ожидали исключение").ЭтоИстина();
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("Не задана обязательная опция --extension-name");
	КонецПопытки;

КонецПроцедуры

