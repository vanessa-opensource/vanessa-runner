// BSLLS-off
// Юнит-тесты СервисЗаполненияПараметров: заполнение пустых опций команды из настроек
// по аннотациям &Опция/&Аргумент/&Флаговый/&НаборОпций, путь команды по цепочке родителей.

#Использовать asserts
#Использовать reflector
#Использовать logos
#Использовать annotations

#Использовать "../../../src/core/Настройки"
#Использовать "../utils"

Перем Сервис;
Перем Поделка;
Перем Команда;
Перем Рефлектор;

#Область ЗаполнениеОпций

&Тест
Процедура ТестДолжен_ПропуститьНеопределенныйОбъектКоманды() Экспорт

	Сервис.Заполнить(Неопределено);

	Ожидаем.Что(Истина).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПропуститьЗаполнение_ЕслиОпределениеКомандыНеНайдено() Экспорт

	// Поделка пуста - желудь команды не зарегистрирован
	Сервис.Заполнить(Команда);

	Ожидаем.Что(Команда.Подключение).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗаполнитьПустуюОпцию_ИзНастроек() Экспорт

	ЗарегистрироватьКоманду("load", ОпределениеСОпцией("Подключение", "ibcmd i"));
	Поделка.СДеталькой("vrunner.load.ibcmd", "/opt/1cv8/ibcmd");

	Сервис.Заполнить(Команда);

	Ожидаем.Что(Команда.Подключение).Равно("/opt/1cv8/ibcmd");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОставитьЗаполненнуюОпцию_БезИзменений() Экспорт

	Команда.Подключение = "из-командной-строки";
	ЗарегистрироватьКоманду("load", ОпределениеСОпцией("Подключение", "ibcmd i"));
	Поделка.СДеталькой("vrunner.load.ibcmd", "из-настроек");

	Сервис.Заполнить(Команда);

	Ожидаем.Что(Команда.Подключение).Равно("из-командной-строки");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗаполнитьАргумент_ИзНастроек() Экспорт

	Аннотации = Новый Массив;
	Аннотации.Добавить(Аннотация("Аргумент", Параметр("Имя", "SRC")));
	Определение = Новый ОпределениеЖелудяСтаб()
		.СоСвойством("Каталог", Аннотации)
		.СКонструктором(АннотацииКоманды("decompile"));

	ЗарегистрироватьКоманду("decompile", Определение);
	Поделка.СДеталькой("vrunner.decompile.SRC", "./src/cf");

	Сервис.Заполнить(Команда);

	Ожидаем.Что(Команда.Каталог).Равно("./src/cf");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПропуститьОпциюБезИмени() Экспорт

	Аннотации = Новый Массив;
	Аннотации.Добавить(Аннотация("Опция"));
	Определение = Новый ОпределениеЖелудяСтаб()
		.СоСвойством("Подключение", Аннотации)
		.СКонструктором(АннотацииКоманды("load"));

	ЗарегистрироватьКоманду("load", Определение);

	Сервис.Заполнить(Команда);

	Ожидаем.Что(Команда.Подключение).Равно(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область ФлаговыеОпции

&Тест
Процедура ТестДолжен_РаспознатьИстину_ВСтроковомЗначенииФлага() Экспорт

	Команда.Тихо = "";
	ЗарегистрироватьКоманду("load", ОпределениеСФлагом("Тихо", "quiet q"));
	Поделка.СДеталькой("vrunner.load.quiet", "да");

	Сервис.Заполнить(Команда);

	Ожидаем.Что(Команда.Тихо).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПолучитьЛожь_ЕслиФлагВНастройкахНеЗадан() Экспорт

	// пустое значение флага нормализуется в типизированную Ложь
	Команда.Тихо = "";
	ЗарегистрироватьКоманду("load", ОпределениеСФлагом("Тихо", "quiet q"));

	Сервис.Заполнить(Команда);

	Ожидаем.Что(Команда.Тихо).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВзятьБулевоЗначениеФлага_КакЕсть() Экспорт

	// флаг с CLI приходит пустым ("" или Неопределено), булево значение живёт в настройках
	Команда.Тихо = "";
	ЗарегистрироватьКоманду("load", ОпределениеСФлагом("Тихо", "quiet q"));
	Поделка.СДеталькой("vrunner.load.quiet", Истина);

	Сервис.Заполнить(Команда);

	Ожидаем.Что(Команда.Тихо).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ПутьКомандыИВложенныеНаборы

&Тест
Процедура ТестДолжен_ПостроитьПутьКоманды_ПоЦепочкеРодителей() Экспорт

	ОпределениеРодителя = Новый ОпределениеЖелудяСтаб()
		.СКонструктором(АннотацииКоманды("cf"));
	Поделка.СЖелудем("КомандаCf", Новый КомандаОпцийСтаб, ОпределениеРодителя);

	ЗарегистрироватьКоманду("load", ОпределениеСОпцией("Подключение", "ibcmd i", "КомандаCf"));
	Поделка.СДеталькой("vrunner.cf.load.ibcmd", "по-полному-пути");

	Сервис.Заполнить(Команда);

	Ожидаем.Что(Команда.Подключение).Равно("по-полному-пути");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиНастройкуРодительскогоУровня_ДляПодкоманды() Экспорт

	ОпределениеРодителя = Новый ОпределениеЖелудяСтаб()
		.СКонструктором(АннотацииКоманды("cf"));
	Поделка.СЖелудем("КомандаCf", Новый КомандаОпцийСтаб, ОпределениеРодителя);

	ЗарегистрироватьКоманду("load", ОпределениеСОпцией("Подключение", "ibcmd i", "КомандаCf"));
	Поделка.СДеталькой("vrunner.cf.ibcmd", "уровень-cf");

	Сервис.Заполнить(Команда);

	Ожидаем.Что(Команда.Подключение).Равно("уровень-cf");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗаполнитьОпцииВложенногоНабора() Экспорт

	НаборОпций = Новый КомандаОпцийСтаб;
	Команда.Набор = НаборОпций;

	АннотацииНабора = Новый Массив;
	АннотацииНабора.Добавить(Аннотация("НаборОпций", Параметр(Неопределено, "НаборПодключения")));
	ОпределениеКоманды = Новый ОпределениеЖелудяСтаб()
		.СоСвойством("Набор", АннотацииНабора)
		.СКонструктором(АннотацииКоманды("load"));
	ЗарегистрироватьКоманду("load", ОпределениеКоманды);

	Поделка.СЖелудем("НаборПодключения", НаборОпций, ОпределениеСОпцией("Каталог", "src s"));
	Поделка.СДеталькой("vrunner.load.src", "./cfg-src");

	Сервис.Заполнить(Команда);

	Ожидаем.Что(НаборОпций.Каталог).Равно("./cfg-src");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт

	Поделка = Новый ПоделкаСтаб;
	Команда = Новый КомандаОпцийСтаб;
	Рефлектор = Новый Рефлектор;

	СервисНастроек = Новый СервисНастроек;
	Рефлектор.УстановитьСвойство(СервисНастроек, "Лог", Логирование.ПолучитьЛог("vrunner"));
	Рефлектор.УстановитьСвойство(СервисНастроек, "Поделка", Поделка);

	Сервис = Новый СервисЗаполненияПараметров;
	Рефлектор.УстановитьСвойство(Сервис, "Лог", Логирование.ПолучитьЛог("vrunner"));
	Рефлектор.УстановитьСвойство(Сервис, "Поделка", Поделка);
	Рефлектор.УстановитьСвойство(Сервис, "СервисНастроек", СервисНастроек);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Регистрирует объект Команда в Поделке под прозвищем КомандаПриложения.
Процедура ЗарегистрироватьКоманду(Знач ИмяКоманды, Знач Определение)
	Поделка.СЖелудем("КомандаПриложения", Команда, Определение);
КонецПроцедуры

Функция ОпределениеСОпцией(Знач ИмяСвойства, Знач ИмяОпции, Знач ИмяРодителя = "")
	Аннотации = Новый Массив;
	Аннотации.Добавить(Аннотация("Опция", Параметр("Имя", ИмяОпции)));
	Возврат Новый ОпределениеЖелудяСтаб()
		.СоСвойством(ИмяСвойства, Аннотации)
		.СКонструктором(АннотацииКоманды("load", ИмяРодителя));
КонецФункции

Функция ОпределениеСФлагом(Знач ИмяСвойства, Знач ИмяОпции)
	Аннотации = Новый Массив;
	Аннотации.Добавить(Аннотация("Опция", Параметр("Имя", ИмяОпции)));
	Аннотации.Добавить(Аннотация("Флаговый"));
	Возврат Новый ОпределениеЖелудяСтаб()
		.СоСвойством(ИмяСвойства, Аннотации)
		.СКонструктором(АннотацииКоманды("load"));
КонецФункции

Функция АннотацииКоманды(Знач ИмяКоманды, Знач ИмяРодителя = "")
	Параметры = Новый Массив;
	Параметры.Добавить(Параметр("Имя", ИмяКоманды));
	Если ЗначениеЗаполнено(ИмяРодителя) Тогда
		Параметры.Добавить(Параметр("Родитель", ИмяРодителя));
	КонецЕсли;
	Аннотации = Новый Массив;
	Аннотации.Добавить(Новый Структура("Имя, Параметры", "КомандаПриложения", Параметры));
	Возврат Аннотации;
КонецФункции

Функция Аннотация(Знач Имя, Знач ЕдинственныйПараметр = Неопределено)
	Параметры = Новый Массив;
	Если ЕдинственныйПараметр <> Неопределено Тогда
		Параметры.Добавить(ЕдинственныйПараметр);
	КонецЕсли;
	Возврат Новый Структура("Имя, Параметры", Имя, Параметры);
КонецФункции

Функция Параметр(Знач Имя, Знач Значение)
	Возврат Новый Структура("Имя, Значение", Имя, Значение);
КонецФункции

#КонецОбласти
