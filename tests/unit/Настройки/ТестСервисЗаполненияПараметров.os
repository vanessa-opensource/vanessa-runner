&Тест
Процедура ТестДолжен_ПроверитьОбязательноеПолеВложенногоНабора() Экспорт

	ЗарегистрироватьКомандуСНабором(ОпределениеСОпцией("Каталог", "src s", , , Обязательность()));

	Попытка
		Сервис.Заполнить(Команда);
		Ожидаем.Что(Ложь, "ожидали исключение").ЭтоИстина();
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("Не задана обязательная опция --src.");
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт

	Поделка = Новый ПоделкаСтаб;
	Команда = Новый КомандаОпцийСтаб;
	Рефлектор = Новый Рефлектор;

	СервисНастроек = Новый СервисНастроек;
	Рефлектор.УстановитьСвойство(СервисНастроек, "Лог", Логирование.ПолучитьЛог("vrunner"));
	Рефлектор.УстановитьСвойство(СервисНастроек, "Поделка", Поделка);

	Сервис = Новый СервисЗаполненияПараметров;
	Рефлектор.УстановитьСвойство(Сервис, "Лог", Логирование.ПолучитьЛог("vrunner"));
	Рефлектор.УстановитьСвойство(Сервис, "Поделка", Поделка);
	Рефлектор.УстановитьСвойство(Сервис, "СервисНастроек", СервисНастроек);
	Рефлектор.УстановитьСвойство(Сервис, "ФайловыеОперации", Новый БилдерФайловыхОпераций().Собрать());

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Регистрирует объект Команда в Поделке под прозвищем КомандаПриложения.
Процедура ЗарегистрироватьКоманду(Знач ИмяКоманды, Знач Определение)
	Поделка.СЖелудем("КомандаПриложения", Команда, Определение);
КонецПроцедуры

// Регистрирует команду load с единственным полем-набором опций и возвращает объект набора.
Функция ЗарегистрироватьКомандуСНабором(Знач ОпределениеНабора)
	НаборОпций = Новый КомандаОпцийСтаб;
	Команда.Набор = НаборОпций;

	АннотацииНабора = Новый Массив;
	АннотацииНабора.Добавить(Аннотация("НаборОпций", Параметр(Неопределено, "НаборПодключения")));
	ОпределениеКоманды = Новый ОпределениеЖелудяСтаб()
		.СоСвойством("Набор", АннотацииНабора)
		.СКонструктором(АннотацииКоманды("load"));

	ЗарегистрироватьКоманду("load", ОпределениеКоманды);
	Поделка.СЖелудем("НаборПодключения", НаборОпций, ОпределениеНабора);

	Возврат НаборОпций;
КонецФункции

Функция ОпределениеСОпцией(Знач ИмяСвойства, Знач ИмяОпции, Знач ИмяРодителя = "", Знач ПеременнаяОкружения = "",
		Знач ДополнительныеАннотации = Неопределено)
	Аннотации = Новый Массив;
	Аннотации.Добавить(Аннотация("Опция", Параметр("Имя", ИмяОпции)));
	Если ЗначениеЗаполнено(ПеременнаяОкружения) Тогда
		Аннотации.Добавить(Аннотация("ВОкружении", Параметр(Неопределено, ПеременнаяОкружения)));
	КонецЕсли;
	ДополнитьАннотации(Аннотации, ДополнительныеАннотации);
	Возврат Новый ОпределениеЖелудяСтаб()
		.СоСвойством(ИмяСвойства, Аннотации)
		.СКонструктором(АннотацииКоманды("load", ИмяРодителя));
КонецФункции

Функция ОпределениеСАргументом(Знач ИмяСвойства, Знач ИмяАргумента, Знач ИмяРодителя = "",
		Знач ПеременнаяОкружения = "", Знач ДополнительныеАннотации = Неопределено)
	Аннотации = Новый Массив;
	Аннотации.Добавить(Аннотация("Аргумент", Параметр("Имя", ИмяАргумента)));
	Если ЗначениеЗаполнено(ПеременнаяОкружения) Тогда
		Аннотации.Добавить(Аннотация("ВОкружении", Параметр(Неопределено, ПеременнаяОкружения)));
	КонецЕсли;
	ДополнитьАннотации(Аннотации, ДополнительныеАннотации);
	Возврат Новый ОпределениеЖелудяСтаб()
		.СоСвойством(ИмяСвойства, Аннотации)
		.СКонструктором(АннотацииКоманды("compile", ИмяРодителя));
КонецФункции

Функция ОпределениеСФлагом(Знач ИмяСвойства, Знач ИмяОпции)
	Аннотации = Новый Массив;
	Аннотации.Добавить(Аннотация("Опция", Параметр("Имя", ИмяОпции)));
	Аннотации.Добавить(Аннотация("Флаговый"));
	Возврат Новый ОпределениеЖелудяСтаб()
		.СоСвойством(ИмяСвойства, Аннотации)
		.СКонструктором(АннотацииКоманды("load"));
КонецФункции

Процедура ДополнитьАннотации(Аннотации, Знач Дополнительные)
	Если Дополнительные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого ТекущаяАннотация Из Дополнительные Цикл
		Аннотации.Добавить(ТекущаяАннотация);
	КонецЦикла;
КонецПроцедуры

// Композит &ОбязательныйПослеЗаполнения развёрнут: в таблице свойства лежат обе аннотации.
Функция Обязательность()
	Аннотации = Новый Массив;
	Аннотации.Добавить(Аннотация("ОбязательныйПослеЗаполнения"));
	Аннотации.Добавить(Аннотация("Обязательный", Параметр(Неопределено, Ложь)));
	Возврат Аннотации;
КонецФункции

Функция Расширение(Знач ОжидаемоеРасширение)
	Аннотации = Новый Массив;
	Аннотации.Добавить(Аннотация("РасширениеФайла", Параметр(Неопределено, ОжидаемоеРасширение)));
	Возврат Аннотации;
КонецФункции

Функция СуществующийФайл(Знач ШаблонСообщения = "")
	Аннотации = Новый Массив;
	Аннотации.Добавить(Аннотация("СуществующийФайл",
		?(ЗначениеЗаполнено(ШаблонСообщения), Параметр(Неопределено, ШаблонСообщения), Неопределено)));
	Возврат Аннотации;
КонецФункции

Функция АннотацииКоманды(Знач ИмяКоманды, Знач ИмяРодителя = "")
	Параметры = Новый Массив;
	Параметры.Добавить(Параметр("Имя", ИмяКоманды));
	Если ЗначениеЗаполнено(ИмяРодителя) Тогда
		Параметры.Добавить(Параметр("Родитель", ИмяРодителя));
	КонецЕсли;
	Аннотации = Новый Массив;
	Аннотации.Добавить(Новый Структура("Имя, Параметры", "КомандаПриложения", Параметры));
	Возврат Аннотации;
КонецФункции

Функция Аннотация(Знач Имя, Знач ЕдинственныйПараметр = Неопределено)
	Параметры = Новый Массив;
	Если ЕдинственныйПараметр <> Неопределено Тогда
		Параметры.Добавить(ЕдинственныйПараметр);
	КонецЕсли;
	Возврат Новый Структура("Имя, Параметры", Имя, Параметры);
КонецФункции

Функция Параметр(Знач Имя, Знач Значение)
	Возврат Новый Структура("Имя, Значение", Имя, Значение);
КонецФункции

#КонецОбласти
