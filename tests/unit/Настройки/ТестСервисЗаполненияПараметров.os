КонецПроцедуры

&Тест
Процедура ТестДолжен_ВзятьБулевоЗначениеФлага_КакЕсть() Экспорт

	// флаг с CLI приходит пустым ("" или Неопределено), булево значение живёт в настройках
	Команда.Тихо = "";
	ЗарегистрироватьКоманду("load", ОпределениеСФлагом("Тихо", "quiet q"));
	Поделка.СДеталькой("vrunner.load.quiet", Истина);

	Сервис.Заполнить(Команда);

	Ожидаем.Что(Команда.Тихо).ЭтоИстина();

