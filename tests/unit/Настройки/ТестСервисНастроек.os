// BSLLS-off
// Юнит-тесты СервисНастроек: каскадное разрешение ключей настроек по пути команды.

#Использовать asserts
#Использовать reflector
#Использовать logos
// annotations нужен пакету Настройки на компиляции (РаботаСАннотациями)
#Использовать annotations

#Использовать "../../../src/core/Настройки"
#Использовать "../utils"

Перем Сервис;
Перем Поделка;

#Область Разрешить

&Тест
Процедура ТестДолжен_НайтиСамыйСпецифичныйКлюч() Экспорт

	Поделка
		.СДеталькой("vrunner.cf.load.ibcmd", "специфичный")
		.СДеталькой("vrunner.cf.ibcmd", "средний")
		.СДеталькой("vrunner.ibcmd", "корневой");

	Ожидаем.Что(Сервис.Разрешить("ibcmd", ПутьКоманды("cf,load"))).Равно("специфичный");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПоднятьсяНаУровеньВыше_ЕслиСпецифичногоНет() Экспорт

	Поделка
		.СДеталькой("vrunner.cf.ibcmd", "средний")
		.СДеталькой("vrunner.ibcmd", "корневой");

	Ожидаем.Что(Сервис.Разрешить("ibcmd", ПутьКоманды("cf,load"))).Равно("средний");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ДойтиДоКорневогоКлюча() Экспорт

	Поделка.СДеталькой("vrunner.ibcmd", "корневой");

	Ожидаем.Что(Сервис.Разрешить("ibcmd", ПутьКоманды("cf,load"))).Равно("корневой");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьУмолчание_ЕслиНичегоНеНайдено() Экспорт

	Ожидаем.Что(Сервис.Разрешить("ibcmd", ПутьКоманды("cf,load"), "умолчание")).Равно("умолчание");

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазрешитьКлючДляПустогоПутиКоманды() Экспорт

	Поделка.СДеталькой("vrunner.v8version", "8.3.25");

	Ожидаем.Что(Сервис.Разрешить("v8version", Новый Массив)).Равно("8.3.25");

КонецПроцедуры

#КонецОбласти

#Область РазрешитьВсе

&Тест
Процедура ТестДолжен_ЗаполнитьТолькоПустыеОпции() Экспорт

	Поделка
		.СДеталькой("vrunner.cf.src", "из-настроек")
		.СДеталькой("vrunner.cf.ibcmd", "не-должно-попасть");

	Опции = Новый Соответствие;
	Опции.Вставить("src", "");
	Опции.Вставить("ibcmd", "из-командной-строки");

	Результат = Сервис.РазрешитьВсе(Опции, ПутьКоманды("cf"));

	Ожидаем.Что(Результат.Получить("src")).Равно("из-настроек");
	Ожидаем.Что(Результат.Получить("ibcmd"), "заполненное значение не перетирается").Равно("из-командной-строки");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОставитьПустоеЗначение_ЕслиНастройкиНет() Экспорт

	Опции = Новый Соответствие;
	Опции.Вставить("src", "");

	Результат = Сервис.РазрешитьВсе(Опции, ПутьКоманды("cf"));

	Ожидаем.Что(Результат.Получить("src")).Равно("");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	Поделка = Новый ПоделкаСтаб;
	Сервис = Новый СервисНастроек;
	Рефлектор = Новый Рефлектор;
	Рефлектор.УстановитьСвойство(Сервис, "Лог", Логирование.ПолучитьЛог("vrunner"));
	Рефлектор.УстановитьСвойство(Сервис, "Поделка", Поделка);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПутьКоманды(Знач СтрокаСегментов)
	Возврат СтрРазделить(СтрокаСегментов, ",");
КонецФункции

#КонецОбласти
