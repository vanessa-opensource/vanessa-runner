// BSLLS-off
// Юнит-тесты СервисНастроек: каскадное разрешение ключей настроек по пути команды.
// Детальки берутся из ПоделкаСтаб.

#Использовать asserts
#Использовать "../utils"

Перем Стенд;
Перем Сервис;
Перем Поделка; // ПоделкаСтаб: детальки настроек

&ПередКаждым
Процедура ПередКаждым() Экспорт
	Стенд = Новый Стенд;
	Поделка = Стенд.Подменить("Поделка", Новый ПоделкаСтаб);
	Сервис = Стенд.Сервис("СервисНастроек");
КонецПроцедуры

#Область Разрешить

&Тест
Процедура ТестДолжен_НайтиСамыйСпецифичныйКлюч() Экспорт

	Поделка
		.СДеталькой("vrunner.cf.load.ibcmd", "специфичный")
		.СДеталькой("vrunner.cf.ibcmd", "средний")
		.СДеталькой("vrunner.ibcmd", "корневой");

	Ожидаем.Что(Сервис.Разрешить("ibcmd", ПутьКоманды("cf,load"))).Равно("специфичный");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПоднятьсяНаУровеньВыше_ЕслиСпецифичногоНет() Экспорт

	Поделка
		.СДеталькой("vrunner.cf.ibcmd", "средний")
		.СДеталькой("vrunner.ibcmd", "корневой");

	Ожидаем.Что(Сервис.Разрешить("ibcmd", ПутьКоманды("cf,load"))).Равно("средний");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ДойтиДоКорневогоКлюча() Экспорт

	Поделка.СДеталькой("vrunner.ibcmd", "корневой");

	Ожидаем.Что(Сервис.Разрешить("ibcmd", ПутьКоманды("cf,load"))).Равно("корневой");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьУмолчание_ЕслиНичегоНеНайдено() Экспорт

	Ожидаем.Что(Сервис.Разрешить("ibcmd", ПутьКоманды("cf,load"), "умолчание")).Равно("умолчание");

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазрешитьКлючДляПустогоПутиКоманды() Экспорт

	Поделка.СДеталькой("vrunner.v8version", "8.3.25");

	Ожидаем.Что(Сервис.Разрешить("v8version", Новый Массив)).Равно("8.3.25");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПутьКоманды(Знач СтрокаСегментов)
	Возврат СтрРазделить(СтрокаСегментов, ",");
КонецФункции

#КонецОбласти
