// BSLLS-off
// Юнит-тесты ФайловыеОперации: поиск файла по шаблону версии $version.

#Использовать asserts
#Использовать tempfiles
#Использовать reflector
#Использовать logos

#Использовать "../../../src/core/Файлы"

Перем Операции;
Перем НакопленныеВременныеФайлы;

#Область ВыборИменПоШаблону

&Тест
Процедура ТестДолжен_ВернутьПустойМассив_ЕслиНичегоНеПодошло() Экспорт

	Имена = НовыеИмена("readme.txt, 1cv8.cf, 1cv8_не_версия.cfu");

	Результат = Операции.ВыбратьИменаПоШаблонуВерсии("1cv8_$version.cfu", Имена);

	Ожидаем.Что(Результат.Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиЕдинственныйПодходящийФайл() Экспорт

	Имена = НовыеИмена("readme.txt, 1cv8_8.3.25.100.cfu, 1cv8_8.3.25.100.cf");

	Результат = Операции.ВыбратьИменаПоШаблонуВерсии("1cv8_$version.cfu", Имена);

	Ожидаем.Что(Результат.Количество()).Равно(1);
	Ожидаем.Что(Результат[0]).Равно("1cv8_8.3.25.100.cfu");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыбратьСтаршуюВерсию_ЧисленноПоСегментам() Экспорт

	// лексикографически 8.3.9 > 8.3.10, численно - наоборот
	Имена = НовыеИмена("1cv8_8.3.9.500.cfu, 1cv8_8.3.10.200.cfu, 1cv8_8.3.10.90.cfu");

	Результат = Операции.ВыбратьИменаПоШаблонуВерсии("1cv8_$version.cfu", Имена);

	Ожидаем.Что(Результат.Количество()).Равно(3);
	Ожидаем.Что(Результат[0], "старшая версия - первая").Равно("1cv8_8.3.10.200.cfu");
	Ожидаем.Что(Результат[2], "младшая версия - последняя").Равно("1cv8_8.3.9.500.cfu");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СчитатьЧетырехсегментнуюВерсиюСтаршеТрехсегментной() Экспорт

	Имена = НовыеИмена("app_1.2.3.cf, app_1.2.3.1.cf");

	Результат = Операции.ВыбратьИменаПоШаблонуВерсии("app_$version.cf", Имена);

	Ожидаем.Что(Результат[0]).Равно("app_1.2.3.1.cf");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПониматьЦифрыСТочками_ВФиксированнойЧастиШаблона() Экспорт

	// в 2.x такой шаблон ломался: из имени выдёргивалась первая похожая на версию подстрока (8.3...)
	Имена = НовыеИмена("update_v8.3_1.0.2.5.cfu, update_v8.3_1.0.10.1.cfu");

	Результат = Операции.ВыбратьИменаПоШаблонуВерсии("update_v8.3_$version.cfu", Имена);

	Ожидаем.Что(Результат.Количество()).Равно(2);
	Ожидаем.Что(Результат[0]).Равно("update_v8.3_1.0.10.1.cfu");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ТребоватьПолногоСовпаденияИмениСШаблоном() Экспорт

	Имена = НовыеИмена("1cv8_8.3.25.100.cfu.bak, prefix_1cv8_8.3.25.100.cfu");

	Результат = Операции.ВыбратьИменаПоШаблонуВерсии("1cv8_$version.cfu", Имена);

	Ожидаем.Что(Результат.Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЭкранироватьСпецсимволыШаблона() Экспорт

	Имена = НовыеИмена("релиз (final)_1.0.0.0.cf, релиз xfinalx_1.0.0.1.cf");

	Результат = Операции.ВыбратьИменаПоШаблонуВерсии("релиз (final)_$version.cf", Имена);

	Ожидаем.Что(Результат.Количество()).Равно(1);
	Ожидаем.Что(Результат[0]).Равно("релиз (final)_1.0.0.0.cf");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ТребоватьОдинаковуюВерсию_ДляПовторныхВхожденийШаблона() Экспорт

	Имена = НовыеИмена("app_1.0.0.0_copy_1.0.0.0.cf, app_1.0.0.0_copy_2.0.0.0.cf");

	Результат = Операции.ВыбратьИменаПоШаблонуВерсии("app_$version_copy_$version.cf", Имена);

	Ожидаем.Что(Результат.Количество()).Равно(1);
	Ожидаем.Что(Результат[0]).Равно("app_1.0.0.0_copy_1.0.0.0.cf");

КонецПроцедуры

#КонецОбласти

#Область ПоискФайлаПоШаблону

&Тест
Процедура ТестДолжен_ВернутьПутьКакЕсть_ЕслиШаблонаНет() Экспорт

	Ожидаем.Что(Операции.НайтиФайлПоШаблонуВерсии("./updates/1cv8.cfu")).Равно("./updates/1cv8.cfu");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиВКаталоге_ФайлСоСтаршейВерсией() Экспорт

	Каталог = ВременныеФайлы.СоздатьКаталог();
	СоздатьПустойФайл(Каталог, "1cv8_1.0.9.0.cfu");
	СоздатьПустойФайл(Каталог, "1cv8_1.0.10.0.cfu");
	СоздатьПустойФайл(Каталог, "1cv8_1.0.10.0.cf");

	Результат = Операции.НайтиФайлПоШаблонуВерсии(ОбъединитьПути(Каталог, "1cv8_$version.cfu"));

	Ожидаем.Что(Результат).Равно(ОбъединитьПути(Каталог, "1cv8_1.0.10.0.cfu"));

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыброситьОшибку_ЕслиФайлПоШаблонуНеНайден() Экспорт

	Каталог = ВременныеФайлы.СоздатьКаталог();
	СоздатьПустойФайл(Каталог, "readme.txt");

	Попытка
		Операции.НайтиФайлПоШаблонуВерсии(ОбъединитьПути(Каталог, "1cv8_$version.cfu"));
		Ожидаем.Что(Ложь, "ожидали исключение").ЭтоИстина();
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("Не найден файл по шаблону версии");
	КонецПопытки;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыброситьОшибку_ЕслиШаблонВКаталогеПути() Экспорт

	Попытка
		Операции.НайтиФайлПоШаблонуВерсии(ОбъединитьПути("updates_$version", "1cv8.cfu"));
		Ожидаем.Что(Ложь, "ожидали исключение").ЭтоИстина();
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("только в имени файла");
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
	Операции = Новый ФайловыеОперации;
	Рефлектор = Новый Рефлектор;
	Рефлектор.УстановитьСвойство(Операции, "Лог", Логирование.ПолучитьЛог("vrunner"));
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыеИмена(Знач СтрокаИмен)
	Имена = Новый Массив;
	Для Каждого Имя Из СтрРазделить(СтрокаИмен, ",") Цикл
		Имена.Добавить(СокрЛП(Имя));
	КонецЦикла;
	Возврат Имена;
КонецФункции

Процедура СоздатьПустойФайл(Знач Каталог, Знач Имя)
	Запись = Новый ЗаписьТекста(ОбъединитьПути(Каталог, Имя));
	Запись.Закрыть();
КонецПроцедуры

#КонецОбласти
