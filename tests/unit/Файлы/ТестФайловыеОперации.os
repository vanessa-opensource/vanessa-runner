// BSLLS-off
// Юнит-тесты ФайловыеОперации: поиск файла по шаблону версии $version, разыменование путей,
// обеспечение и безопасное удаление каталогов. Файловая система настоящая - она и есть предмет теста.

#Использовать asserts
#Использовать tempfiles
#Использовать "../utils"

Перем Операции;

&ПередКаждым
Процедура ПередКаждым() Экспорт
	Операции = Новый Стенд().Сервис("ФайловыеОперации");
КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт
	ВременныеФайлы.Удалить();
КонецПроцедуры

#Область ВыбратьИменаПоШаблонуВерсии

&Тест
Процедура ТестДолжен_ВернутьПустойМассив_ЕслиНичегоНеПодошло() Экспорт

	Имена = ТестовыеДанные.Массив("readme.txt", "1cv8.cf", "1cv8_не_версия.cfu");

	Результат = Операции.ВыбратьИменаПоШаблонуВерсии("1cv8_$version.cfu", Имена);

	Ожидаем.Что(Результат.Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиЕдинственныйПодходящийФайл() Экспорт

	Имена = ТестовыеДанные.Массив("readme.txt", "1cv8_8.3.25.100.cfu", "1cv8_8.3.25.100.cf");

	Результат = Операции.ВыбратьИменаПоШаблонуВерсии("1cv8_$version.cfu", Имена);

	Ожидаем.Что(Результат.Количество()).Равно(1);
	Ожидаем.Что(Результат[0]).Равно("1cv8_8.3.25.100.cfu");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыбратьСтаршуюВерсию_ЧисленноПоСегментам() Экспорт

	// лексикографически 8.3.9 > 8.3.10, численно - наоборот
	Имена = ТестовыеДанные.Массив("1cv8_8.3.9.500.cfu", "1cv8_8.3.10.200.cfu", "1cv8_8.3.10.90.cfu");

	Результат = Операции.ВыбратьИменаПоШаблонуВерсии("1cv8_$version.cfu", Имена);

	Ожидаем.Что(Результат.Количество()).Равно(3);
	Ожидаем.Что(Результат[0], "старшая версия - первая").Равно("1cv8_8.3.10.200.cfu");
	Ожидаем.Что(Результат[2], "младшая версия - последняя").Равно("1cv8_8.3.9.500.cfu");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СчитатьЧетырехсегментнуюВерсиюСтаршеТрехсегментной() Экспорт

	Имена = ТестовыеДанные.Массив("app_1.2.3.cf", "app_1.2.3.1.cf");

	Результат = Операции.ВыбратьИменаПоШаблонуВерсии("app_$version.cf", Имена);

	Ожидаем.Что(Результат[0]).Равно("app_1.2.3.1.cf");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПониматьЦифрыСТочками_ВФиксированнойЧастиШаблона() Экспорт

	// в 2.x такой шаблон ломался: из имени выдёргивалась первая похожая на версию подстрока (8.3...)
	Имена = ТестовыеДанные.Массив("update_v8.3_1.0.2.5.cfu", "update_v8.3_1.0.10.1.cfu");

	Результат = Операции.ВыбратьИменаПоШаблонуВерсии("update_v8.3_$version.cfu", Имена);

	Ожидаем.Что(Результат.Количество()).Равно(2);
	Ожидаем.Что(Результат[0]).Равно("update_v8.3_1.0.10.1.cfu");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ТребоватьПолногоСовпаденияИмениСШаблоном() Экспорт

	Имена = ТестовыеДанные.Массив("1cv8_8.3.25.100.cfu.bak", "prefix_1cv8_8.3.25.100.cfu");

	Результат = Операции.ВыбратьИменаПоШаблонуВерсии("1cv8_$version.cfu", Имена);

	Ожидаем.Что(Результат.Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЭкранироватьСпецсимволыШаблона() Экспорт

	Имена = ТестовыеДанные.Массив("релиз (final)_1.0.0.0.cf", "релиз xfinalx_1.0.0.1.cf");

	Результат = Операции.ВыбратьИменаПоШаблонуВерсии("релиз (final)_$version.cf", Имена);

	Ожидаем.Что(Результат.Количество()).Равно(1);
	Ожидаем.Что(Результат[0]).Равно("релиз (final)_1.0.0.0.cf");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ТребоватьОдинаковуюВерсию_ДляПовторныхВхожденийШаблона() Экспорт

	Имена = ТестовыеДанные.Массив("app_1.0.0.0_copy_1.0.0.0.cf", "app_1.0.0.0_copy_2.0.0.0.cf");

	Результат = Операции.ВыбратьИменаПоШаблонуВерсии("app_$version_copy_$version.cf", Имена);

	Ожидаем.Что(Результат.Количество()).Равно(1);
	Ожидаем.Что(Результат[0]).Равно("app_1.0.0.0_copy_1.0.0.0.cf");

КонецПроцедуры

#КонецОбласти

#Область НайтиФайлПоШаблонуВерсии

&Тест
Процедура ТестДолжен_ВернутьПутьКакЕсть_ЕслиШаблонаНет() Экспорт

	Ожидаем.Что(Операции.НайтиФайлПоШаблонуВерсии("./updates/1cv8.cfu")).Равно("./updates/1cv8.cfu");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиВКаталоге_ФайлСоСтаршейВерсией() Экспорт

	Каталог = ВременныеФайлы.СоздатьКаталог();
	ТестовыеФайлы.Файл(Каталог, "1cv8_1.0.9.0.cfu");
	ТестовыеФайлы.Файл(Каталог, "1cv8_1.0.10.0.cfu");
	ТестовыеФайлы.Файл(Каталог, "1cv8_1.0.10.0.cf");

	Результат = Операции.НайтиФайлПоШаблонуВерсии(ОбъединитьПути(Каталог, "1cv8_$version.cfu"));

	Ожидаем.Что(Результат).Равно(ОбъединитьПути(Каталог, "1cv8_1.0.10.0.cfu"));

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыброситьОшибку_ЕслиФайлПоШаблонуНеНайден() Экспорт

	Каталог = ВременныеФайлы.СоздатьКаталог();
	ТестовыеФайлы.Файл(Каталог, "readme.txt");

	Ожидаем.Что(Операции).Метод("НайтиФайлПоШаблонуВерсии", ТестовыеДанные.Массив(ОбъединитьПути(Каталог, "1cv8_$version.cfu")))
		.ВыбрасываетИсключение("Не найден файл по шаблону версии");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыброситьОшибку_ЕслиШаблонВКаталогеПути() Экспорт

	Ожидаем.Что(Операции).Метод("НайтиФайлПоШаблонуВерсии", ТестовыеДанные.Массив(ОбъединитьПути("updates_$version", "1cv8.cfu")))
		.ВыбрасываетИсключение("только в имени файла");

КонецПроцедуры

#КонецОбласти

#Область ПутиИКаталоги

&Тест
Процедура ТестДолжен_ВернутьПустуюСтроку_ДляПустогоПутиФайла() Экспорт

	Ожидаем.Что(Операции.КаталогФайла("")).Равно("");
	Ожидаем.Что(Операции.ПолныйПуть("")).Равно("");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьКаталогФайла_ДляАбсолютногоПути() Экспорт

	ПутьКФайлу = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "отчет.xml");

	Ожидаем.Что(Операции.КаталогФайла(ПутьКФайлу)).Равно(Новый Файл(ПутьКФайлу).Путь);

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазыменоватьГолоеИмяФайла_ВТекущийКаталог() Экспорт

	// у голого имени Файл.Путь пуст, а КаталогФайла разыменовывает его в текущий каталог
	Ожидаем.Что(ЗначениеЗаполнено(Операции.КаталогФайла("отчет.xml")), "каталог не пуст").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОчиститьСуществующийКаталог_ПриОбеспеченииПустого() Экспорт

	Каталог = ВременныеФайлы.СоздатьКаталог();
	ТестовыеФайлы.Файл(Каталог, "мусор.txt");

	Операции.ОбеспечитьПустойКаталог(Каталог);

	Ожидаем.Что(ТестовыеФайлы.Существует(Каталог), "каталог существует").ЭтоИстина();
	Ожидаем.Что(НайтиФайлы(Каталог, ПолучитьМаскуВсеФайлы()).Количество(), "каталог пуст").Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьНедостающийКаталог_ПриОбеспеченииПустого() Экспорт

	Каталог = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "вложенный", "каталог");

	Операции.ОбеспечитьПустойКаталог(Каталог);

	Ожидаем.Что(ТестовыеФайлы.Существует(Каталог)).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьКаталогДляФайла() Экспорт

	Каталог = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "reports");

	Операции.ОбеспечитьКаталогДляФайла(ОбъединитьПути(Каталог, "junit.xml"));

	Ожидаем.Что(ТестовыеФайлы.Существует(Каталог), "создан каталог, но не файл").ЭтоИстина();
	Ожидаем.Что(ТестовыеФайлы.Существует(ОбъединитьПути(Каталог, "junit.xml"))).ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область УдалитьБезопасно

&Тест
Процедура ТестДолжен_ВернутьИстину_ПриУдаленииПустогоПути() Экспорт

	Ожидаем.Что(Операции.УдалитьБезопасно("")).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьИстину_ПриУдаленииНесуществующегоПути() Экспорт

	Ожидаем.Что(Операции.УдалитьБезопасно(ТестовыеФайлы.НесуществующийПуть("нет.txt"))).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_УдалитьСуществующийКаталог_ИВернутьИстину() Экспорт

	Каталог = ВременныеФайлы.СоздатьКаталог();
	ТестовыеФайлы.Файл(Каталог, "мусор.txt");

	Ожидаем.Что(Операции.УдалитьБезопасно(Каталог)).ЭтоИстина();
	Ожидаем.Что(ТестовыеФайлы.Существует(Каталог), "каталог удалён").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти
