// BSLLS-off
// Юнит-тесты ОперацииJSON: запись и чтение JSON-файла, выбор типа объекта, ошибка на битом JSON.

#Использовать asserts
#Использовать tempfiles

#Использовать "../../../src/core/Файлы"

Перем Операции;
Перем НакопленныеВременныеФайлы;

#Область ЗаписьИЧтение

&Тест
Процедура ТестДолжен_ПрочитатьЗаписанныеДанные_ВСоответствие() Экспорт

	ПутьФайла = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "данные.json");
	Данные = Новый Структура("reportFormat, closeAfterTests, extensions", "jUnit", Истина, СтрРазделить("a,b", ","));

	Операции.Записать(ПутьФайла, Данные);
	Результат = Операции.Прочитать(ПутьФайла);

	Ожидаем.Что(Результат).ИмеетТип("Соответствие");
	Ожидаем.Что(Результат.Получить("reportFormat")).Равно("jUnit");
	Ожидаем.Что(Результат.Получить("closeAfterTests")).ЭтоИстина();
	Ожидаем.Что(Результат.Получить("extensions").Количество()).Равно(2);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗаписатьФайлСОтступами_ВUTF8БезBOM() Экспорт

	ПутьФайла = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "данные.json");

	Операции.Записать(ПутьФайла, Новый Структура("имя", "значение"));

	Чтение = Новый ЧтениеДанных(ПутьФайла);
	ПервыйБайт = Чтение.ПрочитатьБайт();
	Чтение.Закрыть();
	Текст = ПрочитатьТекст(ПутьФайла);

	Ожидаем.Что(ПервыйБайт, "без BOM").Равно(КодСимвола("{"));
	Ожидаем.Что(Текст, "с отступами").Содержит(Символы.Таб + """имя"": ""значение""");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПрочитатьВСтруктуру_ЕслиВСоответствиеЛожь() Экспорт

	ПутьФайла = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "данные.json");
	ЗаписатьТекст(ПутьФайла, "{""Data"": [1, 2], ""TotalDurability"": 3}");

	Результат = Операции.Прочитать(ПутьФайла, Ложь);

	Ожидаем.Что(Результат).ИмеетТип("Структура");
	Ожидаем.Что(Результат.TotalDurability).Равно(3);
	Ожидаем.Что(Результат.Data.Количество()).Равно(2);

КонецПроцедуры

#КонецОбласти

#Область Ошибки

&Тест
Процедура ТестДолжен_ПроброситьИсключение_НаБитомJSON() Экспорт

	ПутьФайла = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "битый.json");
	ЗаписатьТекст(ПутьФайла, "{""имя"": ");

	Попытка
		Операции.Прочитать(ПутьФайла);
		ВызватьИсключение "Должно было упасть";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Не_().Содержит("Должно было упасть");
	КонецПопытки;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПроброситьИсключение_ЕслиФайлаНет() Экспорт

	ПутьФайла = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "нет.json");

	Попытка
		Операции.Прочитать(ПутьФайла);
		ВызватьИсключение "Должно было упасть";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Не_().Содержит("Должно было упасть");
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
	Операции = Новый ОперацииJSON;
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаписатьТекст(Знач ПутьФайла, Знач Текст)
	Запись = Новый ЗаписьТекста(ПутьФайла, "UTF-8");
	Запись.Записать(Текст);
	Запись.Закрыть();
КонецПроцедуры

Функция ПрочитатьТекст(Знач ПутьФайла)
	Чтение = Новый ЧтениеТекста(ПутьФайла, "UTF-8");
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат Текст;
КонецФункции

#КонецОбласти
