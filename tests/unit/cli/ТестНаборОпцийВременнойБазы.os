// BSLLS-off
// Юнит-тесты НаборОпцийВременнойБазы: переданная база или временная по флагу --temp-db.
// Наборы опций - классы cli без зависимостей, создаются напрямую без стенда; подключаются по файлу,
// потому что пакет src/cli целиком тянет рогатку приложения.

#Использовать asserts

Перем Набор;
Перем ОпцииПодключения;

&ПередКаждым
Процедура ПередКаждым() Экспорт
	ПодключитьНаборОпций("НаборОпцийПодключения");
	ПодключитьНаборОпций("НаборОпцийСУБД");
	ПодключитьНаборОпций("НаборОпцийВременнойБазы");
	Набор = Новый НаборОпцийВременнойБазы;
	ОпцииПодключения = Новый НаборОпцийПодключения;
	ОпцииПодключения.СтрокаПодключения = "/Fbase";
КонецПроцедуры

#Область ПараметрыПодключенияЕслиЗаданы

&Тест
Процедура ТестДолжен_ВернутьПараметрыПодключения_БезФлага() Экспорт

	// Дано - опции СУБД доходят до параметров подключения
	ОпцииСУБД = Новый НаборОпцийСУБД;
	ОпцииСУБД.ТипСУБД = "PostgreSQL";

	// Когда
	Параметры = Набор.ПараметрыПодключенияЕслиЗаданы(ОпцииПодключения, ОпцииСУБД);

	// Тогда
	Ожидаем.Что(Параметры.СтрокаПодключения).Равно("/Fbase");
	Ожидаем.Что(Параметры.ТипСУБД).Равно("PostgreSQL");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьПараметрыПодключения_ЕслиФлагСброшен() Экспорт

	// Дано - значение флага без --temp-db в командной строке
	Набор.ИспользоватьВременнуюБазу = Ложь;

	// Когда / Тогда
	Ожидаем.Что(Набор.ПараметрыПодключенияЕслиЗаданы(ОпцииПодключения).СтрокаПодключения).Равно("/Fbase");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьНеопределено_ПоФлагуПриЗаданнойСтрокеПодключения() Экспорт

	// Дано
	Набор.ИспользоватьВременнуюБазу = Истина;

	// Когда / Тогда - сервис создаст временную базу
	Ожидаем.Что(Набор.ПараметрыПодключенияЕслиЗаданы(ОпцииПодключения)).ЭтоНеопределено();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьНеопределено_БезФлагаИБезСтрокиПодключения() Экспорт

	// Дано
	ОпцииПодключения.СтрокаПодключения = "";

	// Когда / Тогда
	Ожидаем.Что(Набор.ПараметрыПодключенияЕслиЗаданы(ОпцииПодключения)).ЭтоНеопределено();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПодключитьНаборОпций(Знач Имя)
	КореньПроекта = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "..", "..");
	КаталогНаборов = ОбъединитьПути(КореньПроекта, "src", "cli", "НаборыОпций");
	ПодключитьСценарий(ОбъединитьПути(КаталогНаборов, Имя + ".os"), Имя);
КонецПроцедуры

#КонецОбласти
