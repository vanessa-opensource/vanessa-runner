{
  "$schema": "https://github.com/vanessa-opensource/vanessa-runner/releases/latest/download/vrunner-settings-schema.json",
  "vrunner": {
    "ibconnection": "/F./build/ib",
    "v8version": "8.3.24",
    "cf": {
      "compile": {
