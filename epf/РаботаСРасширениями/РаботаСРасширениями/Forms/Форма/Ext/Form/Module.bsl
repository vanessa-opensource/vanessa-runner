////////////////////////////////////////////////////////////////////////////////
// Обработка работы с установленными расширениями конфигурации.
// Построена по шаблону epf/ШаблонОбработки: регион "Инфраструктура" и обработчики
// формы общие (эталон - ШаблонОбработки), уникальна только "БизнесЛогика".
//
// Режимы (выбираются по флагам в параметрах запуска):
//   - загрузка расширения (по умолчанию): Путь, Имя, Перезаписывать, БезопасныйРежим, ...
//   - ЗапуститьТолькоПроверкуПрименимостиРасширений: проверка применимости
//   - ТолькоУстановитьПараметрыРасширения: смена свойств без перезагрузки
//   - УдалитьРасширение: удаление по имени
//   - СписокРасширений [Подробно]: список / таблица установленных расширений
////////////////////////////////////////////////////////////////////////////////

#Область ОписаниеПеременных

&НаКлиенте
Перем ПутьКОбработке; // каталог обработки (для разрешения путей вида $instrumentsRoot)

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	УбратьПодтверждениеПриЗавершенииПрограммы();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	СтрокаЗапуска = СокрЛП(ПараметрЗапуска);
	Если СтрокаЗапуска = "" Тогда
		Возврат;
	КонецЕсли;

	ПутьФайлаРезультата = "";
	Результат = НовыйРезультат();
	ЗавершитьРаботуСистемыЗапрошено = Ложь;

	Попытка
		ПутьКОбработке = ПолучитьПутьОбработки();

		ПараметрыЗапуска = ПолучитьСтруктуруПараметров(СтрокаЗапуска);
		ПреобразоватьПараметрыКоторыеНачинаютсяСТочкиКНормальнымПутям(ПараметрыЗапуска);

		Если ПараметрыЗапуска.Свойство("ФайлРезультата") Тогда
			ПутьФайлаРезультата = ПараметрыЗапуска.ФайлРезультата;
		КонецЕсли;
		ЗавершитьРаботуСистемыЗапрошено = ПараметрыЗапуска.Свойство("ЗавершитьРаботуСистемы");

		Результат = ВыполнитьОперацию(ПараметрыЗапуска);
	Исключение
		Результат.КодВозврата = 1;
		Результат.Ошибка = "Неудача при выполнении обработки: " + Символы.ПС
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ЗаписатьФайлРезультата(ПутьФайлаРезультата, Результат);

	Если ЗавершитьРаботуСистемыЗапрошено Тогда
		ЗавершитьРаботуСистемы(Ложь, Ложь);
	Иначе
		ПрекратитьРаботуСистемы(Ложь);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область БизнесЛогика

&НаКлиенте
Функция ВыполнитьОперацию(Знач ПараметрыЗапуска)

	ИмяРасширения = "";
	ПараметрыЗапуска.Свойство("Имя", ИмяРасширения);

	Если ПараметрыЗапуска.Свойство("ЗапуститьТолькоПроверкуПрименимостиРасширений") Тогда
		Возврат ПроверитьПрименимостьРасширенийНаСервере(ИмяРасширения);
	ИначеЕсли ПараметрыЗапуска.Свойство("ТолькоУстановитьПараметрыРасширения") Тогда
		Возврат УстановитьПараметрыРасширенияНаСервере(ИмяРасширения, ПараметрыЗапуска);
	ИначеЕсли ПараметрыЗапуска.Свойство("УдалитьРасширение") Тогда
		Возврат УдалитьРасширениеПоИмениНаСервере(ИмяРасширения);
	ИначеЕсли ПараметрыЗапуска.Свойство("СписокРасширений") Тогда
		Возврат СписокРасширенийНаСервере(
			ПолучитьБулевоПараметр(ПараметрыЗапуска, "Подробно", Ложь),
			ПолучитьБулевоПараметр(ПараметрыЗапуска, "ВыводJSON", Ложь));
	Иначе
		Возврат ВыполнитьЗагрузкуРасширений(ПараметрыЗапуска, ИмяРасширения);
	КонецЕсли;

КонецФункции

// --- Загрузка ---

// Синхронно загружает одно или несколько расширений из cfe-файла/каталога.
&НаКлиенте
Функция ВыполнитьЗагрузкуРасширений(Знач ПараметрыЗапуска, Знач ИмяРасширения)

	Результат = НовыйРезультат();

	ПутьРасширения = "";
	Если НЕ ПараметрыЗапуска.Свойство("Путь", ПутьРасширения) ИЛИ НЕ ЗначениеЗаполнено(ПутьРасширения) Тогда
		ВызватьИсключение "Не задан путь расширения - формат Путь=НужныйПутьФайлаРасширения";
	КонецЕсли;

	ПараметрыРасширения = Новый Структура;
	ПараметрыРасширения.Вставить("БезопасныйРежим",
		ПолучитьБулевоПараметр(ПараметрыЗапуска,"БезопасныйРежим", Ложь));
	ПараметрыРасширения.Вставить("ЗащитаОтОпасныхДействий",
		ПолучитьБулевоПараметр(ПараметрыЗапуска,"ЗащитаОтОпасныхДействий", Ложь));
	ПараметрыРасширения.Вставить("ИспользоватьОсновныеРолиДляВсехПользователей",
		ПолучитьБулевоПараметр(ПараметрыЗапуска,"ИспользоватьОсновныеРолиДляВсехПользователей", Истина));
	ПараметрыРасширения.Вставить("ПроверитьПрименимость",
		ПолучитьБулевоПараметр(ПараметрыЗапуска,"ПроверитьПрименимость", Ложь));
	ПараметрыРасширения.Вставить("ЗагружатьРасширениеПриНаличииПроблемПрименимости",
		ПолучитьБулевоПараметр(ПараметрыЗапуска,"ЗагружатьРасширениеПриНаличииПроблемПрименимости", Ложь));

	Перезаписывать = ПолучитьБулевоПараметр(ПараметрыЗапуска,"Перезаписывать", Ложь);
	ОтключитьЛогикуНачалаРаботыСистемы = ПолучитьБулевоПараметр(ПараметрыЗапуска,"ОтключитьЛогикуНачалаРаботыСистемы", Ложь);

	НайденныеФайлы = НайтиФайлыРасширений(ПутьРасширения);
	Результат.Сообщения.Добавить(СтрШаблон("Найдено файлов расширений: %1", НайденныеФайлы.Количество()));

	Для Каждого Файл Из НайденныеФайлы Цикл
		ПутьФайла = Файл.ПолноеИмя;
		Имя = ?(ПустаяСтрока(ИмяРасширения), Файл.ИмяБезРасширения, ИмяРасширения);

		Результат.Сообщения.Добавить(СтрШаблон("Загрузка расширения '%1' из файла: %2", Имя, ПутьФайла));

		Попытка
			ДвоичныеДанные = Новый ДвоичныеДанные(ПутьФайла);
		Исключение
			Результат.КодВозврата = 1;
			Результат.Ошибка = СтрШаблон("Не удалось прочитать файл расширения %1: %2",
				ПутьФайла, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			Возврат Результат;
		КонецПопытки;

		РезУстановки = УстановитьРасширениеНаСервере(Имя, ДвоичныеДанные, Перезаписывать, ПараметрыРасширения);
		ДобавитьСообщения(Результат.Сообщения, РезУстановки.Сообщения);

		Если РезУстановки.КодВозврата <> 0 Тогда
			Результат.КодВозврата = РезУстановки.КодВозврата;
			Результат.Ошибка = ПутьФайла + Символы.ПС + РезУстановки.Ошибка;
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;

	ДобавитьСообщения(Результат.Сообщения,
		ОбновитьПараметрыРаботыВерсийРасширенийНаСервере(ОтключитьЛогикуНачалаРаботыСистемы));

	Возврат Результат;

КонецФункции

&НаКлиенте
Функция НайтиФайлыРасширений(Знач ПутьРасширения)

	Файл = Новый Файл(ПутьРасширения);
	Если Файл.Существует() И НЕ Файл.ЭтоКаталог() Тогда
		Результат = Новый Массив;
		Результат.Добавить(Файл);
		Возврат Результат;
	КонецЕсли;

	Результат = НайтиФайлы(ПутьРасширения, "*.cfe", Истина);
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		ВызватьИсключение "Не найдено файлов-расширений для пути " + ПутьРасширения;
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервере
Функция УстановитьРасширениеНаСервере(Знач Имя, Знач ДвоичныеДанныеРасширения, Знач Перезаписывать,
		Знач ПараметрыРасширения)

	Результат = НовыйРезультат();

	РасширенияДо = РасширенияКонфигурации.Получить();

	// Перезапись выполняется обновлением уже установленного расширения по имени (Записать на
	// существующем объекте заменяет его данные). Это идемпотентно и не зависит от внутреннего
	// имени cfe, в отличие от схемы "удалить по имени + создать заново".
	СуществующиеРасширения = РасширенияКонфигурации.Получить(Новый Структура("Имя", Имя));
	ОбновлениеСуществующего = СуществующиеРасширения.Количество() > 0;

	Если ОбновлениеСуществующего Тогда
		Если НЕ Перезаписывать Тогда
			Результат.КодВозврата = 1;
			Результат.Ошибка = СтрШаблон("Расширение '%1' уже установлено."
				+ " Для перезаписи укажите параметр Перезаписывать.", Имя);
			Возврат Результат;
		КонецЕсли;
		Расширение = СуществующиеРасширения[0];
		Результат.Сообщения.Добавить(СтрШаблон("Обновление установленного расширения '%1'", Имя));
	Иначе
		Расширение = РасширенияКонфигурации.Создать();
	КонецЕсли;

	ОписаниеЗащиты = Новый("ОписаниеЗащитыОтОпасныхДействий");
	ОписаниеЗащиты.ПредупреждатьОбОпасныхДействиях = ПараметрыРасширения.ЗащитаОтОпасныхДействий;

	Расширение.БезопасныйРежим = ПараметрыРасширения.БезопасныйРежим;
	Расширение.ЗащитаОтОпасныхДействий = ОписаниеЗащиты;

	Если Версия8315ИлиВыше() Тогда
		Расширение.ИспользоватьОсновныеРолиДляВсехПользователей =
			ПараметрыРасширения.ИспользоватьОсновныеРолиДляВсехПользователей;
	КонецЕсли;

	Если ПараметрыРасширения.ПроверитьПрименимость Тогда
		МассивПроблемПрименимости = Расширение.ПроверитьВозможностьПрименения(ДвоичныеДанныеРасширения, Истина);
		ДобавитьСообщенияСервер(Результат.Сообщения, ОписатьПроблемыПрименимости(МассивПроблемПрименимости, Имя));
		Если МассивПроблемПрименимости.Количество() > 0
			И НЕ ПараметрыРасширения.ЗагружатьРасширениеПриНаличииПроблемПрименимости Тогда
			Результат.КодВозврата = 1;
			Результат.Ошибка = "Расширение не удалось установить: обнаружены ошибки применимости."
				+ " Чтобы загрузить расширение несмотря на ошибки, укажите параметр"
				+ " ЗагружатьРасширениеПриНаличииПроблемПрименимости.";
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	Расширение.Записать(ДвоичныеДанныеРасширения);

	Если ОбновлениеСуществующего Тогда
		ИмяУстановленного = Имя;
	Иначе
		НовыеЭлементы = РазностьМассивов(РасширенияКонфигурации.Получить(), РасширенияДо);
		Если НЕ ЗначениеЗаполнено(НовыеЭлементы) Тогда
			Результат.Сообщения.Добавить("Не найдено новых установленных расширений после установки расширения");
			Возврат Результат;
		КонецЕсли;
		ИмяУстановленного = НовыеЭлементы[0].Имя;
	КонецЕсли;

	ДобавитьСообщенияСервер(Результат.Сообщения,
		ОписатьУспешнуюУстановку(ПараметрыРасширения, ИмяУстановленного));

	Возврат Результат;

КонецФункции

&НаСервере
Функция РасширениеПоИмени(Знач Имя)

	Отбор = Новый Структура("Имя", Имя);
	Расширения = РасширенияКонфигурации.Получить(Отбор);
	Если Не ЗначениеЗаполнено(Расширения) Тогда
		ВызватьИсключение "Не удалось найти расширение по имени " + Имя;
	КонецЕсли;

	Возврат Расширения[0];

КонецФункции

&НаСервере
Функция ОписатьУспешнуюУстановку(Знач ПараметрыРасширения, Знач Имя)

	Сообщения = Новый Массив;

	Расширение = РасширениеПоИмени(Имя);
	Сообщения.Добавить(СтрШаблон("Установлено расширение %1, версия %2", Расширение.Имя, Расширение.Версия));

	Сообщения.Добавить(?(ПараметрыРасширения.БезопасныйРежим,
		"Безопасный режим установлен!", "Безопасный режим снят!"));
	Сообщения.Добавить(?(ПараметрыРасширения.ЗащитаОтОпасныхДействий,
		"Защита от опасных действий установлена!", "Защита от опасных действий снята!"));

	Если Версия8315ИлиВыше() Тогда
		Сообщения.Добавить(?(ПараметрыРасширения.ИспользоватьОсновныеРолиДляВсехПользователей,
			"Установлен режим использования основных ролей расширения!",
			"Режим использования основных ролей расширения снят!"));
	КонецЕсли;

	Возврат Сообщения;

КонецФункции

&НаСервере
Функция ОбновитьПараметрыРаботыВерсийРасширенийНаСервере(Знач ОтключитьЛогикуНачалаРаботыСистемы)

	Сообщения = Новый Массив;

	Если ОтключитьЛогикуНачалаРаботыСистемы
		ИЛИ Метаданные.Подсистемы.Найти("СтандартныеПодсистемы") = Неопределено Тогда
		Возврат Сообщения;
	КонецЕсли;

	Попытка
		МодульРегистрыСведенийПараметрыРаботыВерсийРасширений = Вычислить("РегистрыСведений.ПараметрыРаботыВерсийРасширений");
		МодульРегистрыСведенийПараметрыРаботыВерсийРасширений.ОбновитьПараметрыРаботыРасширений();
		Сообщения.Добавить("Параметры работы версий расширений обновлены");
	Исключение
		Сообщения.Добавить("Не удалось обновить параметры работы версий расширений: "
			+ ОписаниеОшибки());
	КонецПопытки;

	Возврат Сообщения;

КонецФункции

// --- Проверка применимости ---

&НаСервере
Функция ПроверитьПрименимостьРасширенийНаСервере(Знач ИмяРасширения = "")

	Результат = НовыйРезультат();

	Если ПустаяСтрока(ИмяРасширения) Тогда
		МассивПроблемПрименимости = РасширенияКонфигурации.ПроверитьВозможностьПримененияВсех();
	Иначе
		Расширение = РасширениеПоИмени(ИмяРасширения);
		ВсеПроблемы = РасширенияКонфигурации.ПроверитьВозможностьПримененияВсех();
		МассивПроблемПрименимости = Новый Массив;
		Для Каждого Проблема Из ВсеПроблемы Цикл
			Если Проблема.Расширение = Расширение Тогда
				МассивПроблемПрименимости.Добавить(Проблема);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	ДобавитьСообщенияСервер(Результат.Сообщения, ОписатьПроблемыПрименимости(МассивПроблемПрименимости, ""));

	Если МассивПроблемПрименимости.Количество() > 0 Тогда
		Результат.КодВозврата = 1;
		Результат.Ошибка = "При проверке применимости обнаружены ошибки!";
	Иначе
		Результат.Сообщения.Добавить("Ошибок применимости не обнаружено!");
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервере
Функция ОписатьПроблемыПрименимости(Знач МассивПроблемПрименимости, Знач ИмяНовогоРасширения)

	Сообщения = Новый Массив;
	Шаблон = "В расширении <%1> обнаружена проблема с важностью <%2>: %3";

	Для Каждого Проблема Из МассивПроблемПрименимости Цикл
		ИмяРасш = ?(ЗначениеЗаполнено(Проблема.Расширение.Имя), Проблема.Расширение.Имя, ИмяНовогоРасширения);
		Сообщения.Добавить(СтрШаблон(Шаблон, ИмяРасш, Строка(Проблема.Важность), Проблема.Описание));
	КонецЦикла;

	Возврат Сообщения;

КонецФункции

// --- Установка параметров ---

&НаСервере
Функция УстановитьПараметрыРасширенияНаСервере(Знач Имя, Знач ПараметрыКоманднойСтроки)

	Результат = НовыйРезультат();

	Если ПустаяСтрока(Имя) Тогда
		Результат.КодВозврата = 1;
		Результат.Ошибка = "Не задано имя расширения - формат Имя=МоеИмя";
		Возврат Результат;
	КонецЕсли;

	Расширение = РасширениеПоИмени(Имя);
	ИзмененияЕсть = Ложь;

	Если ПараметрыКоманднойСтроки.Свойство("Активность") Тогда
		Расширение.Активно = СтрокаВБулево(ПараметрыКоманднойСтроки.Активность);
		ИзмененияЕсть = Истина;
	КонецЕсли;

	Если ПараметрыКоманднойСтроки.Свойство("БезопасныйРежим") Тогда
		Расширение.БезопасныйРежим = СтрокаВБулево(ПараметрыКоманднойСтроки.БезопасныйРежим);
		ИзмененияЕсть = Истина;
	КонецЕсли;

	Если ПараметрыКоманднойСтроки.Свойство("ЗащитаОтОпасныхДействий") Тогда
		ОписаниеЗащиты = Новый("ОписаниеЗащитыОтОпасныхДействий");
		ОписаниеЗащиты.ПредупреждатьОбОпасныхДействиях = СтрокаВБулево(ПараметрыКоманднойСтроки.ЗащитаОтОпасныхДействий);
		Расширение.ЗащитаОтОпасныхДействий = ОписаниеЗащиты;
		ИзмененияЕсть = Истина;
	КонецЕсли;

	Если ПараметрыКоманднойСтроки.Свойство("ИспользоватьОсновныеРолиДляВсехПользователей") Тогда
		Если Версия8315ИлиВыше() Тогда
			Расширение.ИспользоватьОсновныеРолиДляВсехПользователей =
				СтрокаВБулево(ПараметрыКоманднойСтроки.ИспользоватьОсновныеРолиДляВсехПользователей);
			ИзмененияЕсть = Истина;
		Иначе
			Результат.Сообщения.Добавить("Параметр ИспользоватьОсновныеРолиДляВсехПользователей"
				+ " поддерживается только на платформе 8.3.15 и выше - пропущен");
		КонецЕсли;
	КонецЕсли;

	Если Не ИзмененияЕсть Тогда
		Результат.Сообщения.Добавить("Не указано ни одного параметра расширения для изменения"
			+ " (Активность, БезопасныйРежим, ЗащитаОтОпасныхДействий, ИспользоватьОсновныеРолиДляВсехПользователей)");
		Возврат Результат;
	КонецЕсли;

	Расширение.Записать();

	ДобавитьСообщенияСервер(Результат.Сообщения, ОписатьПараметрыРасширения(Расширение));

	Возврат Результат;

КонецФункции

&НаСервере
Функция ОписатьПараметрыРасширения(Знач Расширение)

	Сообщения = Новый Массив;

	Сообщения.Добавить(СтрШаблон("Параметры расширения %1 обновлены (версия %2)", Расширение.Имя, Расширение.Версия));
	Сообщения.Добавить(?(Расширение.Активно,
		"Расширение активно!", "Расширение неактивно!"));
	Сообщения.Добавить(?(Расширение.БезопасныйРежим,
		"Безопасный режим установлен!", "Безопасный режим снят!"));
	Сообщения.Добавить(?(Расширение.ЗащитаОтОпасныхДействий.ПредупреждатьОбОпасныхДействиях,
		"Защита от опасных действий установлена!", "Защита от опасных действий снята!"));

	Если Версия8315ИлиВыше() Тогда
		Сообщения.Добавить(?(Расширение.ИспользоватьОсновныеРолиДляВсехПользователей,
			"Установлен режим использования основных ролей расширения!",
			"Режим использования основных ролей расширения снят!"));
	КонецЕсли;

	Возврат Сообщения;

КонецФункции

// --- Удаление / список ---

&НаСервере
Функция УдалитьРасширениеПоИмениНаСервере(Знач Имя)

	Результат = НовыйРезультат();

	Если ПустаяСтрока(Имя) Тогда
		Результат.КодВозврата = 1;
		Результат.Ошибка = "Не задано имя расширения - формат Имя=МоеИмя";
		Возврат Результат;
	КонецЕсли;

	Существующие = РасширенияКонфигурации.Получить(Новый Структура("Имя", Имя));
	Если Существующие.Количество() = 0 Тогда
		Результат.КодВозврата = 1;
		Результат.Ошибка = СтрШаблон("Расширение '%1' не найдено", Имя);
		Возврат Результат;
	КонецЕсли;

	Для Каждого Расширение Из Существующие Цикл
		Расширение.Удалить();
	КонецЦикла;

	Результат.Сообщения.Добавить(СтрШаблон("Расширение '%1' удалено", Имя));

	Возврат Результат;

КонецФункции

&НаСервере
Функция СписокРасширенийНаСервере(Знач Подробно, Знач ВыводJSON = Ложь)

	Результат = НовыйРезультат();

	Расширения = РасширенияКонфигурации.Получить();

	Если ВыводJSON Тогда
		Результат.Сообщения.Добавить(СписокРасширенийВJSON(Расширения));
		Возврат Результат;
	КонецЕсли;

	Если Расширения.Количество() = 0 Тогда
		Результат.Сообщения.Добавить("Установленных расширений нет");
		Возврат Результат;
	КонецЕсли;

	Если НЕ Подробно Тогда
		Для Каждого Расширение Из Расширения Цикл
			Результат.Сообщения.Добавить(Расширение.Имя);
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Строки = Новый Массив;
	Строки.Добавить(ЗаголовокСписка());
	Для Каждого Расширение Из Расширения Цикл
		Строки.Добавить(ЯчейкиРасширения(Расширение));
	КонецЦикла;

	ДобавитьСообщенияСервер(Результат.Сообщения, ОтформатироватьТаблицу(Строки));

	Возврат Результат;

КонецФункции

// Сериализует список установленных расширений в JSON-строку.
// Для каждого расширения выводятся: имя, синоним, версия, хэш и текущие параметры
// (активность, безопасный режим, защита от опасных действий, основные роли для всех).
//
// Параметры:
//   Расширения - Массив - элементы расширений конфигурации (РасширениеКонфигурации)
//
// Возвращаемое значение:
//   Строка - JSON-представление массива расширений (для пустого списка - "[]")
//
&НаСервере
Функция СписокРасширенийВJSON(Знач Расширения)

	ПоддержкаОсновныхРолей = Версия8315ИлиВыше();

	МассивРасширений = Новый Массив;
	Для Каждого Расширение Из Расширения Цикл
		Запись = Новый Структура;
		Запись.Вставить("имя", Расширение.Имя);
		Запись.Вставить("синоним", Расширение.Синоним);
		Запись.Вставить("версия", Расширение.Версия);
		Запись.Вставить("хэш", ХэшРасширения(Расширение));
		Запись.Вставить("активно", Расширение.Активно);
		Запись.Вставить("безопасныйРежим", Расширение.БезопасныйРежим);
		Запись.Вставить("защитаОтОпасныхДействий",
			Расширение.ЗащитаОтОпасныхДействий.ПредупреждатьОбОпасныхДействиях);
		Если ПоддержкаОсновныхРолей Тогда
			Запись.Вставить("основныеРолиДляВсех", Расширение.ИспользоватьОсновныеРолиДляВсехПользователей);
		Иначе
			Запись.Вставить("основныеРолиДляВсех", Неопределено);
		КонецЕсли;
		МассивРасширений.Добавить(Запись);
	КонецЦикла;

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, " "));
	ЗаписатьJSON(ЗаписьJSON, МассивРасширений);
	Возврат ЗаписьJSON.Закрыть();

КонецФункции

// Возвращает хэш-сумму расширения в виде строки. Свойство ХешСумма доступно не на всех
// платформах, поэтому обращение к нему обёрнуто в попытку.
//
// Параметры:
//   Расширение - РасширениеКонфигурации - расширение, хэш которого нужно получить
//
// Возвращаемое значение:
//   Строка - хэш-сумма расширения либо пустая строка, если свойство недоступно
//
&НаСервере
Функция ХэшРасширения(Знач Расширение)
	Попытка
		Возврат Строка(Расширение.ХешСумма);
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

&НаСервереБезКонтекста
Функция ЗаголовокСписка()
	Заголовок = Новый Массив;
	Заголовок.Добавить("Имя");
	Заголовок.Добавить("Синоним");
	Заголовок.Добавить("Версия");
	Заголовок.Добавить("Активно");
	Заголовок.Добавить("Безопасный режим");
	Заголовок.Добавить("Защита от опасных действий");
	Заголовок.Добавить("Основные роли для всех");
	Возврат Заголовок;
КонецФункции

&НаСервере
Функция ЯчейкиРасширения(Знач Расширение)

	ОсновныеРоли = "-";
	Если Версия8315ИлиВыше() Тогда
		ОсновныеРоли = ?(Расширение.ИспользоватьОсновныеРолиДляВсехПользователей, "да", "нет");
	КонецЕсли;

	Ячейки = Новый Массив;
	Ячейки.Добавить(Расширение.Имя);
	Ячейки.Добавить(?(ЗначениеЗаполнено(Расширение.Синоним), Расширение.Синоним, "-"));
	Ячейки.Добавить(?(ЗначениеЗаполнено(Расширение.Версия), Расширение.Версия, "-"));
	Ячейки.Добавить(?(Расширение.Активно, "да", "нет"));
	Ячейки.Добавить(?(Расширение.БезопасныйРежим, "да", "нет"));
	Ячейки.Добавить(?(Расширение.ЗащитаОтОпасныхДействий.ПредупреждатьОбОпасныхДействиях, "да", "нет"));
	Ячейки.Добавить(ОсновныеРоли);
	Возврат Ячейки;

КонецФункции

// Форматирует строки (массивы ячеек) в выровненную моноширинную таблицу.
// Первая строка - заголовок; под ней добавляется строка-разделитель.
&НаСервереБезКонтекста
Функция ОтформатироватьТаблицу(Знач Строки)

	КоличествоКолонок = Строки[0].Количество();

	Ширины = Новый Массив;
	Для К = 1 По КоличествоКолонок Цикл
		Ширины.Добавить(0);
	КонецЦикла;

	Для Каждого СтрокаЯчеек Из Строки Цикл
		Для К = 0 По КоличествоКолонок - 1 Цикл
			Ширины[К] = Макс(Ширины[К], СтрДлина(Строка(СтрокаЯчеек[К])));
		КонецЦикла;
	КонецЦикла;

	Результат = Новый Массив;
	НомерСтроки = 0;
	Для Каждого СтрокаЯчеек Из Строки Цикл
		Результат.Добавить(ОтформатироватьСтрокуТаблицы(СтрокаЯчеек, Ширины));
		Если НомерСтроки = 0 Тогда
			Результат.Добавить(СтрокаРазделительТаблицы(Ширины));
		КонецЕсли;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ОтформатироватьСтрокуТаблицы(Знач Ячейки, Знач Ширины)
	Части = Новый Массив;
	Для К = 0 По Ячейки.Количество() - 1 Цикл
		Части.Добавить(ДополнитьСправа(Строка(Ячейки[К]), Ширины[К]));
	КонецЦикла;
	Возврат СтрСоединить(Части, " | ");
КонецФункции

&НаСервереБезКонтекста
Функция СтрокаРазделительТаблицы(Знач Ширины)
	Части = Новый Массив;
	Для Каждого Ширина Из Ширины Цикл
		Части.Добавить(ПовторитьСимвол("-", Ширина));
	КонецЦикла;
	Возврат СтрСоединить(Части, "-+-");
КонецФункции

&НаСервереБезКонтекста
Функция ДополнитьСправа(Знач Текст, Знач Ширина)
	Пока СтрДлина(Текст) < Ширина Цикл
		Текст = Текст + " ";
	КонецЦикла;
	Возврат Текст;
КонецФункции

&НаСервереБезКонтекста
Функция ПовторитьСимвол(Знач Символ, Знач Количество)
	Результат = "";
	Для К = 1 По Количество Цикл
		Результат = Результат + Символ;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// --- Доменные утилиты ---

&НаСервере
Функция РазностьМассивов(Знач Массив, Знач МассивВычитания)

	Результат = Новый Массив;
	Для Каждого Элемент Из Массив Цикл
		Если МассивВычитания.Найти(Элемент) = Неопределено Тогда
			Результат.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВерсияПриложенияБольшеИлиРавнаЧемЗаданная(Версия1, Версия2)
	Массив1 = РазложитьСтрокуВМассивПодстрок(Версия1, ".");
	Массив2 = РазложитьСтрокуВМассивПодстрок(Версия2, ".");

	Версия1БольшеИлиРавно = Истина;
	Для Ккк = 0 По Мин(Массив1.Количество(), Массив2.Количество()) - 1 Цикл
		Элем1 = Массив1.Получить(Ккк);
		Элем2 = Массив2.Получить(Ккк);

		Если Число(Элем2) > Число(Элем1) Тогда
			Версия1БольшеИлиРавно = Ложь;
		ИначеЕсли Число(Элем2) < Число(Элем1) Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат Версия1БольшеИлиРавно;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция Версия8315ИлиВыше()
	СистемнаяИнформация = Новый СистемнаяИнформация;
	Возврат ВерсияПриложенияБольшеИлиРавнаЧемЗаданная(СистемнаяИнформация.ВерсияПриложения, "8.3.15.1");
КонецФункции

// Преобразует строковое/логическое значение параметра в Булево.
// Понимает как русские (Истина/Да), так и латинские (true/yes/1) обозначения.
// Голый флаг приходит как Булево Истина.
&НаКлиентеНаСервереБезКонтекста
Функция СтрокаВБулево(Знач Значение)
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;
	Стр = НРег(СокрЛП(Строка(Значение)));
	Возврат Стр = "истина" Или Стр = "true" Или Стр = "да" Или Стр = "yes" Или Стр = "1";
КонецФункции

// Возвращает булево значение параметра по ключу, с поддержкой голых флагов и значений по умолчанию.
&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьБулевоПараметр(Знач Параметры, Знач Ключ, Знач ПоУмолчанию = Ложь)
	Значение = Неопределено;
	Если Параметры.Свойство(Ключ, Значение) Тогда
		Возврат СтрокаВБулево(Значение);
	КонецЕсли;
	Возврат ПоУмолчанию;
КонецФункции

#КонецОбласти

#Область Инфраструктура

// Общий код по конвенции (эталон - epf/ШаблонОбработки). Не редактируется в конкретной обработке.

// --- Результат ---

&НаКлиентеНаСервереБезКонтекста
Функция НовыйРезультат()
	Возврат Новый Структура("КодВозврата, Сообщения, Ошибка", 0, Новый Массив, "");
КонецФункции

&НаКлиенте
Процедура ДобавитьСообщения(Приёмник, Знач Источник)
	Для Каждого Сообщение Из Источник Цикл
		Приёмник.Добавить(Сообщение);
	КонецЦикла;
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьСообщенияСервер(Приёмник, Знач Источник)
	Для Каждого Сообщение Из Источник Цикл
		Приёмник.Добавить(Сообщение);
	КонецЦикла;
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаписатьФайлРезультата(Знач ПутьФайла, Знач Результат)

	Если ПустаяСтрока(ПутьФайла) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Данные = Новый Структура;
		Данные.Вставить("КодВозврата", Результат.КодВозврата);
		Данные.Вставить("Сообщения", Результат.Сообщения);
		Данные.Вставить("Ошибка", Результат.Ошибка);

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.ОткрытьФайл(ПутьФайла, "UTF-8");
		ЗаписатьJSON(ЗаписьJSON, Данные);
		ЗаписьJSON.Закрыть();
	Исключение
		// Сбой записи файла результата не должен прерывать завершение работы обработки.
	КонецПопытки;

КонецПроцедуры

// --- Разбор параметров строки запуска ---

&НаКлиенте
Функция ПолучитьСтруктуруПараметров(Стр)

	Результат = Новый Структура;

	Массив = РазложитьСтрокуВМассивПодстрок(Стр, ";");
	Для каждого Элем Из Массив Цикл
		Поз = Найти(Элем, "=");
		Если Поз > 0 Тогда
			Ключ     = Лев(Элем, Поз - 1);
			Значение = Сред(Элем, Поз + 1);
			Попытка
				Результат.Вставить(СокрЛП(Ключ), СокрЛП(Значение));
			Исключение
				// некорректный ключ - пропускаем
			КонецПопытки;
		Иначе
			Если НЕ ПустаяСтрока(Элем) Тогда
				Попытка
					Результат.Вставить(СокрЛП(Элем), Истина);
				Исключение
					// некорректный флаг - пропускаем
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция РазложитьСтрокуВМассивПодстрок(Знач Строка, Знач Разделитель = ",",
		Знач ПропускатьПустыеСтроки = Неопределено)

	Результат = Новый Массив;

	Если ПропускатьПустыеСтроки = Неопределено Тогда
		ПропускатьПустыеСтроки = ?(Разделитель = " ", Истина, Ложь);
		Если ПустаяСтрока(Строка) Тогда
			Если Разделитель = " " Тогда
				Результат.Добавить("");
			КонецЕсли;
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	Позиция = Найти(Строка, Разделитель);
	Пока Позиция > 0 Цикл
		Подстрока = Лев(Строка, Позиция - 1);
		Если Не ПропускатьПустыеСтроки Или Не ПустаяСтрока(Подстрока) Тогда
			Результат.Добавить(Подстрока);
		КонецЕсли;
		Строка = Сред(Строка, Позиция + СтрДлина(Разделитель));
		Позиция = Найти(Строка, Разделитель);
	КонецЦикла;

	Если Не ПропускатьПустыеСтроки Или Не ПустаяСтрока(Строка) Тогда
		Результат.Добавить(Строка);
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура ПреобразоватьПараметрыКоторыеНачинаютсяСТочкиКНормальнымПутям(СтруктураПараметров)

	МассивКлючей = Новый Массив;
	Для каждого ПараметрБилда Из СтруктураПараметров Цикл
		Если Лев(ПараметрБилда.Значение, 1) = "." Или Найти(ПараметрБилда.Значение, "$instrumentsRoot") > 0 Тогда
			МассивКлючей.Добавить(ПараметрБилда.Ключ);
		КонецЕсли;
	КонецЦикла;

	Для каждого Ключ Из МассивКлючей Цикл
		Стало = ПреобразоватьПутьСТочкамиКНормальномуПути(СтруктураПараметров[Ключ]);
		Стало = ЗаменитьСлеши(Стало);
		СтруктураПараметров.Вставить(Ключ, Стало);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Функция ПреобразоватьПутьСТочкамиКНормальномуПути(ОригСтр)

	Если Найти(ОригСтр, "$instrumentsRoot") > 0 И НЕ ПустаяСтрока(ПутьКОбработке) Тогда
		Возврат СтрЗаменить(ОригСтр, "$instrumentsRoot", ДополнитьСлешВПуть(ПутьКОбработке));
	КонецЕсли;

	Возврат ОригСтр;

КонецФункции

&НаКлиенте
Функция ДополнитьСлешВПуть(Знач Каталог)

	Разделитель = ПолучитьРазделительПути();
	Если ПустаяСтрока(Каталог) Тогда
		Возврат Каталог;
	КонецЕсли;
	Если Прав(Каталог, 1) <> Разделитель Тогда
		Каталог = Каталог + Разделитель;
	КонецЕсли;
	Возврат Каталог;

КонецФункции

&НаКлиенте
Функция ЗаменитьСлеши(Знач Путь)
	Результат = СтрЗаменить(Путь, "\", ПолучитьРазделительПути());
	Результат = СтрЗаменить(Результат, "/", ПолучитьРазделительПути());
	Возврат Результат;
КонецФункции

// --- Путь к обработке ---

&НаКлиенте
Функция ПолучитьПутьОбработки()

	Перем ФайлПути, Результат;

	Результат = ПолучитьПутьКОбработкеСервер();
	Если НЕ ПустаяСтрока(ПутьКОбработке) Тогда
		ФайлПути = Новый Файл(ПутьКОбработке);
		Результат = ФайлПути.Путь;
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервере
Функция ПолучитьПутьКОбработкеСервер()

	ОбъектНаСервере = ОбъектНаСервере();
	ИспользуемоеИмяФайла = ОбъектНаСервере.ИспользуемоеИмяФайла;
	ПрефиксИмени = НРег(Лев(ИспользуемоеИмяФайла, 6));
	Если (ПрефиксИмени <> "e1cib/") И (ПрефиксИмени <> "e1cib\") Тогда
		Возврат ИспользуемоеИмяФайла;
	КонецЕсли;

	Возврат "";

КонецФункции

&НаСервере
Функция ОбъектНаСервере()
	Возврат РеквизитФормыВЗначение("Объект");
КонецФункции

// --- Завершение работы ---

&НаСервере
Процедура УбратьПодтверждениеПриЗавершенииПрограммы()

	Если Метаданные.Подсистемы.Найти("СтандартныеПодсистемы") <> Неопределено Тогда
		МодульОбщегоНазначения = Вычислить("ОбщегоНазначения");
		Попытка
			МодульОбщегоНазначения.ХранилищеОбщихНастроекСохранить("ОбщиеНастройкиПользователя",
				"ЗапрашиватьПодтверждениеПриЗавершенииПрограммы", Ложь);
		Исключение
			// Данного модуля и метода может не быть в конфигурации
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
