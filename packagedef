#Область СборкаПакета

// Вызывается пакетным менеджером перед началом сборки пакета.
//
// Параметры:
//   РабочийКаталог - Строка - Текущий рабочий каталог с исходниками пакета.
//
Процедура ПередСборкой(Знач РабочийКаталог) Экспорт

	ВыполнитьКоманду(РабочийКаталог, "opm install --local", "Установка зависимостей");
	// Тесты и доки внутри библиотек весят очень много. А нам они не нужны
	УдалитьСлужебныеКаталогиБиблиотек(ОбъединитьПути(РабочийКаталог, "oscript_modules"));
	ВыполнитьКоманду(РабочийКаталог, "oscript src/main.os epf compile -R epf", "Сборка epf");

КонецПроцедуры

Процедура УдалитьСлужебныеКаталогиБиблиотек(Знач КаталогМодулей)

	ИменаКаталогов = СтрРазделить("tests,test,spec,docs,doc,examples,example,features,.github,.vscode", ",");

	Удалено = 0;
	Для Каждого Библиотека Из НайтиФайлы(КаталогМодулей, "*") Цикл
		Если Не Библиотека.ЭтоКаталог() Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Имя Из ИменаКаталогов Цикл
			Каталог = Новый Файл(ОбъединитьПути(Библиотека.ПолноеИмя, Имя));
			Если Каталог.Существует() И Каталог.ЭтоКаталог() Тогда
				УдалитьФайлы(Каталог.ПолноеИмя);
				Удалено = Удалено + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Сообщить(СтрШаблон("Из библиотек удалено служебных каталогов (тесты, документация, примеры): %1", Удалено));

КонецПроцедуры

Процедура ВыполнитьКоманду(Знач РабочийКаталог, Знач СтрокаЗапуска, Знач Наименование)

	Команда = Новый Команда;
	Команда.УстановитьПравильныйКодВозврата(0);
	Команда.ПоказыватьВыводНемедленно(Истина);
	Команда.УстановитьРабочийКаталог(РабочийКаталог);
	Команда.УстановитьСтрокуЗапуска(СтрокаЗапуска);
	КодВозврата = Команда.Исполнить();
	Если КодВозврата <> 0 Тогда
		ВызватьИсключение СтрШаблон("%1 завершилась с кодом %2", Наименование, КодВозврата);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти



